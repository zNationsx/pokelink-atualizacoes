{"payload":"{\"app\":\"PokeLink\",\"version\":\"4.3\",\"created\":\"2026-11-09T23:49:05.323Z\",\"files\":{\"main.js\":\"const { app, BaseWindow, BrowserWindow, WebContentsView, View, Menu, Tray, ipcMain, dialog, shell, nativeImage, session, clipboard, webContents, powerMonitor, powerSaveBlocker } = require('electron');\\nconst path = require('path');\\nconst fs = require('fs');\\nconst osMod = require('os');\\nconst vm = require('vm');\\n\\n// Mesma pasta de dados no modo dev e no .exe, para os logins das contas serem os mesmos\\napp.setPath('userData', path.join(app.getPath('appData'), 'pokeidle-multi'));\\n// Só um PokeLink por vez: abrir de novo (ex.: com ele na bandeja) só mostra a janela que já está rodando\\nif (!app.requestSingleInstanceLock()) app.exit(0);\\napp.on('second-instance', () => { try { mostrarJanela(); } catch {} });\\napp.on('before-quit', () => { saindo = true; });\\n\\n// As lives abertas em segundo plano ficam com a GUIA mutada (como \\\"mutar guia\\\" no navegador);\\n// o player em si continua com som, então precisa poder tocar sem clique do usuário.\\napp.commandLine.appendSwitch('autoplay-policy', 'no-user-gesture-required');\\n// O Windows volta a poder avisar quando a janela está coberta/bloqueada (antes isso era desligado, e o vídeo\\n// das lives segurava a TELA acesa até com o PC bloqueado). Para o farm não parar quando a janela some:\\n// - os vídeos continuam tocando mesmo escondidos (disable-background-media-suspend);\\n// - as páginas não ficam mais lentas atrás de outra janela (as duas opções de \\\"backgrounding\\\");\\n// - a página da Kick sempre \\\"se acha\\\" visível (KICK_VISIVEL_JS), e o plano B do player confere os pontos.\\napp.commandLine.appendSwitch('disable-background-media-suspend');\\napp.commandLine.appendSwitch('disable-backgrounding-occluded-windows');\\n// O Windows avisa o Chromium quando uma janela está tapada ou fora da tela, e ele pausa o vídeo dela.\\n// É isso que fazia a live da Twitch \\\"às vezes contar, às vezes não\\\". Desligando a checagem, a janela\\n// escondida da live continua decodificando vídeo normalmente.\\napp.commandLine.appendSwitch('disable-features', 'CalculateNativeWinOcclusion');\\napp.commandLine.appendSwitch('disable-renderer-backgrounding');\\n\\n// Por padrão o Electron se identifica como \\\"... PokeLink/x Electron/y ...\\\", o que alguns sites bloqueiam.\\n// Todas as páginas passam a se identificar como o Chrome equivalente.\\nconst CLEAN_UA = `Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/${process.versions.chrome} Safari/537.36`;\\napp.userAgentFallback = CLEAN_UA;\\n// esconde a marca de \\\"navegador controlado por automação\\\"\\napp.commandLine.appendSwitch('disable-blink-features', 'AutomationControlled');\\n// Opção do menu Desempenho (\\\"Interface em um só processo\\\", precisa reiniciar): as páginas do próprio PokeLink (4 barras,\\n// barra de título, lista, painel da direita e barra de baixo) deixam de ter um processo cada e dividem UM. Medido no\\n// programa real: 15 -> 8 processos. As 4 contas do jogo continuam cada uma no seu (cada conta tem a própria sessão, e\\n// processo não é dividido entre sessões); só páginas do MESMO site na MESMA conta (ex.: 2 lives da Kick) passam a dividir.\\nconst desempenhoFile = () => path.join(app.getPath('userData'), 'desempenho.json');\\nlet processoUnico = false; // o que está salvo (o menu mostra isto)\\ntry { processoUnico = !!JSON.parse(fs.readFileSync(desempenhoFile(), 'utf8')).processoUnico; } catch {}\\nconst processoUnicoAtivo = processoUnico; // o que vale nesta execução (a mudança só pega depois de reiniciar)\\nif (processoUnicoAtivo) app.commandLine.appendSwitch('process-per-site');\\n\\n// Silencia os avisos \\\"Failed to load URL ... ERR_BLOCKED_BY_CSP\\\" (pixel do Facebook, inofensivo)\\nprocess.removeAllListeners('warning');\\n\\n// ====== CONFIGURE AQUI ======\\nconst GAME_URL = 'https://pokeidle.io';\\nconst ACCOUNTS = ['Conta 1', 'Conta 2', 'Conta 3', 'Conta 4'];\\n// ============================\\n\\n// ====== VERSÃO ======\\nconst APP_NAME = 'PokeLink';\\n// ============ DOIS NÚMEROS DE VERSÃO, E ISSO É DE PROPÓSITO ============\\n// APP_LABEL  = o que o usuário vê (pílula, Sobre, Novidades, bandeja). É a versão de verdade do\\n//              PokeLink, a que saiu do beta: 1.3, depois 1.4, 1.5...\\n// APP_VERSION = só serve para a atualização pela internet. O PokeLink só oferece atualização quando\\n//              o número publicado é MAIOR que o instalado, e existe gente parada na Beta 2.9/3.0.\\n//              Para essas pessoas, \\\"1.3\\\" parece mais ANTIGO que \\\"3.0\\\" e a atualização nunca aparece.\\n//              Por isso o pacote é numerado a partir de 4.0: alcança todo mundo.\\n// AO LANÇAR: suba OS DOIS (ex.: 1.5→1.6 no APP_LABEL e 4.1→4.2 no APP_VERSION). Nunca diminua nenhum.\\n// E CONFIRA: o primeiro cartão de NOVIDADES_HIST (lá embaixo) tem que ter o MESMO número do APP_LABEL,\\n// no campo 'versao' e no 'titulo'; senão o cartão aparece com o número errado.\\nconst APP_LABEL = '1.6';   // o que aparece para o usuário\\nconst APP_VERSION = '4.3'; // número do pacote de atualização (sempre maior que qualquer beta antiga)\\nconst APP_CHANNEL = '';  // '' = versão final (sem selo). Para voltar ao teste, escreva 'Beta'\\n// Contato para pedidos de remoção (aparece em \\\"Direitos e marcas\\\"). Ex.: 'contato@seudominio.com'\\n// Enquanto estiver vazio, esse trecho não é exibido.\\nconst SUPPORT_CONTACT = '';\\n// ====================\\n\\n// Modo desenvolvedor: só quando o app roda pelo código (npm start / electron .).\\n// No .exe gerado, as opções de desenvolvedor (atualizar arquivos, pasta do app, F12) não existem.\\nconst DEV = !app.isPackaged;\\n\\n// Ícone do app: definido por você (desenvolvedor), não pelo usuário.\\n// Para trocar, coloque \\\"icone.png\\\" (ou .jpg/.ico) na pasta do projeto ANTES de gerar o .exe.\\n// Sem arquivo, usa o ícone padrão do PokeLink (o elo dourado).\\nconst ICON_MIME = { png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', ico: 'image/x-icon' };\\nfunction customIconPath() {\\n  for (const ext of Object.keys(ICON_MIME)) {\\n    const f = path.join(__dirname, 'icone.' + ext);\\n    try { if (fs.statSync(f).isFile()) return f; } catch {}\\n  }\\n  return null;\\n}\\n// a imagem vai para a barra já embutida (data:), assim não depende de caminho de pasta\\nfunction customIconUrl() {\\n  const f = customIconPath();\\n  if (!f) return null;\\n  try {\\n    const buf = fs.readFileSync(f);\\n    return `data:${ICON_MIME[path.extname(f).slice(1).toLowerCase()]};base64,${buf.toString('base64')}`;\\n  } catch { return null; }\\n}\\nfunction applyWindowIcon() {\\n  const f = customIconPath();\\n  if (!f || !win) return;\\n  const img = nativeImage.createFromPath(f);\\n  if (!img.isEmpty()) win.setIcon(img);\\n}\\n\\nconst BAR_H = 28; // cabeçalho fino de cada telinha da grade\\nconst ZOOM_BAR_H = 64; // modo Ampliado: faixa de abas das contas (36) + cabeçalho da conta (28)\\nconst GAP_BG = '#0f0f11'; // cor do vão entre as telas e do fundo da janela\\n// barra de título customizada (substitui a barra de menu nativa do Windows)\\nconst TITLE_H = 34;\\nconst LEFT_W = 240;  // modo Ampliar: lista de contas, à esquerda\\nconst RIGHT_W = 260; // modo Ampliar: painel Otimizar, à direita\\nconst HANDLE_W = 52; // largura de cada painel quando está recolhido (barra de ícones, como no IdleDeck)\\nconst BOTTOM_H = 34; // altura da barra de baixo (layout da grade, modos e uso geral de CPU/memória)\\nlet leftOpen = true, rightOpen = true; // os painéis começam abertos; usuário pode recolher pra ganhar espaço pro jogo\\nlet selecionado = 0; // qual conta o painel da direita mostra quando está na grade (fora do modo Ampliar)\\n// jeito de arrumar as 4 telas na grade: 'grade' (2x2) · 'principal' (1 grande + 3 pequenas) · 'colunas' (4 lado a lado)\\nconst GRADE_MODOS = ['grade', 'principal', 'colunas'];\\nlet gradeModo = 'grade';\\nlet gradeCarregado = false;\\nconst gradeFile = () => path.join(app.getPath('userData'), 'layout.json');\\nfunction gradeAtual() {\\n  if (!gradeCarregado) {\\n    gradeCarregado = true;\\n    try { const j = JSON.parse(fs.readFileSync(gradeFile(), 'utf8')); if (GRADE_MODOS.includes(j.modo)) gradeModo = j.modo; } catch {}\\n  }\\n  return gradeModo;\\n}\\nfunction gradeSalvar() { try { fs.writeFileSync(gradeFile(), JSON.stringify({ modo: gradeModo })); } catch {} }\\n// posição de cada conta dentro da área da grade (W x H), conforme o modo escolhido\\nfunction gradeRects(modo, W, H, GAP) {\\n  const n = ACCOUNTS.length;\\n  const rs = [];\\n  if (modo === 'colunas') {\\n    const cw = Math.floor((W - GAP * (n - 1)) / n);\\n    for (let i = 0; i < n; i++) { const x = i * (cw + GAP); rs.push({ x, y: 0, w: i === n - 1 ? W - x : cw, h: H }); }\\n    return rs;\\n  }\\n  if (modo === 'principal') {\\n    const p = selecionado >= 0 && selecionado < n ? selecionado : 0; // a conta selecionada vira a grande\\n    const mw = Math.floor((W - GAP) * 0.62);\\n    const rw = W - GAP - mw;\\n    const outros = [...Array(n).keys()].filter((i) => i !== p);\\n    const k = outros.length;\\n    const ch = Math.floor((H - GAP * (k - 1)) / k);\\n    rs[p] = { x: 0, y: 0, w: mw, h: H };\\n    outros.forEach((i, j) => { const y = j * (ch + GAP); rs[i] = { x: mw + GAP, y, w: rw, h: j === k - 1 ? H - y : ch }; });\\n    return rs;\\n  }\\n  const w = Math.floor((W - GAP) / 2), h = Math.floor((H - GAP) / 2);\\n  for (let i = 0; i < n; i++) {\\n    const col = i % 2, row = Math.floor(i / 2);\\n    rs.push({ x: col * (w + GAP), y: row ? h + GAP : 0, w: col ? W - GAP - w : w, h: row ? H - GAP - h : h }); // a última coluna/linha absorve a sobra\\n  }\\n  return rs;\\n}\\nconst TITLE_BG = '#17171a';   // precisa ser cor sólida e IGUAL ao fundo da barra de título (#tb no bar.html): o Windows pinta os botões min/max/fechar com ela\\nconst TITLE_FG = '#ffffff';\\nlet titleBar = null;\\nlet menuOpen = false; // com um menu aberto, a barra de título cobre a janela toda (transparente)\\nlet appMenu = null;\\nlet win;\\nlet bars = [];\\nlet views = [];\\nlet focused = -1; // -1 = grade 2x2, 0..3 = tela cheia de uma conta\\nconst level = ACCOUNTS.map(() => 0); // 0 normal, 1 ECO, 2 ECO MAX, 3 dormindo\\nconst ecoCss = ACCOUNTS.map(() => null);\\n\\n// ---------- Zoom (largura \\\"virtual\\\" do jogo) ----------\\nlet REF_WIDTH = 1920; // modo ampliado: o jogo é desenhado como se a janela dele tivesse esta largura\\nlet REF_GRADE = 1400; // grade: idem, só que menor = jogo maior nas telinhas (o IdleDeck usa algo perto disso)\\nlet zoomMax = 0;      // maior zoom aplicado na última arrumação (mostrado na barra de baixo)\\nconst cfgFile = () => path.join(app.getPath('userData'), 'zoom.json');\\nconst barsEdge = false; // true = barras das contas 3 e 4 na borda de baixo da janela; false = todas em cima (como no IdleDeck)\\nfunction loadRef() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(cfgFile(), 'utf8'));\\n    REF_WIDTH = j.ref || REF_WIDTH;\\n    REF_GRADE = j.refGrade || REF_GRADE;\\n  } catch {}\\n}\\nfunction saveCfg() {\\n  try { fs.writeFileSync(cfgFile(), JSON.stringify({ ref: REF_WIDTH, refGrade: REF_GRADE })); } catch {}\\n}\\nfunction changeRef(delta) {\\n  // ajusta o tamanho do jogo do modo em que você está: grade (telinhas) ou ampliado\\n  const ajusta = (v) => Math.min(2600, Math.max(900, v + delta));\\n  if (focused === -1) REF_GRADE = ajusta(REF_GRADE); else REF_WIDTH = ajusta(REF_WIDTH);\\n  saveCfg();\\n  layout();\\n  sendBottomBar();\\n}\\n// 'top' = barra em cima do jogo | 'bottom' = barra embaixo do jogo\\nfunction barPos(i) {\\n  return focused === -1 && barsEdge && i >= 2 ? 'bottom' : 'top';\\n}\\nfunction applyZoom(v, width) {\\n  const z = width / (focused === -1 ? REF_GRADE : REF_WIDTH);\\n  if (!isFinite(z) || z <= 0) return; // janela minimizada / em transição\\n  zoomMax = Math.max(zoomMax, z);\\n  v.webContents.setZoomFactor(z);\\n}\\n\\n// ---------- Layout ----------\\nfunction layout() {\\n  if (tela.off) return; // tela apagada: as páginas ficam fora da janela até você voltar\\n  if (!win || win.isDestroyed() || bars.length < ACCOUNTS.length) return;\\n  const { width, height: fullH } = win.getContentBounds();\\n  const top = titleH();\\n  const height = fullH - top - BOTTOM_H;\\n  if (width < 100 || height < 100) return;\\n  if (titleBar) {\\n    titleBar.setVisible(top > 0);\\n    titleBar.setBounds({ x: 0, y: 0, width, height: menuOpen || dialogOpen ? fullH : TITLE_H });\\n  }\\n  // os dois painéis (lista + Otimizar) ficam reservados sempre, tanto na grade quanto ampliado\\n  const lw = leftOpen ? LEFT_W : HANDLE_W;\\n  const rw = rightOpen ? RIGHT_W : HANDLE_W;\\n  const GAP = 10; // respiro escuro entre as 4 telinhas da grade, pra separar elas visualmente\\n  const gridW = width - lw - rw;\\n  const rects = gradeRects(gradeAtual(), gridW, height, GAP);\\n  zoomMax = 0;\\n  views.forEach((v, i) => {\\n    const grid = focused === -1;\\n    if (!grid && focused !== i) { // modo ampliado: esconde as outras contas\\n      v.setVisible(false);\\n      bars[i].setVisible(false);\\n      return;\\n    }\\n    const r = grid ? rects[i] : null;\\n    const x = lw + (grid ? r.x : 0); // sempre desloca pra abrir espaço da lista à esquerda\\n    const y = (grid ? r.y : 0) + top;\\n    const bw = grid ? r.w : gridW;\\n    const bh = grid ? r.h : height;\\n    // grade: cabeçalho de 1 linha (em cima ou embaixo, como a conta preferir). Ampliado: faixa de abas das contas +\\n    // cabeçalho da conta, sempre em cima (como no IdleDeck); o resto da automação mora no painel da direita\\n    const barH = grid ? BAR_H : ZOOM_BAR_H;\\n    const bottom = grid && barPos(i) === 'bottom';\\n    bars[i].setVisible(true);\\n    bars[i].setBounds({ x, y: bottom ? y + bh - barH : y, width: bw, height: barH });\\n    if (level[i] === 3) { detachView(i); return; } // hibernando: só a barra fica\\n    attachView(i);\\n    v.setVisible(true);\\n    const area = { x, y: bottom ? y : y + barH, width: bw, height: bh - barH };\\n    v.setBounds(area);\\n    applyZoom(v, bw);\\n  });\\n  // lista de contas à esquerda, Otimizar à direita — sempre visíveis (ou só a setinha, se recolhidos)\\n  const s = sidebarView();\\n  s.setVisible(true);\\n  s.setBounds({ x: 0, y: top, width: lw, height });\\n  win.contentView.addChildView(s);\\n  const o = otimSideView();\\n  o.setVisible(true);\\n  o.setBounds({ x: width - rw, y: top, width: rw, height });\\n  win.contentView.addChildView(o);\\n  const bb = bottomBarView();\\n  bb.setVisible(true);\\n  bb.setBounds({ x: 0, y: top + height, width, height: BOTTOM_H });\\n  win.contentView.addChildView(bb);\\n  if (titleBar) win.contentView.addChildView(titleBar);\\n  // Mega Eco (todas as contas): um painel só cobre as 4 telas; os jogos continuam rodando por baixo\\n  if (megaEco()) {\\n    const d = dashView();\\n    d.setVisible(true);\\n    d.setBounds({ x: 0, y: top, width, height });\\n    // uma tela reanexada iria para cima do painel: traz o painel (e os menus) de volta para o topo\\n    win.contentView.addChildView(d);\\n    if (titleBar) win.contentView.addChildView(titleBar);\\n  }\\n  else if (dash && !dash.webContents.isDestroyed()) dash.setVisible(false);\\n}\\n\\n// em tela cheia (F11) a barra de título some, como no Windows\\nfunction titleH() {\\n  return titleBar && !win.isFullScreen() ? TITLE_H : 0;\\n}\\n\\n// Hibernar TIRA a conta da janela (em vez de só escondê-la) e, ao voltar, coloca de novo.\\n// Só esconder com setVisible deixava a área da conta vazia/cinza ao voltar em alguns PCs.\\nconst attached = ACCOUNTS.map(() => true);\\nfunction detachView(i) {\\n  if (!attached[i]) return;\\n  try { win.contentView.removeChildView(views[i]); } catch {}\\n  attached[i] = false;\\n}\\nfunction attachView(i) {\\n  if (attached[i]) return;\\n  win.contentView.addChildView(views[i]);\\n  attached[i] = true;\\n  // a barra de título (menus e pop-ups) precisa continuar por cima de tudo\\n  if (titleBar) win.contentView.addChildView(titleBar);\\n}\\n\\nfunction setFocus(n) {\\n  focused = n;\\n  layout();\\n  sendState();\\n  sendTitleFoco();\\n}\\n// manda pra barra de título a lista de contas (nome + memória) e qual está ampliada agora,\\n// pra ela desenhar a barra lateral do modo Ampliar\\nfunction sendTitleFoco() {\\n  const dados = {\\n    focused, leftOpen, rightOpen,\\n    atual: focused !== -1 ? focused : selecionado, // de qual conta mostrar os detalhes\\n    grade: focused === -1,\\n    contas: ACCOUNTS.map((_, i) => {\\n      const u = usageOf(i);\\n      return { nome: nameOf(i), mem: u ? Math.round(u.mem) : null, modo: level[i] };\\n    }),\\n  };\\n  if (sidebar && !sidebar.webContents.isDestroyed()) sidebar.webContents.send('title-foco', dados);\\n  if (otimSide && !otimSide.webContents.isDestroyed()) otimSide.webContents.send('title-foco', dados);\\n}\\nipcMain.on('layout-set', (_, modo) => {\\n  if (typeof modo === 'string' && modo.startsWith('gear:')) { try { abrirEngrenagem(JSON.parse(modo.slice(5))); } catch {} return; } // caminho reserva (preload antigo)\\n  if (modo === 'tam:mais') { changeRef(-100); return; }  // jogo maior (a janela virtual do jogo fica mais estreita)\\n  if (modo === 'tam:menos') { changeRef(100); return; } // jogo menor (mostra mais coisas de uma vez)\\n  if (modo === 'ampliado') { setFocus(focused !== -1 ? -1 : selecionado); return; } // alterna: amplia a conta selecionada / volta pra grade\\n  if (!GRADE_MODOS.includes(modo)) return;\\n  gradeModo = modo; gradeCarregado = true; gradeSalvar();\\n  if (focused !== -1) { setFocus(-1); return; } // estava ampliada: volta pra grade já no modo novo\\n  layout(); sendState(); sendTitleFoco();\\n});\\nipcMain.on('uso-open', () => showUsage());\\nipcMain.on('sidelado-toggle', (_, lado) => {\\n  if (lado === 'left') leftOpen = !leftOpen; else if (lado === 'right') rightOpen = !rightOpen; else return;\\n  layout();\\n  sendTitleFoco();\\n});\\nipcMain.on('conta-selecionar', (_, i) => {\\n  if (!Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return;\\n  selecionado = i;\\n  if (focused === -1 && gradeAtual() === 'principal') layout();\\n  sendState();\\n  sendTitleFoco();\\n});\\n\\n// ---------- Níveis de economia ----------\\n// 1 = Eco (~4 fps) | 2 = Super Eco (~1 fps, esconde o mapa/canvas) | 3 = Hibernar (tela escondida)\\nconst ECO_CSS = `\\n  *, *::before, *::after {\\n    animation: none !important;\\n    transition: none !important;\\n    scroll-behavior: auto !important;\\n    filter: none !important;\\n    backdrop-filter: none !important;\\n    box-shadow: none !important;\\n    text-shadow: none !important;\\n  }`;\\nconst MAX_CSS = ` canvas { visibility: hidden !important; }`;\\n\\nconst ecoOn = (ms) => `(() => {\\n  if (window.__eco) return;\\n  const o = { raf: window.requestAnimationFrame, caf: window.cancelAnimationFrame };\\n  window.__eco = o;\\n  window.requestAnimationFrame = (cb) => setTimeout(() => cb(performance.now()), ${ms});\\n  window.cancelAnimationFrame = (id) => { clearTimeout(id); try { o.caf.call(window, id); } catch (e) {} };\\n})()`;\\n\\nconst ECO_OFF = `(() => {\\n  if (!window.__eco) return;\\n  window.requestAnimationFrame = window.__eco.raf;\\n  window.cancelAnimationFrame = window.__eco.caf;\\n  delete window.__eco;\\n})()`;\\n\\n// promessa com limite de tempo: página escondida/pausada pode nunca responder\\nconst withTimeout = (p, ms) => Promise.race([p, new Promise((_, rej) => setTimeout(() => rej(new Error('timeout')), ms))]);\\nconst levelSeq = ACCOUNTS.map(() => 0);\\n\\n// liga/desliga o botão \\\"Modo Economia\\\" do jogo (#hunt-eco), só se o estado atual for diferente\\n// O PokeLink lembra se foi ele que ligou (gameEco) e também tenta ver na tela se a cena da batalha está escondida.\\nconst gameEco = ACCOUNTS.map(() => false);\\nconst GAME_ECO_JS = (on, sabido) => `(() => {\\n const b = document.getElementById('hunt-eco');\\n  const cena = document.getElementById('cena');\\n  // com o Modo Economia ligado, o jogo mostra o botão \\\"LIGAR A CENA\\\"\\n  const ligarCena = [...document.querySelectorAll('button, [role=button]')]\\n    .find((e) => /ligar a cena/i.test(e.textContent || '') && e.getClientRects().length);\\n  let ligado = ligarCena ? true : null;\\n  if (ligado === null && b && (b.classList.contains('on') || b.classList.contains('ativo') || b.classList.contains('active') || b.getAttribute('aria-pressed') === 'true')) ligado = true;\\n  else if (/\\\\\\\\beco|economia/i.test(document.body.className || '')) ligado = true;\\n  else if (cena) { const cs = getComputedStyle(cena); ligado = cena.getClientRects().length === 0 || cs.display === 'none' || cs.visibility === 'hidden'; }\\n  if (ligado === null) ligado = ${sabido ? 'true' : 'false'};\\n  if (ligado === ${on ? 'true' : 'false'}) return 'ok';\\n  if (!${on ? 'true' : 'false'} && ligarCena) { ligarCena.click(); return 'trocou'; }\\n  if (b) { b.click(); return 'trocou'; }\\n  return 'sem botão';\\n})()`;\\n\\n// ---------- Modo Ampliar: lista de contas (esquerda) e Otimizar (direita) ----------\\nlet sidebar = null; // lista de contas, à esquerda\\nfunction sidebarView() {\\n  if (sidebar && !sidebar.webContents.isDestroyed()) return sidebar;\\n  sidebar = new WebContentsView({ webPreferences: { preload: path.join(__dirname, 'preload.js') } });\\n  sidebar.setBackgroundColor('#0f0f11');\\n  sidebar.webContents.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'sidebar' } });\\n  win.contentView.addChildView(sidebar);\\n  if (titleBar) win.contentView.addChildView(titleBar); // menus e pop-ups continuam por cima\\n  return sidebar;\\n}\\nlet otimSide = null; // painel Otimizar, à direita\\nfunction otimSideView() {\\n  if (otimSide && !otimSide.webContents.isDestroyed()) return otimSide;\\n  otimSide = new WebContentsView({ webPreferences: { preload: path.join(__dirname, 'preload.js') } });\\n  otimSide.setBackgroundColor('#141417');\\n  otimSide.webContents.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'otimside' } });\\n  win.contentView.addChildView(otimSide);\\n  if (titleBar) win.contentView.addChildView(titleBar);\\n  return otimSide;\\n}\\n\\nlet bottomBar = null; // barra de baixo: uso geral de CPU/memória\\nfunction bottomBarView() {\\n  if (bottomBar && !bottomBar.webContents.isDestroyed()) return bottomBar;\\n  bottomBar = new WebContentsView({ webPreferences: { preload: path.join(__dirname, 'preload.js') } });\\n  bottomBar.setBackgroundColor('#0f0f11');\\n  bottomBar.webContents.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'bottombar' } });\\n  win.contentView.addChildView(bottomBar);\\n  if (titleBar) win.contentView.addChildView(titleBar);\\n  return bottomBar;\\n}\\nfunction sendBottomBar() {\\n  if (!bottomBar || bottomBar.webContents.isDestroyed()) return;\\n  const nivel = level.find((l) => l !== 3);\\n  bottomBar.webContents.send('uso-total', {\\n    cpu: Math.round(usage.total.cpu), mem: Math.round(usage.total.mem),\\n    memTotal: Math.round(osMod.totalmem() / 1048576),\\n    layout: gradeAtual(), focused: focused !== -1, nivel: nivel == null ? 0 : nivel, zoom: Math.round(zoomMax * 100),\\n    versao: APP_LABEL, canal: APP_CHANNEL,\\n  });\\n}\\n\\n// ---------- Mega Eco: um painel com o resumo do farm das 4 contas ----------\\n// Vale para todas as contas ao mesmo tempo: os jogos ficam em Modo Economia e continuam rodando,\\n// e um painel único com o resumo de cada conta cobre as telas.\\nconst megaEco = () => level.every((l) => l === 2);\\nlet dash = null;\\nfunction dashView() {\\n  if (dash && !dash.webContents.isDestroyed()) return dash;\\n  dash = new WebContentsView({ webPreferences: { preload: path.join(__dirname, 'preload.js') } });\\n  dash.setBackgroundColor('#0d0d0f');\\n  dash.webContents.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'resumo' } });\\n  win.contentView.addChildView(dash);\\n  if (titleBar) win.contentView.addChildView(titleBar); // menus e pop-ups continuam por cima\\n  return dash;\\n}\\n// lê da página do jogo tudo o que o resumo mostra\\n// Lê a tela do \\\"Modo Economia\\\" do próprio jogo (números da sessão, gastos, achados, capturas e itens).\\n// É uma função normal: vai para dentro da página do jogo como texto (ecoScrape.toString()).\\nfunction ecoScrape() {\\n  const raiz = document.getElementById('eco-painel') || document.body;\\n  const vis = (e) => !!(e && e.getClientRects().length);\\n  let rotulos = null; // lista montada uma vez só por leitura\\n  const label = (re) => (rotulos || (rotulos = [...raiz.querySelectorAll('div,span,h2,h3,h4,b,small,p,strong')]\\n    .filter((e) => e.children.length <= 2 && (e.textContent || '').length < 40)))\\n    .find((e) => re.test((e.textContent || '').trim()) && vis(e));\\n  const linhas = (e) => (e && e.innerText ? e.innerText : '').split('\\\\n').map((x) => x.trim()).filter(Boolean);\\n  const tile = (re) => {\\n    const l = label(re);\\n    if (!l) return null;\\n    let box = l.parentElement;\\n    for (let k = 0; k < 3 && box && linhas(box).length < 3; k++) box = box.parentElement;\\n    return box ? linhas(box).slice(0, 5) : null;\\n  };\\n  const icones = (box) => [...box.querySelectorAll('img')].map((im) => {\\n    let b = im.parentElement;\\n    for (let k = 0; k < 3 && b && !/\\\\d/.test(b.textContent || ''); k++) b = b.parentElement;\\n    const m = b && (b.textContent || '').replace(/\\\\s+/g, ' ').match(/×?\\\\s*([\\\\d.]+)/);\\n    return { img: im.src, n: m ? m[1] : '' };\\n  }).filter((x) => x.img && x.n);\\n  // ícones de um grupo (Achados, Gastos): só os que vêm depois do título e antes do próximo título\\n  const grupo = (re, reProx) => {\\n    const l = label(re);\\n    if (!l) return [];\\n    let box = l.parentElement;\\n    for (let k = 0; k < 3 && box && !box.querySelector('img'); k++) box = box.parentElement;\\n    if (!box) return [];\\n    const prox = reProx ? label(reProx) : null;\\n    const depois = (a, b) => !!(a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING);\\n    const lista = icones(box).filter((x) => {\\n      const im = [...box.querySelectorAll('img')].find((i) => i.src === x.img);\\n      return im && depois(l, im) && (!prox || !box.contains(prox) || depois(im, prox));\\n    });\\n    return lista.slice(0, 10);\\n  };\\n  // cartões de captura: imagem + \\\"Nv\\\" + horário, sem pegar os blocos que contêm vários cartões\\n  const cards = raiz.querySelector('li.cap-card') ? [] : [...raiz.querySelectorAll('div, li, article')].filter((e) => {\\n    if ((e.textContent || '').length > 160 || !e.querySelector('img') || !vis(e)) return false;\\n    const t = e.innerText || '';\\n    return /Nv\\\\s*\\\\d+/.test(t) && /(?<!\\\\d)\\\\d{1,2}:\\\\d{2}(?!\\\\d)/.test(t) &&\\n      /\\\\bIV\\\\s*\\\\d/.test(t) && /\\\\bQ\\\\s*[\\\\d,]/.test(t) && !/an[uú]ncio|\\\\[\\\\d+\\\\]:/i.test(t);\\n  });\\n  const corta = (el, t) => {\\n    try {\\n      const w = el.naturalWidth || el.width, h = el.naturalHeight || el.height;\\n      if (!w || !h) return null;\\n      const o = document.createElement('canvas'); o.width = w; o.height = h;\\n      const og = o.getContext('2d'); og.drawImage(el, 0, 0);\\n      let x0 = w, y0 = h, x1 = -1, y1 = -1;\\n      const px = og.getImageData(0, 0, w, h).data;\\n      for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) if (px[(y * w + x) * 4 + 3] > 16) { if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y; }\\n      if (x1 < 0) { x0 = 0; y0 = 0; x1 = w - 1; y1 = h - 1; }\\n      const cw = x1 - x0 + 1, ch = y1 - y0 + 1, m = Math.round(t * 0.06), k = Math.min((t - 2 * m) / cw, (t - 2 * m) / ch);\\n      const cv = document.createElement('canvas'); cv.width = t; cv.height = t;\\n      const g = cv.getContext('2d'); g.imageSmoothingEnabled = false;\\n      g.drawImage(o, x0, y0, cw, ch, (t - cw * k) / 2, (t - ch * k) / 2, cw * k, ch * k);\\n      return cv.toDataURL('image/png');\\n    } catch (e) { return null; }\\n  };\\n  const figura = (c) => {\\n    const im = c.querySelector('img, canvas');\\n    if (im) { const r = corta(im, 48); if (r) return r; }\\n    if (im && im.src && /^https?:/.test(im.src)) return im.src;\\n    const bg = [c, ...c.querySelectorAll('*')].map((e) => getComputedStyle(e).backgroundImage).find((b) => /url\\\\(/.test(b || ''));\\n    const m = bg && bg.match(/url\\\\([\\\"']?([^\\\"')]+)/);\\n    return m ? m[1] : (im && im.src) || null;\\n  };\\n  const capCards = [...raiz.querySelectorAll('li.cap-card')].slice(0, 6);\\n  if (capCards.length) {\\n    const t = (c, q) => ((c.querySelector(q) || {}).textContent || '').trim();\\n    var capsNovas = capCards.map((c) => {\\n      const ic = c.querySelector('.cap-retrato canvas, .cap-retrato img');\\n      const chave = [t(c, '.cap-nome'), t(c, '.cap-nv'), t(c, '.cap-hora')].join('|');\\n      const cache = window.__plFig || (window.__plFig = new Map());\\n      let img = cache.get(chave) || null;\\n      if (!img && ic) {\\n        img = figura(c.querySelector('.cap-retrato') || c);\\n        if (img) { cache.set(chave, img); if (cache.size > 60) cache.delete(cache.keys().next().value); }\\n      }\\n      const selos = [...c.querySelectorAll('.cap-selos .cm-pot, .cap-selos .pk-selo')].map((e) => (e.textContent || '').trim()).filter(Boolean);\\n      return { img, linhas: [t(c, '.cap-nome'), t(c, '.cap-nv'), t(c, '.cap-hora'), ...selos].filter(Boolean) };\\n    });\\n  }\\n  const caps = capsNovas || cards.filter((c) => !cards.some((o) => o !== c && c.contains(o))).slice(0, 6).map((c) => ({\\n    img: figura(c),\\n    linhas: linhas(c).slice(0, 8),\\n  }));\\n  // itens do painel \\\"Itens\\\" (texto \\\"×64.866\\\")\\n  const itens = [];\\n  for (const im of raiz.querySelectorAll('img')) {\\n    const b = im.parentElement;\\n    const m = b && (b.textContent || '').trim().match(/^×\\\\s*([\\\\d.]+)$/);\\n    if (m && vis(im) && !itens.some((x) => x.img === im.src)) itens.push({ img: im.src, n: m[1] });\\n  }\\n  // ACHADOS · HUNT: quadrinhos \\\"VISTOS\\\" e \\\"PEGOS\\\" (shiny); o número fica na bolinha do quadrinho (sem bolinha = 0)\\n  const shinyDe = (re, outro) => {\\n    const rot = [...raiz.querySelectorAll('div,span,small,b,p,button,label')]\\n      .filter((e) => e.children.length === 0 && re.test((e.textContent || '').trim()));\\n    const l = rot.find(vis);\\n    if (!l) return null;\\n    let box = l, k = 0;\\n    while (k < 4 && box.parentElement && !outro.test(box.parentElement.textContent || '')) { box = box.parentElement; k++; }\\n    const resto = (box.innerText || '').replace(/vistos|pegos/ig, '');\\n    const m = resto.match(/\\\\d[\\\\d.]*/);\\n    return m ? Number(m[0].replace(/\\\\./g, '')) || 0 : 0;\\n  };\\n  const slot = (tit) => {\\n    const e = document.querySelector(`#eco-achados .eco-slot-shiny[title=\\\"${tit}\\\"]`);\\n    if (!e || !e.getClientRects().length) return null; // quadrinho fora da tela (ex.: conta em Normal): não dá para saber\\n    const m = (e.innerText || '').replace(/vistos|pegos/ig, '').match(/\\\\d[\\\\d.]*/); // innerText ignora números escondidos\\n    return m ? Number(m[0].replace(/\\\\./g, '')) || 0 : 0;\\n  };\\n  const sv = slot('Shinies vistos'), sp = slot('Shinies capturados');\\n  let shiny = sv != null || sp != null ? { vistos: sv || 0, pegos: sp || 0 } : { vistos: shinyDe(/^vistos$/i, /pegos/i), pegos: shinyDe(/^pegos$/i, /vistos/i) };\\n  if (shiny.vistos == null && shiny.pegos == null) shiny = null; // não deu para ler agora\\n  const tempo = ((raiz.innerText || '').match(/(?<![\\\\d:])(\\\\d{1,2}:\\\\d{2}:\\\\d{2})(?![\\\\d:])/) || [])[1] || '';\\n  return {\\n    xpT: tile(/^XP TREINADOR$/i), xpP: tile(/^XP POKÉMON$/i), lucro: tile(/^LUCRO LÍQUIDO$/i),\\n    abates: tile(/^ABATES$/i), capturas: tile(/^CAPTURAS$/i),\\n    gastos: grupo(/^GASTOS$/i), achados: grupo(/^ACHADOS/i, /^GASTOS$/i), caps, itens: itens.slice(0, 12), tempo, shiny,\\n  };\\n}\\n\\n// Perfil do treinador (cartão com o nick): barra de XP \\\"360.605.664 / 364.365.100 xp\\\" e o ícone.\\n// Função normal: vai para dentro da página do jogo como texto (trPerfil.toString()).\\nfunction trPerfil() {\\n  const nick = document.getElementById('tr-nick');\\n  if (!nick) return null;\\n  const miniatura = (el, t) => {\\n    try {\\n      const w = el.naturalWidth || el.width, h = el.naturalHeight || el.height;\\n      if (!w || !h) return null;\\n      const o = document.createElement('canvas'); o.width = w; o.height = h;\\n      const og = o.getContext('2d'); og.drawImage(el, 0, 0);\\n      let x0 = w, y0 = h, x1 = -1, y1 = -1;\\n      const px = og.getImageData(0, 0, w, h).data;\\n      for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) if (px[(y * w + x) * 4 + 3] > 16) { if (x < x0) x0 = x; if (x > x1) x1 = x; if (y < y0) y0 = y; if (y > y1) y1 = y; }\\n      if (x1 < 0) { x0 = 0; y0 = 0; x1 = w - 1; y1 = h - 1; }\\n      const cw = x1 - x0 + 1, ch = y1 - y0 + 1, m = Math.round(t * 0.06), k = Math.min((t - 2 * m) / cw, (t - 2 * m) / ch);\\n      const cv = document.createElement('canvas'); cv.width = t; cv.height = t;\\n      const g = cv.getContext('2d'); g.imageSmoothingEnabled = false;\\n      g.drawImage(o, x0, y0, cw, ch, (t - cw * k) / 2, (t - ch * k) / 2, cw * k, ch * k);\\n      return cv.toDataURL('image/png');\\n    } catch (e) { return null; }\\n  };\\n  const xpTxt = document.getElementById('tr-xp-txt');\\n  const retrato = document.querySelector('#tr-retrato canvas, #tr-retrato img');\\n  const mx = xpTxt && (xpTxt.textContent || '').match(/(\\\\d{1,3}(?:\\\\.\\\\d{3})*)\\\\s*\\\\/\\\\s*(\\\\d{1,3}(?:\\\\.\\\\d{3})*)/);\\n  if (mx && retrato) {\\n    const c = window.__plAv;\\n    const img = c && c.nick === nick.textContent && Date.now() - c.em < 60000 ? c.img : miniatura(retrato, 64);\\n    window.__plAv = { nick: nick.textContent, em: c && c.img === img ? c.em : Date.now(), img };\\n    return { xp: { atual: Number(mx[1].replace(/\\\\./g, '')), total: Number(mx[2].replace(/\\\\./g, '')) }, img };\\n  }\\n  const re = /(\\\\d{1,3}(?:\\\\.\\\\d{3})*)\\\\s*\\\\/\\\\s*(\\\\d{1,3}(?:\\\\.\\\\d{3})*)\\\\s*xp/i; // números com ponto de milhar (não gruda no nível)\\n  let box = nick, xp = null;\\n  for (let k = 0; k < 5 && !xp; k++) {\\n    if (!box.parentElement || box.parentElement.querySelector('#ativo-card')) break; // não pega a XP do pokémon\\n    box = box.parentElement;\\n    const m = (box.textContent || '').replace(/\\\\s+/g, ' ').match(re);\\n    if (m) xp = { atual: Number(m[1].replace(/\\\\./g, '')), total: Number(m[2].replace(/\\\\./g, '')) };\\n  }\\n  // ícone do perfil: fica à ESQUERDA do nick, então vem ANTES dele na página (a moeda de ouro vem depois)\\n  const urlDe = (e) => {\\n    try {\\n      if (e.tagName === 'CANVAS') return e.width && e.width <= 200 ? e.toDataURL('image/png') : null;\\n      if (e.tagName === 'IMG') {\\n        const w = e.naturalWidth, h = e.naturalHeight;\\n        if (w && h) {\\n          const cv = document.createElement('canvas'); cv.width = 64; cv.height = 64;\\n          const g = cv.getContext('2d'); g.imageSmoothingEnabled = false;\\n          const k = Math.min(64 / w, 64 / h); g.drawImage(e, (64 - w * k) / 2, (64 - h * k) / 2, w * k, h * k);\\n          return cv.toDataURL('image/png');\\n        }\\n        return /^https?:/.test(e.src) ? e.src : null;\\n      }\\n      const m = (getComputedStyle(e).backgroundImage || '').match(/url\\\\([\\\"']?([^\\\"')]+)/);\\n      return m && /^https?:|^data:image/.test(m[1]) ? m[1] : null;\\n    } catch (er) { return /^https?:/.test(e.src || '') ? e.src : null; }\\n  };\\n  const antes = (e) => !!(e.compareDocumentPosition(nick) & Node.DOCUMENT_POSITION_FOLLOWING);\\n  const cands = [...box.querySelectorAll('*')].filter((e) => e !== nick && !e.contains(nick) && antes(e) &&\\n    (e.tagName === 'IMG' || e.tagName === 'CANVAS' || /url\\\\(/.test(getComputedStyle(e).backgroundImage || '')));\\n  let img = null;\\n  for (let k = cands.length - 1; k >= 0 && !img; k--) img = urlDe(cands[k]);\\n  return { xp, img };\\n}\\n\\nconst RESUMO_JS = `(() => {\\n  const q = (s) => document.querySelector(s);\\n  const t = (s) => ((q(s) || {}).textContent || '').trim();\\n  const J = (k) => { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch (e) { return null; } };\\n  const nick = t('#tr-nick');\\n  const key = nick.toLowerCase();\\n  const card = q('#ativo-card');\\n  let sprite = null;\\n  try { const cv = card && card.querySelector('canvas'); if (cv && cv.width) sprite = cv.toDataURL('image/png'); } catch (e) {}\\n  const nomeEl = card && card.querySelector('.ativo-nome');\\n  const pkNome = nomeEl ? [...nomeEl.childNodes].filter((n) => n.nodeType === 3).map((n) => n.textContent).join('').trim() : '';\\n  const ativos = [...document.querySelectorAll('.tr-ativo')].map((a) => ({\\n    nome: ((a.querySelector('.tr-ativo-nome') || {}).textContent || '').trim(),\\n    valor: ((a.querySelector('.tr-ativo-valor') || {}).textContent || '').trim(),\\n    tempo: ((a.querySelector('.tr-ativo-tempo') || {}).textContent || '').trim(),\\n  })).filter((a) => a.nome);\\n  // painel de automação do jogo: interruptores (bola, poção, mapa...) e itens com quantidade\\n  const pa = q('#p-auto');\\n  const auto = [];\\n  const itens = [];\\n  if (pa) {\\n    for (const el of pa.querySelectorAll('input[type=checkbox], [role=switch], [aria-pressed], [aria-checked]')) {\\n      const box = el.closest('label, .auto-item, .toggle, li, div') || el;\\n      const nome = (box.textContent || el.getAttribute('aria-label') || el.title || '').replace(/\\\\\\\\s+/g, ' ').trim().slice(0, 24);\\n      const on = el.type === 'checkbox' ? el.checked : (el.getAttribute('aria-checked') === 'true' || el.getAttribute('aria-pressed') === 'true');\\n      if (nome && !auto.some((x) => x.nome === nome)) auto.push({ nome, on: !!on });\\n    }\\n    for (const im of pa.querySelectorAll('img')) {\\n      let box = im.parentElement;\\n      for (let k = 0; k < 3 && box && !/\\\\\\\\d/.test(box.textContent || ''); k++) box = box.parentElement;\\n      const m = box && (box.textContent || '').replace(/\\\\\\\\s+/g, ' ').match(/([\\\\\\\\d.]{1,9})/);\\n      if (m && im.src && !itens.some((x) => x.img === im.src)) itens.push({ img: im.src, n: m[1], nome: im.alt || im.title || '' });\\n    }\\n  }\\n  const logEl = q('#hud-log');\\n  const log = logEl ? [...logEl.children].slice(-5).map((e) => e.textContent.trim()).filter(Boolean) : [];\\n  return {\\n    auto: auto.slice(0, 8), itens: itens.slice(0, 12),\\n    eco: (() => { try { return (${ecoScrape.toString()})(); } catch (e) { return null; } })(),\\n    perfil: (() => { try { return (${trPerfil.toString()})(); } catch (e) { return null; } })(),\\n    nick, nivel: t('#tr-level'), ouro: t('#tr-gold'), gemas: t('#tr-gemas'), diamantes: t('#tr-diamantes'), guild: t('#tr-guild'),\\n    ativos, hunt: t('#hud-hunt'), log,\\n    pk: { nome: pkNome, lv: t('#ativo-card .pl-lv'), hp: t('#ativo-card .barra.hp span'), xp: t('#ativo-card .barra.xp span'), sprite },\\n    ses: J('sessao-hunt:' + key) || {},\\n    caps: (J('capturas-hist:' + key) || []).slice(0, 8).map((c) => ({ nome: c.nome, lv: c.level, shiny: !!c.shiny, em: c.em, pot: c.potencia })),\\n  };\\n})()`;\\nlet dashLendo = false;\\nasync function refreshDash() {\\n  if (!megaEco() || !dash || dash.webContents.isDestroyed() || dashLendo) return;\\n  dashLendo = true;\\n  try {\\n  const contas = await Promise.all(views.map(async (v, i) => {\\n    let d = null;\\n    try { d = await withTimeout(v.webContents.executeJavaScript(RESUMO_JS), 4000); } catch {}\\n    return Object.assign({ conta: i, nome: nameOf(i) }, d || { erro: true });\\n  }));\\n  if (!dash.webContents.isDestroyed()) dash.webContents.send('resumo', { at: Date.now(), contas });\\n  } finally { dashLendo = false; }\\n}\\nconst refreshResumo = () => refreshDash();\\nipcMain.on('resumo-ready', () => refreshDash());\\n// botões do painel: \\\"Normal\\\", \\\"Ver os jogos (Eco)\\\" ou abrir uma conta\\n// botão \\\"Ligar a cena\\\" de cada conta: troca só aquela conta entre Eco e Normal\\nipcMain.on('cena-toggle', (_, i) => {\\n  if (!Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return;\\n  setLevel(i, level[i] === 1 ? 0 : 1, true);\\n  buildMenu();\\n});\\n// modo de desempenho: vale para as 4 contas (menu \\\"Desempenho\\\" da barra de cima)\\nfunction setAllLevel(lv) {\\n  if (!(lv >= 0 && lv <= 2)) return;\\n  ACCOUNTS.forEach((_, k) => setLevel(k, lv, true));\\n  if (lv === 2) setFocus(-1);\\n  layout();\\n  buildMenu();\\n  refreshDash();\\n}\\nipcMain.on('resumo-nivel', (_, i, lv) => {\\n  setAllLevel(lv);\\n  if (Number.isInteger(i) && i >= 0 && i < ACCOUNTS.length) setFocus(i);\\n});\\n\\nasync function applyLevel(i, waking) {\\n  const wc = views[i].webContents;\\n  if (wc.isDestroyed()) return;\\n  const lv = level[i];\\n  const seq = ++levelSeq[i]; // se o nível mudar de novo no meio, esta aplicação para\\n\\n  // 1) PRIMEIRO mostra/esconde a tela. Antes isso ficava no fim, depois de rodar scripts na página;\\n  //    vindo do Hibernar, a página pausada podia não responder e a tela nunca voltava (ficava preta).\\n  wc.setBackgroundThrottling(lv === 3); // hibernando: deixa o Chromium pausar a página escondida\\n  layout();\\n  if (waking) {\\n    // Depois de hibernar, o jogo pode não voltar a se desenhar sozinho (tela vazia).\\n    // Recarregar a conta garante que ela volta funcionando; o nível é reaplicado no dom-ready.\\n    ecoCss[i] = null;\\n    wc.reload();\\n    return;\\n  }\\n  if (lv !== 3) { try { wc.invalidate(); } catch {} } // força redesenhar\\n\\n  // 2) depois ajusta a página (efeitos/quadros), sem travar se ela demorar\\n  try {\\n    // limpa ajustes de versões antigas do PokeLink (se houver)\\n    if (ecoCss[i]) { const k = ecoCss[i]; ecoCss[i] = null; await withTimeout(wc.removeInsertedCSS(k), 3000); }\\n    await withTimeout(wc.executeJavaScript(ECO_OFF), 3000);\\n    if (seq !== levelSeq[i]) return;\\n    // Eco e Mega Eco: liga o \\\"Modo Economia\\\" do próprio jogo; Normal: desliga\\n    const querEco = lv === 1 || lv === 2;\\n    const r = await withTimeout(wc.executeJavaScript(GAME_ECO_JS(querEco, gameEco[i])), 3000);\\n    if (r === 'ok' || r === 'trocou') gameEco[i] = querEco;\\n  } catch {}\\n  if (lv === 2) refreshResumo(i);\\n\\n}\\n\\nfunction sendState() {\\n  const estado = {\\n    level, names: displayNames(), focused, sel: selecionado, muted, pos: ACCOUNTS.map((_, i) => barPos(i)),\\n    auto: { enabled: auto.enabled, dry: auto.contas.map((c) => c.dry), status: autoStatus },\\n    lives: livesState(),\\n    loading,\\n    extBtns: EXTENSIONS.filter((e) => e.botao && !extOff.has(e.id)).map((e) => ({ id: e.id, botao: e.botao, nome: e.nome })),\\n    hunt: { on: autoHunt.contas, status: huntStatus },\\n    celular: monitor.ligado,\\n    mem: ACCOUNTS.map((_, i) => { const u = usageOf(i); return u ? Math.round(u.mem) : null; }),\\n  };\\n  bars.forEach((b) => { if (!b.webContents.isDestroyed()) b.webContents.send('state', estado); });\\n  sendBottomBar();\\n  if (otimSide && !otimSide.webContents.isDestroyed()) otimSide.webContents.send('state', estado);\\n}\\n\\nipcMain.on('bar-ready', sendState);\\n// ----- medição de uso (CPU e memória) de cada conta, para ver se o modo de desempenho faz diferença -----\\nconst usage = { porPid: new Map(), total: { cpu: 0, mem: 0 }, gpu: { cpu: 0, mem: 0 }, lista: [] };\\n// memória \\\"própria\\\" de cada processo (a mesma que o Gerenciador de Tarefas mostra). Antes somava a memória\\n// compartilhada entre os processos várias vezes, e o total aparecia bem maior do que o real.\\nconst memDe = (m) => (m.memory.privateBytes || m.memory.workingSetSize) / 1024;\\nfunction sampleUsage() {\\n  try {\\n    const ms = app.getAppMetrics();\\n    usage.lista = ms;\\n    usage.porPid = new Map(ms.map((m) => [m.pid, { cpu: m.cpu.percentCPUUsage, mem: memDe(m) }]));\\n    usage.total = ms.reduce((t, m) => ({ cpu: t.cpu + m.cpu.percentCPUUsage, mem: t.mem + memDe(m) }), { cpu: 0, mem: 0 });\\n    const g = ms.find((m) => m.type === 'GPU');\\n    usage.gpu = g ? { cpu: g.cpu.percentCPUUsage, mem: memDe(g) } : { cpu: 0, mem: 0 };\\n  } catch {}\\n}\\nfunction usageOf(i) {\\n  const wc = views[i] && views[i].webContents;\\n  if (!wc || wc.isDestroyed()) return null;\\n  try { return usage.porPid.get(wc.getOSProcessId()) || null; } catch { return null; }\\n}\\nconst fmtUso = (u) => (u ? `CPU ${u.cpu.toFixed(0)}% · ${Math.round(u.mem)} MB` : 'medindo...');\\n\\nconst LEVELS = [\\n  { name: 'Normal', desc: 'o jogo como ele é, sem nada desligado' },\\n  { name: 'Eco', desc: 'liga o Modo Economia do próprio jogo (desliga a cena da batalha)' },\\n  { name: 'Mega Eco', desc: 'todas as contas: troca as telas por um painel com o resumo do farm; os jogos continuam rodando' },\\n];\\n// medidor: junta o uso de cada conta e de cada grupo, com o nível (ok / médio / alto)\\nconst FAIXAS = { conta: [400, 700], jogo: [1600, 2800], kick: [200, 350], twitch: [60, 150], barras: [300, 500], gpu: [600, 1000], outros: [500, 900], total: [3000, 5000] };\\nfunction nivelDe(mem, faixa, cpu, cpuF = [20, 50]) {\\n  const n = (v, [x, y]) => (v >= y ? 2 : v >= x ? 1 : 0);\\n  return ['ok', 'medio', 'alto'][Math.max(n(mem, faixa), n(cpu || 0, cpuF))];\\n}\\nfunction usoDados() {\\n  // processos de uma página: o dela e os dos quadros de outros sites dentro dela (anúncios, captcha...), que antes caíam em \\\"Outros\\\"\\n  const pidsDe = (wc) => {\\n    const s = new Set();\\n    try {\\n      if (!wc || wc.isDestroyed()) return s;\\n      s.add(wc.getOSProcessId());\\n      try { for (const f of wc.mainFrame.framesInSubtree) s.add(f.osProcessId); } catch {}\\n    } catch {}\\n    return s;\\n  };\\n  const soma = (wcs) => {\\n    const pids = new Set();\\n    wcs.forEach((wc) => { for (const p of pidsDe(wc)) pids.add(p); });\\n    return [...pids].reduce((t, pid) => { const u = usage.porPid.get(pid); return u ? { cpu: t.cpu + u.cpu, mem: t.mem + u.mem } : t; }, { cpu: 0, mem: 0 });\\n  };\\n  const livesDe = (p) => liveOpen.flatMap((o) => [...o[p].values()].map((sl) => sl.view && sl.view.webContents));\\n  const nTw = liveOpen.reduce((t, o) => t + o.twitch.size, 0);\\n  const nKk = liveOpen.reduce((t, o) => t + o.kick.size, 0);\\n  const contas = ACCOUNTS.map((_, i) => {\\n    const u = usageOf(i) || { cpu: 0, mem: 0 };\\n    return { nome: nameOf(i), modo: LEVELS[level[i]] ? LEVELS[level[i]].name : 'hibernando', cpu: u.cpu, mem: u.mem, nivel: nivelDe(u.mem, FAIXAS.conta, u.cpu, [15, 40]) };\\n  });\\n  const gJogo = soma(views.map((v) => v.webContents));\\n  const gTw = soma([...livesDe('twitch')]);\\n  const gKk = soma(livesDe('kick'));\\n  const uiWcs = [...bars.map((b) => b.webContents), titleBar && titleBar.webContents, sidebar && sidebar.webContents,\\n    otimSide && otimSide.webContents, bottomBar && bottomBar.webContents];\\n  const gBar = soma(uiWcs); // inclui a lista da esquerda, o painel da direita e a barra de baixo (antes caíam em \\\"Outros\\\")\\n  const conhecidos = new Set();\\n  [...views.map((v) => v.webContents), ...livesDe('twitch'), ...livesDe('kick'), ...uiWcs]\\n    .forEach((wc) => { for (const p of pidsDe(wc)) conhecidos.add(p); });\\n  const outrosProc = usage.lista.filter((m) => m.type !== 'GPU' && !conhecidos.has(m.pid));\\n  const nomeProc = (m) => {\\n    if (m.type === 'Browser') return 'programa principal';\\n    const n = String(m.name || m.serviceName || '');\\n    if (/network/i.test(n)) return 'internet';\\n    if (/audio/i.test(n)) return 'som';\\n    if (/storage/i.test(n)) return 'arquivos';\\n    if (/video capture/i.test(n)) return 'captura de vídeo';\\n    if (m.type === 'Tab') {\\n      try {\\n        const wc = webContents.getAllWebContents().find((w) => !w.isDestroyed() && w.getOSProcessId() === m.pid);\\n        if (wc) { const u = wc.getURL(); return 'página escondida: ' + (u.startsWith('file:') ? 'PokeLink' : (u.split('/')[2] || 'vazia')); }\\n      } catch {}\\n      return 'extensão ou página escondida';\\n    }\\n    return n || m.type;\\n  };\\n  const porNome = new Map();\\n  outrosProc.forEach((m) => { const k = nomeProc(m); porNome.set(k, (porNome.get(k) || 0) + memDe(m)); });\\n  const gOutros = outrosProc.reduce((t, m) => ({ cpu: t.cpu + m.cpu.percentCPUUsage, mem: t.mem + memDe(m) }), { cpu: 0, mem: 0 });\\n  const grupo = (id, nome, u, faixa, qtd, dica) => {\\n    const porItem = qtd ? u.mem / qtd : u.mem;\\n    return { id, nome, cpu: u.cpu, mem: u.mem, qtd: qtd || 0, porItem: qtd ? porItem : null, dica,\\n      nivel: qtd === 0 && (id === 'kick' || id === 'twitch') ? 'ok' : nivelDe(porItem, faixa, u.cpu) };\\n  };\\n  // o modo de cada live muda MUITO o peso (página inteira da Kick gasta bem mais que o player pequeno) e a troca pode ser automática\\n  const kModos = ACCOUNTS.map((_, i) => (liveOpen[i].kick.size ? ((kickPlayer === 'completa' || kickCompleta[i]) ? 'inteira' : 'pequeno') : null)).filter(Boolean);\\n  const dicaKick = !kModos.length ? 'player pequeno: menos'\\n    : kModos.every((x) => x === 'pequeno') ? 'player pequeno'\\n      : (kModos.every((x) => x === 'inteira') ? 'página inteira' : 'página inteira em parte') + (kickPlayer === 'auto' && kickCompleta.some(Boolean) ? ' (troca automática)' : '');\\n  const tModos = ACCOUNTS.map((_, i) => (liveOpen[i].twitch.size ? modoTw(i) : null)).filter(Boolean);\\n  const dicaTwitch = !tModos.length ? 'conexão direta: quase nada' : tModos.every((x) => x === 'irc') ? 'conexão direta' : tModos.every((x) => x !== 'irc') ? 'páginas do chat' : 'conexão direta em parte';\\n  const grupos = [\\n    grupo('jogo', 'As 4 contas do jogo', gJogo, FAIXAS.jogo, null, 'Eco e Mega Eco diminuem'),\\n    grupo('gpu', 'Placa de vídeo', usage.gpu, FAIXAS.gpu, null, 'desenho das telas'),\\n    grupo('kick', `Lives da Kick`, gKk, FAIXAS.kick, nKk, dicaKick),\\n    grupo('twitch', `Lives da Twitch`, gTw, FAIXAS.twitch, nTw, dicaTwitch),\\n    grupo('barras', 'Barras e painéis', gBar, FAIXAS.barras, null, 'interface do PokeLink'),\\n    grupo('outros', `Outros`, gOutros, FAIXAS.outros, null, `${outrosProc.length} processos`),\\n  ].sort((x, y) => y.mem - x.mem);\\n  const nLives = nTw + nKk;\\n  return {\\n    contas, grupos,\\n    outros: [...porNome].sort((a, b) => b[1] - a[1]).slice(0, 8).map(([nome, mem]) => ({ nome, mem })),\\n    total: { cpu: usage.total.cpu, mem: usage.total.mem, nivel: nivelDe(usage.total.mem, FAIXAS.total, usage.total.cpu, [25, 60]), nLives },\\n  };\\n}\\nipcMain.handle('uso-get', () => usoDados());\\n// painel de uso: desce na própria janela (cartões coloridos); sem a barra de cima, mostra em texto\\nfunction showUsage() {\\n  sampleUsage();\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (canDraw) {\\n    const id = ++cfgPanelSeq;\\n    cfgPanels.add(id);\\n    dialogOpen = true;\\n    layout();\\n    titleBar.webContents.focus();\\n    titleBar.webContents.send('title-uso', { id });\\n    return;\\n  }\\n  const d = usoDados();\\n  const f = (u) => fmtUso(u);\\n  uiDialog({\\n    type: 'info',\\n    title: 'Uso de CPU e memória',\\n    message: 'Quanto cada conta está usando agora',\\n    detail: d.contas.map((c) => `${c.nome} — ${c.modo}: ${f(c)}`).join('\\\\n') +\\n      '\\\\n\\\\nPor grupo:\\\\n' + d.grupos.map((g) => `${g.nome}${g.qtd ? ` (${g.qtd})` : ''}: ${f(g)}`).join('\\\\n') +\\n      `\\\\n\\\\nPokeLink inteiro (${d.total.nLives} lives): ${f(d.total)}`,\\n  });\\n}\\nfunction setLevel(i, lv, soEsta) {\\n  if (!(i >= 0 && i < ACCOUNTS.length) || !(lv >= 0 && lv <= 2)) return; // 0 Normal, 1 Eco, 2 Mega Eco\\n  // Mega Eco é para todas as contas de uma vez\\n  if (!soEsta) { setAllLevel(lv); return; } // o modo vale para todas as contas\\n  const waking = level[i] === 3 && lv !== 3;\\n  level[i] = lv;\\n  applyLevel(i, waking);\\n  sendState();\\n}\\nipcMain.on('level-set', (_, i, lv) => setLevel(i, lv));\\n\\nlet lastPerfMenu = null;\\nipcMain.on('perf-menu', async (e, i, rect) => {\\n  if (!(i >= 0 && i < ACCOUNTS.length)) return;\\n  // menu no tema do PokeLink, desenhado pela barra de título (que cobre a janela enquanto ele está aberto)\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (canDraw && rect) {\\n    const b = bars[i].getBounds();\\n    const r = await uiPopup({\\n      x: b.x + Math.round(rect.left), y: b.y + Math.round(rect.bottom) + 4,\\n      up: b.y + Math.round(rect.top) - 4, // se não couber embaixo, abre para cima\\n      title: `Desempenho — ${nameOf(i)}`,\\n      sub: `Agora esta conta usa: ${fmtUso(usageOf(i))}` + (level[i] === 3 ? ' (hibernando)' : ''),\\n      items: LEVELS.map((L, lv) => ({ value: lv, label: L.name, desc: L.desc, checked: level[i] === lv, icon: ['▶', '🍃', '📊', '💤'][lv] })),\\n    });\\n    if (r != null) setLevel(i, r);\\n    return;\\n  }\\n  lastPerfMenu = Menu.buildFromTemplate([\\n    { label: `Desempenho — ${nameOf(i)}`, enabled: false },\\n    { type: 'separator' },\\n    ...LEVELS.map((L, lv) => ({\\n      label: `${L.name}  —  ${L.desc}`,\\n      type: 'radio',\\n      checked: level[i] === lv,\\n      click: () => setLevel(i, lv),\\n    })),\\n  ]);\\n  lastPerfMenu.popup({ window: win });\\n});\\n\\n// ---------- Som, recarregar e troca de tela (acionados pela barra) ----------\\nconst muted = ACCOUNTS.map((_, i) => i > 0); // contas 2, 3 e 4 começam sem som\\n\\nconst JS_VOLUME = (v) => `(() => { try {\\n  if (!window.__pieVol) {\\n    window.__pieVol = { v: 1 };\\n    const d = Object.getOwnPropertyDescriptor(HTMLMediaElement.prototype, 'volume');\\n    if (d && d.set) {\\n      Object.defineProperty(HTMLMediaElement.prototype, 'volume', { configurable: true, get() { return this.__pieV ?? d.get.call(this); }, set(x) { this.__pieV = x; d.set.call(this, Math.min(1, Math.max(0, x * window.__pieVol.v))); } });\\n    }\\n    const dd = Object.getOwnPropertyDescriptor(BaseAudioContext.prototype, 'destination');\\n    if (dd && dd.get) {\\n      const mapa = new WeakMap();\\n      Object.defineProperty(BaseAudioContext.prototype, 'destination', { configurable: true, get() {\\n        if (!mapa.has(this)) { const g = this.createGain(); g.gain.value = window.__pieVol.v; g.connect(dd.get.call(this)); (window.__pieGains ||= []).push(g); mapa.set(this, g); }\\n        return mapa.get(this);\\n      } });\\n    }\\n  }\\n  window.__pieVol.v = ${v};\\n  for (const g of (window.__pieGains || [])) g.gain.value = ${v};\\n  for (const m of document.querySelectorAll('audio,video')) { const o = m.__pieV ?? m.volume; m.volume = o; }\\n} catch (e) {} })()`;\\n\\nfunction setMuted(i, m) {\\n  muted[i] = !!m;\\n  const wc = views[i] && views[i].webContents;\\n  if (wc && !wc.isDestroyed()) {\\n    wc.setAudioMuted(muted[i]);\\n    wc.executeJavaScript(JS_VOLUME(muted[i] ? 0 : 1)).catch(() => {});\\n  }\\n  const menu = Menu.getApplicationMenu();\\n  const item = menu && menu.getMenuItemById('mute' + i);\\n  if (item) item.checked = muted[i];\\n  sendState();\\n}\\n\\nipcMain.on('view-set', (_, n) => {\\n  if (Number.isInteger(n) && n >= -1 && n < ACCOUNTS.length) setFocus(n);\\n});\\n// Recarregar uma conta de forma confiável.\\n// Antes falhava às vezes porque: (1) o jogo pedia \\\"tem certeza que quer sair?\\\" e o Electron\\n// cancelava o recarregamento em silêncio; (2) a página estava travada e não respondia.\\nconst loading = ACCOUNTS.map(() => false);\\nfunction reloadAccount(i) {\\n  const wc = views[i] && views[i].webContents;\\n  if (!wc || wc.isDestroyed()) return;\\n  let started = false;\\n  const onStart = () => { started = true; };\\n  wc.once('did-start-loading', onStart);\\n  wc.reloadIgnoringCache();\\n  setTimeout(() => {\\n    if (wc.isDestroyed()) return;\\n    wc.removeListener('did-start-loading', onStart);\\n    if (started) return;\\n    // não começou a carregar: a página está travada; reinicia o processo dela e carrega de novo\\n    try { wc.forcefullyCrashRenderer(); } catch {}\\n    setTimeout(() => { if (!wc.isDestroyed()) wc.loadURL(GAME_URL).catch(() => {}); }, 300);\\n  }, 4000);\\n}\\n// ---------- Vigia anti-travamento ----------\\n// Se a página de uma conta parar de responder (jogo congelado), o PokeLink reinicia só aquela conta sozinho,\\n// em vez de o jogador ter que fechar e abrir o programa.\\nconst travada = ACCOUNTS.map(() => null);      // quando a página começou a não responder\\nconst pingFalhas = ACCOUNTS.map(() => 0);      // checagens seguidas sem resposta\\nconst ultimaRecup = ACCOUNTS.map(() => 0);     // evita ficar reiniciando sem parar\\nfunction logTravamento(msg) {\\n  try {\\n    const f = path.join(app.getPath('userData'), 'travamentos.log');\\n    try { if (fs.statSync(f).size > 200 * 1024) fs.writeFileSync(f, ''); } catch {}\\n    fs.appendFileSync(f, new Date().toLocaleString('pt-BR') + ' - ' + msg + '\\\\n');\\n  } catch {}\\n}\\nfunction recuperarConta(i, motivo) {\\n  const wc = views[i] && views[i].webContents;\\n  if (!wc || wc.isDestroyed()) return;\\n  if (Date.now() - ultimaRecup[i] < 2 * 60 * 1000) return; // no máximo 1 vez a cada 2 min por conta\\n  ultimaRecup[i] = Date.now();\\n  travada[i] = null; pingFalhas[i] = 0;\\n  autoBusy[i] = false; // a Auto Compra que estava presa na página travada é liberada\\n  logTravamento(`${nameOf(i)} travou (${motivo}); reiniciando a conta`);\\n  avisoCelular('erro', `${nameOf(i)} travou`, 'Foi reiniciada sozinha e já está voltando a farmar.');\\n  try { wc.forcefullyCrashRenderer(); } catch {} // o aviso de \\\"processo fechou\\\" já recarrega o jogo\\n  setTimeout(() => { if (!wc.isDestroyed() && wc.getURL() === '') wc.loadURL(GAME_URL).catch(() => {}); }, 2500);\\n}\\nasync function vigiaContas() {\\n  if (sono.ausente) return;\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    const wc = views[i] && views[i].webContents;\\n    if (!wc || wc.isDestroyed() || level[i] === 3 || wc.isLoading()) { pingFalhas[i] = 0; continue; }\\n    // aviso do próprio Chromium: travada há mais de 30 s\\n    if (travada[i] && Date.now() - travada[i] > 30000) { recuperarConta(i, 'sem responder'); continue; }\\n    // checagem simples: a página responde a um \\\"oi\\\" em até 10 s?\\n    const ok = await withTimeout(wc.executeJavaScript('1'), 10000).then(() => true, () => false);\\n    pingFalhas[i] = ok ? 0 : pingFalhas[i] + 1;\\n    if (pingFalhas[i] >= 3) recuperarConta(i, 'não respondeu 3 checagens');\\n  }\\n}\\n// ---------- Deixar o PC dormir/hibernar ----------\\n// As lives e o jogo tocando vídeo/áudio seguram o Windows acordado (\\\"Video Wake Lock\\\" no powercfg /requests).\\n// Com esta opção (DESLIGADA por padrão: quem farma quer o PC acordado), quando você fica sem mexer no PC quase o tempo que o Windows espera\\n// para dormir/hibernar, o PokeLink pausa tudo (fecha as lives e deixa as contas em branco) e o PC dorme\\n// normalmente. Quando você volta, as contas carregam de novo sozinhas.\\n// Se o Windows estiver configurado para \\\"Nunca\\\" dormir, nada muda: o PokeLink continua farmando.\\nconst sono = { ligado: false, ausente: false, desde: 0, timeout: 0, naoRepetir: false };\\nconst sonoFile = () => path.join(app.getPath('userData'), 'sono.json');\\n// ---------- Otimizar a conta: recarrega pra liberar memória acumulada, mantendo o login ----------\\nconst otimizarFile = () => path.join(app.getPath('userData'), 'otimizar.json');\\nconst otimizarHist = ACCOUNTS.map(() => []); // {hora, antes, depois}\\nlet otimizarPagina = ACCOUNTS.map(() => 'atual'); // 'atual' (recarrega a página de agora) | 'inicio' (volta pro endereço da conta)\\nlet otimizarAuto = ACCOUNTS.map(() => 0); // minutos entre otimizações sozinhas (0 = desligado)\\nconst otimizarTimers = ACCOUNTS.map(() => null);\\nfunction loadOtimizar() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(otimizarFile(), 'utf8'));\\n    if (Array.isArray(j.pagina)) j.pagina.forEach((v, i) => { if (i < ACCOUNTS.length && ['atual', 'inicio'].includes(v)) otimizarPagina[i] = v; });\\n    if (Array.isArray(j.auto)) j.auto.forEach((v, i) => { if (i < ACCOUNTS.length && Number.isInteger(v) && v >= 0) otimizarAuto[i] = v; });\\n  } catch {}\\n}\\nconst saveOtimizar = () => { try { fs.writeFileSync(otimizarFile(), JSON.stringify({ pagina: otimizarPagina, auto: otimizarAuto })); } catch {} };\\n// faz a otimização de verdade: mede a memória, recarrega (ou volta pro início), espera carregar e mede de novo\\nasync function otimizarConta(i) {\\n  const wc = views[i] && views[i].webContents;\\n  if (!wc || wc.isDestroyed()) return null;\\n  sampleUsage();\\n  const antes = usageOf(i) ? Math.round(usageOf(i).mem) : null;\\n  if (otimizarPagina[i] === 'inicio') wc.loadURL(GAME_URL).catch(() => {});\\n  else wc.reload();\\n  await new Promise((r) => {\\n    let feito = false;\\n    const ok = () => { if (feito) return; feito = true; r(); };\\n    wc.once('did-finish-load', ok);\\n    setTimeout(ok, 15000); // não trava pra sempre se a página demorar\\n  });\\n  await new Promise((r) => setTimeout(r, 3000)); // dá um tempinho pra acomodar antes de medir de novo\\n  sampleUsage();\\n  const depois = usageOf(i) ? Math.round(usageOf(i).mem) : null;\\n  const entry = { hora: new Date().toLocaleTimeString('pt-BR'), antes, depois };\\n  otimizarHist[i].unshift(entry);\\n  otimizarHist[i] = otimizarHist[i].slice(0, 10);\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('otimizar-update');\\n  return entry;\\n}\\nfunction setOtimizarAuto(i, minutos) {\\n  otimizarAuto[i] = Math.max(0, Math.min(600, Number(minutos) || 0));\\n  saveOtimizar();\\n  if (otimizarTimers[i]) { clearInterval(otimizarTimers[i]); otimizarTimers[i] = null; }\\n  if (otimizarAuto[i] > 0) {\\n    otimizarTimers[i] = setInterval(() => {\\n      if (focused === i) return; // você está mexendo nela agora: espera o próximo ciclo\\n      otimizarConta(i);\\n    }, otimizarAuto[i] * 60000);\\n  }\\n}\\nfunction setOtimizarPagina(i, modo) {\\n  if (!['atual', 'inicio'].includes(modo)) return;\\n  otimizarPagina[i] = modo;\\n  saveOtimizar();\\n}\\nfunction otimizarState(i) {\\n  const u = usageOf(i);\\n  return { mem: u ? Math.round(u.mem) : null, hist: otimizarHist[i], pagina: otimizarPagina[i], auto: otimizarAuto[i] };\\n}\\nipcMain.handle('otimizar-get', (_, i) => (Number.isInteger(i) && i >= 0 && i < ACCOUNTS.length ? otimizarState(i) : null));\\nipcMain.handle('otimizar-agora', (_, i) => (Number.isInteger(i) && i >= 0 && i < ACCOUNTS.length ? otimizarConta(i) : null));\\nipcMain.on('otimizar-auto', (_, i, minutos) => { if (Number.isInteger(i) && i >= 0 && i < ACCOUNTS.length) setOtimizarAuto(i, minutos); });\\nipcMain.on('otimizar-pagina', (_, i, modo) => { if (Number.isInteger(i) && i >= 0 && i < ACCOUNTS.length) setOtimizarPagina(i, modo); });\\nfunction loadSono() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(sonoFile(), 'utf8'));\\n    if (typeof j.ligado === 'boolean' && j.v2) sono.ligado = j.ligado; // (versão anterior vinha ligada sem você escolher)\\n    if (typeof j.tela === 'boolean') tela.ligado = j.tela;\\n  } catch {}\\n}\\nconst salvarSono = () => { try { fs.writeFileSync(sonoFile(), JSON.stringify({ v2: true, ligado: sono.ligado, tela: tela.ligado })); } catch {} };\\n// Mantém o PC LIGADO para o farm continuar (a tela pode apagar normalmente: isto não segura o monitor).\\n// Só fica desligado se você escolheu \\\"Pausar o farm para o PC dormir\\\".\\nlet pcAcordadoId = null;\\nfunction manterPcAcordado() { }\\nfunction setSono(on) {\\n  sono.ligado = !!on;\\n  salvarSono();\\n  manterPcAcordado();\\n  if (!on && sono.ausente) voltarDoAusente();\\n  buildMenu();\\n}\\n// lê do Windows em quantos segundos ele dorme/hiberna sozinho (0 = nunca); na bateria vale o tempo da bateria\\nfunction lerTempoWindows() {\\n  if (process.platform !== 'win32') return;\\n  const { execFile } = require('child_process');\\n  const ler = (nome) => new Promise((ok) => {\\n    execFile('powercfg', ['/q', 'SCHEME_CURRENT', 'SUB_SLEEP', nome], { windowsHide: true, timeout: 10000 }, (err, out) => {\\n      const hex = String(out || '').match(/0x[0-9a-f]{8}/gi) || [];\\n      if (err || hex.length < 2) return ok(0);\\n      const [ca, cc] = hex.slice(-2).map((h) => parseInt(h, 16)); // os dois últimos: na tomada e na bateria\\n      let bat = false; try { bat = powerMonitor.isOnBatteryPower(); } catch {}\\n      ok((bat ? cc : ca) || 0);\\n    });\\n  });\\n  Promise.all([ler('STANDBYIDLE'), ler('HIBERNATEIDLE')]).then((t) => {\\n    const v = t.filter((x) => x > 0);\\n    sono.timeout = v.length ? Math.min(...v) : 0;\\n  }).catch(() => {});\\n}\\nfunction entrarAusente() {\\n  sono.ausente = true;\\n  sono.desde = Date.now();\\n  logTravamento('PC sem uso: PokeLink pausado para o Windows poder dormir/hibernar');\\n  avisoCelular('pc', 'Farm pausado', 'O PC ficou sem uso e o PokeLink pausou tudo para ele dormir.');\\n  monitorEnviar(true); // avisa o celular antes de o PC dormir\\n  syncLives(); // fecha as lives (com o PC ausente nenhuma fica aberta)\\n  ACCOUNTS.forEach((_, i) => { if (ircs[i]) closeIrc(i); });\\n  views.forEach((v) => {\\n    const wc = v && v.webContents;\\n    if (!wc || wc.isDestroyed()) return;\\n    wc.setAudioMuted(true);\\n    wc.loadURL('about:blank').catch(() => {}); // página vazia: solta o vídeo e o som\\n  });\\n  sendState();\\n}\\nfunction voltarDoAusente() {\\n  if (!sono.ausente) return;\\n  sono.ausente = false;\\n  avisoCelular('pc', 'Farm voltou', 'O PC acordou e as contas estão carregando de novo.');\\n  views.forEach((v, i) => {\\n    const wc = v && v.webContents;\\n    if (!wc || wc.isDestroyed()) return;\\n    wc.setAudioMuted(!!muted[i]);\\n    wc.loadURL(GAME_URL).catch(() => {});\\n  });\\n  ACCOUNTS.forEach((_, i) => { autoLast[i] = Date.now() - checkMs() + 60000; }); // Auto Compra volta depois de ~1 min\\n  setTimeout(checkLives, 15000);\\n  syncLives();\\n  sendState();\\n}\\n// ---------- Deixar a tela apagar (o farm continua) ----------\\n// O PokeLink impede o Windows de saber quando a janela está escondida (para a Kick não pausar). Por isso o\\n// vídeo das lives e do jogo seguravam a TELA acesa (\\\"Video Wake Lock\\\"), até com o PC bloqueado.\\n// Agora, ao bloquear o PC (Windows+L) ou quando a tela iria apagar por falta de uso, o PokeLink esconde a\\n// própria janela: o Windows apaga a tela normalmente, e o jogo e as lives continuam rodando por trás.\\n// Quando você volta (mexe no mouse/teclado ou desbloqueia), a janela aparece de novo.\\nconst tela = { ligado: true, off: false, bloqueada: false, voltou: 0, apagaEm: 0 };\\nfunction setTela(on) { tela.ligado = !!on; salvarSono(); if (!on) acenderTela(); buildMenu(); }\\n// Só esconder a janela não bastava: as páginas continuavam se achando \\\"na tela\\\" e o vídeo segurava o monitor\\n// aceso. Agora as páginas também saem da janela enquanto a tela está apagada (aí o Windows sabe que ninguém\\n// está vendo vídeo); o jogo e as lives continuam rodando normalmente por trás.\\nlet telaFilhos = [];\\nfunction apagarTela() { }\\nfunction acenderTela() { }\\nfunction checarTela() { }\\n// lê em quantos segundos o Windows apaga a tela (0 = nunca)\\nfunction lerTempoTela() { }\\nfunction checarAusencia() {\\n  if (process.platform !== 'win32') return;\\n  let idle = 0; try { idle = powerMonitor.getSystemIdleTime(); } catch { return; }\\n  if (idle < 60) sono.naoRepetir = false; // você mexeu no PC\\n  if (sono.ausente) {\\n    if (idle < 60) { voltarDoAusente(); return; }\\n    // passou bem do tempo e o PC não dormiu (outro programa segurando): volta a farmar e não pausa de novo até você mexer\\n    if (Date.now() - sono.desde > 15 * 60 * 1000) { sono.naoRepetir = true; voltarDoAusente(); }\\n    return;\\n  }\\n  if (!sono.ligado || !sono.timeout || sono.naoRepetir) return;\\n  if (idle >= Math.max(60, sono.timeout - 60)) entrarAusente(); // 1 minuto antes do Windows dormir\\n}\\nipcMain.on('reload-account', (_, i) => {\\n  if (Number.isInteger(i) && i >= 0 && i < ACCOUNTS.length) reloadAccount(i);\\n});\\nipcMain.on('mute-toggle', (_, i) => {\\n  if (views[i]) setMuted(i, !muted[i]);\\n});\\n\\n// ---------- Atualização dentro do app ----------\\nconst UPDATABLE = ['main.js', 'preload.js', 'bar.html'];\\n\\nfunction restartApp() {\\n  app.relaunch();\\n  app.exit(0);\\n}\\n\\n// Atualizações vêm num pacote \\\".plk\\\" ASSINADO por você (veja assinar-atualizacao.js).\\n// O app só instala pacotes cuja assinatura bate com esta chave pública, então ninguém além de você\\n// consegue colocar código no PokeLink por esse menu. Esta linha é preenchida pelo script na 1ª vez.\\nconst UPDATE_PUBLIC_KEY = `-----BEGIN PUBLIC KEY-----\\nMCowBQYDK2VwAyEAVcB59cUlJYYtgWKZjWaxLmSemRouKoYPqNnlAxj4nyI=\\n-----END PUBLIC KEY-----`;\\n\\nconst verParts = (v) => String(v).split(/[^0-9]+/).filter(Boolean).map(Number);\\nfunction compareVersions(a, b) {\\n  const x = verParts(a), y = verParts(b);\\n  for (let k = 0; k < Math.max(x.length, y.length); k++) {\\n    const d = (x[k] || 0) - (y[k] || 0);\\n    if (d) return d > 0 ? 1 : -1;\\n  }\\n  return 0;\\n}\\n\\n// confere se cada arquivo tem o conteúdo certo (evita, por ex., código JS salvo como bar.html)\\nfunction checkFileContent(name, content) {\\n  if (typeof content !== 'string' || !content.trim()) return `${name} está vazio.`;\\n  if (name.endsWith('.html')) {\\n    if (!/^\\\\s*<!doctype html/i.test(content)) return `${name} não é uma página HTML (o arquivo parece trocado).`;\\n    return null;\\n  }\\n  if (/^\\\\s*</.test(content)) return `${name} parece ser HTML, não JavaScript (o arquivo parece trocado).`;\\n  if (name === 'main.js' && !content.includes('BaseWindow')) return 'main.js não parece ser o arquivo principal do PokeLink.';\\n  if (name === 'preload.js' && (!content.includes('exposeInMainWorld') || content.includes('BaseWindow'))) return 'preload.js não parece ser o preload do PokeLink.';\\n  try { new vm.Script(content, { filename: name }); } catch (e) { return `${name} tem erro de sintaxe: ${e.message}`; }\\n  return null;\\n}\\n\\n// lê e confere um pacote; devolve { version, files } ou lança um erro com mensagem amigável\\nfunction readUpdatePackage(file) {\\n  let pkg;\\n  try { pkg = JSON.parse(fs.readFileSync(file, 'utf8')); }\\n  catch { throw new Error('O arquivo não é um pacote de atualização do PokeLink.'); }\\n  if (!pkg || typeof pkg.payload !== 'string' || typeof pkg.sig !== 'string') {\\n    throw new Error('O arquivo não é um pacote de atualização do PokeLink.');\\n  }\\n  let ok = false;\\n  try {\\n    ok = require('crypto').verify(null, Buffer.from(pkg.payload, 'utf8'), UPDATE_PUBLIC_KEY, Buffer.from(pkg.sig, 'base64'));\\n  } catch { ok = false; }\\n  if (!ok) throw new Error('A assinatura do pacote não é válida. Ele não foi gerado pelo desenvolvedor do PokeLink ou foi alterado.');\\n  const data = JSON.parse(pkg.payload);\\n  const names = Object.keys(data.files || {});\\n  if (!names.length || names.some((n) => !UPDATABLE.includes(n))) throw new Error('O pacote tem arquivos inesperados.');\\n  for (const n of names) {\\n    const err = checkFileContent(n, data.files[n]);\\n    if (err) throw new Error(err);\\n  }\\n  return { version: String(data.version || '?'), files: data.files };\\n}\\n\\nasync function applyUpdate() {\\n  if (!UPDATE_PUBLIC_KEY) {\\n    showError('Atualizações', 'As atualizações ainda não foram configuradas nesta versão do PokeLink.');\\n    return;\\n  }\\n  const r = await dialog.showOpenDialog({\\n    title: 'Escolha o pacote de atualização do PokeLink',\\n    properties: ['openFile'],\\n    filters: [{ name: 'Atualização do PokeLink', extensions: ['plk'] }],\\n  });\\n  if (r.canceled || !r.filePaths.length) return;\\n\\n  let up;\\n  try { up = readUpdatePackage(r.filePaths[0]); }\\n  catch (e) { showError('Atualização recusada', e.message); return; }\\n\\n  const cmp = compareVersions(up.version, APP_VERSION);\\n  const c = await uiDialog({\\n    type: cmp > 0 ? 'question' : 'warning',\\n    title: 'Atualização',\\n    message: cmp > 0\\n      ? `Atualizar de ${APP_LABEL} (pacote ${APP_VERSION}) para o pacote ${up.version}?`\\n      : `Este pacote (${up.version}) não é mais novo que o pacote instalado (${APP_VERSION}).`,\\n    detail: cmp > 0\\n      ? 'O PokeLink reinicia ao final. Os logins e configurações das contas são mantidos.'\\n      : 'Instalar mesmo assim vai substituir a versão atual por esta.',\\n    buttons: [cmp > 0 ? 'Atualizar' : 'Instalar mesmo assim', 'Cancelar'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (c.response !== 0) return;\\n\\n  installPackage(up);\\n}\\n\\n// grava os arquivos do pacote (já conferido) e reinicia\\nfunction installPackage(up) {\\n  try {\\n    for (const [name, content] of Object.entries(up.files)) {\\n      const dest = path.join(__dirname, name);\\n      if (fs.existsSync(dest)) fs.copyFileSync(dest, dest + '.bak'); // guarda a versão anterior\\n      fs.writeFileSync(dest, content, 'utf8');\\n    }\\n  } catch (e) {\\n    showError('Falha ao instalar', e.message);\\n    return false;\\n  }\\n  restartApp();\\n  return true;\\n}\\n\\n// ---------- Atualização online ----------\\n// O PokeLink confere de tempos em tempos um arquivo \\\"latest.json\\\" publicado por você na internet\\n// (ex.: num repositório do GitHub). Se houver versão nova, avisa o usuário e instala com um clique.\\n// O pacote baixado passa pela MESMA conferência de assinatura: só pacotes assinados por você entram,\\n// mesmo que alguém mexa no site onde os arquivos estão.\\n// Coloque aqui o endereço do seu latest.json (enquanto estiver vazio, a atualização online fica desligada):\\nconst UPDATE_FEED_URL = 'https://raw.githubusercontent.com/zNationsx/pokelink-atualizacoes/main/latest.json';\\nconst UPDATE_CHECK_HOURS = 3;\\nlet updateOffered = null;\\nlet updateBusy = false;\\n\\n// Lê o latest.json. No GitHub, o endereço \\\"raw\\\" fica alguns minutos em cache depois de você subir um\\n// arquivo novo; a API do GitHub entrega a versão mais recente na hora. Usa a API e, se falhar, o raw.\\nasync function fetchFeed(ses) {\\n  const m = UPDATE_FEED_URL.match(/^https:\\\\/\\\\/raw\\\\.githubusercontent\\\\.com\\\\/([^/]+)\\\\/([^/]+)\\\\/([^/]+)\\\\/(.+)$/);\\n  if (m) {\\n    try {\\n      const api = `https://api.github.com/repos/${m[1]}/${m[2]}/contents/${m[4]}?ref=${m[3]}`;\\n      const r = await withTimeout(ses.fetch(api, { headers: { Accept: 'application/vnd.github.raw+json', 'User-Agent': 'PokeLink' } }), 15000);\\n      if (r.ok) return JSON.parse(await r.text());\\n    } catch {}\\n  }\\n  const r = await withTimeout(ses.fetch(UPDATE_FEED_URL + (UPDATE_FEED_URL.includes('?') ? '&' : '?') + 't=' + Date.now(), { cache: 'no-store' }), 20000);\\n  if (!r.ok) throw new Error('servidor respondeu ' + r.status);\\n  return r.json();\\n}\\n\\nasync function checkOnlineUpdate(manual) {\\n  if (updateBusy) return;\\n  if (!UPDATE_FEED_URL || !UPDATE_PUBLIC_KEY) {\\n    if (manual) uiDialog({ type: 'info', title: 'Atualizações', message: 'A atualização online ainda não foi configurada.', detail: `Versão instalada: ${APP_LABEL}.` });\\n    return;\\n  }\\n  updateBusy = true;\\n  try {\\n    const ses = session.fromPartition('persist:lives-check');\\n    const feed = await fetchFeed(ses);\\n    if (!feed || !feed.version || !feed.file) throw new Error('arquivo latest.json incompleto');\\n    if (compareVersions(feed.version, APP_VERSION) <= 0) {\\n      if (manual) uiDialog({ type: 'info', title: 'Atualizações', message: 'Você já está na versão mais recente.',\\n        detail: `Versão instalada: ${APP_LABEL} (pacote ${APP_VERSION}).\\\\nPacote publicado online: ${feed.version}.` });\\n      return;\\n    }\\n    if (!manual && updateOffered === feed.version) return; // já ofereceu esta versão; não insiste\\n    updateOffered = feed.version;\\n    const c = await uiDialog({\\n      type: 'question',\\n      title: 'Atualização disponível',\\n      message: `Nova versão do PokeLink: ${feed.version}`,\\n      detail: (feed.notes ? `Novidades:\\\\n${feed.notes}\\\\n\\\\n` : '') + `Versão instalada: ${APP_LABEL}. O PokeLink reinicia ao final; logins e configurações são mantidos.`,\\n      buttons: ['Atualizar agora', 'Depois'],\\n      defaultId: 0,\\n      cancelId: 1,\\n    });\\n    if (c.response !== 0) return;\\n    // baixa o pacote, confere a assinatura e instala\\n    const url = new URL(feed.file, UPDATE_FEED_URL).href;\\n    const pr = await withTimeout(ses.fetch(url + (url.includes('?') ? '&' : '?') + 't=' + Date.now(), { cache: 'no-store' }), 60000);\\n    if (!pr.ok) throw new Error('não consegui baixar o pacote (' + pr.status + ')');\\n    const tmp = path.join(app.getPath('temp'), `pokelink-${feed.version}.plk`);\\n    fs.writeFileSync(tmp, Buffer.from(await pr.arrayBuffer()));\\n    let up;\\n    try { up = readUpdatePackage(tmp); } finally { try { fs.unlinkSync(tmp); } catch {} }\\n    if (compareVersions(up.version, APP_VERSION) <= 0) throw new Error('o pacote baixado não é mais novo que a versão instalada');\\n    installPackage(up);\\n  } catch (e) {\\n    if (manual) showError('Atualizações', 'Não consegui atualizar: ' + e.message);\\n  } finally {\\n    updateBusy = false;\\n  }\\n}\\n\\nasync function undoUpdate() {\\n  const c = await uiDialog({\\n    type: 'question',\\n    title: 'Desfazer atualização',\\n    message: 'Voltar para a versão anterior?',\\n    detail: 'O PokeLink reinicia ao final.',\\n    buttons: ['Voltar versão', 'Cancelar'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (c.response !== 0) return;\\n  let n = 0;\\n  try {\\n    for (const name of UPDATABLE) {\\n      const dest = path.join(__dirname, name);\\n      if (fs.existsSync(dest + '.bak')) { fs.copyFileSync(dest + '.bak', dest); n++; }\\n    }\\n  } catch (e) {\\n    showError('Falha ao restaurar', e.message);\\n    return;\\n  }\\n  if (!n) { showError('Desfazer', 'Não há versão anterior guardada.'); return; }\\n  restartApp();\\n}\\n\\n// ---------- Auto Compra (loja \\\"Market\\\" do jogo, paga em OURO): pokébolas, poções e revives ----------\\nconst DEFAULT_CFG = {\\n  dry: false, // sem Modo Teste: compra de verdade assim que ligar\\n  rules: [\\n    // compra `buy` unidades quando você tiver menos de `min`. `cat` = aba do Market.\\n    { cat: 'Pokébolas', name: 'Poké Ball', on: true, min: 2000, buy: 5000 },\\n    { cat: 'Pokébolas', name: 'Great Ball', on: false, min: 500, buy: 1000 },\\n    { cat: 'Pokébolas', name: 'Super Ball', on: false, min: 500, buy: 1000 },\\n    { cat: 'Pokébolas', name: 'Ultra Ball', on: true, min: 1000, buy: 3000 },\\n    { cat: 'Poções', name: 'Small Potion', on: false, min: 100, buy: 500 },\\n    { cat: 'Poções', name: 'Great Potion', on: false, min: 5000, buy: 10000 },\\n    { cat: 'Poções', name: 'Ultra Potion', on: false, min: 1000, buy: 2000 },\\n    { cat: 'Poções', name: 'Hyper Potion', on: false, min: 500, buy: 1000 },\\n    { cat: 'Poções', name: 'Ultimate Potion', on: false, min: 200, buy: 500 },\\n    { cat: 'Poções', name: 'Golden Potion', on: false, min: 100, buy: 200 },\\n    { cat: 'Revives', name: 'Revive', on: false, min: 500, buy: 1000 },\\n    { cat: 'Revives', name: 'Max Revive', on: false, min: 200, buy: 300 },\\n  ],\\n  reserve: 0,            // sem Segurança: compra usando todo o ouro que a conta tiver\\n  maxHour: 999999999999, // sem teto de gasto por hora\\n  intervalMin: 5,        // verifica a cada N minutos (fixo, não aparece mais na tela)\\n};\\n\\n// valida/limpa qualquer configuração (vinda do arquivo ou da janela de configuração)\\nfunction sanitizeCfg(c) {\\n  c = c || {};\\n  const n = (v, lo, hi, d) => { if (v === '' || v == null) return d; v = Math.floor(Number(v)); return Number.isFinite(v) ? Math.min(hi, Math.max(lo, v)) : d; };\\n  // só aceita itens conhecidos (nome e aba vêm da lista padrão, nunca de fora)\\n  const rules = DEFAULT_CFG.rules.map((d) => {\\n    const r = (Array.isArray(c.rules) && c.rules.find((x) => x && x.name === d.name)) || {};\\n    return { cat: d.cat, name: d.name, on: r.on === undefined ? d.on : !!r.on, min: n(r.min, 0, 100000000, d.min), buy: n(r.buy, 1, 10000000, d.buy) };\\n  });\\n  return {\\n    dry: false, // sem Modo Teste: sempre compra de verdade, mesmo em contas configuradas antes dessa versão\\n    rules,\\n    reserve: n(c.reserve, 0, 2000000000, DEFAULT_CFG.reserve),\\n    maxHour: n(c.maxHour, 0, 20000000000, DEFAULT_CFG.maxHour),\\n    intervalMin: n(c.intervalMin, 1, 120, DEFAULT_CFG.intervalMin),\\n  };\\n}\\n\\nconst auto = Object.assign({ enabled: ACCOUNTS.map(() => false) }, sanitizeCfg({}));\\n// configuração própria de cada conta (itens, quantidades, reserva, limite, modo teste)\\nauto.contas = ACCOUNTS.map(() => sanitizeCfg({}));\\nconst cfgDe = (i) => auto.contas[i] || auto;\\nconst checkMs = () => auto.intervalMin * 60 * 1000;\\nconst autoStatus = ACCOUNTS.map(() => 'desligado');\\nconst autoBusy = ACCOUNTS.map(() => false);\\nconst autoLast = ACCOUNTS.map(() => 0);\\nconst autoFalhas = ACCOUNTS.map(() => 0); // só pra mostrar no status \\\"tento em 5 min (Nª vez seguida)\\\"; nunca desliga sozinha\\nconst spendLog = ACCOUNTS.map(() => []);\\nconst autoFile = () => path.join(app.getPath('userData'), 'autobuy.json');\\nconst autoLogFile = () => path.join(app.getPath('userData'), 'autobuy-log.txt');\\nconst marketIconsFile = () => path.join(app.getPath('userData'), 'market-icons.json'); // ícones reais do Market, pegos do próprio jogo\\n\\nfunction loadAuto() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(autoFile(), 'utf8'));\\n    if (Array.isArray(j.enabled)) ACCOUNTS.forEach((_, i) => { auto.enabled[i] = !!j.enabled[i]; });\\n    Object.assign(auto, sanitizeCfg(j)); // arquivos antigos (só enabled/dry) continuam funcionando\\n    // versões antigas tinham uma configuração só: vira a configuração inicial de todas as contas\\n    ACCOUNTS.forEach((_, i) => { auto.contas[i] = sanitizeCfg(Array.isArray(j.contas) && j.contas[i] ? j.contas[i] : j); });\\n  } catch {}\\n  ACCOUNTS.forEach((_, i) => { autoStatus[i] = auto.enabled[i] ? 'ligado' : 'desligado'; });\\n}\\nfunction saveAuto() {\\n  try {\\n    fs.writeFileSync(autoFile(), JSON.stringify({\\n      enabled: auto.enabled, dry: auto.dry, rules: auto.rules,\\n      reserve: auto.reserve, maxHour: auto.maxHour, intervalMin: auto.intervalMin,\\n      contas: auto.contas,\\n    }));\\n  } catch {}\\n}\\nfunction autoLog(i, text) {\\n  try { fs.appendFileSync(autoLogFile(), `[${new Date().toLocaleString('pt-BR')}] ${nameOf(i)}: ${text}\\\\n`); } catch {}\\n}\\n\\n// Script que roda DENTRO da página do jogo (String.raw: sem crases e sem \\\"${\\\" aqui dentro)\\nconst AUTOBUY_PAGE = String.raw`(async (opts) => {\\n  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n  const vis = (el) => {\\n    if (!el) return false;\\n    const r = el.getBoundingClientRect();\\n    const cs = getComputedStyle(el);\\n    return r.width > 0 && r.height > 0 && cs.display !== 'none' && cs.visibility !== 'hidden';\\n  };\\n  const num = (t) => { const d = String(t == null ? '' : t).replace(/\\\\D/g, ''); return d ? parseInt(d, 10) : null; };\\n  const norm = (s) => String(s || '').normalize('NFD').replace(/[\\\\u0300-\\\\u036f]/g, '').toLowerCase().trim();\\n  const waitFor = async (fn, ms) => {\\n    const t0 = Date.now();\\n    while (Date.now() - t0 < (ms || 4000)) { const v = fn(); if (v) return v; await sleep(150); }\\n    return null;\\n  };\\n  const txt = (el) => (el && el.textContent ? el.textContent.trim() : '');\\n  const res = { lines: [], bought: 0, spent: 0, failed: false, skipped: false };\\n  const say = (s) => res.lines.push(s);\\n  const modalEl = () => document.getElementById('modal');\\n  const isOpen = () => { const m = modalEl(); return !!m && vis(m.querySelector('.modal-caixa')); };\\n  const closeModal = async () => {\\n    if (!isOpen()) return;\\n    const x = document.getElementById('modal-fechar');\\n    if (x) x.click();\\n    await waitFor(() => !isOpen(), 3000);\\n  };\\n  const linhas = (el) => String((el && el.innerText) || '').split('\\\\n').map((x) => x.trim()).filter(Boolean);\\n  const raizM = () => document.getElementById('modal') || document.body;\\n  // Market novo (sem as classes antigas): acha cada item pelo botão \\\"Comprar N\\\" e pelo texto \\\"você tem ×N\\\"\\n  // lê quantidade, nome e preço pelo TEXTO do cartão (\\\"você tem ×54.150\\\", \\\"Ultra Ball\\\", \\\"130 /un.\\\")\\n  const lerTexto = (c) => {\\n    const ls = linhas(c);\\n    const iTem = ls.findIndex((l) => /voc[eêÊ]\\\\s*tem/i.test(l));\\n    if (iTem < 0) return null;\\n    const temL = ls[iTem];\\n    const have = num((temL.match(/[×xX]\\\\s*([\\\\d.]+)/) || [])[1] || (ls[iTem + 1] && /^[×xX]?\\\\s*[\\\\d.]+$/.test(ls[iTem + 1]) ? ls[iTem + 1] : ''));\\n    const iNome = ls.findIndex((l, k) => k > iTem && !/^[×xX]?\\\\s*[\\\\d.]+$/.test(l));\\n    const iUn = ls.findIndex((l) => /\\\\/\\\\s*un/i.test(l));\\n    let price = null;\\n    if (iUn >= 0) { const m = ls[iUn].match(/([\\\\d.]+)\\\\s*\\\\/\\\\s*un/i); price = m ? num(m[1]) : num(ls[iUn - 1]); }\\n    return { name: iNome >= 0 ? ls[iNome] : '', have, price };\\n  };\\n  const cardsNovos = () => Array.from(raizM().querySelectorAll('button')).filter((b) => /^comprar\\\\b/i.test(txt(b)) && /\\\\d/.test(txt(b))).map((b) => {\\n    let c = b.parentElement;\\n    for (let k = 0; k < 6 && c && !/voc[eêÊ]\\\\s*tem/i.test(c.innerText || ''); k++) c = c.parentElement;\\n    if (!c) return null;\\n    const ls = linhas(c);\\n    const iTem = ls.findIndex((l) => /voc[eê] tem/i.test(l));\\n    if (iTem < 0) return null;\\n    const temL = ls[iTem];\\n    const have = num((temL.match(/[×x]\\\\s*([\\\\d.]+)/i) || [])[1] || (ls[iTem + 1] && /^[×x]?\\\\s*[\\\\d.]+$/.test(ls[iTem + 1]) ? ls[iTem + 1] : ''));\\n    const iNome = ls.findIndex((l, k) => k > iTem && !/^[×x]?\\\\s*[\\\\d.]+$/.test(l));\\n    const name = iNome >= 0 ? ls[iNome] : '';\\n    const iUn = ls.findIndex((l) => /\\\\/\\\\s*un/i.test(l));\\n    let price = null;\\n    if (iUn >= 0) { const m = ls[iUn].match(/([\\\\d.]+)\\\\s*\\\\/\\\\s*un/i); price = m ? num(m[1]) : num(ls[iUn - 1]); }\\n    return { el: c, name, have, price, buyBtn: b, input: c.querySelector('input') };\\n  }).filter((x) => x && x.name);\\n  const readCards = () => {\\n    const antigos = Array.from(document.querySelectorAll('#mk-corpo .mk-card'));\\n    if (!antigos.length) return cardsNovos();\\n    return antigos.map((c) => {\\n      const nome = c.querySelector('.mk-nome');\\n      const tem = c.querySelector('.mk-tem');\\n      const preco = c.querySelector('.mk-preco .mk-moeda') || c.querySelector('.mk-preco');\\n      const card = {\\n        el: c,\\n        name: (nome && nome.getAttribute('title')) || txt(nome),\\n        have: tem ? num((txt(tem).match(/[×xX]\\\\s*([\\\\d.]+)/) || [])[1] || txt(tem)) : null,\\n        price: preco ? num((txt(preco).match(/([\\\\d.]+)/) || [])[1]) : null,\\n        buyBtn: c.querySelector('button.mk-acao') || Array.from(c.querySelectorAll('button')).find((b) => /^comprar\\\\b/i.test(txt(b))) || null,\\n        input: c.querySelector('input[type=number]') || c.querySelector('input'),\\n      };\\n      // o Market mudou e manteve algumas classes antigas: o que não der para ler pelas classes, lê pelo texto\\n      if (card.have === null || !card.price || !card.name) {\\n        const t = lerTexto(c);\\n        if (t) {\\n          if (card.have === null) card.have = t.have;\\n          if (!card.price) card.price = t.price;\\n          if (!card.name) card.name = t.name;\\n        }\\n      }\\n      return card;\\n    });\\n  };\\n  // ouro: o número grande do Market que não está dentro de nenhum item\\n  const readGold = () => {\\n    const velho = document.querySelector('#mk-saldo .mk-moeda');\\n    if (velho) return num(txt(velho));\\n    const cards = readCards().map((c) => c.el);\\n    const nums = Array.from(raizM().querySelectorAll('div, span, b, strong'))\\n      .filter((e) => e.children.length <= 2 && /^[\\\\d.]{4,}$/.test(txt(e)) && !cards.some((c) => c.contains(e)))\\n      .map((e) => num(txt(e)));\\n    return nums.length ? Math.max.apply(null, nums) : null;\\n  };\\n  const temItens = () => readCards().length > 0;\\n\\n  if (isOpen()) {\\n    const m = modalEl();\\n    const titulo = txt(document.getElementById('modal-titulo')).slice(0, 40);\\n    const eMarket = norm(titulo) === 'market';\\n    // aviso/propaganda do jogo (ex.: \\\"Entrar no Discord\\\"): pode fechar pelo X. Qualquer outra janela é sua: não mexe.\\n    if (!eMarket && /discord/i.test(txt(m))) {\\n      const fechar = document.getElementById('modal-fechar')\\n        || m.querySelector('[aria-label*=\\\"echar\\\" i], [title*=\\\"echar\\\" i], .modal-fechar, .fechar')\\n        || Array.from(m.querySelectorAll('button')).find((b) => /^(×|✕|✖|x)$/i.test(txt(b)));\\n      if (fechar) { fechar.click(); await waitFor(() => !isOpen(), 3000); }\\n      if (!isOpen()) say('fechei um aviso do jogo (Discord) que estava na tela');\\n    }\\n    if (isOpen()) {\\n      res.reason = eMarket ? 'Market aberto por você' : 'janela aberta';\\n      say('uma janela do jogo está aberta' + (titulo ? ' (\\\"' + titulo + '\\\")' : '') + ', pulei. Feche-a que eu tento de novo em ~1 min');\\n      res.skipped = true;\\n      return res;\\n    }\\n  }\\n  // O Market abre INVISÍVEL durante a verificação: os cliques funcionam normalmente,\\n  // mas a janela não pisca na sua tela (ela some de novo no final, de qualquer jeito).\\n  const oculto = document.createElement('style');\\n  oculto.id = 'pokelink-market-oculto';\\n  oculto.textContent = '#modal, #modal * { opacity: 0 !important; transition: none !important; animation: none !important; }';\\n  document.head.appendChild(oculto);\\n  const mostrarModal = () => { try { oculto.remove(); } catch (e) {} };\\n  // Modo Economia do jogo (Eco/Mega Eco): a cena e os menus podem ficar escondidos.\\n  // Nesse caso liga a cena só durante a compra e desliga de novo no final.\\n  const acharBtnCena = () => Array.from(document.querySelectorAll('button, [role=button]'))\\n    .find((e) => /ligar a cena/i.test(txt(e)) && vis(e));\\n  let religarEco = false;\\n  const achaMarket = () => {\\n    const todos = Array.from(document.querySelectorAll('nav.menu-topo button, nav button, button, a, [role=button]'));\\n    const ok = (b) => norm(txt(b)) === 'market' || (norm(txt(b)).length < 24 && /\\bmarket\\b/.test(norm(txt(b))));\\n    return todos.find((b) => ok(b) && vis(b)) || todos.find(ok) || null;\\n  };\\n  let btn = achaMarket();\\n  const abrir = async () => {\\n    btn.click();\\n    return waitFor(() => isOpen() && temItens(), 5000);\\n  };\\n  if ((!btn || !vis(btn)) && acharBtnCena()) {\\n    acharBtnCena().click(); religarEco = true;\\n    await waitFor(() => { const b = achaMarket(); return b && vis(b); }, 4000);\\n    btn = achaMarket();\\n    if (religarEco) say('liguei a cena por um instante para usar o Market (Modo Economia)');\\n  }\\n  if (!btn) { mostrarModal(); say('botão Market não encontrado (a conta está logada?)'); res.reason = 'sem botão Market'; res.skipped = true; return res; }\\n  let origKey = null;\\n  try {\\n    let opened = await abrir();\\n    if (!opened && !religarEco && acharBtnCena()) {\\n      // o Market não abriu com a cena desligada: tenta de novo com a cena ligada\\n      acharBtnCena().click(); religarEco = true;\\n      say('liguei a cena por um instante para usar o Market (Modo Economia)');\\n      await sleep(1200);\\n      btn = achaMarket() || btn;\\n      opened = await abrir();\\n    }\\n    if (!opened) { say('o Market não abriu'); res.failed = true; return res; }\\n    // aba de compra (\\\"Compra\\\" no Market antigo, \\\"Comprar\\\" no novo)\\n    const aba = Array.from(document.querySelectorAll('.mk-aba')).find((b) => /^compra(r)?$/i.test(txt(b)))\\n      || Array.from(raizM().querySelectorAll('button, [role=tab]')).find((b) => /^compra(r)?$/i.test(txt(b)) && !/voc[eê] tem/i.test((b.parentElement && b.parentElement.innerText) || ''));\\n    if (aba && !aba.classList.contains('on')) { aba.click(); await sleep(500); }\\n    // abas do Market: aceita nome com ícone, número ou singular/plural (ex.: \\\"🧪 Poções 3\\\", \\\"Poção\\\")\\n    const raiz = (k) => norm(k).replace(/[^a-z]/g, '').replace(/(oes|aos|as|os|es|s)$/, '').slice(0, 3);\\n    // categorias: no Market novo ficam na coluna \\\"Categorias\\\", com o nome na 1ª linha (ex.: \\\"Poções / Curam em campo\\\")\\n    const abasCat = () => {\\n      const velhas = Array.from(document.querySelectorAll('.mk-cat'));\\n      if (velhas.length) return velhas;\\n      const nomes = ['pokebolas', 'pocoes', 'revives', 'ovos', 'itens', 'pedras'];\\n      return Array.from(raizM().querySelectorAll('button, [role=tab], li, a, div')).filter((e) => {\\n        const l = linhas(e);\\n        return l.length >= 1 && l.length <= 3 && nomes.some((n) => norm(l[0]).includes(n)) && !/voc[eê] tem/i.test(e.innerText || '') &&\\n          !Array.from(e.children).some((ch) => linhas(ch).length && norm(linhas(ch)[0]) === norm(l[0]) && linhas(ch).length === l.length);\\n      });\\n    };\\n    const catBtn = (key) => {\\n      const abas = abasCat().map((b) => Object.assign(b, { __t: linhas(b)[0] || txt(b) }));\\n      return abas.find((b) => norm(b.__t) === key)\\n        || abas.find((b) => norm(b.__t).includes(key))\\n        || abas.find((b) => raiz(b.__t) && raiz(b.__t) === raiz(key)) || null;\\n    };\\n    // se não achar a aba pelo nome, procura o item passando pelas abas\\n    const acharAbaDoItem = async (nome) => {\\n      for (const b of abasCat()) {\\n        if (!b.classList.contains('on')) { b.click(); await sleep(400); }\\n        if (readCards().some((c) => norm(c.name) === norm(nome))) return b;\\n      }\\n      return null;\\n    };\\n    const cur = document.querySelector('.mk-cat.on');\\n    origKey = cur ? norm(txt(cur)) : null;\\n    const cats = [];\\n    opts.rules.forEach((r) => { if (cats.indexOf(r.cat) < 0) cats.push(r.cat); });\\n\\n    let remaining = opts.maxSpend;\\n    let stop = false;\\n    for (const catName of cats) {\\n      if (stop) break;\\n      const group = opts.rules.filter((r) => r.cat === catName);\\n      let cb = catBtn(norm(catName));\\n      if (!cb) cb = await acharAbaDoItem(group[0].name);\\n      if (!cb) { say('aba \\\"' + catName + '\\\" não encontrada no Market (abas: ' + abasCat().map((b) => linhas(b)[0]).join(', ') + '), pulei'); continue; }\\n      if (!readCards().some((c) => norm(c.name) === norm(group[0].name))) {\\n        cb.click();\\n        const shown = await waitFor(() => readCards().some((c) => norm(c.name) === norm(group[0].name)), 4000);\\n        if (!shown) { say('não consegui abrir a aba ' + catName + ', pulei'); continue; }\\n        await sleep(200);\\n      }\\n      for (const rule of group) {\\n        const find = () => readCards().find((c) => norm(c.name) === norm(rule.name));\\n        const card = find();\\n        if (!card) { say(rule.name + ': não achei na loja'); continue; }\\n        if (card.have === null || !card.price) {\\n          say(rule.name + ': não consegui ler quantidade/preço, pulei (tela: \\\"' + linhas(card.el).slice(0, 8).join(' | ') + '\\\")');\\n          continue;\\n        }\\n        if (card.have >= rule.min) { say(rule.name + ': tem ' + card.have + ' (ok, mínimo ' + rule.min + ')'); continue; }\\n        const gold = readGold();\\n        if (gold === null) { say('não consegui ler o ouro, pulei'); stop = true; break; }\\n        let qty = Math.min(rule.buy, Math.floor(Math.max(0, gold - opts.reserve) / card.price), Math.floor(remaining / card.price));\\n        if (qty < 1) { say(rule.name + ': tem ' + card.have + ' (baixo), mas sem ouro livre ou limite por hora atingido'); continue; }\\n        let custo = qty * card.price;\\n        const input = card.input;\\n        if (!input) { say(rule.name + ': campo de quantidade não encontrado'); res.failed = true; stop = true; break; }\\n        const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set;\\n        setter.call(input, String(qty));\\n        input.dispatchEvent(new Event('input', { bubbles: true }));\\n        input.dispatchEvent(new Event('change', { bubbles: true }));\\n        await sleep(300);\\n        // o jogo às vezes ajusta sozinho o número digitado (ex.: perto de algum limite da tela);\\n        // usa o que ele realmente aceitou no campo, em vez de travar achando que deu algo errado\\n        const aceito = num(input.value);\\n        if (aceito && aceito !== qty) { qty = aceito; custo = qty * card.price; }\\n        const totEl = card.el.querySelector('.mk-total .mk-moeda');\\n        const total = totEl ? num(txt(totEl)) : num(txt((find() || card).buyBtn)); // Market novo: o total fica no botão \\\"Comprar N\\\"\\n        if (total !== custo) { say(rule.name + ': total na tela (' + total + ') difere do esperado (' + custo + '), NÃO comprei'); res.failed = true; stop = true; break; }\\n        if (opts.dry) { say('TESTE: compraria ' + qty + ' ' + rule.name + ' por ' + custo + ' ouro (tem ' + card.have + '). Total conferido, não cliquei em Comprar'); continue; }\\n        const compra = (find() || card).buyBtn;\\n        if (!compra) { say(rule.name + ': botão Comprar não encontrado'); res.failed = true; stop = true; break; }\\n        const antes = card.have;\\n        compra.click();\\n        const ok = await waitFor(() => { const c = find(); return c && c.have !== null && c.have >= antes + qty; }, 12000);\\n        if (!ok) { say(rule.name + ': cliquei em Comprar mas a quantidade não subiu, parei por segurança'); res.failed = true; stop = true; break; }\\n        remaining -= custo; res.spent += custo; res.bought += qty;\\n        say('Comprei ' + qty + ' ' + rule.name + ' por ' + custo + ' ouro (tinha ' + antes + ')');\\n      }\\n    }\\n    return res;\\n  } finally {\\n    // deixa o Market na aba em que estava antes de fechar\\n    try {\\n      const k = origKey && Array.from(document.querySelectorAll('.mk-cat')).find((b) => norm(txt(b)) === origKey);\\n      if (k && !k.classList.contains('on') && isOpen()) { k.click(); await sleep(150); }\\n    } catch (e) {}\\n    await closeModal();\\n    await sleep(150);\\n    mostrarModal(); // as janelas do jogo voltam a aparecer normalmente\\n    // volta ao Modo Economia, se a cena foi ligada só para a compra\\n    if (religarEco) {\\n      await sleep(400);\\n      const eco = document.getElementById('hunt-eco');\\n      if (eco && !acharBtnCena()) { eco.click(); say('voltei ao Modo Economia'); }\\n    }\\n  }\\n})`;\\n\\nasync function runAutoBuy(i) {\\n  if (sono.ausente) return; // PC ausente: as contas estão em branco\\n  if (autoBusy[i]) return;\\n  const wc = views[i] && views[i].webContents;\\n  if (!wc || wc.isDestroyed()) return;\\n  if (wc.isLoading()) { autoStatus[i] = 'carregando...'; autoLast[i] = Date.now() - checkMs() + 30000; sendState(); return; }\\n  if (level[i] === 3) { autoStatus[i] = 'hibernando, pulou'; sendState(); return; }\\n  const cfg = cfgDe(i);\\n  const rules = cfg.rules.filter((r) => r.on);\\n  if (!rules.length) { autoStatus[i] = 'nenhum item ativo'; sendState(); return; }\\n  autoBusy[i] = true;\\n  try {\\n    const spentHour = spendLog[i].filter((e) => Date.now() - e.t < 3600000).reduce((a, e) => a + e.v, 0);\\n    const opts = { rules, dry: false, reserve: cfg.reserve, maxSpend: Math.max(0, cfg.maxHour - spentHour) };\\n    const r = await withTimeout(wc.executeJavaScript(AUTOBUY_PAGE + '(' + JSON.stringify(opts) + ')'), 180000);\\n    const hora = new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });\\n    r.lines.forEach((l) => autoLog(i, l));\\n    if (r.spent > 0) spendLog[i].push({ t: Date.now(), v: r.spent });\\n    spendLog[i] = spendLog[i].filter((e) => Date.now() - e.t < 3600000); // só interessa a última hora; o resto só ia crescendo à toa\\n    if (r.failed) {\\n      // Falhou: NÃO desliga mais a Auto Compra em nenhuma conta, por quantas vezes seguidas for.\\n      // Ela só tenta de novo em 5 min e lê tudo outra vez antes de comprar (não compra em dobro).\\n      autoFalhas[i]++;\\n      autoStatus[i] = `${hora} falhou, tento em 5 min (${autoFalhas[i]}ª vez seguida)`;\\n      autoLog(i, `falhou (${autoFalhas[i]}ª vez seguida); nova tentativa em ~5 min`);\\n      autoLast[i] = Date.now() - checkMs() + 5 * 60000;\\n    } else if (r.skipped) {\\n      autoFalhas[i] = 0;\\n      autoStatus[i] = `${hora} ${r.reason || 'pulou'}`;\\n      autoLast[i] = Date.now() - checkMs() + 60000; // tenta de novo em ~1 min\\n    }\\n    else if (r.bought > 0) { autoFalhas[i] = 0; autoStatus[i] = `${hora} comprou`; }\\n    else { autoFalhas[i] = 0; autoStatus[i] = `${hora} ok`; }\\n  } catch (e) {\\n    autoStatus[i] = 'erro';\\n    autoLog(i, 'erro: ' + e.message);\\n  } finally {\\n    autoBusy[i] = false;\\n    sendState();\\n  }\\n}\\n\\n// pega as imagens de verdade de cada item (Poké Ball, Great Ball, poções...) direto do Market do jogo,\\n// pra usar no painel \\\"O que comprar\\\" em vez do ícone desenhado. Precisa que o Market esteja aberto na conta.\\nipcMain.handle('market-icons-capture', async (_, i) => {\\n  if (!Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return { erro: 'conta inválida' };\\n  const wc = views[i] && views[i].webContents;\\n  if (!wc || wc.isDestroyed()) return { erro: 'conta não encontrada' };\\n  const r = await withTimeout(wc.executeJavaScript(String.raw`(() => {\\n    const txt = (el) => (el && el.textContent ? el.textContent.trim() : '');\\n    const modal = document.getElementById('modal');\\n    const temModal = !!modal;\\n    const caixa = modal ? modal.querySelector('.modal-caixa') : null;\\n    if (!modal) return { erro: 'não achei nenhum #modal na página', temModal, debug: [] };\\n    const linhas = (el) => String((el && el.innerText) || '').split('\\\\n').map((x) => x.trim()).filter(Boolean);\\n    const itens = [];\\n    const debug = [];\\n    const todosBotoes = Array.from(modal.querySelectorAll('button, [role=\\\"button\\\"]'));\\n    const botoes = todosBotoes.filter((b) => /comprar/i.test(txt(b)));\\n    const amostraBotoes = botoes.length ? [] : todosBotoes.slice(0, 15).map((b) => txt(b).slice(0, 40));\\n    botoes.forEach((b) => {\\n      let c = b.parentElement;\\n      for (let k = 0; k < 6 && c && !/voc[eê] tem/i.test(c.innerText || ''); k++) c = c.parentElement;\\n      const ls = c ? linhas(c) : [];\\n      const iTem = ls.findIndex((l) => /voc[eê] tem/i.test(l));\\n      const iNome = iTem >= 0 ? ls.findIndex((l, k) => k > iTem && !/^[×x]?\\\\s*[\\\\d.]+$/.test(l)) : -1;\\n      const name = iNome >= 0 ? ls[iNome] : '';\\n      const imgs = c ? Array.from(c.querySelectorAll('img')).map((im) => im.src) : [];\\n      debug.push({ achouContainer: !!c, temVoceTem: iTem >= 0, name, qtdImgsNoContainer: imgs.length, primeiraImg: imgs[0] || null });\\n      if (name && imgs[0]) itens.push({ name, src: imgs[0] });\\n    });\\n    return { itens, debug, temModal, temCaixa: !!caixa, qtdBotoesComprar: botoes.length, qtdTodosBotoes: todosBotoes.length, amostraBotoes, qtdImgsNaPagina: document.querySelectorAll('img').length };\\n  })()`), 8000).catch((e) => ({ erro: e.message }));\\n  try {\\n    const f = path.join(app.getPath('desktop'), 'market-icones-diagnostico.json');\\n    fs.writeFileSync(f, JSON.stringify(r, null, 1));\\n  } catch {}\\n  if (r && r.itens && r.itens.length) {\\n    let atual = {};\\n    try { atual = JSON.parse(fs.readFileSync(marketIconsFile(), 'utf8')); } catch {}\\n    r.itens.forEach((it) => { atual[it.name] = it.src; });\\n    try { fs.mkdirSync(path.dirname(marketIconsFile()), { recursive: true }); fs.writeFileSync(marketIconsFile(), JSON.stringify(atual)); } catch {}\\n    return { ok: true, achados: r.itens.length, itens: atual };\\n  }\\n  return { erro: (r && r.erro) || 'não achou nenhuma imagem; olha o arquivo market-icones-diagnostico.json na Área de Trabalho' };\\n});\\nipcMain.handle('market-icons-get', async () => {\\n  try { return JSON.parse(fs.readFileSync(marketIconsFile(), 'utf8')); } catch { return {}; }\\n});\\n\\nfunction startAutoBuyTimer() {\\n  // escalona as contas para não abrirem o Market todas ao mesmo tempo\\n  ACCOUNTS.forEach((_, i) => { autoLast[i] = Date.now() - checkMs() + 30000 + i * 15000; });\\n  setInterval(() => {\\n    ACCOUNTS.forEach((_, i) => {\\n      if (auto.enabled[i] && Date.now() - autoLast[i] >= checkMs()) {\\n        autoLast[i] = Date.now();\\n        runAutoBuy(i);\\n      }\\n    });\\n  }, 10000);\\n}\\n\\n// ---------- Troca de hunt automática (segue a recomendação da extensão /hunt) ----------\\n// Igual à Auto Compra: o PokeLink faz o que um jogador faria, com as janelas invisíveis.\\n// 1) abre a /hunt, marca \\\"só hunts liberadas\\\" e o critério (XP/h ou Ouro/h) e lê o ranking;\\n// 2) escolhe a melhor hunt SEGURA (risco até o limite) que ganhe da atual pela margem escolhida;\\n// 3) abre o Mapa no modo Lista, vai na região e clica na hunt; depois confere se o jogo trocou mesmo.\\n// Começa DESLIGADA em todas as contas. Nunca troca com janela do jogo aberta nem em combate.\\nconst HUNT_LER = String.raw`(async (o) => {\\n  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n  const vis = (el) => { if (!el) return false; const r = el.getBoundingClientRect(); const cs = getComputedStyle(el); return r.width > 0 && r.height > 0 && cs.display !== 'none' && cs.visibility !== 'hidden'; };\\n  const txt = (el) => (el && el.textContent ? el.textContent.trim() : '');\\n  const waitFor = async (fn, ms) => { const t0 = Date.now(); while (Date.now() - t0 < ms) { const v = fn(); if (v) return v; await sleep(150); } return null; };\\n  const valor = (t) => {\\n    t = String(t || '').toLowerCase().replace(/\\\\s/g, '');\\n    const m = t.match(/([\\\\d.,]+)(bi|mi|mil|k|m|b)?/);\\n    if (!m) return 0;\\n    let n = parseFloat(m[1].replace(/\\\\./g, '').replace(',', '.')) || 0;\\n    const s = m[2] || '';\\n    if (s === 'bi' || s === 'b') n *= 1e9; else if (s === 'mi' || s === 'm') n *= 1e6; else if (s === 'mil' || s === 'k') n *= 1e3;\\n    return n;\\n  };\\n  const modal = document.getElementById('modal');\\n  const caixa = modal && modal.querySelector('.modal-caixa');\\n  if (caixa && vis(caixa)) return { motivo: 'janela do jogo aberta' };\\n  const ic = document.getElementById('ir-centro') || document.getElementById('eco-ir-centro');\\n  if (ic && ic.disabled) return { motivo: 'em combate' };\\n  const atualTxt = txt(document.getElementById('eco-onde')) || txt(document.getElementById('hud-hunt'));\\n  const barra = document.querySelector('button.pih-barra');\\n  if (!barra) return { motivo: 'extensão /hunt não encontrada nesta conta', atualTxt };\\n  const st = document.createElement('style');\\n  st.id = 'pokelink-hunt-oculto';\\n  st.textContent = '.pih-painel, .pih-painel * { opacity: 0 !important; transition: none !important; animation: none !important; }';\\n  document.head.appendChild(st);\\n  let painel = document.querySelector('.pih-painel');\\n  const jaAberto = painel && vis(painel);\\n  try {\\n    if (!jaAberto) barra.click();\\n    painel = await waitFor(() => { const p = document.querySelector('.pih-painel'); return p && vis(p) && p.querySelector('table.pih-tab tbody tr') ? p : null; }, 10000);\\n    if (!painel) return { motivo: 'a /hunt não abriu', atualTxt };\\n    const seg = Array.from(painel.querySelectorAll('.pih-seg button'));\\n    const quer = o.criterio === 'ouro' ? /ouro/i : /xp/i;\\n    const bt = seg.find((x) => quer.test(txt(x)));\\n    if (bt && !bt.classList.contains('on')) { bt.click(); await sleep(1200); }\\n    const lab = Array.from(painel.querySelectorAll('label')).find((l) => /liberadas/i.test(txt(l)));\\n    const cb = lab && lab.querySelector('input[type=checkbox]');\\n    if (cb && !cb.checked) { cb.click(); await sleep(1500); }\\n    await sleep(500);\\n    const ths = Array.from(painel.querySelectorAll('table.pih-tab thead th')).map((t) => txt(t).toLowerCase());\\n    const col = (re, def) => { const k = ths.findIndex((t) => re.test(t)); return k >= 0 ? k : def; };\\n    const cXp = col(/xp/, 2), cOuro = col(/ouro/, 6), cRisco = col(/risco/, 5);\\n    const rows = Array.from(painel.querySelectorAll('table.pih-tab tbody tr')).slice(0, 40).map((tr) => {\\n      const tds = tr.querySelectorAll('td');\\n      const sub = txt(tr.querySelector('td.pih-hunt small'));\\n      const partes = sub.split('·');\\n      const rTxt = txt(tds[cRisco]);\\n      const rm = rTxt.match(/(\\\\d+)\\\\s*%/);\\n      return {\\n        nome: txt(tr.querySelector('td.pih-hunt b')),\\n        regiao: (partes[0] || '').trim(),\\n        nv: parseInt(String(partes[1] || '').replace(/\\\\D/g, ''), 10) || 0,\\n        val: valor(txt(tds[o.criterio === 'ouro' ? cOuro : cXp])),\\n        risco: rm ? Number(rm[1]) : null,\\n        seguro: !!(tds[cRisco] && tds[cRisco].querySelector('.pih-ok')),\\n      };\\n    }).filter((r) => r.nome);\\n    return { ok: true, atualTxt, rows };\\n  } finally {\\n    if (!jaAberto) { const f = document.querySelector('.pih-painel .pih-fechar'); if (f) f.click(); else document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true })); }\\n    await sleep(300);\\n    st.remove();\\n  }\\n})`;\\nconst HUNT_IR = String.raw`(async (o) => {\\n  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n  const vis = (el) => { if (!el) return false; const r = el.getBoundingClientRect(); const cs = getComputedStyle(el); return r.width > 0 && r.height > 0 && cs.display !== 'none' && cs.visibility !== 'hidden'; };\\n  const txt = (el) => (el && el.textContent ? el.textContent.trim() : '');\\n  const norm = (s) => String(s || '').normalize('NFD').replace(/[\\\\u0300-\\\\u036f]/g, '').toLowerCase().trim();\\n  const num = (s) => parseInt(String(s || '').replace(/\\\\D/g, ''), 10) || 0;\\n  const waitFor = async (fn, ms) => { const t0 = Date.now(); while (Date.now() - t0 < ms) { const v = fn(); if (v) return v; await sleep(150); } return null; };\\n  const modal = () => document.getElementById('modal');\\n  const aberto = () => { const m = modal(); const c = m && m.querySelector('.modal-caixa'); return !!c && vis(c); };\\n  if (aberto()) return { motivo: 'janela do jogo aberta' };\\n  const atualTxt = () => txt(document.getElementById('eco-onde')) || txt(document.getElementById('hud-hunt'));\\n  const ehAlvo = () => { const a = norm(atualTxt()); return a.includes(norm(o.nome)) && (!o.nv || num(a.split(norm(o.nome))[1]) === o.nv || num(a) === o.nv); };\\n  const st = document.createElement('style');\\n  st.id = 'pokelink-mapa-oculto';\\n  st.textContent = '#modal, #modal * { opacity: 0 !important; transition: none !important; animation: none !important; }';\\n  document.head.appendChild(st);\\n  let busca = null;\\n  try {\\n    const btMapa = Array.from(document.querySelectorAll('button')).find((b) => !b.closest('#modal') && norm(txt(b)) === 'mapa');\\n    if (!btMapa) return { motivo: 'botão Mapa não encontrado' };\\n    btMapa.click();\\n    const ok = await waitFor(() => aberto() && /mapa/i.test(txt(document.getElementById('modal-titulo'))), 6000);\\n    if (!ok) return { motivo: 'o Mapa não abriu' };\\n    const lista = document.querySelector('.mapa-modo-bt[aria-label=\\\"Lista\\\"]');\\n    if (lista && !lista.classList.contains('on')) { lista.click(); await sleep(500); }\\n    const reg = Array.from(document.querySelectorAll('.mapa-reg-bt')).find((b) => norm(txt(b.querySelector('.mapa-reg-nome'))) === norm(o.regiao));\\n    if (!reg) return { motivo: 'região ' + o.regiao + ' não encontrada' };\\n    if (reg.classList.contains('mapa-area-travada')) return { motivo: 'região ' + o.regiao + ' travada' };\\n    if (!reg.classList.contains('on')) { reg.click(); await sleep(700); }\\n    const acha = () => Array.from(document.querySelectorAll('#ml-corpo .ml-linha')).find((r) => norm(txt(r.querySelector('.ml-nome'))) === norm(o.nome) && (!o.nv || num(txt(r.querySelector('.ml-nv'))) === o.nv));\\n    let linha = await waitFor(acha, 3000);\\n    if (!linha) { // usa a busca do mapa\\n      busca = document.getElementById('f-mapa');\\n      if (busca) { busca.value = o.nome; busca.dispatchEvent(new Event('input', { bubbles: true })); linha = await waitFor(acha, 3000); }\\n    }\\n    if (!linha) return { motivo: o.nome + ' não encontrado no mapa' };\\n    if (linha.classList.contains('on')) return { ok: true, ja: true };\\n    if (/trav/i.test(linha.className) || txt(linha.querySelector('.ml-trava'))) return { motivo: o.nome + ' está travado' };\\n    linha.click();\\n    const foi = await waitFor(ehAlvo, 9000);\\n    return foi ? { ok: true } : { motivo: 'o jogo não trocou (talvez em combate)' };\\n  } finally {\\n    if (busca) { busca.value = ''; busca.dispatchEvent(new Event('input', { bubbles: true })); }\\n    if (aberto()) { const x = document.getElementById('modal-fechar'); if (x) x.click(); await sleep(400); }\\n    st.remove();\\n  }\\n})`;\\nconst autoHunt = { contas: ACCOUNTS.map(() => false), criterio: 'xp', riscoMax: 30, margem: 10, intervaloMin: 15 };\\nconst huntStatus = ACCOUNTS.map(() => 'desligado');\\nconst huntUlt = ACCOUNTS.map(() => 0);       // última verificação\\nconst huntUltTroca = ACCOUNTS.map(() => 0);  // última troca feita\\nconst huntHist = ACCOUNTS.map(() => []);     // trocas feitas (mais recentes primeiro)\\nconst autoHuntFile = () => path.join(app.getPath('userData'), 'autohunt.json');\\nfunction loadAutoHunt() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(autoHuntFile(), 'utf8'));\\n    (Array.isArray(j.contas) ? j.contas : []).forEach((v, i) => { if (i < ACCOUNTS.length) autoHunt.contas[i] = !!v; });\\n    if (['xp', 'ouro'].includes(j.criterio)) autoHunt.criterio = j.criterio;\\n    if ([10, 20, 30, 50, 100].includes(j.riscoMax)) autoHunt.riscoMax = j.riscoMax;\\n    if ([5, 10, 20, 30].includes(j.margem)) autoHunt.margem = j.margem;\\n    if ([10, 15, 30, 60].includes(j.intervaloMin)) autoHunt.intervaloMin = j.intervaloMin;\\n    autoHunt.contas.forEach((on, i) => { huntStatus[i] = on ? 'ligada' : 'desligado'; });\\n  } catch {}\\n}\\nconst saveAutoHunt = () => { try { fs.writeFileSync(autoHuntFile(), JSON.stringify(autoHunt)); } catch {} };\\nconst avisarHunt = () => { if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('hunt-update'); sendState(); };\\nconst huntHora = () => new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });\\n// \\\"Shedinja · nível 500\\\" -> { nome, nv }\\nconst lerAtual = (t) => { const m = String(t || '').match(/^(.+?)\\\\s*[·-]\\\\s*n[ií]vel\\\\s*([\\\\d.]+)/i); return m ? { nome: m[1].trim(), nv: parseInt(m[2].replace(/\\\\D/g, ''), 10) } : { nome: String(t || '').trim(), nv: 0 }; };\\nconst mesmaHunt = (a, b) => a && b && a.nome.toLowerCase() === b.nome.toLowerCase() && (!a.nv || !b.nv || a.nv === b.nv);\\nasync function rodarAutoHunt(i, forcar) {\\n  const wc = views[i] && views[i].webContents;\\n  if (sono.ausente || !wc || wc.isDestroyed() || wc.isLoading() || level[i] === 3) return;\\n  if (autoBusy[i]) { huntStatus[i] = 'esperando outra tarefa terminar'; huntUlt[i] = Date.now() - autoHunt.intervaloMin * 60000 + 60000; avisarHunt(); return; }\\n  autoBusy[i] = true;\\n  huntStatus[i] = 'conferindo...'; avisarHunt();\\n  const deNovoEm = (min) => { huntUlt[i] = Date.now() - autoHunt.intervaloMin * 60000 + min * 60000; };\\n  try {\\n    const r = await withTimeout(wc.executeJavaScript(HUNT_LER + '(' + JSON.stringify({ criterio: autoHunt.criterio }) + ')'), 30000).catch(() => null);\\n    if (!r || !r.ok) { huntStatus[i] = `${huntHora()} ${(r && r.motivo) || 'não consegui ler a /hunt'}`; deNovoEm(2); return; }\\n    const atual = lerAtual(r.atualTxt);\\n    const seguras = r.rows.filter((x) => x.val > 0 && x.regiao && (x.risco == null ? x.seguro : x.risco <= autoHunt.riscoMax))\\n      .sort((a, b) => b.val - a.val);\\n    const melhor = seguras[0];\\n    if (!melhor) { huntStatus[i] = `${huntHora()} nenhuma hunt dentro do risco de ${autoHunt.riscoMax}%`; return; }\\n    if (mesmaHunt(atual, melhor)) { huntStatus[i] = `${huntHora()} já está na melhor: ${melhor.nome} Nv ${melhor.nv}`; return; }\\n    const linhaAtual = r.rows.find((x) => mesmaHunt(atual, x));\\n    const ganho = linhaAtual && linhaAtual.val > 0 ? (melhor.val / linhaAtual.val - 1) * 100 : null;\\n    if (ganho != null && ganho < autoHunt.margem) { huntStatus[i] = `${huntHora()} ${atual.nome} já está perto da melhor (${melhor.nome} só +${Math.floor(ganho)}%)`; return; }\\n    if (!forcar && Date.now() - huntUltTroca[i] < 10 * 60000) { huntStatus[i] = `${huntHora()} trocou há pouco; espera para não ficar pulando`; return; }\\n    huntStatus[i] = `indo para ${melhor.nome} (${melhor.regiao} Nv ${melhor.nv})...`; avisarHunt();\\n    const ir = await withTimeout(wc.executeJavaScript(HUNT_IR + '(' + JSON.stringify({ nome: melhor.nome, regiao: melhor.regiao, nv: melhor.nv }) + ')'), 40000).catch(() => null);\\n    if (ir && ir.ok) {\\n      huntUltTroca[i] = Date.now();\\n      const linha = { em: Date.now(), de: atual.nome ? `${atual.nome}${atual.nv ? ' Nv ' + atual.nv : ''}` : '?', para: `${melhor.nome} Nv ${melhor.nv}`, regiao: melhor.regiao, ganho: ganho != null ? Math.round(ganho) : null, criterio: autoHunt.criterio };\\n      if (!ir.ja) { huntHist[i].unshift(linha); huntHist[i].length = Math.min(huntHist[i].length, 20); avisoCelular('hunt', 'Hunt trocada', `${nameOf(i)}: ${linha.de} → ${linha.para}${linha.ganho != null ? ` (+${linha.ganho}%)` : ''}.`); }\\n      huntStatus[i] = `${huntHora()} ${ir.ja ? 'já estava em' : 'trocou para'} ${melhor.nome} Nv ${melhor.nv}${ganho != null && !ir.ja ? ` (+${Math.round(ganho)}%)` : ''}`;\\n    } else {\\n      huntStatus[i] = `${huntHora()} não trocou: ${(ir && ir.motivo) || 'sem resposta'}`;\\n      deNovoEm(2); // tenta de novo em ~2 min\\n    }\\n  } finally {\\n    autoBusy[i] = false;\\n    avisarHunt();\\n  }\\n}\\nfunction startAutoHuntTimer() {\\n  ACCOUNTS.forEach((_, i) => { huntUlt[i] = Date.now() - autoHunt.intervaloMin * 60000 + 90000 + i * 20000; }); // 1ª conferência ~1,5 min depois de abrir\\n  setInterval(() => {\\n    ACCOUNTS.forEach((_, i) => {\\n      if (autoHunt.contas[i] && Date.now() - huntUlt[i] >= autoHunt.intervaloMin * 60000) { huntUlt[i] = Date.now(); rodarAutoHunt(i); }\\n    });\\n  }, 15000);\\n}\\nconst huntDados = () => ({\\n  criterio: autoHunt.criterio, riscoMax: autoHunt.riscoMax, margem: autoHunt.margem, intervaloMin: autoHunt.intervaloMin,\\n  contas: ACCOUNTS.map((_, i) => ({ i, nome: nameOf(i), on: autoHunt.contas[i], status: huntStatus[i],\\n    proxima: autoHunt.contas[i] ? Math.max(0, Math.round((huntUlt[i] + autoHunt.intervaloMin * 60000 - Date.now()) / 60000)) : null,\\n    hist: huntHist[i].slice(0, 5).map((h) => ({ ...h, hora: new Date(h.em).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) })) })),\\n});\\nipcMain.handle('hunt-get', () => huntDados());\\nipcMain.on('hunt-set', (_, d) => {\\n  d = d || {};\\n  if (Number.isInteger(d.conta) && d.conta >= 0 && d.conta < ACCOUNTS.length) {\\n    autoHunt.contas[d.conta] = !!d.on;\\n    huntStatus[d.conta] = d.on ? 'ligada · primeira conferência em ~10 s' : 'desligado';\\n    if (d.on) huntUlt[d.conta] = Date.now() - autoHunt.intervaloMin * 60000 + 10000;\\n  }\\n  if (['xp', 'ouro'].includes(d.criterio)) autoHunt.criterio = d.criterio;\\n  if ([10, 20, 30, 50, 100].includes(Number(d.riscoMax))) autoHunt.riscoMax = Number(d.riscoMax);\\n  if ([5, 10, 20, 30].includes(Number(d.margem))) autoHunt.margem = Number(d.margem);\\n  if ([10, 15, 30, 60].includes(Number(d.intervaloMin))) autoHunt.intervaloMin = Number(d.intervaloMin);\\n  saveAutoHunt();\\n  avisarHunt();\\n});\\nipcMain.on('hunt-panel', () => showAutoHunt());\\nipcMain.handle('hunt-agora', async (_, i) => { if (Number.isInteger(i) && i >= 0 && i < ACCOUNTS.length) await rodarAutoHunt(i, true); return huntDados(); });\\nfunction showAutoHunt() {\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (!canDraw) return;\\n  const id = ++cfgPanelSeq;\\n  cfgPanels.add(id);\\n  dialogOpen = true;\\n  layout();\\n  titleBar.webContents.focus();\\n  titleBar.webContents.send('title-autohunt', { id });\\n}\\n\\nipcMain.on('auto-set', (_, i, on) => {\\n  if (!(i >= 0 && i < ACCOUNTS.length)) return;\\n  auto.enabled[i] = !!on;\\n  autoFalhas[i] = 0;\\n  autoStatus[i] = on ? 'ligado' : 'desligado';\\n  if (on) autoLast[i] = Date.now() - checkMs() + 5000; // primeira verificação em ~5s\\n  saveAuto();\\n  sendState();\\n});\\n\\n// ---------- Janela de configuração da Auto Compra ----------\\nlet cfgWin = null;\\nfunction openAutoConfig() {\\n  if (cfgWin && !cfgWin.isDestroyed()) { cfgWin.show(); cfgWin.focus(); return; }\\n  cfgWin = new BrowserWindow({\\n    width: 680, height: 820, minWidth: 520, minHeight: 560,\\n    title: 'Auto Compra — Configurações', backgroundColor: '#141417', autoHideMenuBar: true,\\n    titleBarStyle: 'hidden', // mesma barra de título do PokeLink\\n    titleBarOverlay: { color: TITLE_BG, symbolColor: TITLE_FG, height: TITLE_H },\\n    ...(customIconPath() ? { icon: customIconPath() } : {}),\\n    webPreferences: { preload: path.join(__dirname, 'preload.js') },\\n  });\\n  cfgWin.setMenu(null);\\n  cfgWin.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'config' } });\\n}\\n// salva a configuração de uma conta (ou de todas, com \\\"todas\\\")\\nfunction saveAutoCfg(c, conta, todas) {\\n  const nova = sanitizeCfg(c);\\n  auto.intervalMin = nova.intervalMin; // o intervalo entre verificações vale para todas\\n  ACCOUNTS.forEach((_, i) => {\\n    if (todas || i === conta || !Number.isInteger(conta)) auto.contas[i] = sanitizeCfg(nova);\\n    auto.contas[i].intervalMin = nova.intervalMin;\\n  });\\n  if (todas || !Number.isInteger(conta)) Object.assign(auto, nova);\\n  saveAuto();\\n  buildMenu(); // atualiza o item \\\"Modo teste\\\" do menu\\n  sendState();\\n  return { ok: true };\\n}\\n// engrenagem da barra: a configuração desce do botão como um painel (desenhado pela barra de título)\\nlet cfgPanelSeq = 0;\\nconst cfgPanels = new Set();\\nipcMain.on('auto-config', (e, rect) => {\\n  const bi = bars.findIndex((b) => b.webContents === e.sender);\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (!canDraw || bi < 0 || !rect) { openAutoConfig(); return; }\\n  const b = bars[bi].getBounds();\\n  const id = ++cfgPanelSeq;\\n  cfgPanels.add(id);\\n  dialogOpen = true; // a barra de título cobre a janela enquanto o painel está aberto\\n  layout();\\n  titleBar.webContents.focus();\\n  titleBar.webContents.send('title-autocfg', {\\n    id, conta: bi, nome: nameOf(bi), on: !!auto.enabled[bi], status: autoStatus[bi] || '', x: b.x + Math.round(rect.left) - 8, y: b.y + Math.round(rect.bottom) + 4, up: b.y + Math.round(rect.top) - 4,\\n  });\\n});\\nipcMain.on('auto-run-now', (_, i) => { if (Number.isInteger(i) && i >= 0 && i < ACCOUNTS.length) runAutoBuy(i); });\\nipcMain.on('auto-log', () => { try { fs.appendFileSync(autoLogFile(), ''); } catch {} shell.openPath(autoLogFile()); });\\nipcMain.on('title-autocfg-closed', (_, id) => {\\n  cfgPanels.delete(id);\\n  dialogOpen = dlgWait.size > 0 || popWait.size > 0 || cfgPanels.size > 0;\\n  layout();\\n});\\nipcMain.handle('autocfg-get', (_, defaults, conta) => {\\n  const i = Number.isInteger(conta) && conta >= 0 && conta < ACCOUNTS.length ? conta : 0;\\n  const src = defaults ? sanitizeCfg({}) : cfgDe(i);\\n  return { dry: src.dry, rules: src.rules, reserve: src.reserve, maxHour: src.maxHour, intervalMin: auto.intervalMin, icon: customIconUrl(),\\n    conta: i, contas: ACCOUNTS.map((_, k) => ({ nome: nameOf(k), on: !!auto.enabled[k] })) };\\n});\\nipcMain.handle('autocfg-save', (_, c, conta, todas) => saveAutoCfg(c, Number.isInteger(conta) ? conta : null, !!todas));\\nipcMain.on('close-self', (e) => {\\n  const w = BrowserWindow.fromWebContents(e.sender);\\n  if (w && !w.isDestroyed()) w.close();\\n});\\n\\n// ---------- Diagnóstico (mapa da tela, para eu poder criar leitura/compra) ----------\\nconst OUTLINE_JS = `(() => {\\n  const SKIP = new Set(['SCRIPT', 'STYLE', 'SVG', 'PATH', 'NOSCRIPT', 'LINK', 'META']);\\n  const ATTRS = ['id', 'role', 'data-id', 'data-action', 'data-item', 'data-type', 'title', 'aria-label', 'alt', 'type'];\\n  const out = [];\\n  const walk = (el, d) => {\\n    if (d > 16 || out.length > 8000 || SKIP.has(el.tagName.toUpperCase())) return;\\n    const cs = getComputedStyle(el);\\n    if (cs.display === 'none' || cs.visibility === 'hidden') return;\\n    const own = [...el.childNodes].filter((n) => n.nodeType === 3).map((n) => n.textContent.trim()).filter(Boolean).join(' ').slice(0, 90);\\n    const cls = (typeof el.className === 'string' ? el.className : '').trim().replace(/\\\\\\\\s+/g, '.').slice(0, 70);\\n    const at = ATTRS.map((a) => (el.getAttribute(a) ? a + '=\\\"' + el.getAttribute(a).slice(0, 40) + '\\\"' : '')).filter(Boolean).join(' ');\\n    out.push('  '.repeat(d) + el.tagName.toLowerCase() + (cls ? '.' + cls : '') + (at ? ' ' + at : '') + (own ? ' \\\"' + own + '\\\"' : ''));\\n    for (const c of el.children) walk(c, d + 1);\\n  };\\n  walk(document.body, 0);\\n  return out.join('\\\\\\\\n');\\n})()`;\\n\\nasync function saveOutline(i) {\\n  try {\\n    const txt = await withTimeout(views[i].webContents.executeJavaScript(OUTLINE_JS), 15000);\\n    const file = path.join(app.getPath('desktop'), `diagnostico-conta${i + 1}.txt`);\\n    fs.writeFileSync(file, txt, 'utf8');\\n    uiDialog({\\n      type: 'info',\\n      message: 'Diagnóstico salvo na área de trabalho.',\\n      detail: `${path.basename(file)}\\\\n\\\\nO arquivo tem só a estrutura e os textos visíveis da tela (sem senhas nem valores digitados). Pode abrir e conferir antes de me enviar.`,\\n    });\\n  } catch (e) {\\n    showError('Diagnóstico', e.message);\\n  }\\n}\\n\\n// ---------- Nick das contas (lido do próprio jogo: #tr-nick) ----------\\nconst nicks = ACCOUNTS.map(() => null);\\nconst nickMiss = ACCOUNTS.map(() => 0);\\nconst nickFile = () => path.join(app.getPath('userData'), 'nicks.json');\\nconst nameOf = (i) => nicks[i] || ACCOUNTS[i];\\nconst displayNames = () => ACCOUNTS.map((_, i) => nameOf(i));\\n\\nfunction loadNicks() { // mostra o último nick conhecido já na abertura\\n  try {\\n    const j = JSON.parse(fs.readFileSync(nickFile(), 'utf8'));\\n    if (Array.isArray(j)) ACCOUNTS.forEach((_, i) => { if (typeof j[i] === 'string' && j[i]) nicks[i] = j[i].slice(0, 24); });\\n  } catch {}\\n}\\nfunction saveNicks() {\\n  try { fs.writeFileSync(nickFile(), JSON.stringify(nicks)); } catch {}\\n}\\nasync function readNick(i) {\\n  if (sono.ausente) return;\\n  const wc = views[i] && views[i].webContents;\\n  if (!wc || wc.isDestroyed() || wc.isLoading()) return;\\n  try {\\n    const t = await withTimeout(wc.executeJavaScript(\\\"(() => { const e = document.getElementById('tr-nick'); return e ? e.textContent.trim() : ''; })()\\\"), 3000);\\n    const nick = String(t || '').slice(0, 24);\\n    let changed = false;\\n    if (nick) {\\n      nickMiss[i] = 0;\\n      if (nicks[i] !== nick) { nicks[i] = nick; changed = true; }\\n    } else if (++nickMiss[i] >= 3 && nicks[i]) { // tela de login por um tempo: volta para \\\"Conta N\\\"\\n      nicks[i] = null; changed = true;\\n    }\\n    if (changed) { saveNicks(); buildMenu(); sendState(); }\\n  } catch {}\\n}\\nfunction startNickTimer() {\\n  setInterval(() => ACCOUNTS.forEach((_, i) => readNick(i)), 8000);\\n  setTimeout(() => ACCOUNTS.forEach((_, i) => readNick(i)), 4000);\\n}\\n\\nfunction buildMenu() {\\n  const each = (fn) => ACCOUNTS.map((_, i) => fn(i));\\n\\n  // Menus organizados: o que se usa sempre fica no 1º nível; ajustes e logins ficam agrupados.\\n  // (ligar/desligar Twitch, Kick, Auto Compra e Troca de hunt ficam nos botões da barra de cada conta)\\n  const template = [\\n    {\\n      label: 'Contas',\\n      submenu: [\\n        // atalhos escondidos: Ctrl+0 (as 4 contas) e Ctrl+1..4 (ampliar uma conta)\\n        { label: 'Ver as 4 contas', accelerator: 'CmdOrCtrl+0', visible: false, click: () => setFocus(-1) },\\n        ...each((i) => ({ label: `Ampliar ${nameOf(i)}`, accelerator: `CmdOrCtrl+${i + 1}`, visible: false, click: () => setFocus(i) })),\\n        { label: 'Recarregar todas', click: () => views.forEach((_, i) => reloadAccount(i)) },\\n        { label: 'Silenciar todas', click: () => each((i) => setMuted(i, true)) },\\n        { label: 'Ligar o som de todas', click: () => each((i) => setMuted(i, false)) },\\n        { type: 'separator' },\\n        { label: `Ver no celular...${monitor.ligado ? '  ✓ ligado' : ''}`, click: showMonitor },\\n        { label: 'Troca de hunt automática...', click: showAutoHunt },\\n        { label: 'Notificações do Windows: shiny visto e capturado', type: 'checkbox', checked: bandeja.notif, click: (item) => setNotif(item.checked) },\\n        { type: 'separator' },\\n        // \\\"Tamanho do jogo\\\" saiu do menu: a barra de baixo tem os botões de zoom. Os atalhos continuam.\\n        { label: 'Aumentar o jogo', accelerator: 'CmdOrCtrl+=', visible: false, click: () => changeRef(-100) },\\n        { label: 'Diminuir o jogo', accelerator: 'CmdOrCtrl+-', visible: false, click: () => changeRef(100) },\\n        { label: 'Tela cheia', accelerator: 'F11', click: () => win.setFullScreen(!win.isFullScreen()) },\\n        { type: 'separator' },\\n        { label: 'Copiar login para o celular (PokeLink Lite)', submenu: each((i) => ({ label: nameOf(i), click: () => copyLoginForPhone(i) })) },\\n      ],\\n    },\\n    {\\n      label: 'Lives',\\n      submenu: [\\n        { label: 'Ver lives abertas', click: showLives },\\n        { label: 'Verificar agora', click: () => { checkLives(); } },\\n        { type: 'separator' },\\n        // Pontos: cada plataforma tem o seu painel, e é lá que ficam avisos, resgate e escolha de canais.\\n        { label: 'Pontos e resgate da Kick...', click: () => openKickWin() },\\n        { label: 'Pontos e resgate da Twitch...', click: () => openTwitchWin() },\\n        { type: 'separator' },\\n        {\\n          label: 'Ajustes da Kick',\\n          submenu: [\\n            { label: 'Avisar ao juntar 300 / 500 / 1.000 pontos', type: 'checkbox', checked: kickAvisos, click: (item) => setKickAvisos(item.checked) },\\n            { type: 'separator' },\\n            { label: 'Kick leve (sem imagens, vídeo mínimo)', type: 'checkbox', checked: kickLeve, click: (item) => setKickLeve(item.checked) },\\n            { label: 'Esconder as mensagens do chat (economiza CPU; teste antes)', type: 'checkbox', checked: kickChatOculto, click: (item) => setKickChatOculto(item.checked) },\\n            { label: 'Máximo de lives abertas por conta', submenu: [2, 3, 4, 6].map((n) => ({ label: n === 6 ? '6 (padrão)' : String(n), type: 'radio', checked: LIVE_MAX.kick === n, click: () => setKickMax(n) })) },\\n            { type: 'separator' },\\n            { label: 'Player pequeno (recomendado)', type: 'radio', checked: kickPlayer === 'auto', click: () => setKickPlayer('auto') },\\n            { label: 'Página inteira (mais pesado)', type: 'radio', checked: kickPlayer === 'completa', click: () => setKickPlayer('completa') },\\n          ],\\n        },\\n        {\\n          label: 'Logins da Twitch e da Kick',\\n          submenu: each((i) => ({\\n            label: nameOf(i),\\n            submenu: [\\n              { label: 'Entrar na Twitch...', click: () => openLiveLogin(i, 'twitch') },\\n              { label: 'Entrar na Kick...', click: () => openLiveLogin(i, 'kick') },\\n              { label: 'Importar login da Kick do navegador...', click: () => importKickLogin(i) },\\n            ],\\n          })),\\n        },\\n      ],\\n    },\\n    {\\n      label: 'Desempenho',\\n      // Normal / Eco / Mega Eco saíram daqui: são as pílulas da barra de baixo e do painel da direita,\\n      // que já valem para as 4 contas. Ficou só o que não tem botão na tela.\\n      submenu: [\\n        { label: 'Pausar o farm para o PC dormir', type: 'checkbox', checked: sono.ligado, click: (item) => setSono(item.checked) },\\n        { label: 'Ao fechar, continuar rodando na bandeja', type: 'checkbox', checked: bandeja.ligado, click: (item) => setBandeja(item.checked) },\\n        { label: 'Interface em um só processo (economiza memória; reinicia)', type: 'checkbox', checked: processoUnico, click: (item) => setProcessoUnico(item.checked) },\\n        { label: 'Uso de CPU e memória', click: showUsage },\\n      ],\\n    },\\n    {\\n      label: 'PvP',\\n      submenu: [\\n        ...each((i) => ({ label: `Análise de PvP — ${nameOf(i)}`, click: () => openPvp(i) })),\\n        { type: 'separator' },\\n        { label: 'Gerar relatório do tracker', submenu: each((i) => ({ label: nameOf(i), click: () => captureTracker(i) })) },\\n      ],\\n    },\\n    {\\n      label: 'Atualizações',\\n      submenu: [\\n        { label: 'Procurar atualização', click: () => checkOnlineUpdate(true) },\\n        { label: 'Ver novidades', click: showNovidades },\\n        { type: 'separator' },\\n        { label: 'Instalar atualização de arquivo...', click: applyUpdate },\\n        // o atalho funciona mesmo se a barra de cima quebrar depois de uma atualização ruim\\n        { label: 'Desfazer última atualização', accelerator: 'CmdOrCtrl+Shift+Z', click: undoUpdate },\\n        { type: 'separator' },\\n        { label: `Versão instalada: ${APP_CHANNEL ? APP_CHANNEL + ' ' : ''}${APP_LABEL}`, enabled: false },\\n      ],\\n    },\\n    {\\n      label: 'Ajuda',\\n      submenu: [\\n        { label: 'Extensões (/hunt, Rotom Sniper)', click: showExtensions },\\n        { label: 'Gerar relatório de erro', submenu: each((i) => ({ label: nameOf(i), click: () => saveOutline(i) })) },\\n        { label: 'Reiniciar o PokeLink', accelerator: 'CmdOrCtrl+Shift+R', click: restartApp },\\n        { label: 'Sair do PokeLink (fecha de vez)', click: sairDeVez },\\n        { type: 'separator' },\\n        { label: 'Sobre o PokeLink', click: showAbout },\\n        { label: 'Termos de Uso', click: showTerms },\\n      ],\\n    },\\n  ];\\n  if (DEV) {\\n    // só aparece rodando pelo código, nunca no .exe\\n    template.push({\\n      label: 'Desenvolvedor',\\n      submenu: [\\n        { label: 'Abrir pasta do app', click: () => shell.openPath(__dirname) },\\n        { label: 'Ferramentas de desenvolvedor: F12 na tela desejada', enabled: false },\\n      ],\\n    });\\n  }\\n\\n  appMenu = Menu.buildFromTemplate(template);\\n  atualizarTray();\\n  // o menu continua registrado: atalhos (Ctrl+1, F11, Ctrl+0...) seguem funcionando\\n  Menu.setApplicationMenu(appMenu);\\n  sendTitleState();\\n}\\n\\nasync function showAbout() {\\n  const r = await uiDialog({\\n    about: true, // cabeçalho com o ícone, o nome e a versão\\n    title: 'Sobre o PokeLink',\\n    message: 'Plataforma PokeLink, criada por Nations.',\\n    detail:\\n      'O PokeLink foi desenvolvido para melhorar a qualidade de vida de quem joga com 4 contas no mesmo computador, ' +\\n      'reunindo todas em uma única janela.\\\\n\\\\n' +\\n      'O PokeLink é uma plataforma independente. Nations é o desenvolvedor do PokeLink, não do PokeIdle, ' +\\n      'e não tem vínculo com a equipe do jogo. Se preferir jogar sem a plataforma, use o site oficial: www.pokeidle.io',\\n    note: 'O uso de mais de 4 contas está sujeito a banimento no jogo. O PokeLink foi feito para no máximo 4 contas.',\\n    foot: 'Versão beta: se algo der errado, use Ajuda > Gerar relatório de erro.',\\n    buttons: ['Fechar', 'Direitos e marcas', 'Abrir www.pokeidle.io'],\\n    defaultId: 0,\\n    cancelId: 0,\\n  });\\n  if (r.response === 1) showRights();\\n  if (r.response === 2) shell.openExternal('https://www.pokeidle.io');\\n}\\n\\nasync function showRights() {\\n  const contato = SUPPORT_CONTACT\\n    ? '\\\\n\\\\nPedido de remoção: se você é titular de direitos sobre algo presente no PokeLink e quer que seja removido, ' +\\n      `escreva para ${SUPPORT_CONTACT}. Pedidos legítimos são atendidos sem necessidade de ordem judicial.`\\n    : '';\\n  const r = await uiDialog({\\n    type: 'info',\\n    title: 'Direitos e marcas',\\n    message: 'Projeto de fã, independente e não oficial.',\\n    detail:\\n      'Pokémon e todos os elementos da franquia são marcas e obras de Nintendo, Game Freak, Creatures e ' +\\n      'The Pokémon Company. O PokeIdle e seu conteúdo pertencem à equipe do PokeIdle.\\\\n\\\\n' +\\n      'O PokeLink não tem vínculo com nenhum deles. O jogo exibido nas janelas é carregado diretamente de ' +\\n      'www.pokeidle.io: o PokeLink não copia, hospeda nem distribui esse conteúdo.\\\\n\\\\n' +\\n      'O código e a interface do PokeLink são de autoria de Nations.' + contato,\\n    note: 'Funções automáticas, como a Auto Compra, podem não ser permitidas pelas regras do PokeIdle. ' +\\n      'Confira os termos do jogo antes de usar. O uso é por sua conta e risco.',\\n    buttons: ['Voltar', 'Fechar'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (r.response === 0) showAbout();\\n}\\nipcMain.on('show-about', showAbout);\\n\\n// ---------- Pop-ups no tema do app ----------\\n// Mesmo formato do dialog.showMessageBox do Electron: uiDialog({ type, title, message, detail, buttons, defaultId, cancelId })\\n// devolve uma Promise com { response } = índice do botão clicado.\\nconst dlgWait = new Map();\\nlet dlgSeq = 0;\\nlet dialogOpen = false;\\nfunction uiDialog(o) {\\n  o = o || {};\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && !titleBar.webContents.isLoading()\\n    && win && !win.isDestroyed() && !win.isFullScreen() && !win.isMinimized();\\n  if (!canDraw) return dialog.showMessageBox(o); // tela cheia/minimizado: usa o do Windows\\n  const id = ++dlgSeq;\\n  const pr = new Promise((resolve) => {\\n    dlgWait.set(id, resolve);\\n    dialogOpen = true;\\n    layout();\\n    titleBar.webContents.focus();\\n    titleBar.webContents.send('title-dialog', {\\n      id,\\n      type: o.type || 'info',\\n      title: o.title || APP_NAME,\\n      message: o.message || '',\\n      detail: o.detail || '',\\n      note: o.note || '',  // aviso destacado (só nos pop-ups do app)\\n      foot: o.foot || '',  // texto pequeno no fim\\n      table: o.table || null, // { head: [...], rows: [[...], ...] }\\n      form: o.form || null,\\n      cards: o.cards || null, // [{ title, chips, big, bigSub, stats: [[rótulo, valor]] }]\\n      lives: o.lives || null, // painel das lives (showLives)   // [{ section } | { id, label, hint, type: 'check'|'number'|'select', options, value }]\\n      buttons: o.buttons && o.buttons.length ? o.buttons : ['OK'],\\n      defaultId: Number.isInteger(o.defaultId) ? o.defaultId : 0,\\n      cancelId: Number.isInteger(o.cancelId) ? o.cancelId : null,\\n      about: o.about ? { name: APP_NAME, version: APP_LABEL, channel: APP_CHANNEL, icon: customIconUrl() } : null,\\n    });\\n  });\\n  pr.id = id; // permite fechar este pop-up pelo código (uiDialogClose)\\n  return pr;\\n}\\n// fecha um pop-up aberto pelo código (ex.: o aviso de \\\"gerando...\\\" quando o trabalho termina)\\nfunction uiDialogClose(p) {\\n  if (p && p.id && titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('title-dialog-close', p.id);\\n}\\nconst showError = (title, text) => uiDialog({ type: 'error', title, message: title, detail: text });\\n\\n// menuzinho de escolha no tema do app (ex.: Desempenho). Devolve o \\\"value\\\" escolhido ou null.\\nlet popSeq = 0;\\nconst popWait = new Map();\\nfunction uiPopup(o) {\\n  return new Promise((resolve) => {\\n    const id = ++popSeq;\\n    popWait.set(id, resolve);\\n    dialogOpen = true; // a barra de título cresce para cobrir a janela\\n    layout();\\n    titleBar.webContents.focus();\\n    titleBar.webContents.send('title-popup', Object.assign({ id }, o));\\n  });\\n}\\nipcMain.on('title-popup-reply', (_, id, value) => {\\n  const done = popWait.get(id);\\n  if (!done) return;\\n  popWait.delete(id);\\n  dialogOpen = dlgWait.size > 0 || popWait.size > 0 || cfgPanels.size > 0;\\n  layout();\\n  done(value == null ? null : value);\\n});\\nipcMain.on('title-dialog-reply', (_, id, response, values) => {\\n  const done = dlgWait.get(id);\\n  if (!done) return;\\n  dlgWait.delete(id);\\n  dialogOpen = dlgWait.size > 0 || popWait.size > 0 || cfgPanels.size > 0;\\n  layout();\\n  done({ response: Number(response) || 0, values: values && typeof values === 'object' ? values : null });\\n});\\n\\n// F12 ou Ctrl+Shift+I abre as ferramentas de desenvolvedor da tela em que você clicou por último\\n// Ctrl+0 (as 4 contas) e Ctrl+1..4 (ampliar conta) funcionam em qualquer parte da janela\\nfunction viewKeys(wc) {\\n  wc.on('before-input-event', (e, input) => {\\n    if (input.type !== 'keyDown' || !(input.control || input.meta) || input.shift || input.alt) return;\\n    const k = String(input.key);\\n    if (k === '0') { e.preventDefault(); setFocus(-1); }\\n    else if (/^[1-4]$/.test(k) && Number(k) <= ACCOUNTS.length) { e.preventDefault(); setFocus(Number(k) - 1); }\\n  });\\n}\\nfunction devKeys(wc) {\\n  viewKeys(wc);\\n  if (!DEV) return; // no .exe não existe atalho para as ferramentas de desenvolvedor\\n  wc.on('before-input-event', (e, input) => {\\n    if (input.type !== 'keyDown') return;\\n    const k = String(input.key).toLowerCase();\\n    if (k === 'f12' || (input.control && input.shift && k === 'i')) {\\n      e.preventDefault();\\n      wc.toggleDevTools();\\n    }\\n  });\\n}\\n\\n// ---------- Barra de título customizada ----------\\nfunction sendTitleState() {\\n  if (!titleBar || titleBar.webContents.isDestroyed() || !appMenu) return;\\n  titleBar.webContents.send('title-state', {\\n    title: APP_NAME,\\n    icon: customIconUrl(),\\n    version: APP_LABEL,\\n    channel: APP_CHANNEL,\\n    menus: serializeMenu(appMenu),\\n  });\\n}\\n\\n// transforma o Menu do Electron em dados simples para a barra desenhar os menus em HTML\\nconst prettyAccel = (a) => (a ? String(a).replace(/CmdOrCtrl|CommandOrControl/g, 'Ctrl') : '');\\nfunction serializeMenu(menu) {\\n  return menu.items.map((it) => ({\\n    label: it.label,\\n    type: it.type,\\n    checked: !!it.checked,\\n    enabled: it.enabled !== false,\\n    visible: it.visible !== false,\\n    accel: prettyAccel(it.accelerator),\\n    submenu: it.submenu ? serializeMenu(it.submenu) : null,\\n  }));\\n}\\n\\n// engrenagem da barra de baixo: abre os mesmos menus (Contas, Lives, Desempenho, PvP, Atualizações, Ajuda) para cima,\\n// desenhados pela barra de título (que cobre a janela enquanto o menu está aberto). Sem ela (tela cheia), usa o menu nativo.\\nfunction abrirEngrenagem(rect) {\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (!canDraw || !rect || !bottomBar || bottomBar.webContents.isDestroyed()) {\\n    try { if (appMenu) appMenu.popup({ window: win }); } catch {}\\n    return;\\n  }\\n  const b = bottomBar.getBounds();\\n  sendTitleState(); // menus com os ✓ de agora\\n  menuOpen = true;\\n  layout();\\n  titleBar.webContents.focus();\\n  titleBar.webContents.send('title-state', { gear: { x: b.x + Math.round(Number(rect.right) || 0), up: b.y + Math.round(Number(rect.top) || 0) } });\\n}\\nipcMain.on('gear-open', (_, rect) => abrirEngrenagem(rect));\\nipcMain.on('title-ready', () => { sendTitleState(); sendTitleFoco(); });\\nipcMain.on('title-open', (_, open) => {\\n  menuOpen = !!open;\\n  layout();\\n});\\n// clique num item: chega o \\\"caminho\\\" de índices até ele (ex.: [1, 4, 2] = Contas > Som por conta > 3º item)\\nipcMain.on('title-click', (_, pathIdx) => {\\n  if (!appMenu || !Array.isArray(pathIdx)) return;\\n  let items = appMenu.items;\\n  let item = null;\\n  for (const n of pathIdx) {\\n    item = items && items[n];\\n    if (!item) return;\\n    items = item.submenu && item.submenu.items;\\n  }\\n  if (!item || item.submenu || item.enabled === false || item.type === 'separator') return;\\n  item.click({}); // checkbox: o próprio Electron inverte o \\\"checked\\\" antes de chamar o click\\n  sendTitleState(); // atualiza os ✓ na barra\\n});\\n\\n// ---------- Lives: bônus da Twitch e pontos da Kick ----------\\n// Cada conta do jogo usa o próprio login da Twitch/Kick (mesma sessão da conta: persist:contaN).\\n// Twitch e Kick ligam separadas, cada uma com o seu botão na barra da conta.\\n// Quando um canal oficial entra ao vivo, a live abre escondida com a GUIA mutada (o player segue\\n// tocando, como uma janela visível) e sem economia de segundo plano; quando a live acaba, ela fecha.\\nconst LIVE_CHANNELS = {\\n  twitch: ['tftoddy', 'clovaobengala', 'patopapao', 'rodil', 'matta', 'cogu', 'biscoitao', 'xdaren_', 'luccatv', 'faasii', 'axtlol', 'surskity11', 'guaxilol1'],\\n  // lista oficial completa da Kick (painel \\\"Bônus na Kick\\\" do jogo)\\n  kick: ['rodil', 'clovaobengalalol', 'axt', 'xdaren', 'yetz', 'patopapao2', 'biscoitao', 'matta', 'cogu', 'tftoddy', 'luccatv', 'surskity'],\\n};\\n// Máximo de lives abertas POR CONTA em cada plataforma (cada live gasta ~200-300 MB).\\n// Kick: abre todas as lives oficiais ao vivo (até 6 por conta). A janela de Resgate marca\\n// \\\"sem render\\\" quando uma live aberta há 20+ min não ganhou nenhum ponto (ex.: limite da Kick).\\n// Twitch: 2. A própria Twitch só conta como espectador em até 2 lives ao mesmo tempo; abrindo\\n// uma terceira, NENHUMA conta ponto. Antes era 99 porque o modo antigo abria só páginas de chat (leves).\\nconst LIVE_MAX = { twitch: 2, kick: 6 };\\nconst LIVE_PLATS = () => Object.keys(LIVE_CHANNELS).filter((p) => LIVE_MAX[p] > 0 && lives[p].some(Boolean));\\nconst LIVE_CHECK_MIN = 3; // de quantos em quantos minutos verificar quem está ao vivo\\nconst PLAT = {\\n  // Twitch em 3 modos (Lives > Modo da Twitch): página completa, só o player (vídeo) ou só o chat\\n  twitch: {\\n    name: 'Twitch', login: 'https://www.twitch.tv/login',\\n    url: (c, m = twitchModo) => (m === 'chat' || m === 'auto' || m === 'irc' ? `https://www.twitch.tv/popout/${c}/chat?popout=`\\n      : m === 'player' ? `https://player.twitch.tv/?channel=${c}&parent=twitch.tv&muted=true&quality=160p30`\\n        : `https://www.twitch.tv/${c}`),\\n  },\\n  kick: { name: 'Kick', url: (c) => `https://kick.com/${c}`, login: 'https://kick.com/' },\\n};\\n// Identificação de navegador igual à de um Chrome normal, com a MESMA versão do Chromium que roda por dentro.\\n// Antes era um \\\"Chrome 124\\\" fixo enquanto o motor era outra versão: essa diferença faz sites com proteção\\n// anti-robô (como a Kick) recusarem o login com \\\"Muitas tentativas\\\".\\nconst LIVE_UA = CLEAN_UA;\\n\\n// ----- canais novos: aprendidos quando o painel de bônus do jogo está aberto -----\\nconst learnedFile = () => path.join(app.getPath('userData'), 'lives-canais.json');\\nfunction loadLearnedChannels() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(learnedFile(), 'utf8'));\\n    for (const p of Object.keys(LIVE_CHANNELS)) {\\n      (j[p] || []).forEach((c) => { if (!LIVE_CHANNELS[p].includes(c)) LIVE_CHANNELS[p].push(c); });\\n    }\\n  } catch {}\\n}\\n// lê a lista \\\"CANAIS OFICIAIS\\\" (Twitch) e \\\"CANAIS OFICIAIS NA KICK\\\" do painel aberto no jogo\\nconst LIVE_DISCOVER = `(() => {\\n  // atalho leve: se o painel de canais não está na tela, não varre a página toda (era pesado com o jogo aberto há horas)\\n  if (!document.body || !/canais oficiais/i.test(document.body.textContent || '')) return { twitch: [], kick: [] };\\n  const read = (headRe) => {\\n    const head = [...document.querySelectorAll('div,span,p,h1,h2,h3,h4,b,strong')]\\n      .find((e) => headRe.test((e.textContent || '').trim()) && e.getClientRects().length);\\n    if (!head) return { rows: [], completo: false };\\n    let box = head.parentElement;\\n    for (let k = 0; k < 4 && box && !/AO VIVO|OFFLINE/i.test(box.innerText || ''); k++) box = box.parentElement;\\n    if (!box) return { rows: [], completo: false };\\n    // sobe mais um pouco para pegar também a parte \\\\\\\"CANAIS OFFLINE (N)\\\\\\\", sem entrar na lista da outra plataforma\\n    const nHead = (el) => ((el.textContent || '').match(/CANAIS OFICIAIS/gi) || []).length;\\n    for (let k = 0; k < 4 && !/CANAIS OFFLINE\\\\\\\\s*\\\\\\\\(\\\\\\\\d+\\\\\\\\)/i.test(box.textContent || ''); k++) {\\n      const up = box.parentElement;\\n      if (!up || nHead(up) > 1) break;\\n      box = up;\\n    }\\n    const skip = /^(OFFLINE|AO VIVO|COPIAR|CANAIS|DISCORD)$/i;\\n    const out = [];\\n    const vistos = new Set();\\n    for (const e of box.querySelectorAll('*')) {\\n      if (e.children.length) continue;\\n      const t = (e.textContent || '').trim();\\n      if (!/^[A-Za-z0-9_]{2,25}$/.test(t) || !/[A-Za-z]/.test(t) || skip.test(t)) continue;\\n      let row = e.parentElement;\\n      for (let k = 0; k < 3 && row && !/AO VIVO|OFFLINE/i.test(row.textContent || ''); k++) row = row.parentElement;\\n      if (!(row && row !== box && /AO VIVO|OFFLINE/i.test(row.textContent || ''))) continue;\\n      if ((row.textContent || '').length > 100 || vistos.has(row)) continue; // uma linha de canal é curta; ignora avisos e faixas\\n      vistos.add(row);\\n      // o nome mostrado pode ser diferente do endereço do canal: usa o link, se a linha tiver um\\n      const a = row.querySelector('a[href*=\\\"kick.com/\\\"], a[href*=\\\"twitch.tv/\\\"]') || row.closest('a[href]');\\n      const m = a ? String(a.href).match(/(?:kick\\\\\\\\.com|twitch\\\\\\\\.tv)\\\\\\\\/([A-Za-z0-9_-]+)/i) : null;\\n      out.push({ name: t, slug: (m ? m[1] : t).toLowerCase(), live: /AO VIVO/i.test(row.textContent || ''), link: !!m });\\n    }\\n    // a lista veio inteira? confere com o contador \\\\\\\"CANAIS OFFLINE (N)\\\\\\\" (se a parte offline estiver fechada, não vem)\\n    const cont = (box.textContent || '').match(/CANAIS OFFLINE\\\\\\\\s*\\\\\\\\((\\\\\\\\d+)\\\\\\\\)/i);\\n    const nOff = out.filter((r) => !r.live).length;\\n    const completo = cont ? nOff === Number(cont[1]) : (out.length >= 3 && nOff > 0);\\n    return { rows: out, completo };\\n  };\\n  const tw = read(/^CANAIS OFICIAIS$/i), kk = read(/^CANAIS OFICIAIS NA KICK$/i);\\n  return { twitch: tw.rows, kick: kk.rows, completo: { twitch: tw.completo, kick: kk.completo } };\\n})()`;\\n// ----- lives lidas DIRETO da conexão do jogo (WebSocket) -----\\n// O servidor do jogo manda para a página os canais oficiais da Kick/Twitch, quem está ao vivo e em quais\\n// lives da Twitch ele já está contando o bônus. Este script roda na página ANTES do jogo e só escuta:\\n// guarda os blocos \\\"kick\\\" e \\\"twitch\\\" que chegam. Não manda nada para o servidor.\\n// Para ficar leve, só abre (JSON.parse) as mensagens que citam kick/twitch.\\nconst LIVE_HOOK_JS = `(() => {\\n  if (window.__plLiveHook) return;\\n  window.__plLiveHook = true;\\n  const Nativo = window.WebSocket;\\n  if (!Nativo) return;\\n  const L = (window.__plLive = window.__plLive || { at: 0, ligado: false });\\n  const guardar = (est) => {\\n    if (!est || typeof est !== 'object') return;\\n    let mudou = false;\\n    if ('kick' in est) { L.kick = est.kick; mudou = true; }\\n    if ('twitch' in est) { L.twitch = est.twitch; mudou = true; }\\n    if (mudou) L.at = Date.now();\\n  };\\n  const ouvir = (ws) => {\\n    ws.addEventListener('open', () => { L.ligado = true; });\\n    ws.addEventListener('close', () => { L.ligado = false; });\\n    ws.addEventListener('message', (ev) => {\\n      const d = ev.data;\\n      if (typeof d !== 'string' || (d.indexOf('\\\"kick\\\"') < 0 && d.indexOf('\\\"twitch\\\"') < 0)) return;\\n      let m; try { m = JSON.parse(d); } catch (e) { return; }\\n      if (m && (m.t === 'welcome' || m.t === 'estado')) guardar(m.estado);\\n    });\\n  };\\n  class WS extends Nativo {\\n    constructor(...a) {\\n      super(...a);\\n      try { if (new URL(String(a[0]), location.href).host === location.host) ouvir(this); } catch (e) {}\\n    }\\n  }\\n  try { Object.defineProperty(WS, 'name', { value: 'WebSocket' }); } catch (e) {}\\n  window.WebSocket = WS;\\n})();`;\\n// resumo pequeno do que a conta recebeu (lido a cada 20 s pelo PokeLink)\\nconst LIVE_STATE_JS = `(() => {\\n  const L = window.__plLive;\\n  if (!L || !L.at) return null;\\n  const arr = (x) => (Array.isArray(x) ? x : []);\\n  const k = L.kick || {}, t = L.twitch || {};\\n  return {\\n    ligado: !!L.ligado,\\n    kick: { tem: !!L.kick, login: k.login || null,\\n      oficiais: arr(k.oficiais).map((c) => ({ slug: String(c.slug || '').toLowerCase(), aoVivo: !!c.aoVivo, esp: Number(c.espectadores) || 0, ativo: c.ativo !== false })).filter((c) => c.slug) },\\n    twitch: { tem: !!L.twitch, login: t.login || null,\\n      oficiais: arr(t.oficiais).map((o) => String(o.login || '').toLowerCase()).filter(Boolean),\\n      lives: arr(t.lives).map((l) => String(l.login || '').toLowerCase()).filter(Boolean),\\n      contando: arr(t.assistindoEm).map((x) => String(x).toLowerCase()) },\\n  };\\n})()`;\\n// liga o script na página da conta antes de o jogo carregar (vale para os recarregamentos também)\\nfunction ligarLeituraLives(wc) {\\n  const ligar = () => {\\n    if (wc.isDestroyed() || wc.debugger.isAttached()) return;\\n    try {\\n      wc.debugger.attach('1.3');\\n      wc.debugger.sendCommand('Page.enable').catch(() => {});\\n      wc.debugger.sendCommand('Page.addScriptToEvaluateOnNewDocument', { source: LIVE_HOOK_JS }).catch(() => {});\\n    } catch {}\\n  };\\n  ligar();\\n  wc.debugger.on('detach', () => setTimeout(ligar, 2000)); // se soltar (ex.: travou e reiniciou), liga de novo\\n}\\nconst jogoInfo = ACCOUNTS.map(() => null); // última leitura de cada conta\\nasync function lerLivesDoJogo() {\\n  if (sono.ausente) return;\\n  await Promise.all(views.map(async (v, i) => {\\n    const wc = v && v.webContents;\\n    if (!wc || wc.isDestroyed() || wc.isLoading()) return;\\n    const r = await withTimeout(wc.executeJavaScript(LIVE_STATE_JS), 3000).catch(() => null);\\n    if (r) jogoInfo[i] = Object.assign(r, { lido: Date.now() });\\n    else if (jogoInfo[i] && Date.now() - jogoInfo[i].lido > 5 * 60 * 1000) jogoInfo[i] = null;\\n  }));\\n}\\n// a leitura do jogo vale se a conexão está ligada e foi lida há pouco\\nconst jogoFresco = (p) => jogoInfo.find((x) => x && x.ligado && x[p] && x[p].tem && x[p].oficiais.length >= 3 && Date.now() - x.lido < 2 * 60 * 1000) || null;\\n// quem está ao vivo segundo o jogo (só canais oficiais com pontos ativos)\\nfunction aoVivoDoJogo(p) {\\n  const j = jogoFresco(p);\\n  if (!j) return null;\\n  if (p === 'kick') return new Set(j.kick.oficiais.filter((c) => c.ativo && c.aoVivo).map((c) => c.slug));\\n  return new Set(j.twitch.lives.filter((c) => j.twitch.oficiais.includes(c)));\\n}\\nlet fonteLives = ''; // de onde veio a última informação (aparece no rodapé do painel Lives)\\n// \\\"ao vivo\\\" segundo o painel do jogo (quando ele estiver aberto): ajuda quando a Kick/Twitch não responde\\nconst gameLive = { twitch: new Map(), kick: new Map() }; // slug -> horário em que o jogo mostrou AO VIVO\\nasync function discoverChannels(lido) {\\n  let found;\\n  if (lido) found = [lido];\\n  else {\\n    await lerLivesDoJogo();\\n    // lista oficial vinda da conexão do jogo (confiável)\\n    const doJogo = { completo: {}, doJogo: true, twitch: [], kick: [] };\\n    for (const p of Object.keys(LIVE_CHANNELS)) {\\n      const j = jogoFresco(p);\\n      if (!j) continue;\\n      doJogo[p] = p === 'kick'\\n        ? j.kick.oficiais.filter((c) => c.ativo).map((c) => ({ slug: c.slug, live: c.aoVivo, link: true }))\\n        : j.twitch.oficiais.map((c) => ({ slug: c, live: j.twitch.lives.includes(c), link: true }));\\n      doJogo.completo[p] = true;\\n    }\\n    const faltam = Object.keys(LIVE_CHANNELS).filter((p) => !doJogo.completo[p]);\\n    // só lê a tela se a conexão não trouxe alguma das plataformas (mais leve)\\n    const daTela = !faltam.length ? [] : await Promise.all(views.map((v) => (v && !v.webContents.isDestroyed()\\n      ? withTimeout(v.webContents.executeJavaScript(LIVE_DISCOVER), 3000).catch(() => ({})) : {})));\\n    found = [doJogo, ...daTela];\\n  }\\n  let j = null;\\n  let mudou = false;\\n  for (const p of Object.keys(LIVE_CHANNELS)) {\\n    const rows = found.flatMap((f) => (f && f[p]) || []).map((r) => (typeof r === 'string' ? { slug: r.toLowerCase(), live: false } : r));\\n    // lista oficial completa lida do painel do jogo: o que não está nela deixou de ser parceiro\\n    // (Twitch: só com o endereço do canal na linha, porque lá o nome mostrado costuma ser diferente do canal)\\n    const inteira = found.find((f) => f && f.completo && f.completo[p] && f[p] && f[p].length >= 3 && (p === 'kick' || f[p].every((r) => r.link)));\\n    if (inteira) mudou = conferirOficiais(p, inteira[p].map((r) => r.slug), !!inteira.doJogo) || mudou;\\n    for (const r of rows) if (r.live && !removidos[p][r.slug]) gameLive[p].set(r.slug, Date.now()); else gameLive[p].delete(r.slug);\\n    const novos = [...new Set(rows.map((r) => r.slug))]\\n      .filter((c) => !LIVE_CHANNELS[p].includes(c) && !removidos[p][c]);\\n    if (!novos.length) continue;\\n    LIVE_CHANNELS[p].push(...novos);\\n    if (!j) { try { j = JSON.parse(fs.readFileSync(learnedFile(), 'utf8')); } catch { j = {}; } }\\n    j[p] = [...new Set([...(j[p] || []), ...novos])];\\n  }\\n  if (j) { try { fs.writeFileSync(learnedFile(), JSON.stringify(j)); } catch {} }\\n  if (!lido && usarAoVivoDoJogo()) syncLives(); // alguém entrou/saiu do ar: abre/fecha já\\n  if (!lido) conferirTwitchDireta();\\n  return !!j || mudou;\\n}\\n// Twitch automática: se a conexão direta está nos canais há 12 min e o jogo não contou nenhum, volta para a página do chat\\nfunction conferirTwitchDireta() {\\n  if (twitchModo !== 'auto') return;\\n  ACCOUNTS.forEach((_, i) => {\\n    if (ircFalhou[i] || modoTw(i) !== 'irc' || !ircDesde[i] || Date.now() - ircDesde[i] < 12 * 60 * 1000) return;\\n    const j = jogoInfo[i];\\n    const abertos = [...liveOpen[i].twitch.keys()];\\n    const contando = (j && j.twitch && j.twitch.contando) || [];\\n    const erroLogin = ircState[i] === 'erro de login' || ircState[i] === 'sem login';\\n    if (erroLogin || (abertos.length && !abertos.some((c) => contando.includes(c)))) {\\n      ircFalhou[i] = true;\\n      logTravamento(`${nameOf(i)}: Twitch pela conexão direta não contou o bônus; voltando para a página do chat`);\\n      saveLives();\\n      syncLives();\\n    }\\n  });\\n}\\n// copia \\\"quem está ao vivo\\\" do jogo para o PokeLink; devolve true se mudou algo\\nfunction usarAoVivoDoJogo() {\\n  let mudou = false;\\n  const partes = [];\\n  for (const p of Object.keys(LIVE_CHANNELS)) {\\n    // A Twitch é perguntada direto, e dá a resposta certa. O painel do jogo era lido em outro ritmo e\\n    // SOBRESCREVIA essa lista com a dele — que para a Twitch vem vazia. Resultado: a verificação achava\\n    // os canais ao vivo e, segundos depois, a leitura do jogo apagava todos. Era por isso que aparecia\\n    // \\\"7/20 ao vivo\\\" na mesma tela em que todos os canais estavam offline.\\n    if (p === 'twitch' && Date.now() - twitchCheckOkAt < 20 * 60 * 1000) continue;\\n    const s = aoVivoDoJogo(p);\\n    if (!s) continue;\\n    const novo = LIVE_CHANNELS[p].filter((c) => s.has(c));\\n    if (novo.length !== liveNow[p].size || novo.some((c) => !liveNow[p].has(c))) { liveNow[p] = new Set(novo); mudou = true; }\\n    partes.push(`${PLAT[p].name} ${novo.length} ao vivo`);\\n  }\\n  if (partes.length) { fonteLives = 'pelo jogo: ' + partes.join(', '); liveLastCheck = Date.now(); }\\n  return mudou;\\n}\\n\\n// junta canais novos (de qualquer fonte) na lista e guarda\\n// ----- canais removidos (deixaram de ser parceiros) -----\\n// 'auto' = sumiu da lista oficial do painel do jogo · 'manual' = você tirou pelo painel\\nconst removidosFile = () => path.join(app.getPath('userData'), 'lives-removidos.json');\\nconst removidos = { twitch: {}, kick: {} };\\nconst fixos = { twitch: new Set(), kick: new Set() }; // você trouxe de volta: a remoção automática não mexe mais\\nfunction loadRemovidos() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(removidosFile(), 'utf8'));\\n    for (const p of Object.keys(removidos)) if (j[p] && typeof j[p] === 'object') Object.assign(removidos[p], j[p]);\\n    for (const p of Object.keys(fixos)) ((j.fixos && j.fixos[p]) || []).forEach((c) => fixos[p].add(String(c)));\\n  } catch {}\\n  aplicarRemovidos();\\n}\\nfunction saveRemovidos() {\\n  try { fs.writeFileSync(removidosFile(), JSON.stringify({ ...removidos, fixos: { twitch: [...fixos.twitch], kick: [...fixos.kick] } })); } catch {}\\n}\\n// tira da lista, da seleção da Kick e fecha as lives abertas desses canais\\nfunction aplicarRemovidos() {\\n  for (const p of Object.keys(LIVE_CHANNELS)) {\\n    for (const c of LIVE_CHANNELS[p].filter((x) => removidos[p][x])) {\\n      LIVE_CHANNELS[p].splice(LIVE_CHANNELS[p].indexOf(c), 1);\\n      liveNow[p].delete(c);\\n      gameLive[p].delete(c);\\n    }\\n    for (const c of Object.keys(removidos[p])) {\\n      if (p === 'kick') kickSel.forEach((sel) => { const k = sel.indexOf(c); if (k >= 0) sel.splice(k, 1); });\\n      liveOpen.forEach((o) => { const slot = o[p].get(c); if (slot) { closeLive(slot); o[p].delete(c); } });\\n    }\\n  }\\n}\\nfunction avisarCanais() {\\n  saveRemovidos();\\n  saveLives();\\n  syncLives(); // também redesenha o painel das Lives\\n  sendState();\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('kick-update');\\n  if (kickWin && !kickWin.isDestroyed()) kickWin.webContents.send('kick-update');\\n}\\nfunction removerCanal(p, slug, como) {\\n  slug = String(slug || '').toLowerCase();\\n  if (!LIVE_CHANNELS[p] || !/^[a-z0-9_]{2,25}$/.test(slug)) return false;\\n  if (removidos[p][slug] === 'manual') return false;\\n  if (como === 'auto' && fixos[p].has(slug)) return false;\\n  if (como !== 'auto') fixos[p].delete(slug);\\n  removidos[p][slug] = como === 'auto' ? 'auto' : 'manual';\\n  aplicarRemovidos();\\n  return true;\\n}\\nfunction voltarCanal(p, slug) {\\n  slug = String(slug || '').toLowerCase();\\n  if (!removidos[p] || !removidos[p][slug]) return false;\\n  delete removidos[p][slug];\\n  if (!LIVE_CHANNELS[p].includes(slug)) LIVE_CHANNELS[p].push(slug);\\n  return true;\\n}\\n// compara com a lista oficial completa lida no jogo: quem saiu é removido sozinho, quem voltou volta\\nfunction conferirOficiais(p, slugs, confiavel) {\\n  const oficial = new Set(slugs.map((c) => String(c).toLowerCase()));\\n  let mudou = false;\\n  for (const [c, como] of Object.entries(removidos[p])) if (como === 'auto' && oficial.has(c)) mudou = voltarCanal(p, c) || mudou;\\n  const sairam = LIVE_CHANNELS[p].filter((c) => !oficial.has(c));\\n  // segurança: se quase todos \\\"saíram\\\", provavelmente a leitura falhou; não remove nada\\n  if (sairam.length && (confiavel || sairam.length <= Math.max(3, Math.floor(LIVE_CHANNELS[p].length / 2)))) {\\n    for (const c of sairam) mudou = removerCanal(p, c, 'auto') || mudou;\\n  }\\n  if (mudou) avisarCanais();\\n  return mudou;\\n}\\nconst listaCanais = () => Object.keys(LIVE_CHANNELS).map((p) => ({\\n  p, name: PLAT[p].name, lista: [...LIVE_CHANNELS[p]],\\n  removidos: Object.entries(removidos[p]).map(([slug, como]) => ({ slug, como })),\\n}));\\n// ----- confere a lista oficial sozinho (igual à Auto Compra com o Market) -----\\n// Ao abrir o PokeLink e a cada 3 horas: abre o painel \\\"Bônus na Kick\\\" (e o da Twitch, se houver) INVISÍVEL\\n// numa conta, lê a lista oficial inteira, fecha e ajusta a lista do PokeLink.\\nconst BONUS_ABRIR = (plat) => `(async () => {\\n  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n  const modal = document.getElementById('modal');\\n  const aberto = () => { const c = modal && modal.querySelector('.modal-caixa'); if (!c) return false; const r = c.getBoundingClientRect(); return r.width > 0 && r.height > 0; };\\n  if (aberto()) return 'janela';\\n  const b = document.querySelector('button.tr-ativo.${plat}') ||\\n    [...document.querySelectorAll('button,[role=button]')].find((e) => e.classList.contains('tr-ativo') && /${plat}/i.test((e.getAttribute('aria-label') || '') + ' ' + (e.textContent || '') + ' ' + e.className));\\n  if (!b) return 'sem botao';\\n  let st = document.getElementById('pokelink-bonus-oculto');\\n  if (!st) { st = document.createElement('style'); st.id = 'pokelink-bonus-oculto'; document.head.appendChild(st); }\\n  st.textContent = '#modal, #modal * { opacity: 0 !important; transition: none !important; animation: none !important; }';\\n  b.click();\\n  const titulo = () => [...document.querySelectorAll('h1,h2,h3,h4,div,span,b,strong')].some((e) => !e.children.length && /^CANAIS OFICIAIS/i.test((e.textContent || '').trim()));\\n  for (let k = 0; k < 30; k++) { if (titulo()) return 'ok'; await sleep(200); }\\n  return 'nao abriu';\\n})()`;\\nconst BONUS_OFFLINE = `(() => {\\n  const t = [...document.querySelectorAll('button,[role=button],div,span')].find((e) => /^CANAIS OFFLINE\\\\\\\\s*\\\\\\\\(\\\\\\\\d+\\\\\\\\)/i.test((e.textContent || '').trim()) && (e.textContent || '').trim().length < 40);\\n  if (!t) return false;\\n  (t.closest('button,[role=button]') || t).click();\\n  return true;\\n})()`;\\nconst BONUS_FECHAR = `(async () => {\\n  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n  const x = document.getElementById('modal-fechar');\\n  if (x) x.click(); else document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));\\n  await sleep(400);\\n  const st = document.getElementById('pokelink-bonus-oculto'); if (st) st.remove();\\n  return true;\\n})()`;\\nlet listaInfo = '';\\nlet listaBusy = false;\\nasync function lerBonus(i, plat) {\\n  const wc = views[i].webContents;\\n  const js = (code, ms) => withTimeout(wc.executeJavaScript(code), ms).catch(() => null);\\n  const abriu = await js(BONUS_ABRIR(plat), 9000);\\n  if (abriu !== 'ok') { if (abriu && abriu !== 'janela' && abriu !== 'sem botao') await js(BONUS_FECHAR, 3000); return { erro: abriu || 'sem resposta' }; }\\n  try {\\n    await new Promise((r) => setTimeout(r, 800)); // deixa a lista terminar de aparecer\\n    let d = await js(LIVE_DISCOVER, 4000);\\n    if (d && d.completo && !d.completo[plat] && (await js(BONUS_OFFLINE, 2000))) { // parte \\\"offline\\\" fechada: abre e lê de novo\\n      await new Promise((r) => setTimeout(r, 700));\\n      d = await js(LIVE_DISCOVER, 4000);\\n    }\\n    return d || { erro: 'não leu' };\\n  } finally { await js(BONUS_FECHAR, 3000); }\\n}\\nasync function conferirListaOficial() {\\n  if (sono.ausente) return listaInfo;\\n  await lerLivesDoJogo();\\n  if (jogoFresco('kick')) { await discoverChannels(); listaInfo = 'lista oficial vem direto do jogo'; return listaInfo; }\\n  if (listaBusy) return listaInfo;\\n  listaBusy = true;\\n  try {\\n    // prefere uma conta que você não está usando agora (o painel invisível segura os cliques por uns segundos)\\n    const ordem = ACCOUNTS.map((_, i) => i).sort((a, b) => (a === focused) - (b === focused));\\n    for (const i of ordem) {\\n      const wc = views[i] && views[i].webContents;\\n      if (!wc || wc.isDestroyed() || wc.isLoading() || level[i] === 3 || autoBusy[i]) continue;\\n      autoBusy[i] = true; // não deixa a Auto Compra abrir o Market ao mesmo tempo\\n      try {\\n        const res = {};\\n        for (const plat of ['kick', 'twitch']) res[plat] = await lerBonus(i, plat);\\n        const k = res.kick;\\n        if (k && !k.erro) {\\n          await discoverChannels(k);\\n          const t = res.twitch;\\n          if (t && !t.erro) await discoverChannels({ twitch: t.twitch, kick: [], completo: { twitch: t.completo && t.completo.twitch, kick: false } });\\n          const hora = new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });\\n          listaInfo = k.completo && k.completo.kick ? `lista oficial conferida às ${hora} (Kick: ${k.kick.length} canais)` : `lista oficial às ${hora}: veio incompleta, não removi ninguém`;\\n          avisarCanais();\\n          return listaInfo;\\n        }\\n        if (k && k.erro === 'janela') continue; // tem uma janela aberta nessa conta: tenta outra\\n      } finally { autoBusy[i] = false; }\\n    }\\n    listaInfo = 'lista oficial: não consegui abrir o painel de bônus agora (tento de novo mais tarde)';\\n    return listaInfo;\\n  } finally { listaBusy = false; }\\n}\\nipcMain.handle('lista-conferir', async () => { await conferirListaOficial(); return livesOverview(); });\\n\\nipcMain.on('canal-remover', (_, p, slug) => { if (removerCanal(p, slug, 'manual')) avisarCanais(); });\\nipcMain.on('canal-voltar', (_, p, slug) => {\\n  const era = removidos[p] && removidos[p][String(slug || '').toLowerCase()];\\n  if (!voltarCanal(p, slug)) return;\\n  if (era === 'auto') fixos[p].add(String(slug).toLowerCase()); // a remoção automática errou: não tira de novo\\n  avisarCanais();\\n  checkLives();\\n});\\n\\nfunction addChannels(novos) {\\n  let mudou = false;\\n  let j = null;\\n  for (const p of Object.keys(LIVE_CHANNELS)) {\\n    const add = [...(novos[p] || [])].map((c) => String(c).toLowerCase()).filter((c) => /^[a-z0-9_]{2,25}$/.test(c) && !LIVE_CHANNELS[p].includes(c) && !removidos[p][c]);\\n    if (!add.length) continue;\\n    LIVE_CHANNELS[p].push(...add);\\n    if (!j) { try { j = JSON.parse(fs.readFileSync(learnedFile(), 'utf8')); } catch { j = {}; } }\\n    j[p] = [...new Set([...(j[p] || []), ...add])];\\n    mudou = true;\\n  }\\n  if (j) { try { fs.writeFileSync(learnedFile(), JSON.stringify(j)); } catch {} }\\n  return mudou;\\n}\\n\\n// Aprende canais pelas respostas que o próprio jogo recebe do servidor (lista de parceiros),\\n// sem depender do painel \\\"Bônus Twitch/Kick\\\" estar aberto.\\n// Procura, no JSON, listas onde a maioria dos nomes já é de canais conhecidos e pega os outros nomes da mesma lista.\\nfunction learnFromJson(json) {\\n  const out = { twitch: new Set(), kick: new Set() };\\n  const so = (p) => { const outro = p === 'twitch' ? 'kick' : 'twitch'; return LIVE_CHANNELS[p].filter((c) => !LIVE_CHANNELS[outro].includes(c)); };\\n  const exclusivos = { twitch: so('twitch'), kick: so('kick') };\\n  const walk = (o, d) => {\\n    if (!o || typeof o !== 'object' || d > 7) return;\\n    if (Array.isArray(o)) {\\n      const objs = o.filter((x) => x && typeof x === 'object' && !Array.isArray(x));\\n      const strs = o.filter((x) => typeof x === 'string');\\n      const listas = [];\\n      if (strs.length >= 2) listas.push({ vals: strs, objs: null });\\n      if (objs.length >= 2) {\\n        for (const key of Object.keys(objs[0])) {\\n          const vals = objs.map((x) => x[key]);\\n          if (vals.filter((v) => typeof v === 'string' && /^[A-Za-z0-9_]{2,25}$/.test(v)).length >= objs.length * 0.8) listas.push({ vals, objs });\\n        }\\n      }\\n      for (const { vals, objs: os } of listas) {\\n        const low = vals.map((v) => (typeof v === 'string' ? v.toLowerCase() : ''));\\n        const conhecidos = low.filter((v) => LIVE_CHANNELS.twitch.includes(v) || LIVE_CHANNELS.kick.includes(v)).length;\\n        if (conhecidos < 2) continue;\\n        low.forEach((v, k) => {\\n          if (!/^[a-z0-9_]{2,25}$/.test(v)) return;\\n          // plataforma: pelo campo do próprio item (ex.: plataforma: \\\"kick\\\"), senão pelos nomes exclusivos da lista\\n          const item = os ? JSON.stringify(os[k]).toLowerCase() : '';\\n          let p = /\\\"(?:plataforma|platform|tipo|type|provedor|origem)\\\"\\\\s*:\\\\s*\\\"kick\\\"/.test(item) ? 'kick'\\n            : /\\\"(?:plataforma|platform|tipo|type|provedor|origem)\\\"\\\\s*:\\\\s*\\\"twitch\\\"/.test(item) ? 'twitch' : null;\\n          if (!p) {\\n            const tw = low.filter((x) => exclusivos.twitch.includes(x)).length;\\n            const kk = low.filter((x) => exclusivos.kick.includes(x)).length;\\n            p = tw > kk ? 'twitch' : kk > tw ? 'kick' : null;\\n          }\\n          if (p) out[p].add(v);\\n        });\\n      }\\n      o.forEach((x) => walk(x, d + 1));\\n    } else Object.values(o).forEach((v) => walk(v, d + 1));\\n  };\\n  walk(json, 0);\\n  return out;\\n}\\nconst apiUrls = new Set(); // respostas do jogo que podem ter a lista de parceiros\\nfunction watchGameApi(i) {\\n  const ses = session.fromPartition(`persist:conta${i + 1}`);\\n  try {\\n    ses.webRequest.onCompleted({ urls: ['https://pokeidle.io/*', 'https://*.pokeidle.io/*'] }, (d) => {\\n      if (d.method !== 'GET' || d.statusCode !== 200 || !/xhr|fetch/i.test(d.resourceType || '')) return;\\n      if (!/twitch|kick|stream|live|parceir|canais|canal|bonus|b%C3%B4nus/i.test(d.url)) return;\\n      if (apiUrls.size < 30 && !apiUrls.has(d.url)) { apiUrls.add(d.url); setTimeout(learnFromApi, 2000); }\\n    });\\n  } catch {}\\n}\\nlet apiLearning = false;\\nasync function learnFromApi() {\\n  if (apiLearning || !apiUrls.size) return;\\n  apiLearning = true;\\n  try {\\n    const ses = session.fromPartition('persist:conta1');\\n    let achou = false;\\n    for (const u of apiUrls) {\\n      try {\\n        const r = await withTimeout(ses.fetch(u, { headers: { Accept: 'application/json' } }), 10000);\\n        if (!r.ok) continue;\\n        const j = await r.json().catch(() => null);\\n        if (j && addChannels(learnFromJson(j))) achou = true;\\n      } catch {}\\n    }\\n    if (achou) checkLives(); // canal novo: já confere se está ao vivo e abre\\n  } finally { apiLearning = false; }\\n}\\n\\n// ----- quais contas estão com Twitch / Kick ligadas -----\\nconst livesFile = () => path.join(app.getPath('userData'), 'lives.json');\\n// \\\"chat\\\" = só o chat (padrão: testado, conta o bônus e é bem mais leve)\\n// \\\"player\\\" = só o vídeo · \\\"completo\\\" = página do canal (vídeo + chat)\\n// \\\"auto\\\" (padrão) = conexão direta de chat (quase não gasta nada), conferida pelo jogo: se o jogo não contar o\\n// bônus, aquela conta volta sozinha para a página do chat. Sem a confirmação do jogo, usa a página do chat.\\nlet twitchModo = 'auto';\\nconst ircFalhou = ACCOUNTS.map(() => false); // conta em que a conexão direta não contou: usa a página do chat\\nconst ircDesde = ACCOUNTS.map(() => 0);      // desde quando a conexão direta está nos canais\\n// Quais contas tiveram que voltar para a página do canal (o player não rendeu pontos nelas).\\nconst twPlayerFalhou = ACCOUNTS.map(() => false);\\nfunction modoTw(i) {\\n  if (twitchModo !== 'auto') return twitchModo;\\n  // A Twitch mudou: o bônus do PokeIdle vem dos PONTOS DO CANAL, e a Twitch só dá pontos a quem está\\n  // assistindo com o vídeo rodando. Chat sozinho não ganha nada.\\n  // O automático abre SÓ O PLAYER (player.twitch.tv): ele avisa a Twitch que a conta está assistindo,\\n  // igual à página do canal, e gasta bem menos (sem chat, sem lista de canais, sem o resto do site).\\n  // O saldo, o baú e o resgate não dependem mais da tela: vão pela API, de dentro do próprio player.\\n  // Rede de segurança: se numa conta o player não render ponto nenhum, ela volta sozinha para a página\\n  // do canal e fica assim (twPlayerFalhou), sem você precisar escolher nada.\\n  return twPlayerFalhou[i] ? 'completo' : 'player';\\n}\\n// a live está numa página que rende pontos? (a do canal ou o player; o chat não rende)\\nfunction twPaginaBoa(url, slug) {\\n  const u = String(url || '');\\n  return u.includes('twitch.tv/' + slug) || (u.includes('player.twitch.tv') && u.includes('channel=' + slug));\\n}\\n// fecha a Twitch de uma conta para reabrir no modo certo\\nfunction reabrirTwitch(i) {\\n  for (const slot of liveOpen[i].twitch.values()) closeLive(slot);\\n  liveOpen[i].twitch.clear();\\n  closeIrc(i);\\n  ircDesde[i] = 0;\\n}\\nconst modoTwAtual = ACCOUNTS.map(() => '');\\nfunction setTwitchModo(m) {\\n  if (twitchModo === m) return;\\n  twitchModo = m;\\n  ircFalhou.fill(false);\\n  saveLives();\\n  buildMenu();\\n  // fecha tudo da Twitch e reabre no modo novo\\n  ACCOUNTS.forEach((_, i) => {\\n    for (const slot of liveOpen[i].twitch.values()) closeLive(slot);\\n    liveOpen[i].twitch.clear();\\n    closeIrc(i);\\n  });\\n  syncLives();\\n}\\n\\n// ---------- Twitch por conexão direta de chat (modo \\\"irc\\\") ----------\\n// Cada conta mantém UMA conexão de chat da Twitch, com o próprio login, e entra nos chats dos canais oficiais\\n// ao vivo (JOIN). A conexão é feita AQUI, no processo principal: antes ela morava numa página escondida, e uma\\n// página, mesmo vazia, gasta dezenas de MB por conta (medido: ~75 MB). Ideias do PokeIdle Deck (MIT, Copyright (c)\\n// 2026 Artur Bruno): entrar nos canais em lotes (a Twitch aceita 20 entradas a cada 10 s), reconectar sozinho com\\n// espera crescente e tratar como morta a conexão que fica 7 min sem receber nada (o Wi-Fi trocou, o PC dormiu).\\nconst nodeNet = require('net');\\nconst nodeTls = require('tls');\\nconst nodeCrypto = require('crypto');\\nlet ircServidor = { host: 'irc-ws.chat.twitch.tv', port: 443, seguro: true, rejectUnauthorized: true }; // (só os testes trocam)\\nlet IRC_SILENCIO_MS = 7 * 60 * 1000;\\nlet IRC_LOTE = 15;\\nlet IRC_LOTE_MS = 11000;\\nlet IRC_ESPERA_BASE = 5; // segundos; dobra a cada falha, até 120\\n\\n// <<WSMINI (cliente WebSocket mínimo: o Electron 33 não tem WebSocket no processo principal)\\nfunction abrirWS(opt) {\\n  const chave = nodeCrypto.randomBytes(16).toString('base64');\\n  const sock = opt.seguro\\n    ? nodeTls.connect({ host: opt.host, port: opt.port, servername: opt.host, rejectUnauthorized: opt.rejectUnauthorized !== false })\\n    : nodeNet.connect({ host: opt.host, port: opt.port });\\n  let buf = Buffer.alloc(0), aberto = false, fechado = false, frag = null;\\n  const fechar = (erro) => { if (fechado) return; fechado = true; try { sock.destroy(); } catch {} if (opt.onClose) opt.onClose(erro || null); };\\n  const quadro = (op, dados) => { // quadros do cliente sempre vão \\\"mascarados\\\" (exigência do protocolo)\\n    const p = Buffer.isBuffer(dados) ? dados : Buffer.from(String(dados), 'utf8');\\n    const n = p.length;\\n    let cab;\\n    if (n < 126) { cab = Buffer.alloc(2); cab[1] = 0x80 | n; }\\n    else if (n < 65536) { cab = Buffer.alloc(4); cab[1] = 0x80 | 126; cab.writeUInt16BE(n, 2); }\\n    else { cab = Buffer.alloc(10); cab[1] = 0x80 | 127; cab.writeUInt32BE(0, 2); cab.writeUInt32BE(n, 6); }\\n    cab[0] = 0x80 | op;\\n    const mascara = nodeCrypto.randomBytes(4);\\n    const m2 = Buffer.from(p);\\n    for (let k = 0; k < n; k++) m2[k] ^= mascara[k & 3];\\n    sock.write(Buffer.concat([cab, mascara, m2]));\\n  };\\n  sock.setNoDelay(true);\\n  sock.on(opt.seguro ? 'secureConnect' : 'connect', () => {\\n    sock.write(`GET ${opt.caminho || '/'} HTTP/1.1\\\\r\\\\nHost: ${opt.host}\\\\r\\\\nUpgrade: websocket\\\\r\\\\nConnection: Upgrade\\\\r\\\\nSec-WebSocket-Key: ${chave}\\\\r\\\\nSec-WebSocket-Version: 13\\\\r\\\\nUser-Agent: Mozilla/5.0\\\\r\\\\n\\\\r\\\\n`);\\n  });\\n  sock.on('error', (e) => fechar(e));\\n  sock.on('close', () => fechar(null));\\n  sock.on('data', (d) => {\\n    buf = buf.length ? Buffer.concat([buf, d]) : d;\\n    if (!aberto) {\\n      const fim2 = buf.indexOf('\\\\r\\\\n\\\\r\\\\n');\\n      if (fim2 < 0) { if (buf.length > 16384) fechar(new Error('resposta grande demais')); return; }\\n      const cab = buf.slice(0, fim2).toString('latin1');\\n      buf = buf.slice(fim2 + 4);\\n      const esperado = nodeCrypto.createHash('sha1').update(chave + '258EAFA5-E914-47DA-95CA-C5AB0DC85B11').digest('base64');\\n      const aceite = (cab.match(/^sec-websocket-accept:\\\\s*(.+)$/im) || [])[1];\\n      if (!/^HTTP\\\\/1\\\\.1 101/.test(cab) || !aceite || aceite.trim() !== esperado) { fechar(new Error('o servidor recusou a conexão')); return; }\\n      aberto = true;\\n      if (opt.onOpen) opt.onOpen();\\n    }\\n    for (;;) {\\n      if (buf.length < 2) break;\\n      const fin = !!(buf[0] & 0x80), op = buf[0] & 0x0f, mascarado = !!(buf[1] & 0x80);\\n      let len = buf[1] & 0x7f, off = 2;\\n      if (len === 126) { if (buf.length < 4) break; len = buf.readUInt16BE(2); off = 4; }\\n      else if (len === 127) {\\n        if (buf.length < 10) break;\\n        len = buf.readUInt32BE(2) * 4294967296 + buf.readUInt32BE(6); off = 10;\\n        if (len > 16 * 1024 * 1024) { fechar(new Error('quadro grande demais')); return; }\\n      }\\n      let mascara = null;\\n      if (mascarado) { if (buf.length < off + 4) break; mascara = buf.slice(off, off + 4); off += 4; }\\n      if (buf.length < off + len) break;\\n      let carga = buf.slice(off, off + len);\\n      if (mascara) { carga = Buffer.from(carga); for (let k = 0; k < carga.length; k++) carga[k] ^= mascara[k & 3]; }\\n      buf = buf.slice(off + len);\\n      if (op === 8) { try { quadro(8, carga.slice(0, 2)); } catch {} fechar(null); return; }\\n      if (op === 9) { try { quadro(10, carga); } catch {} continue; }\\n      if (op === 10) continue;\\n      if (op === 1 || op === 2 || op === 0) {\\n        if (op !== 0) frag = { op, partes: [] };\\n        if (!frag) continue;\\n        frag.partes.push(carga);\\n        if (fin) { const todo = Buffer.concat(frag.partes); const tipo = frag.op; frag = null; if (tipo === 1 && opt.onMessage) opt.onMessage(todo.toString('utf8')); }\\n      }\\n    }\\n  });\\n  return {\\n    send: (texto) => { if (aberto && !fechado) quadro(1, texto); },\\n    close: () => { try { if (aberto && !fechado) quadro(8, Buffer.alloc(0)); } catch {} fechar(null); },\\n  };\\n}\\n// WSMINI>>\\n\\nconst ircs = ACCOUNTS.map(() => null); // { ws, token, nick, pedidos, enviados, joined, ... } (um por conta)\\nconst ircState = ACCOUNTS.map(() => ''); // '' · conectando · ok · fechado · erro de login · sem login\\nfunction closeIrc(i) {\\n  const c = ircs[i];\\n  ircs[i] = null;\\n  ircState[i] = '';\\n  if (!c) return;\\n  c.parar = true;\\n  clearTimeout(c.reconectar); clearTimeout(c.silencio); clearTimeout(c.lote);\\n  try { if (c.ws) c.ws.close(); } catch {}\\n}\\n// entra nos canais pedidos, em lotes (a Twitch aceita 20 entradas a cada 10 s)\\nfunction ircEntrar(i) {\\n  const c = ircs[i];\\n  if (!c || !c.ws || !c.pronto) return;\\n  clearTimeout(c.lote);\\n  const faltam = [...c.pedidos].filter((ch) => !c.enviados.has(ch));\\n  const lote = faltam.slice(0, IRC_LOTE);\\n  if (lote.length) {\\n    for (const ch of lote) c.enviados.add(ch);\\n    c.ws.send('JOIN ' + lote.map((ch) => '#' + ch).join(','));\\n  }\\n  if (faltam.length > lote.length) c.lote = setTimeout(() => ircEntrar(i), IRC_LOTE_MS);\\n}\\nfunction ircLinha(i, c, l) {\\n  if (!l) return;\\n  if (l.startsWith('PING')) { try { c.ws.send('PONG' + l.slice(4)); } catch {} return; }\\n  if (/ NOTICE \\\\* :(Login authentication failed|Improperly formatted auth)/i.test(l)) {\\n    c.erroLogin = true; ircState[i] = 'erro de login';\\n    try { c.ws.close(); } catch {}\\n    return;\\n  }\\n  if (/ RECONNECT\\\\s*$/.test(l)) { try { c.ws.close(); } catch {} return; } // a Twitch pediu para conectar de novo\\n  const p = l.split(' ');\\n  if (p[1] === '001') { c.pronto = true; c.tentativas = 0; ircState[i] = 'ok'; ircEntrar(i); return; }\\n  if ((p[1] === 'JOIN' || p[1] === 'PART') && p[2] && p[0].toLowerCase().startsWith(':' + c.nick + '!')) {\\n    const ch = p[2].replace(/^#/, '').toLowerCase();\\n    if (p[1] === 'JOIN') c.joined.add(ch); else c.joined.delete(ch);\\n  }\\n}\\nfunction ircConectar(i) {\\n  const c = ircs[i];\\n  if (!c || c.parar || c.ws) return;\\n  ircState[i] = 'conectando';\\n  c.pronto = false; c.joined.clear(); c.enviados.clear();\\n  const silencio = () => {\\n    clearTimeout(c.silencio);\\n    c.silencio = setTimeout(() => { // nada chegou (nem o PING da Twitch): a conexão morreu calada\\n      logTravamento(`${nameOf(i)}: chat da Twitch ficou em silêncio; conectando de novo`);\\n      try { if (c.ws) c.ws.close(); } catch {}\\n    }, IRC_SILENCIO_MS);\\n  };\\n  const ws = abrirWS(Object.assign({}, ircServidor, {\\n    onOpen: () => {\\n      silencio();\\n      ws.send('CAP REQ :twitch.tv/membership');\\n      ws.send('PASS oauth:' + c.token);\\n      ws.send('NICK ' + c.nick);\\n    },\\n    onMessage: (txt) => { silencio(); for (const l of txt.split('\\\\r\\\\n')) ircLinha(i, c, l); },\\n    onClose: () => {\\n      clearTimeout(c.silencio); clearTimeout(c.lote);\\n      if (c.ws === ws) c.ws = null;\\n      c.pronto = false; c.joined.clear(); c.enviados.clear();\\n      if (c.parar || ircs[i] !== c) return;\\n      if (c.erroLogin) { ircState[i] = 'erro de login'; return; } // não insiste com login inválido\\n      ircState[i] = 'fechado';\\n      const espera = Math.min(120, IRC_ESPERA_BASE * 2 ** Math.min(c.tentativas, 5)); c.tentativas++;\\n      c.reconectar = setTimeout(() => { c.reconectar = null; ircConectar(i); }, espera * 1000);\\n    },\\n  }));\\n  c.ws = ws;\\n}\\nlet ircBusy = ACCOUNTS.map(() => false);\\nasync function ensureIrc(i, chans) {\\n  if (ircBusy[i]) return;\\n  ircBusy[i] = true;\\n  try {\\n    if (!chans.length || !lives.twitch[i]) { closeIrc(i); return; }\\n    const ses = accountSession(i);\\n    const tok = ((await ses.cookies.get({ domain: 'twitch.tv', name: 'auth-token' }))[0] || {}).value;\\n    const nick = ((await ses.cookies.get({ domain: 'twitch.tv', name: 'login' }))[0] || {}).value;\\n    if (!tok || !nick) { ircState[i] = 'sem login'; return; }\\n    let c = ircs[i];\\n    if (c && (c.token !== tok || c.nick !== nick.toLowerCase())) { closeIrc(i); c = null; } // entrou com outro login\\n    if (!c) c = ircs[i] = { token: tok, nick: nick.toLowerCase(), pedidos: new Set(), enviados: new Set(), joined: new Set(), ws: null, pronto: false, tentativas: 0, parar: false, erroLogin: false };\\n    // sai dos canais que não estão mais ao vivo e entra nos novos\\n    const novos = new Set(chans);\\n    for (const ch of [...c.pedidos]) {\\n      if (novos.has(ch)) continue;\\n      c.pedidos.delete(ch);\\n      if (c.ws && c.pronto && c.enviados.has(ch)) c.ws.send('PART #' + ch);\\n      c.enviados.delete(ch); c.joined.delete(ch);\\n    }\\n    for (const ch of novos) c.pedidos.add(ch);\\n    if (c.erroLogin) { ircState[i] = 'erro de login'; return; }\\n    if (!c.ws && !c.reconectar) ircConectar(i);\\n    else if (c.pronto) ircEntrar(i);\\n  } finally { ircBusy[i] = false; }\\n}\\nconst lives = { twitch: ACCOUNTS.map(() => false), kick: ACCOUNTS.map(() => false) };\\n// canais da Kick escolhidos para farmar em cada conta (vazio = automático)\\nconst kickSel = ACCOUNTS.map(() => []);\\n// canais da Twitch escolhidos para farmar em cada conta (vazio = automático)\\nconst twitchSel = ACCOUNTS.map(() => []);\\nfunction loadLives() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(livesFile(), 'utf8'));\\n    const tw = Array.isArray(j.twitch) ? j.twitch : Array.isArray(j.on) ? j.on : []; // \\\"on\\\" = versão antiga (só Twitch)\\n    tw.forEach((v, i) => { if (i < ACCOUNTS.length) lives.twitch[i] = !!v; });\\n    (Array.isArray(j.kick) ? j.kick : []).forEach((v, i) => { if (i < ACCOUNTS.length) lives.kick[i] = !!v; });\\n    (Array.isArray(j.kickSel) ? j.kickSel : []).forEach((v, i) => { if (i < ACCOUNTS.length && Array.isArray(v)) kickSel[i] = v.map(String); });\\n    // O modo da Twitch não é mais escolha do usuário: só a página do canal ganha pontos, então não há\\n    // o que escolher. Quem tinha um modo de chat salvo volta para o automático ao abrir.\\n    if (['completo', 'auto'].includes(j.twitchModo)) twitchModo = j.twitchModo;\\n    else twitchModo = 'auto';\\n    // quem estava no antigo padrão (\\\"só o chat\\\") passa para o novo padrão automático (uma vez só)\\n    if (!j.v2 && twitchModo === 'chat') twitchModo = 'auto';\\n    if (['auto', 'completa'].includes(j.kickPlayer)) kickPlayer = j.kickPlayer;\\n    (Array.isArray(j.kickCompleta) ? j.kickCompleta : []).forEach((v, i) => { if (i < ACCOUNTS.length) kickCompleta[i] = !!v; });\\n    (Array.isArray(j.ircFalhou) ? j.ircFalhou : []).forEach((v, i) => { if (i < ACCOUNTS.length) ircFalhou[i] = !!v; });\\n    if (typeof j.kickLeve === 'boolean') kickLeve = j.kickLeve;\\n    if (typeof j.kickAvisos === 'boolean') kickAvisos = j.kickAvisos;\\n    if (typeof j.kickChatOculto === 'boolean') kickChatOculto = j.kickChatOculto;\\n    if ([1, 2, 3, 4, 5, 6].includes(Number(j.kickMax))) LIVE_MAX.kick = Number(j.kickMax);\\n    if (typeof j.kickAutoResgate === 'boolean') kickAutoResgate = j.kickAutoResgate;\\n    if (j.kickResgateTiers && typeof j.kickResgateTiers === 'object') Object.assign(kickResgateTiers, j.kickResgateTiers);\\n    (Array.isArray(j.twitchSel) ? j.twitchSel : []).forEach((v, i) => { if (i < ACCOUNTS.length && Array.isArray(v)) twitchSel[i] = v.map(String); });\\n    if (typeof j.twitchAvisos === 'boolean') twitchAvisos = j.twitchAvisos;\\n    if (typeof j.twitchAutoResgate === 'boolean') twitchAutoResgate = j.twitchAutoResgate;\\n    if (typeof j.twitchPacotes === 'boolean') twitchPacotes = j.twitchPacotes;\\n    if (j.twitchResgateTiers && typeof j.twitchResgateTiers === 'object') Object.assign(twitchResgateTiers, j.twitchResgateTiers);\\n    if ([1, 2, 3, 4].includes(Number(j.twitchMax))) LIVE_MAX.twitch = Number(j.twitchMax);\\n  } catch {}\\n}\\nconst saveLives = () => { try { fs.writeFileSync(livesFile(), JSON.stringify({ v2: true, twitch: lives.twitch, kick: lives.kick, kickSel, twitchModo, kickLeve, kickAvisos, kickPlayer, kickCompleta, ircFalhou, kickAutoResgate, kickResgateTiers, kickChatOculto, kickMax: LIVE_MAX.kick,\\n  twitchSel, twitchAvisos, twitchAutoResgate, twitchPacotes, twitchResgateTiers, twitchMax: LIVE_MAX.twitch })); } catch {} };\\n// ----- opções dos pontos da Twitch (o bônus agora sai dos pontos do canal, igual na Kick) -----\\nlet twitchAvisos = true;        // avisar ao bater 300 / 500 / 1.000 pontos num canal\\nlet twitchAutoResgate = false;  // resgatar sozinho, sem abrir janela\\nlet twitchPacotes = true;       // preferir o maior pacote que der (3h, 5h, 10h) em vez de 1h de cada vez\\nconst twitchResgateTiers = { xp: true, capture: true, lure: true };\\n// avisos ao bater 300/500/1.000 pontos da Kick (liga/desliga no painel de pontos ou no menu Lives)\\nlet kickAvisos = true;\\n// Auto Resgate: resgata os bônus da Kick sozinho, sem abrir janela nenhuma (precisa de \\\"Página inteira\\\").\\n// kickResgateTiers diz quais metas resgatar sozinho; a maior marcada que der também é a que o botão\\n// \\\"Resgatar\\\" manual usa primeiro, só abrindo a janela se não conseguir resgatar sozinho.\\nlet kickAutoResgate = false;\\nconst kickResgateTiers = { 300: true, 500: true, 1000: true };\\nfunction setKickAvisos(on) {\\n  kickAvisos = !!on;\\n  saveLives();\\n  buildMenu();\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('kick-update');\\n  if (kickWin && !kickWin.isDestroyed()) kickWin.webContents.send('kick-update');\\n}\\nipcMain.on('kick-avisos', (_, on) => setKickAvisos(on));\\nfunction setKickAutoResgate(on) {\\n  voltarAResgatar('kick'); // mexeu no botão: tenta de novo (serve depois de vincular a Kick no jogo)\\n  kickAutoResgate = !!on;\\n  saveLives();\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('kick-update');\\n  if (kickWin && !kickWin.isDestroyed()) kickWin.webContents.send('kick-update');\\n}\\nipcMain.on('kick-auto-resgate', (_, on) => setKickAutoResgate(on));\\nipcMain.on('kick-resgate-tier', (_, pts, on) => {\\n  if (!KICK_GOALS.some((g) => g.pts === pts)) return;\\n  kickResgateTiers[pts] = !!on;\\n  saveLives();\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('kick-update');\\n  if (kickWin && !kickWin.isDestroyed()) kickWin.webContents.send('kick-update');\\n});\\n\\nconst liveNow = { twitch: new Set(), kick: new Set() };                        // canais ao vivo agora\\nconst liveOpen = ACCOUNTS.map(() => ({ twitch: new Map(), kick: new Map() })); // canal -> live escondida\\nlet liveChecking = false;\\nlet liveLastCheck = 0;\\nlet liveErrors = 0;\\n\\nconst checkSession = () => session.fromPartition('persist:lives-check');\\nconst accountSession = (i) => session.fromPartition(`persist:conta${i + 1}`);\\n// Twitch: UMA pergunta só para todos os canais de uma vez. Antes o PokeLink baixava a página de cada\\n// canal e procurava \\\"isLiveBroadcast\\\":true no HTML; a Twitch parou de mandar isso, então TODO canal\\n// aparecia offline e nenhuma live abria. Agora pergunta direto, do mesmo jeito que o site pergunta.\\nlet twitchCheckInfo = '';\\nlet twitchCheckOkAt = 0; // quando a Twitch respondeu direto pela última vez\\n// Pergunta pronta (\\\"UseLive\\\"): é exatamente a que o site da Twitch usa para saber se um canal está ao\\n// vivo. A Twitch recusa perguntas escritas à mão (devolve HTTP 400), por isso vai esta, pelo código dela.\\nconst TW_USELIVE_HASH = '639d5f11bfb8bf3053b424d9ef650d04c4ebb7d94711d644afb08fe9a0fad5d9';\\nconst twUseLiveBody = (canais) => JSON.stringify(canais.map((c) => ({\\n  operationName: 'UseLive',\\n  variables: { channelLogin: c },\\n  extensions: { persistedQuery: { version: 1, sha256Hash: TW_USELIVE_HASH } },\\n})));\\n// transforma a resposta da Twitch em { canal: true/false }\\nfunction twLerUseLive(j, canais) {\\n  if (!Array.isArray(j)) return null;\\n  const out = {};\\n  canais.forEach((c, n) => {\\n    const d = j[n] && j[n].data;\\n    if (d === undefined) return;\\n    const u = d && d.user;\\n    out[c] = !!(u && u.stream && u.stream.id); // canal que não existe vem null = offline\\n  });\\n  return Object.keys(out).length ? out : null;\\n}\\n// Pergunta escrita à mão. O que dava HTTP 400 não era escrevê-la à mão: era mandá-la em LOTE (dentro de\\n// uma lista). Sozinha, com as variáveis à parte, a Twitch aceita normalmente. Vale como 2ª tentativa e é\\n// o seguro para o dia em que a Twitch trocar o código da pergunta pronta.\\nconst twQueryBody = (canais) => JSON.stringify({\\n  query: 'query($l:[String!]){users(logins:$l){login stream{id}}}',\\n  variables: { l: canais },\\n});\\nfunction twLerQuery(j, canais) {\\n  const us = j && j.data && Array.isArray(j.data.users) ? j.data.users : null;\\n  if (!us) return null;\\n  const achados = {};\\n  for (const u of us) if (u && u.login) achados[String(u.login).toLowerCase()] = !!(u.stream && u.stream.id);\\n  if (!Object.keys(achados).length) return null;\\n  const out = {};\\n  // canal que não existe não volta na lista: conta como offline, igual à pergunta pronta\\n  canais.forEach((c) => { out[c] = achados[String(c).toLowerCase()] === true; });\\n  return out;\\n}\\n// 3º caminho: perguntar DE DENTRO de uma página da twitch.tv aberta por um instante (mesmo jeito que\\n// já é feito com a Kick). Vale quando a Twitch recusa a pergunta vinda \\\"de fora\\\" do navegador.\\nconst TWITCH_LIVE_JS = (canais) => String.raw`(async () => {\\n  const canais = ${JSON.stringify(canais)};\\n  const corpo = canais.map((c) => ({ operationName: 'UseLive', variables: { channelLogin: c },\\n    extensions: { persistedQuery: { version: 1, sha256Hash: ${JSON.stringify(TW_USELIVE_HASH)} } } }));\\n  try {\\n    const r = await fetch('https://gql.twitch.tv/gql', {\\n      method: 'POST', credentials: 'include',\\n      headers: { 'Client-ID': ${JSON.stringify(TW_CLIENT_ID)}, 'Content-Type': 'text/plain' },\\n      body: JSON.stringify(corpo),\\n    });\\n    if (!r.ok) return { erro: 'http ' + r.status };\\n    return { lista: await r.json() };\\n  } catch (e) { return { erro: String(e && e.message || e) } }\\n})()`;\\nasync function twitchViaPagina(canais) {\\n  const i = ACCOUNTS.findIndex((_, k) => lives.twitch[k]);\\n  if (i < 0) return null;\\n  const v = new WebContentsView({ webPreferences: { partition: `persist:conta${i + 1}`, backgroundThrottling: false } });\\n  const wc = v.webContents;\\n  wc.setAudioMuted(true);\\n  twitchViewIds.add(wc.id);\\n  try {\\n    await withTimeout(wc.loadURL('https://www.twitch.tv/', { userAgent: LIVE_UA }), 30000).catch(() => {});\\n    const r = await withTimeout(wc.executeJavaScript(TWITCH_LIVE_JS(canais)), 25000).catch((e) => ({ erro: e.message }));\\n    if (!r || r.erro) { twitchCheckInfo += ` · pela página: ${(r && r.erro) || 'sem resposta'}`; return null; }\\n    return twLerUseLive(r.lista, canais);\\n  } catch (e) {\\n    twitchCheckInfo += ' · pela página: erro ' + e.message;\\n    return null;\\n  } finally {\\n    twitchViewIds.delete(wc.id);\\n    try { wc.close(); } catch {}\\n  }\\n}\\nasync function twitchAoVivoTodos(canais) {\\n  if (!canais.length) return null;\\n  const pedir = async (corpo) => {\\n    const r = await withTimeout(checkSession().fetch('https://gql.twitch.tv/gql', {\\n      method: 'POST',\\n      headers: { 'Client-ID': TW_CLIENT_ID, 'Content-Type': 'text/plain', 'User-Agent': LIVE_UA },\\n      body: corpo,\\n    }), 20000);\\n    if (!r.ok) throw new Error('HTTP ' + r.status);\\n    return r.json();\\n  };\\n  const contar = (out, como) => {\\n    const vivos = Object.values(out).filter(Boolean).length;\\n    twitchCheckInfo = `${como}: ${vivos}/${canais.length} ao vivo`;\\n    twitchCheckOkAt = Date.now(); // deu certo: o painel do jogo não manda mais na Twitch por um tempo\\n    return out;\\n  };\\n  // 1) pergunta pronta, direto (é a que o site usa)\\n  try {\\n    const out = twLerUseLive(await pedir(twUseLiveBody(canais)), canais);\\n    if (out) return contar(out, 'pela Twitch');\\n    twitchCheckInfo = 'pela Twitch: resposta sem dados';\\n  } catch (e) { twitchCheckInfo = 'pela Twitch: ' + e.message; }\\n  // 2) pergunta escrita à mão\\n  try {\\n    const out = twLerQuery(await pedir(twQueryBody(canais)), canais);\\n    if (out) return contar(out, 'pela Twitch (2)');\\n  } catch (e) { twitchCheckInfo += ' · 2ª tentativa: ' + e.message; }\\n  // 3) de dentro de uma página da twitch.tv\\n  const out = await twitchViaPagina(canais);\\n  if (out) return contar(out, 'pela página da Twitch');\\n  return null; // nada deu: cai no jeito antigo, canal por canal\\n}\\nasync function isLive(plat, c) {\\n  if (plat === 'twitch') {\\n    const r = await withTimeout(checkSession().fetch(`https://www.twitch.tv/${c}`, { headers: { 'User-Agent': LIVE_UA } }), 15000);\\n    if (!r.ok) throw new Error('HTTP ' + r.status);\\n    const html = await r.text();\\n    if (/\\\"isLiveBroadcast\\\"\\\\s*:\\\\s*true/.test(html)) return true;\\n    // Sem a marca NENHUMA na página não dá para dizer que está offline (foi isso que quebrou): avisa que\\n    // não deu para verificar, e aí vale o que o painel do jogo mostrou há pouco.\\n    if (!/isLiveBroadcast/.test(html)) throw new Error('a página da Twitch não diz mais se está ao vivo');\\n    return false;\\n  }\\n  // Kick: tenta pela sessão de uma conta logada (passa pela proteção anti-robô da Kick) e depois pela sessão neutra\\n  const sess = [...ACCOUNTS.map((_, i) => i).filter((i) => lives.kick[i]).map(accountSession), checkSession()];\\n  let lastErr = null;\\n  for (const ses of sess) {\\n    try {\\n      const r = await withTimeout(ses.fetch(`https://kick.com/api/v2/channels/${c}`, {\\n        headers: { 'User-Agent': LIVE_UA, Accept: 'application/json' },\\n      }), 15000);\\n      if (!r.ok) { lastErr = new Error('HTTP ' + r.status); continue; }\\n      const j = await r.json();\\n      return !!(j && j.livestream && j.livestream.is_live !== false);\\n    } catch (e) { lastErr = e; }\\n  }\\n  throw lastErr || new Error('sem resposta');\\n}\\n\\n// Kick: a proteção anti-robô dela às vezes recusa as consultas feitas \\\"de fora\\\" (o PokeLink perguntando direto).\\n// Por isso a verificação principal é feita DE DENTRO de uma página da kick.com aberta por um instante,\\n// com o login de uma conta (igual a um navegador normal). Depois a página é fechada.\\nconst KICK_LIVE_JS = (slugs) => `(async () => {\\n  const out = {};\\n  await Promise.all(${JSON.stringify([])}.concat(SLUGS).map(async (s) => {\\n    try {\\n      const r = await fetch('/api/v2/channels/' + s, { headers: { Accept: 'application/json' }, credentials: 'include' });\\n      if (!r.ok) { out[s] = 'http ' + r.status; return; }\\n      const j = await r.json();\\n      out[s] = !!(j && j.livestream && j.livestream.is_live !== false);\\n    } catch (e) { out[s] = 'erro'; }\\n  }));\\n  return out;\\n})()`.replace('SLUGS', JSON.stringify(slugs));\\nlet kickCheckInfo = ''; // resumo da última verificação da Kick (aparece no painel das Lives)\\nasync function kickLiveViaPage() {\\n  const i = ACCOUNTS.findIndex((_, k) => lives.kick[k]);\\n  if (i < 0) return {};\\n  const v = new WebContentsView({ webPreferences: { partition: `persist:conta${i + 1}`, backgroundThrottling: false } });\\n  const wc = v.webContents;\\n  wc.setAudioMuted(true);\\n  kickViewIds.add(wc.id); // modo leve: não baixa imagens nessa página\\n  try {\\n    await withTimeout(wc.loadURL('https://kick.com/', { userAgent: LIVE_UA }), 30000).catch(() => {});\\n    let r = {};\\n    for (let k = 0; k < 3; k++) { // a proteção da Kick pode levar uns segundos para liberar a página\\n      r = (await withTimeout(wc.executeJavaScript(KICK_LIVE_JS(LIVE_CHANNELS.kick)), 25000).catch(() => null)) || {};\\n      if (Object.values(r).some((x) => typeof x === 'boolean')) break;\\n      await new Promise((ok) => setTimeout(ok, 4000));\\n    }\\n    const ok = Object.values(r).filter((x) => typeof x === 'boolean').length;\\n    const falhas = Object.entries(r).filter(([, x]) => typeof x !== 'boolean');\\n    kickCheckInfo = `pela página: ${ok}/${LIVE_CHANNELS.kick.length} canais` + (falhas.length ? ` (${falhas.slice(0, 3).map(([c, x]) => c + ': ' + x).join(', ')})` : '');\\n    return r;\\n  } catch (e) {\\n    kickCheckInfo = 'pela página: erro ' + e.message;\\n    return {};\\n  } finally {\\n    kickViewIds.delete(wc.id);\\n    try { wc.close(); } catch {}\\n  }\\n}\\n\\nasync function twitchLogged(i) {\\n  try { return (await accountSession(i).cookies.get({ domain: 'twitch.tv', name: 'auth-token' })).length > 0; }\\n  catch { return false; }\\n}\\nasync function kickLogged(i) {\\n  const ses = accountSession(i);\\n  try {\\n    const r = await withTimeout(ses.fetch('https://kick.com/api/v1/user', { headers: { 'User-Agent': LIVE_UA, Accept: 'application/json' } }), 10000);\\n    if (r.ok) { const j = await r.json().catch(() => null); if (j && (j.username || j.id)) return true; }\\n    if (r.status === 401) return false;\\n  } catch {}\\n  // a Kick não respondeu direito: usa o cookie de sessão como referência\\n  try { return (await ses.cookies.get({ domain: 'kick.com' })).some((c) => /session_token/i.test(c.name)); }\\n  catch { return false; }\\n}\\nconst isLogged = (i, plat) => (plat === 'twitch' ? twitchLogged(i) : kickLogged(i));\\n\\nasync function checkLives() {\\n  if (liveChecking) return;\\n  if (sono.ausente) { syncLives(); return; }\\n  if (!LIVE_PLATS().length) { syncLives(); return; }\\n  liveChecking = true;\\n  let errs = 0;\\n  try {\\n    // conta que saiu da Twitch/Kick: desliga só aquela plataforma (sem login não conta)\\n    let changed = false;\\n    for (let i = 0; i < ACCOUNTS.length; i++) {\\n      for (const p of Object.keys(LIVE_CHANNELS)) {\\n        if (lives[p][i] && !(await isLogged(i, p))) { lives[p][i] = false; changed = true; }\\n      }\\n    }\\n    if (changed) { saveLives(); buildMenu(); }\\n    await discoverChannels(); // lista oficial e quem está ao vivo pela conexão do jogo (ou pela tela)\\n    // A Twitch fica FORA do \\\"pelo jogo\\\": o painel do jogo às vezes devolve lista vazia, e o PokeLink\\n    // acreditava nela e nem perguntava para a Twitch (era o \\\"0 ao vivo\\\" com todos os canais offline).\\n    // Agora a Twitch é sempre perguntada direto; o jogo só vale se a pergunta falhar.\\n    const peloJogo = LIVE_PLATS().filter((p) => p !== 'twitch' && aoVivoDoJogo(p));\\n    usarAoVivoDoJogo();\\n    const resto = LIVE_PLATS().filter((p) => !peloJogo.includes(p));\\n    if (!resto.length) fonteLives = fonteLives || 'pelo jogo';\\n    // Kick: só abre a página escondida da kick.com se o jogo não informou (bem mais leve)\\n    const kickPage = resto.includes('kick') ? await kickLiveViaPage() : {};\\n    // Twitch: uma pergunta só para a lista inteira (bem mais rápido e confiável que abrir 17 páginas)\\n    const twPage = resto.includes('twitch') ? await twitchAoVivoTodos(LIVE_CHANNELS.twitch) : null;\\n    await Promise.all(resto.flatMap((plat) => LIVE_CHANNELS[plat].map(async (c) => {\\n      if (plat === 'kick' && typeof kickPage[c] === 'boolean') { kickPage[c] ? liveNow.kick.add(c) : liveNow.kick.delete(c); return; }\\n      if (plat === 'twitch' && twPage && typeof twPage[c] === 'boolean') { twPage[c] ? liveNow.twitch.add(c) : liveNow.twitch.delete(c); return; }\\n      try { (await isLive(plat, c)) ? liveNow[plat].add(c) : liveNow[plat].delete(c); }\\n      catch {\\n        errs++;\\n        // não deu para verificar: se o painel do jogo mostrou AO VIVO há pouco (15 min), considera ao vivo\\n        const t = gameLive[plat].get(c);\\n        if (t && Date.now() - t < 15 * 60 * 1000) liveNow[plat].add(c);\\n      }\\n    })));\\n  } finally {\\n    liveChecking = false;\\n    liveErrors = errs;\\n    liveLastCheck = Date.now();\\n  }\\n  syncLives();\\n}\\n\\nfunction openLive(i, plat, c) {\\n  // autoplayPolicy: sem isso o Chromium exige um clique humano para o vídeo começar, e a live fica parada\\n  const v = new WebContentsView({ webPreferences: { partition: `persist:conta${i + 1}`, backgroundThrottling: false,\\n    autoplayPolicy: 'no-user-gesture-required' } });\\n  const wc = v.webContents;\\n  if (plat === 'twitch') { twitchViewIds.add(wc.id); wc.once('destroyed', () => twitchViewIds.delete(wc.id)); }\\n  ligarSaudeLive(v, i, plat, c); // se a página cair ou não carregar, abre de novo sozinha\\n  wc.setAudioMuted(true); // igual a \\\"mutar guia\\\": ninguém ouve, mas o player segue tocando normalmente\\n  wc.on('dom-ready', () => {\\n    wc.executeJavaScript(JS_VOLUME(0)).catch(() => {});\\n  });\\n  if (plat === 'kick') {\\n    // modo leve da Kick: menos coisas carregando e desenhando na página da live\\n    kickViewIds.add(wc.id);\\n    wc.once('destroyed', () => kickViewIds.delete(wc.id));\\n    // roda antes da página da Kick: ela sempre \\\"se acha\\\" visível (a janela pode estar escondida com a tela apagada)\\n    // e já deixa marcada a qualidade mais baixa do vídeo (a live é só pra contar ponto, ninguém vê ela)\\n    try {\\n      wc.debugger.attach('1.3');\\n      wc.debugger.sendCommand('Page.addScriptToEvaluateOnNewDocument', { source: KICK_VISIVEL_JS }).catch(() => {});\\n      wc.debugger.sendCommand('Page.addScriptToEvaluateOnNewDocument', { source: KICK_QUALIDADE_JS }).catch(() => {});\\n      // ninguém olha a live: com o \\\"reduzir movimento\\\", a própria Kick corta as animações dela (ideia do PokeIdle Deck)\\n      wc.debugger.sendCommand('Emulation.setEmulatedMedia', { features: [{ name: 'prefers-reduced-motion', value: 'reduce' }] }).catch(() => {});\\n    } catch {}\\n    wc.on('dom-ready', () => { if (kickLeve) wc.insertCSS(KICK_LEVE_CSS).catch(() => {}); });\\n    // opcional: só a lista de mensagens some (o botão dos pontos fica no rodapé do chat e continua lá)\\n    wc.on('dom-ready', () => { if (kickChatOculto) wc.insertCSS(KICK_CHAT_CSS).catch(() => {}); });\\n  }\\n  if (plat === 'twitch' && modoTw(i) !== 'irc' && modoTw(i) !== 'chat') {\\n    // A Twitch só conta ponto com o vídeo TOCANDO, e o vídeo não toca numa página que o Chromium\\n    // considera fora da tela. Na Kick isso foi resolvido pondo a live DENTRO da janela principal;\\n    // na Twitch isso quebrou os painéis (são até 8 lives), então cada live ganha a SUA PRÓPRIA janela,\\n    // posicionada bem longe da área visível. Nada aparece para você e a janela principal não é tocada.\\n    let host = null;\\n    try {\\n      host = new BrowserWindow({\\n        x: -32000, y: -32000, width: 1000, height: 620,\\n        show: false, frame: false, skipTaskbar: true, focusable: false,\\n        backgroundColor: '#000000',\\n        webPreferences: { backgroundThrottling: false },\\n      });\\n      host.setMenu(null);\\n      host.showInactive(); // precisa estar \\\"aberta\\\" para o vídeo rodar, mas nunca rouba o foco\\n      host.setIgnoreMouseEvents(true);\\n      host.contentView.addChildView(v);\\n      v.setBounds({ x: 0, y: 0, width: 1000, height: 620 });\\n      twitchHosts.set(v, host);\\n    } catch (e) {\\n      // se a janela extra falhar, a live continua funcionando do jeito antigo (só sem o vídeo tocar)\\n      try { if (host && !host.isDestroyed()) host.destroy(); } catch {}\\n      twitchHosts.delete(v);\\n      logTravamento('Twitch: não consegui abrir a janela escondida da live (' + e.message + ')');\\n    }\\n  }\\n  if (plat === 'twitch' && modoTw(i) !== 'irc' && modoTw(i) !== 'chat') {\\n    // Além da janela própria: a página se acha visível, já marca a menor qualidade do vídeo e corta\\n    // as animações. Ninguém assiste essa live, ela só existe para contar ponto.\\n    try {\\n      wc.debugger.attach('1.3');\\n      wc.debugger.sendCommand('Page.addScriptToEvaluateOnNewDocument', { source: KICK_VISIVEL_JS }).catch(() => {});\\n      wc.debugger.sendCommand('Page.addScriptToEvaluateOnNewDocument', { source: TWITCH_QUALIDADE_JS }).catch(() => {});\\n      wc.debugger.sendCommand('Emulation.setEmulatedMedia', { features: [{ name: 'prefers-reduced-motion', value: 'reduce' }] }).catch(() => {});\\n      twitchQualidadeMinima(wc); // a Twitch ignora o 160p pedido pelo player: isto ela não ignora\\n    } catch {}\\n  }\\n  if (plat === 'kick' && win && !win.isDestroyed()) {\\n    // Kick e Twitch só contam pontos com o player TOCANDO e a página VISÍVEL. Fora da área da janela, a página\\n    // fica \\\"hidden\\\" e o vídeo nem carrega (confirmado no diagnóstico da Kick, e era o \\\"vídeo parado\\\" da Twitch).\\n    // Então a live fica DENTRO da janela, em tamanho de computador (para o chat e a contagem funcionarem),\\n    // por baixo de uma \\\"capa\\\" escura e das contas do jogo. Ninguém vê, mas para o site ela está aberta na tela.\\n    try {\\n      ensureLiveCover();\\n      if (!tela.off) win.contentView.addChildView(v, 0); // fica por baixo da capa (com a tela apagada, entra ao acender)\\n      // player pequeno: 640x360 basta (e puxa vídeo de qualidade menor); página inteira precisa de tamanho de computador\\n      v.setBounds(kickUrl(i, c).includes('player.kick.com') ? { x: 0, y: TITLE_H, width: 640, height: 360 } : { x: 0, y: TITLE_H, width: 1024, height: 576 });\\n      slotAttached.add(v);\\n      updateLiveCover();\\n    } catch {}\\n  }\\n  wc.setWindowOpenHandler(() => ({ action: 'deny' }));\\n  if (plat === 'twitch' && ['player', 'completo'].includes(modoTw(i))) {\\n    // menor qualidade possível (160p) para gastar pouco; na 1ª vez recarrega para aplicar\\n    wc.on('dom-ready', () => {\\n      wc.executeJavaScript(`(() => { try {\\n        const before = localStorage.getItem('video-quality');\\n        localStorage.setItem('video-quality', JSON.stringify({ default: '160p30' }));\\n        // MUDO: o Chromium só deixa um vídeo começar sozinho se ele estiver mudo. Aqui estava \\\"false\\\",\\n        // então o player da Twitch nem começava (era o \\\"vídeo parado\\\"). A guia já é muda de qualquer jeito.\\n        localStorage.setItem('video-muted', JSON.stringify({ default: true }));\\n        return before;\\n      } catch (e) { return 'erro'; } })()`).then((before) => {\\n        if (before === null && !wc.isDestroyed()) wc.reload();\\n      }).catch(() => {});\\n    });\\n  }\\n  wc.loadURL(plat === 'kick' ? kickUrl(i, c) : PLAT[plat].url(c, modoTw(i)), { userAgent: LIVE_UA }).catch(() => {});\\n  return v;\\n}\\n// As lives abrem uma de cada vez, para não travar o PC abrindo dezenas de páginas no mesmo segundo.\\nconst LIVE_OPEN_GAP = 1500;\\nlet liveOpenAt = 0;\\nfunction scheduleLive(i, plat, c) {\\n  const now = Date.now();\\n  liveOpenAt = Math.max(liveOpenAt, now);\\n  const slot = { view: null, timer: null, openedAt: Date.now() + (liveOpenAt - now), miss: 0 };\\n  slot.timer = setTimeout(() => { slot.timer = null; slot.view = openLive(i, plat, c); }, liveOpenAt - now);\\n  liveOpenAt += LIVE_OPEN_GAP;\\n  return slot;\\n}\\nconst slotAttached = new Set(); // lives que estão dentro da janela (Kick)\\n// capa escura por cima das lives da Kick (e por baixo das contas do jogo), para elas nunca aparecerem\\nlet liveCover = null;\\n// A \\\"capa\\\" tapa as lives escondidas da Kick (que ficam dentro da janela, por baixo das telas do jogo).\\n// Ela PRECISA ser uma página de verdade (WebContentsView): um View comum pinta o fundo na camada de baixo da\\n// janela, e as lives (que têm camada própria) apareciam POR CIMA dele, nos vãos entre as telas. Testado no\\n// Electron: com View comum vazavam milhares de pixels da live; com esta página mínima (sem JavaScript e sem\\n// imagens), zero. Ela só existe enquanto há live da Kick aberta e cobre só a área das lives, para gastar pouco.\\nfunction ensureLiveCover() {\\n  if ((liveCover && !liveCover.webContents.isDestroyed()) || !win) return;\\n  liveCover = new WebContentsView({ webPreferences: { javascript: false, images: false, sandbox: true, webgl: false, spellcheck: false } });\\n  liveCover.setBackgroundColor(GAP_BG);\\n  liveCover.webContents.loadURL('about:blank');\\n  win.contentView.addChildView(liveCover, 0);\\n}\\nfunction updateLiveCover() {\\n  if (!liveCover || liveCover.webContents.isDestroyed() || !win) return;\\n  let w = 0, h = 0;\\n  for (const v of slotAttached) { try { const b = v.getBounds(); w = Math.max(w, b.x + b.width); h = Math.max(h, b.y + b.height); } catch {} }\\n  if (!w) { // não sobrou nenhuma live da Kick na janela: a capa não serve mais (libera o processo dela)\\n    try { win.contentView.removeChildView(liveCover); } catch {}\\n    try { liveCover.webContents.close(); } catch {}\\n    liveCover = null;\\n    return;\\n  }\\n  liveCover.setBounds({ x: 0, y: 0, width: w, height: h });\\n}\\n// ---------- Kick leve ----------\\n// A Kick só conta pontos com o player tocando numa página visível, então não dá para tirar o vídeo.\\n// Mas dá para cortar o resto: imagens (miniaturas, avatares, emotes), fontes, rastreadores/anúncios,\\n// animações, e deixar o vídeo minúsculo (o player tende a escolher a menor qualidade).\\nlet kickLeve = true;\\nconst kickViewIds = new Set();\\nconst twitchViewIds = new Set(); // páginas da Twitch (chat/vídeo) abertas como live\\n// cada live da Twitch tem uma janela só dela, fora da área visível (é lá que o vídeo consegue tocar)\\nconst twitchHosts = new Map();\\nlet kickChatOculto = false; // opção: esconde as mensagens do chat nas lives da Kick (economiza CPU)\\nconst KICK_CHAT_CSS = '#chatroom-messages { display: none !important; }';\\nconst KICK_LEVE_CSS = `\\n  *, *::before, *::after { animation: none !important; transition: none !important; }\\n  video { width: 192px !important; height: 108px !important; max-width: 192px !important; object-fit: contain; }\\n  img { visibility: hidden !important; }\\n`;\\n// Anúncios, rastreadores e avisos de cookies que as páginas das lives carregam (a da Kick abre ~40 sites de fora).\\n// Lista ampliada a partir do PokeIdle Deck (MIT, Copyright (c) 2026 Artur Bruno), mais o que o PokeLink já cortava.\\n// O vídeo, a própria Kick/Twitch e o Cloudflare (a checagem anti-robô) passam normal.\\nconst LIVE_BLOQUEIO = [\\n  // anúncios\\n  'googlesyndication.com', 'doubleclick.net', 'googleadservices.com', 'adtrafficquality.google', 'imasdk.googleapis.com',\\n  'openx.net', 'openxcdn.net', 'criteo.com', 'criteo.net', 'dnacdn.net', 'creativecdn.com', 'id5-sync.com', 'amazon-adsystem.com',\\n  // análises e rastreadores\\n  'googletagmanager.com', 'google-analytics.com', 'tiktok.com', 'tiktokw.us', 'facebook.net', 'facebook.com', 'analytics.yahoo.com',\\n  'quora.com', 'litix.io', 'datazoom.io', 'datadoghq.com', 'datadoghq.eu', 'datadoghq-browser-agent.com', 'cloudflareinsights.com',\\n  'scorecardresearch.com', 'sentry.io', 'amplitude.com', 'hotjar.com', 'clarity.ms',\\n  // aviso de cookies e pagamento (as lives não assinam nada)\\n  'onetrust.com', 'cookielaw.org', 'stripe.com', 'stripe.network',\\n];\\n// alguns serviços têm muitos domínios com o mesmo nome no meio (ex.: browser-intake-datadoghq.com): esses o PokeLink já cortava por pedaço de nome\\nconst LIVE_BLOQUEIO_PEDACOS = /datadoghq|onetrust|cookielaw/;\\nconst liveBloqueado = (url) => {\\n  try {\\n    const h = new URL(url).hostname.toLowerCase();\\n    return LIVE_BLOQUEIO.some((d) => h === d || h.endsWith('.' + d)) || LIVE_BLOQUEIO_PEDACOS.test(h);\\n  } catch { return false; }\\n};\\nfunction watchKickRequests(i) {\\n  const ses = session.fromPartition(`persist:conta${i + 1}`);\\n  try {\\n    ses.webRequest.onBeforeRequest({ urls: ['*://*/*'] }, (d, cb) => {\\n      if (kickLeve) {\\n        if (kickViewIds.has(d.webContentsId) &&\\n            (d.resourceType === 'image' || d.resourceType === 'font' || liveBloqueado(d.url))) return cb({ cancel: true });\\n        // Twitch: além dos anúncios, corta imagem e fonte. A página da Twitch carrega miniaturas, avatares\\n        // e emotes sem parar, e nada disso é visto por ninguém (a live fica numa janela escondida) nem é\\n        // preciso para contar ponto: o saldo e o resgate agora vêm pela API, não da tela.\\n        if (twitchViewIds.has(d.webContentsId) &&\\n            (d.resourceType === 'image' || d.resourceType === 'font' || liveBloqueado(d.url))) return cb({ cancel: true });\\n      }\\n      cb({});\\n    });\\n  } catch {}\\n}\\n// Player da Kick: \\\"auto\\\" (padrão) = player pequeno (player.kick.com, só o vídeo). Se numa conta os pontos\\n// não subirem em 15 min, aquela conta volta sozinha para a página inteira. \\\"completa\\\" = sempre a página inteira.\\nlet kickPlayer = 'auto';\\nconst kickCompleta = ACCOUNTS.map(() => false); // conta em que o player pequeno não contou pontos\\nconst kickUrl = (i, c) => (kickPlayer === 'completa' || kickCompleta[i]\\n  ? `https://kick.com/${c}` : `https://player.kick.com/${c}?autoplay=true&muted=false`);\\nfunction setKickPlayer(m) {\\n  kickPlayer = m;\\n  kickCompleta.fill(false);\\n  saveLives();\\n  buildMenu();\\n  ACCOUNTS.forEach((_, i) => { for (const sl of liveOpen[i].kick.values()) closeLive(sl); liveOpen[i].kick.clear(); });\\n  syncLives();\\n}\\nasync function setProcessoUnico(on) {\\n  processoUnico = !!on;\\n  try { fs.writeFileSync(desempenhoFile(), JSON.stringify({ processoUnico })); } catch {}\\n  buildMenu();\\n  const r = await uiDialog({\\n    type: 'question', title: 'Interface em um só processo',\\n    message: processoUnico ? 'Ligado. Reiniciar o PokeLink agora?' : 'Desligado. Reiniciar o PokeLink agora?',\\n    detail: 'A mudança só vale depois de reiniciar. Seus logins e configurações são mantidos.' + (processoUnico ? '\\\\n\\\\nSe notar qualquer coisa estranha, é só desligar aqui de novo.' : ''),\\n    buttons: ['Reiniciar agora', 'Depois'], defaultId: 0, cancelId: 1,\\n  });\\n  if (r && r.response === 0) restartApp();\\n}\\nfunction setKickChatOculto(on) {\\n  kickChatOculto = !!on;\\n  saveLives();\\n  buildMenu();\\n  ACCOUNTS.forEach((_, i) => { for (const sl of liveOpen[i].kick.values()) { try { if (sl.view) sl.view.webContents.reload(); } catch {} } });\\n}\\nfunction setKickMax(n) {\\n  LIVE_MAX.kick = n;\\n  saveLives();\\n  buildMenu();\\n  syncLives(); // fecha as lives que passaram do limite\\n}\\nfunction setKickLeve(on) {\\n  kickLeve = !!on;\\n  saveLives();\\n  buildMenu();\\n  // recarrega as lives da Kick para aplicar\\n  ACCOUNTS.forEach((_, i) => { for (const sl of liveOpen[i].kick.values()) { try { if (sl.view) sl.view.webContents.reload(); } catch {} } });\\n}\\n\\nfunction closeLive(slot) {\\n  if (slot.timer) clearTimeout(slot.timer);\\n  const v = slot.view;\\n  if (v && slotAttached.has(v)) { try { win.contentView.removeChildView(v); } catch {} slotAttached.delete(v); updateLiveCover(); }\\n  try { if (v && !v.webContents.isDestroyed()) v.webContents.close(); } catch {}\\n  // janela escondida da live da Twitch: fecha junto, senão fica sobrando aberta fora da tela\\n  const host = v && twitchHosts.get(v);\\n  if (host) {\\n    twitchHosts.delete(v);\\n    try { if (!host.isDestroyed()) host.destroy(); } catch {}\\n  }\\n}\\n\\n// ---------- Limpeza de memória da interface ----------\\n// As páginas do PokeLink (barras e painéis) redesenham partes da tela a cada poucos segundos, e o Chromium demora a coletar\\n// o que sobra (medido: o painel da direita chegava a +10 MB por minuto e voltava ao normal só depois de uma coleta).\\n// A cada minuto pedimos a coleta a elas. Só às páginas do PokeLink; nunca ao jogo nem às lives.\\nasync function liberarMemoriaUI() {\\n  if (tela.off || sono.ausente) return;\\n  const lista = [...bars.map((b) => b.webContents), titleBar && titleBar.webContents, sidebar && sidebar.webContents,\\n    otimSide && otimSide.webContents, bottomBar && bottomBar.webContents];\\n  const vistos = new Set(); // se as páginas dividem um processo, uma coleta basta\\n  for (const wc of lista) {\\n    let ligou = false;\\n    try {\\n      if (!wc || wc.isDestroyed()) continue;\\n      const pid = wc.getOSProcessId();\\n      if (vistos.has(pid)) continue;\\n      vistos.add(pid);\\n      if (wc.debugger.isAttached()) continue; // alguém (ex.: F12) já está usando o depurador desta página\\n      wc.debugger.attach('1.3'); ligou = true;\\n      await withTimeout(wc.debugger.sendCommand('HeapProfiler.collectGarbage'), 5000);\\n    } catch {} finally { try { if (ligou && wc.debugger.isAttached()) wc.debugger.detach(); } catch {} }\\n  }\\n}\\n\\n// ---------- Saúde das lives: recupera a que caiu ou travou (ideia do PokeIdle Deck, MIT) ----------\\n// Antes, uma live com a página caída ou sem internet ficava parada até a troca de modo de 15 min. Agora:\\n// página que cai é aberta de novo na hora; página que não carrega tenta de novo (15 s, 30 s, 1 min, 2 min); e, a cada\\n// 30 s, confere se o vídeo da Kick está mesmo andando (é o que rende pontos): pausado, manda tocar; parado em duas\\n// conferências seguidas, recarrega SÓ aquela live, esperando o dobro a cada tentativa seguida (1, 2 e 4 min).\\nconst LIVE_VIGIA_SEG = 30;\\nlet LIVE_FALHA_BASE = 15; // segundos até tentar de novo uma live que não carregou (dobra até 2 min)\\nconst saudeLive = new Map(); // id da página -> { reloads, retries, stalls, tempo, falhas, timer, carregandoDesde }\\nconst LIVE_PLAY_JS = `(() => { const v = document.querySelector('video'); if (!v) return 'sem';\\n  if (v.paused) v.play().catch(() => {}); return [v.paused, v.readyState, v.currentTime].join(' '); })()`;\\nfunction saudeDe(id) {\\n  let s = saudeLive.get(id);\\n  if (!s) { s = { reloads: 0, retries: 0, stalls: 0, tempo: null, falhas: 0, timer: null, carregandoDesde: 0 }; saudeLive.set(id, s); }\\n  return s;\\n}\\nfunction recarregarLive(i, plat, c, wc, motivo) {\\n  if (!wc || wc.isDestroyed()) return;\\n  const s = saudeDe(wc.id);\\n  s.reloads++; s.stalls = 0; s.tempo = null; s.carregandoDesde = 0;\\n  logTravamento(`${nameOf(i)}: live ${plat} de ${c} recarregada (${motivo}; ${s.reloads}ª vez)`);\\n  logEvento('problema', i, plat, c, `a live de ${c} na ${plat === 'twitch' ? 'Twitch' : 'Kick'} parou (${motivo})`);\\n  try { wc.reload(); } catch {}\\n}\\nfunction ligarSaudeLive(v, i, plat, c) {\\n  const wc = v.webContents;\\n  const id = wc.id;\\n  const s = saudeDe(id);\\n  wc.once('destroyed', () => { const x = saudeLive.get(id); if (x && x.timer) clearTimeout(x.timer); saudeLive.delete(id); });\\n  const atual = () => { const sl = liveOpen[i][plat].get(c); return !!sl && sl.view === v && !wc.isDestroyed(); };\\n  wc.on('render-process-gone', (_, d) => {\\n    if (!atual() || d.reason === 'clean-exit') return;\\n    logTravamento(`${nameOf(i)}: a página da live ${plat} de ${c} caiu (${d.reason})`);\\n    setTimeout(() => { if (atual()) recarregarLive(i, plat, c, wc, 'página caiu'); }, 2000);\\n  });\\n  wc.on('did-fail-load', (_, code, desc, url, principal) => {\\n    if (!principal || code === -3 || !atual()) return; // -3 = navegação trocada por outra (normal)\\n    s.falhou = true; // o Electron avisa \\\"terminou de carregar\\\" também para a página de erro: esse aviso não conta como sucesso\\n    if (s.timer) return;\\n    const espera = Math.min(120, LIVE_FALHA_BASE * 2 ** Math.min(s.falhas, 3));\\n    s.falhas++;\\n    s.timer = setTimeout(() => { s.timer = null; if (atual()) { try { wc.reload(); } catch {} } }, espera * 1000);\\n  });\\n  wc.on('did-finish-load', () => {\\n    if (s.falhou) { s.falhou = false; return; } // era a página de erro da falha acima\\n    s.falhas = 0; s.carregandoDesde = 0;\\n  });\\n}\\nlet vigiaLivesBusy = false;\\nasync function vigiarLives() {\\n  if (vigiaLivesBusy || tela.off || sono.ausente) return; // tela apagada / PC ausente: as lives estão pausadas de propósito\\n  vigiaLivesBusy = true;\\n  try {\\n    for (let i = 0; i < ACCOUNTS.length; i++) {\\n      for (const [c, slot] of [...liveOpen[i].kick]) {\\n        const v = slot.view;\\n        if (!v) continue; // ainda vai abrir (as lives abrem escalonadas)\\n        const wc = v.webContents; // numa página destruída isto vira undefined\\n        if (!wc || wc.isDestroyed()) { closeLive(slot); liveOpen[i].kick.delete(c); continue; } // sumiu: a próxima sincronização abre outra\\n        const s = saudeDe(wc.id);\\n        try { if (typeof wc.isCrashed === 'function' && wc.isCrashed()) { recarregarLive(i, 'kick', c, wc, 'página caiu'); continue; } } catch {}\\n        if (wc.isLoading()) {\\n          s.carregandoDesde = s.carregandoDesde || Date.now();\\n          if (Date.now() - s.carregandoDesde > 3 * 60 * 1000) recarregarLive(i, 'kick', c, wc, 'carregando há mais de 3 min');\\n          continue;\\n        }\\n        s.carregandoDesde = 0;\\n        let r = 'travada'; // página que não responde ao script conta como parada\\n        try { r = await withTimeout(wc.executeJavaScript(LIVE_PLAY_JS), 10000); } catch { r = 'travada'; }\\n        const p = String(r).split(' ');\\n        let andando = false;\\n        if (p.length === 3 && p[0] === 'false') {\\n          const t = parseFloat(p[2]);\\n          if (isFinite(t)) { andando = s.tempo == null || t > s.tempo; s.tempo = t; }\\n        }\\n        if (andando) {\\n          if (s.stalls || s.retries) logEvento('ok', i, 'kick', c, `a live de ${c} na Kick voltou a tocar`);\\n          s.stalls = 0; s.retries = 0; continue;\\n        }\\n        if (++s.stalls >= 2 << Math.min(s.retries, 2)) { s.retries++; recarregarLive(i, 'kick', c, wc, 'vídeo parado'); }\\n      }\\n    }\\n  } finally { vigiaLivesBusy = false; }\\n}\\n\\n// abre/fecha as lives de cada conta conforme quem está ao vivo, o que está ligado e os limites\\nfunction syncLives() {\\n  ACCOUNTS.forEach((_, i) => {\\n    for (const plat of Object.keys(LIVE_CHANNELS)) {\\n      const open = liveOpen[i][plat];\\n      let want = [];\\n      if (lives[plat][i] && !sono.ausente) {\\n        const aoVivo = LIVE_CHANNELS[plat].filter((c) => liveNow[plat].has(c));\\n        if (plat === 'kick' && kickSel[i].length) {\\n          // você escolheu os canais: abre só eles (quando estiverem ao vivo)\\n          want = kickSel[i].filter((c) => liveNow.kick.has(c)).slice(0, LIVE_MAX.kick);\\n        } else if (plat === 'kick') {\\n          // mantém as que já estão abertas (reabrir zera o tempo assistido) e completa com os canais\\n          // que já têm mais pontos: concentrar num canal chega antes nos 300/500/1.000 de cada bônus\\n          const pts = (c) => (kickPts[i][c] && kickPts[i][c].pts) || 0;\\n          const ganho = (c) => (kickPts[i][c] && kickPts[i][c].pts != null ? kickPts[i][c].pts - kickPts[i][c].base : 0);\\n          const abertas = aoVivo.filter((c) => open.has(c)).sort((a, b) => ganho(b) - ganho(a)); // as que estão rendendo primeiro\\n          const resto = aoVivo.filter((c) => !open.has(c)).sort((a, b) => pts(b) - pts(a));\\n          want = [...abertas, ...resto].slice(0, LIVE_MAX.kick);\\n        } else if (plat === 'twitch' && twitchSel[i].length) {\\n          // você escolheu os canais da Twitch: abre só eles (quando estiverem ao vivo)\\n          want = twitchSel[i].filter((c) => liveNow.twitch.has(c)).slice(0, LIVE_MAX.twitch);\\n        } else if (plat === 'twitch') {\\n          // mantém as abertas (reabrir zera o tempo assistido) e completa com quem já tem mais pontos:\\n          // concentrar em poucos canais chega antes nos 300 / 500 / 1.000 de cada bônus\\n          const pts = (c) => (twitchPts[i][c] && twitchPts[i][c].pts) || 0;\\n          const ganho = (c) => (twitchPts[i][c] && twitchPts[i][c].pts != null ? twitchPts[i][c].pts - twitchPts[i][c].base : 0);\\n          const abertas = aoVivo.filter((c) => open.has(c)).sort((a, b) => ganho(b) - ganho(a));\\n          const resto = aoVivo.filter((c) => !open.has(c)).sort((a, b) => pts(b) - pts(a));\\n          want = [...abertas, ...resto].slice(0, LIVE_MAX.twitch);\\n        } else {\\n          want = aoVivo.slice(0, LIVE_MAX[plat]);\\n        }\\n      }\\n      for (const [c, v] of open) {\\n        if (want.includes(c)) { v.miss = 0; continue; }\\n        // Fecha NA HORA quando foi você que tirou (plataforma desligada, canal desativado, fora do limite).\\n        // Só espera 2 verificações quando o motivo é o canal ter aparecido offline (pode ser falha momentânea\\n        // da Kick/Twitch, e reabrir zeraria o tempo assistido).\\n        const tiradoPorVoce = !lives[plat][i] ||\\n          (plat === 'kick' && kickSel[i].length && !kickSel[i].includes(c)) ||\\n          (plat === 'twitch' && twitchSel[i].length && !twitchSel[i].includes(c)) ||\\n          liveNow[plat].has(c);\\n        v.miss = (v.miss || 0) + 1;\\n        if (tiradoPorVoce || v.miss >= 2) {\\n          if (!tiradoPorVoce) logEvento('info', i, plat, c, `a live de ${c} na ${plat === 'twitch' ? 'Twitch' : 'Kick'} acabou`);\\n          closeLive(v); open.delete(c);\\n        }\\n      }\\n      if (plat === 'twitch') {\\n        // o modo desta conta mudou (ex.: conexão direta não contou): fecha e reabre no modo novo\\n        const m = modoTw(i);\\n        if (modoTwAtual[i] && modoTwAtual[i] !== m) reabrirTwitch(i);\\n        modoTwAtual[i] = m;\\n      }\\n      if (plat === 'twitch' && modoTw(i) === 'irc') {\\n        // modo conexão direta: nenhuma página por canal, só uma conexão de chat por conta\\n        for (const c of want) if (!open.has(c)) open.set(c, { view: null, timer: null, openedAt: Date.now(), miss: 0 });\\n        if (open.size && !ircDesde[i]) ircDesde[i] = Date.now();\\n        if (!open.size) ircDesde[i] = 0;\\n        ensureIrc(i, [...open.keys()]);\\n      } else {\\n        for (const c of want) if (!open.has(c)) open.set(c, scheduleLive(i, plat, c));\\n      }\\n    }\\n  });\\n  sendState();\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('lives-update'); // painel das lives\\n}\\n\\nfunction livesState() {\\n  return {\\n    twitch: lives.twitch,\\n    kick: lives.kick,\\n    open: liveOpen.map((o) => ({ twitch: [...o.twitch.keys()], kick: [...o.kick.keys()] })),\\n    checked: liveLastCheck > 0,\\n  };\\n}\\n\\n// liga/desliga Twitch ou Kick de uma conta; só liga se a conta estiver logada naquela plataforma\\nasync function setLivesOn(i, plat, on) {\\n  if (!PLAT[plat]) return;\\n  if (on && !(await isLogged(i, plat))) {\\n    sendState(); buildMenu(); // mantém o botão e o menu desligados\\n    const nm = PLAT[plat].name;\\n    const r = await uiDialog({\\n      type: 'warning',\\n      title: nm,\\n      message: `${nameOf(i)} não está conectada na ${nm}.`,\\n      detail: `Para ${plat === 'twitch' ? 'o bônus' : 'os pontos'} contar${plat === 'twitch' ? '' : 'em'}, as lives precisam abrir com a conta da ${nm} vinculada a esta conta do jogo.\\\\n\\\\n` +\\n        `Entre na ${nm} e o botão liga sozinho quando você fechar a janela de login.`,\\n      buttons: plat === 'kick' ? ['Importar login do navegador', `Entrar na ${nm}`, 'Cancelar'] : [`Entrar na ${nm}`, 'Cancelar'],\\n      defaultId: 0,\\n      cancelId: plat === 'kick' ? 2 : 1,\\n    });\\n    if (plat === 'kick') {\\n      // o login direto na Kick costuma ser recusado pela proteção anti-robô dela; importar do navegador funciona\\n      if (r.response === 0) importKickLogin(i);\\n      if (r.response === 1) openLiveLogin(i, plat, true);\\n    } else if (r.response === 0) openLiveLogin(i, plat, true);\\n    return;\\n  }\\n  lives[plat][i] = !!on;\\n  saveLives();\\n  buildMenu();\\n  if (on) checkLives(); else syncLives();\\n  // avisa o painel de pontos da Kick (o liga/desliga também fica lá)\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('kick-update');\\n  if (kickWin && !kickWin.isDestroyed()) kickWin.webContents.send('kick-update');\\n}\\nipcMain.on('lives-set', (_, i, plat, on) => {\\n  if (!Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return;\\n  if (typeof plat === 'boolean') { on = plat; plat = 'twitch'; } // compatível com a barra antiga\\n  setLivesOn(i, plat, !!on);\\n});\\n\\n// janela para entrar na Twitch/Kick com a sessão daquela conta\\nfunction openLiveLogin(i, plat, enableAfter) {\\n  const w = new BrowserWindow({\\n    width: 560, height: 780, title: `${PLAT[plat].name} — ${nameOf(i)}`,\\n    backgroundColor: '#141417', autoHideMenuBar: true,\\n    ...(customIconPath() ? { icon: customIconPath() } : {}),\\n    webPreferences: { partition: `persist:conta${i + 1}` },\\n  });\\n  w.setMenu(null);\\n  // janelinhas que o login abre (captcha, \\\"entrar com...\\\"): abrem de verdade, na mesma sessão, como num navegador\\n  w.webContents.setWindowOpenHandler(() => ({\\n    action: 'allow',\\n    overrideBrowserWindowOptions: { width: 520, height: 700, autoHideMenuBar: true, backgroundColor: '#ffffff', webPreferences: { partition: `persist:conta${i + 1}` } },\\n  }));\\n  w.loadURL(PLAT[plat].login, { userAgent: LIVE_UA });\\n  // Twitch: quando o login termina, fecha a janela sozinha\\n  const ses = accountSession(i);\\n  const onCookie = (_, cookie, cause, removed) => {\\n    if (plat === 'twitch' && !removed && cookie.name === 'auth-token' && /twitch\\\\.tv$/.test(cookie.domain)) {\\n      setTimeout(() => { if (!w.isDestroyed()) w.close(); }, 1500);\\n    }\\n  };\\n  ses.cookies.on('changed', onCookie);\\n  // ao fechar, recarrega as lives abertas dessa conta para já contarem com o login\\n  w.on('closed', async () => {\\n    ses.cookies.removeListener('changed', onCookie);\\n    for (const slot of liveOpen[i][plat].values()) { try { if (slot.view) slot.view.webContents.reload(); } catch {} }\\n    if (enableAfter) {\\n      if (await isLogged(i, plat)) setLivesOn(i, plat, true);\\n      else uiDialog({ type: 'info', title: PLAT[plat].name, message: `O login na ${PLAT[plat].name} não foi concluído.`, detail: 'As lives desta conta continuam desligadas.' });\\n    }\\n  });\\n}\\n\\nfunction livesOverview() {\\n  return {\\n    contas: ACCOUNTS.map((_, i) => ({\\n      i, name: nameOf(i),\\n      plats: Object.keys(LIVE_CHANNELS).map((p) => ({ p, name: PLAT[p].name, on: !!lives[p][i], open: [...liveOpen[i][p].keys()],\\n        contando: p === 'twitch' && jogoInfo[i] && jogoInfo[i].twitch ? jogoInfo[i].twitch.contando : null })),\\n    })),\\n    aoVivo: Object.keys(LIVE_CHANNELS).map((p) => ({ p, name: PLAT[p].name, list: [...liveNow[p]] })),\\n    quando: liveLastCheck ? new Date(liveLastCheck).toLocaleTimeString('pt-BR') : '',\\n    erros: liveErrors,\\n    kickInfo: fonteLives || kickCheckInfo,\\n    canais: listaCanais(),\\n    listaInfo,\\n  };\\n}\\nipcMain.handle('lives-get', () => livesOverview());\\nipcMain.handle('lives-check-now', async () => { await checkLives(); return livesOverview(); });\\n\\n// painel \\\"Lives\\\" no estilo do painel da Kick (desenhado pela barra de título)\\nasync function showLives() {\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (canDraw) {\\n    const id = ++cfgPanelSeq;\\n    cfgPanels.add(id);\\n    dialogOpen = true;\\n    layout();\\n    titleBar.webContents.focus();\\n    titleBar.webContents.send('title-lives', { id });\\n    return;\\n  }\\n  const o = livesOverview();\\n  const r = await uiDialog({\\n    type: 'info',\\n    title: 'Lives',\\n    message: 'Lives abertas em segundo plano',\\n    detail: 'Clique num canal aberto para ver a live com a sua conta.',\\n    lives: o,\\n    buttons: ['Fechar', 'Verificar agora'],\\n    defaultId: 0,\\n    cancelId: 0,\\n  });\\n  if (r.response === 1) { await checkLives(); showLives(); }\\n}\\n\\n// abre a live numa janela visível, com a sessão da conta (para conferir os pontos da Kick, por exemplo)\\nconst livePageWins = new Map();\\nfunction openLivePage(i, plat, c) {\\n  if (!PLAT[plat] || !Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return;\\n  const key = `${i}|${plat}|${c}`;\\n  const old = livePageWins.get(key);\\n  if (old && !old.isDestroyed()) { old.focus(); return; }\\n  const w = new BrowserWindow({\\n    width: 1200, height: 820, title: `${PLAT[plat].name} — ${c} — ${nameOf(i)}`,\\n    backgroundColor: '#0b0b0e', autoHideMenuBar: true,\\n    ...(customIconPath() ? { icon: customIconPath() } : {}),\\n    webPreferences: { partition: `persist:conta${i + 1}` },\\n  });\\n  w.setMenu(null);\\n  w.webContents.setAudioMuted(true); // a live escondida já está tocando; esta só serve para olhar\\n  w.on('page-title-updated', (e) => e.preventDefault());\\n  w.webContents.setWindowOpenHandler(({ url }) => { if (/^https?:/i.test(url)) shell.openExternal(url); return { action: 'deny' }; });\\n  w.loadURL(PLAT[plat].url(c), { userAgent: LIVE_UA });\\n  w.on('closed', () => livePageWins.delete(key));\\n  livePageWins.set(key, w);\\n}\\nipcMain.on('live-page-open', (_, i, plat, c) => openLivePage(i, plat, String(c)));\\n\\n// ---------- Extensões do Chrome dentro do PokeLink ----------\\n// O PokeLink baixa cada extensão da Chrome Web Store no PC do usuário (não vem dentro do PokeLink),\\n// guarda em %APPDATA%\\\\pokeidle-multi\\\\extensoes\\\\<id> e carrega nas 4 contas. Atualizam sozinhas.\\n// Para adicionar outra, basta incluir aqui o id dela (o código no fim do link da Chrome Web Store).\\nconst EXTENSIONS = [\\n  { id: 'mhnplloljgchpfpcpbhmcokmnefodjnh', nome: '/hunt for PokeIdle', autor: 'Liang',\\n    sobre: 'Mostra, acima do pokémon em campo, as melhores hunts por XP/h e ouro/h. Clique na barra /hunt dentro do jogo.' },\\n  { id: 'olccbpdjdkbfgondiiaicmlifhbcggmk', nome: 'Rotom Sniper', autor: '', botao: 'Sniper',\\n    sobre: 'Cockpit Auto-Sniper: regras de compra no mercado da comunidade, radar de pokémon, estatísticas de farm.' },\\n];\\nconst extUrl = (id) => 'https://clients2.google.com/service/update2/crx?response=redirect' +\\n  `&prodversion=${process.versions.chrome}&acceptformat=crx2,crx3&x=id%3D${id}%26uc`;\\nconst extRoot = (id) => path.join(app.getPath('userData'), 'extensoes', id);\\nconst extState = Object.fromEntries(EXTENSIONS.map((e) => [e.id, { version: null, error: null, name: null }]));\\n\\n// .crx = cabeçalho do Chrome + um .zip\\nfunction crxToZip(buf) {\\n  if (buf.toString('ascii', 0, 4) !== 'Cr24') throw new Error('o arquivo baixado não é uma extensão');\\n  const v = buf.readUInt32LE(4);\\n  if (v === 3) return buf.subarray(12 + buf.readUInt32LE(8));\\n  if (v === 2) return buf.subarray(16 + buf.readUInt32LE(8) + buf.readUInt32LE(12));\\n  throw new Error('formato de extensão desconhecido');\\n}\\n// descompacta um .zip (sem bibliotecas extras)\\nfunction unzipTo(zip, dir) {\\n  const zlib = require('zlib');\\n  let eocd = -1;\\n  for (let p = zip.length - 22; p >= Math.max(0, zip.length - 65557); p--) {\\n    if (zip.readUInt32LE(p) === 0x06054b50) { eocd = p; break; }\\n  }\\n  if (eocd < 0) throw new Error('zip inválido');\\n  const count = zip.readUInt16LE(eocd + 10);\\n  let p = zip.readUInt32LE(eocd + 16);\\n  const base = path.resolve(dir);\\n  for (let n = 0; n < count; n++) {\\n    if (zip.readUInt32LE(p) !== 0x02014b50) throw new Error('zip inválido');\\n    const method = zip.readUInt16LE(p + 10);\\n    const csize = zip.readUInt32LE(p + 20);\\n    const nlen = zip.readUInt16LE(p + 28), xlen = zip.readUInt16LE(p + 30), clen = zip.readUInt16LE(p + 32);\\n    const local = zip.readUInt32LE(p + 42);\\n    const name = zip.toString('utf8', p + 46, p + 46 + nlen);\\n    p += 46 + nlen + xlen + clen;\\n    const dest = path.resolve(base, name);\\n    if (!dest.startsWith(base + path.sep)) continue; // nunca escreve fora da pasta\\n    if (name.endsWith('/')) { fs.mkdirSync(dest, { recursive: true }); continue; }\\n    const start = local + 30 + zip.readUInt16LE(local + 26) + zip.readUInt16LE(local + 28);\\n    const data = zip.subarray(start, start + csize);\\n    fs.mkdirSync(path.dirname(dest), { recursive: true });\\n    fs.writeFileSync(dest, method === 0 ? data : zlib.inflateRawSync(data));\\n  }\\n}\\nfunction localExt(id) {\\n  try {\\n    const vs = fs.readdirSync(extRoot(id)).filter((v) => fs.existsSync(path.join(extRoot(id), v, 'manifest.json')) && /^\\\\d/.test(v));\\n    vs.sort((a, b) => compareVersions(b, a));\\n    return vs.length ? { id, version: vs[0], dir: path.join(extRoot(id), vs[0]) } : null;\\n  } catch { return null; }\\n}\\nasync function downloadExt(id) {\\n  const r = await withTimeout(session.fromPartition('persist:lives-check').fetch(extUrl(id)), 30000);\\n  if (!r.ok) throw new Error('Chrome Web Store respondeu ' + r.status);\\n  const buf = Buffer.from(await r.arrayBuffer());\\n  const tmp = path.join(extRoot(id), '_baixando');\\n  fs.rmSync(tmp, { recursive: true, force: true });\\n  unzipTo(crxToZip(buf), tmp);\\n  const version = JSON.parse(fs.readFileSync(path.join(tmp, 'manifest.json'), 'utf8')).version;\\n  const dir = path.join(extRoot(id), version);\\n  if (fs.existsSync(path.join(dir, 'manifest.json'))) fs.rmSync(tmp, { recursive: true, force: true });\\n  else { fs.rmSync(dir, { recursive: true, force: true }); fs.renameSync(tmp, dir); }\\n  for (const v of fs.readdirSync(extRoot(id))) if (v !== version) fs.rmSync(path.join(extRoot(id), v), { recursive: true, force: true });\\n  return { id, version, dir };\\n}\\nasync function loadExtInto(ext) {\\n  const st = extState[ext.id];\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    const api = (() => { const ses = session.fromPartition(`persist:conta${i + 1}`); return ses.extensions || ses; })();\\n    try {\\n      // tira versões antigas desta mesma extensão (mesma pasta-base)\\n      for (const e of api.getAllExtensions()) if (e.path !== ext.dir && e.path && e.path.startsWith(extRoot(ext.id))) api.removeExtension(e.id);\\n      if (!api.getAllExtensions().some((e) => e.path === ext.dir)) {\\n        const loaded = await api.loadExtension(ext.dir, { allowFileAccess: false });\\n        if (loaded && loaded.name) st.name = loaded.name;\\n      }\\n      extErroConta[ext.id][i] = null;\\n    } catch (e) { st.error = `conta ${i + 1}: ${e.message}`; extErroConta[ext.id][i] = e.message; }\\n  }\\n  st.version = ext.version;\\n}\\n// carrega as cópias locais (antes das contas abrirem); devolve quais extensões ainda não tinham cópia\\n// extensões desligadas pelo usuário (Ajuda > Extensões)\\nconst extCfgFile = () => path.join(app.getPath('userData'), 'extensoes.json');\\nconst extOff = new Set();\\ntry { (JSON.parse(fs.readFileSync(extCfgFile(), 'utf8')).desligadas || []).forEach((id) => extOff.add(id)); } catch {}\\nconst saveExtCfg = () => { try { fs.writeFileSync(extCfgFile(), JSON.stringify({ desligadas: [...extOff] })); } catch {} };\\nconst extBusy = new Map(); // id -> 'atualizando' | 'reinstalando' | ...\\n\\nasync function loadLocalExtensions() {\\n  const faltando = [];\\n  for (const e of EXTENSIONS) {\\n    if (extOff.has(e.id)) continue;\\n    const loc = localExt(e.id);\\n    if (loc) await loadExtInto(loc); else faltando.push(e.id);\\n  }\\n  return faltando;\\n}\\n// em segundo plano: baixa as que faltam (e recarrega as contas) e atualiza as outras para o próximo início\\nasync function updateExtensions(faltando) {\\n  let novas = false;\\n  for (const e of EXTENSIONS) {\\n    if (extOff.has(e.id)) continue;\\n    try {\\n      const ext = await downloadExt(e.id);\\n      extState[e.id].error = null;\\n      if (faltando.includes(e.id)) { await loadExtInto(ext); novas = true; }\\n    } catch (err) { extState[e.id].error = err.message; }\\n  }\\n  if (novas) views.forEach((_, i) => reloadAccount(i)); // 1ª vez: recarrega para as extensões aparecerem\\n}\\n// No Chrome, a extensão abre pelo botão dela na barra do navegador (uma janelinha). O PokeLink não tem essa\\n// barra, então abre a mesma página da extensão numa janela própria, com a sessão (login) daquela conta.\\nconst extWins = new Map();\\nfunction openExtPage(i, id) {\\n  const def = EXTENSIONS.find((e) => e.id === id);\\n  if (!def || !Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return;\\n  const key = `${i}|${id}`;\\n  const old = extWins.get(key);\\n  if (old && !old.isDestroyed()) { old.show(); old.focus(); return; }\\n  const ses = session.fromPartition(`persist:conta${i + 1}`);\\n  const api = ses.extensions || ses;\\n  const loc = localExt(id);\\n  const ext = loc && api.getAllExtensions().find((e) => e.path === loc.dir);\\n  if (!ext) {\\n    uiDialog({ type: 'warning', title: def.nome, message: `${def.nome} ainda não está instalada.`, detail: 'Ela é baixada sozinha ao abrir o PokeLink. Confira em Ajuda → Extensões.' });\\n    return;\\n  }\\n  const m = ext.manifest || {};\\n  let page = (m.action && m.action.default_popup) || (m.browser_action && m.browser_action.default_popup) ||\\n    (m.side_panel && m.side_panel.default_path) || m.options_page || (m.options_ui && m.options_ui.page);\\n  let grande = false;\\n  if (!page) {\\n    // Sem janelinha: no Chrome, o clique no ícone faz a extensão abrir uma página própria (ex.: o \\\"Cockpit\\\").\\n    // Procura essa página: primeiro as citadas no código de fundo da extensão, depois pelo nome do arquivo.\\n    try {\\n      const norm = (f) => String(f).replace(/\\\\\\\\/g, '/').replace(/^\\\\//, '');\\n      const htmls = fs.readdirSync(loc.dir, { recursive: true }).map(norm).filter((f) => /\\\\.html?$/i.test(f));\\n      const bg = m.background && (m.background.service_worker || (m.background.scripts || [])[0]);\\n      let citadas = [];\\n      if (bg) {\\n        const code = fs.readFileSync(path.join(loc.dir, bg), 'utf8');\\n        citadas = [...code.matchAll(/['\\\"`]\\\\/?([\\\\w\\\\-/.]+\\\\.html?)/g)].map((x) => norm(x[1]));\\n      }\\n      page = citadas.find((c) => htmls.includes(c)) ||\\n        htmls.find((f) => /cockpit|dashboard|painel|panel|sniper|app|index|main/i.test(f)) || htmls[0];\\n      grande = !!page;\\n    } catch {}\\n  }\\n  if (!page) {\\n    uiDialog({ type: 'info', title: def.nome, message: `${def.nome} funciona direto dentro do jogo.`, detail: 'Ela não tem uma janela própria: os recursos dela aparecem na página do jogo.' });\\n    return;\\n  }\\n  const w = new BrowserWindow({\\n    width: grande ? 1180 : 460, height: grande ? 800 : 700, minWidth: 320, minHeight: 400, title: `${def.botao || def.nome} — ${nameOf(i)}`,\\n    backgroundColor: '#141417', autoHideMenuBar: true,\\n    ...(customIconPath() ? { icon: customIconPath() } : {}),\\n    webPreferences: { session: ses },\\n  });\\n  w.setMenu(null);\\n  w.on('page-title-updated', (e) => e.preventDefault());\\n  w.webContents.setWindowOpenHandler(({ url }) => { if (/^https?:/i.test(url)) shell.openExternal(url); return { action: 'deny' }; });\\n  w.loadURL(`chrome-extension://${ext.id}/${String(page).replace(/^\\\\//, '')}`).catch(() => {});\\n  w.on('closed', () => extWins.delete(key));\\n  extWins.set(key, w);\\n}\\nipcMain.on('ext-open', (_, i, id) => openExtPage(i, String(id)));\\n\\n// tira a extensão das 4 contas (sem apagar os arquivos)\\nfunction unloadExt(id) {\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    const ses = session.fromPartition(`persist:conta${i + 1}`);\\n    const api = ses.extensions || ses;\\n    try { for (const e of api.getAllExtensions()) if (e.path && e.path.startsWith(extRoot(id))) api.removeExtension(e.id); } catch {}\\n  }\\n  extState[id].version = null;\\n}\\nconst reloadAllAccounts = () => views.forEach((_, i) => reloadAccount(i));\\n\\n// ligar / desligar / atualizar / reinstalar uma extensão\\n// erro de carregamento por conta (para saber em qual conta a extensão não entrou)\\nconst extErroConta = Object.fromEntries(EXTENSIONS.map((e) => [e.id, ACCOUNTS.map(() => null)]));\\nconst extApi = (i) => { const ses = session.fromPartition(`persist:conta${i + 1}`); return ses.extensions || ses; };\\nfunction extNaConta(id, i) {\\n  try { return extApi(i).getAllExtensions().some((e) => e.path && e.path.startsWith(extRoot(id))); } catch { return false; }\\n}\\n// Reparar numa conta: tira a extensão só daquela conta, apaga os dados que ela guardou ali (configurações\\n// que podem ter estragado) e coloca de novo. O login do jogo e as outras contas não mudam.\\nasync function repararExt(id, i) {\\n  const api = extApi(i);\\n  for (const e of api.getAllExtensions()) if (e.path && e.path.startsWith(extRoot(id))) { try { api.removeExtension(e.id); } catch {} }\\n  const ses = session.fromPartition(`persist:conta${i + 1}`);\\n  const base = (typeof ses.getStoragePath === 'function' && ses.getStoragePath()) || path.join(app.getPath('userData'), 'Partitions', `conta${i + 1}`);\\n  for (const pasta of ['Local Extension Settings', 'Sync Extension Settings', 'Managed Extension Settings']) {\\n    try { fs.rmSync(path.join(base, pasta, id), { recursive: true, force: true }); } catch {}\\n  }\\n  try { await ses.clearStorageData({ origin: `chrome-extension://${id}` }); } catch {}\\n  let ext = localExt(id);\\n  if (!ext) ext = await downloadExt(id);\\n  await api.loadExtension(ext.dir, { allowFileAccess: false });\\n  extErroConta[id][i] = null;\\n  reloadAccount(i);\\n}\\nasync function extAction(id, acao) {\\n  if (!extState[id] || extBusy.has(id)) return;\\n  const rep = /^reparar:(\\\\d)$/.exec(acao);\\n  if (rep) {\\n    const i = Number(rep[1]);\\n    if (!(i >= 0 && i < ACCOUNTS.length)) return;\\n    extBusy.set(id, `reparando na conta ${i + 1}`);\\n    notifyExts();\\n    try { await repararExt(id, i); extState[id].error = null; }\\n    catch (e) { extState[id].error = `conta ${i + 1}: ${e.message}`; extErroConta[id][i] = e.message; }\\n    finally { extBusy.delete(id); sendState(); notifyExts(); }\\n    return;\\n  }\\n  extBusy.set(id, { on: 'ativando', off: 'desativando', update: 'atualizando', reinstall: 'reinstalando' }[acao] || acao);\\n  notifyExts();\\n  try {\\n    if (acao === 'off') {\\n      extOff.add(id); saveExtCfg();\\n      unloadExt(id);\\n      reloadAllAccounts();\\n    } else if (acao === 'on') {\\n      extOff.delete(id); saveExtCfg();\\n      let ext = localExt(id);\\n      if (!ext) ext = await downloadExt(id);\\n      await loadExtInto(ext);\\n      reloadAllAccounts();\\n    } else if (acao === 'update' || acao === 'reinstall') {\\n      unloadExt(id);\\n      if (acao === 'reinstall') fs.rmSync(extRoot(id), { recursive: true, force: true }); // apaga a cópia local\\n      const ext = await downloadExt(id);\\n      extOff.delete(id); saveExtCfg();\\n      await loadExtInto(ext);\\n      reloadAllAccounts();\\n    }\\n    extState[id].error = null;\\n  } catch (e) {\\n    extState[id].error = e.message;\\n    // se a reinstalação falhou no download, tenta voltar a cópia que tiver\\n    const loc = !extOff.has(id) && localExt(id);\\n    if (loc) { try { await loadExtInto(loc); } catch {} }\\n  } finally {\\n    extBusy.delete(id);\\n    sendState(); // atualiza o botão Sniper na barra\\n    notifyExts();\\n  }\\n}\\nfunction extOverview() {\\n  return EXTENSIONS.map((e) => ({\\n    id: e.id, nome: extState[e.id].name || e.nome, autor: e.autor, sobre: e.sobre,\\n    on: !extOff.has(e.id), version: extState[e.id].version || (localExt(e.id) || {}).version || null, error: extState[e.id].error, busy: extBusy.get(e.id) || null,\\n    contas: ACCOUNTS.map((_, i) => ({ nome: nameOf(i), ok: extNaConta(e.id, i), erro: extErroConta[e.id][i] })),\\n  }));\\n}\\nfunction notifyExts() { if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('exts-update'); }\\nipcMain.handle('ext-get', () => extOverview());\\nipcMain.on('ext-action', (_, id, acao) => { extAction(String(id), String(acao)); });\\n\\nfunction showExtensions() {\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (canDraw) {\\n    const id = ++cfgPanelSeq;\\n    cfgPanels.add(id);\\n    dialogOpen = true;\\n    layout();\\n    titleBar.webContents.focus();\\n    titleBar.webContents.send('title-exts', { id });\\n    return;\\n  }\\n  showExtensionsDialog();\\n}\\nfunction showExtensionsDialog() {\\n  const linhas = EXTENSIONS.map((e) => {\\n    const st = extState[e.id];\\n    return `${st.version ? '✓' : '✗'} ${st.name || e.nome}${st.version ? ' ' + st.version : ' (ainda não instalada)'}` +\\n      (e.autor ? ` · por ${e.autor}` : '') + `\\\\n   ${e.sobre}` + (st.error ? `\\\\n   Último erro: ${st.error}` : '');\\n  });\\n  uiDialog({\\n    type: EXTENSIONS.every((e) => extState[e.id].version) ? 'info' : 'warning',\\n    title: 'Extensões',\\n    message: 'Extensões ativas nas 4 contas',\\n    detail: linhas.join('\\\\n\\\\n') + '\\\\n\\\\nBaixadas da Chrome Web Store e atualizadas automaticamente.',\\n  });\\n}\\n\\n// ---------- PvP: captura dos dados do tracker (1º passo da análise de duelos) ----------\\n// Abre o tracker do jogo (pokeidle.io/tracker/j/<nick>) escondido, com a sessão da conta, e salva\\n// tudo o que a página recebe (respostas JSON) + o texto da página num arquivo na Área de Trabalho.\\n// Com esse arquivo dá para montar a leitura dos duelos e o painel de análise.\\nasync function captureTracker(i) {\\n  const nick = nameOf(i);\\n  if (/^Conta \\\\d$/.test(nick)) {\\n    uiDialog({ type: 'warning', title: 'PvP', message: 'Ainda não sei o nick desta conta.', detail: 'Espere a conta carregar o jogo e tente de novo.' });\\n    return;\\n  }\\n  const url = `https://pokeidle.io/tracker/j/${encodeURIComponent(nick.toLowerCase())}`;\\n  // avisa na hora que começou (antes não aparecia nada até terminar)\\n  const aviso = uiDialog({\\n    type: 'info', title: 'PvP', message: `Gerando o relatório do PvP de ${nick}...`,\\n    detail: 'Leva uns 15 segundos. Um novo aviso aparece quando o arquivo estiver pronto.',\\n  });\\n  // Página escondida numa sessão própria (o tracker é público). Usar a sessão da conta podia\\n  // conflitar com o jogo aberto e a janela era fechada no meio (\\\"Object has been destroyed\\\").\\n  const v = new WebContentsView({ webPreferences: { partition: 'persist:tracker', backgroundThrottling: false } });\\n  const wc = v.webContents;\\n  v.setBounds({ x: 0, y: 0, width: 1400, height: 1000 });\\n  const log = [];\\n  const nota = (t) => log.push(`${new Date().toISOString().slice(11, 19)} ${t}`);\\n  wc.on('did-start-loading', () => nota('carregando'));\\n  wc.on('did-finish-load', () => nota('carregou'));\\n  wc.on('did-fail-load', (_, code, desc, u) => nota(`falhou ${code} ${desc} ${u}`));\\n  wc.on('did-navigate', (_, u) => nota('navegou ' + u));\\n  wc.on('render-process-gone', (_, d) => nota('página caiu: ' + d.reason));\\n  wc.on('destroyed', () => nota('página destruída'));\\n  wc.on('console-message', (...args) => { const m = args[0] && args[0].message ? args[0].message : args[2]; if (m) nota('console: ' + String(m).slice(0, 200)); });\\n  wc.setWindowOpenHandler(({ url: u }) => { nota('tentou abrir ' + u); return { action: 'deny' }; });\\n  const alive = () => !wc.isDestroyed();\\n  const dbg = wc.debugger;\\n  const reqs = new Map();\\n  const respostas = [];\\n  try {\\n    dbg.attach('1.3');\\n    await withTimeout(dbg.sendCommand('Network.enable'), 3000);\\n    dbg.on('message', async (_, method, p) => {\\n      if (method === 'Network.responseReceived' && /json|text\\\\/plain/i.test(p.response.mimeType || '')) reqs.set(p.requestId, p.response.url);\\n      if (method === 'Network.loadingFinished' && reqs.has(p.requestId) && alive()) {\\n        try {\\n          const b = await dbg.sendCommand('Network.getResponseBody', { requestId: p.requestId });\\n          respostas.push({ url: reqs.get(p.requestId), body: b.base64Encoded ? Buffer.from(b.body, 'base64').toString('utf8') : b.body });\\n        } catch {}\\n      }\\n    });\\n  } catch (e) { nota('sem captura de rede: ' + e.message); }\\n  const espera = (ms) => new Promise((r) => setTimeout(r, ms));\\n  // cada leitura tem limite de tempo: com a página ainda carregando, o executeJavaScript podia ficar esperando para sempre\\n  const ler = () => (alive() ? withTimeout(wc.executeJavaScript('document.body ? document.body.innerText : \\\"\\\"'), 2500).catch(() => '') : Promise.resolve(''));\\n  let texto = '', turno = '';\\n  try {\\n    wc.loadURL(url).catch((e) => nota('loadURL: ' + e.message)); // não espera o \\\"fim do carregamento\\\"\\n    for (let k = 0; k < 10; k++) { await espera(1000); const t = await ler(); if (t) texto = t; } // guarda o que tiver a cada segundo\\n    nota(texto ? `texto lido (${texto.length} letras)` : 'texto vazio');\\n    if (alive()) {\\n      await withTimeout(wc.executeJavaScript(`(() => {\\n        const b = [...document.querySelectorAll('button,a,[role=button]')].find((e) => /turno a turno/i.test(e.textContent || ''));\\n        if (b) b.click(); return !!b;\\n      })()`), 3000).then((ok) => nota(ok ? 'abriu turno a turno' : 'botão turno a turno não encontrado')).catch(() => {});\\n      await espera(4000);\\n      turno = await ler();\\n    }\\n  } catch (e) {\\n    nota('erro: ' + e.message);\\n  } finally {\\n    try { dbg.detach(); } catch {}\\n    try { if (alive()) wc.close(); } catch {}\\n  }\\n  // salva na Área de Trabalho; se não der, na pasta Downloads; e sempre uma cópia na pasta de dados do app\\n  const nome = `pvp-tracker-${nick}.json`;\\n  const dados = JSON.stringify({ versao: APP_VERSION, nick, url, data: new Date().toISOString(), log, respostas, texto, turno }, null, 1);\\n  let f = null;\\n  for (const dir of ['desktop', 'downloads', 'userData']) {\\n    try { const p = path.join(app.getPath(dir), nome); fs.writeFileSync(p, dados, 'utf8'); f = p; break; } catch {}\\n  }\\n  uiDialogClose(aviso); // fecha o \\\"gerando...\\\" e mostra o resultado\\n  if (!f) { showError('PvP', 'Não consegui salvar o relatório em nenhuma pasta.'); return; }\\n  const r = await uiDialog({\\n    type: 'info', title: 'PvP', message: 'Relatório do PvP pronto.',\\n    detail: `Arquivo: ${f}\\\\n\\\\n${respostas.length} resposta(s) do tracker capturadas` +\\n      (texto ? '' : ' (a página do tracker não carregou o texto)') + '. Envie esse arquivo para montar a análise dos duelos.',\\n    buttons: ['Mostrar o arquivo', 'OK'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (r.response === 0) shell.showItemInFolder(f);\\n}\\n\\n// ---------- PvP: histórico e análise dos duelos (dados do tracker do jogo) ----------\\n// O tracker (pokeidle.io/tracker/j/<nick>) mostra só as últimas 20 partidas. O PokeLink lê o tracker\\n// de cada conta de tempos em tempos e guarda cada partida nova em %APPDATA%\\\\pokeidle-multi\\\\pvp,\\n// montando um histórico maior para calcular vitórias/derrotas por adversário e dar sugestões.\\nconst PVP_EVERY_MIN = 15;\\nconst pvpDir = () => path.join(app.getPath('userData'), 'pvp');\\nconst pvpFile = (nick) => path.join(pvpDir(), nick.toLowerCase().replace(/[^a-z0-9_-]/g, '_') + '.json');\\nconst pvpBusy = new Set();\\nconst TYPES = ['NORMAL', 'FIRE', 'WATER', 'GRASS', 'ELECTRIC', 'ICE', 'FIGHTING', 'POISON', 'GROUND', 'FLYING',\\n  'PSYCHIC', 'BUG', 'ROCK', 'GHOST', 'DRAGON', 'DARK', 'STEEL', 'FAIRY'];\\nconst splitTypes = (t) => (String(t).toUpperCase().match(new RegExp(TYPES.join('|'), 'g')) || []);\\n// tabela de tipos (ataque -> defesa): 2 = super efetivo, 0.5 = pouco efetivo, 0 = imune\\nconst TYPE_CHART = {\\n  NORMAL: { ROCK: 0.5, GHOST: 0, STEEL: 0.5 },\\n  FIRE: { FIRE: 0.5, WATER: 0.5, GRASS: 2, ICE: 2, BUG: 2, ROCK: 0.5, DRAGON: 0.5, STEEL: 2 },\\n  WATER: { FIRE: 2, WATER: 0.5, GRASS: 0.5, GROUND: 2, ROCK: 2, DRAGON: 0.5 },\\n  GRASS: { FIRE: 0.5, WATER: 2, GRASS: 0.5, POISON: 0.5, GROUND: 2, FLYING: 0.5, BUG: 0.5, ROCK: 2, DRAGON: 0.5, STEEL: 0.5 },\\n  ELECTRIC: { WATER: 2, GRASS: 0.5, ELECTRIC: 0.5, GROUND: 0, FLYING: 2, DRAGON: 0.5 },\\n  ICE: { FIRE: 0.5, WATER: 0.5, GRASS: 2, ICE: 0.5, GROUND: 2, FLYING: 2, DRAGON: 2, STEEL: 0.5 },\\n  FIGHTING: { NORMAL: 2, ICE: 2, POISON: 0.5, FLYING: 0.5, PSYCHIC: 0.5, BUG: 0.5, ROCK: 2, GHOST: 0, DARK: 2, STEEL: 2, FAIRY: 0.5 },\\n  POISON: { GRASS: 2, POISON: 0.5, GROUND: 0.5, ROCK: 0.5, GHOST: 0.5, STEEL: 0, FAIRY: 2 },\\n  GROUND: { FIRE: 2, GRASS: 0.5, ELECTRIC: 2, POISON: 2, FLYING: 0, BUG: 0.5, ROCK: 2, STEEL: 2 },\\n  FLYING: { GRASS: 2, ELECTRIC: 0.5, FIGHTING: 2, BUG: 2, ROCK: 0.5, STEEL: 0.5 },\\n  PSYCHIC: { FIGHTING: 2, POISON: 2, PSYCHIC: 0.5, DARK: 0, STEEL: 0.5 },\\n  BUG: { FIRE: 0.5, GRASS: 2, FIGHTING: 0.5, POISON: 0.5, FLYING: 0.5, PSYCHIC: 2, GHOST: 0.5, DARK: 2, STEEL: 0.5, FAIRY: 0.5 },\\n  ROCK: { FIRE: 2, ICE: 2, FIGHTING: 0.5, GROUND: 0.5, FLYING: 2, BUG: 2, STEEL: 0.5 },\\n  GHOST: { NORMAL: 0, PSYCHIC: 2, GHOST: 2, DARK: 0.5 },\\n  DRAGON: { DRAGON: 2, STEEL: 0.5, FAIRY: 0 },\\n  DARK: { FIGHTING: 0.5, PSYCHIC: 2, GHOST: 2, DARK: 0.5, FAIRY: 0.5 },\\n  STEEL: { FIRE: 0.5, WATER: 0.5, ELECTRIC: 0.5, ICE: 2, ROCK: 2, STEEL: 0.5, FAIRY: 2 },\\n  FAIRY: { FIRE: 0.5, FIGHTING: 2, POISON: 0.5, DRAGON: 2, DARK: 2, STEEL: 0.5 },\\n};\\nconst eff = (atk, defTypes) => defTypes.reduce((m, d) => m * ((TYPE_CHART[atk] || {})[d] ?? 1), 1);\\nconst bestHit = (atkTypes, defTypes) => Math.max(...atkTypes.map((a) => eff(a, defTypes)), 0);\\nconst num = (t) => { const s = String(t).trim().toLowerCase(); const n = parseFloat(s.replace(/\\\\./g, '').replace(',', '.'));\\n  if (!isFinite(n)) return 0; return /mi$/.test(s) ? n * 1e6 : /k$/.test(s) ? n * 1e3 : n; };\\nconst fmtN = (n) => (n >= 1e6 ? (n / 1e6).toFixed(1).replace('.', ',') + ' mi' : n >= 1e3 ? (n / 1e3).toFixed(1).replace('.', ',') + ' k' : String(Math.round(n)));\\n\\n// \\\"há 4 min\\\" / \\\"há 2 h\\\" / \\\"há 3 dias\\\" / \\\"agora\\\" -> horário aproximado\\nfunction agoToTime(t, now) {\\n  const m = String(t).match(/(\\\\d+)\\\\s*(s|min|h|dia)/i);\\n  if (!m) return now;\\n  const n = Number(m[1]);\\n  const mult = { s: 1e3, min: 6e4, h: 36e5, dia: 864e5 }[m[2].toLowerCase()] || 6e4;\\n  return now - n * mult;\\n}\\n\\n// transforma o texto da página do tracker em dados\\nfunction parseTracker(text) {\\n  const tk = String(text).split(/[\\\\n\\\\t]/).map((x) => x.trim()).filter(Boolean);\\n  const out = { summary: {}, counters: [], presas: [], mons: [], matches: [] };\\n  const idx = (re) => tk.findIndex((x) => re.test(x));\\n  // cabeçalho\\n  for (const x of tk.slice(0, 40)) {\\n    let m;\\n    if (!out.summary.pr && (m = x.match(/^([\\\\d.]+) PR$/))) out.summary.pr = num(m[1]);\\n    else if (!out.summary.rank && (m = x.match(/^(\\\\d+)º$/))) out.summary.rank = Number(m[1]);\\n    else if (out.summary.wins == null && (m = x.match(/^([\\\\d.]+)V$/))) out.summary.wins = num(m[1]);\\n    else if (out.summary.losses == null && (m = x.match(/^([\\\\d.]+)D$/))) out.summary.losses = num(m[1]);\\n    else if (!out.summary.level && (m = x.match(/^Nível ([\\\\d.]+)$/))) out.summary.level = num(m[1]);\\n  }\\n  // listas \\\"nome / TIPOS / partidas / %\\\"\\n  const readList = (startRe, endRe) => {\\n    const a = idx(startRe); if (a < 0) return [];\\n    let b = tk.findIndex((x, k) => k > a && endRe.test(x)); if (b < 0) b = tk.length;\\n    const seg = tk.slice(a + 1, b).filter((x) => !/^(ADVERSÁRIO|PARTIDAS|VITÓRIAS)$/i.test(x));\\n    const res = [];\\n    for (let k = 0; k + 3 < seg.length + 1; k++) {\\n      if (splitTypes(seg[k + 1]).length && /^[A-Z]+$/.test(seg[k + 1]) && /^[\\\\d.]+$/.test(seg[k + 2] || '') && /%$/.test(seg[k + 3] || '')) {\\n        res.push({ name: seg[k], types: splitTypes(seg[k + 1]), games: num(seg[k + 2]), wr: num(seg[k + 3]) });\\n        k += 3;\\n      }\\n    }\\n    return res;\\n  };\\n  out.counters = readList(/^MAIORES COUNTERS$/i, /^PRESAS FAVORITAS$/i);\\n  out.presas = readList(/^PRESAS FAVORITAS$/i, /^GOLPES$/i);\\n  // os seus pokémon: nome / TIPOS / partidas / % / dano / abates\\n  {\\n    const a = idx(/^OS SEUS POKÉMON$/i); const b = idx(/^ÚLTIMAS 20 PARTIDAS$/i);\\n    if (a >= 0) {\\n      const seg = tk.slice(a + 1, b > a ? b : tk.length);\\n      for (let k = 0; k + 5 < seg.length + 1; k++) {\\n        if (/^[A-Z]+$/.test(seg[k + 1] || '') && splitTypes(seg[k + 1]).length && /^[\\\\d.]+$/.test(seg[k + 2] || '') && /%$/.test(seg[k + 3] || '')) {\\n          out.mons.push({ name: seg[k], types: splitTypes(seg[k + 1]), games: num(seg[k + 2]), wr: num(seg[k + 3]), dmg: num(seg[k + 4]), kills: num(seg[k + 5]) });\\n          k += 5;\\n        }\\n      }\\n    }\\n  }\\n  // partidas: \\\"Vitória|Derrota\\\" / \\\"há X · 1:49\\\" / \\\"contra NICK 1.930 PR\\\" / \\\"+9 ▼\\\" / (detalhes, se abertos)\\n  {\\n    const now = Date.now();\\n    const a = idx(/^ÚLTIMAS 20 PARTIDAS$/i);\\n    const seg = a >= 0 ? tk.slice(a + 1) : [];\\n    const starts = [];\\n    seg.forEach((x, k) => { if (/^(Vitória|Derrota)$/.test(x) && /^contra /.test(seg[k + 2] || '')) starts.push(k); });\\n    starts.forEach((k, n) => {\\n      const end = n + 1 < starts.length ? starts[n + 1] : seg.length;\\n      const blk = seg.slice(k, end);\\n      const t = (blk[1] || '').match(/^(.*?)\\\\s*·\\\\s*(\\\\d+:\\\\d+)$/);\\n      const c = (blk[2] || '').match(/^contra (.+?) ([\\\\d.]+) PR$/);\\n      const d = (blk[3] || '').match(/^([+-]\\\\d+)/);\\n      if (!c) return;\\n      const match = {\\n        win: blk[0] === 'Vitória', opp: c[1], oppPr: num(c[2]), delta: d ? Number(d[1]) : 0,\\n        dur: t ? t[2] : '', time: agoToTime(t ? t[1] : '', now),\\n      };\\n      // times (aparecem quando a partida é aberta): nome seguido de \\\"Nv 100 · caiu\\\"\\n      const det = blk.slice(4);\\n      const cut = det.findIndex((x) => /^O TIME DE /i.test(x));\\n      const team = (part) => {\\n        const r = [];\\n        part.forEach((x, j) => {\\n          const nv = (part[j + 1] || '').match(/^Nv\\\\s*([\\\\d.]+)\\\\s*·?\\\\s*(.*)$/i);\\n          if (!nv) return;\\n          const nums = part.slice(j + 2, j + 6).filter((y) => /^[\\\\d.,]+\\\\s*(k|mi)?$/i.test(y)).slice(0, 3).map(num);\\n          r.push({ name: x, lv: num(nv[1]), fainted: /caiu/i.test(nv[2]), dmg: nums[0] || 0, taken: nums[1] || 0, kills: nums[2] || 0 });\\n        });\\n        return r;\\n      };\\n      if (cut >= 0) { match.mine = team(det.slice(0, cut)); match.theirs = team(det.slice(cut)); }\\n      match.key = [match.opp, match.oppPr, match.delta, match.dur, match.win ? 'V' : 'D'].join('|');\\n      out.matches.push(match);\\n    });\\n  }\\n  return out;\\n}\\n\\n// abre o tracker escondido (sessão própria), abre todas as partidas e devolve o texto da página\\nasync function loadTrackerText(nick) {\\n  const url = `https://pokeidle.io/tracker/j/${encodeURIComponent(nick.toLowerCase())}`;\\n  const v = new WebContentsView({ webPreferences: { partition: 'persist:tracker', backgroundThrottling: false } });\\n  const wc = v.webContents;\\n  v.setBounds({ x: 0, y: 0, width: 1400, height: 1000 });\\n  const alive = () => !wc.isDestroyed();\\n  const js = (code, ms = 3000) => (alive() ? withTimeout(wc.executeJavaScript(code), ms).catch(() => null) : Promise.resolve(null));\\n  const espera = (ms) => new Promise((r) => setTimeout(r, ms));\\n  let text = '';\\n  try {\\n    wc.loadURL(url).catch(() => {});\\n    for (let k = 0; k < 15; k++) {\\n      await espera(1000);\\n      text = (await js('document.body ? document.body.innerText : \\\"\\\"')) || '';\\n      if (/ÚLTIMAS 20 PARTIDAS/i.test(text) && /contra /.test(text)) break;\\n    }\\n    // abre (▼) cada partida para aparecerem os times\\n    await js(`(async () => {\\n      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n      const alvos = [...document.querySelectorAll('*')].filter((e) => e.children.length === 0 && /▼/.test(e.textContent || '') && e.getClientRects().length);\\n      for (const e of alvos) { (e.closest('button,[role=button],summary,[onclick]') || e).click(); await sleep(120); }\\n      return alvos.length;\\n    })()`, 15000);\\n    await espera(1500);\\n    const t2 = await js('document.body ? document.body.innerText : \\\"\\\"');\\n    if (t2) text = t2;\\n  } finally {\\n    try { if (alive()) wc.close(); } catch {}\\n  }\\n  return text;\\n}\\n\\nfunction loadPvp(nick) {\\n  try { return JSON.parse(fs.readFileSync(pvpFile(nick), 'utf8')); } catch { return { nick, matches: [], tracker: null, updated: 0 }; }\\n}\\nfunction savePvp(data) {\\n  try { fs.mkdirSync(pvpDir(), { recursive: true }); fs.writeFileSync(pvpFile(data.nick), JSON.stringify(data)); } catch {}\\n}\\n\\n// lê o tracker e junta as partidas novas no histórico\\nasync function refreshPvp(nick) {\\n  if (!nick || /^Conta \\\\d$/.test(nick) || pvpBusy.has(nick)) return null;\\n  pvpBusy.add(nick);\\n  try {\\n    const text = await loadTrackerText(nick);\\n    const p = parseTracker(text);\\n    if (!p.matches.length && !p.mons.length) return null;\\n    const data = loadPvp(nick);\\n    const known = new Map(data.matches.map((m) => [m.key, m]));\\n    for (const m of p.matches) {\\n      const old = known.get(m.key);\\n      if (!old) { data.matches.push(m); known.set(m.key, m); }\\n      else if (!old.mine && m.mine) Object.assign(old, { mine: m.mine, theirs: m.theirs }); // completa detalhes\\n    }\\n    data.matches.sort((a, b) => b.time - a.time);\\n    if (data.matches.length > 3000) data.matches.length = 3000; // guarda bastante (anos de jogo), mas não cresce para sempre\\n    data.tracker = { summary: p.summary, counters: p.counters, presas: p.presas, mons: p.mons };\\n    data.updated = Date.now();\\n    savePvp(data);\\n    return data;\\n  } finally { pvpBusy.delete(nick); }\\n}\\n\\n// análise: vitórias/derrotas por adversário + sugestões\\nfunction analyzePvp(data) {\\n  // Análise feita só com números reais das partidas guardadas (nada de \\\"chute\\\" por tipo):\\n  // saldo de PR, vitórias/derrotas, dano, abates e quem caiu, por período (hoje, 7 dias, tudo).\\n  const t = data.tracker || { summary: {}, counters: [], presas: [], mons: [] };\\n  const todas = (data.matches || []).filter((m) => m && m.opp).sort((a, b) => b.time - a.time);\\n  const pct = (w, n) => (n ? Math.round((w / n) * 100) : 0);\\n  const media = (v, n) => (n ? v / n : 0);\\n  const contaMais = (arr) => { const c = new Map(); arr.forEach((x) => c.set(x, (c.get(x) || 0) + 1)); return [...c.entries()].sort((a, b) => b[1] - a[1])[0] || null; };\\n  function analisa(ms) {\\n    const n = ms.length, w = ms.filter((m) => m.win).length;\\n    const saldo = ms.reduce((s, m) => s + (Number(m.delta) || 0), 0);\\n    const comTime = ms.filter((m) => m.mine && m.mine.length);\\n    // aberturas: o 1º e o 2º pokémon (nas vitórias rápidas o tracker só mostra quem chegou a lutar,\\n    // então o time inteiro não dá para comparar; a abertura aparece sempre)\\n    const aberturas = new Map();\\n    for (const m of comTime) {\\n      const ab = m.mine.slice(0, 2).map((p) => p.name);\\n      if (ab.length < 2 && !m.win) continue;\\n      const k = ab.join(' → ');\\n      const x = aberturas.get(k) || { ordem: ab, n: 0, w: 0, saldo: 0 };\\n      x.n++; if (m.win) x.w++; x.saldo += Number(m.delta) || 0;\\n      aberturas.set(k, x);\\n    }\\n    const minAb = Math.max(5, Math.round(n * 0.02));\\n    const listaTimes = [...aberturas.values()].filter((x) => x.n >= minAb && x.ordem.length === 2)\\n      .map((x) => ({ ordem: x.ordem, n: x.n, w: x.w, l: x.n - x.w, wr: pct(x.w, x.n), saldo: x.saldo, porPartida: Math.round((x.saldo / x.n) * 10) / 10 }))\\n      .sort((a, b) => b.porPartida - a.porPartida).slice(0, 6);\\n    // adversários\\n    const advs = new Map();\\n    for (const m of ms) {\\n      const a = advs.get(m.opp) || { nome: m.opp, n: 0, w: 0, saldo: 0, pr: m.oppPr, ult: 0, ameaca: new Map(), perdas: 0, porTime: new Map() };\\n      a.n++; if (m.win) a.w++; a.saldo += Number(m.delta) || 0;\\n      if (m.time > a.ult) { a.ult = m.time; a.pr = m.oppPr; }\\n      if (!m.win && m.theirs) { a.perdas++; for (const p of m.theirs) a.ameaca.set(p.name, (a.ameaca.get(p.name) || 0) + (p.dmg || 0)); }\\n      if (m.mine && m.mine.length) {\\n        const k = m.mine.map((p) => p.name).join(' → ');\\n        const tt = a.porTime.get(k) || { n: 0, w: 0 }; tt.n++; if (m.win) tt.w++; a.porTime.set(k, tt);\\n      }\\n      advs.set(m.opp, a);\\n    }\\n    const advLista = [...advs.values()].map((a) => {\\n      const am = [...a.ameaca.entries()].sort((x, y) => y[1] - x[1])[0];\\n      const bom = [...a.porTime.entries()].filter(([, v]) => v.n >= 3).sort((x, y) => (y[1].w / y[1].n) - (x[1].w / x[1].n) || y[1].n - x[1].n)[0];\\n      return { nome: a.nome, n: a.n, w: a.w, l: a.n - a.w, wr: pct(a.w, a.n), saldo: a.saldo, pr: a.pr, ult: a.ult,\\n        ameaca: am ? { nome: am[0], dano: Math.round(am[1] / Math.max(1, a.perdas)) } : null,\\n        melhor: bom && bom[1].w > 0 ? { ordem: bom[0].split(' → '), n: bom[1].n, wr: pct(bom[1].w, bom[1].n) } : null };\\n    });\\n    const minAdv = Math.max(3, Math.round(n * 0.005));\\n    const rivais = advLista.filter((a) => a.n >= minAdv && a.saldo < 0).sort((a, b) => a.saldo - b.saldo).slice(0, 10);\\n    const presas = advLista.filter((a) => a.n >= minAdv && a.saldo > 0).sort((a, b) => b.saldo - a.saldo).slice(0, 10);\\n    // seus pokémon\\n    const mons = new Map();\\n    for (const m of comTime) {\\n      const danoTime = m.mine.reduce((s, p) => s + (p.dmg || 0), 0) || 1;\\n      m.mine.forEach((p, pos) => {\\n        const x = mons.get(p.name) || { nome: p.name, n: 0, w: 0, dano: 0, abates: 0, recebido: 0, vivoV: 0, parte: 0, lead: 0, leadW: 0 };\\n        x.n++; if (m.win) { x.w++; if (!p.fainted) x.vivoV++; }\\n        x.dano += p.dmg || 0; x.abates += p.kills || 0; x.recebido += p.taken || 0; x.parte += (p.dmg || 0) / danoTime;\\n        if (pos === 0) { x.lead++; if (m.win) x.leadW++; }\\n        mons.set(p.name, x);\\n      });\\n    }\\n    const monsLista = [...mons.values()].filter((x) => x.n >= Math.max(3, Math.round(comTime.length * 0.02))).map((x) => ({\\n      nome: x.nome, n: x.n, dano: Math.round(media(x.dano, x.n)), abates: Math.round(media(x.abates, x.n) * 10) / 10,\\n      recebido: Math.round(media(x.recebido, x.n)), vivo: pct(x.vivoV, x.w), parte: Math.round(media(x.parte, x.n) * 100),\\n      lead: x.lead, leadWr: pct(x.leadW, x.lead),\\n    })).sort((a, b) => b.parte - a.parte);\\n    // ameaças: pokémon dos adversários que mais derrubam o seu time (abates e dano que eles mesmos fizeram)\\n    const contra = new Map();\\n    for (const m of ms) {\\n      for (const p of (m.theirs || [])) {\\n        const x = contra.get(p.name) || { nome: p.name, n: 0, w: 0, abates: 0, dano: 0, seus: new Map() };\\n        x.n++; if (m.win) x.w++; x.abates += p.kills || 0; x.dano += p.dmg || 0;\\n        (m.mine || []).forEach((q) => x.seus.set(q.name, (x.seus.get(q.name) || 0) + (q.kills || 0)));\\n        contra.set(p.name, x);\\n      }\\n    }\\n    const minC = Math.max(10, Math.round(n * 0.03));\\n    const counters = [...contra.values()].filter((x) => x.n >= minC).map((x) => {\\n      const top = [...x.seus.entries()].sort((a, b) => b[1] - a[1])[0];\\n      return { nome: x.nome, n: x.n, wr: pct(x.w, x.n), abates: Math.round((x.abates / x.n) * 100) / 100, dano: Math.round(x.dano / x.n),\\n        melhor: top && top[1] > 0 ? { nome: top[0], abates: Math.round((top[1] / x.n) * 10) / 10 } : null };\\n    }).sort((a, b) => b.abates - a.abates || b.dano - a.dano).slice(0, 10);\\n    return { n, w, l: n - w, wr: pct(w, n), saldo, times: listaTimes, rivais, presas, mons: monsLista, counters };\\n  }\\n  const agora = Date.now();\\n  const desde = (ms) => todas.filter((m) => agora - m.time <= ms);\\n  const ult = todas.slice(0, 20);\\n  return {\\n    nick: data.nick, updated: data.updated, total: todas.length, desde: todas.length ? todas[todas.length - 1].time : 0,\\n    summary: t.summary || {},\\n    ultimas: ult.map((m) => ({ win: !!m.win, delta: Number(m.delta) || 0, opp: m.opp, dur: m.dur, time: m.time })),\\n    periodos: { hoje: analisa(desde(864e5)), semana: analisa(desde(7 * 864e5)), tudo: analisa(todas) },\\n    temporada: { counters: (t.counters || []).slice(0, 6), presas: (t.presas || []).slice(0, 6) },\\n  };\\n}\\n\\n// janela do PvP\\nlet pvpWin = null;\\nfunction openPvp(i) {\\n  if (pvpWin && !pvpWin.isDestroyed()) { pvpWin.webContents.send('pvp-account', i); pvpWin.show(); pvpWin.focus(); return; }\\n  pvpWin = new BrowserWindow({\\n    width: 1100, height: 820, minWidth: 760, minHeight: 560, title: 'PvP — PokeLink',\\n    backgroundColor: '#141417', autoHideMenuBar: true,\\n    titleBarStyle: 'hidden', titleBarOverlay: { color: TITLE_BG, symbolColor: TITLE_FG, height: TITLE_H },\\n    ...(customIconPath() ? { icon: customIconPath() } : {}),\\n    webPreferences: { preload: path.join(__dirname, 'preload.js') },\\n  });\\n  pvpWin.setMenu(null);\\n  pvpWin.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'pvp', i: String(i) } });\\n  pvpWin.on('closed', () => { pvpWin = null; });\\n}\\nipcMain.handle('pvp-get', async (_, i, force) => {\\n  if (!Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return null;\\n  const nick = nameOf(i);\\n  if (/^Conta \\\\d$/.test(nick)) return { erro: 'Ainda não sei o nick desta conta. Espere o jogo carregar.' };\\n  let data = loadPvp(nick);\\n  if (force || !data.updated || Date.now() - data.updated > 5 * 60 * 1000) data = (await refreshPvp(nick)) || data;\\n  if (!data.updated) return { erro: 'Não consegui ler o tracker desta conta. Confira a internet e tente \\\"Atualizar\\\".' };\\n  return Object.assign(analyzePvp(data), { contas: ACCOUNTS.map((_, k) => nameOf(k)), conta: i });\\n});\\n// coleta em segundo plano: guarda as partidas novas antes que saiam das \\\"últimas 20\\\"\\nasync function pvpCollectAll() {\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    try { await refreshPvp(nameOf(i)); } catch {}\\n  }\\n}\\n\\n// ---------- Importar o login da Kick de um navegador normal ----------\\n// A proteção anti-robô da Kick recusa o login feito dentro do PokeLink. Em vez de logar aqui,\\n// o usuário loga no Chrome/Edge, exporta os cookies da kick.com (extensão \\\"Cookie-Editor\\\" → Export → JSON)\\n// e cola no PokeLink. Os cookies ficam só na sessão daquela conta, neste PC.\\nfunction parseCookieText(txt) {\\n  const t = String(txt || '').trim();\\n  if (!t) return [];\\n  // 1) JSON (Cookie-Editor, EditThisCookie...)\\n  if (/^[\\\\[{]/.test(t)) {\\n    try {\\n      const j = JSON.parse(t);\\n      const arr = Array.isArray(j) ? j : Array.isArray(j.cookies) ? j.cookies : [j];\\n      return arr.filter((c) => c && c.name).map((c) => ({\\n        name: String(c.name), value: String(c.value ?? ''), domain: c.domain || '.kick.com', path: c.path || '/',\\n        secure: c.secure !== false, httpOnly: !!c.httpOnly,\\n        expirationDate: Number(c.expirationDate || c.expires || 0) || undefined,\\n        sameSite: ({ no_restriction: 'no_restriction', none: 'no_restriction', lax: 'lax', strict: 'strict' })[String(c.sameSite || '').toLowerCase()] || 'unspecified',\\n      }));\\n    } catch {}\\n  }\\n  // 2) formato Netscape (cookies.txt): domínio  flag  caminho  seguro  expira  nome  valor\\n  const net = t.split(/\\\\r?\\\\n/).filter((l) => l && !l.startsWith('#')).map((l) => l.split('\\\\t')).filter((p) => p.length >= 7);\\n  if (net.length) {\\n    return net.map((p) => ({ domain: p[0], path: p[2], secure: /true/i.test(p[3]), expirationDate: Number(p[4]) || undefined, name: p[5], value: p[6], httpOnly: false, sameSite: 'unspecified' }));\\n  }\\n  // 3) \\\"nome=valor; nome2=valor2\\\"\\n  return t.replace(/^cookie:\\\\s*/i, '').split(';').map((x) => x.trim()).filter((x) => x.includes('='))\\n    .map((x) => { const k = x.indexOf('='); return { name: x.slice(0, k).trim(), value: x.slice(k + 1).trim(), domain: '.kick.com', path: '/', secure: true, httpOnly: false, sameSite: 'unspecified' }; });\\n}\\n\\nasync function importKickLogin(i) {\\n  const f = await uiDialog({\\n    type: 'question',\\n    title: `Kick — ${nameOf(i)}`,\\n    message: 'Importar o login da Kick do seu navegador',\\n    detail: '1. No Chrome ou Edge, instale a extensão \\\"Cookie-Editor\\\".\\\\n' +\\n      '2. Entre em kick.com com a conta da Kick desta conta do jogo.\\\\n' +\\n      '3. Clique na extensão → Export → JSON (copia sozinho).\\\\n' +\\n      '4. Cole aqui embaixo e clique em Importar.\\\\n\\\\n' +\\n      'Isso é o seu login: cole só aqui no PokeLink e não mande para ninguém.',\\n    form: [{ id: 'cookies', label: 'Cookies da kick.com', hint: 'cole o texto copiado pela extensão', type: 'textarea', value: '' }],\\n    buttons: ['Importar', 'Cancelar'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (f.response !== 0 || !f.values) return;\\n  const list = parseCookieText(f.values.cookies).filter((c) => /kick\\\\.com$/i.test(String(c.domain).replace(/^\\\\./, '')));\\n  if (!list.length) {\\n    showError('Kick', 'Não encontrei cookies da kick.com no texto colado. Confira se você estava em kick.com ao exportar.');\\n    return;\\n  }\\n  const ses = accountSession(i);\\n  let ok = 0;\\n  for (const c of list) {\\n    const host = String(c.domain).replace(/^\\\\./, '');\\n    try {\\n      await ses.cookies.set({\\n        url: `https://${host}${c.path || '/'}`, name: c.name, value: c.value,\\n        domain: c.domain.startsWith('.') || c.domain.includes('kick.com') ? c.domain : undefined,\\n        path: c.path || '/', secure: c.secure, httpOnly: c.httpOnly,\\n        expirationDate: c.expirationDate, sameSite: c.sameSite,\\n      });\\n      ok++;\\n    } catch {}\\n  }\\n  try { await ses.cookies.flushStore(); } catch {}\\n  if (await kickLogged(i)) {\\n    uiDialog({ type: 'info', title: 'Kick', message: `Login da Kick importado na ${nameOf(i)}.`, detail: `${ok} cookie(s) importados. O botão Kick desta conta foi ligado.` });\\n    setLivesOn(i, 'kick', true);\\n  } else {\\n    uiDialog({\\n      type: 'warning', title: 'Kick', message: 'Os cookies foram importados, mas a Kick ainda não reconheceu o login.',\\n      detail: `${ok} cookie(s) importados. Confira se você estava logado em kick.com ao exportar e exporte de novo.`,\\n    });\\n  }\\n}\\n\\n// ---------- Pontos da Kick: leitura em tempo real + aviso + atalho para o resgate ----------\\n// O saldo de pontos de cada canal é lido de dentro das lives da Kick que já estão abertas\\n// escondidas (mesma conta). Primeiro pela API da própria página; se não der, pela tela do chat.\\nconst KICK_GOALS = [\\n  { pts: 300, nome: '+15% XP', chave: 'xp' },\\n  { pts: 500, nome: '+15% Capture Boost', chave: 'capture.?boost' },\\n  { pts: 1000, nome: '+15% Secret Lure', chave: 'secret.?lure' },\\n];\\nconst KICK_POLL_SEC = 60;\\nconst kickPts = ACCOUNTS.map(() => ({})); // slug -> { pts, at, base, baseAt, via, avisado: {300: true...} }\\nconst kickResgatando = new Set(); // \\\"i|slug\\\" que estão resgatando agora, pra não tentar duas vezes ao mesmo tempo\\nconst liveStatus = new Map(); // \\\"conta|canal\\\" -> { tocando, visivel }\\nconst KICK_POINTS_JS = `(async () => {\\n  const slug = (location.pathname.split('/').filter(Boolean)[0] || '').toLowerCase();\\n  const out = { slug, points: null, via: null, visivel: document.visibilityState, tocando: false };\\n  // o player precisa estar tocando para a Kick contar os pontos: se pausou, dá play de novo\\n  for (const v of document.querySelectorAll('video')) {\\n    if (v.paused) {\\n      try { await v.play(); } catch (e) {\\n        // o navegador recusou o play direto: tenta o botão de play do próprio player\\n        const b = [...document.querySelectorAll('button,[role=button]')].find((x) => /play|reproduzir|assistir/i.test((x.getAttribute('aria-label') || '') + ' ' + (x.title || '')));\\n        if (b) b.click();\\n      }\\n    }\\n    if (!v.paused && v.readyState >= 2) out.tocando = true;\\n  }\\n  out.erroPlay = document.querySelectorAll('video').length ? null : 'sem player na página';\\n  const parse = (t) => {\\n    const m = String(t).replace(/\\\\\\\\s/g, '').match(/^([\\\\\\\\d.,]+)([kKmM]?)$/);\\n    if (!m) return null;\\n    let n = parseFloat(m[1].replace(/\\\\\\\\.(?=\\\\\\\\d{3}(\\\\\\\\D|$))/g, '').replace(',', '.'));\\n    if (/k/i.test(m[2])) n *= 1e3; if (/m/i.test(m[2])) n *= 1e6;\\n    return isFinite(n) ? Math.round(n) : null;\\n  };\\n  // 1) API da Kick, de dentro da página (usa o login da própria página)\\n  try {\\n    const tok = decodeURIComponent((document.cookie.match(/(?:^|; )session_token=([^;]+)/) || [])[1] || '');\\n    const h = { Accept: 'application/json' };\\n    if (tok) h.Authorization = 'Bearer ' + tok;\\n    const find = (o, d) => {\\n      if (!o || typeof o !== 'object' || d > 5) return null;\\n      for (const [k, v] of Object.entries(o)) {\\n        if (/point/i.test(k) && typeof v === 'number') return v;\\n        if (/point/i.test(k) && v && typeof v === 'object' && typeof v.points === 'number') return v.points;\\n        const x = find(v, d + 1); if (x != null) return x;\\n      }\\n      return null;\\n    };\\n    for (const u of ['/api/v2/channels/' + slug + '/me', '/api/v2/channels/' + slug + '/points']) {\\n      const r = await fetch(u, { headers: h, credentials: 'include' });\\n      if (!r.ok) continue;\\n      const p = find(await r.json(), 0);\\n      if (p != null) { out.points = Math.round(p); out.via = 'api'; return out; }\\n    }\\n  } catch (e) {}\\n  // 2) tela: botão/elemento de pontos perto do chat\\n  const els = [...document.querySelectorAll('[aria-label],[title],[data-testid],[class*=point],[class*=Point]')]\\n    .filter((e) => /point|ponto/i.test([e.getAttribute('aria-label'), e.getAttribute('title'), e.getAttribute('data-testid'), e.className].join(' ')));\\n  for (const e of els) {\\n    const p = parse(e.textContent || '');\\n    if (p != null) { out.points = p; out.via = 'tela'; return out; }\\n    for (const s of e.querySelectorAll('*')) { const q = s.children.length ? null : parse(s.textContent || ''); if (q != null) { out.points = q; out.via = 'tela'; return out; } }\\n  }\\n  return out;\\n})()`;\\n\\nconst kickAll = ACCOUNTS.map(() => ({})); // slug -> pontos (todos os canais, não só os abertos)\\nconst kickAllAt = ACCOUNTS.map(() => 0);\\nconst KICK_ALL_JS = (slugs) => `(async () => {\\n  const tok = decodeURIComponent((document.cookie.match(/(?:^|; )session_token=([^;]+)/) || [])[1] || '');\\n  const h = { Accept: 'application/json' }; if (tok) h.Authorization = 'Bearer ' + tok;\\n  const out = {};\\n  for (const s of ${JSON.stringify([])}.concat(SLUGS)) {\\n    try { const r = await fetch('/api/v2/channels/' + s + '/points', { headers: h, credentials: 'include' });\\n      if (r.ok) { const j = await r.json(); const p = j && j.data && j.data.points; if (typeof p === 'number') out[s] = p; } } catch (e) {}\\n  }\\n  return out;\\n})()`.replace('SLUGS', JSON.stringify(slugs));\\nasync function pollKickAll(i) {\\n  if (Date.now() - kickAllAt[i] < (kickApiOk[i] ? 15 : 5) * 60 * 1000) return;\\n  if (kickApiOk[i] !== false) {\\n    kickAllAt[i] = Date.now();\\n    for (const slug of LIVE_CHANNELS.kick) {\\n      if (liveOpen[i].kick.has(slug)) continue; // os abertos já são lidos a cada minuto\\n      const n = await saldoKick(i, slug);\\n      if (n == null) break;\\n      kickAll[i][slug] = n;\\n    }\\n    if (kickApiOk[i]) return;\\n  }\\n  const slot = [...liveOpen[i].kick.values()].find((x) => x.view && !x.view.webContents.isDestroyed() && !x.view.webContents.isLoading());\\n  if (!slot) return;\\n  kickAllAt[i] = Date.now();\\n  try { Object.assign(kickAll[i], await withTimeout(slot.view.webContents.executeJavaScript(KICK_ALL_JS(LIVE_CHANNELS.kick)), 20000)); } catch {}\\n}\\n\\n// Saldo de pontos pedido DIRETO à Kick, com o login da própria conta (sem precisar ler de dentro da live)\\nconst acharPontos = (o, d = 0) => {\\n  if (o == null || d > 5) return null;\\n  if (typeof o === 'number') return o;\\n  if (typeof o !== 'object') return null;\\n  for (const k of ['points', 'balance', 'amount']) if (typeof o[k] === 'number') return o[k];\\n  for (const v of Object.values(o)) { const x = acharPontos(v, d + 1); if (x != null) return x; }\\n  return null;\\n};\\nconst kickApiOk = ACCOUNTS.map(() => null); // true/false: a consulta direta funciona nesta conta?\\nasync function saldoKick(i, slug) {\\n  try {\\n    const ses = accountSession(i);\\n    const ck = (await ses.cookies.get({ url: 'https://kick.com', name: 'session_token' }))[0];\\n    if (!ck) return null;\\n    const r = await withTimeout(ses.fetch(`https://kick.com/api/v2/channels/${encodeURIComponent(slug)}/points`, {\\n      headers: { Accept: 'application/json', 'User-Agent': LIVE_UA, Authorization: 'Bearer ' + decodeURIComponent(ck.value) },\\n    }), 10000);\\n    if (!r.ok) { kickApiOk[i] = false; return null; }\\n    const n = acharPontos(await r.json().catch(() => null));\\n    kickApiOk[i] = n != null;\\n    return n;\\n  } catch { kickApiOk[i] = false; return null; }\\n}\\n// vídeo tocando? (serve para o player pequeno e para a página inteira)\\n// força a menor qualidade de vídeo da Kick (gasta bem menos memória e processador que a qualidade cheia).\\n// A live fica escondida o tempo todo, então a qualidade não faz diferença nenhuma pra quem usa o PokeLink.\\nconst KICK_QUALIDADE_JS = `(() => {\\n  try { localStorage.setItem('kick_video_size', '160p'); } catch (e) {}\\n})();`;\\n// Twitch: mesma ideia. A qualidade escolhida fica guardada no próprio navegador, em \\\"video-quality\\\".\\nconst TWITCH_QUALIDADE_JS = `(() => {\\n  try {\\n    localStorage.setItem('video-quality', '{\\\"default\\\":\\\"160p30\\\"}');\\n    localStorage.setItem('volume', '0');\\n    localStorage.setItem('mature', 'true');          // não para no aviso de conteúdo adulto\\n    localStorage.setItem('mature_accepted', 'true');\\n  } catch (e) {}\\n})();`;\\nconst KICK_VISIVEL_JS = `(() => {\\n  if (window.__plVisivel) return;\\n  window.__plVisivel = true;\\n  try {\\n    Object.defineProperty(Document.prototype, 'hidden', { get: () => false, configurable: true });\\n    Object.defineProperty(Document.prototype, 'visibilityState', { get: () => 'visible', configurable: true });\\n    Object.defineProperty(Document.prototype, 'webkitHidden', { get: () => false, configurable: true });\\n    Document.prototype.hasFocus = () => true;\\n  } catch (e) {}\\n  const parar = (e) => e.stopImmediatePropagation();\\n  for (const t of ['visibilitychange', 'webkitvisibilitychange', 'blur', 'pagehide', 'freeze']) {\\n    window.addEventListener(t, parar, true); document.addEventListener(t, parar, true);\\n  }\\n})();`;\\nconst KICK_TOCANDO_JS = `(() => { const v = document.querySelector('video');\\n  return { tocando: !!(v && !v.paused && v.readyState > 2), visivel: document.visibilityState === 'visible' }; })()`;\\n// player pequeno que não está rendendo pontos: aquela conta passa para a página inteira\\nfunction conferirPlayerKick(i) {\\n  if (kickPlayer !== 'auto' || kickCompleta[i]) return;\\n  if (tela.off || Date.now() - tela.voltou < 15 * 60 * 1000) return; // tela apagada há pouco: espera para julgar\\n  for (const [slug, slot] of liveOpen[i].kick) {\\n    if (!slot.view || Date.now() - slot.openedAt < 15 * 60 * 1000) continue;\\n    const s = kickPts[i][slug];\\n    // sem saldo há 15 min (não dá para conferir) ou saldo parado desde que abriu (sem resgate no meio)\\n    const semDados = !s || !s.at || Date.now() - s.at > 10 * 60 * 1000;\\n    const parado = s && s.inicio != null && s.pts <= s.inicio && Date.now() - s.inicioAt >= 15 * 60 * 1000;\\n    if (semDados || parado) {\\n      kickCompleta[i] = true;\\n      logTravamento(`${nameOf(i)}: player pequeno da Kick não contou pontos em ${slug}; usando a página inteira nesta conta`);\\n      saveLives();\\n      for (const sl of liveOpen[i].kick.values()) closeLive(sl);\\n      liveOpen[i].kick.clear();\\n      syncLives();\\n      return;\\n    }\\n  }\\n}\\nasync function waitForWc(fn, ms) {\\n  const t0 = Date.now();\\n  while (Date.now() - t0 < ms) {\\n    const v = fn();\\n    if (v) return v;\\n    await new Promise((r) => setTimeout(r, 400));\\n  }\\n  return null;\\n}\\n// troca essa conta pro player grande por um instante só pra resgatar, e volta pro pequeno sozinho depois\\n// (não salva essa troca em disco: se o PokeLink fechar no meio, na próxima vez já abre leve de novo).\\n// ---- RESGATE DA KICK PELA API (o mesmo pedido do botão Resgatar do site) ----\\n// Antes o PokeLink precisava estar na \\\"Página inteira\\\" para clicar no painel de pontos: quando a conta\\n// estava no player pequeno ele FECHAVA as lives daquela conta, abria a página inteira do canal, clicava\\n// e reabria tudo. Isso gastava memória, perdia o tempo já assistido das lives fechadas e quebrava toda\\n// vez que a Kick mexia no layout. Agora são três pedidos à API da Kick com o login da conta, feitos de\\n// dentro do player que já está aberto: saldo, lista de bônus e resgate. (Ideia do PokeIdle Deck, MIT.)\\nconst KICK_RESGATAR_API_JS = (slug, chave, custo) => String.raw`(async () => {\\n  const slug = ${JSON.stringify(String(slug))};\\n  const palavra = new RegExp(${JSON.stringify(String(chave))}, 'i');\\n  const alvoCusto = ${Number(custo) || 0};\\n  const tok = decodeURIComponent((document.cookie.match(/(?:^|; )session_token=([^;]+)/) || [])[1] || '');\\n  if (!tok) return { ok: false, erro: 'sem o login da Kick nesta conta' };\\n  const base = 'https://kick.com/api/v2/channels/' + encodeURIComponent(slug);\\n  const call = (caminho, init) => fetch(base + caminho, Object.assign({ cache: 'no-cache', credentials: 'include' }, init, {\\n    headers: Object.assign({ Accept: 'application/json', 'x-app-platform': 'web', Authorization: 'Bearer ' + tok },\\n      init && init.body ? { 'Content-Type': 'application/json' } : {}),\\n  }));\\n  try {\\n    let r = await call('/points');\\n    if (!r.ok) return { ok: false, erro: 'saldo: erro ' + r.status };\\n    const pontos = ((await r.json().catch(() => null)) || {}).data;\\n    const saldo = pontos && typeof pontos.points === 'number' ? pontos.points : null;\\n    r = await call('/rewards');\\n    if (!r.ok) return { ok: false, erro: 'bônus: erro ' + r.status, points: saldo };\\n    const lista = (((await r.json().catch(() => null)) || {}).data) || [];\\n    const livres = lista.filter((x) => x && x.is_enabled !== false && x.is_paused !== true);\\n    const doJogo = (x) => /pokeidle/i.test(String(x.title || '') + ' ' + String(x.description || ''));\\n    const premio = livres.find((x) => palavra.test(String(x.title || '')) && doJogo(x))\\n      || livres.find((x) => Number(x.cost) === alvoCusto && doJogo(x))\\n      || livres.find((x) => palavra.test(String(x.title || '')));\\n    if (!premio) return { ok: false, erro: 'este canal não tem esse bônus', points: saldo };\\n    if (saldo != null && saldo < Number(premio.cost)) {\\n      return { ok: false, erro: 'pontos insuficientes (' + saldo + '/' + premio.cost + ')', points: saldo };\\n    }\\n    // o transaction_id é um ULID novo, do mesmo jeito que o site gera: o tempo em base 32 e mais 16 letras ao acaso\\n    const abc = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';\\n    let t = Date.now(), id = '';\\n    for (let n = 0; n < 10; n++) { id = abc[t % 32] + id; t = Math.floor(t / 32); }\\n    for (let n = 0; n < 16; n++) id += abc[Math.floor(Math.random() * 32)];\\n    r = await call('/rewards/' + premio.id + '/redeem', { method: 'POST', body: JSON.stringify({ transaction_id: id, message: '' }) });\\n    if (r.ok) return { ok: true, titulo: premio.title, custo: Number(premio.cost), points: saldo };\\n    return { ok: false, erro: 'a Kick recusou (erro ' + r.status + ')', points: saldo };\\n  } catch (e) { return { ok: false, erro: 'sem resposta da Kick: ' + (e && e.message || e) }; }\\n})()`;\\n// Qualquer página da Kick já aberta nesta conta serve para o pedido (ele pergunta pelo canal, não depende\\n// de estar na página dele). Sem nenhuma aberta, não força nada: cai no caminho antigo.\\nfunction kickPaginaDaConta(i) {\\n  for (const [, sl] of liveOpen[i].kick) {\\n    const w = sl.view && sl.view.webContents;\\n    if (w && !w.isDestroyed() && !w.isLoading() && String(w.getURL()).includes('kick.com')) return w;\\n  }\\n  return null;\\n}\\nasync function kickResgatarLeve(i, slug, valor) {\\n  const meta = KICK_GOALS.find((g) => g.pts === valor);\\n  // 1) pela API, de dentro de uma página da Kick que já está aberta nesta conta: não fecha live nenhuma\\n  const wcApi = meta && kickPaginaDaConta(i);\\n  if (wcApi) {\\n    let r = null;\\n    try { r = await withTimeout(wcApi.executeJavaScript(KICK_RESGATAR_API_JS(slug, meta.chave, meta.pts)), 20000); } catch (e) { r = { ok: false, erro: e.message }; }\\n    if (r && r.ok) {\\n      marcarResgate('kick', i, slug, valor);\\n      logResgate('kick', i, slug, `resgatei ${r.titulo || meta.nome} por ${r.custo || valor} pontos`);\\n      const st = kickPts[i][slug];\\n      if (st && st.pts != null) { st.pts = Math.max(0, st.pts - (r.custo || valor)); st.base = st.pts; st.baseAt = Date.now(); st.avisado = {}; }\\n      return r;\\n    }\\n    // sem pontos não adianta tentar pelo clique (e nem vale fechar as lives por isso)\\n    if (r && /insuficiente/i.test(String(r.erro || ''))) {\\n      logResgate('kick', i, slug, `o resgate de ${valor} pontos não deu certo (${r.erro})`, 'problema');\\n      return r;\\n    }\\n    if (r && r.erro) logResgate('kick', i, slug, `a API da Kick recusou (${r.erro}); tentando pelo painel`, 'problema');\\n  }\\n  // 2) plano B: o jeito antigo, clicando no painel da página inteira\\n  const jaCompleta = kickPlayer === 'completa' || kickCompleta[i];\\n  if (jaCompleta) {\\n    const slot = liveOpen[i].kick.get(slug);\\n    const wc = slot && slot.view && slot.view.webContents;\\n    const r = await kickResgatar(wc, valor);\\n    if (r && r.ok) { marcarResgate('kick', i, slug, valor); logResgate('kick', i, slug, `resgatei o bônus de ${valor} pontos`); }\\n    else logResgate('kick', i, slug, `o resgate de ${valor} pontos não deu certo (${(r && r.erro) || 'sem resposta'})`, 'problema');\\n    return r;\\n  }\\n  kickCompleta[i] = true;\\n  for (const sl of liveOpen[i].kick.values()) closeLive(sl);\\n  liveOpen[i].kick.clear();\\n  syncLives();\\n  const voltarProPequeno = () => {\\n    kickCompleta[i] = false;\\n    for (const sl of liveOpen[i].kick.values()) closeLive(sl);\\n    liveOpen[i].kick.clear();\\n    syncLives();\\n  };\\n  const wc = await waitForWc(() => {\\n    const slot = liveOpen[i].kick.get(slug);\\n    return slot && slot.view && !slot.view.webContents.isDestroyed() && !slot.view.webContents.isLoading() ? slot.view.webContents : null;\\n  }, 25000);\\n  if (!wc) { voltarProPequeno(); return { ok: false, erro: 'não consegui abrir a página inteira a tempo' }; }\\n  await new Promise((r) => setTimeout(r, 2000)); // dá um tempo pro chat e os pontos renderizarem\\n  const resultado = await kickResgatar(wc, valor);\\n  voltarProPequeno();\\n  if (resultado && resultado.ok) { marcarResgate('kick', i, slug, valor); logResgate('kick', i, slug, `resgatei o bônus de ${valor} pontos`); }\\n  else logResgate('kick', i, slug, `o resgate de ${valor} pontos não deu certo (${(resultado && resultado.erro) || 'sem resposta'})`, 'problema');\\n  return resultado;\\n}\\n// Resgata um bônus da Kick sozinho (sem abrir janela), clicando pela própria conexão da live que já está\\n// aberta. Só funciona na \\\"Página inteira\\\" (é lá que fica o painel de pontos, embaixo do chat).\\nasync function kickResgatar(wc, valor) {\\n  const meta = KICK_GOALS.find((g) => g.pts === valor);\\n  if (!wc || wc.isDestroyed() || !meta) return { ok: false, erro: 'conta ou meta inválida' };\\n  if (wc.getURL().includes('player.kick.com')) return { ok: false, erro: 'essa conta está no \\\"Player pequeno\\\"; precisa estar na \\\"Página inteira\\\" pra resgatar sozinho' };\\n  try {\\n    const r = await withTimeout(wc.executeJavaScript(String.raw`(async () => {\\n      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n      const waitFor = async (fn, ms) => { const t0 = Date.now(); while (Date.now() - t0 < ms) { const v = fn(); if (v) return v; await sleep(200); } return null; };\\n      const clicar = (el) => {\\n        const r = el.getBoundingClientRect();\\n        const opts = { bubbles: true, cancelable: true, view: window, clientX: r.x + r.width / 2, clientY: r.y + r.height / 2 };\\n        el.dispatchEvent(new PointerEvent('pointerdown', opts));\\n        el.dispatchEvent(new MouseEvent('mousedown', opts));\\n        el.dispatchEvent(new PointerEvent('pointerup', opts));\\n        el.dispatchEvent(new MouseEvent('mouseup', opts));\\n        el.dispatchEvent(new MouseEvent('click', opts));\\n      };\\n      const re = new RegExp(${JSON.stringify(meta.chave)}, 'i');\\n      const btnPontos = document.querySelector('[data-testid=\\\"channel-points-button\\\"]');\\n      if (!btnPontos) return { ok: false, erro: 'não achei o botão de pontos na página' };\\n      clicar(btnPontos);\\n      const alvo = await waitFor(() => [...document.querySelectorAll('button')].find((b) => re.test(b.textContent || '')), 4000);\\n      if (!alvo) { try { clicar(btnPontos); } catch {} return { ok: false, erro: 'não achei essa recompensa (pode faltar pontos ainda)' }; }\\n      clicar(alvo);\\n      const confirmar = await waitFor(() => [...document.querySelectorAll('button')].find((b) => /^resgatar$/i.test((b.textContent || '').trim())), 4000);\\n      if (!confirmar) {\\n        try { clicar(btnPontos); } catch {}\\n        const semPontos = alvo.disabled || alvo.getAttribute('aria-disabled') === 'true' || /disabled|opacity-50|cursor-not-allowed/i.test(alvo.className || '');\\n        return { ok: false, erro: semPontos ? 'parece que não tem pontos suficientes pra esse bônus agora' : 'não achei o botão de confirmar' };\\n      }\\n      clicar(confirmar);\\n      await sleep(1200);\\n      try { clicar(btnPontos); } catch {} // fecha o painel de novo\\n      return { ok: true };\\n    })()`), 15000);\\n    return r || { ok: false, erro: 'sem resposta da página' };\\n  } catch (e) { return { ok: false, erro: e.message }; }\\n}\\n\\nasync function pollKickPoints() {\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    for (const [slug, slot] of liveOpen[i].kick) {\\n      const wc = slot.view && slot.view.webContents;\\n      if (!wc || wc.isDestroyed() || wc.isLoading()) continue;\\n      let r = null;\\n      const n = await saldoKick(i, slug); // 1º: direto na Kick\\n      if (n != null) {\\n        try { r = await withTimeout(wc.executeJavaScript(KICK_TOCANDO_JS), 4000); } catch {}\\n        r = Object.assign(r || {}, { points: n, via: 'kick' });\\n      } else if (!wc.getURL().includes('player.kick.com')) {\\n        try { r = await withTimeout(wc.executeJavaScript(KICK_POINTS_JS), 8000); } catch {} // 2º: de dentro da página inteira\\n      } else {\\n        try { r = await withTimeout(wc.executeJavaScript(KICK_TOCANDO_JS), 4000); } catch {}\\n      }\\n      if (r) liveStatus.set(`${i}|${slug}`, { tocando: !!r.tocando, visivel: r.visivel, at: Date.now() });\\n      if (!r || r.points == null) continue;\\n      const now = Date.now();\\n      const s = kickPts[i][slug] || { base: r.points, baseAt: now, avisado: {} };\\n      if (r.points < (s.pts ?? r.points)) { s.base = r.points; s.baseAt = now; s.avisado = {}; } // resgatou: recomeça a contagem\\n      s.pts = r.points; s.at = now; s.via = r.via;\\n      // ponto de partida para conferir se o player pequeno está rendendo (zera ao reabrir ou resgatar)\\n      if (s.inicioSlot !== slot.openedAt || r.points < (s.inicio ?? r.points)) { s.inicio = r.points; s.inicioAt = now; s.inicioSlot = slot.openedAt; }\\n      kickPts[i][slug] = s;\\n      conferirDevolucao('kick', i, slug, s, r.points);\\n      conferirLiveParada('kick', i, slug, slot, s, r.points);\\n      // avisa quando cruza 300 / 500 / 1.000\\n      const meta = [...KICK_GOALS].reverse().find((g) => r.points >= g.pts && !s.avisado[g.pts]);\\n      if (meta) {\\n        KICK_GOALS.forEach((g) => { if (r.points >= g.pts) s.avisado[g.pts] = true; });\\n        if (!kickAutoResgate) kickGoalAlert(i, slug, r.points, meta); // com Auto Resgate ligado, resgata em vez de avisar\\n      }\\n      // Auto Resgate: tenta sozinho a maior meta marcada que já der pra pegar\\n      const chave = `${i}|${slug}`;\\n      if (kickAutoResgate && !resgatePausado.kick[i] && !kickResgatando.has(chave)) {\\n        const alvo = [...KICK_GOALS].reverse().find((g) => kickResgateTiers[g.pts] && r.points >= g.pts);\\n        if (alvo) {\\n          kickResgatando.add(chave);\\n          kickResgatarLeve(i, slug, alvo.pts).finally(() => kickResgatando.delete(chave));\\n        }\\n      }\\n    }\\n  }\\n  for (let i = 0; i < ACCOUNTS.length; i++) if (lives.kick[i]) { conferirPlayerKick(i); await pollKickAll(i); }\\n  if (kickWin && !kickWin.isDestroyed()) kickWin.webContents.send('kick-update');\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('kick-update'); // painel da barra\\n}\\nasync function kickGoalAlert(i, slug, pts, meta) {\\n  avisoCelular('kick', `${pts.toLocaleString('pt-BR')} pontos na Kick`, `${nameOf(i)} · ${slug}: já dá para resgatar ${meta.nome}.`);\\n  if (!kickAvisos) return; // avisos desligados (a meta continua marcada, então não acumula avisos)\\n  const r = await uiDialog({\\n    type: 'info',\\n    title: 'Pontos da Kick',\\n    message: `${nameOf(i)}: ${pts.toLocaleString('pt-BR')} pontos em ${slug}`,\\n    detail: `Já dá para resgatar ${meta.nome} (${meta.pts.toLocaleString('pt-BR')} pontos). ` +\\n      'O resgate é feito na live: abra os pontos do canal (embaixo do chat) e escolha o bônus. Em segundos ele aparece no jogo.',\\n    buttons: ['Resgatar na live', 'Depois'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (r.response === 0) openLivePage(i, 'kick', slug);\\n}\\n// leva até o resgate: amplia a conta e abre o painel \\\"Bônus na Kick\\\" do jogo\\nasync function openKickRedeem(i) {\\n  setFocus(i);\\n  if (win) win.focus();\\n  const wc = views[i] && views[i].webContents;\\n  if (!wc || wc.isDestroyed()) return;\\n  const ok = await withTimeout(wc.executeJavaScript(`(() => {\\n    const b = document.querySelector('button.tr-ativo.kick') ||\\n      [...document.querySelectorAll('button,[role=button]')].find((e) => /kick/i.test((e.getAttribute('aria-label') || '') + ' ' + (e.textContent || '')));\\n    if (b) b.click(); return !!b;\\n  })()`), 3000).catch(() => false);\\n  if (!ok) uiDialog({ type: 'info', title: 'Pontos da Kick', message: 'Abra o painel \\\"Bônus na Kick\\\" no jogo para resgatar.', detail: 'Não achei o botão da Kick no painel do treinador desta conta.' });\\n}\\n\\nfunction kickState() {\\n  return {\\n    atualizado: kickAtualizado ? new Date(kickAtualizado).toLocaleTimeString('pt-BR') : '',\\n    avisos: kickAvisos,\\n    autoResgate: kickAutoResgate,\\n    resgateTiers: kickResgateTiers,\\n    kickPlayer,\\n    goals: KICK_GOALS,\\n    poll: KICK_POLL_SEC,\\n    removidos: listaCanais().find((x) => x.p === 'kick').removidos,\\n    contas: ACCOUNTS.map((_, i) => ({\\n      i, name: nameOf(i), on: !!lives.kick[i],\\n      sel: kickSel[i],\\n      todos: LIVE_CHANNELS.kick.map((slug) => ({\\n        slug, live: liveNow.kick.has(slug), sel: kickSel[i].includes(slug),\\n        pts: kickPts[i][slug] && kickPts[i][slug].pts != null ? kickPts[i][slug].pts : (kickAll[i][slug] ?? null),\\n      })),\\n      canais: [...liveOpen[i].kick.keys()].map((slug) => {\\n        const s = kickPts[i][slug];\\n        const horas = s && s.at > s.baseAt ? (s.at - s.baseAt) / 36e5 : 0;\\n        const st = liveStatus.get(`${i}|${slug}`);\\n        const slot = liveOpen[i].kick.get(slug);\\n        return { slug, pts: s ? s.pts : null, via: s ? s.via : null, at: s ? s.at : 0, tocando: st ? st.tocando : null,\\n          aberta: slot && slot.view ? slot.openedAt : 0,\\n          // aberta há 20+ min e o saldo não subiu nada desde a 1ª leitura = não está rendendo\\n          semRender: !!(slot && slot.view && Date.now() - slot.openedAt > 20 * 60 * 1000 && s && s.pts != null && s.pts === s.base && Date.now() - s.baseAt > 15 * 60 * 1000),\\n          porHora: horas >= 0.1 ? Math.round((s.pts - s.base) / horas) : null };\\n      }),\\n    })),\\n  };\\n}\\nipcMain.handle('kick-get', () => kickState());\\n// botão \\\"Atualizar\\\" do painel da Kick: confere na hora quem está ao vivo e o saldo de TODOS os canais\\n// (antes o saldo dos canais fechados só era relido a cada 15 min, então o botão parecia não fazer nada)\\nlet kickAtualizado = 0;\\nipcMain.handle('kick-refresh', async () => {\\n  try { await withTimeout(discoverChannels(), 8000); } catch {}\\n  kickAllAt.fill(0); // força reler o saldo dos canais que não estão abertos\\n  try { await withTimeout(pollKickPoints(), 60000); } catch {}\\n  kickAtualizado = Date.now();\\n  return kickState();\\n});\\nipcMain.on('kick-redeem', (_, i) => { if (Number.isInteger(i) && i >= 0 && i < ACCOUNTS.length) openKickRedeem(i); });\\nipcMain.on('kick-redeem-live', async (_, i, slug) => {\\n  slug = String(slug);\\n  const chave = `${i}|${slug}`;\\n  const pts = kickPts[i] && kickPts[i][slug] && kickPts[i][slug].pts;\\n  const alvo = [...KICK_GOALS].reverse().find((g) => kickResgateTiers[g.pts] && pts >= g.pts);\\n  if (alvo && !kickResgatando.has(chave)) {\\n    kickResgatando.add(chave);\\n    const r = await kickResgatarLeve(i, slug, alvo.pts).finally(() => kickResgatando.delete(chave));\\n    if (r.ok) return; // resgatou sozinho, sem precisar abrir nada\\n  }\\n  openLivePage(i, 'kick', slug); // não deu pra resgatar sozinho: abre a janela pra você resgatar na mão\\n});\\n// escolher/desmarcar um canal para farmar\\nipcMain.on('kick-sel', (_, i, slug) => {\\n  if (!Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return;\\n  slug = String(slug).toLowerCase();\\n  if (!LIVE_CHANNELS.kick.includes(slug)) return;\\n  const k = kickSel[i].indexOf(slug);\\n  if (k >= 0) kickSel[i].splice(k, 1); else kickSel[i].push(slug);\\n  saveLives();\\n  syncLives();\\n  if (kickWin && !kickWin.isDestroyed()) kickWin.webContents.send('kick-update');\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('kick-update'); // painel da barra\\n});\\nipcMain.on('kick-open', (e, i, rect) => {\\n  if (!Number.isInteger(i)) return;\\n  // moedinha da barra: os pontos descem do botão como um painel (desenhado pela barra de título)\\n  const bi = bars.findIndex((b) => b.webContents === e.sender);\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (!canDraw || bi < 0 || !rect) { openKickWin(); return; }\\n  const b = bars[bi].getBounds();\\n  const id = ++cfgPanelSeq;\\n  cfgPanels.add(id);\\n  dialogOpen = true;\\n  layout();\\n  titleBar.webContents.focus();\\n  titleBar.webContents.send('title-kick', {\\n    id, conta: i, x: b.x + Math.round(rect.left) - 8, y: b.y + Math.round(rect.bottom) + 4, up: b.y + Math.round(rect.top) - 4,\\n  });\\n  pollKickPoints();\\n});\\nipcMain.on('otimizar-open', (e, i, rect) => {\\n  if (!Number.isInteger(i)) return;\\n  const bi = bars.findIndex((b) => b.webContents === e.sender);\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (!canDraw || bi < 0 || !rect) return;\\n  const b = bars[bi].getBounds();\\n  const id = ++cfgPanelSeq;\\n  cfgPanels.add(id);\\n  dialogOpen = true;\\n  layout();\\n  titleBar.webContents.focus();\\n  titleBar.webContents.send('title-otimizar', {\\n    id, conta: i, x: b.x + Math.round(rect.left) - 8, y: b.y + Math.round(rect.bottom) + 4, up: b.y + Math.round(rect.top) - 4,\\n  });\\n});\\nipcMain.handle('kick-diag', async () => {\\n  // diagnóstico: o que a página da Kick mostra perto do chat (para ajustar a leitura dos pontos)\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    for (const [slug, slot] of liveOpen[i].kick) {\\n      const wc = slot.view && slot.view.webContents;\\n      if (!wc || wc.isDestroyed()) continue;\\n      const dump = await withTimeout(wc.executeJavaScript(`(async () => {\\n        const slug = ${JSON.stringify(slug)};\\n        const tok = decodeURIComponent((document.cookie.match(/(?:^|; )session_token=([^;]+)/) || [])[1] || '');\\n        const h = { Accept: 'application/json' }; if (tok) h.Authorization = 'Bearer ' + tok;\\n        const api = {};\\n        for (const u of ['/api/v2/channels/' + slug + '/me', '/api/v2/channels/' + slug + '/points']) {\\n          try { const r = await fetch(u, { headers: h, credentials: 'include' }); api[u] = r.status + ' ' + (await r.text()).slice(0, 3000); } catch (e) { api[u] = 'erro ' + e.message; }\\n        }\\n        const rot = [...document.querySelectorAll('[aria-label],[title],[data-testid]')].map((e) => e.tagName + ' | ' + [e.getAttribute('aria-label'), e.getAttribute('title'), e.getAttribute('data-testid')].filter(Boolean).join(' | ') + ' | ' + (e.textContent || '').trim().slice(0, 40)).slice(0, 400);\\n        const chat = document.querySelector('#chatroom-footer, [id*=chat] footer, [class*=chat-input], [class*=ChatInput]');\\n        const videos = [...document.querySelectorAll('video')].map((v) => ({ paused: v.paused, muted: v.muted, readyState: v.readyState, t: v.currentTime }));\\n        return { url: location.href, logado: !!tok, visivel: document.visibilityState, videos, api, rotulos: rot, chat: chat ? chat.outerHTML.slice(0, 8000) : null };\\n      })()`), 15000).catch((e) => ({ erro: e.message }));\\n      const f = path.join(app.getPath('desktop'), 'kick-diagnostico.json');\\n      try { fs.writeFileSync(f, JSON.stringify({ versao: APP_VERSION, conta: nameOf(i), slug, dump }, null, 1)); } catch { return null; }\\n      return f;\\n    }\\n  }\\n  return '';\\n});\\n\\n// janela \\\"Resgate\\\" (pontos em tempo real)\\nlet kickWin = null;\\nfunction openKickWin() {\\n  if (kickWin && !kickWin.isDestroyed()) { kickWin.show(); kickWin.focus(); return; }\\n  kickWin = new BrowserWindow({\\n    width: 980, height: 760, minWidth: 640, minHeight: 480, title: 'Pontos da Kick — PokeLink',\\n    backgroundColor: '#141417', autoHideMenuBar: true,\\n    titleBarStyle: 'hidden', titleBarOverlay: { color: TITLE_BG, symbolColor: TITLE_FG, height: TITLE_H },\\n    ...(customIconPath() ? { icon: customIconPath() } : {}),\\n    webPreferences: { preload: path.join(__dirname, 'preload.js') },\\n  });\\n  kickWin.setMenu(null);\\n  kickWin.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'kick' } });\\n  kickWin.on('closed', () => { kickWin = null; });\\n  pollKickPoints();\\n}\\n\\n// ================= Registro dos resgates, devolução e live parada (Kick e Twitch) =================\\n// Três coisas que faltavam nas lives e que só se descobre deixando rodar a noite inteira:\\n// 1) um REGISTRO do que aconteceu (resgates, baús, recusas), para dar para conferir depois;\\n// 2) perceber quando o PokeIdle DEVOLVE os pontos (acontece quando a Kick/Twitch não está vinculada na\\n//    conta do jogo): sem isso o PokeLink ficaria resgatando para sempre sem nenhum bônus entrar;\\n// 3) perceber a live que está aberta e \\\"tocando\\\" mas NÃO está rendendo ponto nenhum, e recarregar ela.\\n// Ideia 1 e 2 vistas no PokeIdle Deck (artbruno35, MIT).\\nconst resgatesFile = () => path.join(app.getPath('userData'), 'resgates.log');\\nconst resgatesMem = [];       // as últimas linhas, para o Diagnóstico (o arquivo guarda tudo)\\nlet resgatesEscritas = 0;\\nfunction logResgate(plat, i, slug, texto, nivel) {\\n  logEvento(nivel || 'ok', i, plat, slug, texto);\\n  const linha = `${new Date().toLocaleString('pt-BR')} · ${plat === 'twitch' ? 'Twitch' : 'Kick'} · ${nameOf(i)} · ${slug}: ${texto}`;\\n  resgatesMem.unshift(linha);\\n  if (resgatesMem.length > 200) resgatesMem.length = 200;\\n  try {\\n    const f = resgatesFile();\\n    // o arquivo não cresce para sempre: passando de 1 MB, fica só a metade mais nova\\n    if (++resgatesEscritas % 50 === 0) {\\n      try {\\n        if (fs.statSync(f).size > 1024 * 1024) {\\n          const t = fs.readFileSync(f, 'utf8');\\n          fs.writeFileSync(f, t.slice(Math.floor(t.length / 2)).replace(/^[^\\\\n]*\\\\n/, ''));\\n        }\\n      } catch {}\\n    }\\n    fs.appendFileSync(f, linha + '\\\\n');\\n  } catch {}\\n}\\n// ---- pontos devolvidos: a plataforma não está vinculada NAQUELA conta do jogo ----\\n// Depois de um resgate, o saldo só pode subir devagar (10 pontos a cada 5 min, mais os baús). Se em até\\n// 30 minutos ele volta para perto do que era ANTES do resgate, o PokeIdle devolveu: o bônus não entrou.\\nconst DEVOLUCAO_MS = 30 * 60 * 1000;\\nconst resgatePausado = { kick: ACCOUNTS.map(() => null), twitch: ACCOUNTS.map(() => null) };\\nfunction marcarResgate(plat, i, slug, custo) {\\n  const st = (plat === 'twitch' ? twitchPts : kickPts)[i][slug];\\n  if (!st) return;\\n  st.resgAt = Date.now();\\n  st.resgCusto = custo;\\n  // o saldo logo DEPOIS do resgate (o st.pts ainda é o de antes quando esta função é chamada)\\n  st.resgSaldo = Math.max(0, (st.pts || 0) - custo);\\n}\\nfunction conferirDevolucao(plat, i, slug, st, pts) {\\n  if (!st || !st.resgAt || !st.resgCusto) return;\\n  if (Date.now() - st.resgAt > DEVOLUCAO_MS) { st.resgAt = 0; return; }\\n  // metade do custo de folga: é muito mais do que assistir rende nesse tempo\\n  if (pts < (st.resgSaldo || 0) + Math.floor(st.resgCusto / 2)) return;\\n  st.resgAt = 0;\\n  if (resgatePausado[plat][i]) return;\\n  const nome = plat === 'twitch' ? 'Twitch' : 'Kick';\\n  resgatePausado[plat][i] = `os pontos do resgate voltaram (a ${nome} não está vinculada nesta conta do jogo?)`;\\n  logResgate(plat, i, slug, `os pontos do último resgate VOLTARAM (saldo ${pts}); parei de resgatar nesta conta`, 'problema');\\n  logTravamento(`${nameOf(i)}: o resgate da ${nome} não entrou no jogo e os pontos voltaram; parei de resgatar nesta conta`);\\n  avisoCelular(plat, `Resgate da ${nome} não entrou`, `${nameOf(i)}: vincule a ${nome} no jogo (Bônus) e ligue o Auto Resgate de novo.`);\\n  if (plat === 'twitch') twitchSaldoInfo = `${nameOf(i)}: ${resgatePausado.twitch[i]}`;\\n  // isto precisa chegar em você: sem vincular, TODO ponto gasto é jogado fora\\n  uiDialog({\\n    type: 'warning',\\n    title: `Resgate da ${nome} não entrou no jogo`,\\n    message: `${nameOf(i)}: resgatei o bônus em ${slug}, mas os pontos voltaram.`,\\n    detail: `Isso acontece quando a ${nome} não está vinculada NESTA conta do PokeIdle. Abra o jogo nesta conta, ` +\\n      `vincule a ${nome} na parte de bônus e depois ligue o Auto Resgate de novo (é o que faz o PokeLink voltar a resgatar). ` +\\n      'Até lá parei de resgatar nesta conta para não jogar pontos fora.',\\n    buttons: ['Entendi'],\\n  }).catch(() => {});\\n}\\n// liga de novo (ao mexer no Auto Resgate, depois de vincular no jogo)\\nfunction voltarAResgatar(plat) {\\n  for (let i = 0; i < ACCOUNTS.length; i++) resgatePausado[plat][i] = null;\\n}\\n// ---- live aberta que não rende ponto nenhum ----\\n// O vídeo pode estar \\\"tocando\\\" e mesmo assim não contar (anúncio sem fim, sessão expirada, a plataforma\\n// parou de contar). A prova de verdade é o SALDO SUBIR. Sem subir em 20 minutos, recarrega aquela live.\\nconst PARADA_MS = 20 * 60 * 1000;\\nfunction conferirLiveParada(plat, i, slug, slot, st, pts) {\\n  if (!st) return;\\n  if (st.ptsVistos == null || pts > st.ptsVistos) { st.ptsVistos = pts; st.mudouAt = Date.now(); return; }\\n  if (pts < st.ptsVistos) { st.ptsVistos = pts; st.mudouAt = Date.now(); return; } // resgatou\\n  if (!st.mudouAt) { st.mudouAt = Date.now(); return; }\\n  const aberta = Date.now() - (slot.openedAt || Date.now());\\n  if (Date.now() - st.mudouAt < PARADA_MS || aberta < PARADA_MS) return;\\n  if (st.recarregadaAt && Date.now() - st.recarregadaAt < PARADA_MS) return;\\n  const wc = slot.view && slot.view.webContents;\\n  if (!wc || wc.isDestroyed() || wc.isLoading()) return;\\n  st.recarregadaAt = Date.now();\\n  st.mudouAt = Date.now();\\n  st.recargas = (st.recargas || 0) + 1;\\n  // Modo player: se depois de 2 recargas aquela conta continua sem ganhar ponto, o player não está\\n  // contando nela. Volta sozinha para a página do canal e fica assim (o usuário não escolhe nada).\\n  if (plat === 'twitch' && st.recargas >= 2 && modoTw(i) === 'player' && !twPlayerFalhou[i]) {\\n    twPlayerFalhou[i] = true;\\n    st.recargas = 0;\\n    logEvento('problema', i, 'twitch', slug, 'o player sozinho não rendeu pontos nesta conta; voltei para a página do canal');\\n    logTravamento(`${nameOf(i)}: o player da Twitch não rendeu pontos; voltando para a página do canal`);\\n    reabrirTwitch(i);\\n    return;\\n  }\\n  logResgate(plat, i, slug, `sem ganhar ponto nenhum há 20 min (saldo parado em ${pts}); recarreguei a live`, 'problema');\\n  try { wc.reload(); } catch {}\\n}\\n\\n// ================= Histórico das lives =================\\n// Tudo o que acontece com as lives num lugar só, para dar para olhar depois e entender a noite inteira:\\n// live que parou, que voltou, que acabou, resgate, baú, recusa e pontos devolvidos. Fica guardado entre\\n// uma aberta e outra do PokeLink (historico.json) e aparece no painel do botão 🕘 da barra de baixo.\\nconst HIST_MAX = 300;                 // o mais novo primeiro\\nconst eventos = [];\\nconst histFile = () => path.join(app.getPath('userData'), 'historico.json');\\nlet histTimer = null;\\nlet histVistoAt = 0;                  // até quando você já olhou (o restante conta como \\\"novo\\\")\\nfunction loadHistorico() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(histFile(), 'utf8'));\\n    if (Array.isArray(j.eventos)) eventos.push(...j.eventos.filter((e) => e && e.at && e.texto).slice(0, HIST_MAX));\\n    if (Number.isFinite(j.vistoAt)) histVistoAt = j.vistoAt;\\n  } catch {}\\n}\\nfunction salvarHistorico() {\\n  clearTimeout(histTimer);\\n  histTimer = setTimeout(() => {\\n    try { fs.writeFileSync(histFile(), JSON.stringify({ eventos: eventos.slice(0, HIST_MAX), vistoAt: histVistoAt })); } catch {}\\n  }, 3000);\\n}\\nconst histHoje = () => { const d = new Date(); d.setHours(0, 0, 0, 0); return eventos.filter((e) => e.at >= d.getTime()); };\\nconst histProblemasHoje = () => histHoje().filter((e) => e.nivel === 'problema').length;\\nconst histNovos = () => eventos.filter((e) => e.at > histVistoAt).length;\\n// nivel: 'problema' (atenção), 'ok' (deu certo) ou 'info'\\nfunction logEvento(nivel, i, plat, slug, texto) {\\n  const ev = {\\n    at: Date.now(), nivel: nivel === 'problema' || nivel === 'ok' ? nivel : 'info',\\n    conta: Number.isInteger(i) ? nameOf(i) : null, plat: plat || null, slug: slug || null, texto: String(texto),\\n  };\\n  // o mesmo aviso repetido em menos de 1 minuto não entra duas vezes\\n  const ant = eventos[0];\\n  if (ant && ant.texto === ev.texto && ant.conta === ev.conta && ev.at - ant.at < 60 * 1000) return;\\n  eventos.unshift(ev);\\n  if (eventos.length > HIST_MAX) eventos.length = HIST_MAX;\\n  salvarHistorico();\\n  mandarHistorico();\\n}\\nfunction mandarHistorico() {\\n  const d = { novos: histNovos(), problemas: histProblemasHoje() };\\n  for (const w of [histWin, titleBar && { webContents: titleBar.webContents }, bottomBar && { webContents: bottomBar.webContents }]) {\\n    try { if (w && w.webContents && !w.webContents.isDestroyed()) w.webContents.send('historico-update', d); } catch {}\\n  }\\n}\\nfunction historicoState() {\\n  return {\\n    eventos: eventos.slice(0, HIST_MAX),\\n    problemas: histProblemasHoje(),\\n    total: eventos.length,\\n    problemasTotal: eventos.filter((e) => e.nivel === 'problema').length,\\n    novos: histNovos(),\\n    vistoAt: histVistoAt,\\n  };\\n}\\nlet histWin = null;\\nfunction openHistoricoWin() {\\n  if (histWin && !histWin.isDestroyed()) { histWin.show(); histWin.focus(); return; }\\n  histWin = new BrowserWindow({\\n    width: 720, height: 680, minWidth: 460, minHeight: 380, title: 'Histórico das lives — PokeLink',\\n    backgroundColor: '#141417', autoHideMenuBar: true,\\n    titleBarStyle: 'hidden', titleBarOverlay: { color: TITLE_BG, symbolColor: TITLE_FG, height: TITLE_H },\\n    ...(customIconPath() ? { icon: customIconPath() } : {}),\\n    webPreferences: { preload: path.join(__dirname, 'preload.js') },\\n  });\\n  histWin.setMenu(null);\\n  histWin.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'historico' } });\\n  histWin.on('closed', () => { histWin = null; });\\n  histVistoAt = Date.now(); // abriu: nada mais está \\\"novo\\\"\\n  salvarHistorico();\\n  mandarHistorico();\\n}\\nipcMain.on('historico-open', () => openHistoricoWin());\\nipcMain.handle('historico-get', () => historicoState());\\nipcMain.on('historico-limpar', () => { eventos.length = 0; histVistoAt = Date.now(); salvarHistorico(); mandarHistorico(); });\\nipcMain.on('historico-visto', () => { histVistoAt = Date.now(); salvarHistorico(); mandarHistorico(); });\\n\\n// ---- QUALIDADE DO VÍDEO DA TWITCH: a menor que o canal tiver, de verdade ----\\n// Pedir 160p pelo player não adianta: a Twitch ignora e sobe para 1080p (visto no diagnóstico). O jeito\\n// que funciona é mexer na LISTA de qualidades. Antes de começar o vídeo, o player baixa uma lista\\n// (um arquivo .m3u8 do usher.ttvnw.net) com uma linha por qualidade; o PokeLink pega essa lista no\\n// caminho e devolve ao player uma lista com UMA qualidade só, a mais fraca que ainda tem imagem.\\n// O player não tem como subir, porque nem sabe que existe outra, e a live continua tocando — que é a\\n// única coisa que conta ponto. Ideia vista no PokeIdle Deck (artbruno35, código aberto MIT).\\n// Linhas só de áudio ficam de fora de propósito: sem imagem a Twitch não conta nada.\\nfunction soMenorQualidade(texto) {\\n  const linhas = String(texto).replace(/\\\\r\\\\n/g, '\\\\n').split('\\\\n');\\n  if (!linhas.length || !linhas[0].startsWith('#EXTM3U')) return null;\\n  const ficam = [];\\n  const ops = [];\\n  for (let n = 0; n < linhas.length; n++) {\\n    const l = linhas[n];\\n    if (!l.startsWith('#EXT-X-STREAM-INF:')) { if (l.length) ficam.push(l); continue; }\\n    let k = n + 1;\\n    while (k < linhas.length && (!linhas[k].length || linhas[k].startsWith('#'))) k++;\\n    if (k >= linhas.length) break;\\n    const m = l.match(/(?:^|[,:])BANDWIDTH=(\\\\d+)/); // sem pegar o AVERAGE-BANDWIDTH\\n    ops.push({ banda: m ? Number(m[1]) : Infinity, video: /RESOLUTION=/.test(l), info: l, url: linhas[k] });\\n    n = k;\\n  }\\n  const comVideo = ops.filter((o) => o.video);\\n  if (comVideo.length < 2) return null; // uma só: não há o que escolher, deixa passar do jeito que veio\\n  const menor = comVideo.reduce((a, b) => (b.banda < a.banda ? b : a));\\n  ficam.push(menor.info, menor.url);\\n  return ficam.join('\\\\n') + '\\\\n';\\n}\\nlet twQualidadeInfo = ''; // o que aconteceu na última lista (aparece no Diagnóstico)\\nfunction twitchQualidadeMinima(wc) {\\n  try {\\n    wc.debugger.sendCommand('Fetch.enable', {\\n      patterns: [{ urlPattern: '*usher.ttvnw.net*', requestStage: 'Response' }],\\n    }).catch((e) => { twQualidadeInfo = 'não consegui ligar: ' + e.message; });\\n  } catch (e) { twQualidadeInfo = 'não consegui ligar: ' + e.message; return; }\\n  wc.debugger.on('message', async (_e, metodo, p) => {\\n    if (metodo !== 'Fetch.requestPaused' || !p || !p.requestId) return;\\n    const id = p.requestId;\\n    const seguir = () => wc.debugger.sendCommand('Fetch.continueRequest', { requestId: id }).catch(() => {});\\n    try {\\n      const url = (p.request && p.request.url) || '';\\n      if (!/usher\\\\.ttvnw\\\\.net/.test(url) || !/\\\\.m3u8/.test(url) || p.responseStatusCode !== 200) return seguir();\\n      const r = await wc.debugger.sendCommand('Fetch.getResponseBody', { requestId: id });\\n      const corpo = r.base64Encoded ? Buffer.from(r.body, 'base64').toString('utf8') : String(r.body || '');\\n      const menor = soMenorQualidade(corpo);\\n      if (!menor) { twQualidadeInfo = 'a lista veio com uma qualidade só'; return seguir(); }\\n      const origem = ((p.request.headers || {}).Origin) || ((p.request.headers || {}).origin) || '*';\\n      await wc.debugger.sendCommand('Fetch.fulfillRequest', {\\n        requestId: id,\\n        responseCode: 200,\\n        responseHeaders: [\\n          { name: 'content-type', value: 'application/vnd.apple.mpegurl' },\\n          { name: 'cache-control', value: 'no-cache' },\\n          { name: 'access-control-allow-origin', value: origem },\\n          { name: 'access-control-allow-credentials', value: 'true' },\\n          { name: 'vary', value: 'Origin' },\\n        ],\\n        body: Buffer.from(menor, 'utf8').toString('base64'),\\n      });\\n      const res = (menor.match(/RESOLUTION=(\\\\d+x\\\\d+)/) || [])[1] || '?';\\n      twQualidadeInfo = 'menor qualidade entregue ao player: ' + res;\\n    } catch (e) {\\n      twQualidadeInfo = 'deixei passar a lista original (' + (e && e.message) + ')';\\n      seguir();\\n    }\\n  });\\n}\\n// ================= Pontos, baú e resgate da TWITCH =================\\n// A Twitch mudou: o bônus do PokeIdle agora sai dos PONTOS DO CANAL, igual na Kick. Só conta quem está\\n// na página do canal com o vídeo rodando (chat sozinho não ganha nada). Cada canal oficial monta as\\n// recompensas do seu jeito, então o PokeLink LÊ a lista de cada canal em vez de usar uma tabela fixa.\\n// Preços observados (hora avulsa × horas, sem desconto):\\n//   +15% XP          300 / 900 (3h) / 1.500 (5h) / 3.000 (10h)\\n//   +15% Capture     500 / 1.500   / 2.500       / 5.000\\n//   +15% Secret Lure 1.000 / 3.000 / 5.000       / 10.000\\nconst TWITCH_TIPOS = [\\n  { id: 'xp', nome: '+15% XP', base: 300, chave: 'xp' },\\n  { id: 'capture', nome: '+15% Capture Boost', base: 500, chave: 'capture' },\\n  { id: 'lure', nome: '+15% Secret Lure', base: 1000, chave: 'secret|lure' },\\n];\\nconst TWITCH_GOALS = TWITCH_TIPOS.map((t) => ({ pts: t.base, nome: t.nome, chave: t.chave, id: t.id }));\\nconst TWITCH_POLL_SEC = 60;\\nconst TW_CLIENT_ID = 'kimne78kx3ncx6brgo4mv6wki5h1ko'; // id público do site da Twitch (o próprio site usa este)\\nconst twitchPts = ACCOUNTS.map(() => ({}));      // slug -> { pts, at, base, baseAt, inicio, avisado }\\nconst twitchRewards = ACCOUNTS.map(() => ({}));  // slug -> { at, lista: [{ tipo, titulo, custo, horas }] }\\nconst twitchRewardsAt = ACCOUNTS.map(() => ({}));\\nconst twitchResgatando = new Set();\\nconst twitchStatus = new Map();                  // \\\"i|slug\\\" -> { tocando, visivel }\\nlet twitchAtualizado = 0;\\nlet twitchBauTotal = 0;                          // quantos baús de bônus o PokeLink já pegou\\nlet twitchBauAviso = '';                         // último motivo de um baú não ter passado (não repete no log)\\n\\n// qual tipo de bônus é este título? (os canais escrevem de jeitos diferentes e o texto vem cortado)\\nfunction twTipoDe(titulo) {\\n  const t = String(titulo || '');\\n  for (const x of TWITCH_TIPOS) if (new RegExp(x.chave, 'i').test(t)) return x.id;\\n  return null;\\n}\\n// lista de recompensas do PokeIdle que ESTE canal oferece (lida da página). Sem lista ainda: usa as de 1 hora.\\nfunction twOpcoes(i, slug) {\\n  const r = twitchRewards[i][slug];\\n  const lista = r && Array.isArray(r.lista) ? r.lista.filter((x) => x.tipo && x.custo > 0) : [];\\n  if (lista.length) return lista;\\n  return TWITCH_TIPOS.map((x) => ({ tipo: x.id, titulo: x.nome, custo: x.base, horas: 1 }));\\n}\\n\\n// ---- scripts que rodam DENTRO da página do canal ----\\n// Pedaço comum: falar com a API da Twitch (gql.twitch.tv) usando o LOGIN DA CONTA, de dentro da live.\\n// É o mesmo pedido que o site faz quando você clica em Resgatar, então não depende de achar botão\\n// nenhum na tela (o layout da Twitch muda sempre; a API não). Quando a Twitch desconfia e pede a\\n// checagem anti-robô, o script pega o token dela ali mesmo, dentro do player, e manda o pedido de novo.\\nconst TW_GQL_JS = String.raw`\\n  const tok = decodeURIComponent((document.cookie.match(/(?:^|; )auth-token=([^;]+)/) || [])[1] || '');\\n  const dev = decodeURIComponent((document.cookie.match(/(?:^|; )unique_id=([^;]+)/) || [])[1] || '');\\n  const base = { 'Client-ID': ${JSON.stringify(TW_CLIENT_ID)}, 'Content-Type': 'text/plain;charset=UTF-8' };\\n  if (tok) base.Authorization = 'OAuth ' + tok;\\n  if (dev) base['X-Device-Id'] = dev;\\n  let integridade = null;\\n  const gql = async (query, variables) => {\\n    for (let n = 0; n < 2; n++) {\\n      const parar = new AbortController();\\n      const relogio = setTimeout(() => parar.abort(), 10000);\\n      let r;\\n      try {\\n        r = await fetch('https://gql.twitch.tv/gql', {\\n          method: 'POST', cache: 'no-cache', credentials: 'include', signal: parar.signal,\\n          headers: integridade ? Object.assign({ 'Client-Integrity': integridade }, base) : base,\\n          body: JSON.stringify({ query, variables }),\\n        });\\n      } finally { clearTimeout(relogio); }\\n      if (!r.ok) return { falhou: 'erro ' + r.status };\\n      const j = await r.json();\\n      const desafio = !!(j && j.extensions && j.extensions.challenge) ||\\n        !!(j && Array.isArray(j.errors) && j.errors.some((e) => e && e.extensions && e.extensions.code === 'IntegrityCheckFailed'));\\n      if (!desafio) return j;\\n      if (integridade) return { falhou: 'checagem anti-robô da Twitch' };\\n      const t = await fetch('https://gql.twitch.tv/integrity', { method: 'POST', cache: 'no-cache', credentials: 'include', headers: base });\\n      const tj = t.ok ? await t.json().catch(() => null) : null;\\n      if (!tj || !tj.token) return { falhou: 'checagem anti-robô da Twitch (' + t.status + ')' };\\n      integridade = tj.token;\\n    }\\n    return { falhou: 'sem resposta' };\\n  };\\n  const porque = (j, p) => (j && j.falhou) || (p && p.error && p.error.code) ||\\n    (j && j.errors && j.errors[0] && j.errors[0].message) || 'sem resposta';\\n`;\\n// Os campos do canal que interessam: saldo, baú esperando e a lista de bônus (com id, descrição e preço).\\nconst TW_CANAL_Q = 'query($login:String!){user(login:$login){id channel{self{communityPoints{balance availableClaim{id}}} ' +\\n  'communityPointsSettings{customRewards{id title prompt cost isEnabled isPaused isInStock cooldownExpiresAt}}}}}';\\n// só os bônus que dá para resgatar AGORA (ligado, sem pausa, com estoque e fora do tempo de espera)\\nconst TW_LIVRES_JS = String.raw`\\n  const livres = (lista) => (lista || []).filter((x) => x && x.isEnabled !== false && x.isPaused !== true\\n    && x.isInStock !== false && !x.cooldownExpiresAt);\\n`;\\n// Lê o saldo de pontos, garante o vídeo tocando e PEGA o baú de bônus (a cada ~15 min a Twitch solta um\\n// baú que vale +50 pontos; pegá-lo quase dobra o ganho por hora). Antes o baú era um clique no ícone da\\n// tela; agora é o mesmo pedido que o site faz, que funciona mesmo com o layout mudado.\\nconst TWITCH_LER_JS = (slug, pegarBau) => String.raw`(async () => {` + TW_GQL_JS + TW_LIVRES_JS + String.raw`\\n  const slug = ${JSON.stringify(String(slug))};\\n  const out = { slug, points: null, via: null, tocando: false, bau: false, logado: false, rewards: null };\\n  // Tolera o iconinho de pontos antes do numero (ex.: \\\"\\\\u23f1 1.200\\\") e o jeito ABREVIADO que a Twitch\\n  // escreve saldo grande. CUIDADO com o português: \\\"2,7 mil\\\" são 2.700, e NÃO 2,7 milhões. Antes as letras\\n  // eram jogadas fora até sobrar \\\"2,7m\\\", que virava 2.700.000 no painel. A abreviação vai lida inteira:\\n  // mil = x1.000, mi/mm/kk = x1.000.000, bi = x1.000.000.000; em inglês, k e m/mn.\\n  const num = (t) => {\\n    const limpo = String(t).replace(/[\\\\s\\\\u00a0]/g, '').replace(/^[^\\\\d]+/, '');\\n    // a ordem importa: \\\"milhões\\\" tem que ser testado ANTES de \\\"mil\\\", senão vira mil\\n    const m = limpo.match(/^([\\\\d.,]+)\\\\s*(milhares|milh[õo]es|milh[ãa]o|milhao|bilh[õo]es|bilh[ãa]o|mil|bi|mi|mn|k|m|b)?/i);\\n    if (!m) return null;\\n    let n = parseFloat(m[1].replace(/\\\\.(?=\\\\d{3}(\\\\D|$))/g, '').replace(',', '.'));\\n    if (!isFinite(n)) return null;\\n    const suf = String(m[2] || '').toLowerCase();\\n    if (suf === 'mil' || suf === 'milhares' || suf === 'k') n *= 1e3;\\n    else if (/^(mi|m|mn|milh)/.test(suf)) n *= 1e6;\\n    else if (/^(bi|b)/.test(suf)) n *= 1e9;\\n    return isFinite(n) ? Math.round(n) : null;\\n  };\\n  // 1) o vídeo PRECISA estar tocando: sem isso a Twitch não conta nenhum ponto.\\n  // NÃO se espera pelo play(): num vídeo que não carregou ele fica pendurado para sempre e seguraria\\n  // toda a leitura. Manda tocar, espera um instante e confere depois.\\n  const paradosAntes = [...document.querySelectorAll('video')].filter((v) => v.paused);\\n  for (const v of paradosAntes) {\\n    try { v.muted = true; } catch (e) {} // mudo = o navegador deixa começar sozinho\\n    try { const p = v.play(); if (p && p.catch) p.catch(() => {}); } catch (e) {}\\n  }\\n  if (paradosAntes.length) {\\n    const b = [...document.querySelectorAll('button,[role=button]')]\\n      .find((x) => /play|reproduzir|assistir/i.test((x.getAttribute('aria-label') || '') + ' ' + (x.title || '')));\\n    if (b) { try { b.click(); } catch (e) {} }\\n    await new Promise((r) => setTimeout(r, 400));\\n  }\\n  for (const v of document.querySelectorAll('video')) if (!v.paused && v.readyState >= 2) out.tocando = true;\\n  out.semPlayer = !document.querySelectorAll('video').length;\\n  // o tempo do vídeo e o tamanho real: comparando o tempo entre duas leituras dá para saber se ele\\n  // ANDOU de verdade. Olhar só \\\"paused\\\" num instante dava alarme falso no meio do anúncio da Twitch.\\n  const vv = document.querySelector('video');\\n  out.tempo = vv ? vv.currentTime : null;\\n  out.altura = vv ? vv.videoHeight : null;\\n  // 2) saldo, lista de bônus e baú pela API do site, com o login desta conta\\n  try {\\n    out.logado = !!tok;\\n    const j = await gql(${JSON.stringify(TW_CANAL_Q)}, { login: slug });\\n    if (j && j.falhou) out.erroApi = j.falhou;\\n    const u = j && j.data && j.data.user;\\n    const ch = u && u.channel;\\n    const cp = ch && ch.self && ch.self.communityPoints;\\n    if (u && u.id) out.canalId = u.id;\\n    if (cp && typeof cp.balance === 'number') { out.points = cp.balance; out.via = 'api'; }\\n    const cfg = ch && ch.communityPointsSettings;\\n    if (cfg && Array.isArray(cfg.customRewards)) {\\n      out.rewards = livres(cfg.customRewards).map((x) => ({\\n        id: x.id, titulo: String(x.title || ''), prompt: x.prompt == null ? null : String(x.prompt), custo: Number(x.cost) || 0,\\n      }));\\n    }\\n    // 3) o baú de bônus (+50 pontos): só vem para quem \\\"clica\\\". Aqui é o mesmo pedido do clique.\\n    if (${pegarBau ? 'true' : 'false'} && u && u.id && cp && cp.availableClaim && cp.availableClaim.id) {\\n      const k = await gql('mutation($i:ClaimCommunityPointsInput!){claimCommunityPoints(input:$i){claim{id} currentPoints error{code}}}',\\n        { i: { channelID: u.id, claimID: cp.availableClaim.id } });\\n      const p = k && k.data && k.data.claimCommunityPoints;\\n      if (p && !p.error && !(k.errors && k.errors.length)) {\\n        out.bau = true;\\n        if (typeof p.currentPoints === 'number') out.points = p.currentPoints;\\n        else if (out.points != null) out.points += 50;\\n      } else out.erroBau = porque(k, p);\\n    }\\n  } catch (e) { out.erroApi = String(e && e.message || e); }\\n  // 4) a API não respondeu: lê o número DO LUGAR CERTO na tela. Antes ele aceitava qualquer elemento com\\n  // \\\"point\\\" no nome e pegava um número qualquer da página (mostrava 95 quando o saldo era 230). Agora\\n  // só vale o marcador do saldo ou o botão de pontos do canal; não achando, prefere não dizer nada.\\n  if (out.points == null) {\\n    const lugares = [\\n      '[data-test-selector=\\\"balance-string\\\"]',\\n      '[data-a-target=\\\"channel-points-balance\\\"]',\\n      '[data-test-selector=\\\"community-points-summary\\\"] button',\\n      'button[aria-label*=\\\"ponto\\\" i]',\\n      'button[aria-label*=\\\"point\\\" i]',\\n    ];\\n    for (const sel of lugares) {\\n      for (const e of document.querySelectorAll(sel)) {\\n        let p = num(e.textContent || '');\\n        if (p == null) {\\n          for (const s of e.querySelectorAll('*')) {\\n            if (s.children.length) continue;\\n            const q = num(s.textContent || '');\\n            if (q != null) { p = q; break; }\\n          }\\n        }\\n        if (p != null) { out.points = p; out.via = 'tela'; out.onde = sel + (out.erroApi ? ' — a API não respondeu: ' + out.erroApi : ''); break; }\\n      }\\n      if (out.points != null) break;\\n    }\\n  }\\n  return out;\\n})()`;\\n\\n// Lê a lista de recompensas do canal pelo painel \\\"Power-ups e recompensas\\\" (quando a API não respondeu).\\nconst TWITCH_LISTA_JS = String.raw`(async () => {\\n  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n  const esperar = async (fn, ms) => { const t0 = Date.now(); while (Date.now() - t0 < ms) { const v = fn(); if (v) return v; await sleep(200); } return null; };\\n  const num = (t) => {\\n    const limpo = String(t).replace(/[\\\\s\\\\u00a0]/g, '').replace(/^[^\\\\d]+/, '').replace(/[^\\\\d.,]+$/, '');\\n    const m = limpo.match(/^([\\\\d.,]+)$/);\\n    if (!m) return null;\\n    const n = parseFloat(m[1].replace(/\\\\.(?=\\\\d{3}(\\\\D|$))/g, '').replace(',', '.'));\\n    return isFinite(n) ? Math.round(n) : null;\\n  };\\n  const abrir = document.querySelector('[data-test-selector=\\\"community-points-summary\\\"] button, button[aria-label*=\\\"recompensa\\\" i], button[aria-label*=\\\"reward\\\" i], button[aria-label*=\\\"power\\\" i], button[aria-label*=\\\"ponto\\\" i], button[aria-label*=\\\"point\\\" i]');\\n  const cartoes = () => [...document.querySelectorAll('button,[role=button]')].filter((e) => /\\\\+?15%|pokeidle|capture|secret|lure/i.test(e.textContent || ''));\\n  let cs = cartoes();\\n  let abri = false; // só fecha o painel no fim se foi ESTE script que abriu\\n  if (!cs.length && abrir) {\\n    abrir.click();\\n    abri = true;\\n    cs = (await esperar(() => { const x = cartoes(); return x.length ? x : null; }, 6000)) || [];\\n  }\\n  const lista = [];\\n  for (const e of cs) {\\n    if (e.querySelector('button')) continue; // fica com o cartão mais interno\\n    const txt = (e.textContent || '').replace(/\\\\s+/g, ' ').trim();\\n    let custo = null;\\n    for (const s of e.querySelectorAll('*')) { if (s.children.length) continue; const n = num(s.textContent || ''); if (n != null && n >= 100) { custo = n; break; } }\\n    if (custo == null) continue;\\n    const h = txt.match(/\\\\((\\\\d+)\\\\s*h\\\\)/i);\\n    const nome = txt.replace(/^[\\\\d.,]+\\\\s*/, '').trim(); // tira o preço que vem grudado no começo\\n    lista.push({ titulo: (nome || txt).slice(0, 90), custo, horas: h ? Number(h[1]) : 1 });\\n  }\\n  if (abri && abrir) { try { abrir.click(); } catch (e) {} } // fecha o painel do jeito que estava\\n  return lista;\\n})()`;\\n\\n// Resgata um bônus pela API da Twitch, de dentro da live (o mesmo pedido do botão Resgatar do site).\\n// A Twitch confere CUSTO, TÍTULO e DESCRIÇÃO: se não forem iguaizinhos aos do canal ela recusa\\n// (PROPERTIES_MISMATCH), por isso o script lê a lista do canal na hora e manda os valores dela.\\nconst TWITCH_RESGATAR_API_JS = (slug, alvo) => String.raw`(async () => {` + TW_GQL_JS + TW_LIVRES_JS + String.raw`\\n  const slug = ${JSON.stringify(String(slug))};\\n  const alvo = ${JSON.stringify(alvo)};\\n  try {\\n    const j = await gql(${JSON.stringify(TW_CANAL_Q)}, { login: slug });\\n    if (j && j.falhou) return { ok: false, erro: j.falhou };\\n    const u = j && j.data && j.data.user;\\n    const ch = u && u.channel;\\n    if (!u || !u.id || !ch) return { ok: false, erro: 'canal não encontrado' };\\n    const lista = livres(ch.communityPointsSettings && ch.communityPointsSettings.customRewards);\\n    const re = new RegExp(alvo.chave, 'i');\\n    const combina = (x) => re.test(String(x.title || '')) && Number(x.cost) === alvo.custo;\\n    const r = (alvo.id && lista.find((x) => x.id === alvo.id))\\n      || lista.find((x) => combina(x) && /pokeidle/i.test(String(x.title || '') + ' ' + String(x.prompt || '')))\\n      || lista.find(combina);\\n    if (!r) return { ok: false, erro: 'esse bônus não está disponível neste canal agora' };\\n    const cp = ch.self && ch.self.communityPoints;\\n    if (cp && typeof cp.balance === 'number' && cp.balance < Number(r.cost)) {\\n      return { ok: false, erro: 'pontos insuficientes (' + cp.balance + '/' + r.cost + ')', points: cp.balance };\\n    }\\n    const id = [...crypto.getRandomValues(new Uint8Array(16))].map((b) => b.toString(16).padStart(2, '0')).join('');\\n    const m = await gql('mutation($i:RedeemCommunityPointsCustomRewardInput!){redeemCommunityPointsCustomReward(input:$i){redemption{id} error{code}}}',\\n      { i: { channelID: u.id, cost: Number(r.cost), prompt: r.prompt == null ? null : r.prompt, rewardID: r.id, title: r.title, transactionID: id } });\\n    const p = m && m.data && m.data.redeemCommunityPointsCustomReward;\\n    if (p && p.redemption && !p.error && !(m.errors && m.errors.length)) return { ok: true, titulo: r.title, custo: Number(r.cost) };\\n    return { ok: false, erro: porque(m, p) };\\n  } catch (e) { return { ok: false, erro: String(e && e.message || e) }; }\\n})()`;\\n\\n// PLANO B: resgatar clicando no cartão do painel, quando a API recusar. Casa PALAVRA-CHAVE + PREÇO: só o\\n// nome não serve (vem cortado com \\\"...\\\") e só o preço também não (tem recompensa de outro tipo com o mesmo valor).\\nconst TWITCH_RESGATAR_CLIQUE_JS = (chave, custo) => String.raw`(async () => {\\n  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n  const esperar = async (fn, ms) => { const t0 = Date.now(); while (Date.now() - t0 < ms) { const v = fn(); if (v) return v; await sleep(200); } return null; };\\n  const clicar = (el) => {\\n    const r = el.getBoundingClientRect();\\n    const o = { bubbles: true, cancelable: true, view: window, clientX: r.x + r.width / 2, clientY: r.y + r.height / 2 };\\n    el.dispatchEvent(new PointerEvent('pointerdown', o));\\n    el.dispatchEvent(new MouseEvent('mousedown', o));\\n    el.dispatchEvent(new PointerEvent('pointerup', o));\\n    el.dispatchEvent(new MouseEvent('mouseup', o));\\n    el.dispatchEvent(new MouseEvent('click', o));\\n  };\\n  const re = new RegExp(${JSON.stringify(String(chave))}, 'i');\\n  const alvoCusto = ${Number(custo) || 0};\\n  const num = (t) => {\\n    const limpo = String(t).replace(/[\\\\s\\\\u00a0]/g, '').replace(/^[^\\\\d]+/, '').replace(/[^\\\\d.,]+$/, '');\\n    const m = limpo.match(/^([\\\\d.,]+)$/);\\n    if (!m) return null;\\n    const n = parseFloat(m[1].replace(/\\\\.(?=\\\\d{3}(\\\\D|$))/g, '').replace(',', '.'));\\n    return isFinite(n) ? Math.round(n) : null;\\n  };\\n  const temPreco = (e) => {\\n    for (const s of e.querySelectorAll('*')) { if (s.children.length) continue; if (num(s.textContent || '') === alvoCusto) return true; }\\n    return false;\\n  };\\n  const achar = () => [...document.querySelectorAll('button,[role=button]')]\\n    .find((e) => !e.querySelector('button') && re.test(e.textContent || '') && temPreco(e)) || null;\\n  const abrir = document.querySelector('[data-test-selector=\\\"community-points-summary\\\"] button, button[aria-label*=\\\"recompensa\\\" i], button[aria-label*=\\\"reward\\\" i], button[aria-label*=\\\"power\\\" i], button[aria-label*=\\\"ponto\\\" i], button[aria-label*=\\\"point\\\" i]');\\n  let abri = false; // só fecha o painel no fim se foi ESTE script que abriu\\n  const fechar = () => { if (abri && abrir) { try { clicar(abrir); } catch (e) {} } };\\n  let alvo = achar();\\n  if (!alvo) {\\n    if (!abrir) return { ok: false, erro: 'não achei o botão de pontos do canal na página' };\\n    clicar(abrir);\\n    abri = true;\\n    alvo = await esperar(achar, 7000);\\n  }\\n  if (!alvo) { fechar(); return { ok: false, erro: 'não achei essa recompensa no painel deste canal' }; }\\n  if (alvo.disabled || alvo.getAttribute('aria-disabled') === 'true') {\\n    fechar();\\n    return { ok: false, erro: 'parece que ainda não tem pontos suficientes' };\\n  }\\n  clicar(alvo);\\n  const conf = await esperar(() => [...document.querySelectorAll('button')]\\n    .find((b) => /^(resgatar|resgate|redeem|confirmar|confirm|sim|ok)$/i.test((b.textContent || '').trim())), 5000);\\n  if (conf) clicar(conf);\\n  await sleep(1500);\\n  fechar();\\n  return { ok: true, confirmado: !!conf };\\n})()`;\\n\\n\\n// ---- SALDO DE TODOS OS CANAIS, SEM PRECISAR ABRIR A LIVE ----\\n// É o que a Kick já fazia e faltava na Twitch: pergunta o saldo de todos os canais oficiais de uma vez,\\n// usando o login daquela conta. Sem isso, só os canais com live aberta mostravam pontos.\\n// São duas perguntas prontas possíveis (a Twitch já trocou de código uma vez); tenta as duas e fica na\\n// que responder. Vai no mesmo formato de lote que já funciona para saber quem está ao vivo.\\nconst TW_PONTOS_HASHES = [\\n  '1530a003a7d374b0380b79db0be0534f30ff46e61cffa2bc0e2468a909fbc024',\\n  '9988086babc615a918a1e9a722ff41d98847acac822645dc02b3634898dd8882',\\n];\\nlet twPontosHash = null;   // a que funcionou (para não ficar tentando as duas sempre)\\nlet twitchSaldoInfo = '';  // aparece no painel, para dar para ver o que aconteceu\\nasync function twitchTokenDaConta(i) {\\n  try {\\n    const cs = await accountSession(i).cookies.get({ domain: '.twitch.tv', name: 'auth-token' });\\n    return (cs[0] && cs[0].value) || null;\\n  } catch { return null; }\\n}\\nasync function twitchSaldosDaConta(i, canais, token) {\\n  const corpo = (hash) => JSON.stringify(canais.map((c) => ({\\n    operationName: 'ChannelPointsContext',\\n    variables: { channelLogin: c },\\n    extensions: { persistedQuery: { version: 1, sha256Hash: hash } },\\n  })));\\n  const tentar = async (hash) => {\\n    const r = await withTimeout(accountSession(i).fetch('https://gql.twitch.tv/gql', {\\n      method: 'POST',\\n      headers: { 'Client-ID': TW_CLIENT_ID, 'Content-Type': 'text/plain', Authorization: 'OAuth ' + token, 'User-Agent': LIVE_UA },\\n      body: corpo(hash),\\n    }), 25000);\\n    if (!r.ok) throw new Error('HTTP ' + r.status);\\n    const j = await r.json();\\n    if (!Array.isArray(j)) throw new Error('resposta estranha');\\n    const saldos = {};\\n    const premios = {};\\n    canais.forEach((c, n) => {\\n      const ch = j[n] && j[n].data && j[n].data.community && j[n].data.community.channel;\\n      const self = ch && ch.self && ch.self.communityPoints;\\n      if (self && typeof self.balance === 'number') saldos[c] = self.balance;\\n      const cfg = ch && ch.communityPointsSettings;\\n      if (cfg && Array.isArray(cfg.customRewards)) {\\n        const lista = cfg.customRewards\\n          .filter((x) => x && x.isEnabled !== false && x.isPaused !== true)\\n          .map((x) => {\\n            const t = String(x.title || '');\\n            const h = t.match(/\\\\((\\\\d+)\\\\s*h\\\\)/i);\\n            return { tipo: twTipoDe(t), titulo: t, custo: Number(x.cost) || 0, horas: h ? Number(h[1]) : 1,\\n              id: x.id || null, prompt: x.prompt == null ? null : String(x.prompt) };\\n          })\\n          .filter((x) => x.tipo && x.custo > 0);\\n        if (lista.length) premios[c] = lista;\\n      }\\n    });\\n    if (!Object.keys(saldos).length) throw new Error('nenhum saldo veio');\\n    return { saldos, premios };\\n  };\\n  // 3ª tentativa: pergunta escrita à mão, todos os canais de uma vez. Não depende dos códigos prontos,\\n  // então continua funcionando no dia em que a Twitch trocar os dois.\\n  const tentarSimples = async () => {\\n    const r = await withTimeout(accountSession(i).fetch('https://gql.twitch.tv/gql', {\\n      method: 'POST',\\n      headers: { 'Client-ID': TW_CLIENT_ID, 'Content-Type': 'text/plain', Authorization: 'OAuth ' + token, 'User-Agent': LIVE_UA },\\n      body: JSON.stringify({\\n        query: 'query($l:[String!]){users(logins:$l){login channel{self{communityPoints{balance}} ' +\\n          'communityPointsSettings{customRewards{id title prompt cost isEnabled isPaused isInStock cooldownExpiresAt}}}}}',\\n        variables: { l: canais },\\n      }),\\n    }), 25000);\\n    if (!r.ok) throw new Error('HTTP ' + r.status);\\n    const j = await r.json();\\n    const us = j && j.data && Array.isArray(j.data.users) ? j.data.users : null;\\n    if (!us) throw new Error('resposta sem dados');\\n    const saldos = {};\\n    const premios = {};\\n    for (const u of us) {\\n      if (!u || !u.login || !u.channel) continue;\\n      const c = canais.find((x) => String(x).toLowerCase() === String(u.login).toLowerCase()) || u.login;\\n      const self = u.channel.self && u.channel.self.communityPoints;\\n      if (self && typeof self.balance === 'number') saldos[c] = self.balance;\\n      const cfg = u.channel.communityPointsSettings;\\n      if (cfg && Array.isArray(cfg.customRewards)) {\\n        const lista = cfg.customRewards\\n          .filter((x) => x && x.isEnabled !== false && x.isPaused !== true && x.isInStock !== false && !x.cooldownExpiresAt)\\n          .map((x) => {\\n            const t = String(x.title || '');\\n            const h = t.match(/\\\\((\\\\d+)\\\\s*h\\\\)/i);\\n            return { tipo: twTipoDe(t), titulo: t, custo: Number(x.cost) || 0, horas: h ? Number(h[1]) : 1,\\n              id: x.id || null, prompt: x.prompt == null ? null : String(x.prompt) };\\n          })\\n          .filter((x) => x.tipo && x.custo > 0);\\n        if (lista.length) premios[c] = lista;\\n      }\\n    }\\n    if (!Object.keys(saldos).length) throw new Error('nenhum saldo veio');\\n    return { saldos, premios };\\n  };\\n  const ordem = twPontosHash ? [twPontosHash, ...TW_PONTOS_HASHES.filter((h) => h !== twPontosHash)] : TW_PONTOS_HASHES;\\n  let erro = null;\\n  for (const hash of ordem) {\\n    try { const r = await tentar(hash); twPontosHash = hash; return r; }\\n    catch (e) { erro = e; }\\n  }\\n  try { return await tentarSimples(); } catch (e) { erro = e; }\\n  throw erro || new Error('sem resposta');\\n}\\nasync function pollTwitchSaldos() {\\n  const canais = LIVE_CHANNELS.twitch;\\n  if (!canais.length) return;\\n  let lidos = 0;\\n  let contas = 0;\\n  let ultimoErro = '';\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    if (!lives.twitch[i]) continue;\\n    contas++;\\n    const token = await twitchTokenDaConta(i);\\n    if (!token) { ultimoErro = `${nameOf(i)}: sem login da Twitch`; continue; }\\n    try {\\n      const { saldos, premios } = await twitchSaldosDaConta(i, canais, token);\\n      const agora = Date.now();\\n      for (const [slug, pts] of Object.entries(saldos)) {\\n        const st = twitchPts[i][slug] || { base: pts, baseAt: agora, avisado: {} };\\n        if (pts < (st.pts ?? pts)) { st.base = pts; st.baseAt = agora; st.avisado = {}; } // resgatou: recomeça a conta\\n        st.pts = pts; st.at = agora; st.via = 'api';\\n        twitchPts[i][slug] = st;\\n        lidos++;\\n      }\\n      for (const [slug, lista] of Object.entries(premios)) {\\n        twitchRewards[i][slug] = { at: agora, lista };\\n        twitchRewardsAt[i][slug] = agora;\\n      }\\n    } catch (e) { ultimoErro = `${nameOf(i)}: ${e.message}`; }\\n  }\\n  twitchSaldoInfo = lidos\\n    ? `saldos: ${lidos} canais em ${contas} conta${contas === 1 ? '' : 's'}`\\n    : (ultimoErro ? 'saldos: ' + ultimoErro : '');\\n}\\n\\n// ---- leitura periódica ----\\nlet twitchBauProx = 0;\\nasync function pollTwitchPoints() {\\n  await pollTwitchSaldos().catch(() => {}); // saldo de TODOS os canais, mesmo sem live aberta\\n  const pegarBau = Date.now() >= twitchBauProx;\\n  if (pegarBau) twitchBauProx = Date.now() + 2 * 60 * 1000; // tenta o baú no máximo a cada 2 min\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    for (const [slug, slot] of liveOpen[i].twitch) {\\n      const wc = slot.view && slot.view.webContents;\\n      if (!wc || wc.isDestroyed() || wc.isLoading()) continue;\\n      if (!twPaginaBoa(wc.getURL(), slug)) continue; // modo chat: não rende ponto nem dá para ler\\n      let r = null;\\n      try { r = await withTimeout(wc.executeJavaScript(TWITCH_LER_JS(slug, pegarBau)), 12000); } catch {}\\n      if (!r) continue;\\n      const ant = twitchStatus.get(`${i}|${slug}`);\\n      const antTocando = ant ? !!ant.tocando : null;\\n      // andou = o tempo do vídeo avançou desde a leitura anterior. É a prova de que está rodando.\\n      const andou = r.tempo != null && ant && ant.tempo != null && r.tempo > ant.tempo + 0.5;\\n      twitchStatus.set(`${i}|${slug}`, {\\n        tocando: !!r.tocando || andou,\\n        logado: !!r.logado, semPlayer: !!r.semPlayer, onde: r.onde || null,\\n        tempo: r.tempo, altura: r.altura, at: Date.now(),\\n      });\\n      {\\n        const agoraTocando = !!r.tocando || andou;\\n        const slotVelho = Date.now() - (slot.openedAt || Date.now()) > 3 * 60 * 1000; // 3 min de carência ao abrir\\n        if (antTocando === true && !agoraTocando && slotVelho) logEvento('problema', i, 'twitch', slug, `a live de ${slug} na Twitch parou (nenhum vídeo tocando)`);\\n        if (antTocando === false && agoraTocando) logEvento('ok', i, 'twitch', slug, `a live de ${slug} na Twitch voltou a tocar`);\\n      }\\n      if (r.bau) twitchBauTotal++;\\n      if (r.bau) logResgate('twitch', i, slug, `peguei o baú de bônus (+50${r.points != null ? `, saldo ${r.points}` : ''})`);\\n      if (r.erroBau && twitchBauAviso !== r.erroBau) {\\n        twitchBauAviso = r.erroBau;\\n        logTravamento(`Twitch: o baú de bônus de ${slug} não passou (${r.erroBau})`);\\n        logResgate('twitch', i, slug, `o baú de bônus não passou (${r.erroBau})`, 'problema');\\n      }\\n      if (Array.isArray(r.rewards) && r.rewards.length) {\\n        const lista = r.rewards.map((x) => {\\n          const h = String(x.titulo).match(/\\\\((\\\\d+)\\\\s*h\\\\)/i);\\n          return { tipo: twTipoDe(x.titulo), titulo: x.titulo, custo: Number(x.custo) || 0, horas: h ? Number(h[1]) : 1,\\n            id: x.id || null, prompt: x.prompt == null ? null : x.prompt };\\n        }).filter((x) => x.tipo && x.custo > 0);\\n        if (lista.length) { twitchRewards[i][slug] = { at: Date.now(), lista }; twitchRewardsAt[i][slug] = Date.now(); }\\n      }\\n      if (r.points == null) continue;\\n      const now = Date.now();\\n      const s = twitchPts[i][slug] || { base: r.points, baseAt: now, avisado: {} };\\n      // O número da tela vem ARREDONDADO e abreviado (\\\"2,7 mil\\\"). Tendo um saldo da API de menos de\\n      // 10 minutos, ele manda: o da tela só serve quando não há nada melhor.\\n      if (r.via === 'tela' && s.via === 'api' && s.at && now - s.at < 10 * 60 * 1000) continue;\\n      if (r.points < (s.pts ?? r.points)) { s.base = r.points; s.baseAt = now; s.avisado = {}; } // resgatou: recomeça\\n      s.pts = r.points; s.at = now; s.via = r.via;\\n      if (s.inicioSlot !== slot.openedAt || r.points < (s.inicio ?? r.points)) { s.inicio = r.points; s.inicioAt = now; s.inicioSlot = slot.openedAt; }\\n      twitchPts[i][slug] = s;\\n      conferirDevolucao('twitch', i, slug, s, r.points);   // o jogo devolveu os pontos? então para de resgatar\\n      conferirLiveParada('twitch', i, slug, slot, s, r.points); // aberta e sem render nada? recarrega\\n      const meta = [...TWITCH_GOALS].reverse().find((g) => r.points >= g.pts && !s.avisado[g.pts]);\\n      if (meta) {\\n        TWITCH_GOALS.forEach((g) => { if (r.points >= g.pts) s.avisado[g.pts] = true; });\\n        if (!twitchAutoResgate) twitchGoalAlert(i, slug, r.points, meta);\\n      }\\n      const chave = `${i}|${slug}`;\\n      if (twitchAutoResgate && !resgatePausado.twitch[i] && !twitchResgatando.has(chave)) {\\n        const alvo = twitchMelhorOpcao(i, slug, r.points);\\n        if (alvo) {\\n          twitchResgatando.add(chave);\\n          twitchResgatar(i, slug, alvo).finally(() => twitchResgatando.delete(chave));\\n        }\\n      }\\n    }\\n    // lista de recompensas pela tela: só se a API não trouxe nada em 30 min\\n    if (lives.twitch[i]) await twitchLerLista(i);\\n    // Canais SEM live aberta (o canal saiu do ar, ou está fora do limite de 2): o saldo deles continua\\n    // sendo lido, então o Auto Resgate gasta esses pontos também, um canal por vez a cada volta.\\n    if (twitchAutoResgate && !resgatePausado.twitch[i] && lives.twitch[i]) await twitchResgatarParados(i);\\n  }\\n  if (twitchWin && !twitchWin.isDestroyed()) twitchWin.webContents.send('twitch-update');\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('twitch-update');\\n}\\n// gasta o saldo guardado nos canais que não estão com live aberta (inclusive os que saíram do ar)\\nasync function twitchResgatarParados(i) {\\n  for (const slug of Object.keys(twitchPts[i])) {\\n    if (liveOpen[i].twitch.has(slug)) continue;             // esse já é tratado na volta normal\\n    const chave = `${i}|${slug}`;\\n    if (twitchResgatando.has(chave)) continue;\\n    const st = twitchPts[i][slug];\\n    if (!st || st.pts == null || !st.at || Date.now() - st.at > 10 * 60 * 1000) continue; // saldo velho: espera a próxima leitura\\n    if (st.paradoAt && Date.now() - st.paradoAt < 10 * 60 * 1000) continue;               // não insiste no mesmo canal\\n    const alvo = twitchMelhorOpcao(i, slug, st.pts);\\n    if (!alvo) continue;\\n    st.paradoAt = Date.now();\\n    twitchResgatando.add(chave);\\n    const r = await twitchResgatar(i, slug, alvo).finally(() => twitchResgatando.delete(chave));\\n    if (r && r.ok) logEvento('ok', i, 'twitch', slug, `resgatei ${alvo.tipo === 'xp' ? '+15% XP' : alvo.titulo} em ${slug} (canal sem live aberta)`);\\n    return; // um por volta: cada um pode precisar abrir uma página escondida\\n  }\\n}\\nasync function twitchLerLista(i) {\\n  for (const [slug, slot] of liveOpen[i].twitch) {\\n    if (Date.now() - (twitchRewardsAt[i][slug] || 0) < 30 * 60 * 1000) continue;\\n    const wc = slot.view && slot.view.webContents;\\n    if (!wc || wc.isDestroyed() || wc.isLoading()) continue;\\n    if (!String(wc.getURL()).includes('twitch.tv/' + slug)) continue; // a lista pela TELA só existe na página do canal\\n    twitchRewardsAt[i][slug] = Date.now();\\n    let lista = null;\\n    try { lista = await withTimeout(wc.executeJavaScript(TWITCH_LISTA_JS), 20000); } catch {}\\n    if (!Array.isArray(lista)) continue;\\n    const boas = lista.map((x) => Object.assign({ tipo: twTipoDe(x.titulo) }, x)).filter((x) => x.tipo && x.custo > 0);\\n    if (boas.length) twitchRewards[i][slug] = { at: Date.now(), lista: boas };\\n    return; // uma por vez: abrir o painel mexe na página\\n  }\\n}\\n// melhor pacote que dá pra pegar agora (o maior, pra precisar de menos cliques e falhar menos vezes)\\nfunction twitchMelhorOpcao(i, slug, pts) {\\n  if (pts == null) return null;\\n  const ops = twOpcoes(i, slug).filter((o) => twitchResgateTiers[o.tipo] !== false && o.custo <= pts);\\n  if (!ops.length) return null;\\n  // \\\"Preferir pacotes\\\" desligado: só os de 1 hora, e entre eles o bônus mais caro (o mais valioso).\\n  if (!twitchPacotes) {\\n    const base = ops.filter((o) => (o.horas || 1) <= 1);\\n    if (base.length) return base.slice().sort((a, b) => b.custo - a.custo)[0];\\n  }\\n  // Ligado: o pacote com MAIS HORAS que der (não o mais caro). Com 1.200 pontos, 3h de XP por 900\\n  // vale mais que 1h de Secret Lure por 1.000: o preço por hora é o mesmo e rende o triplo de tempo.\\n  return ops.slice().sort((a, b) => ((b.horas || 1) - (a.horas || 1)) || (b.custo - a.custo))[0];\\n}\\n// Uma página da Twitch desta conta para falar com a API, na ordem do mais barato para o mais caro:\\n// 1) a live daquele canal, se estiver aberta; 2) QUALQUER live da Twitch já aberta naquela conta (o\\n// pedido pergunta pelo canal, então não precisa ser a página dele); 3) nada aberto ou canal fora do ar:\\n// abre um player escondido só por alguns segundos e fecha. Com isso dá para resgatar MESMO COM O CANAL\\n// OFFLINE — antes os pontos ficavam parados até o canal voltar. (Ideia do PokeIdle Deck, MIT.)\\nasync function twitchPaginaDaConta(i, slug) {\\n  const slot = liveOpen[i].twitch.get(slug);\\n  const wc = slot && slot.view && slot.view.webContents;\\n  if (wc && !wc.isDestroyed() && !wc.isLoading() && twPaginaBoa(wc.getURL(), slug)) return { wc, propria: true, fechar: null };\\n  for (const [, sl] of liveOpen[i].twitch) {\\n    const w = sl.view && sl.view.webContents;\\n    if (w && !w.isDestroyed() && !w.isLoading() && String(w.getURL()).includes('twitch.tv')) return { wc: w, propria: false, fechar: null };\\n  }\\n  // nenhuma live aberta nesta conta: abre uma página escondida só para fazer o pedido\\n  let win = null;\\n  try {\\n    win = new BrowserWindow({\\n      x: -32000, y: -32000, width: 800, height: 500, show: false, frame: false, skipTaskbar: true, focusable: false,\\n      webPreferences: { partition: `persist:conta${i + 1}`, backgroundThrottling: false, autoplayPolicy: 'no-user-gesture-required' },\\n    });\\n    win.setMenu(null);\\n    const w = win.webContents;\\n    twitchViewIds.add(w.id);\\n    w.setAudioMuted(true);\\n    await withTimeout(w.loadURL(PLAT.twitch.url(slug, 'player'), { userAgent: LIVE_UA }), 30000).catch(() => {});\\n    await new Promise((r) => setTimeout(r, 1500)); // deixa o login e os scripts da Twitch entrarem\\n    return { wc: w, propria: false, fechar: () => { try { twitchViewIds.delete(w.id); win.destroy(); } catch {} } };\\n  } catch (e) {\\n    try { if (win && !win.isDestroyed()) win.destroy(); } catch {}\\n    return null;\\n  }\\n}\\n// Resgate: primeiro pela API da Twitch (não depende do layout da página nem do canal estar no ar);\\n// se ela recusar, tenta o jeito antigo, clicando no cartão do painel da página do canal.\\nasync function twitchResgatar(i, slug, opcao) {\\n  const pag = await twitchPaginaDaConta(i, slug);\\n  if (!pag) return { ok: false, erro: 'não consegui abrir uma página da Twitch nesta conta' };\\n  const wc = pag.wc;\\n  const fechar = () => { try { if (pag.fechar) pag.fechar(); } catch {} };\\n  const tipo = TWITCH_TIPOS.find((t) => t.id === opcao.tipo);\\n  if (!tipo) { fechar(); return { ok: false, erro: 'bônus desconhecido' }; }\\n  const anotar = (r) => {\\n    if (!r || !r.ok) return r;\\n    const custo = Number(r.custo) || opcao.custo;\\n    marcarResgate('twitch', i, slug, custo);\\n    logResgate('twitch', i, slug, `resgatei ${tipo.nome}${opcao.horas > 1 ? ` (${opcao.horas}h)` : ''} por ${custo} pontos`);\\n    logTravamento(`${nameOf(i)}: resgatei ${tipo.nome}${opcao.horas > 1 ? ` (${opcao.horas}h)` : ''} por ${custo} pontos em ${slug} (Twitch${r.viaClique ? ', pelo painel' : ''})`);\\n    const s = twitchPts[i][slug];\\n    if (s && s.pts != null) { s.pts = Math.max(0, s.pts - custo); s.base = s.pts; s.baseAt = Date.now(); s.avisado = {}; }\\n    return r;\\n  };\\n  let api = null;\\n  try {\\n    api = await withTimeout(wc.executeJavaScript(\\n      TWITCH_RESGATAR_API_JS(slug, { id: opcao.id || null, custo: opcao.custo, chave: tipo.chave })), 25000);\\n  } catch (e) { api = { ok: false, erro: e.message }; }\\n  if (api && api.ok) { fechar(); return anotar(api); }\\n  // sem pontos não adianta tentar o clique\\n  if (api && /insuficiente/i.test(String(api.erro || ''))) { fechar(); return api; }\\n  // o plano B (clicar no painel) só existe na página do canal daquela live\\n  if (!pag.propria || !String(wc.getURL()).includes('twitch.tv/' + slug)) {\\n    fechar();\\n    return api || { ok: false, erro: 'sem resposta da Twitch' };\\n  }\\n  if (api && api.erro) logResgate('twitch', i, slug, `a API recusou o resgate de ${tipo.nome} (${api.erro}); tentando pelo painel`, 'problema');\\n  try {\\n    const r = await withTimeout(wc.executeJavaScript(TWITCH_RESGATAR_CLIQUE_JS(tipo.chave, opcao.custo)), 20000);\\n    fechar();\\n    if (r && r.ok) return anotar(Object.assign({ viaClique: true }, r));\\n    return api && api.erro ? api : (r || { ok: false, erro: 'sem resposta da página' });\\n  } catch (e) { fechar(); return api && api.erro ? api : { ok: false, erro: e.message }; }\\n}\\nasync function twitchGoalAlert(i, slug, pts, meta) {\\n  avisoCelular('twitch', `${pts.toLocaleString('pt-BR')} pontos na Twitch`, `${nameOf(i)} · ${slug}: já dá para resgatar ${meta.nome}.`);\\n  if (!twitchAvisos) return;\\n  const r = await uiDialog({\\n    type: 'info',\\n    title: 'Pontos da Twitch',\\n    message: `${nameOf(i)}: ${pts.toLocaleString('pt-BR')} pontos em ${slug}`,\\n    detail: `Já dá para resgatar ${meta.nome} (${meta.pts.toLocaleString('pt-BR')} pontos). ` +\\n      'O resgate é feito na live, no painel \\\"Power-ups e recompensas\\\" do canal. Cada resgate vale 1 hora e as horas se somam.',\\n    buttons: ['Resgatar na live', 'Depois'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (r.response === 0) openLivePage(i, 'twitch', slug);\\n}\\n\\nfunction twitchState() {\\n  const modo = twitchModo === 'auto' ? modoTw(0) : twitchModo;\\n  return {\\n    atualizado: twitchAtualizado ? new Date(twitchAtualizado).toLocaleTimeString('pt-BR') : '',\\n    avisos: twitchAvisos,\\n    autoResgate: twitchAutoResgate,\\n    resgateTiers: twitchResgateTiers,\\n    pacotes: twitchPacotes,\\n    bau: twitchBauTotal,\\n    modo,\\n    modoOk: modo === 'completo',\\n    max: LIVE_MAX.twitch,\\n    goals: TWITCH_GOALS,\\n    tipos: TWITCH_TIPOS,\\n    poll: TWITCH_POLL_SEC,\\n    check: twitchCheckInfo,\\n    saldoInfo: twitchSaldoInfo,\\n    abertasTotal: ACCOUNTS.reduce((t, _, i) => t + liveOpen[i].twitch.size, 0),\\n    removidos: (listaCanais().find((x) => x.p === 'twitch') || {}).removidos || [],\\n    contas: ACCOUNTS.map((_, i) => {\\n      const j = jogoInfo[i];\\n      return {\\n        i, name: nameOf(i), on: !!lives.twitch[i],\\n        vinculo: (j && j.twitch && j.twitch.login) || null,\\n        sel: twitchSel[i],\\n        todos: LIVE_CHANNELS.twitch.map((slug) => ({\\n          slug, live: liveNow.twitch.has(slug), sel: twitchSel[i].includes(slug),\\n          pts: twitchPts[i][slug] && twitchPts[i][slug].pts != null ? twitchPts[i][slug].pts : null,\\n        })),\\n        canais: [...liveOpen[i].twitch.keys()].map((slug) => {\\n          const s = twitchPts[i][slug];\\n          const horas = s && s.at > s.baseAt ? (s.at - s.baseAt) / 36e5 : 0;\\n          const st = twitchStatus.get(`${i}|${slug}`);\\n          const slot = liveOpen[i].twitch.get(slug);\\n          const pts = s ? s.pts : null;\\n          const melhor = twitchMelhorOpcao(i, slug, pts);\\n          return {\\n            slug, pts, via: s ? s.via : null, at: s ? s.at : 0,\\n            tocando: st ? st.tocando : null,\\n            logado: st ? st.logado : null,\\n            onde: st ? st.onde : null,\\n            semPlayer: st ? st.semPlayer : null,\\n            altura: st ? st.altura : null,\\n            aberta: slot && slot.view ? slot.openedAt : 0,\\n            opcoes: twOpcoes(i, slug),\\n            melhor,\\n            semRender: !!(slot && slot.view && Date.now() - slot.openedAt > 20 * 60 * 1000 &&\\n              s && s.pts != null && s.pts === s.base && Date.now() - s.baseAt > 15 * 60 * 1000),\\n            porHora: horas >= 0.1 ? Math.round((s.pts - s.base) / horas) : null,\\n          };\\n        }),\\n      };\\n    }),\\n  };\\n}\\nconst mandarTwitch = () => {\\n  if (twitchWin && !twitchWin.isDestroyed()) twitchWin.webContents.send('twitch-update');\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('twitch-update');\\n};\\nipcMain.handle('twitch-get', () => twitchState());\\nipcMain.handle('twitch-refresh', async () => {\\n  try { await withTimeout(discoverChannels(), 8000); } catch {}\\n  ACCOUNTS.forEach((_, i) => { twitchRewardsAt[i] = {}; });\\n  try { await withTimeout(pollTwitchSaldos(), 40000); } catch {}\\n  try { await withTimeout(pollTwitchPoints(), 60000); } catch {}\\n  twitchAtualizado = Date.now();\\n  return twitchState();\\n});\\nipcMain.on('twitch-sel', (_, i, slug) => {\\n  if (!Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return;\\n  slug = String(slug).toLowerCase();\\n  if (!LIVE_CHANNELS.twitch.includes(slug)) return;\\n  const k = twitchSel[i].indexOf(slug);\\n  if (k >= 0) twitchSel[i].splice(k, 1); else twitchSel[i].push(slug);\\n  saveLives();\\n  syncLives();\\n  mandarTwitch();\\n});\\nipcMain.on('twitch-avisos', (_, on) => { twitchAvisos = !!on; saveLives(); mandarTwitch(); });\\nipcMain.on('twitch-auto-resgate', (_, on) => { twitchAutoResgate = !!on; voltarAResgatar('twitch'); saveLives(); mandarTwitch(); });\\nipcMain.on('twitch-pacotes', (_, on) => { twitchPacotes = !!on; saveLives(); mandarTwitch(); });\\nipcMain.on('twitch-max', (_, n) => {\\n  if (![1, 2].includes(Number(n))) return;\\n  LIVE_MAX.twitch = Number(n);\\n  saveLives();\\n  syncLives();\\n  mandarTwitch();\\n});\\nipcMain.on('twitch-resgate-tier', (_, id, on) => {\\n  if (!TWITCH_TIPOS.some((t) => t.id === id)) return;\\n  twitchResgateTiers[id] = !!on;\\n  saveLives();\\n  mandarTwitch();\\n});\\n// Resgate em LOTE (Shift + clique no Resgatar): gasta o saldo daquele canal de uma vez, um resgate\\n// atrás do outro com 2 s entre eles, parando no primeiro erro. Funciona com o canal fora do ar.\\nasync function twitchResgatarLote(i, slug) {\\n  const st = twitchPts[i][slug];\\n  let saldo = st && st.pts;\\n  if (saldo == null) return { feitos: 0, erro: 'ainda não sei o saldo deste canal' };\\n  // quantos cabem, simulando o saldo indo embora\\n  const plano = [];\\n  for (let n = 0; n < 20; n++) {\\n    const alvo = twitchMelhorOpcao(i, slug, saldo);\\n    if (!alvo) break;\\n    plano.push(alvo);\\n    saldo -= alvo.custo;\\n  }\\n  if (!plano.length) return { feitos: 0, erro: 'o saldo deste canal não dá para nenhum bônus agora' };\\n  const gasto = plano.reduce((t, o) => t + o.custo, 0);\\n  const horas = plano.reduce((t, o) => t + (o.horas || 1), 0);\\n  const r = await uiDialog({\\n    type: 'question',\\n    title: 'Resgatar tudo',\\n    message: `${nameOf(i)}: resgatar ${plano.length} ${plano.length === 1 ? 'bônus' : 'bônus'} em ${slug}?`,\\n    detail: `Gasta ${gasto.toLocaleString('pt-BR')} dos ${(st.pts || 0).toLocaleString('pt-BR')} pontos e rende ${horas}h de bônus:\\\\n` +\\n      plano.map((o) => `· ${o.titulo}${o.horas > 1 ? ` (${o.horas}h)` : ''} — ${o.custo.toLocaleString('pt-BR')}`).join('\\\\n') +\\n      '\\\\n\\\\nAs horas do mesmo bônus se somam até 3x; o que passar disso é desperdiçado.',\\n    buttons: ['Resgatar tudo', 'Cancelar'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (r.response !== 0) return { feitos: 0, cancelado: true };\\n  let feitos = 0;\\n  for (const alvo of plano) {\\n    const res = await twitchResgatar(i, slug, alvo);\\n    if (!res || !res.ok) return { feitos, erro: (res && res.erro) || 'sem resposta' };\\n    feitos++;\\n    mandarTwitch();\\n    await new Promise((x) => setTimeout(x, 2000)); // um de cada vez, com calma\\n  }\\n  return { feitos };\\n}\\nipcMain.on('twitch-redeem-live', async (_, i, slug, lote) => {\\n  if (!Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return;\\n  slug = String(slug);\\n  const chave = `${i}|${slug}`;\\n  const s = twitchPts[i][slug];\\n  if (lote) {\\n    if (twitchResgatando.has(chave)) return;\\n    twitchResgatando.add(chave);\\n    const r = await twitchResgatarLote(i, slug).finally(() => twitchResgatando.delete(chave));\\n    mandarTwitch();\\n    if (r.cancelado) return;\\n    if (r.feitos) logEvento('ok', i, 'twitch', slug, `resgatei ${r.feitos} bônus de uma vez em ${slug}`);\\n    if (r.erro) {\\n      uiDialog({ type: 'info', title: 'Resgatar tudo',\\n        message: r.feitos ? `Resgatei ${r.feitos} e parei.` : 'Não deu para resgatar.',\\n        detail: `Motivo: ${r.erro}.`, buttons: ['Entendi'] }).catch(() => {});\\n    }\\n    return;\\n  }\\n  const alvo = twitchMelhorOpcao(i, slug, s && s.pts);\\n  if (alvo && !twitchResgatando.has(chave)) {\\n    twitchResgatando.add(chave);\\n    const r = await twitchResgatar(i, slug, alvo).finally(() => twitchResgatando.delete(chave));\\n    mandarTwitch();\\n    if (r && r.ok) return;\\n  }\\n  openLivePage(i, 'twitch', slug); // não deu sozinho: abre a live pra você resgatar na mão\\n});\\nipcMain.handle('twitch-diag', async () => {\\n  // despejo da página para ajustar os cliques quando a Twitch mudar o painel de novo\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    for (const [slug, slot] of liveOpen[i].twitch) {\\n      const wc = slot.view && slot.view.webContents;\\n      if (!wc || wc.isDestroyed()) continue;\\n      const dump = await withTimeout(wc.executeJavaScript(String.raw`(async () => {\\n        const rot = [...document.querySelectorAll('button,[role=button],[data-test-selector],[aria-label]')]\\n          .map((e) => e.tagName + ' | ' + [e.getAttribute('data-test-selector'), e.getAttribute('aria-label'), e.className && String(e.className).slice(0, 60)].filter(Boolean).join(' | ') + ' | ' + (e.textContent || '').replace(/\\\\s+/g, ' ').trim().slice(0, 60))\\n          .slice(0, 500);\\n        // TUDO sobre cada vídeo da página: é com isto que dá para saber por que o player não começa\\n        const videos = [...document.querySelectorAll('video')].map((v) => {\\n          const r = v.getBoundingClientRect();\\n          return {\\n            paused: v.paused, muted: v.muted, readyState: v.readyState, networkState: v.networkState,\\n            tempo: v.currentTime, duracao: v.duration, autoplay: v.autoplay, ended: v.ended,\\n            largura: v.videoWidth, altura: v.videoHeight,\\n            naTela: Math.round(r.width) + 'x' + Math.round(r.height) + ' em ' + Math.round(r.left) + ',' + Math.round(r.top),\\n            temFonte: !!(v.src || v.srcObject || v.querySelector('source')),\\n            erro: v.error ? (v.error.code + ': ' + v.error.message) : null,\\n          };\\n        });\\n        // o player tenta começar agora? guarda o motivo exato da recusa\\n        let tentativa = 'nenhum vídeo na página';\\n        const v0 = document.querySelector('video');\\n        if (v0) {\\n          try { await v0.play(); tentativa = 'começou'; }\\n          catch (e) { tentativa = 'recusado: ' + e.name + ' - ' + e.message; }\\n        }\\n        // avisos que seguram o player (maior de idade, \\\"ainda está aí?\\\", erro de transmissão)\\n        const avisos = [...document.querySelectorAll('button,h1,h2,h3,p,span')]\\n          .map((e) => (e.textContent || '').replace(/\\\\s+/g, ' ').trim())\\n          .filter((t) => t.length > 3 && t.length < 120 &&\\n            /assistir|começar|come\\\\u00e7ar|maior|adulto|mature|sens\\\\u00edvel|sensitive|ainda est|still (watching|here)|erro|error|indispon|unavailable|offline|carregando|loading/i.test(t))\\n          .slice(0, 40);\\n        return {\\n          url: location.href,\\n          logado: /auth-token=/.test(document.cookie),\\n          visivel: document.visibilityState, temFoco: document.hasFocus(), escondido: document.hidden,\\n          janela: window.innerWidth + 'x' + window.innerHeight,\\n          qualidadeSalva: (() => { try { return localStorage.getItem('video-quality'); } catch (e) { return 'erro'; } })(),\\n          mudoSalvo: (() => { try { return localStorage.getItem('video-muted'); } catch (e) { return 'erro'; } })(),\\n          videos, tentativaDePlay: tentativa, avisosNaTela: avisos, rotulos: rot,\\n        };\\n      })()`), 20000).catch((e) => ({ erro: e.message }));\\n      // Área de Trabalho; se não der para gravar lá, grava na pasta de dados do PokeLink\\n      let f = '';\\n      try { f = path.join(app.getPath('desktop'), 'twitch-diagnostico.json'); } catch { f = ''; }\\n      const host = twitchHosts.get(slot.view);\\n      const janela = host && !host.isDestroyed()\\n        ? { existe: true, posicao: host.getBounds(), visivel: host.isVisible(), minimizada: host.isMinimized(), focada: host.isFocused() }\\n        : { existe: false };\\n      const conteudo = JSON.stringify({ versao: APP_VERSION, conta: nameOf(i), slug,\\n        qualidadeForcada: twQualidadeInfo || 'ainda não peguei nenhuma lista de qualidades',\\n        resgatePausado: resgatePausado.twitch[i] || null,\\n        registro: resgatesMem.slice(0, 30),\\n        bau: { pegos: twitchBauTotal, ultimoErro: twitchBauAviso || null },\\n        modo: modoTw(i), janelaEscondida: janela, lido: twitchPts[i][slug] || null,\\n        estado: twitchStatus.get(`${i}|${slug}`) || null,\\n        recompensas: twitchRewards[i][slug] || null, dump }, null, 1);\\n      try {\\n        fs.writeFileSync(f, conteudo);\\n      } catch (e1) {\\n        try {\\n          f = path.join(app.getPath('userData'), 'twitch-diagnostico.json');\\n          fs.writeFileSync(f, conteudo); // o mesmo conteúdo completo, só em outra pasta\\n        } catch (e2) {\\n          logTravamento('Twitch: não consegui salvar o diagnóstico (' + e1.message + ' / ' + e2.message + ')');\\n          return null;\\n        }\\n      }\\n      return f;\\n    }\\n  }\\n  return '';\\n});\\nipcMain.on('twitch-open', () => openTwitchWin());\\n\\n// janela \\\"Pontos da Twitch\\\"\\nlet twitchWin = null;\\nfunction openTwitchWin() {\\n  if (twitchWin && !twitchWin.isDestroyed()) { twitchWin.show(); twitchWin.focus(); return; }\\n  twitchWin = new BrowserWindow({\\n    width: 980, height: 760, minWidth: 640, minHeight: 480, title: 'Pontos da Twitch — PokeLink',\\n    backgroundColor: '#141417', autoHideMenuBar: true,\\n    titleBarStyle: 'hidden', titleBarOverlay: { color: TITLE_BG, symbolColor: TITLE_FG, height: TITLE_H },\\n    ...(customIconPath() ? { icon: customIconPath() } : {}),\\n    webPreferences: { preload: path.join(__dirname, 'preload.js') },\\n  });\\n  twitchWin.setMenu(null);\\n  twitchWin.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'twitch' } });\\n  twitchWin.on('closed', () => { twitchWin = null; });\\n  pollTwitchPoints();\\n}\\n// ================= fim do bloco da Twitch =================\\n\\n// ---------- Levar o login de uma conta para o PokeLink Lite (Android) ----------\\n// O login com Google/Cloudflare é recusado dentro de apps no celular. Como aqui a conta já está logada,\\n// o PokeLink copia o login (cookies do pokeidle.io) e o usuário cola no app do celular.\\nasync function copyLoginForPhone(i) {\\n  const c = await uiDialog({\\n    type: 'warning',\\n    title: 'Login para o celular',\\n    message: `Copiar o login da ${nameOf(i)}?`,\\n    detail: 'O texto copiado É o seu login no jogo: quem tiver ele entra na sua conta. Mande só para você mesmo ' +\\n      '(ex.: WhatsApp \\\"mensagem para mim\\\") e apague a mensagem depois de colar no PokeLink Lite.',\\n    buttons: ['Copiar', 'Cancelar'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (c.response !== 0) return;\\n  const ses = session.fromPartition(`persist:conta${i + 1}`);\\n  const list = (await ses.cookies.get({})).filter((k) => /(^|\\\\.)pokeidle\\\\.io$/i.test(String(k.domain).replace(/^\\\\./, '')));\\n  // o login do jogo pode estar em cookies E no armazenamento da página (localStorage / IndexedDB)\\n  let store = { ls: {}, idb: [] };\\n  const wc = views[i] && views[i].webContents;\\n  if (wc && !wc.isDestroyed()) {\\n    try { store = JSON.parse(await withTimeout(wc.executeJavaScript(LOGIN_EXPORT_JS), 10000)); } catch {}\\n  }\\n  const nLs = Object.keys(store.ls || {}).length;\\n  const nIdb = (store.idb || []).reduce((s2, d) => s2 + d.stores.reduce((t, st) => t + st.items.length, 0), 0);\\n  if (!list.length && !nLs && !nIdb) { showError('Login para o celular', 'Esta conta não está logada no jogo.'); return; }\\n  const texto = JSON.stringify({\\n    v: 2,\\n    cookies: list.map((k) => ({ name: k.name, value: k.value, domain: k.domain, path: k.path, secure: k.secure, httpOnly: k.httpOnly, expirationDate: k.expirationDate })),\\n    ls: store.ls || {},\\n    idb: store.idb || [],\\n  });\\n  clipboard.writeText(texto);\\n  uiDialog({\\n    type: texto.length > 60000 ? 'warning' : 'info', title: 'Login para o celular', message: 'Login copiado.',\\n    detail: `${nameOf(i)}: ${list.length} cookie(s), ${nLs} item(ns) de armazenamento e ${nIdb} registro(s) de banco da página.\\\\n\\\\n` +\\n      'No PokeLink Lite: escolha a conta, toque em \\\"Login\\\" e cole.' +\\n      (texto.length > 60000 ? `\\\\n\\\\nO texto ficou grande (${Math.round(texto.length / 1000)} mil letras). Se o WhatsApp cortar, mande como arquivo .txt (cole no Bloco de Notas, salve e envie).` : ''),\\n  });\\n}\\n// lê o armazenamento da página do jogo (prioriza o que parece ser login)\\nconst LOGIN_EXPORT_JS = `(async () => {\\n  const pri = /auth|token|session|user|login|firebase|sb-|supabase|jwt|account|conta|cred/i;\\n  const ls = {}; let size = 0;\\n  const keys = Object.keys(localStorage).sort((a, b) => (pri.test(b) ? 1 : 0) - (pri.test(a) ? 1 : 0));\\n  for (const k of keys) {\\n    const v = localStorage.getItem(k);\\n    if (v == null || v.length > 40000) continue;\\n    if (!pri.test(k) && size + v.length > 30000) continue;\\n    ls[k] = v; size += k.length + v.length;\\n  }\\n  const idb = [];\\n  try {\\n    const dbs = (indexedDB.databases ? await indexedDB.databases() : []).filter((d) => pri.test(d.name || ''));\\n    for (const d of dbs) {\\n      const r = await new Promise((res, rej) => { const q = indexedDB.open(d.name); q.onsuccess = () => res(q.result); q.onerror = () => rej(q.error); });\\n      const out = { name: d.name, version: r.version, stores: [] };\\n      for (const sn of r.objectStoreNames) {\\n        const st = r.transaction(sn, 'readonly').objectStore(sn);\\n        const vals = await new Promise((res) => { const q = st.getAll(); q.onsuccess = () => res(q.result); q.onerror = () => res([]); });\\n        const st2 = r.transaction(sn, 'readonly').objectStore(sn);\\n        const ks = await new Promise((res) => { const q = st2.getAllKeys(); q.onsuccess = () => res(q.result); q.onerror = () => res([]); });\\n        out.stores.push({ name: sn, keyPath: st.keyPath, autoIncrement: st.autoIncrement, items: vals.slice(0, 200).map((v, n) => ({ key: ks[n], value: v })) });\\n      }\\n      r.close();\\n      idb.push(out);\\n    }\\n  } catch (e) {}\\n  return JSON.stringify({ ls, idb });\\n})()`;\\n\\n// ---------- Ver no celular (PokeLink Monitor) ----------\\n// Manda um RESUMO das contas (o mesmo do Mega Eco) para um banco de dados online (Firebase), guardado sob um\\n// código aleatório. No celular, a página do PokeLink Monitor mostra esse resumo de qualquer lugar.\\n// O celular só LÊ: só o PokeLink deste PC consegue gravar no código dele (login anônimo do Firebase).\\n// Começa DESLIGADO. Nada do jogo é mandado para o servidor do jogo: o PokeLink só lê a tela, como no Mega Eco.\\nconst MONITOR_DB = 'https://pokelink-monitor-default-rtdb.firebaseio.com';\\nconst MONITOR_KEY = 'AIzaSyAGo6qRvEUBXKTsAFZXFF94_zeO7CTIuYY'; // chave pública do app (não é senha)\\nconst MONITOR_SITE = 'https://znationsx.github.io/pokelink-monitor/';\\nconst MONITOR_SEG = 20; // envia a cada 20 segundos (avisos importantes vão na hora)\\nconst MONITOR_FREQ = '20 segundos';\\nconst monitor = { pendente: false, ligado: false, codigo: '', refresh: '', uid: '', token: '', tokenAte: 0, ultimo: 0, erro: '', enviando: false,\\n  avisos: [], cache: ACCOUNTS.map(() => null), vistos: ACCOUNTS.map(() => null), codigoNovo: false };\\nconst monitorFile = () => path.join(app.getPath('userData'), 'celular.json');\\nfunction loadMonitor() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(monitorFile(), 'utf8'));\\n    monitor.ligado = !!j.ligado;\\n    if (typeof j.codigo === 'string' && /^[A-Z0-9]{20,}$/.test(j.codigo)) monitor.codigo = j.codigo;\\n    if (typeof j.refresh === 'string') monitor.refresh = j.refresh;\\n    if (typeof j.uid === 'string') monitor.uid = j.uid;\\n    if (Array.isArray(j.avisos)) monitor.avisos = j.avisos.slice(0, 30);\\n  } catch {}\\n  if (monitor.ligado && !monitor.codigo) monitor.ligado = false;\\n}\\nconst saveMonitor = () => { try { fs.writeFileSync(monitorFile(), JSON.stringify({ ligado: monitor.ligado, codigo: monitor.codigo, refresh: monitor.refresh, uid: monitor.uid, avisos: monitor.avisos })); } catch {} };\\n// código de 20 letras/números (sem 0/O, 1/I): impossível de adivinhar\\nfunction novoCodigo() {\\n  const A = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\\n  return [...require('crypto').randomBytes(20)].map((b) => A[b % 32]).join('');\\n}\\nconst avisarMonitor = () => { if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('monitor-update'); };\\n// guarda um aviso para a tela \\\"Avisos\\\" do celular (só quando a função está ligada)\\nfunction avisoCelular(tipo, titulo, texto) {\\n  if (!monitor.ligado) return;\\n  monitor.avisos.unshift({ tipo, titulo, texto, em: Date.now() });\\n  monitor.avisos.length = Math.min(monitor.avisos.length, 30);\\n  saveMonitor();\\n  // aviso vai para o celular na hora (junta avisos que chegam no mesmo instante)\\n  clearTimeout(monitor.avisoTimer);\\n  monitor.avisoTimer = setTimeout(() => monitorEnviar(true), 1500);\\n}\\n// login anônimo no Firebase (fica guardado; renova sozinho)\\nasync function monitorLogin() {\\n  if (monitor.token && Date.now() < monitor.tokenAte - 60000) return monitor.token;\\n  const ses = checkSession();\\n  if (monitor.refresh) {\\n    const r = await withTimeout(ses.fetch(`https://securetoken.googleapis.com/v1/token?key=${MONITOR_KEY}`, {\\n      method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },\\n      body: 'grant_type=refresh_token&refresh_token=' + encodeURIComponent(monitor.refresh),\\n    }), 15000);\\n    if (r.ok) {\\n      const j = await r.json();\\n      Object.assign(monitor, { token: j.id_token, refresh: j.refresh_token, uid: j.user_id, tokenAte: Date.now() + Number(j.expires_in || 3600) * 1000 });\\n      saveMonitor();\\n      return monitor.token;\\n    }\\n  }\\n  const r = await withTimeout(ses.fetch(`https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=${MONITOR_KEY}`, {\\n    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ returnSecureToken: true }),\\n  }), 15000);\\n  if (!r.ok) throw new Error(`o servidor recusou o login (${r.status}). Confira se o login anônimo está ativado no Firebase`);\\n  const j = await r.json();\\n  Object.assign(monitor, { token: j.idToken, refresh: j.refreshToken, uid: j.localId, tokenAte: Date.now() + Number(j.expiresIn || 3600) * 1000 });\\n  saveMonitor();\\n  return monitor.token;\\n}\\n// transforma o resumo do Mega Eco de uma conta no formato pequeno que o celular mostra\\nfunction celConta(i, d, status) {\\n  const num = (t) => { const n = Number(String(t == null ? '' : t).replace('−', '-').replace(/\\\\./g, '').replace(',', '.').replace(/[^\\\\d.-]/g, '')); return isFinite(n) ? n : 0; };\\n  const curto = (n) => { n = Number(n) || 0; const a = Math.abs(n);\\n    return a >= 1e9 ? (n / 1e9).toFixed(1).replace('.', ',') + 'B' : a >= 1e6 ? (n / 1e6).toFixed(1).replace('.', ',') + 'M' : a >= 1e3 ? (n / 1e3).toFixed(1).replace('.', ',') + 'k' : String(Math.round(n)); };\\n  const hora = (t) => (t ? new Date(t).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) : '');\\n  const s = d.ses || {}, e = d.eco || {};\\n  const h = (s.ms || 0) / 3600000;\\n  const porH = (v) => (h > 0.02 ? (Number(v) || 0) / h : 0);\\n  const ritmo = (l, v) => (l && /\\\\/h$/.test(l[2] || '') ? num(l[2]) : porH(v));\\n  const tile = (l, v) => ({\\n    v: l && l[1] ? (/^[\\\\d.,−-]+$/.test(l[1]) && Math.abs(num(l[1])) >= 1e6 ? curto(num(l[1])) : l[1]) : curto(v),\\n    h: curto(ritmo(l, v)),\\n  });\\n  const hp = String((d.pk && d.pk.hp) || '').match(/([\\\\d.]+)\\\\s*\\\\/\\\\s*([\\\\d.]+)/);\\n  const sprite = d.pk && d.pk.sprite && d.pk.sprite.length < 20000 ? d.pk.sprite : null;\\n  const caps = (e.caps || []).length\\n    ? e.caps.slice(0, 5).map((c) => {\\n      const ls = c.linhas || [];\\n      return { img: c.img || null, nome: ls[0] || '', nv: ls.find((x) => /^Nv\\\\s*\\\\d/.test(x)) || '', hora: ls.find((x) => /^\\\\d{1,2}:\\\\d{2}$/.test(x)) || '',\\n        info: ls.filter((x) => /^(IV\\\\s|Q\\\\s)/.test(x)).join(' · '), shiny: /shiny|✨/i.test(ls.join(' ')) };\\n    })\\n    : (d.caps || []).slice(0, 5).map((c) => ({ img: null, nome: c.nome || '', nv: c.lv ? 'Nv ' + c.lv : '', hora: hora(c.em), info: '', shiny: !!c.shiny }));\\n  const kick = lives.kick[i] ? LIVE_CHANNELS.kick.map((slug) => {\\n    const p = kickPts[i][slug] && kickPts[i][slug].pts != null ? kickPts[i][slug].pts : kickAll[i][slug];\\n    return { slug, pts: p == null ? null : p, aberta: liveOpen[i].kick.has(slug) };\\n  }).filter((k) => k.pts != null).sort((a, b) => b.pts - a.pts).slice(0, 3) : null;\\n  const j = jogoInfo[i];\\n  return {\\n    n: i + 1, nick: d.nick || nameOf(i), nivel: d.nivel || '', status,\\n    perfil: d.perfil && d.perfil.xp && d.perfil.xp.total > 0 ? {\\n      atual: d.perfil.xp.atual, total: d.perfil.xp.total, pct: Math.round(Math.min(100, (d.perfil.xp.atual / d.perfil.xp.total) * 100) * 10) / 10,\\n      img: d.perfil.img && d.perfil.img.length < 20000 ? d.perfil.img : null,\\n    } : (monitor.cache[i] && monitor.cache[i].perfil) || null, modo: LEVELS[level[i]] ? LEVELS[level[i]].name : '',\\n    ouro: curto(num(d.ouro)), gemas: curto(num(d.gemas)), diam: curto(num(d.diamantes)),\\n    hunt: d.hunt || '', tempo: e.tempo || '',\\n    pk: { nome: (d.pk && d.pk.nome) || '', lv: (d.pk && d.pk.lv) || '', hp: hp ? Math.round(Math.max(0, Math.min(100, (num(hp[1]) / Math.max(1, num(hp[2]))) * 100))) : null, img: sprite },\\n    xpT: tile(e.xpT, s.xpTreinador), xpP: tile(e.xpP, s.xpPokemon), lucro: tile(e.lucro, s.gold), abates: tile(e.abates, s.abates), capturas: tile(e.capturas, s.capturas),\\n    ouroH: Math.round(ritmo(e.lucro, s.gold)), xpH: Math.round(ritmo(e.xpT, s.xpTreinador)), capsN: num(e.capturas && e.capturas[1]) || Number(s.capturas) || 0,\\n    gastos: (e.gastos || []).slice(0, 6), achados: (e.achados || []).slice(0, 6), caps,\\n    shiny: e.shiny ? { vistos: e.shiny.vistos || 0, pegos: e.shiny.pegos || 0 }\\n      : (monitor.cache[i] && monitor.cache[i].shiny && monitor.cache[i].hunt === (d.hunt || '') ? monitor.cache[i].shiny : null),\\n    ativos: (d.ativos || []).slice(0, 6).map((a) => `${a.nome} ${a.valor}`.replace(/\\\\s+/g, ' ').trim()),\\n    auto: auto.enabled[i] ? autoStatus[i] : null,\\n    troca: autoHunt.contas[i] ? huntStatus[i] : null,\\n    kick, twitch: lives.twitch[i] ? ((j && j.twitch && j.twitch.contando) || []).slice(0, 5) : null,\\n    exts: EXTENSIONS.filter((x) => !extOff.has(x.id)).map((x) => ({ nome: x.botao || x.nome.replace(/ for PokeIdle$/i, ''), ok: extNaConta(x.id, i) })),\\n  };\\n}\\n// shiny visto ou pego (contadores do ACHADOS · HUNT) vira aviso no celular\\nconst shinyAnt = ACCOUNTS.map(() => null);\\nfunction celShinyContador(i, sh, jaAvisou) {\\n  if (!sh) return;\\n  const a = shinyAnt[i];\\n  shinyAnt[i] = sh;\\n  if (!a) return; // 1ª leitura: só guarda\\n  const hunt = monitor.cache[i] && monitor.cache[i].hunt ? ` em ${monitor.cache[i].hunt.split('·')[0].trim()}` : '';\\n  if (sh.vistos > a.vistos) avisoCelular('shiny', 'Shiny visto!', `${nameOf(i)}: apareceu um shiny${hunt}.`);\\n  if (sh.pegos > a.pegos && !jaAvisou) avisoCelular('shiny', 'Shiny pego!', `${nameOf(i)}: pegou um shiny${hunt}.`);\\n}\\n// shiny novo no histórico de capturas da conta vira aviso no celular (devolve quantos avisou)\\nfunction celShiny(i, caps) {\\n  const lista = (caps || []).filter((c) => c && c.shiny);\\n  const chaves = lista.map((c) => `${c.nome}|${c.em}`);\\n  if (!monitor.vistos[i]) { monitor.vistos[i] = new Set(chaves); return 0; } // 1ª leitura: só guarda\\n  let n = 0;\\n  lista.forEach((c, k) => {\\n    if (monitor.vistos[i].has(chaves[k])) return;\\n    monitor.vistos[i].add(chaves[k]);\\n    n++;\\n    avisoCelular('shiny', 'Shiny pego!', `${nameOf(i)}: ${c.nome}${c.lv ? ' Nv ' + c.lv : ''}.`);\\n  });\\n  return n;\\n}\\nasync function monitorDados() {\\n  const contas = await Promise.all(views.map(async (v, i) => {\\n    const wc = v && v.webContents;\\n    const viva = wc && !wc.isDestroyed();\\n    let d = null;\\n    if (!sono.ausente && viva && !wc.isLoading()) d = await withTimeout(wc.executeJavaScript(RESUMO_JS), 5000).catch(() => null);\\n    const status = sono.ausente ? 'pausado' : !viva ? 'fechada' : travada[i] ? 'travada' : wc.isLoading() ? 'carregando' : !d ? 'sem resposta' : !d.nick ? 'sem login' : d.hunt ? 'farmando' : 'parada';\\n    if (!d || !d.nick) return Object.assign({}, monitor.cache[i] || { n: i + 1, nick: nameOf(i) }, { status, antigo: !!monitor.cache[i] });\\n    return (monitor.cache[i] = celConta(i, d, status));\\n  }));\\n  return { v: 1, at: { '.sv': 'timestamp' }, versao: APP_VERSION, pausado: !!sono.ausente, intervalo: 1, intervaloSeg: MONITOR_SEG, contas, avisos: monitor.avisos.slice(0, 20) };\\n}\\nasync function monitorEnviar(forcar) {\\n  if (!monitor.ligado || !monitor.codigo) return;\\n  if (monitor.enviando) { if (forcar) monitor.pendente = true; return; } // manda de novo assim que terminar\\n  if (!forcar && Date.now() - monitor.ultimo < MONITOR_SEG * 1000 - 2000) return;\\n  monitor.enviando = true;\\n  avisarMonitor();\\n  try {\\n    const corpo = await monitorDados();\\n    for (let tent = 0; ; tent++) {\\n      const tok = await monitorLogin();\\n      corpo.dono = monitor.uid;\\n      const r = await withTimeout(checkSession().fetch(`${MONITOR_DB}/m/${monitor.codigo}.json?auth=${encodeURIComponent(tok)}`, {\\n        method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo),\\n      }), 20000);\\n      if (r.ok) { monitor.ultimo = Date.now(); monitor.erro = ''; return; }\\n      if (r.status === 401 && tent === 0) { monitor.token = ''; continue; } // login vencido: renova e tenta de novo\\n      if (r.status === 401 && tent === 1) { // o código ficou com outro login (ex.: o login foi refeito): cria um código novo\\n        monitor.codigo = novoCodigo(); monitor.codigoNovo = true; saveMonitor(); continue;\\n      }\\n      throw new Error('o servidor respondeu ' + r.status);\\n    }\\n  } catch (e) {\\n    monitor.erro = e.message;\\n  } finally {\\n    monitor.enviando = false;\\n    avisarMonitor();\\n    if (monitor.pendente) { monitor.pendente = false; setTimeout(() => monitorEnviar(true), 300); }\\n  }\\n}\\nasync function monitorApagar(codigo) {\\n  if (!codigo) return;\\n  try {\\n    const tok = await monitorLogin();\\n    await withTimeout(checkSession().fetch(`${MONITOR_DB}/m/${codigo}.json?auth=${encodeURIComponent(tok)}`, { method: 'DELETE' }), 15000);\\n  } catch {}\\n}\\nfunction monitorEstado() {\\n  return {\\n    ligado: monitor.ligado, codigo: monitor.codigo, codigoFmt: (monitor.codigo.match(/.{1,4}/g) || []).join('-'),\\n    link: monitor.codigo ? MONITOR_SITE + '#' + monitor.codigo : '', site: MONITOR_SITE,\\n    ultimo: monitor.ultimo ? new Date(monitor.ultimo).toLocaleTimeString('pt-BR') : '',\\n    erro: monitor.erro, enviando: monitor.enviando, freq: MONITOR_FREQ, codigoNovo: monitor.codigoNovo,\\n  };\\n}\\nipcMain.handle('monitor-get', () => monitorEstado());\\nipcMain.on('monitor-panel', () => showMonitor());\\nipcMain.handle('monitor-acao', async (_, acao) => {\\n  monitor.codigoNovo = false;\\n  if (acao === 'ligar') {\\n    if (!monitor.codigo) monitor.codigo = novoCodigo();\\n    monitor.ligado = true; saveMonitor();\\n    await monitorEnviar(true);\\n  } else if (acao === 'desligar') {\\n    monitor.ligado = false; monitor.erro = ''; saveMonitor();\\n    await monitorApagar(monitor.codigo); // o resumo some do servidor\\n  } else if (acao === 'trocar') {\\n    const velho = monitor.codigo;\\n    monitor.codigo = novoCodigo(); saveMonitor();\\n    await monitorApagar(velho); // o código antigo para de funcionar\\n    if (monitor.ligado) await monitorEnviar(true);\\n  } else if (acao === 'agora') {\\n    await monitorEnviar(true);\\n  }\\n  buildMenu();\\n  sendState(); // bolinha do botão de celular nas barras\\n  return monitorEstado();\\n});\\nfunction showMonitor() {\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (!canDraw) return;\\n  const id = ++cfgPanelSeq;\\n  cfgPanels.add(id);\\n  dialogOpen = true;\\n  layout();\\n  titleBar.webContents.focus();\\n  titleBar.webContents.send('title-monitor', { id });\\n}\\n\\n// ---------- Bandeja do Windows (perto do relógio) e notificações de shiny ----------\\n// Ao fechar no X, o PokeLink continua rodando escondido na bandeja (o farm não para). \\\"Sair\\\" fecha de vez.\\n// As notificações usam o balão da bandeja, que o Windows mostra como notificação normal.\\nconst TRAY_PNG = 'data:image/png;base64,';\\nconst bandeja = { ligado: true, avisado: false, notif: true };\\nconst bandejaFile = () => path.join(app.getPath('userData'), 'bandeja.json');\\nfunction loadBandeja() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(bandejaFile(), 'utf8'));\\n    if (typeof j.ligado === 'boolean') bandeja.ligado = j.ligado;\\n    if (typeof j.notif === 'boolean') bandeja.notif = j.notif;\\n    bandeja.avisado = !!j.avisado;\\n  } catch {}\\n}\\nconst salvarBandeja = () => { try { fs.writeFileSync(bandejaFile(), JSON.stringify(bandeja)); } catch {} };\\nlet tray = null, trayIcone = null, saindo = false, notifConta = null;\\nfunction mostrarJanela() {\\n  if (!win || win.isDestroyed()) return;\\n  if (win.isMinimized()) win.restore();\\n  win.show();\\n  win.focus();\\n  layout();\\n}\\nfunction sairDeVez() { saindo = true; try { if (tray) tray.destroy(); } catch {} app.quit(); }\\nfunction setBandeja(on) { bandeja.ligado = !!on; salvarBandeja(); buildMenu(); }\\nfunction setNotif(on) { bandeja.notif = !!on; salvarBandeja(); buildMenu(); }\\n// notificação do Windows (clicar abre o PokeLink naquela conta)\\nfunction notificar(titulo, texto, conta) {\\n  if (!tray) return;\\n  notifConta = Number.isInteger(conta) ? conta : null;\\n  try { tray.displayBalloon({ icon: trayIcone, title: titulo, content: texto }); } catch {}\\n}\\nfunction atualizarTray() {\\n  if (!tray) return;\\n  tray.setToolTip(`PokeLink ${APP_CHANNEL ? APP_CHANNEL + ' ' : ''}${APP_LABEL}${win && !win.isVisible() ? ' — rodando em segundo plano' : ''}`);\\n  tray.setContextMenu(Menu.buildFromTemplate([\\n    { label: 'Abrir o PokeLink', click: mostrarJanela },\\n    { type: 'separator' },\\n    { label: monitor.ligado ? 'Ver no celular  ✓ ligado' : 'Ver no celular...', click: () => { mostrarJanela(); setTimeout(showMonitor, 300); } },\\n    { label: 'Desempenho', submenu: LEVELS.map((L, lv) => ({ label: L.name, type: 'radio', checked: level.every((x) => x === lv), click: () => setAllLevel(lv) })) },\\n    { label: 'Silenciar todas', click: () => ACCOUNTS.forEach((_, i) => setMuted(i, true)) },\\n    { label: 'Ligar o som de todas', click: () => ACCOUNTS.forEach((_, i) => setMuted(i, false)) },\\n    { type: 'separator' },\\n    { label: 'Notificações de shiny (visto e capturado)', type: 'checkbox', checked: bandeja.notif, click: (it) => setNotif(it.checked) },\\n    { label: 'Ao fechar, continuar rodando aqui', type: 'checkbox', checked: bandeja.ligado, click: (it) => setBandeja(it.checked) },\\n    { type: 'separator' },\\n    { label: 'Sair do PokeLink', click: sairDeVez },\\n  ]));\\n}\\nasync function criarBandeja() {\\n  if (tray) return;\\n  let img = null;\\n  const f = customIconPath();\\n  if (f) img = nativeImage.createFromPath(f);\\n  if (!img || img.isEmpty()) img = nativeImage.createFromDataURL(TRAY_PNG);\\n  trayIcone = img.resize({ width: 32, height: 32 });\\n  tray = new Tray(trayIcone.resize({ width: 16, height: 16 }));\\n  tray.on('click', mostrarJanela);\\n  tray.on('double-click', mostrarJanela);\\n  tray.on('balloon-click', () => { mostrarJanela(); if (notifConta != null) setFocus(notifConta); });\\n  atualizarTray();\\n  // X da janela: esconde em vez de fechar (se a opção estiver ligada)\\n  win.on('close', (e) => {\\n    if (saindo || !bandeja.ligado) return;\\n    e.preventDefault();\\n    win.hide();\\n    atualizarTray();\\n    if (!bandeja.avisado) {\\n      bandeja.avisado = true; salvarBandeja();\\n      notificar('O PokeLink continua rodando', 'O farm segue aqui na bandeja, perto do relógio. Para fechar de vez, clique com o botão direito no ícone e escolha \\\"Sair do PokeLink\\\".');\\n    }\\n  });\\n  win.on('show', atualizarTray);\\n}\\n\\n// ----- vigia de shiny (leve): contador \\\"Shinies vistos/capturados\\\" da hunt e histórico de capturas -----\\nconst SHINY_JS = `(() => {\\n  const slot = (tit) => {\\n    const e = document.querySelector('#eco-achados .eco-slot-shiny[title=\\\"' + tit + '\\\"]');\\n    if (!e || !e.getClientRects().length) return null;\\n    const m = (e.innerText || '').replace(/vistos|pegos/ig, '').match(/\\\\\\\\d[\\\\\\\\d.]*/);\\n    return m ? Number(m[0].replace(/\\\\\\\\./g, '')) || 0 : 0;\\n  };\\n  const nick = ((document.getElementById('tr-nick') || {}).textContent || '').trim();\\n  let caps = [];\\n  try { caps = JSON.parse(localStorage.getItem('capturas-hist:' + nick.toLowerCase()) || '[]') || []; } catch (e) {}\\n  const onde = document.getElementById('eco-onde') || document.getElementById('hud-hunt');\\n  return { nick, vistos: slot('Shinies vistos'), pegos: slot('Shinies capturados'), hunt: ((onde || {}).textContent || '').trim(),\\n    shinies: (Array.isArray(caps) ? caps : []).filter((c) => c && c.shiny).slice(0, 30).map((c) => ({ nome: c.nome, lv: c.level, em: c.em })) };\\n})()`;\\nconst shinyEst = ACCOUNTS.map(() => ({ chaves: null, vistos: null, pegos: null, hunt: '' }));\\nfunction avisarShiny(i, tipo, texto) {\\n  avisoCelular('shiny', tipo === 'visto' ? 'Shiny visto!' : 'Shiny pego!', texto);\\n  if (bandeja.notif) notificar(tipo === 'visto' ? '✨ Shiny visto!' : '🎉 Shiny capturado!', texto, i);\\n}\\nlet vigiaShinyRodando = false;\\nasync function vigiaShiny() {\\n  if (vigiaShinyRodando || sono.ausente || (!bandeja.notif && !monitor.ligado)) return;\\n  vigiaShinyRodando = true;\\n  try {\\n    for (let i = 0; i < ACCOUNTS.length; i++) {\\n      const wc = views[i] && views[i].webContents;\\n      if (!wc || wc.isDestroyed() || wc.isLoading()) continue;\\n      const r = await withTimeout(wc.executeJavaScript(SHINY_JS), 3000).catch(() => null);\\n      if (!r || !r.nick) continue;\\n      const e = shinyEst[i];\\n      const ondeTxt = r.hunt ? ` em ${r.hunt.split('·')[0].trim()}` : '';\\n      // capturados: shiny novo no histórico de capturas (funciona em qualquer modo)\\n      const chaves = r.shinies.map((c) => `${c.nome}|${c.em}`);\\n      let pegou = 0;\\n      if (e.chaves) r.shinies.forEach((c, k) => {\\n        if (e.chaves.has(chaves[k])) return;\\n        pegou++;\\n        avisarShiny(i, 'pego', `${nameOf(i)} capturou ${c.nome}${c.lv ? ' Nv ' + c.lv : ''}!`);\\n      });\\n      e.chaves = new Set([...(e.chaves || []), ...chaves]);\\n      // vistos (e pegos, se o histórico não avisou): contador da hunt, lido só quando a tela do Eco está aparecendo\\n      if (r.vistos != null) {\\n        const mesma = e.hunt === r.hunt;\\n        if (mesma && e.vistos != null && r.vistos > e.vistos) avisarShiny(i, 'visto', `${nameOf(i)}: apareceu um shiny${ondeTxt}!`);\\n        if (mesma && e.pegos != null && r.pegos > e.pegos && !pegou) avisarShiny(i, 'pego', `${nameOf(i)} capturou um shiny${ondeTxt}!`);\\n        e.vistos = r.vistos; e.pegos = r.pegos; e.hunt = r.hunt;\\n      }\\n    }\\n  } finally { vigiaShinyRodando = false; }\\n}\\n\\n// ---------- Termos de Uso (aceite obrigatório na 1ª vez e quando os termos mudarem) ----------\\n// Mude TERMS_VERSION sempre que alterar o texto: todo mundo terá de aceitar de novo.\\nconst TERMS_VERSION = '2';\\nconst TERMS_TEXT = [\\n  'TERMOS DE USO DO POKELINK',\\n  '',\\n  '1. O que é o PokeLink',\\n  'O PokeLink é um programa independente e não oficial, criado por Nations, que reúne contas do jogo PokeIdle em uma única janela. Ele não tem vínculo com a equipe do PokeIdle, com a Nintendo, Game Freak, Creatures, The Pokémon Company, Twitch, Kick ou Google. Todas as marcas citadas pertencem aos seus donos.',\\n  '',\\n  '2. Uso por sua conta e risco',\\n  'Funções automáticas (Auto Compra, abertura automática de lives, extensões e outras) podem não ser permitidas pelas regras do jogo ou das plataformas. Cabe a você conferir essas regras antes de usar. Advertências, suspensões, banimentos, perdas de itens, ouro, pontos ou progresso decorrentes do uso do PokeLink são de sua inteira responsabilidade.',\\n  '',\\n  '3. Suas contas e a segurança delas',\\n  'Os logins que você faz no PokeLink (jogo, Twitch, Kick e outros) ficam guardados apenas no seu computador. O desenvolvedor não recebe, não armazena e não tem acesso às suas senhas ou sessões. A segurança das contas é responsabilidade sua, incluindo: manter o computador livre de vírus e programas maliciosos, não compartilhar senhas e não compartilhar os textos de login exportados pelo PokeLink (eles dão acesso à conta).',\\n  '',\\n  '4. Seus dados',\\n  'O PokeLink não envia seus dados pessoais ao desenvolvedor. Para funcionar, ele se comunica diretamente com: pokeidle.io (o jogo e o tracker), Twitch, Kick, Chrome Web Store (extensões) e o endereço de atualizações do PokeLink. Cada um desses serviços tem suas próprias políticas de privacidade.',\\n  '',\\n  'Ver no celular (opcional, desligado por padrão): se você ligar essa função, um resumo das suas contas (nick, nível, ouro, XP, capturas, hunt atual, pontos das lives e avisos) é enviado a cada 20 segundos para um banco de dados do Google Firebase usado pelo PokeLink. O resumo fica guardado sob um código aleatório que só você conhece e pode ser visto por quem tiver esse código. Senhas e logins nunca são enviados. Ao desligar a função ou trocar o código, o resumo é apagado do servidor.',\\n  '',\\n  '5. Sem garantias',\\n  'O PokeLink foi testado, mas é fornecido \\\"no estado em que se encontra\\\", sem garantia de que funcionará sem erros, sem interrupções ou de que continuará compatível com o jogo e com as plataformas, que podem mudar a qualquer momento.',\\n  '',\\n  '6. Limitação de responsabilidade',\\n  'Na máxima extensão permitida pela lei, o desenvolvedor não se responsabiliza por danos diretos ou indiretos decorrentes do uso ou da impossibilidade de uso do PokeLink, incluindo perda ou invasão de contas, vazamento de dados causado por vírus, programas maliciosos, compartilhamento de logins ou falhas de segurança do seu computador, e ações de terceiros (jogo, plataformas, extensões).',\\n  '',\\n  '7. Extensões de terceiros',\\n  'As extensões que o PokeLink baixa da Chrome Web Store são feitas por terceiros. O desenvolvedor do PokeLink não controla nem responde pelo funcionamento delas. Você pode desativá-las em Ajuda > Extensões.',\\n  '',\\n  '8. Atualizações',\\n  'O PokeLink procura e instala atualizações assinadas pelo desenvolvedor. Ao usar o programa, você concorda em recebê-las.',\\n  '',\\n  '9. Mudanças nestes termos',\\n  'Estes termos podem mudar. Quando isso acontecer, o PokeLink pedirá um novo aceite. Se você não concordar, deve parar de usar o programa.',\\n  '',\\n  'Ao clicar em \\\"Aceitar\\\", você declara que leu, entendeu e concorda com estes Termos de Uso.',\\n].join('\\\\n');\\n// ---------- Novidades (patch notes) ----------\\n// As novidades de cada atualização ficam AQUI. Elas aparecem sozinhas uma vez, na primeira vez que o\\n// PokeLink abre numa versão nova (só para quem já usava; quem acabou de instalar vê os Termos de Uso).\\n// Também dá para abrir em Atualizações > Ver novidades. **texto** vira negrito.\\nconst NOVIDADES_HIST = [\\n{\\n  versao: '1.6',\\n  data: '09/11/2026',\\n  selo: 'ATUALIZAÇÃO GRANDE',\\n  titulo: 'POKELINK 1.6: VISUAL NOVO E AS LIVES REFEITAS',\\n  cartoes: [\\n    { icone: '🟣', valor: '100%', nome: 'Twitch refeita', sub: 'pontos, baú e resgate pelo jeito certo' },\\n    { icone: '📉', valor: '160p', nome: 'lives mais leves', sub: 'qualidade mínima de verdade' },\\n    { icone: '🕘', valor: '1', nome: 'histórico', sub: 'tudo o que acontece com as lives' },\\n  ],\\n  resumo: 'O PokeIdle mudou o jeito de dar o bônus das lives, então a **Twitch foi refeita do zero** e a **Kick ganhou o mesmo tratamento**. O PokeLink parou de clicar em botões na tela: agora ele conversa com a Twitch e a Kick do mesmo jeito que os sites conversam entre si, o que é mais rápido, gasta menos e não quebra quando eles mudam o layout. E tem **visual novo** em cinza e verde.',\\n  destaque: 'Abra o painel da Twitch pela setinha ▼ no botão da Twitch, e o **histórico das lives** no botão 🕘 da barra de baixo.',\\n  paginas: [\\n    { titulo: 'A TWITCH MUDOU (IMPORTANTE)', itens: [\\n      '**O bônus agora sai dos pontos do canal**, igual na Kick. A Twitch só conta quem está assistindo com o vídeo rodando: **ficar só no chat não ganha mais nada**.',\\n      '**Painel próprio da Twitch:** pontos de todos os canais (mesmo sem live aberta), quais canais farmar, resgate na hora e resgate automático por tipo de bônus.',\\n      '**Pacotes de várias horas:** cada canal oferece 1h, 3h, 5h ou 10h do mesmo bônus pelo mesmo preço por hora. O PokeLink lê o que cada canal tem e pega o maior pacote que o saldo der, o que rende mais tempo de bônus com os mesmos pontos.',\\n      '**Baú de bônus sozinho:** a cada ~15 minutos a Twitch solta um baú de 50 pontos, que quase dobra o ganho por hora. O PokeLink pega todos, inclusive passando pela checagem anti-robô da Twitch.',\\n      '**Máximo de 2 lives por conta:** a Twitch só conta até 2 ao mesmo tempo. Abrir mais faz nenhuma contar, então o PokeLink segura nesse número.',\\n    ] },\\n    { titulo: 'RESGATE QUE NÃO FALHA', itens: [\\n      '**Sem clicar na tela:** saldo, baú e resgate agora usam os mesmos pedidos que os botões dos sites fazem. Antes o PokeLink procurava o cartão certo no painel e clicava nele, e qualquer mudança de layout quebrava tudo.',\\n      '**Na Kick, ninguém mais é fechado:** antes, para resgatar, o PokeLink precisava fechar as lives da conta, abrir a página inteira do canal e clicar — perdendo o tempo já assistido. Agora o resgate sai de dentro da live que já está aberta.',\\n      '**Resgate mesmo com o canal fora do ar:** os pontos guardados num canal que saiu do ar não ficam mais parados esperando ele voltar. O PokeLink resgata assim que o saldo der.',\\n      '**Resgatar tudo:** segure Shift e clique em Resgatar no painel da Twitch. Ele mostra quantos bônus cabem no saldo daquele canal e quantas horas isso rende, e resgata um atrás do outro depois que você confirmar.',\\n      '**Aviso quando o bônus não entra:** se o PokeIdle devolver os pontos (a Twitch ou a Kick não vinculada naquela conta do jogo), o PokeLink avisa e **para de resgatar** nessa conta, em vez de torrar pontos a noite inteira sem nada entrar no jogo. Depois de vincular, mexa no botão do Auto Resgate para voltar.',\\n    ] },\\n    { titulo: 'LIVES MUITO MAIS LEVES', itens: [\\n      '**Vídeo na qualidade mínima de verdade:** antes a Twitch ignorava o pedido de qualidade baixa e mandava 1080p. Agora ela só tem como mandar a menor qualidade que o canal oferece, e isso corta bastante memória e processador quando há várias lives.',\\n      '**Só o player:** cada live da Twitch abre apenas o vídeo, sem o chat, sem a lista de canais e sem o resto do site. Se numa conta isso não render pontos, ela volta sozinha para a página do canal — você não precisa escolher nada.',\\n      '**Nada de imagem à toa:** avatares, miniaturas e emotes nem são baixados nas lives, que ficam escondidas e só existem para contar ponto.',\\n      '**Sem anúncios nem rastreadores:** a página de uma live chega a abrir dezenas de sites de fora. O PokeLink corta todos eles; o vídeo e a checagem de segurança passam normalmente.',\\n    ] },\\n    { titulo: 'QUANDO ALGO DÁ ERRADO', itens: [\\n      '**Histórico das lives:** o botão 🕘 na barra de baixo abre tudo o que aconteceu — live que parou, que voltou, que acabou, resgates, baús e recusas — com hora, conta e canal, e um filtro de \\\"só problemas\\\". A bolinha amarela no botão mostra quantas novidades surgiram desde a última vez que você olhou.',\\n      '**Live que não rende é recarregada:** não basta o vídeo estar tocando, a prova é o saldo subir. Se ele ficar parado por 20 minutos, aquela live é recarregada sozinha.',\\n      '**Recuperação sozinha:** se uma live cair ou travar, o PokeLink reabre só aquela, esperando 1, 2 e 4 minutos entre as tentativas seguidas.',\\n      '**Registro em arquivo:** cada resgate e cada baú ficam anotados em resgates.log, na pasta de dados, para conferir depois com calma.',\\n    ] },\\n    { titulo: 'VISUAL NOVO', itens: [\\n      '**Quatro jeitos de ver as contas:** grade, principal + 3, colunas e ampliado. A escolha fica na barra de baixo e é lembrada na próxima vez.',\\n      '**Barra de baixo:** layout, tamanho do jogo com os botões − e +, os modos Eco e o uso de CPU e memória do PokeLink, tudo à mão.',\\n      '**Uma engrenagem só:** todos os menus num lugar só, e os painéis da esquerda e da direita viram uma barra de ícones quando recolhidos.',\\n      '**Novidades numa tela só:** esta janela que você está lendo agora rola de cima a baixo, sem setas nem páginas escondendo metade do que mudou.',\\n    ] },\\n  ],\\n  botao: 'JOGAR',\\n},\\n{\\n  versao: '2.5',\\n  data: '31/10/2026',\\n  selo: 'ATUALIZAÇÃO',\\n  titulo: 'KICK MAIS LEVE, COMPRA MAIS ESPERTA',\\n  cartoes: [\\n    { icone: '📉', valor: '-28%', nome: 'memória da Kick', sub: 'por live escondida' },\\n    { icone: '🛒', valor: '0', nome: 'desligamentos', sub: 'a Auto Compra não para mais sozinha' },\\n    { icone: '🎨', valor: '12', nome: 'ícones novos', sub: 'direto do jogo, no Market' },\\n  ],\\n  resumo: 'A live escondida da Kick agora gasta bem menos memória e processador. A **Auto Compra** ficou mais confiável (não se desliga mais sozinha e corrigi um bug de compra) e ganhou um **visual novo**, mais simples e com os ícones de verdade do jogo.',\\n  destaque: 'Dá uma olhada em **Auto Compra > Configurações**: a lista \\\"O que comprar\\\" agora é em cartões, com a imagem de cada pokébola e poção igual ao Market do jogo.',\\n  paginas: [\\n    { titulo: 'KICK MAIS LEVE', itens: [\\n      '**Menos memória:** a live que fica escondida (só para contar os pontos) agora carrega na qualidade mais baixa de vídeo, já que ninguém a vê de verdade.',\\n      '**Sem perda nenhuma:** os pontos continuam contando normalmente; só o consumo do computador caiu.',\\n    ] },\\n    { titulo: 'AUTO COMPRA MAIS CONFIÁVEL', itens: [\\n      '**Não desliga mais sozinha:** antes, depois de 3 falhas seguidas, ela se desligava por segurança. Agora ela só continua tentando de 5 em 5 minutos, sem desistir.',\\n      '**Bug corrigido:** quando o jogo ajustava sozinho a quantidade digitada no Market, a compra travava achando que algo tinha dado errado. Agora ela confere o número que o jogo realmente aceitou.',\\n      '**Mais simples:** o Modo Teste e a Segurança (reserva de ouro, limite por hora) saíram da tela — ela já compra de verdade, usando o ouro que a conta tiver.',\\n    ] },\\n    { titulo: 'VISUAL NOVO', itens: [\\n      '**Ícones de verdade:** pokébolas, poções e revives agora aparecem com a imagem de cada item, puxada direto do jogo.',\\n      '**Cartões em vez de lista:** o mesmo estilo dos cartões do Market oficial, mantendo a moldura dourada do PokeLink.',\\n    ] },\\n    { titulo: 'EM BREVE', itens: [\\n      '**Auto Resgate da Kick:** estou preparando um jeito de resgatar os bônus (300/500/1.000 pontos) automaticamente, sem precisar abrir nenhuma janela.',\\n    ] },\\n  ],\\n  botao: 'JOGAR',\\n},\\n{\\n  versao: '2.2.1',\\n  data: '22/10/2026',\\n  selo: 'ATUALIZAÇÃO',\\n  titulo: 'SEU FARM NA PALMA DA MÃO',\\n  cartoes: [\\n    { icone: '📱', valor: '20 s', nome: 'contas no celular', sub: 'quase em tempo real' },\\n    { icone: '✨', valor: 'shiny', nome: 'vistos e pegos', sub: 'em destaque' },\\n    { icone: '⚔️', valor: 'PvP', nome: 'análise refeita', sub: 'só números reais' },\\n  ],\\n  resumo: 'Agora dá para **acompanhar as 4 contas pelo celular**, de qualquer lugar, com shiny, XP e avisos chegando na hora. O **Mega Eco** e o **PvP** ganharam um visual novo e muito mais claro, e as contas podem **trocar de hunt sozinhas**.',\\n  destaque: 'Clique no botão **📱** na barra de qualquer conta, depois em **Ligar**, e aponte a câmera do celular para o QR code. Pronto!',\\n  paginas: [\\n    { titulo: 'VER NO CELULAR', itens: [\\n      '**Como ligar:** botão 📱 na barra de qualquer conta (ou Contas > Ver no celular) > Ligar. Leia o QR code com a câmera, ou abra **znationsx.github.io/pokelink-monitor** e digite o código.',\\n      '**Quase em tempo real:** os números atualizam a cada 20 segundos e o celular recebe na hora, sem precisar recarregar.',\\n      '**Cada conta com o seu perfil:** retrato do treinador, nível e a barra de XP igual à do jogo, com quanto falta para o próximo nível.',\\n      '**Shiny em destaque:** painel dourado com os shiny **vistos** e **pegos** da hunt, somando as 4 contas e em cada uma.',\\n      '**Avisos na hora:** shiny visto, shiny pego, conta travada, meta da Kick, hunt trocada e Auto Compra parada.',\\n      '**Dica:** no celular, use \\\"Adicionar à tela inicial\\\" para virar um ícone, como um app. A página se atualiza sozinha quando sai versão nova.',\\n    ] },\\n    { titulo: 'SEGURANÇA DO CELULAR', itens: [\\n      '**Desligado por padrão:** nada é enviado até você clicar em Ligar. O botão 📱 fica com uma bolinha verde enquanto está ligado.',\\n      '**Só para ver:** pelo celular não dá para mexer em nada.',\\n      '**Código só seu:** o resumo fica guardado sob um código aleatório de 20 letras e números. Só quem tem o código vê.',\\n      '**Trocar código:** se alguém viu o seu código, um clique cria outro e o antigo para de funcionar.',\\n      '**Senhas nunca saem do PC:** só o resumo é enviado. Ao desligar, ele é apagado do servidor. Os Termos de Uso foram atualizados com essa função.',\\n    ] },\\n    { titulo: 'BANDEJA E NOTIFICAÇÕES', itens: [\\n      '**Fechou, continua farmando:** o X esconde o PokeLink na bandeja do Windows (perto do relógio, na setinha ^). As contas, as lives e o celular continuam funcionando.',\\n      '**Clique no ícone** para abrir de novo. **Clique direito** para o menu rápido: celular, desempenho, som e **Sair do PokeLink**, que fecha de vez.',\\n      '**Notificação de shiny:** o Windows avisa quando uma conta **vê** ou **captura** um shiny. Clicando no aviso, o PokeLink abre naquela conta.',\\n      '**Você escolhe:** \\\"Ao fechar, continuar rodando na bandeja\\\" fica em Desempenho, e as notificações em Contas. Dá para desligar os dois.',\\n    ] },\\n    { titulo: 'MEGA ECO NOVO', itens: [\\n      '**Visual novo**, no mesmo estilo do celular: cada conta num cartão organizado, do mais importante para o detalhe.',\\n      '**Topo:** painel de **shiny da hunt** (vistos e pegos) e o **ritmo agora** das contas (ouro/h, XP/h, capturas e ouro total).',\\n      '**Cada conta:** retrato do treinador, nick inteiro, nível, barra de XP, hunt e status, bônus ativos, shiny da hunt, os números principais e o pokémon em campo.',\\n      '**Últimas capturas com a figurinha** do pokémon, IV e qualidade, além de achados e gastos.',\\n      '**Quase em tempo real:** o painel atualiza a cada 2 segundos.',\\n    ] },\\n    { titulo: 'PVP REFEITO', itens: [\\n      '**Análise com números reais** das partidas guardadas: saldo de PR, vitórias, dano, abates e quem caiu. Nada de \\\"chute\\\" por tipo.',\\n      '**Período:** veja Hoje, 7 dias ou Tudo.',\\n      '**Rivais e presas:** de quem você mais perde e mais ganha PR, com a maior ameaça de cada rival e o time seu que mais venceu contra ele.',\\n      '**Aberturas:** qual 1º e 2º pokémon rendem mais PR por partida.',\\n      '**Seu time:** quanto do dano cada pokémon faz, abates, quantas vezes fica de pé e como vai abrindo o time. **Ameaças:** quem mais derruba o seu time.',\\n      '**Últimas 20** em quadradinhos V/D, com o adversário e o PR de cada uma.',\\n    ] },\\n    { titulo: 'TROCA DE HUNT AUTOMÁTICA', itens: [\\n      '**Botão novo na barra de cada conta:** \\\"Troca de hunt\\\". Clique no nome para ligar ou desligar naquela conta; a setinha abre as configurações.',\\n      '**Como funciona:** o PokeLink lê o ranking da /hunt e leva a conta para a melhor hunt, pelo Mapa, como um jogador faria.',\\n      '**Você escolhe:** mais XP/h ou mais ouro/h, risco máximo, quanto a hunt nova precisa ganhar e de quanto em quanto tempo conferir.',\\n      '**Seguro:** só hunts liberadas, nunca em combate nem com uma janela do jogo aberta, e espera 10 minutos entre trocas.',\\n    ] },\\n    { titulo: 'OUTRAS MELHORIAS', itens: [\\n      '**Painel das Lives novo:** resumo em números no topo, uma tabela para ligar e desligar por conta e a lista de canais com quem está ao vivo.',\\n      '**Menus mais organizados:** ajustes e logins da Kick e da Twitch agrupados em Lives, tamanho do jogo e tela cheia em Contas. O número em cima do menu Lives saiu.',\\n      '**Tela apagando:** as lives tocam com o volume zerado por dentro, e o Windows volta a apagar a tela normalmente com o farm rodando. A opção \\\"Deixar a tela apagar\\\" saiu do menu.',\\n      '**Novidades sempre aparecem**, mesmo quando os Termos de Uso mudam. Use o seletor no topo deste card para ver as versões anteriores.',\\n    ] },\\n  ],\\n  botao: 'JOGAR',\\n},\\n{\\n  versao: '2.0',\\n  data: '20/10/2026',\\n  selo: 'ATUALIZAÇÃO',\\n  titulo: 'LIVES MAIS LEVES E MAIS ESPERTAS',\\n  cartoes: [\\n    { icone: '📺', valor: '−55%', nome: 'memória da Kick', sub: 'player pequeno' },\\n    { icone: '💬', valor: '−80%', nome: 'memória da Twitch', sub: 'conexão direta' },\\n    { icone: '⚡', valor: '20 s', nome: 'para abrir a live', sub: 'lista direto do jogo' },\\n  ],\\n  resumo: 'Agora o PokeLink sabe **direto do jogo** quais são os canais oficiais e quem está ao vivo. As lives abrem mais rápido, gastam bem menos memória, ex-parceiros somem sozinhos e as contas travadas se recuperam sem precisar fechar o programa.',\\n  destaque: 'Bloqueou o PC (Windows+L)? Agora **a tela apaga normalmente e o farm continua** rodando por trás. Ao voltar, tudo aparece de novo.',\\n  paginas: [\\n    { titulo: 'LIVES PELO JOGO', itens: [\\n      '**Lista oficial direto do jogo:** os canais parceiros e quem está ao vivo chegam pela própria conexão do jogo, sempre atualizados.',\\n      '**Lives abrem em até 20 segundos** quando um canal entra no ar (antes podia levar até 3 minutos).',\\n      '**Sem página escondida da Kick:** a verificação que abria o site inteiro da Kick a cada 3 minutos acabou, e com ela os picos de processador.',\\n      '**Twitch confirmada pelo jogo:** o painel Lives mostra \\\"✓ o jogo já está contando o bônus em: ...\\\" para você ter certeza de que está valendo.',\\n      '**Plano B:** se o jogo parar de informar as lives, o PokeLink volta sozinho para o jeito antigo de verificar. Nada para de funcionar.',\\n    ] },\\n    { titulo: 'EX-PARCEIROS', itens: [\\n      '**Saem sozinhos:** quem deixou de ser parceiro oficial some da lista, a live fecha e sai da seleção \\\"Ativado\\\". Quem voltar a ser parceiro volta sozinho.',\\n      '**Tirar à mão:** um **×** em cada canal no painel de Pontos da Kick e na nova seção \\\"Canais oficiais\\\" do painel Lives (Twitch e Kick).',\\n      '**Trazer de volta:** os removidos ficam riscados em \\\"Removidos da lista\\\", com um clique para voltar. Se você trouxer de volta, a remoção automática não mexe mais nele.',\\n      '**Conferir lista:** botão novo no painel Lives. Se o jogo não informar a lista, o PokeLink abre o painel de bônus escondido ao abrir e a cada 3 horas, sem atrapalhar.',\\n    ] },\\n    { titulo: 'KICK E TWITCH MAIS LEVES', itens: [\\n      '**Kick com player pequeno:** só o vídeo, num tamanho menor, em vez da página inteira. Gasta bem menos memória e internet.',\\n      '**Plano B da Kick:** se numa conta os pontos não subirem em 15 minutos, aquela conta volta sozinha para a página inteira. Escolha em Lives > Lives da Kick.',\\n      '**Saldo da Kick direto da Kick:** os pontos são consultados com o login da conta, sem ler de dentro da live, e os canais offline também são atualizados a cada 15 minutos.',\\n      '**Twitch automática (novo padrão):** uma única conexão de chat por conta, sem nenhuma página aberta. Se o jogo não contar o bônus em 12 minutos, a conta volta sozinha para a página do chat.',\\n      'As trocas automáticas ficam anotadas no arquivo **travamentos.log**, dizendo qual conta mudou e por quê.',\\n    ] },\\n    { titulo: 'TELA E ENERGIA', itens: [\\n      '**A tela apaga com o farm rodando:** ao bloquear o PC ou ficar sem mexer até o horário de a tela apagar, o PokeLink esconde a janela e o Windows apaga o monitor. O jogo e as lives continuam.',\\n      '**Volta na hora:** ao desbloquear ou mexer no mouse/teclado, a janela aparece de novo em até 2 segundos.',\\n      '**Kick contando com a tela apagada:** as lives da Kick continuam se considerando visíveis com a janela escondida.',\\n      '**Opção em Desempenho:** \\\"Deixar a tela apagar (o farm continua)\\\", ligada por padrão.',\\n      '**Pausar o farm para o PC dormir:** opção nova (desligada por padrão). Segue o tempo de suspensão do Windows e, ao voltar, as contas recarregam sozinhas.',\\n    ] },\\n    { titulo: 'ESTABILIDADE', itens: [\\n      '**Vigia anti-travamento:** a cada 30 segundos o PokeLink confere se cada conta responde. Se uma conta congelar, só ela é reiniciada sozinha, sem fechar o programa.',\\n      '**Sem pedidos presos:** a leitura do nome da conta e a Auto Compra agora têm limite de tempo. Uma conta travada não acumula pedidos nem deixa a Auto Compra parada para sempre.',\\n      '**Leitura mais leve dos canais:** a busca de canais só varre a tela quando o painel de bônus está aberto (antes pesava cada vez mais com o jogo aberto por horas).',\\n      '**Registro de travamentos:** cada travamento e recuperação fica anotado no **travamentos.log**, na pasta de dados do PokeLink.',\\n    ] },\\n    { titulo: 'PAINÉIS E FERRAMENTAS', itens: [\\n      '**Uso de CPU e memória em cartões:** desce dentro da janela, com cada conta e cada grupo num cartão. **Verde** ok, **amarelo** médio e **vermelho** alto. Atualiza sozinho a cada 5 segundos.',\\n      '**Medição correta:** agora mostra a memória real de cada parte (a mesma do Gerenciador de Tarefas), quanto gasta cada live e o grupo \\\"Outros\\\", com o que tem dentro.',\\n      '**Extensões por conta:** o painel de Extensões mostra em quais contas cada extensão carregou (bolinha verde ou vermelha).',\\n      '**Reparar só nesta conta:** se uma extensão não funcionar numa conta, ela é tirada, limpa e colocada de novo só ali. O login do jogo e as outras contas não mudam.',\\n      '**Novidades:** este card aparece uma vez a cada versão nova e pode ser aberto de novo em Atualizações > Ver novidades desta versão.',\\n    ] },\\n  ],\\n  botao: 'JOGAR',\\n},\\n];\\nconst novidadesFile = () => path.join(app.getPath('userData'), 'novidades.json');\\nfunction showNovidades() {\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (!canDraw) return false;\\n  const id = ++cfgPanelSeq;\\n  cfgPanels.add(id);\\n  dialogOpen = true;\\n  layout();\\n  titleBar.webContents.focus();\\n  const k = Math.max(0, NOVIDADES_HIST.findIndex((n) => n.versao === APP_LABEL));\\n  titleBar.webContents.send('title-novidades', { id, canal: APP_CHANNEL, atual: k,\\n    lista: NOVIDADES_HIST.map((n) => Object.assign({}, n, { versao: `v${n.versao}${APP_CHANNEL ? ' ' + APP_CHANNEL : ''}` })) });\\n  try { fs.writeFileSync(novidadesFile(), JSON.stringify({ versao: APP_LABEL })); } catch {}\\n  return true;\\n}\\n// mostra uma vez por versão; quem acabou de instalar só marca como vista\\nfunction talvezNovidades(jaUsava) {\\n  let vista = null;\\n  try { vista = JSON.parse(fs.readFileSync(novidadesFile(), 'utf8')).versao; } catch {}\\n  if (vista === APP_LABEL) return;\\n  if (!jaUsava) { try { fs.writeFileSync(novidadesFile(), JSON.stringify({ versao: APP_LABEL })); } catch {} return; }\\n  setTimeout(showNovidades, 2500);\\n}\\nconst termsFile = () => path.join(app.getPath('userData'), 'termos.json');\\nconst termsAccepted = () => { try { return JSON.parse(fs.readFileSync(termsFile(), 'utf8')).versao === TERMS_VERSION; } catch { return false; } };\\nasync function askTerms() {\\n  if (termsAccepted()) return true;\\n  for (;;) {\\n    const r = await uiDialog({\\n      type: 'info',\\n      title: 'Termos de Uso',\\n      message: 'Antes de começar, leia e aceite os Termos de Uso',\\n      detail: TERMS_TEXT,\\n      form: [{ id: 'li', label: 'Li e aceito os Termos de Uso', type: 'check', value: false }],\\n      buttons: ['Aceitar', 'Recusar e sair'],\\n      defaultId: 0,\\n      cancelId: 1,\\n    });\\n    if (r.response !== 0) { app.quit(); return false; }\\n    if (r.values && r.values.li) {\\n      try { fs.writeFileSync(termsFile(), JSON.stringify({ versao: TERMS_VERSION, em: new Date().toISOString(), app: APP_VERSION })); } catch {}\\n      return true;\\n    }\\n    await uiDialog({ type: 'warning', title: 'Termos de Uso', message: 'Marque \\\"Li e aceito os Termos de Uso\\\" para continuar.' });\\n  }\\n}\\nfunction showTerms() {\\n  uiDialog({ type: 'info', title: 'Termos de Uso', message: 'Termos de Uso do PokeLink', detail: TERMS_TEXT });\\n}\\n\\n// ---------- Janela ----------\\nfunction createWindow() {\\n  loadRef();\\n  loadNicks();\\n  loadAuto();\\n  loadAutoHunt();\\n  loadLives();\\n  loadOtimizar();\\n  otimizarAuto.forEach((min, i) => { if (min > 0) setOtimizarAuto(i, min); });\\n  loadLearnedChannels();\\n  loadRemovidos();\\n  loadSono();\\n  loadMonitor();\\n  loadHistorico();\\n  loadBandeja();\\n  win = new BaseWindow({\\n    width: 1600, height: 900, title: APP_NAME, backgroundColor: GAP_BG,\\n    titleBarStyle: 'hidden', // esconde a barra nativa (título + menu)\\n    titleBarOverlay: { color: TITLE_BG, symbolColor: TITLE_FG, height: TITLE_H }, // mantém min/max/fechar\\n  });\\n\\n  views = ACCOUNTS.map((name, i) => {\\n    const view = new WebContentsView({\\n      webPreferences: {\\n        partition: `persist:conta${i + 1}`, // cookies/login próprios de cada conta\\n        backgroundThrottling: false,        // não pausa quando a view não está visível\\n      },\\n    });\\n    view.webContents.on('did-fail-load', () => {}); // ignora recursos bloqueados (ex: tracker)\\n    // ignora o \\\"tem certeza que quer sair desta página?\\\" do jogo (ele bloqueava o recarregar)\\n    view.webContents.on('will-prevent-unload', (e) => e.preventDefault());\\n    // se a página da conta travar de vez ou fechar sozinha, carrega de novo\\n    view.webContents.on('render-process-gone', (_, d) => {\\n      if (d.reason !== 'clean-exit' && !view.webContents.isDestroyed()) setTimeout(() => view.webContents.loadURL(GAME_URL).catch(() => {}), 1000);\\n    });\\n    view.webContents.on('unresponsive', () => { if (!travada[i]) { travada[i] = Date.now(); logTravamento(`${nameOf(i)} parou de responder`); } });\\n    view.webContents.on('responsive', () => { if (travada[i]) logTravamento(`${nameOf(i)} voltou sozinha`); travada[i] = null; });\\n    // mostra na barra que a conta está carregando (ícone girando)\\n    view.webContents.on('did-start-loading', () => { if (!loading[i]) { loading[i] = true; sendState(); } });\\n    view.webContents.on('did-stop-loading', () => { if (loading[i]) { loading[i] = false; sendState(); } });\\n    view.webContents.on('did-finish-load', layout);\\n    view.webContents.on('did-finish-load', () => setTimeout(() => readNick(i), 2500));\\n    view.webContents.on('did-navigate', layout);\\n    view.webContents.on('dom-ready', () => { ecoCss[i] = null; applyLevel(i); }); // reaplica o nível após recarregar\\n    devKeys(view.webContents);\\n    ligarLeituraLives(view.webContents); // lê as lives pela conexão do jogo\\n    view.webContents.loadURL(GAME_URL);\\n    win.contentView.addChildView(view);\\n    return view;\\n  });\\n\\n  bars = ACCOUNTS.map((name, i) => {\\n    const b = new WebContentsView({\\n      webPreferences: { preload: path.join(__dirname, 'preload.js') },\\n    });\\n    devKeys(b.webContents);\\n    b.webContents.loadFile(path.join(__dirname, 'bar.html'), { query: { i: String(i) } });\\n    win.contentView.addChildView(b);\\n    return b;\\n  });\\n\\n  titleBar = new WebContentsView({\\n    webPreferences: { preload: path.join(__dirname, 'preload.js') },\\n  });\\n  titleBar.setBackgroundColor('#00000000'); // transparente: quando o menu abre, o jogo continua aparecendo atrás\\n  devKeys(titleBar.webContents);\\n  titleBar.webContents.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'title' } });\\n  // termos de uso: pede o aceite assim que a barra de cima (que desenha o pop-up) estiver pronta\\n  titleBar.webContents.once('did-finish-load', () => setTimeout(async () => {\\n    // já tinha aceitado alguma versão dos termos = já usava (atualizou) e deve ver as novidades\\n    const jaUsava = (() => { try { return fs.statSync(termsFile()).isFile(); } catch { return false; } })();\\n    if (await askTerms()) talvezNovidades(jaUsava);\\n  }, 600));\\n  win.contentView.addChildView(titleBar);\\n\\n  applyWindowIcon(); // ícone personalizado também na barra de tarefas\\n\\n  win.on('resize', layout);\\n  win.on('enter-full-screen', layout);\\n  win.on('leave-full-screen', layout);\\n  layout();\\n\\n  buildMenu();\\n\\n  startAutoBuyTimer();\\n  startAutoHuntTimer();\\n  startNickTimer();\\n\\n  // começa com as contas 2, 3 e 4 sem som\\n  muted.forEach((m, i) => views[i].webContents.setAudioMuted(m));\\n}\\n\\napp.whenReady().then(async () => {\\n  // extensões: carrega as cópias locais antes das contas abrirem e procura atualização em segundo plano\\n  const extFaltando = await loadLocalExtensions();\\n  createWindow();\\n  updateExtensions(extFaltando);\\n  win.on('closed', () => app.quit()); // fecha tudo junto (inclusive janelas de login abertas)\\n  setTimeout(checkLives, 3000); // já verifica logo ao abrir\\n  setInterval(checkLives, LIVE_CHECK_MIN * 60 * 1000);\\n  setInterval(vigiaContas, 30 * 1000); // vigia anti-travamento\\n  lerTempoWindows(); setInterval(lerTempoWindows, 10 * 60 * 1000); // tempo para dormir do Windows\\n  setInterval(checarAusencia, 30 * 1000);\\n  manterPcAcordado();\\n  lerTempoTela(); setInterval(lerTempoTela, 10 * 60 * 1000);\\n  setInterval(checarTela, 2000); // leve: só pergunta ao Windows há quanto tempo ninguém mexe\\n  powerMonitor.on('lock-screen', () => { tela.bloqueada = true; apagarTela(); });\\n  powerMonitor.on('unlock-screen', () => { tela.bloqueada = false; acenderTela(); });\\n  powerMonitor.on('resume', () => { sono.naoRepetir = false; voltarDoAusente(); }); // PC acordou\\n  powerMonitor.on('on-ac', () => { lerTempoWindows(); lerTempoTela(); }); powerMonitor.on('on-battery', () => { lerTempoWindows(); lerTempoTela(); });\\n  sampleUsage(); setInterval(() => { sampleUsage(); sendTitleFoco(); sendBottomBar(); sendState(); }, 5000); // mede CPU/memória de cada conta\\n  setInterval(refreshDash, 5000); // Mega Eco: atualiza o painel (só com o Mega Eco ligado)\\n  // canais novos: o painel \\\"Bônus Twitch/Kick\\\" é lido a cada 20 s, e a lista do servidor a cada 10 min\\n  setInterval(async () => { if (LIVE_PLATS().length && (await discoverChannels())) checkLives(); }, 20 * 1000);\\n  setInterval(learnFromApi, 10 * 60 * 1000);\\n  setTimeout(conferirListaOficial, 45 * 1000); // confere a lista oficial ao abrir (com o jogo já carregado)...\\n  setInterval(conferirListaOficial, 3 * 3600 * 1000); // ...e a cada 3 horas\\n  views.forEach((_, i) => watchGameApi(i));\\n  views.forEach((_, i) => watchKickRequests(i)); // Kick leve: corta imagens, fontes e rastreadores nas lives\\n  setTimeout(pvpCollectAll, 60 * 1000); // PvP: guarda as partidas novas de cada conta\\n  setTimeout(() => checkOnlineUpdate(false), 20 * 1000); // atualização online: confere ao abrir...\\n  setInterval(() => checkOnlineUpdate(false), UPDATE_CHECK_HOURS * 3600 * 1000); // ...e de tempos em tempos\\n  setInterval(pollKickPoints, KICK_POLL_SEC * 1000); // pontos da Kick em tempo real\\n  setInterval(pollTwitchPoints, TWITCH_POLL_SEC * 1000); // pontos da Twitch em tempo real\\n  setInterval(vigiarLives, LIVE_VIGIA_SEG * 1000); // live caída ou com o vídeo parado: recarrega só ela\\n  setInterval(liberarMemoriaUI, 60 * 1000); // devolve a memória que as barras e painéis deixam de lixo\\n  setInterval(pvpCollectAll, PVP_EVERY_MIN * 60 * 1000);\\n  criarBandeja(); // ícone perto do relógio (fechar no X deixa rodando aqui)\\n  setInterval(vigiaShiny, 15 * 1000); // notificações de shiny visto/capturado\\n  setTimeout(() => monitorEnviar(true), 40 * 1000); // ver no celular: 1º envio com o jogo já carregado...\\n  setInterval(() => monitorEnviar(false), 5 * 1000); // ...e depois a cada 20 segundos\\n});\\napp.on('window-all-closed', () => app.quit());\",\"preload.js\":\"const { contextBridge, ipcRenderer } = require('electron');\\n\\ncontextBridge.exposeInMainWorld('api', {\\n  // barra de cada conta\\n  setLevel: (i, lv) => ipcRenderer.send('level-set', i, lv),\\n  perfMenu: (i, rect) => ipcRenderer.send('perf-menu', i, rect || null),\\n  setAuto: (i, on) => ipcRenderer.send('auto-set', i, on),\\n  setLives: (i, plat, on) => ipcRenderer.send('lives-set', i, plat, on),\\n  openAutoConfig: (rect) => ipcRenderer.send('auto-config', rect || null),\\n  onAutoCfg: (cb) => ipcRenderer.on('title-autocfg', (_, d) => cb(d)),\\n  autoCfgClosed: (id) => ipcRenderer.send('title-autocfg-closed', id),\\n  autoRunNow: (i) => ipcRenderer.send('auto-run-now', i),\\n  autoLog: () => ipcRenderer.send('auto-log'),\\n  setView: (i) => ipcRenderer.send('view-set', i),\\n  reload: (i) => ipcRenderer.send('reload-account', i),\\n  toggleMute: (i) => ipcRenderer.send('mute-toggle', i),\\n  ready: () => ipcRenderer.send('bar-ready'),\\n  onState: (cb) => ipcRenderer.on('state', (_, s) => cb(s)),\\n  // janela de configuração da Auto Compra\\n  autoGet: (defaults, conta) => ipcRenderer.invoke('autocfg-get', !!defaults, Number.isInteger(conta) ? conta : null),\\n  autoSave: (c, conta, todas) => ipcRenderer.invoke('autocfg-save', c, Number.isInteger(conta) ? conta : null, !!todas),\\n  marketIconsGet: () => ipcRenderer.invoke('market-icons-get'),\\n  marketIconsCapture: (conta) => ipcRenderer.invoke('market-icons-capture', conta),\\n  closeSelf: () => ipcRenderer.send('close-self'),\\n  // Mega Eco (resumo do farm)\\n  onResumo: (cb) => ipcRenderer.on('resumo', (_, d) => cb(d)),\\n  resumoReady: () => ipcRenderer.send('resumo-ready'),\\n  resumoNivel: (i, lv) => ipcRenderer.send('resumo-nivel', i, lv),\\n  cenaToggle: (i) => ipcRenderer.send('cena-toggle', i),\\n  // pontos da Kick\\n  kickGet: () => ipcRenderer.invoke('kick-get'),\\n  kickRefresh: () => ipcRenderer.invoke('kick-refresh'),\\n  kickRedeem: (i) => ipcRenderer.send('kick-redeem', i),\\n  kickRedeemLive: (i, slug) => ipcRenderer.send('kick-redeem-live', i, slug),\\n  kickSel: (i, slug) => ipcRenderer.send('kick-sel', i, slug),\\n  kickAvisos: (on) => ipcRenderer.send('kick-avisos', !!on),\\n  kickAutoResgate: (on) => ipcRenderer.send('kick-auto-resgate', !!on),\\n  kickResgateTier: (pts, on) => ipcRenderer.send('kick-resgate-tier', pts, !!on),\\n  kickOpen: (i, rect) => ipcRenderer.send('kick-open', i, rect || null),\\n  onKickPanel: (cb) => ipcRenderer.on('title-kick', (_, d) => cb(d)),\\n  onLivesPanel: (cb) => ipcRenderer.on('title-lives', (_, d) => cb(d)),\\n  onExtsPanel: (cb) => ipcRenderer.on('title-exts', (_, d) => cb(d)),\\n  onExtsUpdate: (cb) => ipcRenderer.on('exts-update', () => cb()),\\n  extGet: () => ipcRenderer.invoke('ext-get'),\\n  extAction: (id, acao) => ipcRenderer.send('ext-action', id, acao),\\n  onLivesUpdate: (cb) => ipcRenderer.on('lives-update', () => cb()),\\n  livesGet: () => ipcRenderer.invoke('lives-get'),\\n  livesCheckNow: () => ipcRenderer.invoke('lives-check-now'),\\n  kickDiag: () => ipcRenderer.invoke('kick-diag'),\\n  canalRemover: (plat, slug) => ipcRenderer.send('canal-remover', plat, slug),\\n  canalVoltar: (plat, slug) => ipcRenderer.send('canal-voltar', plat, slug),\\n  listaConferir: () => ipcRenderer.invoke('lista-conferir'),\\n  onUsoPanel: (cb) => ipcRenderer.on('title-uso', (_, d) => cb(d)),\\n  usoGet: () => ipcRenderer.invoke('uso-get'),\\n  onNovidades: (cb) => ipcRenderer.on('title-novidades', (_, d) => cb(d)),\\n  onAutoHuntPanel: (cb) => ipcRenderer.on('title-autohunt', (_, d) => cb(d)),\\n  onHuntUpdate: (cb) => ipcRenderer.on('hunt-update', () => cb()),\\n  huntGet: () => ipcRenderer.invoke('hunt-get'),\\n  huntSet: (d) => ipcRenderer.send('hunt-set', d),\\n  huntAgora: (i) => ipcRenderer.invoke('hunt-agora', i),\\n  huntPanel: () => ipcRenderer.send('hunt-panel'),\\n  onKickUpdate: (cb) => ipcRenderer.on('kick-update', () => cb()),\\n  // pontos da Twitch (painel próprio, igual ao da Kick)\\n  twitchGet: () => ipcRenderer.invoke('twitch-get'),\\n  twitchRefresh: () => ipcRenderer.invoke('twitch-refresh'),\\n  twitchSel: (i, slug) => ipcRenderer.send('twitch-sel', i, slug),\\n  twitchRedeemLive: (i, slug, lote) => ipcRenderer.send('twitch-redeem-live', i, slug, !!lote),\\n  twitchAvisos: (on) => ipcRenderer.send('twitch-avisos', !!on),\\n  twitchAutoResgate: (on) => ipcRenderer.send('twitch-auto-resgate', !!on),\\n  twitchPacotes: (on) => ipcRenderer.send('twitch-pacotes', !!on),\\n  twitchMax: (n) => ipcRenderer.send('twitch-max', n),\\n  twitchResgateTier: (id, on) => ipcRenderer.send('twitch-resgate-tier', id, !!on),\\n  twitchDiag: () => ipcRenderer.invoke('twitch-diag'),\\n  twitchOpen: () => ipcRenderer.send('twitch-open'),\\n  onTwitchUpdate: (cb) => ipcRenderer.on('twitch-update', () => cb()),\\n  // histórico das lives (o que parou, o que voltou, resgates e baús)\\n  histOpen: () => ipcRenderer.send('historico-open'),\\n  histGet: () => ipcRenderer.invoke('historico-get'),\\n  histLimpar: () => ipcRenderer.send('historico-limpar'),\\n  histVisto: () => ipcRenderer.send('historico-visto'),\\n  onHistUpdate: (cb) => ipcRenderer.on('historico-update', (_, d) => cb(d)),\\n  // Otimizar a conta (recarrega pra liberar memória, mantendo o login)\\n  otimizarOpen: (i, rect) => ipcRenderer.send('otimizar-open', i, rect || null),\\n  onOtimizarPanel: (cb) => ipcRenderer.on('title-otimizar', (_, d) => cb(d)),\\n  onOtimizarUpdate: (cb) => ipcRenderer.on('otimizar-update', () => cb()),\\n  otimizarGet: (i) => ipcRenderer.invoke('otimizar-get', i),\\n  otimizarAgora: (i) => ipcRenderer.invoke('otimizar-agora', i),\\n  otimizarAuto: (i, min) => ipcRenderer.send('otimizar-auto', i, min),\\n  otimizarPagina: (i, modo) => ipcRenderer.send('otimizar-pagina', i, modo),\\n  // ver no celular (PokeLink Monitor)\\n  onMonitorPanel: (cb) => ipcRenderer.on('title-monitor', (_, d) => cb(d)),\\n  onMonitorUpdate: (cb) => ipcRenderer.on('monitor-update', () => cb()),\\n  monitorGet: () => ipcRenderer.invoke('monitor-get'),\\n  monitorAcao: (acao) => ipcRenderer.invoke('monitor-acao', acao),\\n  monitorPanel: () => ipcRenderer.send('monitor-panel'),\\n  // análise de PvP\\n  pvpGet: (i, force) => ipcRenderer.invoke('pvp-get', i, !!force),\\n  onPvpAccount: (cb) => ipcRenderer.on('pvp-account', (_, i) => cb(i)),\\n  // barra de título customizada\\n  titleReady: () => ipcRenderer.send('title-ready'),\\n  titleOpen: (open) => ipcRenderer.send('title-open', !!open),\\n  titleClick: (pathIdx) => ipcRenderer.send('title-click', pathIdx),\\n  showAbout: () => ipcRenderer.send('show-about'),\\n  onDialog: (cb) => ipcRenderer.on('title-dialog', (_, d) => cb(d)),\\n  onPopup: (cb) => ipcRenderer.on('title-popup', (_, d) => cb(d)),\\n  popupReply: (id, value) => ipcRenderer.send('title-popup-reply', id, value),\\n  openLivePage: (i, plat, c) => ipcRenderer.send('live-page-open', i, plat, c),\\n  openExt: (i, id) => ipcRenderer.send('ext-open', i, id),\\n  onDialogClose: (cb) => ipcRenderer.on('title-dialog-close', (_, id) => cb(id)),\\n  dialogReply: (id, n, values) => ipcRenderer.send('title-dialog-reply', id, n, values || null),\\n  onTitleState: (cb) => ipcRenderer.on('title-state', (_, s) => cb(s)),\\n  onTitleFoco: (cb) => ipcRenderer.on('title-foco', (_, d) => cb(d)),\\n  sideladoToggle: (lado) => ipcRenderer.send('sidelado-toggle', lado),\\n  contaSelecionar: (i) => ipcRenderer.send('conta-selecionar', i),\\n  layoutSet: (modo) => ipcRenderer.send('layout-set', modo),\\n  usoOpen: () => ipcRenderer.send('uso-open'),\\n  gearOpen: (rect) => ipcRenderer.send('gear-open', rect || null),\\n  onUsoTotal: (cb) => ipcRenderer.on('uso-total', (_, d) => cb(d)),\\n  onTitleBadges: (cb) => ipcRenderer.on('title-badges', (_, b) => cb(b)),\\n});\",\"bar.html\":\"<!doctype html>\\n<meta charset=\\\"utf-8\\\">\\n<style>\\n  :root {\\n    --frame-dark: #19191b;\\n    --frame: #39393f;\\n    --frame-hi: #4f4f58;\\n    --frame-top: #484850;\\n    --btn-top: #414148;\\n    --btn-bot: #62626c;\\n    --btn-edge: #9b9ba5;\\n    --chip-1: #7cd148;\\n    --chip-2: #54545d;\\n    --cream: #eeeeef;\\n    --panel: #76cf3f;\\n    --box: #1e1e21;\\n  }\\n  * { box-sizing: border-box; }\\n  [hidden] { display: none !important; }\\n  html, body { margin: 0; height: 100%; }\\n  body {\\n    background: linear-gradient(var(--frame-top), var(--frame) 22%, var(--frame) 78%, #252528);\\n    border-top: 1px solid var(--frame-hi);\\n    border-bottom: 2px solid var(--frame-dark);\\n    color: #fff; font: 700 11px \\\"Segoe UI\\\", system-ui, sans-serif;\\n    user-select: none; overflow: hidden; white-space: nowrap;\\n  }\\n  /* barra na borda de baixo: moldura espelhada */\\n  body.bottom {\\n    background: linear-gradient(#252528, var(--frame) 22%, var(--frame) 78%, var(--frame-top));\\n    border-top: 2px solid var(--frame-dark);\\n    border-bottom: 1px solid var(--frame-hi);\\n  }\\n  #app { display: flex; align-items: center; gap: 10px; height: 100%; padding: 0 9px; }\\n  .grp { display: flex; align-items: center; gap: 8px; }\\n  .grp.right { margin-left: auto; }\\n\\n  /* botão no estilo do menu do jogo: dois tons de roxo + moldura dupla */\\n  .btn {\\n    display: flex; align-items: center; gap: 6px;\\n    height: 24px; padding: 0 10px 0 4px; margin: 0;\\n    font: inherit; color: #fff; cursor: pointer;\\n    text-shadow: 1px 1px 0 var(--frame-dark);\\n    background: linear-gradient(var(--btn-top) 0 48%, var(--btn-bot) 48% 90%, var(--btn-edge) 90%);\\n    border: 2px solid var(--frame-dark); border-radius: 6px;\\n    box-shadow: 0 0 0 1px var(--frame-hi), 0 0 0 2px var(--frame-dark);\\n  }\\n  .btn:hover { filter: brightness(1.15); }\\n  .btn:active { transform: translateY(1px); }\\n  .btn.icon { padding: 0 6px 0 6px; }\\n  .tile-name {\\n    height: 32px; align-items: flex-start !important; justify-content: center; flex-direction: row;\\n    border-radius: 10px; padding: 3px 10px 3px 6px; gap: 7px;\\n  }\\n  .tile-name .chip { margin-top: 1px; }\\n  .tile-txt { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; overflow: hidden; }\\n  .tile-txt .lbl { max-width: none; display: block !important; }\\n  .tile-sub { font-size: 9.5px; font-weight: 600; color: #d0eebd; opacity: .85; text-shadow: none; }\\n  .btn.icon svg { width: 14px; height: 14px; display: block; }\\n  .btn.spin svg { animation: spin .8s linear infinite; }\\n  @keyframes spin { to { transform: rotate(360deg); } }\\n  @media (prefers-reduced-motion: reduce) { .btn.spin svg { animation: none; opacity: .6; } }\\n\\n  /* medalhão redondo do ícone */\\n  .chip {\\n    width: 16px; height: 16px; border-radius: 50%; flex: none;\\n    display: grid; place-items: center; font-size: 10px; line-height: 1;\\n    background: radial-gradient(circle at 35% 30%, var(--chip-1), var(--chip-2));\\n    border: 1px solid var(--frame-dark);\\n  }\\n\\n  /* ativo: realce rosa */\\n  .btn.on {\\n    background: linear-gradient(#62626c 0 48%, #a4e77a 48% 90%, #c9ffa7 90%);\\n    outline: 2px solid var(--cream); outline-offset: 1px;\\n  }\\n\\n  /* Desempenho */\\n  .perf .caret { font-size: 9px; opacity: .9; margin-left: 2px; }\\n  .perf b { font-weight: 800; }\\n  .perf.l0 .chip { background: radial-gradient(circle at 35% 30%, #7d97ff, #3357e3); }\\n  .perf.l1 .chip { background: radial-gradient(circle at 35% 30%, #8ee08e, #009c3b); }\\n  .perf.l2 .chip { background: radial-gradient(circle at 35% 30%, #96f75a, #58c912); }\\n  .perf.l3 .chip { background: radial-gradient(circle at 35% 30%, #44444c, var(--frame-dark)); }\\n\\n  /* Auto Compra */\\n  .coin {\\n    width: 16px; height: 16px; border-radius: 50%; flex: none;\\n    background: radial-gradient(circle at 35% 30%, #ceffb0, #69e01f 55%, #4db80b);\\n    border: 1px solid var(--frame-dark); box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .25);\\n  }\\n  .btn.lives.kick .chip { background: radial-gradient(circle at 35% 30%, #a8ff8a, #3cd61b); }\\n  .btn.lives.kick.on {\\n    background: linear-gradient(#1d6b1a 0 48%, #3cb32a 48% 90%, #8ef07a 90%);\\n    animation: livePulseK 1.6s ease-in-out infinite;\\n  }\\n  @keyframes livePulseK {\\n    0%, 100% { filter: brightness(1); box-shadow: 0 0 0 1px var(--frame-hi), 0 0 0 2px var(--frame-dark), 0 0 0 0 rgba(83, 252, 24, 0); }\\n    50% { filter: brightness(1.25); box-shadow: 0 0 0 1px var(--frame-hi), 0 0 0 2px var(--frame-dark), 0 0 10px 3px rgba(83, 252, 24, .6); }\\n  }\\n  .btn.lives.twitch.on {\\n    background: linear-gradient(#5b2fb0 0 48%, #8f5ee8 48% 90%, #c9a8ff 90%);\\n    animation: livePulse 1.6s ease-in-out infinite; /* pisca enquanto as lives estão ligadas */\\n  }\\n  @keyframes livePulse {\\n    0%, 100% { filter: brightness(1); box-shadow: 0 0 0 1px var(--frame-hi), 0 0 0 2px var(--frame-dark), 0 0 0 0 rgba(201, 168, 255, 0); }\\n    50% { filter: brightness(1.3); box-shadow: 0 0 0 1px var(--frame-hi), 0 0 0 2px var(--frame-dark), 0 0 10px 3px rgba(201, 168, 255, .75); }\\n  }\\n  /* bolinha vermelha de \\\"ao vivo\\\" */\\n  .btn.lives .rec { width: 7px; height: 7px; border-radius: 50%; background: #ff4d5e; box-shadow: 0 0 4px #ff4d5e; animation: recBlink 1s steps(1) infinite; }\\n  @keyframes recBlink { 50% { opacity: 0; } }\\n  @media (prefers-reduced-motion: reduce) {\\n    .btn.lives.on, .btn.lives.kick.on, .btn.lives .rec { animation: none; }\\n  }\\n  .btn.lives b { font-weight: 800; }\\n  .btn.auto.on { background: linear-gradient(#1d6b3a 0 48%, #4aa85a 48% 90%, #8ee08e 90%); }\\n  /* Troca de hunt automática */\\n  /* ver no celular: bolinha verde quando está ligado */\\n  .btn.icon.cel { position: relative; }\\n  .btn.icon.cel.on::after { content: ''; position: absolute; top: 3px; right: 3px; width: 7px; height: 7px; border-radius: 50%; background: #6fdc95; box-shadow: 0 0 0 1.5px #1a1a1d, 0 0 6px #6fdc95; }\\n  .btn.hunt .chip { background: radial-gradient(circle at 35% 30%, #8bd65d, #478521); }\\n  .btn.hunt.on { background: linear-gradient(#1f4f8a 0 48%, #3f7fd0 48% 90%, #8ec5ff 90%); }\\n  .btn.hunt.on .chip { background: radial-gradient(circle at 35% 30%, #b7ff8a, #58c912); }\\n  .st { font-size: 10px; color: var(--cream); opacity: .9; max-width: 120px; overflow: hidden; text-overflow: ellipsis; text-shadow: 1px 1px 0 var(--frame-dark); }\\n\\n  /* nome da conta / abas */\\n  .name .chip { font-size: 9px; }\\n  .tab.cur { background: linear-gradient(#4db80b 0 48%, #69e01f 48% 90%, #96f75a 90%); color: var(--frame-dark); text-shadow: none; }\\n  .name .lbl, .tab .lbl { max-width: 130px; overflow: hidden; text-overflow: ellipsis; }\\n  .sep { width: 2px; height: 20px; background: var(--frame-dark); border-right: 1px solid var(--frame-hi); }\\n\\n  /* barra estreita: primeiro some o texto dos botões menos importantes, depois de todos */\\n  @media (max-width: 1000px) {\\n    .perf .lbl, .perf .caret { display: none; }\\n    .perf { padding-right: 4px; }\\n  }\\n  /* ícone da Kick escuro sobre a bolinha verde */\\n  .btn.lives.kick .chip { color: #0b2e0b; }\\n  .btn.cena .chip { background: radial-gradient(circle at 35% 30%, #8a7aa8, #4a3a68); }\\n  .btn.cena.on .chip { background: radial-gradient(circle at 35% 30%, #8ec5ff, #2f6fd6); }\\n  .btn.cena:not(.on) { background: linear-gradient(#414148 0 48%, #62626c 48% 90%, #9b9ba5 90%); box-shadow: 0 0 0 1px #96f75a, 0 0 0 2px var(--frame-dark); }\\n  /* botão dividido: barrinha separando a setinha */\\n  .btn.split { padding-right: 0; }\\n  .btn.split .split-c {\\n    align-self: stretch; display: grid; place-items: center; width: 22px; margin-left: 4px;\\n    font-size: 8px; border-left: 2px solid rgba(25, 25, 27, .55); box-shadow: inset 1px 0 0 rgba(255, 255, 255, .25);\\n    border-radius: 0 4px 4px 0;\\n  }\\n  .btn.split .split-c:hover { background: rgba(255, 255, 255, .18); }\\n  .btn.split:hover { filter: none; }\\n  .btn.split:hover > :not(.split-c) { filter: brightness(1.15); }\\n  /* grupos: um pouco mais juntos, separadores mais leves */\\n  #app .grp { gap: 6px; }\\n  @media (max-width: 900px) { .lbl, .st { display: none; } .btn { padding-right: 4px; } }\\n\\n  /* ======== Mega Eco: painel das 4 contas ======== */\\n  body.resumo { background: radial-gradient(ellipse at top, #1d1d20, #0d0d0e 70%); border: 0; overflow: auto; white-space: normal;\\n    font: 600 12px \\\"Segoe UI\\\", system-ui, sans-serif; color: var(--cream); user-select: text; }\\n  .dz { display: flex; flex-direction: column; gap: 10px; padding: 10px 12px 8px; min-height: 100%; }\\n  .dz-top { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; padding: 10px 14px; border-radius: 12px;\\n    background: linear-gradient(90deg, #26262a, #19191b); border: 2px solid var(--frame-dark); box-shadow: 0 0 0 1px #39393f; }\\n  .dz-tit b { display: block; font-size: 16px; color: #96f75a; text-shadow: 1px 1px 0 var(--frame-dark); }\\n  .dz-tit span { font-size: 11px; color: #9d9da6; font-weight: 500; }\\n  .dz-tot { display: flex; gap: 18px; flex-wrap: wrap; }\\n  .dz-tot small { display: block; font-size: 10px; color: #9d9da6; }\\n  .dz-tot b { font-size: 17px; color: #fff; }\\n  .ouro { color: #96f75a !important; }\\n  .dz-bt { margin-left: auto; display: grid; gap: 4px; }\\n  .dz-b { height: 26px; padding: 0 14px; cursor: pointer; font: 700 12px \\\"Segoe UI\\\", sans-serif; color: var(--cream);\\n    background: #28282c; border: 1px solid #39393f; border-radius: 7px; }\\n  .dz-b.n { color: #163a00; background: linear-gradient(#96f75a, #69e01f); border-color: var(--frame-dark); }\\n  .dz-b:hover { filter: brightness(1.15); }\\n  .dz-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 10px; align-items: stretch; align-content: start; }\\n  .dz-c { display: flex; flex-direction: column; gap: 9px; padding: 12px; border-radius: 14px; min-width: 0;\\n    background: linear-gradient(170deg, #202024, #151518 80%); border: 1px solid #303035; box-shadow: 0 8px 20px rgba(0,0,0,.25); }\\n  .dz-h { display: flex; align-items: center; gap: 7px; }\\n  .dz-dot { width: 9px; height: 9px; border-radius: 50%; background: #4d4d55; flex: none; }\\n  .dz-dot.on { background: #3ccf6a; box-shadow: 0 0 6px #3ccf6a; } .dz-dot.boss { background: #86ff3a; box-shadow: 0 0 6px #86ff3a; }\\n  .dz-nick { font-size: 14px; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .dz-nv { font-size: 11px; color: #9d9da6; white-space: nowrap; }\\n  /* barra de XP do treinador (igual à do jogo) */\\n  .dz-tr { display: flex; align-items: center; gap: 8px; }\\n  .dz-tr img { width: 28px; height: 28px; object-fit: contain; image-rendering: pixelated; flex: none; }\\n  .dz-xp { position: relative; flex: 1; height: 15px; border-radius: 5px; overflow: hidden; background: #16202e; border: 1px solid #2c3e55; }\\n  .dz-xp i { position: absolute; left: 0; top: 0; bottom: 0; background: linear-gradient(#6fc0ff, #3f8fd8 60%, #2f6fb8); }\\n  .dz-xp span { position: relative; display: block; text-align: center; font-size: 10px; font-weight: 700; line-height: 13px; color: #fff; text-shadow: 0 1px 2px #000, 0 0 3px #000; }\\n  .dz-xp-p { font-size: 11px; font-weight: 700; color: #8ec5ff; flex: none; min-width: 38px; text-align: right; }\\n  .dz-st { margin-left: auto; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 9px; background: #202024; color: #5e5e67; }\\n  .dz-st.on { background: #0e2a0b; color: #8ef07a; } .dz-st.boss { background: #203b0f; color: #adff7a; }\\n  .dz-ver { height: 22px; padding: 0 9px; cursor: pointer; font: 700 11px \\\"Segoe UI\\\", sans-serif; color: var(--cream); background: #28282c; border: 1px solid #39393f; border-radius: 6px; }\\n  .dz-chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: -3px; }\\n  .dz-chip { font-size: 10px; font-weight: 800; padding: 1px 7px; border-radius: 7px; background: #202024; color: #bdbdc3; border: 1px solid #303035; }\\n  .dz-chip.v { background: #203b0f; color: #96f75a; border-color: #3b6e1c; } .dz-chip.tw { background: #2a1a48; color: #c9a8ff; border-color: #4a2f7a; }\\n  .dz-chip.kk { background: #14301a; color: #8ef07a; border-color: #2f6b22; } .dz-chip.g { background: #102a30; color: #8ee6f0; border-color: #20606a; }\\n  .dz-chip.b { background: #1b320c; color: #adff7a; border-color: #3b6e1c; }\\n  .dz-pk { display: flex; align-items: center; gap: 10px; }\\n  .dz-pk img, .dz-pk-sem { width: 58px; height: 58px; object-fit: contain; image-rendering: pixelated; flex: none; }\\n  .dz-pk-sem { border-radius: 50%; background: #28282c; }\\n  .dz-pk-i { flex: 1; min-width: 0; display: grid; gap: 4px; }\\n  .dz-pk-i b { color: #fff; font-size: 13px; } .dz-pk-i span { color: #9d9da6; font-size: 11px; }\\n  .dz-hp { height: 6px; border-radius: 3px; background: #0e0e10; overflow: hidden; }\\n  .dz-hp i { display: block; height: 100%; border-radius: 3px; }\\n  .dz-hunt { font-size: 11px; color: #bdbdc3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  /* quadrinhos no estilo do Modo Economia do jogo */\\n  .dz-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }\\n  .dz-t { display: grid; gap: 1px; padding: 7px 9px; border-radius: 9px; background: #131315; border: 1px solid #2a2a2e; min-width: 0; }\\n  .dz-t small { font-size: 9.5px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: #9d9da6; }\\n  .dz-t b { font-size: 17px; color: #fff; line-height: 1.15; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .dz-t .r { font-size: 11px; font-weight: 700; color: #a4e77a; }\\n  .dz-t .s { font-size: 10px; color: #5e5e67; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .dz-t.lucro b { color: #4ccf6a; }\\n  .dz-t.ouroT { background: #122208; border-color: #284b13; }\\n  .dz-ga { display: flex; flex-wrap: wrap; gap: 6px 16px; padding: 7px 9px; border-radius: 9px; background: #131315; border: 1px solid #2a2a2e; }\\n  .dz-ga h4 { margin: 0 0 3px; font-size: 9.5px; letter-spacing: .05em; text-transform: uppercase; color: #c9ffa7; }\\n  .dz-it.g { background: #1c1c1e; border-color: #346218; }\\n  .dz-ccs { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }\\n  .dz-cc { display: flex; gap: 6px; align-items: center; padding: 5px 7px; border-radius: 8px; background: #1c1c20; border: 1px solid #303035; min-width: 0; }\\n  .dz-cc img { width: 32px; height: 32px; object-fit: contain; image-rendering: pixelated; flex: none; }\\n  .dz-cc > div { min-width: 0; flex: 1; }\\n  .dz-cc-n { display: flex; align-items: baseline; gap: 4px; }\\n  .dz-cc-n b { font-size: 12px; color: #fff; } .dz-cc-n span { font-size: 10px; color: #9d9da6; } .dz-cc-n i { margin-left: auto; font-style: normal; font-size: 10px; color: #5e5e67; }\\n  .dz-cc-c { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 2px; }\\n  .dz-cc-c span { font-size: 9px; font-weight: 800; padding: 0 4px; border-radius: 4px; border: 1px solid; }\\n  .dz-cc-c .p { color: #e2e2e5; background: #37373d; border-color: #585861; } .dz-cc-c .iv { color: #c8f5c8; background: #1d4d2a; border-color: #2f7a40; }\\n  .dz-cc-c .q { color: #c8e0ff; background: #1a3a5a; border-color: #2f5a8a; } .dz-cc-c .n { color: #fff; background: #3a3a3a; border-color: #8a8a8a; }\\n  .dz-rates { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }\\n  .dz-rates div { padding: 6px 8px; border-radius: 8px; background: rgba(0,0,0,.22); }\\n  .dz-rates small { display: block; font-size: 10px; color: #9d9da6; }\\n  .dz-rates b { font-size: 17px; color: #fff; }\\n  .dz-cart, .dz-ses { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 11px; color: #9d9da6; font-weight: 500; }\\n  .dz-cart b, .dz-ses b { color: #fff; font-weight: 800; }\\n  .dz-sec h4 { margin: 0 0 4px; font-size: 10px; letter-spacing: .05em; text-transform: uppercase; color: #c9ffa7; }\\n  .dz-itens { display: flex; flex-wrap: wrap; gap: 4px; }\\n  .dz-it { display: inline-flex; align-items: center; gap: 4px; padding: 2px 7px 2px 3px; border-radius: 8px; background: #1b2238; border: 1px solid #2f3a5a; font-size: 11px; font-weight: 800; color: #fff; }\\n  .dz-it img { width: 18px; height: 18px; object-fit: contain; image-rendering: pixelated; }\\n  .dz-caps { display: flex; flex-wrap: wrap; gap: 4px; }\\n  .dz-cap { font-size: 10.5px; font-weight: 700; padding: 1px 7px; border-radius: 8px; background: #1d4d2a; color: #c8f5c8; }\\n  .dz-cap i { font-style: normal; color: #8ee08e; font-weight: 600; }\\n  .dz-cap.sh { background: #264a10; color: #c9ffa8; }\\n  .dz-log { display: grid; gap: 1px; padding-top: 6px; border-top: 1px solid #2a2a2e; min-height: 52px; align-content: start; }\\n  .dz-caps { min-height: 22px; }\\n  .dz-auto { margin-top: auto; }\\n  .dz-log div { font-size: 10.5px; color: #9d9da6; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .dz-log .ruim { color: #ff8a8a; } .dz-log .bom { color: #8ee08e; }\\n  .dz-auto { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; padding-top: 6px; border-top: 1px solid #2a2a2e; }\\n  .dz-auto-t { font-size: 10px; font-weight: 800; color: #c9ffa7; margin-right: 2px; }\\n  .dz-tg { display: inline-flex; align-items: center; gap: 5px; font-size: 10.5px; font-weight: 700; padding: 2px 8px 2px 4px; border-radius: 10px; background: #202024; color: #5e5e67; }\\n  .dz-tg i { width: 18px; height: 10px; border-radius: 5px; background: #37373d; position: relative; }\\n  .dz-tg i::after { content: \\\"\\\"; position: absolute; top: 1px; left: 1px; width: 8px; height: 8px; border-radius: 50%; background: #5e5e67; }\\n  .dz-tg.on { color: #c8f5c8; background: #14301a; } .dz-tg.on i { background: #2f9a4c; } .dz-tg.on i::after { left: 9px; background: #fff; }\\n  .dz-none { font-size: 11px; color: #4d4d55; font-weight: 500; } .dz-none.big { margin: auto; font-size: 14px; }\\n  .dz-foot { font-size: 10px; color: #4d4d55; text-align: right; }\\n  /* ======== Painel das Lives (visual novo) ======== */\\n  .lv { --card: #161618; --card2: #1d1d21; --line: #323237; --line2: #29292d; --txt: #f3f3f5; --mut: #b3b3bb; --gold: #96f25c; --frame: #72ce39; --frame2: #3d3d44;\\n    --tw: #9146ff; --twTxt: #d6c4ff; --kk: #53fc18; --kkTxt: #c8ffb0; display: flex; flex-direction: column; gap: 14px; color: var(--txt); font: 500 13px/1.35 \\\"Segoe UI\\\", system-ui, sans-serif; }\\n  .lv .hud { font-family: Bahnschrift, \\\"Segoe UI Semibold\\\", \\\"Segoe UI\\\", sans-serif; font-stretch: condensed; font-weight: 700; letter-spacing: 1px; }\\n  .lv-top { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }\\n  .lv-box.lv-kpi { flex-direction: row; align-items: center; gap: 14px; padding: 10px 16px; }\\n  .lv-box.lv-kpi > div { display: flex; flex-direction: column; gap: 3px; min-width: 0; }\\n  .lv-box.lv-kpi .lp-ico { transform: scale(1.5); margin: 0 6px; flex: none; }\\n  .lv-box { background: var(--card); border-radius: 14px; padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; min-width: 0; border: 2px solid var(--line); }\\n  .lv-box.tw { border-color: #5a3a9a; box-shadow: inset 0 0 0 2px var(--card), inset 0 0 0 3px #3a2266; }\\n  .lv-box.kk { border-color: #2f7a1c; box-shadow: inset 0 0 0 2px var(--card), inset 0 0 0 3px #1f4a12; }\\n  .lv-box.res { border-color: var(--frame); box-shadow: inset 0 0 0 2px var(--card), inset 0 0 0 3px var(--frame2); }\\n  .lv-h { display: flex; align-items: center; gap: 8px; }\\n  .lv-h .lp-ico { flex: none; }\\n  .lv-h b { font-size: 15px; }\\n  .lv-h .n { margin-left: auto; font-size: 12px; font-weight: 700; padding: 2px 9px; border-radius: 99px; }\\n  .tw .lv-h .n { background: #2a1a4a; color: var(--twTxt); } .kk .lv-h .n { background: #16301a; color: var(--kkTxt); }\\n  .lv-chips { display: flex; flex-wrap: wrap; gap: 5px; }\\n  .lv-tag { display: inline-flex; align-items: center; gap: 5px; padding: 2px 9px; border-radius: 99px; font-size: 12px; font-weight: 600; background: var(--card2); border: 1px solid var(--line); }\\n  .lv-tag i { width: 7px; height: 7px; border-radius: 50%; background: #ff4d5e; box-shadow: 0 0 5px #ff4d5e; }\\n  .lv-none { font-size: 12px; color: var(--mut); }\\n  .lv-big { font-size: 30px; line-height: 1; color: var(--gold); }\\n  .lv-ok { font-size: 12px; color: #9fe6a8; }\\n  .lv-abas { display: inline-flex; gap: 4px; padding: 4px; border-radius: 12px; background: var(--card); border: 1px solid var(--line); align-self: flex-start; }\\n  .lv-abas button { min-height: 32px; padding: 0 14px; border-radius: 8px; border: 0; cursor: pointer; background: transparent; color: var(--mut); font: 700 12px \\\"Segoe UI\\\", sans-serif; }\\n  .lv-abas button.on { background: #26262a; color: var(--gold); box-shadow: inset 0 0 0 1px var(--frame); }\\n  .lv-abas button:focus-visible { outline: 2px solid #9cff5e; outline-offset: 2px; }\\n  .lv-tab { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--card); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }\\n  .lv-tab th { text-align: left; padding: 10px 14px; font-size: 11px; letter-spacing: .6px; text-transform: uppercase; color: var(--mut); border-bottom: 1px solid var(--line2); background: #1a1a1d; }\\n  .lv-tab th .lp-ico { display: inline-flex; vertical-align: -3px; margin-right: 6px; }\\n  .lv-tab td { padding: 12px 14px; border-bottom: 1px solid var(--line2); vertical-align: top; width: 40%; }\\n  .lv-tab td:first-child { width: 20%; }\\n  .lv-tab tr:last-child td { border-bottom: 0; }\\n  .lv-acc b { font-size: 14px; display: block; }\\n  .lv-acc span { font-size: 12px; color: var(--mut); }\\n  .lv-cel { display: flex; flex-direction: column; gap: 8px; }\\n  .lv-cel .linha { display: flex; align-items: center; gap: 10px; }\\n  .lv-cel .est { font-size: 12px; font-weight: 700; }\\n  .lv-cel.tw .est.on { color: var(--twTxt); } .lv-cel.kk .est.on { color: var(--kkTxt); } .lv-cel .est.off { color: var(--mut); font-weight: 500; }\\n  .lv-ch { padding: 3px 10px; border-radius: 8px; font: 600 12px \\\"Segoe UI\\\", sans-serif; cursor: pointer; color: var(--txt); background: var(--card2); border: 1px solid var(--line); }\\n  .lv-cel.tw .lv-ch:hover { border-color: var(--tw); } .lv-cel.kk .lv-ch:hover { border-color: #3fae2a; }\\n  .lv-of { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; align-items: start; }\\n  .lv-lista { display: flex; flex-direction: column; }\\n  .lv-lista .it { display: flex; align-items: center; gap: 10px; padding: 7px 4px; border-bottom: 1px solid var(--line2); }\\n  .lv-lista .it:last-child { border-bottom: 0; }\\n  .lv-lista .it .nm { flex: 1; font-weight: 600; }\\n  .lv-lista .it .st { font-size: 11px; font-weight: 700; color: var(--mut); }\\n  .lv-lista .it .st.vivo { color: #ff6b7a; }\\n  .lv-lista .it button { width: 26px; height: 26px; border-radius: 7px; cursor: pointer; border: 1px solid var(--line); background: var(--card2); color: var(--mut); font: 700 14px \\\"Segoe UI\\\", sans-serif; }\\n  .lv-lista .it button:hover { color: #ff8a95; border-color: #6a2630; }\\n  .lv-rm { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 8px; border-top: 1px dashed var(--line); }\\n  .lv-rm button { display: inline-flex; gap: 6px; align-items: center; padding: 3px 9px; border-radius: 99px; cursor: pointer; font: 600 12px \\\"Segoe UI\\\", sans-serif; color: var(--mut);\\n    background: transparent; border: 1px dashed var(--line); text-decoration: line-through; }\\n  .lv-rm button small { text-decoration: none; font-size: 10px; }\\n  .lv-rm button:hover { color: var(--txt); text-decoration: none; border-style: solid; }\\n  .lv-nota { font-size: 12px; color: var(--mut); }\\n  /* ======== PvP (visual novo, no padrão do Mega Eco e do celular) ======== */\\n  body.pvp { background: radial-gradient(ellipse at top, #1d1d20, #0d0d0e 70%); }\\n  #pvp .ch { background: #1a1a1d; }\\n  #pvp .pz { flex: 1; overflow: auto; }\\n  .pz .mx { padding-top: 12px; }\\n  .pz-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }\\n  .pz-contas, .pz-seg { display: inline-flex; gap: 4px; padding: 4px; border-radius: 12px; background: var(--card); border: 1px solid var(--line); }\\n  .pz-contas button, .pz-seg button { min-height: 32px; padding: 0 12px; border-radius: 8px; border: 0; cursor: pointer; background: transparent; color: var(--mut);\\n    font: 700 12px \\\"Segoe UI\\\", sans-serif; }\\n  .pz-contas button:hover, .pz-seg button:hover { color: var(--txt); }\\n  .pz-contas button.on { background: #26262a; color: var(--gold); box-shadow: inset 0 0 0 1px var(--frame); }\\n  .pz-seg button.on { background: var(--card2); color: var(--txt); box-shadow: inset 0 0 0 1px var(--line); }\\n  .pz-bar .grow { flex: 1; }\\n  .pz-kpis { display: grid; grid-template-columns: 1.2fr 1.2fr 1.4fr 1.6fr; gap: 12px; }\\n  .pz-kpis .mx-box { padding: 12px 16px; }\\n  .pz-big { font-size: 30px; line-height: 1; white-space: nowrap; }\\n  .pz-sub { font-size: 12px; color: var(--mut); }\\n  .pz-pos { color: #6fdc95; } .pz-neg { color: #ff8a95; }\\n  .pz-wl { height: 8px; border-radius: 99px; overflow: hidden; background: #343439; display: flex; }\\n  .pz-wl i { display: block; height: 100%; background: linear-gradient(90deg, #3fae6a, #6fdc95); }\\n  .pz-ult { display: grid; grid-template-columns: repeat(20, minmax(0, 1fr)); gap: 3px; }\\n  .pz-ult span { height: 22px; border-radius: 4px; display: grid; place-items: center; font-size: 9px; font-weight: 800; color: #0f1a12; }\\n  .pz-ult span.v { background: #6fdc95; } .pz-ult span.d { background: #ff8a95; color: #1a1a1d; }\\n  .pz-abas { display: flex; gap: 6px; border-bottom: 1px solid var(--line2); }\\n  .pz-abas button { padding: 10px 14px; border: 0; background: none; cursor: pointer; color: var(--mut); font: 700 13px \\\"Segoe UI\\\", sans-serif; border-bottom: 2px solid transparent; margin-bottom: -1px; }\\n  .pz-abas button.on { color: var(--gold); border-bottom-color: var(--gold); }\\n  .pz-abas button:focus-visible, .pz-contas button:focus-visible, .pz-seg button:focus-visible { outline: 2px solid #9cff5e; outline-offset: 2px; }\\n  .pz-grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; align-items: start; }\\n  .pz-card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }\\n  .pz-card h3 { margin: 0; font-size: 14px; color: var(--gold); display: flex; align-items: baseline; gap: 8px; }\\n  .pz-card h3 span { font: 500 12px \\\"Segoe UI\\\", sans-serif; color: var(--mut); letter-spacing: 0; }\\n  .pz-card h3 a { margin-left: auto; font: 700 12px \\\"Segoe UI\\\", sans-serif; color: var(--mut); cursor: pointer; letter-spacing: 0; }\\n  .pz-card h3 a:hover { color: var(--gold); }\\n  .pz-lin { display: flex; flex-direction: column; gap: 6px; padding: 10px 12px; border-radius: 10px; background: var(--card2); min-width: 0; }\\n  .pz-lin .t { display: flex; align-items: baseline; gap: 8px; min-width: 0; }\\n  .pz-lin .t b { font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .pz-lin .t .r { margin-left: auto; flex: none; font-weight: 700; font-size: 12px; }\\n  .pz-lin .d { font-size: 12px; color: var(--mut); }\\n  .pz-lin .d b { color: var(--txt); font-weight: 600; }\\n  .pz-ordem { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }\\n  .pz-ordem span { padding: 2px 8px; border-radius: 99px; font-size: 11px; font-weight: 700; background: #1f2a1c; border: 1px solid #3f6b45; color: #bff0cf; }\\n  .pz-ordem i { font-style: normal; color: var(--mut); font-size: 11px; }\\n  .pz-tab { width: 100%; border-collapse: collapse; font-size: 12.5px; }\\n  .pz-tab th { text-align: left; font-size: 10px; letter-spacing: .6px; text-transform: uppercase; color: var(--mut); padding: 8px 10px; border-bottom: 1px solid var(--line2); position: sticky; top: 0; background: var(--card); }\\n  .pz-tab td { padding: 9px 10px; border-bottom: 1px solid var(--line2); vertical-align: middle; }\\n  .pz-tab tr:last-child td { border-bottom: 0; }\\n  .pz-tab td.n { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }\\n  .pz-tab th.n { text-align: right; }\\n  .pz-mini { width: 90px; } .pz-mini .pz-wl { height: 6px; }\\n  .pz-mons { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; }\\n  .pz-mon { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 10px; }\\n  .pz-mon .h { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }\\n  .pz-mon .h b { font-size: 15px; }\\n  .pz-mon .parte { height: 10px; border-radius: 99px; background: var(--card2); overflow: hidden; }\\n  .pz-mon .parte i { display: block; height: 100%; background: linear-gradient(90deg, #72ce39, #96f25c); }\\n  .pz-nota { font-size: 12px; color: var(--mut); line-height: 1.5; }\\n  .pz-msg { padding: 60px 10px; text-align: center; color: var(--mut); font-size: 14px; }\\n  @media (max-width: 1050px) { .pz-kpis { grid-template-columns: 1fr 1fr; } .pz-grid2 { grid-template-columns: 1fr; } }\\n  /* ======== Mega Eco (visual novo, no mesmo estilo do PokeLink no celular) ======== */\\n  .mx { --bg: #0c0c0e; --card: #161618; --card2: #1d1d21; --line: #323237; --line2: #29292d; --txt: #f3f3f5; --mut: #b3b3bb;\\n    --gold: #96f25c; --frame: #72ce39; --frame2: #3d3d44; --ok: #6fdc95; --okTxt: #bff0cf; --warn: #9aff5c;\\n    display: flex; flex-direction: column; gap: 14px; padding: 14px 16px 10px; min-height: 100%; box-sizing: border-box; color: var(--txt);\\n    font: 500 13px/1.35 \\\"Segoe UI\\\", system-ui, sans-serif; }\\n  .mx * { box-sizing: border-box; }\\n  .mx .hud { font-family: Bahnschrift, \\\"Segoe UI Semibold\\\", \\\"Segoe UI\\\", sans-serif; font-stretch: condensed; font-weight: 700; letter-spacing: 1px; }\\n  .mx-mut { color: var(--mut); font-size: 12px; }\\n  .mx-frame { background: var(--card); border: 2px solid var(--frame); border-radius: 14px;\\n    box-shadow: inset 0 0 0 2px var(--card), inset 0 0 0 3px var(--frame2), 0 6px 18px rgba(0, 0, 0, .35); }\\n  /* topo */\\n  .mx-top { display: grid; grid-template-columns: minmax(250px, 1fr) minmax(240px, 1.1fr) minmax(360px, 2fr) auto; gap: 12px; align-items: stretch; }\\n  .mx-brand { display: flex; align-items: center; gap: 14px; padding: 4px 2px; min-width: 0; }\\n  .mx-logo { width: 58px; height: 58px; flex: none; border-radius: 14px; display: grid; place-items: center;\\n    background: radial-gradient(circle at 35% 30%, #35353b, #1a1a1d); border: 2px solid var(--frame); box-shadow: inset 0 0 0 2px #1a1a1d, inset 0 0 0 3px #478521, 0 0 18px rgba(150, 242, 92, .15); }\\n  .mx-brand-t { display: flex; flex-direction: column; gap: 6px; min-width: 0; }\\n  .mx-brand-t b { font-size: 30px; line-height: .9; color: var(--gold); text-shadow: 0 2px 0 #1a1a1d, 0 0 14px rgba(150, 242, 92, .2); }\\n  .mx-brand-l { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\\n  .mx-vivo { display: inline-flex; align-items: center; gap: 6px; padding: 3px 9px; border-radius: 99px; font-size: 11px; font-weight: 700; white-space: nowrap;\\n    background: #1f2a1c; border: 1px solid #3f6b45; color: var(--okTxt); }\\n  .mx-vivo i { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 6px var(--ok); }\\n  @media (prefers-reduced-motion: no-preference) { .mx-vivo i { animation: mxpulso 2s ease-in-out infinite; } @keyframes mxpulso { 50% { opacity: .35; } } }\\n  .mx-box { padding: 12px 16px; display: flex; flex-direction: column; gap: 8px; justify-content: center; }\\n  .mx-box h3 { margin: 0; font-size: 14px; color: var(--gold); }\\n  .mx-nums { display: flex; gap: 0; }\\n  .mx-nums > div { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; padding: 0 12px; }\\n  .mx-nums > div:first-child { padding-left: 0; }\\n  .mx-nums > div + div { border-left: 1px solid var(--line2); }\\n  .mx-nums small { font-size: 10px; letter-spacing: .6px; text-transform: uppercase; color: var(--mut); font-weight: 700; }\\n  .mx-nums b { font-size: 24px; line-height: 1.05; white-space: nowrap; }\\n  .mx-shiny { position: relative; overflow: hidden; border-color: #96f25c;\\n    background: radial-gradient(120% 160% at 50% -30%, #2e5a12 0%, #1d1d21 55%, #161618 100%); box-shadow: inset 0 0 0 2px #161618, inset 0 0 0 3px #4d9024, 0 0 22px rgba(150, 242, 92, .16); }\\n  .mx-shiny h3 { color: #b7ff8a; }\\n  .mx-shiny .mx-nums b { font-size: 34px; color: #b7ff8a; text-shadow: 0 0 12px rgba(183, 255, 138, .35); text-align: center; }\\n  .mx-shiny .mx-nums small { text-align: center; color: var(--gold); }\\n  .mx-shiny .mx-nums b.zero { color: #54545d; text-shadow: none; }\\n  .mx-shiny .est { position: absolute; color: #b7ff8a; opacity: .45; font-size: 13px; pointer-events: none; }\\n  .mx-acoes { display: flex; flex-direction: column; gap: 8px; justify-content: center; min-width: 170px; }\\n  .mx-b { min-height: 38px; padding: 0 14px; border-radius: 10px; cursor: pointer; font: 700 13px \\\"Segoe UI\\\", sans-serif; color: var(--txt);\\n    background: var(--card); border: 2px solid var(--line); }\\n  .mx-b:hover { border-color: var(--frame); }\\n  .mx-b.gold { background: #26262a; border-color: var(--frame); color: var(--gold); box-shadow: inset 0 0 0 2px #26262a, inset 0 0 0 3px #478521; }\\n  .mx-b:focus-visible { outline: 2px solid #9cff5e; outline-offset: 2px; }\\n  /* cartões das contas */\\n  .mx-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; align-items: stretch; }\\n  .mx-c { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 12px;\\n    box-shadow: 0 6px 18px rgba(0, 0, 0, .3); min-width: 0; }\\n  .mx-head { display: flex; gap: 10px; align-items: flex-start; }\\n  .mx-av { width: 46px; height: 46px; border-radius: 10px; flex: none; background: var(--card2); border: 1px solid var(--line); object-fit: contain; image-rendering: pixelated; }\\n  .mx-num { width: 46px; height: 46px; border-radius: 10px; flex: none; display: grid; place-items: center; background: #3a3a41; border: 1px solid #82d350; color: #f0f0f1; font-size: 22px;\\n    box-shadow: inset 0 -3px 0 rgba(0, 0, 0, .25); }\\n  .mx-num.c1 { background: #1f3f6a; border-color: #4f8fd8; color: #dbeaff; }\\n  .mx-num.c2 { background: #1f4a2f; border-color: #4fb06a; color: #d8f5e0; }\\n  .mx-num.c3 { background: #2e5a12; border-color: #6dd02f; color: #ddffc8; }\\n  .mx-id { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5px; }\\n  .mx-nome { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }\\n  .mx-nome b { font-size: 16px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .mx-nome span { flex: none; font-size: 12px; font-weight: 700; color: var(--mut); }\\n  .mx-xp { position: relative; height: 16px; border-radius: 5px; overflow: hidden; background: #16202e; border: 1px solid #2c3e55; }\\n  .mx-xp i { position: absolute; inset: 0 auto 0 0; background: linear-gradient(#6fc0ff, #3f8fd8 60%, #2f6fb8); }\\n  .mx-xp span { position: relative; display: block; text-align: center; font-size: 10.5px; font-weight: 700; line-height: 14px; color: #fff; text-shadow: 0 1px 2px #000, 0 0 3px #000; }\\n  .mx-xp-s { display: flex; justify-content: space-between; font-size: 11px; color: var(--mut); }\\n  .mx-xp-s b { color: #8ec5ff; }\\n  .mx-linha { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 10px; border-radius: 10px; background: var(--card2); }\\n  .mx-hunt { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }\\n  .mx-hunt span { color: var(--mut); font-weight: 500; }\\n  .mx-st { flex: none; display: inline-flex; align-items: center; gap: 6px; padding: 3px 9px; border-radius: 99px; font-size: 11px; font-weight: 700; white-space: nowrap;\\n    background: #1f2a1c; border: 1px solid #3f6b45; color: var(--okTxt); }\\n  .mx-st i { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 6px var(--ok); }\\n  .mx-st.boss { background: #1f1f22; border-color: #3e731d; color: #c5ffa1; } .mx-st.boss i { background: var(--warn); box-shadow: 0 0 6px var(--warn); }\\n  .mx-st.off { background: #1c1c1e; border-color: var(--line); color: var(--mut); } .mx-st.off i { background: #7a6a72; box-shadow: none; }\\n  .mx-chips { display: flex; flex-wrap: wrap; gap: 5px; margin-top: -4px; }\\n  .mx-chip { padding: 2px 8px; border-radius: 99px; font-size: 11px; font-weight: 600; background: var(--card2); border: 1px solid var(--line); color: #d9d9dc; }\\n  .mx-chip.tw { border-color: #6a4aa8; color: #d6c4ff; } .mx-chip.kk { border-color: #3f8a3a; color: #bff0b0; } .mx-chip.v { border-color: #5aa82a; color: #b7ff8a; }\\n  .mx-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid var(--line2); border-radius: 10px; overflow: hidden; }\\n  .mx-stats > div { padding: 9px 11px; display: flex; flex-direction: column; gap: 1px; min-width: 0; }\\n  .mx-stats > div:nth-child(odd) { border-right: 1px solid var(--line2); }\\n  .mx-stats > div:nth-child(n+3) { border-top: 1px solid var(--line2); }\\n  .mx-stats small { font-size: 10px; letter-spacing: .6px; text-transform: uppercase; color: var(--mut); font-weight: 700; }\\n  .mx-stats b { font-size: 20px; line-height: 1.1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\\n  .mx-stats em { font-style: normal; font-size: 11px; color: var(--mut); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\\n  .mx-pk { display: flex; gap: 10px; align-items: center; }\\n  .mx-pk img, .mx-pk .sem { width: 44px; height: 44px; flex: none; border-radius: 10px; background: var(--card2); object-fit: contain; image-rendering: pixelated; }\\n  .mx-pk > div { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }\\n  .mx-pk b { font-size: 13px; } .mx-pk b span { color: var(--mut); font-weight: 500; }\\n  .mx-hp { height: 7px; border-radius: 99px; background: var(--card2); overflow: hidden; } .mx-hp i { display: block; height: 100%; }\\n  .mx-shiny-mini { padding: 10px 14px; gap: 4px; box-shadow: inset 0 0 0 2px #161618, inset 0 0 0 3px #4d9024; }\\n  .mx-shiny-mini h3 { font-size: 12px; }\\n  .mx-shiny-mini .mx-nums b { font-size: 26px; }\\n  .mx-selo { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 7px 12px; border-radius: 10px; font-weight: 600; font-size: 12px;\\n    background: linear-gradient(90deg, #213d0f, #274a12, #213d0f); border: 1px solid #72ce39; color: #b7ff8a; }\\n  .mx-selo b { font-size: 16px; margin-right: 2px; }\\n  .mx-selo .hud { font-size: 13px; letter-spacing: 1px; }\\n  .mx-selo.zero { background: #1b1b1e; border-color: var(--line); color: var(--mut); }\\n  .mx-selo.zero .hud { color: #72ce39; }\\n  .mx-sec { display: flex; flex-direction: column; gap: 7px; }\\n  .mx-sec h4 { margin: 0; font-size: 12px; color: var(--gold); }\\n  .mx-cap { display: flex; align-items: center; gap: 8px; min-width: 0; }\\n  .mx-cap img { width: 30px; height: 30px; border-radius: 7px; background: var(--card2); object-fit: contain; image-rendering: pixelated; flex: none; }\\n  .mx-cap > div { flex: 1; min-width: 0; }\\n  .mx-cap .n { display: flex; gap: 6px; align-items: baseline; font-size: 12px; } .mx-cap .n b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .mx-cap .n span { color: var(--mut); font-size: 11px; } .mx-cap .n i { margin-left: auto; font-style: normal; color: var(--mut); font-size: 11px; }\\n  .mx-cap .c { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 2px; }\\n  .mx-cap .c span { font-size: 10px; font-weight: 700; padding: 0 5px; border-radius: 4px; background: #2e3a2a; color: #bfe8b0; }\\n  .mx-cap .c span.q { background: #2a3248; color: #b8d0ff; }\\n  .mx-itens { display: flex; flex-wrap: wrap; gap: 6px; }\\n  .mx-it { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px 2px 3px; border-radius: 7px; background: var(--card2); font-size: 11px; font-weight: 700; }\\n  .mx-it img { width: 20px; height: 20px; object-fit: contain; image-rendering: pixelated; }\\n  .mx-it.g { color: #ffb3b3; }\\n  .mx-log { display: flex; flex-direction: column; gap: 3px; font-size: 11px; color: var(--mut); border-top: 1px solid var(--line2); padding-top: 8px; }\\n  .mx-log .ruim { color: #ff9aa5; } .mx-log .bom { color: var(--okTxt); }\\n  .mx-ver { margin-top: auto; }\\n  .mx-vazio { margin: auto; color: var(--mut); font-size: 14px; }\\n  @media (max-width: 1250px) { .mx-top { grid-template-columns: 1fr 1fr; } .mx-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\\n  /* ======== barra de título (substitui o menu nativo) ======== */\\n  body.title {\\n    background: transparent; border: 0;\\n    font: 600 12px \\\"Segoe UI\\\", system-ui, sans-serif;\\n  }\\n  body.sidebar {\\n    background: #131314; border: 0; border-right: 2px solid var(--frame-dark);\\n    font: 600 12px \\\"Segoe UI\\\", system-ui, sans-serif; height: 100%;\\n  }\\n  body.sidebar, body.otimside { display: flex; flex-direction: row; height: 100%; }\\n  body.sidebar.fechado .sd-wrap, body.otimside.fechado .ot-col { display: none; }\\n  .ot-col { display: flex; flex-direction: column; flex: 1; min-width: 0; height: 100%; overflow: auto; }\\n  body.otimside {\\n    background: #19191b; border: 0; border-left: 2px solid var(--frame-dark);\\n    font: 600 12px \\\"Segoe UI\\\", system-ui, sans-serif; height: 100%; overflow: auto;\\n  }\\n  body.otimside #app { height: auto; flex-direction: column; align-items: stretch; padding: 10px; gap: 10px; border-bottom: 1px solid #2a2a2e; }\\n  body.otimside #app .sep { display: none; }\\n  body.otimside #app .grp.left, body.otimside #app .grp.mid { flex-direction: column; align-items: stretch; gap: 6px; }\\n  body.otimside #app .grp.left .btn, body.otimside #app .grp.mid .btn { width: 100%; height: 34px; justify-content: flex-start; box-sizing: border-box; }\\n  body.otimside #app .grp.left .lbl, body.otimside #app .grp.mid .lbl, body.otimside #app .grp.livesg .lbl {\\n    display: inline-block !important; flex: 1; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\\n  }\\n  body.otimside #app .grp.livesg { flex-direction: column; align-items: stretch; gap: 6px; }\\n  body.otimside #app .grp.livesg .btn { width: 100%; height: 34px; justify-content: flex-start; box-sizing: border-box; }\\n  /* botões de liga/desliga aqui ficam neutros (igual ao resto), com só um traço colorido quando ligados —\\n     em vez de preencher o botão inteiro de cor, que fica berrante com 5 cores diferentes juntas */\\n  body.otimside #app .grp.mid .btn, body.otimside #app .grp.livesg .btn {\\n    background: linear-gradient(var(--btn-top) 0 48%, var(--btn-bot) 48% 90%, var(--btn-edge) 90%) !important;\\n    animation: none !important; border-left: 4px solid transparent;\\n  }\\n  body.otimside #app .grp.mid .btn.on, body.otimside #app .grp.livesg .btn.on {\\n    border-left-color: #8ef07a; outline: none; box-shadow: 0 0 0 1px var(--frame-hi), 0 0 0 2px var(--frame-dark), inset 0 0 10px rgba(142, 240, 122, .18);\\n  }\\n  body.otimside #app .grp.mid .btn .rec, body.otimside #app .grp.livesg .btn .rec { background: #8ef07a; box-shadow: 0 0 4px #8ef07a; }\\n  body.otimside #app .grp.right.qa-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; width: 100%; }\\n  .qa-btn {\\n    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;\\n    aspect-ratio: 1; border-radius: 12px; cursor: pointer; padding: 6px 2px; min-width: 0;\\n    background: linear-gradient(var(--btn-top) 0 48%, var(--btn-bot) 48% 90%, var(--btn-edge) 90%);\\n    border: 2px solid var(--frame-dark); box-shadow: 0 0 0 1px var(--frame-hi), 0 0 0 2px var(--frame-dark);\\n    color: #fff; text-shadow: 1px 1px 0 var(--frame-dark);\\n  }\\n  .qa-btn:hover { filter: brightness(1.15); }\\n  .qa-btn:active { transform: translateY(1px); }\\n  .qa-btn.on { background: linear-gradient(#1d6b3a 0 48%, #4aa85a 48% 90%, #8ee08e 90%); }\\n  .qa-ico svg { width: 16px; height: 16px; display: block; }\\n  .qa-btn.spin .qa-ico svg { animation: spin .8s linear infinite; }\\n  .qa-lbl { font-size: 9px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }\\n  .ot-wrap { padding: 14px 12px; display: flex; flex-direction: column; gap: 12px; box-sizing: border-box; flex: 1; min-width: 0; }\\n  #tb {\\n    position: relative; z-index: 2;\\n    display: flex; align-items: center; height: 34px;\\n    background: #17171a;              /* igual ao TITLE_BG do main.js (a cor que o Windows usa atrás dos botões da janela) */\\n    padding: 0 150px 0 8px;            /* à direita: espaço dos botões min/max/fechar */\\n    -webkit-app-region: drag;          /* arrastar a janela / duplo clique maximiza */\\n    box-shadow: inset 0 -1px 0 #26262b;\\n  }\\n  #tb .brand { display: flex; align-items: center; gap: 7px; margin-right: 14px; color: var(--cream); }\\n  #tb .brand svg, #tb .brand .appico { width: 18px; height: 18px; display: block; flex: none; object-fit: contain; }\\n  #tb .brand b { font-size: 12px; font-weight: 800; letter-spacing: .02em; text-shadow: 1px 1px 0 var(--frame-dark); }\\n  #tb .ver { margin-left: 2px; }\\n  #tb nav { display: flex; align-items: center; gap: 2px; }\\n  #tb nav { gap: 3px; padding-left: 10px; margin-left: 4px; border-left: 1px solid #39393f; height: 22px; }\\n  .mbtn {\\n    -webkit-app-region: no-drag; position: relative;\\n    display: inline-flex; align-items: center; gap: 6px;\\n    height: 26px; padding: 0 10px 0 8px; margin: 0;\\n    font: 600 12px \\\"Segoe UI\\\", system-ui, sans-serif; color: #cfeebc; cursor: pointer;\\n    background: none; border: 1px solid transparent; border-radius: 8px;\\n    transition: background .12s, color .12s;\\n  }\\n  .mbtn svg { width: 14px; height: 14px; flex: none; opacity: .75; transition: opacity .12s; }\\n  .mbtn:hover { color: #fff; background: rgba(255, 255, 255, .07); }\\n  .mbtn:hover svg { opacity: 1; }\\n  .mbtn.open, .mbtn:focus-visible {\\n    color: #fff; outline: none;\\n    background: linear-gradient(#494951, #5d5d67);\\n    border-color: var(--frame-dark);\\n    box-shadow: 0 0 0 1px #8cd75d, 0 2px 8px rgba(84, 84, 93, .45);\\n    text-shadow: 1px 1px 0 var(--frame-dark);\\n  }\\n  .mbtn.open svg, .mbtn:focus-visible svg { opacity: 1; }\\n  /* selo com número (ex.: lives abertas) */\\n  .mbtn .mb-badge {\\n    min-width: 16px; height: 16px; padding: 0 4px; border-radius: 8px; display: grid; place-items: center;\\n    font-size: 10px; font-weight: 800; color: #fff; background: #e0405a; box-shadow: 0 0 0 2px #26262a;\\n  }\\n  @media (prefers-reduced-motion: reduce) { .mbtn, .mbtn svg { transition: none; } }\\n\\n  /* botão de informações (bolinha com \\\"i\\\") */\\n  .ibtn {\\n    -webkit-app-region: no-drag;\\n    width: 22px; height: 22px; margin: 0 0 0 auto; padding: 0;\\n    display: grid; place-items: center; cursor: pointer;\\n    font: italic 800 13px Georgia, \\\"Times New Roman\\\", serif; color: #fff;\\n    text-shadow: 1px 1px 0 var(--frame-dark);\\n    background: radial-gradient(circle at 35% 30%, var(--chip-1), var(--chip-2));\\n    border: 1px solid var(--frame-dark); border-radius: 50%;\\n    box-shadow: 0 0 0 1px var(--frame-hi);\\n  }\\n  .ibtn:hover, .ibtn:focus-visible { outline: none; filter: brightness(1.2); box-shadow: 0 0 0 1px var(--cream); }\\n\\n  /* ---- pop-ups (substituem as caixas de mensagem do Windows) ---- */\\n  #dlgShade {\\n    position: fixed; inset: 0; z-index: 10;\\n    display: grid; place-items: center; padding: 50px 16px 16px;\\n    background: rgba(14, 14, 16, .55);\\n  }\\n  .dlg {\\n    width: min(460px, 100%); max-height: 100%; overflow: auto;\\n    background: var(--box); color: var(--cream); white-space: normal;\\n    border: 2px solid var(--frame-dark); border-radius: 10px;\\n    box-shadow: 0 0 0 1px #54545d, 0 18px 40px rgba(10, 10, 10, .6);\\n    font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif;\\n    animation: dlgIn .12s ease-out;\\n  }\\n  @keyframes dlgIn { from { opacity: 0; transform: scale(.97); } }\\n  @media (prefers-reduced-motion: reduce) { .dlg { animation: none; } }\\n  .dlg .hd {\\n    display: flex; align-items: center; gap: 8px; height: 32px; padding: 0 6px 0 12px;\\n    background: linear-gradient(var(--frame-top), var(--frame));\\n    border-bottom: 2px solid var(--frame-dark); border-radius: 8px 8px 0 0;\\n    color: #fff; font-size: 12px; text-shadow: 1px 1px 0 var(--frame-dark);\\n  }\\n  .dlg .hd .t { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .dlg .x {\\n    width: 24px; height: 24px; padding: 0; border: 0; border-radius: 5px; cursor: pointer;\\n    background: none; color: var(--cream); font: 700 16px/1 \\\"Segoe UI\\\", sans-serif;\\n  }\\n  .dlg .x:hover, .dlg .x:focus-visible { outline: none; background: #8a2a3a; color: #fff; }\\n  .dlg .bd { display: flex; gap: 14px; padding: 18px 18px 6px; }\\n  .dlg .ico {\\n    flex: none; width: 34px; height: 34px; border-radius: 50%;\\n    display: grid; place-items: center; color: #fff;\\n    font: italic 800 19px Georgia, serif; text-shadow: 1px 1px 0 var(--frame-dark);\\n    border: 2px solid var(--frame-dark); box-shadow: 0 0 0 1px var(--frame-hi);\\n    background: radial-gradient(circle at 35% 30%, var(--chip-1), var(--chip-2));\\n  }\\n  .dlg .ico.warning { background: radial-gradient(circle at 35% 30%, #96f75a, #58c912); color: #163a00; text-shadow: none; font: 800 19px \\\"Segoe UI\\\", sans-serif; }\\n  .dlg .ico.error { background: radial-gradient(circle at 35% 30%, #ff8a8a, #b8283c); font: 800 17px \\\"Segoe UI\\\", sans-serif; }\\n  .dlg .ico.question { font: 800 18px \\\"Segoe UI\\\", sans-serif; }\\n  .dlg .msg { margin: 6px 0 8px; font-size: 15px; font-weight: 700; color: #fff; }\\n  .dlg .det { margin: 0; color: #ccedb7; font-weight: 500; line-height: 1.45; white-space: pre-line; word-break: break-word; }\\n  .dlg .ft { display: flex; justify-content: flex-end; gap: 10px; padding: 14px 18px 16px; }\\n  .dlg .ft .btn { height: 30px; padding: 0 16px; font-size: 13px; }\\n  .dlg .ft .btn:focus-visible { outline: 2px solid var(--cream); outline-offset: 2px; }\\n  /* \\\"Sobre\\\": cabeçalho com a marca */\\n  .dlg .about { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 22px 18px 4px; text-align: center; }\\n  .dlg .about svg, .dlg .about .appico { width: 54px; height: 54px; object-fit: contain; filter: drop-shadow(0 3px 0 var(--frame-dark)); }\\n  .dlg .about .nm { font-size: 22px; font-weight: 800; color: #fff; text-shadow: 2px 2px 0 var(--frame-dark); }\\n  .dlg .about .ver { font-size: 11px; }\\n  .dlg.is-about { width: min(500px, 100%); }\\n  .dlg.is-about .bd { padding: 14px 22px 4px; }\\n  .dlg.is-about .msg { text-align: center; margin-top: 0; }\\n  .dlg .note {\\n    display: flex; gap: 10px; align-items: flex-start; margin: 14px 0 4px; padding: 10px 12px;\\n    background: #203b0f; border: 1px solid #58c912; border-radius: 7px;\\n    color: #c9ffa8; font-weight: 600; line-height: 1.4;\\n  }\\n  .dlg .note .ni {\\n    flex: none; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center;\\n    background: radial-gradient(circle at 35% 30%, #96f75a, #58c912); color: #163a00;\\n    border: 1px solid var(--frame-dark); font-weight: 800; font-size: 12px;\\n  }\\n  .dlg.wide { width: min(820px, 100%); }\\n  .dlg .dform { margin-top: 10px; }\\n  .dlg .det.long { max-height: min(52vh, 460px); overflow: auto; padding: 10px 12px; margin-top: 6px;\\n    background: #151517; border: 1px solid #303035; border-radius: 8px; font-size: 12px; }\\n  /* painel das lives */\\n  .dlg .lv { margin-top: 12px; }\\n  /* Auto Compra como painel que desce do botão */\\n  #cfgShade { position: fixed; inset: 0; z-index: 9; background: rgba(10, 10, 10, .25); }\\n  #cfg.panel {\\n    position: fixed; z-index: 12; display: flex; flex-direction: column;\\n    width: min(680px, calc(100vw - 16px)); height: min(760px, calc(100vh - 56px));\\n    background: #19191b; color: var(--cream); white-space: normal; font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif;\\n    border: 2px solid var(--frame-dark); border-radius: 12px; overflow: hidden;\\n    box-shadow: 0 0 0 1px #54545d, 0 18px 40px rgba(10, 10, 10, .6);\\n    animation: ddIn .1s ease-out;\\n  }\\n  #cfg.panel .ch { -webkit-app-region: no-drag; padding-right: 6px; }\\n  #extsShade { position: fixed; inset: 0; z-index: 9; background: rgba(10, 10, 10, .35); }\\n  .lp.ex { width: min(640px, calc(100vw - 24px)); height: auto; max-height: calc(100vh - 60px); }\\n  .lp.ex .cb { display: grid; gap: 12px; }\\n  .ex-card { padding: 14px; border-radius: 12px; background: linear-gradient(160deg, #222226, #1a1a1c 70%); border: 1px solid #39393f; display: grid; gap: 8px; }\\n  .ex-card.off { opacity: .6; }\\n  .ex-h { display: flex; align-items: center; gap: 10px; }\\n  .ex-ico { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; flex: none;\\n    background: radial-gradient(circle at 35% 30%, var(--chip-1), var(--chip-2)); border: 1px solid var(--frame-dark); }\\n  .ex-ico svg { width: 16px; height: 16px; }\\n  .ex-t { flex: 1; min-width: 0; display: grid; }\\n  .ex-t b { color: #fff; font-size: 15px; } .ex-t span { font-size: 11px; color: #9d9da6; }\\n  .ex-st { font-size: 10px; font-weight: 800; padding: 3px 9px; border-radius: 10px; white-space: nowrap; }\\n  .ex-st.ok { background: #0e2a0b; color: #8ef07a; } .ex-st.off { background: #202024; color: #5e5e67; }\\n  .ex-st.err { background: #232327; color: #ff8a8a; } .ex-st.busy { background: #203b0f; color: #96f75a; }\\n  .ex-d { font-size: 12px; color: #bdbdc3; font-weight: 500; line-height: 1.4; }\\n  .ex-err { font-size: 11px; color: #ff8a8a; font-weight: 500; word-break: break-word; }\\n  .ex-a { display: flex; gap: 8px; }\\n  .ex-a .kx-btn:disabled { opacity: .5; cursor: default; }\\n  /* painel de uso (CPU e memória) em cartões */\\n  .lp.uso { width: min(860px, calc(100vw - 24px)); height: auto; max-height: calc(100vh - 60px); }\\n  .uso-leg { display: flex; gap: 14px; align-items: center; color: #9d9da6; font-size: 12px; font-weight: 600; }\\n  .uso-leg i { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 5px; vertical-align: -1px; }\\n  .uso-h { margin: 14px 0 8px; color: #c6c6cb; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }\\n  .uso-g { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }\\n  .uso-c { position: relative; padding: 12px 14px 11px; border-radius: 10px; background: #202023; border: 1px solid #303036; overflow: hidden; }\\n  .uso-c::before { content: \\\"\\\"; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--n); }\\n  .uso-c .t { color: #d9d9dc; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\\n  .uso-c .v { margin-top: 4px; color: #fff; font: 800 24px/1.1 \\\"Segoe UI\\\", system-ui, sans-serif; }\\n  .uso-c .s { margin-top: 3px; display: flex; align-items: center; justify-content: space-between; gap: 8px; color: var(--n); font-size: 13px; font-weight: 700; }\\n  .uso-c .d { margin-top: 2px; color: #6a6a75; font-size: 12px; font-weight: 600; }\\n  .uso-c .tag { flex: none; padding: 1px 7px; border-radius: 99px; font-size: 10px; font-weight: 800;\\n    letter-spacing: .05em; color: #111113; background: var(--n); }\\n  .uso-c.ok { --n: #7fe08a; } .uso-c.medio { --n: #9ae76a; } .uso-c.alto { --n: #ff5d6c; }\\n  .uso-c.ok { background: #1e2a1e; border-color: #2f4a30; } .uso-c.medio { background: #202023; border-color: #356319; } .uso-c.alto { background: #222225; border-color: #6a2630; }\\n  .uso-c.hero { grid-column: 1 / -1; display: flex; align-items: center; gap: 24px; }\\n  .uso-c.hero .s { margin-top: 0; gap: 14px; }\\n  .uso-c.hero .v { font-size: 30px; }\\n  .uso-out { display: flex; flex-wrap: wrap; gap: 6px 14px; color: #9d9da6; font-size: 12px; }\\n  .uso-out b { color: #d9d9dc; }\\n  /* ---------- Novidades (patch notes) ---------- */\\n  /* Uma tela só: tudo numa rolagem, sem páginas nem setas. Cinza escuro com verde só nos destaques. */\\n  #novShade { position: fixed; inset: 0; z-index: 9; background: rgba(0, 0, 0, .6); backdrop-filter: blur(2px); }\\n  .nov { position: fixed; z-index: 12; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(600px, calc(100vw - 24px));\\n    height: min(760px, calc(100vh - 40px)); display: flex; flex-direction: column; background: #141417; color: #e9e9ee; white-space: normal;\\n    font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif; border: 1px solid #33333a; border-radius: 14px; overflow: hidden;\\n    box-shadow: 0 24px 60px rgba(0, 0, 0, .65); animation: novIn .18s ease-out; }\\n  @keyframes novIn { from { opacity: 0; transform: translate(-50%, -47%) scale(.98); } }\\n  .nov-hd { flex: none; display: flex; align-items: center; gap: 10px; padding: 13px 16px; background: #1c1c20; border-bottom: 1px solid #2c2c33; }\\n  .nov-hd > span { flex: 1; min-width: 0; color: #fff; font: 800 13.5px/1.25 \\\"Segoe UI\\\", sans-serif; }\\n  .nov-hd > span i { display: block; font-style: normal; margin-top: 2px; font: 600 11.5px \\\"Segoe UI\\\", sans-serif; color: #8d8d98; }\\n  .nov-ver { display: flex; align-items: center; gap: 6px; flex: none; font: 600 11px \\\"Segoe UI\\\", sans-serif; color: #8d8d98; }\\n  .nov-ver select { height: 27px; padding: 0 7px; border-radius: 7px; cursor: pointer; color: #d7d7de; background: #232329; border: 1px solid #3a3a42; font: 600 12px \\\"Segoe UI\\\", sans-serif; }\\n  .nov-ver select:focus-visible { outline: 2px solid #6fdc3f; outline-offset: 1px; }\\n  .nov-bd { flex: 1; overflow: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; scrollbar-width: thin; scrollbar-color: #3a3a42 transparent; }\\n  .nov-bd::-webkit-scrollbar { width: 10px; }\\n  .nov-bd::-webkit-scrollbar-thumb { background: #35353d; border: 3px solid #141417; border-radius: 6px; }\\n  .nov-hero { padding: 20px 18px 18px; text-align: center; border-radius: 12px; background: #1b1f1a;\\n    border: 1px solid #2f4a24; box-shadow: inset 0 1px 0 rgba(255, 255, 255, .03); }\\n  .nov-logo { width: 54px; height: 54px; margin: 0 auto; display: block; }\\n  .nov-selo { display: inline-block; margin-top: 10px; padding: 3px 11px; border-radius: 20px; font: 800 9.5px \\\"Segoe UI\\\", sans-serif;\\n    letter-spacing: .12em; color: #0f2605; background: #6fdc3f; }\\n  .nov-tit { margin: 10px 0 0; font: 800 21px/1.25 \\\"Segoe UI\\\", sans-serif; color: #9ff06d; }\\n  .nov-res { margin: 12px auto 0; max-width: 46ch; color: #c2c2cb; font-size: 12.5px; font-weight: 500; line-height: 1.55; }\\n  .nov-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 16px; }\\n  .nov-card { padding: 11px 8px 10px; border-radius: 10px; background: #202024; border: 1px solid #32323a; }\\n  .nov-card .ic { font-size: 20px; line-height: 1.2; }\\n  .nov-card .vl { margin-top: 3px; color: #fff; font: 800 16px \\\"Segoe UI\\\", sans-serif; }\\n  .nov-card .nm { margin-top: 1px; color: #9ff06d; font-weight: 700; font-size: 11.5px; line-height: 1.25; }\\n  .nov-card .sb { margin-top: 3px; color: #8d8d98; font-size: 10.5px; font-weight: 500; line-height: 1.3; }\\n  .nov-gold { padding: 12px 14px; border-radius: 10px; color: #cfe9c0; font-size: 12.5px; font-weight: 500; line-height: 1.5;\\n    background: #1d2619; border: 1px solid #39562c; border-left: 3px solid #6fdc3f; }\\n  .nov-sec { padding: 14px 16px; border-radius: 10px; background: #1a1a1e; border: 1px solid #2a2a31; }\\n  .nov-sec h4 { display: flex; align-items: center; gap: 9px; margin: 0 0 10px; color: #fff; font: 800 12px \\\"Segoe UI\\\", sans-serif; letter-spacing: .07em; }\\n  .nov-sec h4::before { content: \\\"\\\"; width: 3px; height: 13px; border-radius: 2px; background: #6fdc3f; }\\n  .nov-sec ul { margin: 0; padding: 0; list-style: none; }\\n  .nov-sec li { position: relative; margin: 0 0 9px; padding-left: 15px; color: #b9b9c3; font-size: 12.5px; font-weight: 500; line-height: 1.55; }\\n  .nov-sec li:last-child { margin-bottom: 0; }\\n  .nov-sec li::before { content: \\\"▸\\\"; position: absolute; left: 0; top: -.5px; color: #6fdc3f; font-size: 11px; }\\n  .nov b, .nov strong { color: #fff; font-weight: 700; }\\n  .nov-gold b { color: #e2ffd2; }\\n  .nov-fim { padding: 2px 4px 6px; text-align: center; color: #70707a; font-size: 11.5px; font-weight: 500; }\\n  .nov-pe { flex: none; padding: 12px 16px; background: #1c1c20; border-top: 1px solid #2c2c33; }\\n  .nov-go { width: 100%; height: 38px; cursor: pointer; border: 0; border-radius: 9px; color: #0f2605; font: 800 13px \\\"Segoe UI\\\", sans-serif;\\n    letter-spacing: .1em; background: #6fdc3f; }\\n  .nov-go:hover { background: #80ec50; }\\n  /* troca de hunt automática */\\n  .lp.ah { width: min(760px, calc(100vw - 24px)); height: auto; max-height: calc(100vh - 60px); }\\n  /* ver no celular */\\n  #celShade { position: fixed; inset: 0; z-index: 9; background: rgba(10, 10, 10, .35); }\\n  .lp.cel { width: min(640px, calc(100vw - 24px)); height: auto; max-height: calc(100vh - 60px); }\\n  .cel-g { display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap; }\\n  .cel-qr { flex: none; padding: 10px; border-radius: 10px; background: #f3ffec; border: 2px solid #72ce39; box-shadow: 0 0 0 2px #19191b, 0 0 0 3px #478521; line-height: 0; }\\n  .cel-qr svg { width: 200px; height: 200px; display: block; }\\n  .cel-i { flex: 1; min-width: 240px; display: grid; gap: 10px; color: #d9d9dc; font-size: 13px; line-height: 1.45; }\\n  .cel-i ol { margin: 0; padding-left: 18px; display: grid; gap: 4px; }\\n  .cel-cod { padding: 8px 10px; border-radius: 8px; background: #202023; border: 1px solid #303036; color: #96f25c; font: 800 17px/1.2 Consolas, \\\"Courier New\\\", monospace; letter-spacing: 1px; text-align: center; user-select: all; }\\n  .cel-st { padding: 7px 10px; border-radius: 8px; background: #1e2a1e; border: 1px solid #2f4a30; color: #9fe6a8; font-size: 12px; }\\n  .cel-st.erro { background: #222225; border-color: #6a2630; color: #ff9aa5; }\\n  .cel-st.aviso { background: #202023; border-color: #356319; color: #9ae76a; }\\n  .cel-off { display: grid; gap: 10px; color: #d9d9dc; font-size: 13px; line-height: 1.5; }\\n  .cel-off ul { margin: 0; padding-left: 18px; display: grid; gap: 4px; }\\n  .cel-off .nota { color: #6a6a75; font-size: 12px; }\\n  .ah-aviso { padding: 9px 12px; border-radius: 8px; background: #202023; border: 1px solid #356319; color: #9ae76a; font-size: 12px; line-height: 1.45; }\\n  .ah-cfg { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 12px; }\\n  .ah-cfg label { display: flex; flex-direction: column; gap: 4px; color: #9d9da6; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; }\\n  .ah-cfg select { height: 30px; border-radius: 6px; padding: 0 8px; background: #141416; color: #fff; border: 1px solid #37373d; font: 700 12px \\\"Segoe UI\\\", sans-serif; }\\n  .ah-g { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }\\n  .ah-c { padding: 11px 12px; border-radius: 10px; background: #202023; border: 1px solid #303036; }\\n  .ah-c.on { background: #1e2a1e; border-color: #2f4a30; }\\n  .ah-c .h { display: flex; align-items: center; gap: 8px; } .ah-c .h b { color: #fff; font-size: 13px; flex: 1; }\\n  .ah-c .ah-st { margin-top: 6px; color: #ccccd1; font-size: 12px; min-height: 16px; }\\n  .ah-c .px { color: #6a6a75; font-size: 11px; }\\n  .ah-c .hs { margin-top: 6px; display: grid; gap: 2px; color: #9d9da6; font-size: 11px; }\\n  .ah-c .hs b { color: #d9d9dc; }\\n  .ah-c .bt { margin-top: 8px; }\\n  #kickShade, #livesShade, #usoShade, #ahShade { position: fixed; inset: 0; z-index: 9; background: rgba(10, 10, 10, .35); }\\n  /* painel das Lives */\\n  .lp {\\n    position: fixed; z-index: 12; left: 50%; top: 50%; transform: translate(-50%, -48%); display: flex; flex-direction: column;\\n    width: min(940px, calc(100vw - 24px)); height: min(720px, calc(100vh - 60px));\\n    background: #19191b; color: var(--cream); white-space: normal; font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif;\\n    border: 2px solid var(--frame-dark); border-radius: 12px; overflow: hidden;\\n    box-shadow: 0 0 0 1px #54545d, 0 18px 40px rgba(10, 10, 10, .6); animation: ddIn .1s ease-out;\\n  }\\n  .lp .ch { flex: none; display: flex; align-items: center; gap: 8px; height: 38px; padding: 0 8px 0 12px; background: #26262a;\\n    box-shadow: inset 0 -2px 0 var(--frame-dark), inset 0 -3px 0 #39393f; }\\n  .lp .ch b { color: #fff; font-size: 13px; } .lp .ch > span:not(.lp-ico) { color: #9d9da6; font-size: 12px; }\\n  .lp .ch .cfg-x { margin-left: auto; width: 26px; height: 26px; padding: 0; border: 0; border-radius: 6px; cursor: pointer; background: none; color: var(--cream); font: 700 18px/1 \\\"Segoe UI\\\", sans-serif; }\\n  .lp .ch .cfg-x:hover { background: #8a2a3a; color: #fff; }\\n  .lp .cb { flex: 1; overflow: auto; padding: 14px 18px; }\\n  .lp-ico { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; flex: none; }\\n  .lp-ico svg { width: 12px; height: 12px; }\\n  .lp .ch .lp-ico { background: radial-gradient(circle at 35% 30%, var(--chip-1), var(--chip-2)); }\\n  .twitch .lp-ico { background: radial-gradient(circle at 35% 30%, #a78bfa, #6a3bc4); }\\n  .kick .lp-ico { background: radial-gradient(circle at 35% 30%, #a8ff8a, #3cd61b); color: #0b2e0b; }\\n  .lp-nowg { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }\\n  .lp-now { padding: 12px; border-radius: 12px; background: #202024; }\\n  .lp-now.twitch { border: 1px solid #5b2fb0; background: linear-gradient(160deg, #241a3a, #1a1a1c 70%); }\\n  .lp-now.kick { border: 1px solid #2f6b22; background: linear-gradient(160deg, #1d2a18, #1a1a1c 70%); }\\n  .lp-now-h { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }\\n  .lp-now-h b { color: #fff; font-size: 14px; }\\n  .lp-n { margin-left: auto; font-size: 11px; font-weight: 700; color: #bdbdc3; }\\n  .lp-chips { display: flex; flex-wrap: wrap; gap: 6px; }\\n  .lp-tag { display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 10px; border-radius: 12px; font-size: 12px; font-weight: 700; color: #fff; background: rgba(0, 0, 0, .25); }\\n  .lp-dot { width: 7px; height: 7px; border-radius: 50%; background: #ff3b4e; box-shadow: 0 0 5px #ff3b4e; }\\n  .lp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 12px; }\\n  .lp-acc { padding: 12px 14px; border-radius: 12px; background: #202024; border: 1px solid #303035; }\\n  .lp-acc-h { display: flex; align-items: baseline; gap: 8px; margin-bottom: 6px; }\\n  .lp-acc-h b { font-size: 15px; color: #fff; } .lp-acc-h span { font-size: 11px; color: #9d9da6; margin-left: auto; }\\n  .lp-row { padding: 8px 0; border-top: 1px solid #2a2a2e; display: grid; gap: 6px; }\\n  .lp-row-h { display: flex; align-items: center; gap: 8px; }\\n  .lp-row-h b { color: #fff; }\\n  .lp-row-h .sw { margin-left: 8px; }\\n  .lp-count { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 800; padding: 2px 9px; border-radius: 10px; color: #fff; }\\n  .lp-row.twitch .lp-count { background: #5b2fb0; } .lp-row.kick .lp-count { background: #2a8a1f; }\\n  .lp-count .rec { width: 7px; height: 7px; border-radius: 50%; background: #ff3b4e; box-shadow: 0 0 5px #ff3b4e; animation: recBlink 1s steps(1) infinite; }\\n  .lp-off { margin-left: auto; font-size: 11px; font-weight: 700; color: #5e5e67; }\\n  .lp-chip { height: 26px; padding: 0 11px; border-radius: 13px; cursor: pointer; font: 700 12px \\\"Segoe UI\\\", sans-serif; color: #fff; border: 1px solid var(--frame-dark); }\\n  .lp-row.twitch .lp-chip { background: #3d2470; } .lp-row.kick .lp-chip { background: #1d4d1a; }\\n  .lp-chip:hover { filter: brightness(1.3); box-shadow: 0 0 0 1px var(--cream); }\\n  .lp-none { font-size: 11px; color: #5e5e67; font-weight: 500; }\\n  .lp-foot { flex: none; display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: #26262a; font-size: 11px; color: #9d9da6;\\n    box-shadow: inset 0 2px 0 var(--frame-dark), inset 0 3px 0 #39393f; }\\n  .lp-foot .grow { flex: 1; }\\n  @media (max-width: 700px) { .lp-nowg { grid-template-columns: 1fr; } .lp-grid { grid-template-columns: 1fr; } }\\n  #kickw.panel, #twitchw.panel {\\n    position: fixed; z-index: 12; display: flex; flex-direction: column;\\n    width: min(1000px, calc(100vw - 16px)); height: min(780px, calc(100vh - 56px));\\n    background: #19191b; color: var(--cream); white-space: normal; font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif;\\n    border: 2px solid var(--frame-dark); border-radius: 12px; overflow: hidden;\\n    box-shadow: 0 0 0 1px #2f6b22, 0 18px 40px rgba(10, 10, 10, .6);\\n    animation: ddIn .1s ease-out;\\n  }\\n  #kickw.panel .ch, #twitchw.panel .ch { -webkit-app-region: no-drag; padding-right: 6px; }\\n  #kickw .ch .cfg-x, #twitchw .ch .cfg-x, #cfg.panel .ch .cfg-x { margin-left: auto; width: 26px; height: 26px; padding: 0; border: 0; border-radius: 6px; cursor: pointer;\\n    background: none; color: var(--cream); font: 700 18px/1 \\\"Segoe UI\\\", sans-serif; }\\n  #kickw .ch .cfg-x:hover, #twitchw .ch .cfg-x:hover { background: #8a2a3a; color: #fff; }\\n  #cfg.panel .ch .cfg-x { margin-left: auto; width: 26px; height: 26px; padding: 0; border: 0; border-radius: 6px; cursor: pointer;\\n    background: none; color: var(--cream); font: 700 18px/1 \\\"Segoe UI\\\", sans-serif; }\\n  #cfg.panel .ch .cfg-x:hover { background: #8a2a3a; color: #fff; }\\n  #cfg.panel .cb { padding: 14px 16px 6px; }\\n  .cfg-contas { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }\\n  .cfg-contas > span { font-size: 12px; color: #9d9da6; }\\n  #cfgContas { display: flex; gap: 4px; flex-wrap: wrap; }\\n  .cfg-ct { height: 28px; padding: 0 12px; cursor: pointer; font: 700 12px \\\"Segoe UI\\\", sans-serif; color: var(--cream);\\n    background: #28282c; border: 2px solid var(--frame-dark); border-radius: 8px; position: relative; }\\n  .cfg-ct.on::after { content: \\\"\\\"; position: absolute; top: 3px; right: 3px; width: 6px; height: 6px; border-radius: 50%; background: #3ccf6a; }\\n  .cfg-ct.cur { color: #163a00; background: linear-gradient(#96f75a, #69e01f); }\\n  .cfg-ct:hover { filter: brightness(1.15); }\\n  .cfg-todas { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--cream); cursor: pointer; margin-left: auto; white-space: nowrap; }\\n  #cfg .acc-row { box-shadow: 0 0 0 1px #2f6b22; background: linear-gradient(90deg, #1a2a16, #202024); }\\n  #cfg .acc-row .tx b { font-size: 15px; }\\n  #cfg.panel .cf { padding: 10px 16px; }\\n  #cfg .cf .btn { white-space: nowrap; }\\n  /* menuzinho de escolha (Desempenho) */\\n  #popShade { position: fixed; inset: 0; z-index: 9; }\\n  .dd.pop { z-index: 11; min-width: 300px; padding: 6px; }\\n  .pop-t { padding: 6px 10px 8px; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #c9ffa7; border-bottom: 1px solid #303035; margin-bottom: 4px; }\\n  .dd.pop .it.pop-it { grid-template-columns: 26px 1fr 16px; height: auto; min-height: 44px; padding: 7px 8px; gap: 8px; margin-bottom: 2px; }\\n  .pop-ic { font-size: 14px; text-align: center; }\\n  .pop-tx b { display: block; font-size: 13px; color: #fff; }\\n  .pop-tx small { display: block; font-size: 11px; font-weight: 500; color: #9d9da6; white-space: normal; line-height: 1.3; }\\n  .dd .pop-it:hover .pop-tx small, .dd .pop-it:focus-visible .pop-tx small { color: var(--cream); }\\n  .pop-ok { color: #96f75a; font-weight: 800; text-align: center; }\\n  .pop-sub { padding: 0 10px 8px; margin-top: -4px; font-size: 11px; color: #8ee08e; font-weight: 600; }\\n  .dd .pop-it.cur { background: rgba(150, 247, 90, .08); border-color: #346218; }\\n  .dlg .lv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\\n  @media (max-width: 640px) { .dlg .lv-grid { grid-template-columns: 1fr; } }\\n  .dlg .lv-acc { padding: 10px 12px; background: #202024; border: 2px solid var(--frame-dark); border-radius: 10px; box-shadow: 0 0 0 1px #39393f; min-width: 0; }\\n  .dlg .lv-nm { display: block; margin-bottom: 6px; font-size: 14px; color: #fff; }\\n  .dlg .lv-row { padding: 6px 0; border-top: 1px solid #2a2a2e; }\\n  .dlg .lv-h { display: flex; align-items: center; justify-content: space-between; gap: 8px; }\\n  .dlg .lv-pf { font-size: 11px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }\\n  .dlg .lv-row.twitch .lv-pf { color: #c9a8ff; } .dlg .lv-row.kick .lv-pf { color: #8ef07a; }\\n  .dlg .lv-st { font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 9px; border: 1px solid var(--frame-dark); }\\n  .dlg .lv-st.off { background: #28282c; color: #5e5e67; }\\n  .dlg .lv-row.twitch .lv-st.on { background: #5b2fb0; color: #fff; }\\n  .dlg .lv-row.kick .lv-st.on { background: #2a8a1f; color: #fff; }\\n  .dlg .lv-chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }\\n  .dlg .lv-chip, .dlg .lv-tag { font: 700 11px \\\"Segoe UI\\\", sans-serif; padding: 3px 9px; border-radius: 10px; border: 1px solid var(--frame-dark); }\\n  .dlg .lv-chip { cursor: pointer; color: #fff; }\\n  .dlg .lv-row.twitch .lv-chip { background: #3d2470; } .dlg .lv-row.kick .lv-chip { background: #1d4d1a; }\\n  .dlg .lv-chip:hover, .dlg .lv-chip:focus-visible { outline: none; filter: brightness(1.3); box-shadow: 0 0 0 1px var(--cream); }\\n  .dlg .lv-tag { background: #28282c; color: var(--cream); }\\n  .dlg .lv-none { font-size: 11px; color: #5e5e67; font-weight: 500; }\\n  .dlg .lv-now { margin-top: 10px; padding: 8px 12px; background: #1d1d20; border-radius: 8px; border: 1px solid #303035; }\\n  .dlg .lv-now > b { font-size: 12px; color: #c9ffa7; }\\n  .dlg .lv-now .lv-row { display: flex; gap: 10px; align-items: center; }\\n  .dlg .lv-now .lv-chips { margin-top: 0; }\\n  .dlg .lv-foot { margin-top: 8px; font-size: 11px; color: #5e5e67; }\\n  /* cartões da Rota de UP */\\n  .dlg .rcards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 12px; }\\n  @media (max-width: 700px) { .dlg .rcards { grid-template-columns: 1fr; } }\\n  .dlg .rc {\\n    display: flex; flex-direction: column; gap: 8px; padding: 12px; min-width: 0;\\n    background: #202024; border: 2px solid var(--frame-dark); border-radius: 10px; box-shadow: 0 0 0 1px #39393f;\\n  }\\n  .dlg .rc.r1 { background: linear-gradient(#203b0f, #202024 60%); box-shadow: 0 0 0 1px #58c912, 0 0 14px rgba(150, 247, 90, .25); }\\n  .dlg .rc-top { display: flex; align-items: center; gap: 8px; min-width: 0; }\\n  .dlg .rc-medal {\\n    flex: none; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center;\\n    font-weight: 800; font-size: 13px; color: #163a00; border: 2px solid var(--frame-dark);\\n    background: radial-gradient(circle at 35% 30%, #ceffb0, #69e01f 60%, #4db80b);\\n  }\\n  .dlg .rc.r2 .rc-medal { background: radial-gradient(circle at 35% 30%, #ffffff, #c9c9d6 60%, #8d8da0); }\\n  .dlg .rc.r3 .rc-medal { background: radial-gradient(circle at 35% 30%, #c9ffa8, #6dcd32 60%, #468a1c); }\\n  .dlg .rc-title { font-size: 15px; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .dlg .rc-chips { display: flex; flex-wrap: wrap; gap: 4px; }\\n  .dlg .rc-chip { font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 9px; background: #303035; color: #e9e9ec; border: 1px solid #404047; }\\n  .dlg .rc-big b { font-size: 22px; font-weight: 800; color: #fff; text-shadow: 1px 1px 0 var(--frame-dark); }\\n  .dlg .rc.r1 .rc-big b { color: #96f75a; }\\n  .dlg .rc-big span { font-size: 11px; color: #bdbdc3; font-weight: 700; }\\n  .dlg .rc-sub { margin-top: -6px; font-size: 11px; color: #9d9da6; }\\n  .dlg .rc-stats { display: grid; gap: 3px; padding-top: 8px; border-top: 1px solid #303035; }\\n  .dlg .rc-stat { display: flex; justify-content: space-between; gap: 8px; font-size: 11px; }\\n  .dlg .rc-stat span { color: #9d9da6; font-weight: 500; white-space: nowrap; }\\n  .dlg .rc-stat b { color: var(--cream); text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .dlg .fsec { margin: 12px 0 6px; font-size: 11px; letter-spacing: .05em; text-transform: uppercase; color: #c9ffa7; font-weight: 700; }\\n  .dlg .fgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 14px; }\\n  .dlg .frow { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 7px 10px; background: #202024; border: 1px solid #303035; border-radius: 7px; cursor: pointer; }\\n  .dlg .frow.fchk { justify-content: flex-start; }\\n  .dlg .frow.fta { grid-column: 1 / -1; flex-direction: column; align-items: stretch; cursor: default; }\\n  .dlg .frow textarea { width: 100%; min-height: 110px; resize: vertical; padding: 7px 9px; font: 500 11px Consolas, monospace;\\n    color: var(--cream); background: #131314; border: 1px solid #404047; border-radius: 6px; outline: none; }\\n  .dlg .frow textarea:focus { border-color: #a4e77a; box-shadow: 0 0 0 1px #a4e77a; }\\n  .dlg .ftx b { display: block; color: #fff; font-size: 12px; }\\n  .dlg .ftx small { color: #9d9da6; font-size: 11px; font-weight: 500; }\\n  .dlg .frow input:not([type=checkbox]), .dlg .frow select {\\n    width: 140px; flex: none; padding: 5px 8px; font: inherit; font-size: 12px; color: var(--cream);\\n    background: #131314; border: 1px solid #404047; border-radius: 6px; outline: none;\\n  }\\n  .dlg .frow input:not([type=checkbox]) { text-align: right; width: 90px; }\\n  .dlg .frow input:focus, .dlg .frow select:focus { border-color: #a4e77a; box-shadow: 0 0 0 1px #a4e77a; }\\n  @media (max-width: 620px) { .dlg .fgrid { grid-template-columns: 1fr; } }\\n  .dlg .dtab { margin-top: 12px; overflow-x: auto; border: 1px solid #39393f; border-radius: 8px; }\\n  .dlg .dtab table { width: 100%; border-collapse: collapse; font-size: 12px; }\\n  .dlg .dtab th { text-align: left; padding: 7px 9px; background: #26262a; color: #c9ffa7; font-weight: 700; white-space: nowrap; }\\n  .dlg .dtab td { padding: 8px 9px; border-top: 1px solid #2a2a2e; color: var(--cream); font-weight: 600; white-space: nowrap; }\\n  .dlg .dtab tr:first-child td { color: #fff; background: #203b0f; }\\n  .dlg .dtab td:first-child { color: #96f75a; font-weight: 800; }\\n  .dlg .foot { margin: 12px 0 0; color: #9d9da6; font-size: 11px; font-weight: 500; }\\n  .dlg.is-about .bd > div { flex: 1; }\\n  .dlg.is-about .ft { justify-content: center; }\\n  .ver {\\n    padding: 1px 7px 2px; border-radius: 9px;\\n    font-size: 10px; font-weight: 700; color: #163a00; text-shadow: none;\\n    background: linear-gradient(#96f75a 0 50%, #69e01f 50%);\\n    border: 1px solid var(--frame-dark);\\n  }\\n\\n  /* ---- menus suspensos (desenhados em HTML) ---- */\\n  #shade { position: fixed; inset: 34px 0 0 0; z-index: 1; }   /* clique fora = fecha */\\n  .dd {\\n    position: fixed; z-index: 3; min-width: 230px; padding: 5px;\\n    background: var(--box); color: var(--cream);\\n    border: 2px solid var(--frame-dark); border-radius: 8px;\\n    box-shadow: 0 0 0 1px #54545d, 0 10px 24px rgba(10, 10, 10, .55);\\n    font: 600 12px \\\"Segoe UI\\\", system-ui, sans-serif;\\n    animation: ddIn .09s ease-out;\\n  }\\n  @keyframes ddIn { from { opacity: 0; transform: translateY(-4px); } }\\n  @media (prefers-reduced-motion: reduce) { .dd { animation: none; } }\\n  .dd .it {\\n    display: grid; grid-template-columns: 18px 1fr auto 12px; align-items: center; gap: 6px;\\n    width: 100%; height: 28px; padding: 0 8px 0 6px; margin: 0;\\n    font: inherit; color: inherit; text-align: left; cursor: pointer;\\n    background: none; border: 1px solid transparent; border-radius: 5px;\\n  }\\n  .dd .it:hover, .dd .it:focus-visible, .dd .it.sub-open {\\n    outline: none; color: #fff; border-color: var(--frame-dark);\\n    background: linear-gradient(var(--btn-top) 0 50%, var(--btn-bot) 50%);\\n    text-shadow: 1px 1px 0 var(--frame-dark);\\n  }\\n  .dd .it[disabled] { opacity: .45; cursor: default; background: none; border-color: transparent; text-shadow: none; }\\n  .dd .ck { color: #c9ffa7; font-size: 12px; text-align: center; }\\n  .dd .it:hover .ck, .dd .it.sub-open .ck { color: #fff; }\\n  .dd .ac { color: #bdbdc3; font-size: 11px; font-weight: 500; padding-left: 18px; }\\n  .dd .it:hover .ac { color: var(--cream); }\\n  .dd .ar { font-size: 9px; opacity: .8; }\\n  .dd .hr { height: 1px; margin: 5px 6px; background: #303035; }\\n\\n  /* ======== janela de configuração da Auto Compra ======== */\\n  .btn.go {\\n    color: #163a00; text-shadow: none;\\n    background: linear-gradient(#96f75a 0 48%, #69e01f 48% 90%, #58c912 90%);\\n  }\\n  body.config {\\n    background: #19191b; border: 0; overflow: hidden; white-space: normal;\\n    font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif; color: var(--cream);\\n  }\\n  #cfg { display: flex; flex-direction: column; height: 100%; }\\n  /* cabeçalho = barra de título da janela (arrastável) */\\n  #cfg .ch {\\n    flex: none; display: flex; align-items: center; gap: 8px; height: 34px;\\n    padding: 0 150px 0 10px; background: #26262a; -webkit-app-region: drag;\\n    box-shadow: inset 0 -2px 0 var(--frame-dark), inset 0 -3px 0 #39393f;\\n  }\\n  #cfg .ch svg, #cfg .ch .appico { width: 18px; height: 18px; display: block; object-fit: contain; }\\n  #cfg .ch b { font-size: 12px; font-weight: 800; color: #fff; text-shadow: 1px 1px 0 var(--frame-dark); }\\n  #cfg .ch span { font-size: 12px; font-weight: 600; color: #9d9da6; }\\n  #cfg .cb { flex: 1; overflow: auto; padding: 18px max(20px, calc((100% - 620px) / 2)) 8px; }\\n  #cfg h1 { margin: 0 0 4px; font-size: 22px; font-weight: 800; color: #fff; text-shadow: 2px 2px 0 var(--frame-dark); }\\n  #cfg .sub { margin: 0 0 14px; color: #bdbdc3; font-weight: 500; line-height: 1.45; }\\n\\n  .pn {\\n    background: #202024; border: 2px solid var(--frame-dark); border-radius: 10px;\\n    box-shadow: 0 0 0 1px #39393f; margin-bottom: 14px;\\n  }\\n  .pn-h { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 14px 0; }\\n  .pn-h h2 { margin: 0; font-size: 14px; font-weight: 800; color: #fff; }\\n  .pn-h small { color: #9d9da6; font-weight: 500; font-size: 12px; }\\n\\n  .cfg-note {\\n    display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; margin-bottom: 14px;\\n    background: #203b0f; border: 1px solid #58c912; border-radius: 8px;\\n    color: #c9ffa8; font-weight: 500; line-height: 1.4; font-size: 12px;\\n  }\\n  .cfg-note .ni {\\n    flex: none; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center;\\n    background: radial-gradient(circle at 35% 30%, #96f75a, #58c912); color: #163a00;\\n    border: 1px solid var(--frame-dark); font-weight: 800; font-size: 12px;\\n  }\\n\\n  /* chave liga/desliga */\\n  .sw {\\n    appearance: none; -webkit-appearance: none; flex: none; margin: 0; cursor: pointer;\\n    width: 38px; height: 22px; border-radius: 11px; position: relative;\\n    background: #303035; border: 2px solid var(--frame-dark); box-shadow: 0 0 0 1px #39393f;\\n    transition: background .12s;\\n  }\\n  .sw::after {\\n    content: \\\"\\\"; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%;\\n    background: #bdbdc3; transition: transform .12s, background .12s;\\n  }\\n  .sw:checked { background: linear-gradient(var(--btn-top), #a4e77a); }\\n  .sw:checked::after { transform: translateX(16px); background: #fff; }\\n  .sw:focus-visible { outline: 2px solid var(--cream); outline-offset: 2px; }\\n  @media (prefers-reduced-motion: reduce) { .sw, .sw::after { transition: none; } }\\n\\n  /* modo teste */\\n  .mode { display: flex; align-items: center; gap: 12px; padding: 12px 14px; }\\n  .mode .tx { flex: 1; }\\n  .mode .tx b { display: block; color: #fff; font-size: 14px; }\\n  .mode .tx small { color: #9d9da6; font-weight: 500; font-size: 12px; }\\n  .mode .tag { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 9px; border: 1px solid var(--frame-dark); }\\n  .mode .tag.on { background: linear-gradient(#96f75a 0 50%, #69e01f 50%); color: #163a00; }\\n  .mode .tag.off { background: #1d6b3a; color: #c8f5c8; }\\n\\n  /* abas das categorias (iguais às do Market) */\\n  .tabs { display: flex; gap: 6px; padding: 12px 14px 0; flex-wrap: wrap; }\\n  .tabs button {\\n    display: flex; align-items: center; gap: 6px; height: 28px; padding: 0 12px; cursor: pointer;\\n    font: inherit; font-size: 12px; color: var(--cream);\\n    background: #28282c; border: 2px solid var(--frame-dark); border-radius: 6px; box-shadow: 0 0 0 1px #39393f;\\n  }\\n  .tabs button:hover { background: #303035; }\\n  .tabs button.cur {\\n    color: #fff; text-shadow: 1px 1px 0 var(--frame-dark);\\n    background: linear-gradient(var(--btn-top) 0 48%, var(--btn-bot) 48% 90%, var(--btn-edge) 90%);\\n    box-shadow: 0 0 0 1px var(--frame-hi);\\n  }\\n  .tabs .cnt {\\n    min-width: 18px; height: 16px; padding: 0 4px; border-radius: 8px; display: grid; place-items: center;\\n    font-size: 10px; background: var(--frame-dark); color: #c9ffa7;\\n  }\\n  .tabs .cnt.z { color: #52525b; }\\n\\n  /* lista de itens: cartões no estilo do Market oficial do jogo */\\n  .items { padding: 12px 8px; display: grid; grid-template-columns: repeat(auto-fill, minmax(188px, 1fr)); gap: 12px; }\\n  .mk-card {\\n    display: flex; flex-direction: column; gap: 10px; padding: 12px; border-radius: 12px; cursor: pointer;\\n    background: linear-gradient(#28282c, #1d1d21); border: 1px solid #39393f; box-shadow: inset 0 0 0 1px #131314;\\n  }\\n  .mk-card:hover { border-color: #a4e77a; }\\n  .mk-card.off { opacity: .55; }\\n  .mk-top { display: flex; align-items: flex-start; justify-content: space-between; }\\n  .mk-ico {\\n    width: 48px; height: 48px; border-radius: 50%; flex: none; position: relative; overflow: hidden;\\n    border: 2px solid rgba(0, 0, 0, .35); box-shadow: inset 0 2px 4px rgba(255, 255, 255, .3), inset 0 -3px 7px rgba(0, 0, 0, .4), 0 2px 8px rgba(0, 0, 0, .4);\\n  }\\n  .mk-ico::after { content: \\\"\\\"; position: absolute; left: 7px; top: 7px; width: 13px; height: 13px; border-radius: 50%; background: rgba(255, 255, 255, .55); filter: blur(1.5px); }\\n  .mk-ico-img { width: 48px; height: 48px; flex: none; border-radius: 10px; object-fit: contain; padding: 5px;\\n    background: radial-gradient(circle, #303035, #1d1d21); box-shadow: inset 0 0 0 1px #39393f; }\\n  .mk-ico.pokeball { background: linear-gradient(#e24a3f 0 48%, #1a1a1a 48% 52%, #ececed 52% 100%); }\\n  .mk-ico.great { background: linear-gradient(#3f7fe0 0 48%, #1a1a1a 48% 52%, #e24a3f 52% 100%); }\\n  .mk-ico.super { background: linear-gradient(#82f23c 0 48%, #1a1a1a 48% 52%, #3f7fe0 52% 100%); }\\n  .mk-ico.ultra { background: linear-gradient(#2c2c2c 0 48%, #1a1a1a 48% 52%, #82f23c 52% 100%); }\\n  .mk-ico.potion-small { background: radial-gradient(circle at 35% 30%, #ddffc8, #82f23c 55%, #60c91e); }\\n  .mk-ico.potion-great { background: radial-gradient(circle at 35% 30%, #c8ffd0, #3fae4f 55%, #1f6b2a); }\\n  .mk-ico.potion-ultra { background: radial-gradient(circle at 35% 30%, #cde9ff, #3f8fd8 55%, #205a8f); }\\n  .mk-ico.potion-hyper { background: radial-gradient(circle at 35% 30%, #ebebec, #97e06a 55%, #5cab2b); }\\n  .mk-ico.potion-ultimate { background: radial-gradient(circle at 35% 30%, #e6d8ff, #82d350 55%, #4a4a52); }\\n  .mk-ico.potion-golden { background: radial-gradient(circle at 35% 30%, #d8ffc0, #72e72a 55%, #50a81a); }\\n  .mk-ico.revive { background: radial-gradient(circle at 35% 30%, #e8ffe0, #6fbf5a 55%, #2f7a1f); }\\n  .mk-ico.revive-max { background: radial-gradient(circle at 35% 30%, #ffe0e0, #d8473f 55%, #8a1f1f); }\\n  .mk-nome { font-weight: 700; color: #fff; font-size: 13.5px; line-height: 1.25; }\\n  .mk-card.off .mk-nome { color: #9d9da6; }\\n  .mk-flds { display: flex; flex-direction: column; gap: 6px; }\\n  .mk-flds label { display: flex; flex-direction: column; gap: 3px; }\\n  .mk-flds label > span:first-child { font-size: 10.5px; color: #9d9da6; font-weight: 600; }\\n  .mk-card.off .fld { opacity: .5; }\\n\\n  .fld { display: flex; align-items: center; background: #131314; border: 1px solid #404047; border-radius: 6px; }\\n  .fld:focus-within { border-color: #a4e77a; box-shadow: 0 0 0 1px #a4e77a; }\\n  .fld input {\\n    width: 100%; min-width: 0; padding: 6px 8px; text-align: right; font: inherit;\\n    color: var(--cream); background: none; border: 0; outline: none;\\n  }\\n  .fld i { font-style: normal; font-size: 11px; color: #5e5e67; padding-right: 8px; }\\n\\n  /* rodapé fixo */\\n  #cfg .cf {\\n    flex: none; display: flex; gap: 10px; align-items: center; padding: 12px 20px;\\n    background: #26262a; box-shadow: inset 0 2px 0 var(--frame-dark), inset 0 3px 0 #39393f;\\n  }\\n  #cfg .cf .grow { flex: 1; }\\n  #cfg .cf .btn { height: 30px; padding: 0 16px; font-size: 13px; }\\n  #cfg .cf .btn.plain { background: #28282c; box-shadow: 0 0 0 1px #39393f, 0 0 0 2px var(--frame-dark); }\\n\\n  @media (max-width: 560px) {\\n    .items { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }\\n  }\\n  /* ======== janela de análise de PvP ======== */\\n  body.pvp { background: #19191b; border: 0; overflow: hidden; white-space: normal; font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif; color: var(--cream); }\\n  #pvp { display: flex; flex-direction: column; height: 100%; }\\n  #pvp .ch { flex: none; display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 150px 0 10px; background: #26262a; -webkit-app-region: drag;\\n    box-shadow: inset 0 -2px 0 var(--frame-dark), inset 0 -3px 0 #39393f; }\\n  #pvp .ch svg, #pvp .ch .appico { width: 18px; height: 18px; display: block; }\\n  #pvp .ch b { font-size: 12px; font-weight: 800; color: #fff; text-shadow: 1px 1px 0 var(--frame-dark); }\\n  #pvp .ch span { font-size: 12px; color: #9d9da6; }\\n  #pvp .tb { flex: none; display: flex; align-items: center; gap: 6px; padding: 10px 18px; background: #1d1d20; border-bottom: 1px solid #2a2a2e; flex-wrap: wrap; }\\n  #pvp .tb .grow { flex: 1; }\\n  #pvp .tb button.acc { height: 28px; padding: 0 12px; font: inherit; font-size: 12px; color: var(--cream); cursor: pointer;\\n    background: #28282c; border: 2px solid var(--frame-dark); border-radius: 6px; box-shadow: 0 0 0 1px #39393f; }\\n  #pvp .tb button.acc.cur { color: #fff; text-shadow: 1px 1px 0 var(--frame-dark); box-shadow: 0 0 0 1px var(--frame-hi);\\n    background: linear-gradient(var(--btn-top) 0 48%, var(--btn-bot) 48% 90%, var(--btn-edge) 90%); }\\n  #pvp .tb .btn { height: 28px; padding: 0 12px; }\\n  #pvp .cb { flex: 1; overflow: auto; padding: 16px 18px 24px; }\\n  .pv-msg { padding: 40px 10px; text-align: center; color: #bdbdc3; font-size: 14px; }\\n  .pv-cards { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin-bottom: 14px; }\\n  .pv-card { background: #202024; border: 2px solid var(--frame-dark); border-radius: 10px; box-shadow: 0 0 0 1px #39393f; padding: 10px 12px; }\\n  .pv-card small { display: block; font-size: 10px; letter-spacing: .05em; text-transform: uppercase; color: #9d9da6; }\\n  .pv-card b { display: block; margin-top: 3px; font-size: 20px; font-weight: 800; color: #fff; }\\n  .pv-card b .w { color: #8ee08e; } .pv-card b .l { color: #ff8a8a; }\\n  .pv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }\\n  .pv-pn { background: #202024; border: 2px solid var(--frame-dark); border-radius: 10px; box-shadow: 0 0 0 1px #39393f; margin-bottom: 14px; min-width: 0; }\\n  .pv-pn h2 { margin: 0; padding: 12px 14px 8px; font-size: 14px; font-weight: 800; color: #fff; }\\n  .pv-pn h2 small { font-weight: 500; color: #9d9da6; font-size: 11px; margin-left: 6px; }\\n  .pv-sug { list-style: none; margin: 0; padding: 0 12px 12px; display: grid; gap: 6px; }\\n  .pv-sug li { display: flex; gap: 10px; align-items: flex-start; padding: 8px 10px; background: #252529; border-radius: 7px; line-height: 1.4; font-weight: 500; }\\n  .pv-sug li i { flex: none; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-style: normal; font-size: 11px; font-weight: 800;\\n    border: 1px solid var(--frame-dark); color: #fff; background: radial-gradient(circle at 35% 30%, var(--chip-1), var(--chip-2)); }\\n  .pv-sug li.rival i { background: radial-gradient(circle at 35% 30%, #ff8a8a, #b8283c); }\\n  .pv-sug li.forte i { background: radial-gradient(circle at 35% 30%, #ceffb0, #69e01f 60%, #4db80b); color: #163a00; }\\n  .pv-sug li.counter i { background: radial-gradient(circle at 35% 30%, #8ec5ff, #2f6fd6); }\\n  .pv-sug li.ordem i { background: radial-gradient(circle at 35% 30%, #8ee08e, #009c3b); }\\n  .pv-tab { width: 100%; border-collapse: collapse; font-size: 12px; }\\n  .pv-tab th { text-align: left; padding: 6px 10px; color: #c9ffa7; font-size: 11px; font-weight: 700; background: #26262a; white-space: nowrap; }\\n  .pv-tab td { padding: 7px 10px; border-top: 1px solid #2a2a2e; white-space: nowrap; }\\n  .pv-tab td.n { color: #fff; font-weight: 700; }\\n  .pv-tab .w { color: #8ee08e; } .pv-tab .l { color: #ff8a8a; }\\n  .pv-bar { display: inline-block; vertical-align: middle; width: 60px; height: 7px; border-radius: 4px; background: #303035; overflow: hidden; margin-right: 6px; }\\n  .pv-bar span { display: block; height: 100%; background: linear-gradient(90deg, #e05a6a, #96f75a 50%, #4ccf6a); }\\n  .pv-scroll { max-height: 360px; overflow: auto; }\\n  .pv-type { display: inline-block; font-size: 9px; font-weight: 800; padding: 1px 5px; border-radius: 4px; margin-right: 3px; color: #fff; text-shadow: 0 1px 0 rgba(0,0,0,.4); }\\n  .pv-chip { display: inline-block; font-size: 11px; font-weight: 700; padding: 1px 7px; border-radius: 9px; margin: 1px 3px 1px 0; }\\n  .pv-chip.ok { background: #1d4d2a; color: #b6f5c0; } .pv-chip.no { background: #333338; color: #ffc2c8; }\\n  .pv-ct { padding: 8px 14px; border-top: 1px solid #2a2a2e; }\\n  .pv-ct .t { display: flex; justify-content: space-between; gap: 8px; align-items: center; }\\n  .pv-ct .t b { color: #fff; }\\n  .pv-ct .t span { font-size: 11px; color: #ff8a8a; }\\n  .pv-ct .u { margin-top: 4px; font-size: 11px; color: #9d9da6; }\\n  /* abas e blocos organizados */\\n  .pv-nav { flex: none; display: flex; gap: 2px; padding: 0 18px; background: #1d1d20; border-bottom: 1px solid #2a2a2e; }\\n  .pv-tab { height: 36px; padding: 0 16px; cursor: pointer; font: 700 13px \\\"Segoe UI\\\", sans-serif; color: #9d9da6;\\n    background: none; border: 0; border-bottom: 3px solid transparent; }\\n  .pv-tab:hover { color: #fff; }\\n  .pv-tab.cur { color: #fff; border-bottom-color: #9b9ba5; }\\n  .pv-pn h2 { display: flex; align-items: baseline; gap: 6px; }\\n  .pv-more { margin-left: auto; padding: 0; border: 0; background: none; cursor: pointer; font: 700 11px \\\"Segoe UI\\\", sans-serif; color: #c9ffa7; }\\n  .pv-more:hover { text-decoration: underline; }\\n  .pv-pb { padding: 0 12px 12px; display: grid; gap: 6px; }\\n  .pv-pn.rival { box-shadow: 0 0 0 1px #3d3d43; } .pv-pn.ordem { box-shadow: 0 0 0 1px #2f6b22; }\\n  .pv-pn.counter { box-shadow: 0 0 0 1px #2f5a8a; } .pv-pn.time { box-shadow: 0 0 0 1px #3b6e1c; }\\n  .pv-row { padding: 8px 10px; background: #252529; border-radius: 8px; display: grid; gap: 4px; }\\n  .pv-row-a { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\\n  .pv-row-a > b { color: #fff; font-size: 13px; }\\n  .pv-row-b { display: flex; align-items: center; gap: 6px; font-size: 11px; color: #bdbdc3; }\\n  .pv-row-c { font-size: 12px; color: #bdbdc3; font-weight: 500; }\\n  .pv-row-c b { color: #fff; }\\n  .pv-rec { margin-left: auto; font-size: 12px; } .pv-rec .w { color: #8ee08e; } .pv-rec .l { color: #ff8a8a; }\\n  .pv-wr { margin-left: auto; font-size: 11px; font-weight: 700; } .pv-wr.l { color: #ff8a8a; } .pv-wr.w { color: #8ee08e; }\\n  .pv-ordem { display: flex; align-items: center; flex-wrap: wrap; gap: 4px; }\\n  .pv-mon { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 9px; background: #1d4d2a; color: #c8f5c8; }\\n  .pv-arr { color: #5e5e67; font-size: 11px; }\\n  .pv-hl { display: flex; gap: 10px; align-items: flex-start; padding: 8px 10px; border-radius: 8px; background: #252529; font-weight: 500; line-height: 1.4; }\\n  .pv-hl i { flex: none; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font-style: normal; font-size: 11px; font-weight: 800; color: #fff; }\\n  .pv-hl.good i { background: radial-gradient(circle at 35% 30%, #ceffb0, #69e01f 60%, #4db80b); color: #163a00; }\\n  .pv-hl.bad i { background: radial-gradient(circle at 35% 30%, #ff8a8a, #b8283c); }\\n  .pv-hl.warn i { background: radial-gradient(circle at 35% 30%, var(--chip-1), var(--chip-2)); }\\n  .pv-none { font-size: 12px; color: #5e5e67; padding: 4px 2px; font-weight: 500; }\\n  .pv-foot { margin-top: 6px; font-size: 11px; color: #5e5e67; line-height: 1.5; }\\n  @media (max-width: 900px) { .pv-grid { grid-template-columns: 1fr; } .pv-cards { grid-template-columns: repeat(3, 1fr); } }\\n  /* ======== janela de pontos da Kick ======== */\\n  body.kickw, body.twitchw { background: #19191b; border: 0; overflow: hidden; white-space: normal; font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif; color: var(--cream); }\\n  #otimw.panel {\\n    position: fixed; z-index: 12; display: flex; flex-direction: column;\\n    width: min(420px, calc(100vw - 16px)); max-height: min(640px, calc(100vh - 56px));\\n    background: #19191b; color: var(--cream); white-space: normal; font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif;\\n    border: 2px solid var(--frame-dark); border-radius: 12px; overflow: hidden;\\n    box-shadow: 0 0 0 1px #2f6b22, 0 18px 40px rgba(10, 10, 10, .6);\\n    animation: ddIn .1s ease-out;\\n  }\\n  #otimw .ch { flex: none; display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 10px; background: #26262a; -webkit-app-region: no-drag; }\\n  #otimw .ch b { font-size: 12px; font-weight: 800; color: #fff; text-shadow: 1px 1px 0 var(--frame-dark); }\\n  #otimw .ch .cfg-x { margin-left: auto; width: 26px; height: 26px; padding: 0; border: 0; border-radius: 6px; cursor: pointer;\\n    background: none; color: var(--cream); font: 700 18px/1 \\\"Segoe UI\\\", sans-serif; }\\n  #otimw .ch .cfg-x:hover { background: #8a2a3a; color: #fff; }\\n  #otimw .cb { flex: 1; overflow: auto; padding: 14px 16px 18px; display: flex; flex-direction: column; gap: 12px; }\\n  .ot-mem { display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; border-radius: 10px;\\n    background: linear-gradient(#28282c, #1d1d21); border: 1px solid #39393f; }\\n  .ot-mem b { font-size: 22px; color: #8ef07a; }\\n  .ot-mem small { color: #9d9da6; font-weight: 600; }\\n  .ot-bar { height: 6px; border-radius: 3px; background: #131314; overflow: hidden; margin-top: 4px; }\\n  .ot-bar i { display: block; height: 100%; background: linear-gradient(90deg, #8ef07a, #4cc23a); }\\n  .ot-row { display: flex; flex-direction: column; gap: 6px; }\\n  .ot-row > b { font-size: 12.5px; color: #fff; }\\n  .ot-opts { display: flex; gap: 6px; flex-wrap: wrap; }\\n  .ot-opt { padding: 6px 11px; border-radius: 7px; font: 700 11.5px \\\"Segoe UI\\\", sans-serif; cursor: pointer;\\n    background: #28282c; border: 1px solid #39393f; color: #d0eebd; }\\n  .ot-opt.sel { background: #5baa2a; border-color: #9ae06f; color: #fff; }\\n  .ot-hist { display: flex; flex-direction: column; gap: 4px; max-height: 120px; overflow: auto; }\\n  .ot-hist div { display: flex; justify-content: space-between; font-size: 11.5px; color: #aeaeb5; }\\n  .ot-vazio { color: #5e5e67; font-size: 12px; }\\n  #kickw, #twitchw { display: flex; flex-direction: column; height: 100%; }\\n  #kickw .ch, #twitchw .ch { flex: none; display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 150px 0 10px; background: #26262a; -webkit-app-region: drag;\\n    box-shadow: inset 0 -2px 0 var(--frame-dark), inset 0 -3px 0 #39393f; }\\n  #kickw .ch svg, #kickw .ch .appico, #twitchw .ch svg, #twitchw .ch .appico { width: 18px; height: 18px; display: block; }\\n  #kickw .ch b, #twitchw .ch b { font-size: 12px; font-weight: 800; color: #fff; text-shadow: 1px 1px 0 var(--frame-dark); }\\n  #kickw .ch span, #twitchw .ch span { font-size: 12px; color: #9d9da6; }\\n  #kickw .cb, #twitchw .cb { flex: 1; overflow: auto; padding: 16px 18px 24px; }\\n  #kickw .cb, #twitchw .cb { padding: 14px 18px 22px; }\\n  .kx-top { flex: none; display: flex; align-items: center; gap: 6px; padding: 10px 18px; background: #1d1d20; border-bottom: 1px solid #2a2a2e; flex-wrap: wrap; }\\n  .kx-top .grow { flex: 1; }\\n  .kx-tab { display: inline-flex; align-items: center; gap: 7px; height: 30px; padding: 0 12px; cursor: pointer;\\n    font: 700 12px \\\"Segoe UI\\\", sans-serif; color: var(--cream); background: #28282c; border: 2px solid var(--frame-dark); border-radius: 8px; }\\n  .kx-tab:hover { filter: brightness(1.15); }\\n  .kx-tab.cur { color: #fff; background: linear-gradient(#1d6b1a 0 48%, #2f9a22 48%); box-shadow: 0 0 0 1px #53fc18; }\\n  .kx-tab.off { opacity: .55; }\\n  .kx-badge { min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px; display: grid; place-items: center; font-size: 11px; background: #0e1f0b; color: #8ef07a; }\\n  .kx-btn { height: 30px; padding: 0 14px; cursor: pointer; font: 700 12px \\\"Segoe UI\\\", sans-serif; color: var(--cream);\\n    background: #28282c; border: 2px solid var(--frame-dark); border-radius: 8px; white-space: nowrap; }\\n  .kx-btn:hover { filter: brightness(1.2); }\\n  .kx-btn.small { height: 28px; padding: 0 10px; font-size: 11px; }\\n  .kx-btn.go { color: #0b2e0b; background: linear-gradient(#a8ff8a, #53fc18); border-color: #12210e; }\\n  .kx-btn:disabled, .kx-btn.go:disabled { cursor: not-allowed; filter: none; color: #4d4d55; background: #202024; border-color: #2a2a2f; }\\n  .kx-btn.sel { color: #fff; background: #1d4d1a; box-shadow: 0 0 0 1px #53fc18; }\\n  .kx-sum { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding: 12px 14px; margin-bottom: 14px;\\n    background: linear-gradient(90deg, #142112, #19191b); border: 1px solid #2f4a26; border-radius: 12px; }\\n  .kx-sum > div:first-child { flex: 1; min-width: 220px; }\\n  .kx-sum > div:first-child b { display: block; color: #fff; font-size: 14px; }\\n  .kx-sum > div:first-child span { font-size: 12px; color: #9d9da6; font-weight: 500; }\\n  .kx-goalbar { display: flex; gap: 8px; }\\n  .kx-goalbar div { padding: 6px 10px; border-radius: 8px; background: #0e1a0b; border: 1px solid #2f6b22; text-align: center; }\\n  .kx-goalbar b { display: block; color: #8ef07a; font-size: 13px; }\\n  .kx-goalbar span { font-size: 10px; color: #d8f5cf; }\\n  .kx-h { margin: 6px 2px 10px; font-size: 13px; color: #fff; letter-spacing: .02em; }\\n  .kx-h small { margin-left: 6px; font-size: 11px; font-weight: 500; color: #9d9da6; }\\n  .kx-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin-bottom: 18px; }\\n  .kx-card { display: flex; flex-direction: column; gap: 12px; padding: 14px; border-radius: 14px;\\n    background: linear-gradient(160deg, #1d2a18, #1a1a1c 70%); border: 1px solid #2f6b22; box-shadow: 0 6px 18px rgba(0,0,0,.25); }\\n  .kx-card.idle { background: linear-gradient(160deg, #1e1a1e, #19191b 70%); border-color: #303035; }\\n  .kx-card.idle .kx-ring { filter: saturate(.35) brightness(.8); }\\n  .kx-off { color: #96f75a; }\\n  .kx-card.done { border-color: #96f75a; box-shadow: 0 0 0 1px #96f75a, 0 6px 18px rgba(0,0,0,.25); }\\n  .kx-ch { display: flex; align-items: center; justify-content: space-between; gap: 8px; }\\n  .kx-ch b { font-size: 15px; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .kx-st { font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 10px; background: #202024; color: #9d9da6; white-space: nowrap; }\\n  .kx-st.ok { background: #0e2a0b; color: #8ef07a; }\\n  .kx-st.live { display: inline-flex; align-items: center; gap: 6px; background: #232327; color: #fff; letter-spacing: .04em; }\\n  .kx-st.live .rec { display: inline-block; flex: none; width: 8px; height: 8px; border-radius: 50%; background: #ff3b4e; box-shadow: 0 0 6px #ff3b4e; animation: recBlink 1s steps(1) infinite; }\\n  @media (prefers-reduced-motion: reduce) { .kx-st.live .rec { animation: none; } }\\n  .kx-st.warn { background: #203b0f; color: #96f75a; }\\n  .kx-st.bad { background: #232327; color: #ff8a8a; }\\n  .kx-mid { display: flex; align-items: center; gap: 14px; }\\n  .kx-ringbox { position: relative; width: 92px; height: 92px; flex: none; }\\n  .kx-ring { position: absolute; inset: 0; border-radius: 50%;\\n    background: conic-gradient(#53fc18 calc(var(--p) * 1%), #202024 0); }\\n  .kx-ring.full { background: conic-gradient(#96f75a 100%, #202024 0); }\\n  .kx-ring-in { position: absolute; inset: 8px; border-radius: 50%; background: #1c1a1e; }\\n  .kx-ringtx { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }\\n  .kx-ringtx b { font-size: 22px; font-weight: 800; color: #fff; line-height: 1; }\\n  .kx-ringtx span { font-size: 10px; color: #9d9da6; }\\n  .kx-info { flex: 1; min-width: 0; display: grid; gap: 3px; }\\n  .kx-next { font-size: 12px; color: #bdbdc3; }\\n  .kx-next b { color: #fff; }\\n  .kx-falta { font-size: 13px; color: #d8f5cf; }\\n  .kx-falta b { color: #8ef07a; }\\n  .kx-meta { font-size: 11px; color: #9d9da6; }\\n  .kx-meta b { color: #8ef07a; }\\n  .kx-goals { display: flex; gap: 4px; margin-top: 3px; }\\n  .kx-goals span { font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 6px; background: #202024; color: #5e5e67; }\\n  .kx-goals span.on { background: #1d4d1a; color: #8ef07a; }\\n  .kx-act { display: flex; gap: 8px; }\\n  .kx-act .kx-btn { flex: 1; }\\n  .kx-minis { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 8px; margin-bottom: 14px; }\\n  .kx-mini { display: flex; align-items: center; gap: 8px; height: 38px; padding: 0 12px; cursor: pointer; text-align: left;\\n    font: 700 12px \\\"Segoe UI\\\", sans-serif; color: var(--cream); background: #202024; border: 1px solid #303035; border-radius: 10px; }\\n  .kx-mini:hover { filter: brightness(1.2); }\\n  /* remover canal (não é mais parceiro) */\\n  .kx-x { display: inline-grid; place-items: center; width: 18px; height: 18px; flex: none; border-radius: 4px; cursor: pointer;\\n    font: 700 13px/1 inherit; color: #b2b2ba; background: transparent; border: 1px solid transparent; padding: 0; }\\n  .kx-x:hover { color: #fff; background: #7a2232; border-color: #61616c; }\\n  .kx-chr { display: flex; align-items: center; gap: 6px; }\\n  .kx-mini.rmv { opacity: .7; }\\n  .kx-mini.rmv .nm { text-decoration: line-through; }\\n  .kx-mini.rmv b { font-weight: 600; color: #9ae76a; }\\n  .kx-mini .dot { width: 8px; height: 8px; flex: none; border-radius: 50%; background: #414148; }\\n  .kx-mini.live .dot { background: #53fc18; box-shadow: 0 0 6px #53fc18; }\\n  .kx-mini .nm { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .kx-mini b { color: #9d9da6; font-weight: 700; }\\n  .kx-mini i { font-style: normal; color: #8ef07a; }\\n  .kx-mini.sel { background: #1d3a18; border-color: #53fc18; }\\n  .kx-mini.sel b { color: #c8f5c8; }\\n  .kx-empty { padding: 14px; margin-bottom: 16px; font-size: 12px; color: #9d9da6; background: #1d1d20; border-radius: 10px; }\\n  .kx-empty.big { display: grid; gap: 4px; padding: 30px; text-align: center; }\\n  .kx-empty.big b { color: #fff; font-size: 15px; }\\n  .kx-empty.big .kx-on { margin-top: 10px; height: 34px; padding: 0 18px; font-size: 13px; }\\n  .kx-av { margin-right: 6px; color: var(--cream); }\\n  .kx-sw { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; color: #d8f5cf; cursor: pointer; }\\n  .kx-resgate { display: flex; flex-direction: column; gap: 6px; padding: 8px 12px; border-radius: 8px; background: #19191b; border: 1px solid #39393f; }\\n  .kx-tiers { display: flex; gap: 10px; }\\n  .kx-tier { display: flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 700; color: #d0eebd; cursor: pointer; }\\n  .kx-warn { color: #84e04a; font-weight: 600; max-width: 220px; }\\n  .kx-info { color: #9d9da6; font-weight: 500; max-width: 240px; }\\n  .kx-foot { margin-top: 4px; font-size: 11px; color: #5e5e67; line-height: 1.5; }\\n\\n  /* ===== PAINEL DA TWITCH: mesmo desenho da Kick, no roxo da Twitch (#9146ff) ===== */\\n  #twitchw .kx-tab.cur { background: linear-gradient(#4b2a86 0 48%, #7a3fd4 48%); box-shadow: 0 0 0 1px #9146ff; }\\n  #twitchw .kx-badge { background: #1d1030; color: #cbb0ff; }\\n  #twitchw .kx-btn.go { color: #1a0b33; background: linear-gradient(#cdb0ff, #9146ff); border-color: #2a1346; }\\n  #twitchw .kx-btn.sel { background: #3a2166; box-shadow: 0 0 0 1px #9146ff; }\\n  #twitchw .kx-goalbar div { background: #190f29; border-color: #5b34a0; }\\n  #twitchw .kx-goalbar b { color: #cbb0ff; }\\n  #twitchw .kx-goalbar span { color: #e2d5ff; }\\n  #twitchw .kx-card.done { border-color: #bf94ff; box-shadow: 0 0 0 1px #bf94ff, 0 6px 18px rgba(0,0,0,.25); }\\n  #twitchw .kx-ring { background: conic-gradient(#9146ff calc(var(--p) * 1%), #202024 0); }\\n  #twitchw .kx-ring.full { background: conic-gradient(#bf94ff 100%, #202024 0); }\\n  #twitchw .kx-st.ok, #twitchw .kx-st.warn { background: #241440; color: #cbb0ff; }\\n  #twitchw .kx-off, #twitchw .kx-falta b, #twitchw .kx-meta b, #twitchw .kx-mini i { color: #cbb0ff; }\\n  #twitchw .kx-falta, #twitchw .kx-sw, #twitchw .kx-tier { color: #ded0f7; }\\n  #twitchw .kx-goals span.on { background: #3a2166; color: #cbb0ff; }\\n  #twitchw .kx-mini.live .dot { background: #9146ff; box-shadow: 0 0 6px #9146ff; }\\n  #twitchw .kx-mini.sel { background: #2b1b4a; border-color: #9146ff; }\\n  #twitchw .kx-mini.sel b { color: #ded0f7; }\\n  #twitchw .kx-mini.rmv b { color: #b89bf0; }\\n  #twitchw .kx-warn { color: #ffb86b; }\\n  #twitchw .sw:checked { background: linear-gradient(var(--btn-top), #a37bf0); }\\n  #twitchw .kx-btn:disabled, #twitchw .kx-btn.go:disabled { cursor: not-allowed; filter: none; color: #4d4d55; background: #202024; border-color: #2a2a2f; }\\n  #twitchw .kx-sum > div:first-child span { display: block; }\\n  #twitchw .tw-vinc { margin-top: 3px; }\\n  /* avisos proprios da Twitch */\\n  #twitchw .tw-alert { display: flex; gap: 10px; align-items: flex-start; padding: 11px 13px; margin-bottom: 13px;\\n    font-size: 12px; font-weight: 600; line-height: 1.45; color: #ffe2bd; background: #2e1e0c; border: 1px solid #7a5420; border-radius: 10px; }\\n  #twitchw .tw-alert b { color: #fff; }\\n  #twitchw .tw-alert.roxo { color: #e2d5ff; background: #1d1030; border-color: #5b34a0; }\\n  #twitchw .tw-pack { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }\\n  #twitchw .tw-pack span { font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 6px; background: #202024; color: #8d8d97; }\\n  #twitchw .tw-pack span.on { background: #3a2166; color: #cbb0ff; }\\n  #twitchw .tw-vinc { font-size: 11px; font-weight: 600; color: #9d9da6; }\\n  #twitchw .tw-vinc b { color: #cbb0ff; }\\n\\n  .btn.resg .chip { background: radial-gradient(circle at 35% 30%, #a8ff8a, #3cd61b); }\\n\\n  /* ===================================================================\\n     TEMA KICK — cinza escuro + verde (#53fc18)\\n     Bloco final: ajusta os tons-chave e devolve o amarelo aos avisos.\\n     Mexer SO aqui para afinar cores; o resto do arquivo ja foi convertido.\\n     =================================================================== */\\n  :root {\\n    --frame-dark: #0e0e10;   /* contorno externo escuro */\\n    --frame:      #1c1c20;   /* corpo das barras/paineis */\\n    --frame-top:  #232329;   /* topo do degrade */\\n    --frame-hi:   #3a3a42;   /* risco claro da moldura */\\n    --btn-top:    #2a2a30;   /* botao: topo */\\n    --btn-bot:    #35353c;   /* botao: base */\\n    --btn-edge:   #4a4a54;   /* botao: borda de baixo */\\n    --chip-1:     #6cf52e;   /* medalhao: claro */\\n    --chip-2:     #2f9e0c;   /* medalhao: escuro */\\n    --cream:      #ffffff;   /* texto principal */\\n    --box:        #141417;   /* caixas internas */\\n    --kick:       #53fc18;   /* verde da Kick */\\n    --kick-dark:  #2f9e0c;\\n    --amber:      #ffb02e;   /* avisos */\\n  }\\n  /* botao ligado: verde da Kick */\\n  .btn.on {\\n    background: linear-gradient(#1d6b0b 0 48%, #2c9c10 48% 90%, var(--kick) 90%);\\n    outline: 2px solid var(--kick); outline-offset: 1px;\\n  }\\n  /* avisos voltam a ser amarelos (senao \\\"medio\\\" e \\\"ok\\\" ficariam iguais) */\\n  .perf.l2 .chip { background: radial-gradient(circle at 35% 30%, #ffd27a, #d08a10); }\\n  .dlg .ico.warning { background: radial-gradient(circle at 35% 30%, #ffd27a, #d08a10); color: #3a2400; }\\n  .uso-c.medio { --n: var(--amber); background: #221d12; border-color: #5c4414; }\\n  .kx-st.warn { background: #2e2206; color: #ffc859; }\\n  .kx-warn { color: #e0a53e; }\\n  .lv, .mx { --warn: var(--amber); }\\n\\n  /* ===================================================================\\n     PAINEL DA DIREITA v2 — cabeçalho, consumo (gráficos), Otimizar grande\\n     (estrutura do IdleDeck, cores cinza + verde da Kick)\\n     =================================================================== */\\n  body.otimside { background: #141416; }\\n  body.otimside .ot-col { scrollbar-width: thin; scrollbar-color: #34343a transparent; }\\n  .ot-head { padding: 14px 14px 10px; border-bottom: 1px solid #26262a; flex: none; }\\n  .ot-head b { display: block; font-size: 16px; font-weight: 800; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .ot-head small { display: block; margin-top: 2px; font-size: 11.5px; font-weight: 500; color: #9a9aa4; }\\n  .ot-head small i { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--kick); box-shadow: 0 0 6px var(--kick); margin-right: 6px; vertical-align: 1px; }\\n  /* ordem: ações rápidas primeiro (como na referência), depois as automações */\\n  body.otimside #app { background: transparent; border-bottom: 1px solid #26262a; padding: 12px 14px; }\\n  body.otimside #app .grp.right.qa-grid { order: -1; }\\n  .qa-btn {\\n    aspect-ratio: auto; height: 50px; border-radius: 9px; gap: 3px;\\n    background: #1d1d21; border: 1px solid #2c2c32; box-shadow: none; text-shadow: none; color: #d6d6dc;\\n  }\\n  .qa-btn:hover { background: #26262b; filter: none; color: #fff; }\\n  .qa-btn.on { background: #17310f; border-color: #2f6a14; color: #b6ff8f; }\\n  .qa-lbl { font-size: 10px; font-weight: 600; }\\n  body.otimside .ot-wrap { padding: 14px; gap: 0; }\\n  .ot-sec { margin: 0 0 8px; font-size: 10.5px; font-weight: 700; letter-spacing: .9px; text-transform: uppercase; color: #8c8c96; }\\n  .ot-bloco { margin-bottom: 20px; }\\n  .ot-graf { margin-bottom: 14px; }\\n  .ot-graf-top { display: flex; justify-content: space-between; align-items: baseline; font-size: 12px; color: #b4b4bc; font-weight: 500; }\\n  .ot-graf-top b { color: #fff; font-size: 12.5px; font-weight: 700; }\\n  .ot-graf svg { display: block; width: 100%; height: 46px; margin-top: 4px; }\\n  .ot-graf .vazio { height: 46px; margin-top: 4px; display: grid; place-items: center; font-size: 11px; color: #5e5e67; font-weight: 500;\\n    border-bottom: 1px solid #26262a; }\\n  .ot-big {\\n    display: flex; align-items: center; gap: 12px; width: 100%; padding: 12px 14px; cursor: pointer;\\n    border: 0; border-radius: 10px; color: #0b1a05; text-align: left; font-family: inherit;\\n    background: linear-gradient(135deg, #7dff3f, #3fcf0e); box-shadow: 0 4px 14px rgba(83, 252, 24, .22);\\n  }\\n  .ot-big:hover { filter: brightness(1.08); }\\n  .ot-big:active { transform: translateY(1px); }\\n  .ot-big:disabled { filter: grayscale(.5) brightness(.8); cursor: wait; }\\n  .ot-big-ico { flex: none; width: 30px; height: 30px; border-radius: 8px; display: grid; place-items: center; font-size: 17px; background: rgba(255,255,255,.28); }\\n  .ot-big b { display: block; font-size: 15px; font-weight: 800; }\\n  .ot-big small { display: block; font-size: 11px; font-weight: 600; opacity: .75; }\\n  .ot-sub { margin-top: 12px; }\\n  .ot-sub > span { display: block; margin-bottom: 6px; font-size: 11.5px; color: #a4a4ad; font-weight: 600; }\\n  .ot-opt { background: #1d1d21; border: 1px solid #2c2c32; color: #cfcfd6; font-weight: 600; padding: 5px 10px; }\\n  .ot-opt:hover { background: #26262b; color: #fff; }\\n  .ot-opt.sel { background: #17310f; border-color: #3f8a1c; color: #b6ff8f; }\\n  .ot-hist { max-height: none; gap: 9px; }\\n  .ot-hist div { justify-content: flex-start; gap: 14px; font-size: 11.5px; color: #c4c4cb; align-items: flex-start; }\\n  .ot-hist div span:first-child { color: #7c7c86; flex: none; font-variant-numeric: tabular-nums; }\\n\\n  /* texto do botão grande pode quebrar linha em vez de ser cortado */\\n  .ot-big { gap: 10px; padding: 11px 12px; white-space: normal; }\\n  .ot-big-ico { width: 28px; height: 28px; }\\n  .ot-big small { white-space: normal; font-size: 10.5px; line-height: 1.25; }\\n  /* botões de automação: planos como no IdleDeck (sem moldura dupla), barrinha verde quando ligados */\\n  body.otimside #app .grp.mid .btn, body.otimside #app .grp.livesg .btn {\\n    background: #1d1d21 !important; border: 1px solid #2c2c32; border-left: 3px solid #2c2c32;\\n    border-radius: 8px; box-shadow: none !important; text-shadow: none; height: 32px; color: #e4e4e8;\\n  }\\n  body.otimside #app .grp.mid .btn:hover, body.otimside #app .grp.livesg .btn:hover { background: #26262b !important; filter: none; }\\n  body.otimside #app .grp.mid .btn.on, body.otimside #app .grp.livesg .btn.on {\\n    background: #1a2315 !important; border-color: #2c2c32; border-left-color: var(--kick); outline: none;\\n  }\\n\\n  /* ===================================================================\\n     LISTA DE CONTAS (esquerda) v2 — cabeçalho, resumo, grupo com moldura,\\n     avatar com bolinha de status e subtítulo (estrutura do IdleDeck)\\n     =================================================================== */\\n  body.sidebar { background: #121214; }\\n  .sd-wrap { display: flex; flex-direction: column; gap: 10px; padding: 10px 8px; height: 100%; overflow: auto; flex: 1; min-width: 0;\\n    scrollbar-width: thin; scrollbar-color: #34343a transparent; }\\n  .sd-top { display: flex; align-items: center; gap: 9px; padding: 2px 4px 0; }\\n  .sd-logo { width: 30px; height: 30px; border-radius: 9px; flex: none; display: grid; place-items: center; background: #1b2a14; color: var(--kick); }\\n  .sd-logo svg { width: 20px; height: 20px; display: block; }\\n  .sd-top b { flex: 1; min-width: 0; font-size: 15px; font-weight: 800; color: #fff; letter-spacing: .2px; }\\n  .sd-collapse { flex: none; width: 26px; height: 26px; border: 0; border-radius: 7px; background: transparent; color: #8c8c96; font-size: 15px; cursor: pointer; }\\n  .sd-collapse:hover { background: #222226; color: #fff; }\\n  .sd-all { display: flex; align-items: center; gap: 10px; width: 100%; padding: 9px 10px; border-radius: 11px; cursor: pointer; text-align: left;\\n    background: #1a1a1e; border: 1px solid #28282d; color: #fff; font-family: inherit; }\\n  .sd-all:hover { background: #202025; }\\n  .sd-all.cur { border-color: #2f6a14; background: #17221a; }\\n  .sd-all .sd-av { background: #2a3d20; color: #b6ff8f; text-shadow: none; box-shadow: none; }\\n  .sd-all .sd-txt b { font-size: 13.5px; font-weight: 800; }\\n  .sd-grp { display: flex; flex-direction: column; gap: 2px; padding: 8px 6px 6px; border-radius: 13px; background: #17171a; border: 1px solid #2a2a30; }\\n  .sd-gh { display: flex; align-items: center; gap: 8px; padding: 2px 6px 9px; margin-bottom: 4px; border-bottom: 1px solid #25252a; }\\n  .sd-gdot { width: 8px; height: 8px; border-radius: 50%; flex: none; background: var(--kick); box-shadow: 0 0 7px rgba(83, 252, 24, .65); }\\n  .sd-gdot.off { background: #55555d; box-shadow: none; }\\n  .sd-gh b { display: block; font-size: 12.5px; font-weight: 800; color: #fff; }\\n  .sd-gh small { display: block; margin-top: 1px; font-size: 10.5px; font-weight: 500; color: #8c8c96; }\\n  .sd-row { display: flex; align-items: center; gap: 8px; width: 100%; padding: 6px; border: 0; border-radius: 9px; background: transparent;\\n    color: #fff; cursor: pointer; text-align: left; font-family: inherit; }\\n  .sd-row:hover { background: #202024; }\\n  .sd-row.cur { background: #25252a; box-shadow: inset 0 0 0 1px rgba(83, 252, 24, .38); }\\n  .sd-row.off .sd-av, .sd-row.off .sd-txt { opacity: .55; }\\n  .sd-av { position: relative; width: 30px; height: 30px; border-radius: 8px; flex: none; display: grid; place-items: center;\\n    font-size: 11px; font-weight: 800; color: #fff; text-shadow: 1px 1px 0 rgba(0, 0, 0, .35); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .2); }\\n  .sd-dot { position: absolute; right: -3px; bottom: -3px; width: 10px; height: 10px; border-radius: 50%; border: 2px solid #17171a; background: #55555d; }\\n  .sd-row.cur .sd-dot { border-color: #25252a; }\\n  .sd-dot.m0 { background: var(--kick); } .sd-dot.m1 { background: #5ad1c4; } .sd-dot.m2 { background: #8ec5ff; } .sd-dot.m3 { background: #55555d; }\\n  .sd-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }\\n  .sd-nm { font-size: 12.5px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .sd-sub { font-size: 10.5px; font-weight: 500; color: #8c8c96; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .sd-mm { flex: none; font-size: 11px; font-weight: 700; }\\n  .sd-mm.nivel-ok { color: #8ef07a; } .sd-mm.nivel-med { color: var(--amber); } .sd-mm.nivel-alto { color: #ff8a7a; } .sd-mm.nivel- { color: #8c8c96; }\\n  .sd-rl { display: none; flex: none; width: 24px; height: 24px; border-radius: 7px; place-items: center; font-size: 14px; color: #b4b4bc; }\\n  .sd-rl:hover { background: #303035; color: #fff; }\\n  .sd-row:hover .sd-mm { display: none; }\\n  .sd-row:hover .sd-rl { display: grid; }\\n\\n  /* ===================================================================\\n     PAINEL DA DIREITA v3 — blocos com divisória de ponta a ponta,\\n     gráficos na largura toda, Otimizar compacto e rodapé fixo\\n     =================================================================== */\\n  body.otimside #app { gap: 10px; padding: 14px; }\\n  body.otimside #app .grp.right.qa-grid { padding-bottom: 14px; border-bottom: 1px solid #26262a; margin-bottom: 2px; }\\n  body.otimside .ot-sec { margin: 0 0 10px; }\\n  body.otimside #app .ot-sec-auto { margin: 4px 0 -2px; }\\n  body.otimside .ot-wrap { padding: 0; gap: 0; }\\n  body.otimside .ot-bloco { margin: 0; padding: 14px; border-bottom: 1px solid #26262a; }\\n  body.otimside .ot-bloco:last-child { border-bottom: 0; }\\n  .ot-sec-row { display: flex; align-items: center; justify-content: space-between; }\\n  .ot-link { border: 0; background: transparent; color: #8c8c96; font: 600 10.5px \\\"Segoe UI\\\", sans-serif; cursor: pointer; padding: 0; text-transform: none; letter-spacing: 0; }\\n  .ot-link:hover { color: var(--kick); }\\n  .ot-como { margin: 0 0 10px; padding: 9px 10px; border-radius: 8px; background: #1a1a1e; border: 1px solid #28282d;\\n    font-size: 11px; font-weight: 500; color: #b4b4bc; line-height: 1.45; white-space: normal; }\\n  .ot-graf { margin-bottom: 12px; }\\n  .ot-graf:last-child { margin-bottom: 0; }\\n  .ot-graf svg, .ot-graf .vazio { background: #0f0f11; border-radius: 6px; height: 54px; margin-top: 6px; }\\n  .ot-graf .vazio { border: 0; }\\n  .ot-line { display: flex; align-items: center; gap: 8px; width: 100%; margin-top: 10px; padding: 7px 4px; border: 0; border-radius: 7px;\\n    background: transparent; color: #a4a4ad; font: 600 11.5px \\\"Segoe UI\\\", sans-serif; cursor: pointer; text-align: left; }\\n  .ot-line:hover { background: #1b1b1f; color: #fff; }\\n  .ot-line svg { width: 15px; height: 15px; flex: none; }\\n  .ot-line span { flex: 1; min-width: 0; }\\n  .ot-line b { color: #fff; font-weight: 700; }\\n  .ot-line i { font-style: normal; font-size: 10px; color: #6c6c76; }\\n  .ot-opts-in { padding: 2px 4px 4px 27px; }\\n  .ot-foot { position: sticky; bottom: 0; z-index: 5; flex: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;\\n    padding: 12px 14px; background: #141416; border-top: 1px solid #26262a; }\\n  .of-btn { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; height: 60px; padding: 0 2px; min-width: 0;\\n    border-radius: 10px; cursor: pointer; background: #1d1d21; border: 1px solid #2c2c32; color: #cfcfd6; font: 600 11px \\\"Segoe UI\\\", sans-serif; }\\n  .of-btn:hover { background: #26262b; color: #fff; }\\n  .of-btn:active { transform: translateY(1px); }\\n  .of-btn svg { width: 18px; height: 18px; display: block; }\\n  .of-btn span { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .of-btn.primary { background: linear-gradient(135deg, #7dff3f, #3fcf0e); border-color: transparent; color: #0b1a05; font-weight: 800; }\\n  .of-btn.primary:hover { filter: brightness(1.08); color: #0b1a05; }\\n  .of-btn.on { background: #17310f; border-color: #3f8a1c; color: #b6ff8f; }\\n\\n  /* ===================================================================\\n     BARRAS RECOLHIDAS (barra de ícones, como no IdleDeck) + cabeçalhos com botão de recolher\\n     =================================================================== */\\n  body.sidebar { border-right: 1px solid #26262a; }\\n  .rail { display: none; flex-direction: column; align-items: center; gap: 6px; width: 100%; height: 100%; padding: 10px 0; overflow-y: auto; overflow-x: hidden; scrollbar-width: none; }\\n  .rail::-webkit-scrollbar { display: none; }\\n  body.fechado .rail { display: flex; }\\n  .rl-btn { flex: none; width: 36px; height: 36px; border: 0; border-radius: 9px; background: transparent; color: #a4a4ad; display: grid; place-items: center; cursor: pointer; padding: 0; }\\n  .rl-btn:hover { background: #222226; color: #fff; }\\n  .rl-btn:active { transform: translateY(1px); }\\n  .rl-btn svg { width: 18px; height: 18px; display: block; }\\n  .rl-btn.on { color: var(--kick); }\\n  .rl-btn.sel { background: #17310f; color: #b6ff8f; }\\n  .rl-btn.spin svg { animation: spin .8s linear infinite; }\\n  .rl-btn.logo { background: #1b2a14; color: var(--kick); width: 34px; height: 34px; border-radius: 9px; }\\n  .rl-btn.logo:hover { background: #24381a; color: var(--kick); }\\n  .rl-btn.all { color: #b6ff8f; font: 800 11px \\\"Segoe UI\\\", sans-serif; background: #2a3d20; }\\n  .rl-btn.all.cur { box-shadow: inset 0 0 0 1px rgba(83, 252, 24, .55); }\\n  .rl-ct { flex: none; width: 40px; height: 40px; border: 0; border-radius: 10px; background: transparent; display: grid; place-items: center; cursor: pointer; padding: 0; }\\n  .rl-ct:hover { background: #202024; }\\n  .rl-ct.cur { background: #25252a; box-shadow: inset 0 0 0 1px rgba(83, 252, 24, .38); }\\n  .rl-ct.off .sd-av { opacity: .5; }\\n  .rail .sd-dot { border-color: #121214; }\\n  body.otimside .rail .sd-dot { border-color: #141416; }\\n  .rl-sep { flex: none; width: 24px; height: 1px; background: #26262a; margin: 3px 0; }\\n  .rl-spacer { flex: 1; min-height: 6px; }\\n  .ot-head { display: flex; align-items: center; gap: 8px; }\\n  .ot-head-t { flex: 1; min-width: 0; }\\n  .ot-fechar { flex: none; width: 26px; height: 26px; border: 0; border-radius: 7px; background: transparent; color: #8c8c96; font-size: 15px; cursor: pointer; }\\n  .ot-fechar:hover { background: #222226; color: #fff; }\\n  body.otimside #app .ot-sec-live { margin-top: 8px; }\\n\\n  /* ícones antigos vêm com branco fixo: nas barras recolhidas herdam a cor do botão (cinza → branco no hover, verde se ligado) */\\n  .rail .rl-btn svg [stroke=\\\"#fff\\\"] { stroke: currentColor; }\\n  .rail .rl-btn svg [fill=\\\"#fff\\\"], .rail .rl-btn svg[fill=\\\"#fff\\\"] { fill: currentColor; }\\n\\n  /* ===================================================================\\n     TELINHAS DA GRADE (cabeçalho de cada conta) — estilo IdleDeck\\n     =================================================================== */\\n  body.tile { background: #18181b; border-top: 2px solid transparent; border-bottom: 1px solid #2a2a30; }\\n  body.tile.sel { border-top-color: var(--kick); background: linear-gradient(#1c241a, #18181b 70%); }\\n  body.tile.bottom { background: #18181b; border-top: 1px solid #2a2a30; border-bottom: 2px solid transparent; }\\n  body.tile.bottom.sel { border-bottom-color: var(--kick); }\\n  body.tile #app { padding: 0 8px 0 12px; gap: 10px; }\\n  .tl-id { flex: 1; min-width: 0; display: flex; align-items: center; gap: 9px; height: 100%; padding: 0; border: 0; background: transparent;\\n    color: #fff; cursor: pointer; text-align: left; font-family: inherit; }\\n  .tl-dot { flex: none; width: 10px; height: 10px; border-radius: 50%; background: #55555d; }\\n  .tl-dot.m0 { background: var(--kick); box-shadow: 0 0 7px rgba(83, 252, 24, .6); }\\n  .tl-dot.m1 { background: #5ad1c4; } .tl-dot.m2 { background: #8ec5ff; } .tl-dot.m3 { background: #55555d; }\\n  .tl-nome { flex: none; max-width: 62%; font-size: 13.5px; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .tl-st { min-width: 0; font-size: 11.5px; font-weight: 500; color: #8c8c96; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .tl-dir { flex: none; display: flex; align-items: center; gap: 4px; }\\n  .tl-mem { margin-right: 4px; font-size: 11.5px; font-weight: 700; }\\n  .tl-mem.nivel-ok { color: #8ef07a; } .tl-mem.nivel-med { color: var(--amber); } .tl-mem.nivel-alto { color: #ff8a7a; } .tl-mem.nivel- { color: #8c8c96; }\\n  .tl-ic { width: 26px; height: 26px; border: 0; border-radius: 7px; background: transparent; color: #a4a4ad; display: grid; place-items: center; cursor: pointer; padding: 0; }\\n  .tl-ic:hover { background: #26262b; color: #fff; }\\n  .tl-ic svg { width: 15px; height: 15px; display: block; }\\n  .tl-ic svg [stroke=\\\"#fff\\\"] { stroke: currentColor; }\\n  .tl-ic svg [fill=\\\"#fff\\\"], .tl-ic svg[fill=\\\"#fff\\\"] { fill: currentColor; }\\n  .tl-ic.spin svg { animation: spin .8s linear infinite; }\\n\\n  /* ampliado: faixa de abas das contas + cabeçalho da conta (estilo IdleDeck) */\\n  body.tile.zoom { border-top: 0; background: #18181b; }\\n  body.tile.zoom #app { display: block; padding: 0; height: 100%; }\\n  .zm-wrap { display: flex; flex-direction: column; height: 100%; }\\n  .zm-tabs { flex: none; height: 40px; display: flex; align-items: center; gap: 10px; padding: 0 10px; border-bottom: 1px solid #26262a; }\\n  .zm-grp { flex: 1; min-width: 0; display: flex; align-items: center; gap: 6px; overflow: hidden; }\\n  .zm-tab { flex: 0 1 auto; min-width: 0; display: flex; align-items: center; gap: 8px; height: 28px; padding: 0 12px; border-radius: 8px;\\n    background: #1d1d21; border: 1px solid #2a2a30; color: #b4b4bc; font: 700 12px \\\"Segoe UI\\\", sans-serif; cursor: pointer; }\\n  .zm-tab:hover { background: #26262b; color: #fff; }\\n  .zm-tab.on { background: #17310f; border-color: #3f8a1c; color: #fff; }\\n  .zm-nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 150px; }\\n  .zm-sair { flex: none; display: flex; align-items: center; gap: 7px; height: 28px; padding: 0 12px; border-radius: 8px; background: #1d1d21; border: 1px solid #2a2a30;\\n    color: #cfcfd6; font: 600 12px \\\"Segoe UI\\\", sans-serif; cursor: pointer; }\\n  .zm-sair:hover { background: #26262b; color: #fff; }\\n  .zm-sair svg { width: 14px; height: 14px; display: block; }\\n  .zm-sair svg [stroke=\\\"#fff\\\"] { stroke: currentColor; }\\n  .zm-head { flex: 1; min-height: 0; display: flex; align-items: center; gap: 10px; padding: 0 8px 0 12px; }\\n\\n  /* ===================================================================\\n     BARRA DE BAIXO — layout da grade · modos · CPU/RAM · versão (estilo IdleDeck)\\n     =================================================================== */\\n  body.bottombar { background: #101012; border: 0; border-top: 1px solid #26262a; font: 600 11px \\\"Segoe UI\\\", system-ui, sans-serif; height: 100%; }\\n  .bb-wrap { height: 100%; display: flex; align-items: center; gap: 10px; padding: 0 12px; }\\n  .bb-seg { display: flex; gap: 2px; padding: 2px; border-radius: 9px; background: #17171a; border: 1px solid #26262a; }\\n  .bb-ib { width: 30px; height: 24px; border: 0; border-radius: 7px; background: transparent; color: #8c8c96; display: grid; place-items: center; cursor: pointer; padding: 0; }\\n  .bb-ib:hover { background: #222226; color: #fff; }\\n  .bb-ib.on { background: #17310f; color: #b6ff8f; box-shadow: inset 0 0 0 1px rgba(83, 252, 24, .3); }\\n  .bb-ib svg { width: 16px; height: 16px; display: block; }\\n  .bb-sep { width: 1px; height: 18px; background: #26262a; }\\n  .bb-zoom { align-items: center; }\\n  .bb-zv { min-width: 40px; text-align: center; font: 700 11.5px \\\"Segoe UI\\\", sans-serif; color: #cfcfd6; }\\n  .bb-pill { display: flex; align-items: center; gap: 6px; height: 26px; padding: 0 10px; border: 1px solid transparent; border-radius: 8px; background: transparent;\\n    color: #a4a4ad; font: 600 11.5px \\\"Segoe UI\\\", sans-serif; cursor: pointer; }\\n  .bb-pill:hover { background: #1d1d21; color: #fff; }\\n  .bb-pill.on { background: #17310f; color: #b6ff8f; border-color: #2f6a14; }\\n  .bb-pill svg { width: 14px; height: 14px; display: block; }\\n  .bb-fill { flex: 1; }\\n  .bb-stat { display: flex; align-items: center; gap: 7px; height: 100%; padding: 0 6px; border: 0; border-radius: 7px; background: transparent; cursor: pointer; font-family: inherit; }\\n  .bb-stat:hover { background: #1a1a1d; }\\n  .bb-mini { flex: none; width: 4px; height: 20px; border-radius: 2px; background: #26262a; position: relative; overflow: hidden; }\\n  .bb-mini i { position: absolute; left: 0; right: 0; bottom: 0; border-radius: 2px; background: var(--kick); transition: height .4s, background .4s; }\\n  .bb-mini.med i { background: var(--amber); } .bb-mini.alto i { background: #ff5d6c; }\\n  .bb-st { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.05; }\\n  .bb-st small { font-size: 9px; font-weight: 600; letter-spacing: .5px; color: #7c7c86; }\\n  .bb-st b { font-size: 13px; font-weight: 800; color: #fff; }\\n  .bb-ver { height: 22px; padding: 0 10px; border: 0; border-radius: 11px; background: #1d1d21; color: #9a9aa4; font: 600 11px \\\"Segoe UI\\\", sans-serif; cursor: pointer; }\\n  .bb-ver:hover { background: #26262b; color: #fff; }\\n\\n  /* ===================================================================\\n     MENUS (agora abertos pela engrenagem da barra de baixo) — painel plano, ícone ao lado de cada categoria\\n     =================================================================== */\\n  .dd:not(.pop) { min-width: 240px; padding: 6px; background: #17171a; border: 1px solid #2c2c32; border-radius: 12px; box-shadow: 0 12px 32px rgba(0, 0, 0, .6); }\\n  .dd:not(.pop) .it { grid-template-columns: 24px 1fr auto 12px; height: 34px; padding: 0 10px 0 8px; gap: 8px; border: 0; border-radius: 8px; color: #e4e4e8; font: 600 12.5px \\\"Segoe UI\\\", system-ui, sans-serif; }\\n  .dd:not(.pop) .it:hover, .dd:not(.pop) .it:focus-visible, .dd:not(.pop) .it.sub-open { background: #25252a; color: #fff; text-shadow: none; border: 0; }\\n  .dd:not(.pop) .ck { color: var(--kick); }\\n  .dd:not(.pop) .ck.ico { display: grid; place-items: center; color: #9a9aa4; }\\n  .dd:not(.pop) .ck.ico svg { width: 16px; height: 16px; display: block; }\\n  .dd:not(.pop) .it:hover .ck.ico, .dd:not(.pop) .it.sub-open .ck.ico { color: var(--kick); }\\n  .dd:not(.pop) .ac { color: #7c7c86; }\\n  .dd:not(.pop) .ar { color: #6c6c76; }\\n  .dd:not(.pop) .hr { background: #26262a; }\\n  .dd.gear .it { height: 38px; font-size: 13px; }\\n  .bb-gear { flex: none; width: 30px; height: 26px; border: 0; border-radius: 8px; background: transparent; color: #a4a4ad; display: grid; place-items: center; cursor: pointer; padding: 0; }\\n  .bb-gear:hover { background: #222226; color: #fff; }\\n  .bb-gear svg { width: 17px; height: 17px; display: block; }\\n\\n  /* ===================================================================\\n     AJUSTE FINAL — cabeçalhos finos e sutis, botão de informações no estilo da janela\\n     =================================================================== */\\n  /* botão \\\"i\\\": mesmo estilo dos botões do Windows ao lado (plano, altura toda, só acende ao passar o mouse) */\\n  .ibtn { -webkit-app-region: no-drag; width: 42px; height: 100%; margin: 0 0 0 auto; padding: 0; border: 0; border-radius: 0; box-shadow: none; text-shadow: none;\\n    background: transparent; color: #a4a4ad; font: inherit; display: grid; place-items: center; cursor: pointer; }\\n  .ibtn svg { width: 15px; height: 15px; display: block; }\\n  .ibtn:hover, .ibtn:focus-visible { outline: none; filter: none; box-shadow: none; background: rgba(255, 255, 255, .08); color: #fff; }\\n\\n  /* cabeçalho de cada telinha: 28px, nome discreto */\\n  body.tile { border-top: 0; border-bottom: 1px solid #26262b; }\\n  body.tile.sel { border-top-color: transparent; box-shadow: inset 0 2px 0 var(--kick); background: linear-gradient(#1a2218, #18181b 80%); }\\n  body.tile.bottom { border-top: 1px solid #26262b; border-bottom: 0; }\\n  body.tile.bottom.sel { border-bottom-color: transparent; box-shadow: inset 0 -2px 0 var(--kick); }\\n  body.tile #app { padding: 0 6px 0 10px; gap: 8px; }\\n  .tl-id { gap: 7px; }\\n  .tl-dot { width: 7px; height: 7px; }\\n  .tl-dot.m0 { box-shadow: 0 0 5px rgba(83, 252, 24, .55); }\\n  .tl-nome { font-size: 12px; font-weight: 600; color: #c4c4cb; letter-spacing: .1px; }\\n  body.tile.sel .tl-nome { color: #fff; }\\n  .tl-st { font-size: 10.5px; color: #6f6f79; }\\n  .tl-mem { margin-right: 2px; font-size: 10.5px; font-weight: 600; }\\n  .tl-ic { width: 22px; height: 22px; border-radius: 6px; }\\n  .tl-ic svg { width: 13px; height: 13px; }\\n  /* ampliado: abas 36px + cabeçalho 28px */\\n  .zm-tabs { height: 36px; padding: 0 8px; gap: 8px; }\\n  .zm-tab { height: 24px; padding: 0 10px; gap: 7px; font-size: 11.5px; border-radius: 7px; }\\n  .zm-sair { height: 24px; padding: 0 10px; font-size: 11.5px; border-radius: 7px; }\\n  .zm-head { padding: 0 6px 0 10px; gap: 8px; }\\n  /* ===================================================================\\n     BOTAO DA TWITCH: roxo (#9146ff), e nao o verde da Kick.\\n     Fica no FIM da folha de proposito: precisa vir depois das regras\\n     do painel da direita, que pintam todo botao ligado de verde.\\n     =================================================================== */\\n  .btn.lives.twitch .chip { background: radial-gradient(circle at 35% 30%, #d7bcff, #8f5ee8 55%, #6a3bc4); color: #2a1346; }\\n  body.otimside #app .grp.livesg .btn.twitch.on {\\n    background: #1d1430 !important;\\n    border-left-color: #bf94ff;\\n    box-shadow: 0 0 0 1px var(--frame-hi), 0 0 0 2px var(--frame-dark), inset 0 0 10px rgba(191, 148, 255, .18);\\n  }\\n  body.otimside #app .grp.livesg .btn.twitch .rec { background: #bf94ff; box-shadow: 0 0 4px #bf94ff; }\\n  body.otimside #app .grp.livesg .btn.twitch b { color: #cbb0ff; }\\n  /* ---- Histórico das lives (janela própria, mode=historico) ---- */\\n  body.histw { background: #19191b; border: 0; overflow: hidden; white-space: normal; font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif; color: var(--cream); }\\n  #histw { display: flex; flex-direction: column; height: 100%; }\\n  #histw .ch { flex: none; display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 150px 0 12px; background: #26262a; -webkit-app-region: drag;\\n    box-shadow: inset 0 -2px 0 var(--frame-dark), inset 0 -3px 0 #39393f; }\\n  #histw .ch svg, #histw .ch .appico { flex: none; width: 18px; height: 18px; display: block; }\\n  #histw .ch b { font-size: 12px; font-weight: 800; color: #fff; text-shadow: 1px 1px 0 var(--frame-dark); }\\n  #histw .ch span { font-size: 12px; color: #9d9da6; }\\n  #histw .hx-top { flex: none; padding: 14px 16px 10px; background: #1d1d20; border-bottom: 1px solid #2a2a2e; }\\n  #histw .hx-res { display: flex; align-items: flex-start; gap: 12px; padding: 12px 14px; border-radius: 10px; background: #202024;\\n    border: 1px solid #2e2e34; border-left: 3px solid #4a4a52; }\\n  #histw .hx-res.mal { border-left-color: #e4a62b; background: #241f16; border-color: #4a3a18; }\\n  #histw .hx-res .hx-ico { flex: none; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: #2c2c32; font-size: 15px; }\\n  #histw .hx-res.mal .hx-ico { background: #4a3a18; }\\n  #histw .hx-res b { display: block; font-size: 13px; color: #fff; }\\n  #histw .hx-res small { display: block; margin-top: 2px; font-size: 12px; font-weight: 500; color: #a9a9b2; }\\n  #histw .hx-novos { margin-left: auto; flex: none; padding: 3px 9px; border-radius: 11px; background: #3a2d52; color: #c9a8ff; font-size: 11px; font-weight: 700; }\\n  #histw .hx-tabs { display: flex; gap: 8px; margin-top: 12px; }\\n  #histw .hx-tab { display: inline-flex; align-items: center; gap: 7px; height: 28px; padding: 0 12px; cursor: pointer;\\n    border: 1px solid #33333a; border-radius: 14px; background: #202024; color: #b9b9c2; font: 600 12px \\\"Segoe UI\\\", sans-serif; }\\n  #histw .hx-tab:hover { background: #26262b; color: #fff; }\\n  #histw .hx-tab.on { background: #2f2a3e; border-color: #5b4a86; color: #d8c6ff; }\\n  #histw .hx-tab i { font-style: normal; font-size: 11px; color: #8d8d98; }\\n  #histw .hx-tab.on i { color: #b9a4e6; }\\n  #histw .cb { flex: 1; overflow: auto; padding: 6px 8px 10px; }\\n  #histw .hx-dia { padding: 12px 10px 6px; font-size: 11px; font-weight: 800; letter-spacing: .08em; color: #8d8d98; text-transform: uppercase; }\\n  #histw .hx-li { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 9px; }\\n  #histw .hx-li:hover { background: #202024; }\\n  #histw .hx-li .b { flex: none; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-size: 13px; background: #2a2a30; color: #b6b6c0; }\\n  #histw .hx-li.problema .b { background: #3b2f14; color: #efc065; }\\n  #histw .hx-li.ok .b { background: #1f3a1b; color: #8fe06a; }\\n  #histw .hx-li .t { flex: 1; font-size: 12.5px; font-weight: 500; color: #c9c9d1; }\\n  #histw .hx-li .t b { font-weight: 800; color: #fff; }\\n  #histw .hx-li .h { flex: none; display: flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; color: #8d8d98; }\\n  #histw .hx-li .pt { width: 6px; height: 6px; border-radius: 50%; background: #6b5bd1; }\\n  #histw .hx-li.lido .pt { background: #3a3a42; }\\n  #histw .hx-vazio { padding: 40px 16px; text-align: center; font-size: 12.5px; font-weight: 500; color: #8d8d98; }\\n  #histw .hx-pe { flex: none; display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: #1d1d20; border-top: 1px solid #2a2a2e; }\\n  #histw .hx-lp { border: 0; background: none; cursor: pointer; color: #9d9da6; font: 600 12px \\\"Segoe UI\\\", sans-serif; }\\n  #histw .hx-lp:hover { color: #ff9a9a; }\\n  #histw .hx-fx { margin-left: auto; height: 30px; padding: 0 18px; border: 0; border-radius: 8px; cursor: pointer;\\n    background: #6b4fd1; color: #fff; font: 700 12px \\\"Segoe UI\\\", sans-serif; }\\n  #histw .hx-fx:hover { background: #7d61e3; }\\n  /* botão do histórico na barra de baixo */\\n  .bb-hist { position: relative; flex: none; width: 30px; height: 26px; border: 0; border-radius: 8px; background: transparent; color: #a4a4ad; display: grid; place-items: center; cursor: pointer; padding: 0; }\\n  .bb-hist:hover { background: #222226; color: #fff; }\\n  .bb-hist svg { width: 17px; height: 17px; display: block; }\\n  .bb-hist em { position: absolute; top: 1px; right: 0; min-width: 14px; height: 14px; padding: 0 3px; border-radius: 7px; background: #e4a62b; color: #221a06;\\n    font: 800 9px/14px \\\"Segoe UI\\\", sans-serif; font-style: normal; text-align: center; display: none; }\\n  .bb-hist.tem em { display: block; }\\n</style>\\n<div id=\\\"tb\\\" hidden></div>\\n<div id=\\\"kickw\\\" hidden></div>\\n<div id=\\\"twitchw\\\" hidden></div>\\n<div id=\\\"histw\\\" hidden></div>\\n<div id=\\\"otimw\\\" hidden></div>\\n<div id=\\\"pvp\\\" hidden></div>\\n<div id=\\\"app\\\"></div>\\n<div id=\\\"cfg\\\" hidden>\\n  <div class=\\\"ch\\\"><span id=\\\"cfgIco\\\"></span><b>Auto Compra</b><span>Configurações</span></div>\\n  <div class=\\\"cb\\\">\\n    <div class=\\\"cfg-contas\\\"><span>Configurando:</span><div id=\\\"cfgContas\\\"></div>\\n      <label class=\\\"cfg-todas\\\" title=\\\"Ao salvar, copia estas regras para todas as contas\\\"><input type=\\\"checkbox\\\" id=\\\"cfgTodas\\\"> Salvar para todas</label></div>\\n    <div class=\\\"pn acc-row\\\" id=\\\"cfgAcc\\\" hidden>\\n      <label class=\\\"mode\\\">\\n        <span class=\\\"tx\\\"><b id=\\\"cfgAccNome\\\">Auto Compra nesta conta</b><small id=\\\"cfgAccSt\\\"></small></span>\\n        <input type=\\\"checkbox\\\" class=\\\"sw\\\" id=\\\"cfgAccOn\\\">\\n      </label>\\n    </div>\\n    <h1>Auto Compra</h1>\\n    <p class=\\\"sub\\\">Compra pokébolas, poções e revives no Market quando estiverem acabando. Cada conta tem as próprias regras: escolha a conta no topo. O liga/desliga vale na hora; as regras, ao clicar em Salvar.</p>\\n\\n    <div class=\\\"cfg-note\\\"><span class=\\\"ni\\\">!</span><span>Compras automáticas podem não ser permitidas pelas regras do PokeIdle. Confira os termos do jogo antes de ligar. O uso é por sua conta e risco.</span></div>\\n\\n    <div class=\\\"pn\\\">\\n      <div class=\\\"pn-h\\\"><h2>O que comprar</h2><small>Ligue os itens que você quer manter em estoque</small></div>\\n      <div class=\\\"tabs\\\" id=\\\"tabs\\\"></div>\\n      <div class=\\\"items\\\" id=\\\"rules\\\"></div>\\n    </div>\\n  </div>\\n  <div class=\\\"cf\\\">\\n    <button class=\\\"btn plain\\\" id=\\\"defaults\\\" title=\\\"Volta as regras para o padrão\\\">Padrões</button>\\n    <button class=\\\"btn plain\\\" id=\\\"cfgLog\\\" title=\\\"Abre o histórico de compras (todas as contas)\\\">Histórico</button>\\n    <button class=\\\"btn plain\\\" id=\\\"cfgNow\\\" hidden title=\\\"Confere o estoque desta conta agora\\\">Verificar agora</button>\\n\\n    <span class=\\\"grow\\\"></span>\\n    <button class=\\\"btn plain\\\" id=\\\"cancel\\\">Cancelar</button>\\n    <button class=\\\"btn go\\\" id=\\\"save\\\">Salvar</button>\\n  </div>\\n</div>\\n<script>\\n  const params = new URLSearchParams(location.search);\\n  const MODE = params.get('mode');\\n  let I = Number(params.get('i'));\\n  const app = document.getElementById('app');\\n\\n  /* ------------------------- configuração ------------------------- */\\n  function initConfig(painel) {\\n    // painel = { fechar }: a configuração abre como um painel que desce do botão (sem janela separada)\\n    const fechar = painel ? painel.fechar : () => window.api.closeSelf();\\n    if (!painel) {\\n      document.body.classList.add('config');\\n      document.title = 'Auto Compra — Configurações';\\n      app.hidden = true;\\n    }\\n    document.getElementById('cfg').hidden = false;\\n    const $ = (id) => document.getElementById(id);\\n\\n    // números com separador de milhar (1.000.000); ao salvar, só os dígitos\\n    const fmt = (v) => { const d = String(v == null ? '' : v).replace(/\\\\D/g, ''); return d ? Number(d).toLocaleString('pt-BR') : ''; };\\n    const raw = (v) => String(v || '').replace(/\\\\D/g, '');\\n    const numInput = (inp, v) => {\\n      inp.value = fmt(v);\\n      inp.oninput = () => {\\n        const pos = inp.value.length - inp.selectionStart;\\n        inp.value = fmt(inp.value);\\n        const p = Math.max(0, inp.value.length - pos);\\n        inp.setSelectionRange(p, p);\\n      };\\n    };\\n\\n    let RULES = [];\\n    let curCat = null;\\n\\n\\n    function drawTabs() {\\n      const cats = [...new Set(RULES.map((r) => r.cat))];\\n      if (!cats.includes(curCat)) curCat = cats[0];\\n      const tabs = $('tabs');\\n      tabs.innerHTML = '';\\n      cats.forEach((c) => {\\n        const n = RULES.filter((r) => r.cat === c && r.on).length;\\n        const b = el('button', c === curCat ? 'cur' : '', '<span></span><span class=\\\"cnt' + (n ? '' : ' z') + '\\\">' + n + '</span>');\\n        b.firstChild.textContent = c;\\n        b.title = n + ' ite' + (n === 1 ? 'm ligado' : 'ns ligados');\\n        b.onclick = () => { curCat = c; drawTabs(); drawRules(); };\\n        tabs.appendChild(b);\\n      });\\n    }\\n\\n    const ICONE = {\\n      'Poké Ball': 'pokeball', 'Great Ball': 'great', 'Super Ball': 'super', 'Ultra Ball': 'ultra',\\n      'Small Potion': 'potion-small', 'Great Potion': 'potion-great', 'Ultra Potion': 'potion-ultra',\\n      'Hyper Potion': 'potion-hyper', 'Ultimate Potion': 'potion-ultimate', 'Golden Potion': 'potion-golden',\\n      'Revive': 'revive', 'Max Revive': 'revive-max',\\n    };\\n    // ícones reais do Market do jogo (pegos uma vez direto do pokeidle.io); se algum dia o jogo trocar\\n    // esses links, dá pra pegar de novo com window.api.marketIconsCapture(conta) e salvar por cima.\\n    let ICONS_IMG = {\\n      'Poké Ball': 'https://pokeidle.io/assets/site/assets/ui/ball-poke.png',\\n      'Great Ball': 'https://pokeidle.io/assets/site/assets/ui/ball-great.png',\\n      'Super Ball': 'https://pokeidle.io/img/ball-super.png',\\n      'Ultra Ball': 'https://pokeidle.io/assets/site/assets/ui/ball-ultra.png',\\n      'Small Potion': 'https://pokeidle.io/assets/site/assets/markitems/small_potion.png',\\n      'Great Potion': 'https://pokeidle.io/assets/site/assets/markitems/great_potion.png',\\n      'Ultra Potion': 'https://pokeidle.io/assets/site/assets/markitems/ultra_potion.png',\\n      'Hyper Potion': 'https://pokeidle.io/assets/site/assets/markitems/hyper_potion.png',\\n      'Ultimate Potion': 'https://pokeidle.io/assets/site/assets/markitems/ultimate_potion.png',\\n      'Golden Potion': 'https://pokeidle.io/img/itens/golden-potion.png',\\n      'Revive': 'https://pokeidle.io/assets/site/assets/markitems/revive.png',\\n      'Max Revive': 'https://pokeidle.io/assets/site/assets/markitems/max_revive.png',\\n    };\\n    function drawRules() {\\n      const body = $('rules');\\n      body.innerHTML = '';\\n      RULES.filter((r) => r.cat === curCat).forEach((r) => {\\n        const row = el('label', 'mk-card' + (r.on ? '' : ' off'));\\n        const ico = ICONS_IMG[r.name]\\n          ? '<img class=\\\"mk-ico-img\\\" src=\\\"' + ICONS_IMG[r.name].replace(/\\\"/g, '&quot;') + '\\\">'\\n          : '<div class=\\\"mk-ico ' + (ICONE[r.name] || 'pokeball') + '\\\"></div>';\\n        row.innerHTML =\\n          '<div class=\\\"mk-top\\\">' + ico + '<input type=\\\"checkbox\\\" class=\\\"sw\\\"></div>' +\\n          '<span class=\\\"mk-nome\\\"></span>' +\\n          '<div class=\\\"mk-flds\\\">' +\\n          '<label><span>Comprar abaixo de</span><span class=\\\"fld\\\"><input class=\\\"min\\\" inputmode=\\\"numeric\\\"></span></label>' +\\n          '<label><span>Quantidade</span><span class=\\\"fld\\\"><input class=\\\"buy\\\" inputmode=\\\"numeric\\\"></span></label>' +\\n          '</div>';\\n        row.querySelector('.mk-nome').textContent = r.name;\\n        const sw = row.querySelector('.sw');\\n        sw.checked = !!r.on;\\n        sw.onchange = () => { r.on = sw.checked; row.classList.toggle('off', !r.on); drawTabs(); };\\n        const mi = row.querySelector('.min'), bu = row.querySelector('.buy');\\n        numInput(mi, r.min); numInput(bu, r.buy);\\n        mi.onchange = () => { r.min = raw(mi.value); };\\n        bu.onchange = () => { r.buy = raw(bu.value); };\\n        mi.addEventListener('input', () => { r.min = raw(mi.value); });\\n        bu.addEventListener('input', () => { r.buy = raw(bu.value); });\\n        body.appendChild(row);\\n      });\\n    }\\n\\n    let fill = function (c) {\\n      RULES = c.rules.map((r) => ({ ...r }));\\n      drawTabs();\\n      drawRules();\\n      if (c.icon !== undefined) $('cfgIco').innerHTML = iconHtml(c.icon);\\n    }\\n    function collect() {\\n      return {\\n        rules: RULES.map((r) => ({ name: r.name, on: !!r.on, min: raw(r.min), buy: raw(r.buy) })),\\n      };\\n    }\\n    // cada conta tem a própria configuração: abas no topo para escolher qual conta editar\\n    let conta = painel && Number.isInteger(painel.conta) ? painel.conta : 0;\\n    function abasContas(c) {\\n      const box = $('cfgContas');\\n      window.__cfgContaAtual = conta;\\n      if (!box || !c.contas) return;\\n      box.innerHTML = '';\\n      c.contas.forEach((k, n) => {\\n        const bt = document.createElement('button');\\n        bt.className = 'cfg-ct' + (n === conta ? ' cur' : '') + (k.on ? ' on' : '');\\n        bt.textContent = k.nome;\\n        bt.title = k.on ? 'Auto Compra ligada nesta conta' : 'Auto Compra desligada nesta conta';\\n        bt.onclick = () => { conta = n; window.api.autoGet(false, conta).then(fill); };\\n        box.appendChild(bt);\\n      });\\n      const k = c.contas[conta];\\n      const sw = $('cfgAccOn');\\n      if (k && sw && $('cfgAcc') && !$('cfgAcc').hidden) {\\n        $('cfgAccNome').textContent = `Auto Compra ligada em ${k.nome}`;\\n        sw.checked = !!k.on;\\n        $('cfgAccSt').textContent = k.on ? 'Ligada' : 'Desligada: ligue aqui para começar a comprar sozinho';\\n        sw.onchange = () => { window.api.setAuto(conta, sw.checked); k.on = sw.checked; $('cfgAccSt').textContent = sw.checked ? 'Ligada' : 'Desligada'; abasContas(c); };\\n      }\\n    }\\n    const fillBase = fill;\\n    fill = (c) => { fillBase(c); abasContas(c); };\\n    window.__cfgFill = fill;\\n    window.__cfgConta = (n) => { conta = n; window.api.autoGet(false, conta).then(fill); };\\n    if ($('cfgLog')) $('cfgLog').onclick = () => window.api.autoLog();\\n    // se algum dia alguém rodar window.api.marketIconsCapture() de novo (ex.: o jogo trocou algum ícone),\\n    // o que foi salvo substitui os links fixos acima — sem isso, os fixos já bastam.\\n    if (window.api.marketIconsGet) window.api.marketIconsGet().then((m) => { if (m && Object.keys(m).length) { Object.assign(ICONS_IMG, m); drawRules(); } });\\n    window.api.autoGet(false, conta).then(fill);\\n    $('defaults').onclick = () => window.api.autoGet(true, conta).then(fill);\\n    $('cancel').onclick = () => fechar();\\n    $('save').onclick = async () => { await window.api.autoSave(collect(), conta, $('cfgTodas') && $('cfgTodas').checked); fechar(); };\\n    if (!painel) document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fechar(); });\\n  }\\n\\n  /* ---------------------- Mega Eco: painel das 4 contas ---------------------- */\\n  function initResumo() {\\n    document.body.classList.add('resumo');\\n    document.title = 'Mega Eco';\\n    app.hidden = true;\\n    const root = el('div', 'dz');\\n    document.body.appendChild(root);\\n    const esc = (t) => String(t == null ? '' : t).replace(/[&<>\\\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;' }[c]));\\n    const num = (t) => { const n = Number(String(t || '').replace(/\\\\./g, '').replace(',', '.').replace(/[^\\\\d.-]/g, '')); return isFinite(n) ? n : 0; };\\n    const curto = (n) => { n = Number(n) || 0; const a = Math.abs(n);\\n      return a >= 1e9 ? (n / 1e9).toFixed(1).replace('.', ',') + 'B' : a >= 1e6 ? (n / 1e6).toFixed(1).replace('.', ',') + 'M' : a >= 1e3 ? (n / 1e3).toFixed(1).replace('.', ',') + 'k' : String(Math.round(n)); };\\n    const dur = (ms) => { const m = Math.max(0, Math.round(ms / 60000)); return m < 60 ? `${m} min` : `${Math.floor(m / 60)}h${String(m % 60).padStart(2, '0')}`; };\\n    const soma = (o) => Object.values(o || {}).reduce((t, v) => t + (Number(v) || 0), 0);\\n    const hora = (t) => (t ? new Date(t).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) : '');\\n    // nomes curtos para os bônus do jogo\\n    const chipCurto = (a) => {\\n      const n = `${a.nome} ${a.valor}`.replace(/\\\\s+/g, ' ').trim();\\n      if (/twitch/i.test(n)) return { t: 'Twitch ' + ((n.match(/\\\\+[\\\\d,]+%/) || [''])[0]), c: 'tw' };\\n      if (/kick/i.test(n)) return { t: 'Kick', c: 'kk' };\\n      if (/guild/i.test(n)) return { t: 'Guild ' + ((n.match(/\\\\+[\\\\d,]+%/) || [''])[0]), c: 'g' };\\n      if (/vip/i.test(n) || /^\\\\+50% XP$/.test(n)) return { t: 'VIP', c: 'v' };\\n      if (/passe/i.test(n)) return { t: 'Passe', c: 'v' };\\n      if (/boost pok/i.test(n)) return { t: 'Boost Pk', c: 'b' };\\n      if (/boost/i.test(n)) return { t: 'Boost', c: 'b' };\\n      return { t: n.slice(0, 16), c: '' };\\n    };\\n    // ritmo por hora: usa o que o Modo Economia do jogo mostra; se não tiver, calcula pela sessão\\n    const rates = (d) => { const s = d.ses || {}; const h = (s.ms || 0) / 3600000; const r = (v) => (h > 0.02 ? (Number(v) || 0) / h : 0);\\n      const e = d.eco || {};\\n      const doJogo = (l, alt) => (l && /\\\\/h$/.test(l[2] || '') ? num(l[2]) : alt);\\n      return { xp: doJogo(e.xpT, r(s.xpTreinador)), xpPk: doJogo(e.xpP, r(s.xpPokemon)), ouro: doJogo(e.lucro, r(s.gold)),\\n        abates: doJogo(e.abates, r(s.abates)), caps: doJogo(e.capturas, r(s.capturas)) }; };\\n\\n    // itens: só os que você tem (quantidade maior que zero)\\n    const itensDe = (d) => ((d.eco && d.eco.itens && d.eco.itens.length ? d.eco.itens : d.itens) || []).filter((it) => num(it.n) > 0);\\n    // um quadrinho de número no estilo do Modo Economia do jogo\\n    const tile = (cls, rot, l, fallback) => {\\n      const v = l && l[1] ? l[1] : fallback.v;\\n      const rate = l && l[2] ? l[2] : fallback.r;\\n      const sub = l && l[3] ? l[3] : (fallback.s || '');\\n      const rateCurto = /\\\\/h$/.test(rate || '') ? curto(num(rate)) + '/h' : (rate || '');\\n      return `<div class=\\\"dz-t ${cls}\\\"><small>${rot}</small><b>${esc(/^[\\\\d.,−-]+$/.test(v) && num(v) >= 1e6 ? curto(num(v)) : v)}</b>` +\\n        `${rateCurto ? `<span class=\\\"r\\\">${esc(rateCurto)}</span>` : ''}${sub ? `<span class=\\\"s\\\">${esc(sub)}</span>` : ''}</div>`;\\n    };\\n    const capCard = (c) => {\\n      const ls = c.linhas || [];\\n      const nome = ls[0] || '';\\n      const nv = ls.find((x) => /^Nv\\\\s*\\\\d/.test(x)) || '';\\n      const hr = ls.find((x) => /^\\\\d{1,2}:\\\\d{2}$/.test(x)) || '';\\n      const chips = ls.filter((x) => /^(P\\\\d|IV\\\\s|Q\\\\s|N\\\\s)/.test(x));\\n      return `<div class=\\\"dz-cc\\\"><img src=\\\"${esc(c.img)}\\\" alt=\\\"\\\"><div><div class=\\\"dz-cc-n\\\"><b>${esc(nome)}</b> <span>${esc(nv)}</span><i>${esc(hr)}</i></div>` +\\n        `<div class=\\\"dz-cc-c\\\">${chips.map((x) => `<span class=\\\"${/^P/.test(x) ? 'p' : /^IV/.test(x) ? 'iv' : /^Q/.test(x) ? 'q' : 'n'}\\\">${esc(x)}</span>`).join('')}</div></div></div>`;\\n    };\\n    // ---- visual novo do Mega Eco: mesmo estilo do PokeLink no celular ----\\n    const urlImg = (u) => (/^(https?:|data:image\\\\/)/.test(String(u || '')) ? esc(u) : '');\\n    const valorTile = (l, alt) => { const v = l && l[1] ? l[1] : alt; return /^[\\\\d.,−-]+$/.test(String(v)) && Math.abs(num(v)) >= 1e6 ? curto(num(v)) : v; };\\n    function xpBloco(d) {\\n      const x = d.perfil && d.perfil.xp;\\n      if (!x || !x.total) return '';\\n      const pct = Math.max(0, Math.min(100, (x.atual / x.total) * 100));\\n      return `<div class=\\\"mx-xp\\\" title=\\\"XP do treinador\\\"><i style=\\\"width:${pct}%\\\"></i><span>${x.atual.toLocaleString('pt-BR')} / ${x.total.toLocaleString('pt-BR')} xp</span></div>\\n        <div class=\\\"mx-xp-s\\\"><span>faltam ${esc(curto(x.total - x.atual))} para o próximo nível</span><b>${pct.toFixed(1).replace('.', ',')}%</b></div>`;\\n    }\\n    let avatarIgual = false; // a mesma imagem em todas as contas não é o ícone do perfil\\n    function card(d) {\\n      if (d.erro) {\\n        return `<article class=\\\"mx-c\\\"><div class=\\\"mx-head\\\"><span class=\\\"mx-num hud c${d.conta % 4}\\\">${d.conta + 1}</span><div class=\\\"mx-id\\\"><div class=\\\"mx-nome\\\"><b>${esc(d.nome)}</b></div>\\n          <span class=\\\"mx-mut\\\">Carregando o jogo...</span></div></div></article>`;\\n      }\\n      const s = d.ses || {}, e = d.eco || {}, r = rates(d);\\n      const hunt = d.hunt || '';\\n      const st = !hunt ? ['Parado', 'off'] : /boss|arena/i.test(hunt) ? ['Boss', 'boss'] : ['Caçando', ''];\\n      const hp = (d.pk.hp || '').match(/([\\\\d.]+)\\\\s*\\\\/\\\\s*([\\\\d.]+)/);\\n      const hpPct = hp ? Math.max(0, Math.min(100, (num(hp[1]) / Math.max(1, num(hp[2]))) * 100)) : null;\\n      const hpCor = hpPct > 50 ? '#6fdc95' : hpPct > 20 ? '#96f25c' : '#ff7a85';\\n      const huntNome = hunt.split('·')[0].trim(), huntNv = (hunt.split('·')[1] || '').trim();\\n      const av = !avatarIgual && d.perfil && urlImg(d.perfil.img) ? `<img class=\\\"mx-av\\\" src=\\\"${urlImg(d.perfil.img)}\\\" alt=\\\"\\\">` : `<span class=\\\"mx-num hud c${d.conta % 4}\\\">${d.conta + 1}</span>`;\\n      const sh = e.shiny || null;\\n      const capsEco = (e.caps || []).slice(0, 3);\\n      const capsLista = capsEco.length ? capsEco.map((c) => {\\n        const ls = c.linhas || [];\\n        const nv = ls.find((x) => /^Nv\\\\s*\\\\d/.test(x)) || '', hr = ls.find((x) => /^\\\\d{1,2}:\\\\d{2}$/.test(x)) || '';\\n        const ch = ls.filter((x) => /^(IV\\\\s|Q\\\\s)/.test(x));\\n        return `<div class=\\\"mx-cap\\\">${urlImg(c.img) ? `<img src=\\\"${urlImg(c.img)}\\\" alt=\\\"\\\">` : '<img alt=\\\"\\\">'}<div><div class=\\\"n\\\"><b>${esc(ls[0] || '')}</b><span>${esc(nv)}</span><i>${esc(hr)}</i></div>\\n          ${ch.length ? `<div class=\\\"c\\\">${ch.map((x) => `<span class=\\\"${/^Q/.test(x) ? 'q' : ''}\\\">${esc(x)}</span>`).join('')}</div>` : ''}</div></div>`;\\n      }).join('') : (d.caps || []).slice(0, 3).map((c) => `<div class=\\\"mx-cap\\\"><img alt=\\\"\\\"><div><div class=\\\"n\\\"><b>${c.shiny ? '✦ ' : ''}${esc(c.nome)}</b><span>${c.lv ? 'Nv ' + esc(c.lv) : ''}</span><i>${hora(c.em)}</i></div></div></div>`).join('');\\n      const achados = e.achados || [], gastos = e.gastos || [];\\n      const log = (d.log || []).slice(-2);\\n      return `<article class=\\\"mx-c\\\">\\n        <div class=\\\"mx-head\\\">${av}<div class=\\\"mx-id\\\">\\n          <div class=\\\"mx-nome\\\"><b title=\\\"${esc(d.nick || d.nome)}\\\">${esc(d.nick || d.nome)}</b><span>${d.nivel ? 'Nv ' + esc(d.nivel) : ''}</span></div>\\n          ${xpBloco(d)}</div></div>\\n        <div class=\\\"mx-linha\\\"><span class=\\\"mx-hunt\\\" title=\\\"${esc(hunt)}\\\">${hunt ? `${esc(huntNome)}${huntNv ? ` <span>· ${esc(huntNv)}</span>` : ''}` : 'Sem hunt agora'}</span>\\n          <span class=\\\"mx-st ${st[1]}\\\"><i></i>${e.tempo ? esc(e.tempo) + ' · ' : ''}${st[0]}</span></div>\\n        ${(d.ativos || []).length ? `<div class=\\\"mx-chips\\\">${d.ativos.map((a) => { const c = chipCurto(a); return `<span class=\\\"mx-chip ${c.c}\\\" title=\\\"${esc(a.nome + ' ' + a.valor + (a.tempo ? ' · ' + a.tempo : ''))}\\\">${esc(c.t)}</span>`; }).join('')}</div>` : ''}\\n        <section class=\\\"mx-frame mx-box mx-shiny mx-shiny-mini\\\" title=\\\"Shiny desta hunt (Achados do Modo Economia)\\\">\\n          <span class=\\\"est\\\" style=\\\"right:4%;bottom:10%\\\" aria-hidden=\\\"true\\\">✧</span>\\n          <h3 class=\\\"hud\\\">✦ SHINY NESTA HUNT</h3>\\n          <div class=\\\"mx-nums\\\"><div><b class=\\\"hud${sh && sh.vistos ? '' : ' zero'}\\\">${sh ? sh.vistos : '—'}</b><small>vistos</small></div><div><b class=\\\"hud${sh && sh.pegos ? '' : ' zero'}\\\">${sh ? sh.pegos : '—'}</b><small>pegos</small></div></div>\\n        </section>\\n        <div class=\\\"mx-stats\\\">\\n          <div><small>Ouro/h</small><b style=\\\"color:var(--gold)\\\">${curto(r.ouro)}</b><em>lucro ${esc(valorTile(e.lucro, curto(s.gold)))}</em></div>\\n          <div><small>XP/h</small><b>${curto(r.xp)}</b><em>total ${esc(valorTile(e.xpT, curto(s.xpTreinador)))}</em></div>\\n          <div><small>Capturas</small><b>${esc(valorTile(e.capturas, curto(s.capturas)))}</b><em>${curto(r.caps)}/h · abates ${esc(valorTile(e.abates, curto(s.abates)))}</em></div>\\n          <div><small>Carteira</small><b>${curto(num(d.ouro))}</b><em>${esc(d.gemas || 0)} gemas · ${esc(d.diamantes || 0)} diam.</em></div>\\n        </div>\\n        <div class=\\\"mx-pk\\\">${d.pk.sprite ? `<img src=\\\"${d.pk.sprite}\\\" alt=\\\"\\\">` : '<span class=\\\"sem\\\"></span>'}\\n          <div><b>${esc(d.pk.nome || '—')} <span>${esc(d.pk.lv)}</span></b>\\n            ${hpPct != null ? `<div class=\\\"mx-hp\\\" title=\\\"HP ${esc(d.pk.hp)}\\\"><i style=\\\"width:${hpPct}%;background:${hpCor}\\\"></i></div>` : ''}</div></div>\\n        ${capsLista ? `<div class=\\\"mx-sec\\\"><h4 class=\\\"hud\\\">ÚLTIMAS CAPTURAS</h4>${capsLista}</div>` : ''}\\n        ${achados.length || gastos.length ? `<div class=\\\"mx-sec\\\"><h4 class=\\\"hud\\\">ACHADOS E GASTOS</h4><div class=\\\"mx-itens\\\">\\n          ${achados.map((it) => `<span class=\\\"mx-it\\\">${urlImg(it.img) ? `<img src=\\\"${urlImg(it.img)}\\\" alt=\\\"\\\">` : ''}${esc(it.n)}</span>`).join('')}\\n          ${gastos.map((it) => `<span class=\\\"mx-it g\\\" title=\\\"gasto\\\">${urlImg(it.img) ? `<img src=\\\"${urlImg(it.img)}\\\" alt=\\\"\\\">` : ''}−${esc(it.n)}</span>`).join('')}</div></div>` : ''}\\n        ${log.length ? `<div class=\\\"mx-log\\\">${log.map((l) => `<div class=\\\"${/desmai|morre|caiu|derrot.*seu/i.test(l) ? 'ruim' : /captur/i.test(l) ? 'bom' : ''}\\\">${esc(l)}</div>`).join('')}</div>` : ''}\\n        <button class=\\\"mx-b mx-ver\\\" data-ver=\\\"${d.conta}\\\" title=\\\"Abre esta conta (todas voltam ao Eco)\\\">Abrir esta conta</button>\\n      </article>`;\\n    }\\n\\n    function draw(pkt) {\\n      const cs = pkt.contas || [];\\n      const ok = cs.filter((d) => !d.erro);\\n      const t = ok.reduce((a, d) => { const r = rates(d); const sh = (d.eco && d.eco.shiny) || {};\\n        return { ouroH: a.ouroH + r.ouro, xpH: a.xpH + r.xp, ouro: a.ouro + num(d.ouro), caps: a.caps + (num(d.eco && d.eco.capturas && d.eco.capturas[1]) || (d.ses || {}).capturas || 0),\\n          vistos: a.vistos + (Number(sh.vistos) || 0), pegos: a.pegos + (Number(sh.pegos) || 0) }; }, { ouroH: 0, xpH: 0, ouro: 0, caps: 0, vistos: 0, pegos: 0 });\\n      const imgs = ok.map((d) => d.perfil && d.perfil.img).filter(Boolean);\\n      avatarIgual = imgs.length > 1 && new Set(imgs).size === 1;\\n      root.className = 'mx';\\n      root.innerHTML = `\\n        <header class=\\\"mx-top\\\">\\n          <div class=\\\"mx-brand\\\">\\n            <div class=\\\"mx-logo\\\" aria-hidden=\\\"true\\\"><svg width=\\\"30\\\" height=\\\"30\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"#96f25c\\\" stroke-width=\\\"2.2\\\" stroke-linecap=\\\"round\\\"><path d=\\\"M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1\\\"/><path d=\\\"M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1\\\"/></svg></div>\\n            <div class=\\\"mx-brand-t\\\"><b class=\\\"hud\\\">MEGA ECO</b>\\n              <div class=\\\"mx-brand-l\\\"><span class=\\\"mx-vivo\\\"><i></i>${ok.length} de ${cs.length} contas rodando</span><span class=\\\"mx-mut\\\">${pkt.at ? 'atualizado ' + new Date(pkt.at).toLocaleTimeString('pt-BR') : ''}</span></div></div>\\n          </div>\\n          <section class=\\\"mx-frame mx-box mx-shiny\\\" aria-label=\\\"Shiny nesta hunt\\\">\\n            <span class=\\\"est\\\" style=\\\"right:4%;bottom:10%\\\" aria-hidden=\\\"true\\\">✧</span>\\n            <h3 class=\\\"hud\\\">✦ SHINY NESTA HUNT</h3>\\n            <div class=\\\"mx-nums\\\"><div><b class=\\\"hud${t.vistos ? '' : ' zero'}\\\">${t.vistos}</b><small>vistos</small></div><div><b class=\\\"hud${t.pegos ? '' : ' zero'}\\\">${t.pegos}</b><small>pegos</small></div></div>\\n          </section>\\n          <section class=\\\"mx-frame mx-box\\\" aria-label=\\\"Ritmo das contas\\\">\\n            <h3 class=\\\"hud\\\">RITMO AGORA · ${ok.length} ${ok.length === 1 ? 'CONTA' : 'CONTAS'}</h3>\\n            <div class=\\\"mx-nums\\\"><div><small>Ouro/h</small><b class=\\\"hud\\\" style=\\\"color:var(--gold)\\\">${curto(t.ouroH)}</b></div><div><small>XP/h</small><b class=\\\"hud\\\">${curto(t.xpH)}</b></div>\\n              <div><small>Capturas</small><b class=\\\"hud\\\">${curto(t.caps)}</b></div><div><small>Ouro total</small><b class=\\\"hud\\\">${curto(t.ouro)}</b></div></div>\\n          </section>\\n          <div class=\\\"mx-acoes\\\"><button class=\\\"mx-b\\\" data-lv=\\\"1\\\" title=\\\"Mostra os jogos em Modo Economia\\\">Ver os jogos (Eco)</button>\\n            <button class=\\\"mx-b gold\\\" data-lv=\\\"0\\\" title=\\\"Volta tudo ao normal\\\">Normal</button></div>\\n        </header>\\n        <div class=\\\"mx-grid\\\">${cs.map(card).join('')}</div>`;\\n      root.querySelectorAll('[data-lv]').forEach((b) => { b.onclick = () => window.api.resumoNivel(-1, Number(b.dataset.lv)); });\\n      root.querySelectorAll('[data-ver]').forEach((b) => { b.onclick = () => window.api.resumoNivel(Number(b.dataset.ver), 1); });\\n    }\\n    window.api.onResumo(draw);\\n    root.innerHTML = '<div class=\\\"mx-vazio\\\">Montando o painel...</div>';\\n    window.api.resumoReady();\\n  }\\n\\n  /* ---------------------- pontos da Kick (resgate) ---------------------- */\\n  function initKick(painel) {\\n    // painel = { fechar, conta }: abre como painel que desce do botão (sem janela separada)\\n    if (!painel) {\\n      document.body.classList.add('kickw');\\n      document.title = 'Pontos da Kick — PokeLink';\\n      app.hidden = true;\\n    }\\n    const root = document.getElementById('kickw');\\n    root.hidden = false;\\n    const esc = (t) => String(t == null ? '' : t).replace(/[&<>\\\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;' }[c]));\\n    const fmt = (n) => Number(n).toLocaleString('pt-BR');\\n    const dur = (ms) => { const m = Math.max(0, Math.round(ms / 60000)); return m < 60 ? `${m} min` : `${Math.floor(m / 60)}h${String(m % 60).padStart(2, '0')}`; };\\n    root.innerHTML = `<div class=\\\"ch\\\">${iconHtml(null)}<b>Pontos da Kick</b><span>resgate</span>${painel ? '<button class=\\\"cfg-x\\\" id=\\\"kwX\\\" title=\\\"Fechar\\\">×</button>' : ''}</div>\\n      <div class=\\\"kx-top\\\" id=\\\"kxTabs\\\"></div><div class=\\\"cb\\\" id=\\\"kwBody\\\"><div class=\\\"pv-msg\\\">Carregando...</div></div>`;\\n    if (painel) document.getElementById('kwX').onclick = () => painel.fechar();\\n    const tabs = document.getElementById('kxTabs');\\n    const body = document.getElementById('kwBody');\\n    let last = null;\\n    let conta = painel && Number.isInteger(painel.conta) ? painel.conta : null;\\n    if (painel) window.__kickConta = (k) => { conta = k; if (last) draw(last); };\\n\\n    // próxima meta e progresso de um saldo\\n    const meta = (goals, pts) => goals.find((g) => pts < g.pts) || null;\\n\\n    function ring(pct, cls) {\\n      return `<div class=\\\"kx-ring ${cls || ''}\\\" style=\\\"--p:${Math.max(0, Math.min(100, pct))}\\\"><div class=\\\"kx-ring-in\\\"></div></div>`;\\n    }\\n\\n    function cardFarm(c, t, k, goals) {\\n      const farmando = !!k;\\n      k = k || {};\\n      const pts = t.pts;\\n      const m = pts == null ? goals[0] : meta(goals, pts);\\n      const pct = pts == null ? 0 : m ? (pts / m.pts) * 100 : 100;\\n      const falta = m && pts != null ? m.pts - pts : 0;\\n      const eta = m && k && k.porHora > 0 ? dur((falta / k.porHora) * 3600000) : null;\\n      const st = !farmando ? '<span class=\\\"kx-st live\\\"><i class=\\\"rec\\\"></i>AO VIVO</span>'\\n        : k.semRender ? '<span class=\\\"kx-st warn\\\">⚠ sem render</span>'\\n        : k.tocando == null ? '<span class=\\\"kx-st\\\">abrindo...</span>'\\n        : k.tocando ? '<span class=\\\"kx-st live\\\"><i class=\\\"rec\\\"></i>AO VIVO</span>' : '<span class=\\\"kx-st bad\\\">⏸ parado</span>';\\n      return `<div class=\\\"kx-card farm${!m ? ' done' : ''}${farmando ? '' : ' idle'}\\\">\\n        <div class=\\\"kx-ch\\\"><b>${esc(t.slug)}</b><span class=\\\"kx-chr\\\">${st}<button class=\\\"kx-x\\\" data-rm=\\\"kick|${esc(t.slug)}\\\" title=\\\"Remover ${esc(t.slug)} da lista (não é mais parceiro)\\\">×</button></span></div>\\n        <div class=\\\"kx-mid\\\">\\n          <div class=\\\"kx-ringbox\\\">${ring(pct, !m ? 'full' : '')}<div class=\\\"kx-ringtx\\\"><b>${pts == null ? '—' : fmt(pts)}</b><span>pontos</span></div></div>\\n          <div class=\\\"kx-info\\\">\\n            ${m ? `<div class=\\\"kx-next\\\">Próximo: <b>${esc(m.nome)}</b></div><div class=\\\"kx-falta\\\">faltam <b>${fmt(falta)}</b> pts${eta ? ` · ~${eta}` : ''}</div>`\\n              : `<div class=\\\"kx-next\\\"><b>Pode resgatar tudo!</b></div><div class=\\\"kx-falta\\\">1.000+ pontos</div>`}\\n            <div class=\\\"kx-meta\\\">${farmando\\n              ? `${k.porHora != null ? `<b>+${fmt(k.porHora)}</b>/h · ` : ''}farmando há ${dur(Date.now() - (k.aberta || Date.now()))}`\\n              : '<span class=\\\"kx-off\\\">não está farmando · ative para farmar</span>'}</div>\\n            <div class=\\\"kx-goals\\\">${goals.map((g) => `<span class=\\\"${pts != null && pts >= g.pts ? 'on' : ''}\\\">${fmt(g.pts)}</span>`).join('')}</div>\\n          </div>\\n        </div>\\n        <div class=\\\"kx-act\\\">\\n          ${pts != null && pts >= goals[0].pts\\n            ? `<button class=\\\"kx-btn go\\\" data-live=\\\"${c.i}|${esc(t.slug)}\\\" title=\\\"Abre a live com a sua conta para resgatar nos pontos do canal\\\">Resgatar</button>`\\n            : `<button class=\\\"kx-btn go\\\" disabled title=\\\"Disponível a partir de ${fmt(goals[0].pts)} pontos\\\">Resgatar</button>`}\\n          <button class=\\\"kx-btn${t.sel ? ' sel' : ''}\\\" data-sel=\\\"${c.i}|${esc(t.slug)}\\\" title=\\\"${t.sel ? 'Clique para desativar este canal' : 'Ativar este canal para farmar'}\\\">${t.sel ? '✓ Ativado' : 'Ativar'}</button>\\n        </div>\\n      </div>`;\\n    }\\n\\n    function cardOutro(c, t) {\\n      return `<button class=\\\"kx-mini${t.sel ? ' sel' : ''}${t.live ? ' live' : ''}\\\" data-sel=\\\"${c.i}|${esc(t.slug)}\\\" title=\\\"${t.live ? 'Ao vivo agora' : 'Offline'} · clique para ${t.sel ? 'desativar' : 'ativar e farmar quando entrar ao vivo'}\\\">\\n        <span class=\\\"dot\\\"></span><span class=\\\"nm\\\">${esc(t.slug)}</span><b>${t.pts != null ? fmt(t.pts) : '—'}</b>${t.sel ? '<i>✓</i>' : ''}<span class=\\\"kx-x\\\" data-rm=\\\"kick|${esc(t.slug)}\\\" title=\\\"Remover ${esc(t.slug)} da lista (não é mais parceiro)\\\">×</span></button>`;\\n    }\\n\\n    function draw(d) {\\n      if (!d) return;\\n      last = d;\\n      if (conta == null || !d.contas[conta]) conta = Math.max(0, d.contas.findIndex((x) => x.on));\\n      // abas das contas\\n      tabs.innerHTML = d.contas.map((c, n) => `<button class=\\\"kx-tab${n === conta ? ' cur' : ''}${c.on ? '' : ' off'}\\\" data-tab=\\\"${n}\\\">\\n        ${esc(c.name)}${c.on ? `<span class=\\\"kx-badge\\\">${c.canais.length}</span>` : ''}</button>`).join('') +\\n        '<span class=\\\"grow\\\"></span>' +\\n        `<label class=\\\"kx-sw kx-av\\\" title=\\\"Aviso quando um canal bater 300, 500 ou 1.000 pontos\\\"><span>🔔 Avisos</span><input type=\\\"checkbox\\\" class=\\\"sw\\\" id=\\\"kwAvisos\\\" ${d.avisos === false ? '' : 'checked'}></label>` +\\n        `<button class=\\\"kx-btn small\\\" id=\\\"kwDiag\\\" title=\\\"Salva um arquivo para análise\\\">Diagnóstico</button><button class=\\\"kx-btn small\\\" id=\\\"kwNow\\\" title=\\\"${d.atualizado ? 'Última atualização às ' + esc(d.atualizado) : 'Confere agora os pontos e quem está ao vivo'}\\\">${kwOcupado ? 'Atualizando...' : d.atualizado ? 'Atualizar · ' + esc(d.atualizado) : 'Atualizar'}</button>`;\\n      const c = d.contas[conta];\\n      let h = '';\\n      if (!c.on) {\\n        h = `<div class=\\\"kx-empty big\\\"><b>Kick desligada em ${esc(c.name)}</b><span>As lives oficiais da Kick abrem sozinhas (mutadas) para juntar os pontos dos canais.</span>\\n          <div><button class=\\\"kx-btn go kx-on\\\" data-kon=\\\"${c.i}\\\">Ligar a Kick nesta conta</button></div></div>`;\\n      } else {\\n        const abertos = new Map(c.canais.map((k) => [k.slug, k]));\\n        // \\\"Ao vivo\\\": todos os canais ao vivo (farmando primeiro); \\\"Outros canais\\\": os offline\\n        const aoVivo = c.todos.filter((t) => t.live || abertos.has(t.slug))\\n          .sort((a, b2) => (abertos.has(b2.slug) - abertos.has(a.slug)) || ((b2.pts || 0) - (a.pts || 0)));\\n        const outros = c.todos.filter((t) => !t.live && !abertos.has(t.slug)).sort((a, b2) => (b2.pts || 0) - (a.pts || 0));\\n        h += `<div class=\\\"kx-sum\\\"><div><b>${c.sel.length ? `Farmando só os ${c.sel.length} ativados` : 'Farmando automático'}</b>\\n          <span>${c.sel.length ? 'Desative todos para voltar ao automático.' : 'Ative canais para escolher quais farmar.'}</span></div>\\n          <div class=\\\"kx-goalbar\\\">${d.goals.map((g) => `<div><b>${fmt(g.pts)}</b><span>${esc(g.nome)}</span></div>`).join('')}</div>\\n          <div class=\\\"kx-resgate\\\">\\n            <label class=\\\"kx-sw\\\" title=\\\"Resgata os bônus sozinho, sem abrir janela nenhuma\\\"><span>🎁 Auto Resgate</span><input type=\\\"checkbox\\\" class=\\\"sw\\\" id=\\\"kwAutoResgate\\\" ${d.autoResgate ? 'checked' : ''}></label>\\n            <div class=\\\"kx-tiers\\\">${d.goals.map((g) => `<label class=\\\"kx-tier\\\"><input type=\\\"checkbox\\\" class=\\\"sw\\\" data-tier=\\\"${g.pts}\\\" ${d.resgateTiers[g.pts] ? 'checked' : ''}>${fmt(g.pts)}</label>`).join('')}</div>\\n            ${d.kickPlayer !== 'completa' ? '<small class=\\\"kx-info\\\">Na hora de resgatar, a Kick troca pro player grande por alguns segundos e volta pro pequeno sozinha.</small>' : ''}\\n          </div>\\n          <label class=\\\"kx-sw\\\" title=\\\"Desliga a Kick nesta conta (fecha as lives)\\\"><span>Kick ligada</span><input type=\\\"checkbox\\\" class=\\\"sw\\\" checked data-koff=\\\"${c.i}\\\"></label></div>`;\\n        const nFarm = aoVivo.filter((t) => abertos.has(t.slug)).length;\\n        h += `<h3 class=\\\"kx-h\\\">Ao vivo <small>${aoVivo.length} live${aoVivo.length === 1 ? '' : 's'} · ${nFarm} farmando</small></h3>`;\\n        h += aoVivo.length ? `<div class=\\\"kx-grid\\\">${aoVivo.map((t) => cardFarm(c, t, abertos.get(t.slug), d.goals)).join('')}</div>`\\n          : '<div class=\\\"kx-empty\\\">Nenhum canal oficial da Kick ao vivo agora. Os pontos só sobem com live aberta.</div>';\\n        if (outros.length) h += `<h3 class=\\\"kx-h\\\">Offline <small>clique para ativar: o PokeLink farma quando o canal entrar ao vivo</small></h3><div class=\\\"kx-minis\\\">${outros.map((t) => cardOutro(c, t)).join('')}</div>`;\\n      }\\n      if (d.removidos && d.removidos.length) h += `<h3 class=\\\"kx-h\\\">Removidos da lista <small>não são mais parceiros · clique para trazer de volta</small></h3><div class=\\\"kx-minis\\\">${d.removidos.map((r) => `<button class=\\\"kx-mini rmv\\\" data-back=\\\"kick|${esc(r.slug)}\\\" title=\\\"Trazer ${esc(r.slug)} de volta para a lista\\\"><span class=\\\"dot\\\"></span><span class=\\\"nm\\\">${esc(r.slug)}</span><b>${r.como === 'auto' ? 'automático' : 'você tirou'}</b></button>`).join('')}</div>`;\\n      h += `<div class=\\\"kx-foot\\\">A Kick dá 10 pontos a cada 5 minutos de live (≈120/h por canal; assinante 20). Resgatar abre a live com a sua conta: abra os pontos do canal embaixo do chat. Atualiza sozinho a cada ${d.poll}s e avisa ao bater ${d.goals.map((g) => fmt(g.pts)).join(', ')}.</div>`;\\n      body.innerHTML = h;\\n      tabs.querySelectorAll('[data-tab]').forEach((b2) => { b2.onclick = () => { conta = Number(b2.dataset.tab); draw(last); }; });\\n      root.querySelectorAll('[data-kon]').forEach((b2) => { b2.onclick = () => window.api.setLives(Number(b2.dataset.kon), 'kick', true); });\\n      root.querySelectorAll('[data-koff]').forEach((b2) => { b2.onchange = () => window.api.setLives(Number(b2.dataset.koff), 'kick', b2.checked); });\\n      root.querySelectorAll('[data-sel]').forEach((b2) => { const [ci, sl] = b2.dataset.sel.split('|'); b2.onclick = () => window.api.kickSel(Number(ci), sl); });\\n      root.querySelectorAll('[data-rm]').forEach((b2) => { const [pl, sl] = b2.dataset.rm.split('|'); b2.onclick = (ev) => { ev.stopPropagation(); window.api.canalRemover(pl, sl); }; });\\n      root.querySelectorAll('[data-back]').forEach((b2) => { const [pl, sl] = b2.dataset.back.split('|'); b2.onclick = () => window.api.canalVoltar(pl, sl); });\\n      root.querySelectorAll('[data-live]').forEach((b2) => { const [ci, sl] = b2.dataset.live.split('|'); b2.onclick = () => window.api.kickRedeemLive(Number(ci), sl); });\\n      const kwb = document.getElementById('kwNow');\\n      kwb.disabled = kwOcupado;\\n      kwb.onclick = async () => {\\n        if (kwOcupado) return;\\n        kwOcupado = true; kwb.disabled = true; kwb.textContent = 'Atualizando...';\\n        let r = null;\\n        try { r = await window.api.kickRefresh(); } finally { kwOcupado = false; }\\n        draw(r || last);\\n      };\\n      document.getElementById('kwAvisos').onchange = (ev) => window.api.kickAvisos(ev.target.checked);\\n      const kwAr = document.getElementById('kwAutoResgate');\\n      if (kwAr) kwAr.onchange = (ev) => { if (last) last.autoResgate = ev.target.checked; window.api.kickAutoResgate(ev.target.checked); };\\n      root.querySelectorAll('[data-tier]').forEach((b2) => {\\n        b2.onchange = () => {\\n          const pts = Number(b2.dataset.tier);\\n          if (last && last.resgateTiers) last.resgateTiers[pts] = b2.checked;\\n          window.api.kickResgateTier(pts, b2.checked);\\n        };\\n      });\\n      document.getElementById('kwDiag').onclick = async () => {\\n        const f = await window.api.kickDiag();\\n        alert(f ? 'Diagnóstico salvo na Área de Trabalho: kick-diagnostico.json' : 'Nenhuma live da Kick aberta agora para gerar o diagnóstico.');\\n      };\\n    }\\n    let refreshSeq = 0;\\n    const refresh = async () => {\\n      const seq = ++refreshSeq;\\n      const d = await window.api.kickGet().catch(() => last);\\n      if (seq === refreshSeq) draw(d); // chegou uma busca mais nova enquanto essa esperava: ignora a atrasada\\n    };\\n    var kwOcupado = false; // botão Atualizar trabalhando\\n    window.api.onKickUpdate(() => { if (!root.hidden) refresh(); });\\n    setInterval(() => { if (last && !root.hidden) draw(last); }, 15000); // atualiza os tempos\\n    if (painel) window.__kickRefresh = refresh;\\n    refresh();\\n  }\\n\\n  /* ------------------- pontos e resgate da TWITCH (painel roxo) ------------------- */\\n  function initTwitch() {\\n    document.body.classList.add('twitchw');\\n    document.title = 'Pontos da Twitch — PokeLink';\\n    app.hidden = true;\\n    const root = document.getElementById('twitchw');\\n    root.hidden = false;\\n    const esc = (t) => String(t == null ? '' : t).replace(/[&<>\\\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;' }[c]));\\n    const fmt = (n) => Number(n).toLocaleString('pt-BR');\\n    const dur = (ms) => { const m = Math.max(0, Math.round(ms / 60000)); return m < 60 ? m + ' min' : Math.floor(m / 60) + 'h' + String(m % 60).padStart(2, '0'); };\\n    root.innerHTML = '<div class=\\\"ch\\\">' + iconHtml(null) + '<b>Pontos da Twitch</b><span>resgate</span></div>' +\\n      '<div class=\\\"kx-top\\\" id=\\\"twTabs\\\"></div><div class=\\\"cb\\\" id=\\\"twBody\\\"><div class=\\\"pv-msg\\\">Carregando...</div></div>';\\n    const tabs = document.getElementById('twTabs');\\n    const body = document.getElementById('twBody');\\n    let last = null;\\n    let conta = null;\\n    let ocupado = false;\\n\\n    const meta = (goals, pts) => goals.find((g) => pts < g.pts) || null;\\n    const ring = (pct, cls) => '<div class=\\\"kx-ring ' + (cls || '') + '\\\" style=\\\"--p:' + Math.max(0, Math.min(100, pct)) + '\\\"><div class=\\\"kx-ring-in\\\"></div></div>';\\n\\n    // pacotes que este canal oferece, agrupados por tipo de bônus\\n    function packHtml(k, pts) {\\n      const ops = (k && k.opcoes) || [];\\n      if (!ops.length) return '';\\n      const porTipo = {};\\n      ops.forEach((o) => { (porTipo[o.tipo] = porTipo[o.tipo] || []).push(o); });\\n      let h = '';\\n      Object.keys(porTipo).forEach((t) => {\\n        const lista = porTipo[t].slice().sort((a, b) => a.custo - b.custo);\\n        h += '<span class=\\\"' + (pts != null && pts >= lista[0].custo ? 'on' : '') + '\\\">' +\\n          (t === 'xp' ? 'XP' : t === 'capture' ? 'Capture' : 'Lure') + ' ' +\\n          lista.map((o) => fmt(o.custo) + (o.horas > 1 ? '·' + o.horas + 'h' : '')).join(' / ') + '</span>';\\n      });\\n      return '<div class=\\\"tw-pack\\\">' + h + '</div>';\\n    }\\n\\n    function cardFarm(c, t, k, goals) {\\n      const farmando = !!k;\\n      k = k || {};\\n      const pts = t.pts;\\n      const m = pts == null ? goals[0] : meta(goals, pts);\\n      const pct = pts == null ? 0 : m ? (pts / m.pts) * 100 : 100;\\n      const falta = m && pts != null ? m.pts - pts : 0;\\n      const eta = m && k && k.porHora > 0 ? dur((falta / k.porHora) * 3600000) : null;\\n      // A Twitch passa um anúncio antes da live: nos primeiros minutos o player fica indo e voltando, e\\n      // cravar \\\"vídeo parado\\\" ali era alarme falso. Agora só acusa depois de 3 min sem o vídeo andar.\\n      const novinha = farmando && Date.now() - (k.aberta || 0) < 3 * 60 * 1000;\\n      const st = !farmando ? '<span class=\\\"kx-st live\\\"><i class=\\\"rec\\\"></i>AO VIVO</span>'\\n        : k.logado === false ? '<span class=\\\"kx-st bad\\\">sem login</span>'\\n        : k.tocando ? '<span class=\\\"kx-st live\\\"><i class=\\\"rec\\\"></i>AO VIVO</span>'\\n        : k.tocando == null || novinha ? '<span class=\\\"kx-st\\\">começando...</span>'\\n        : k.semPlayer ? '<span class=\\\"kx-st bad\\\">sem player</span>'\\n        : k.semRender ? '<span class=\\\"kx-st warn\\\">sem render</span>'\\n        : '<span class=\\\"kx-st bad\\\">vídeo parado</span>';\\n      const podeJa = k && k.melhor;\\n      return '<div class=\\\"kx-card farm' + (!m ? ' done' : '') + (farmando ? '' : ' idle') + '\\\">' +\\n        '<div class=\\\"kx-ch\\\"><b>' + esc(t.slug) + '</b><span class=\\\"kx-chr\\\">' + st +\\n          '<button class=\\\"kx-x\\\" data-rm=\\\"twitch|' + esc(t.slug) + '\\\" title=\\\"Remover ' + esc(t.slug) + ' da lista (não é mais parceiro)\\\">&times;</button></span></div>' +\\n        '<div class=\\\"kx-mid\\\">' +\\n          '<div class=\\\"kx-ringbox\\\">' + ring(pct, !m ? 'full' : '') + '<div class=\\\"kx-ringtx\\\"><b>' + (pts == null ? '&mdash;' : fmt(pts)) + '</b><span>pontos</span></div></div>' +\\n          '<div class=\\\"kx-info\\\">' +\\n            (pts == null ? '<div class=\\\"kx-next\\\">Próximo: <b>' + esc(goals[0].nome) + '</b></div><div class=\\\"kx-falta\\\">saldo ainda não lido</div>'\\n              : m ? '<div class=\\\"kx-next\\\">Próximo: <b>' + esc(m.nome) + '</b></div><div class=\\\"kx-falta\\\">faltam <b>' + fmt(falta) + '</b> pts' + (eta ? ' &middot; ~' + eta : '') + '</div>'\\n              : '<div class=\\\"kx-next\\\"><b>Pode resgatar tudo!</b></div><div class=\\\"kx-falta\\\">1.000+ pontos</div>') +\\n            (k.via ? '<div class=\\\"kx-meta\\\">saldo ' + (k.via === 'api' ? 'pela Twitch' : 'lido da tela' + (k.onde ? ' (' + esc(k.onde) + ')' : '')) + '</div>' : '') +\\n            '<div class=\\\"kx-meta\\\">' + (farmando\\n              ? ((k.porHora != null ? '<b>+' + fmt(k.porHora) + '</b>/h &middot; ' : '') + 'farmando há ' + dur(Date.now() - (k.aberta || Date.now())) +\\n                 (k.altura ? ' &middot; vídeo ' + k.altura + 'p' : ''))\\n              : '<span class=\\\"kx-off\\\">não está farmando &middot; ative para farmar</span>') + '</div>' +\\n            packHtml(k, pts) +\\n          '</div>' +\\n        '</div>' +\\n        '<div class=\\\"kx-act\\\">' +\\n          (podeJa\\n            ? '<button class=\\\"kx-btn go\\\" data-live=\\\"' + c.i + '|' + esc(t.slug) + '\\\" title=\\\"Resgata ' + esc(podeJa.titulo) + ' por ' + fmt(podeJa.custo) + ' pontos\\\">Resgatar ' + (podeJa.horas > 1 ? podeJa.horas + 'h' : '') + '</button>'\\n            : '<button class=\\\"kx-btn go\\\" disabled title=\\\"Disponível a partir de ' + fmt(goals[0].pts) + ' pontos\\\">Resgatar</button>') +\\n          '<button class=\\\"kx-btn' + (t.sel ? ' sel' : '') + '\\\" data-sel=\\\"' + c.i + '|' + esc(t.slug) + '\\\" title=\\\"' + (t.sel ? 'Clique para desativar este canal' : 'Ativar este canal para farmar') + '\\\">' + (t.sel ? '&#10003; Ativado' : 'Ativar') + '</button>' +\\n        '</div>' +\\n      '</div>';\\n    }\\n\\n    function cardOutro(c, t) {\\n      return '<button class=\\\"kx-mini' + (t.sel ? ' sel' : '') + (t.live ? ' live' : '') + '\\\" data-sel=\\\"' + c.i + '|' + esc(t.slug) + '\\\" title=\\\"' + (t.live ? 'Ao vivo agora' : 'Offline') + ' &middot; clique para ' + (t.sel ? 'desativar' : 'ativar') + '\\\">' +\\n        '<span class=\\\"dot\\\"></span><span class=\\\"nm\\\">' + esc(t.slug) + '</span><b>' + (t.pts != null ? fmt(t.pts) : '&mdash;') + '</b>' + (t.sel ? '<i>&#10003;</i>' : '') +\\n        '<span class=\\\"kx-x\\\" data-rm=\\\"twitch|' + esc(t.slug) + '\\\" title=\\\"Remover da lista\\\">&times;</span></button>';\\n    }\\n\\n    function draw(d) {\\n      if (!d) return;\\n      last = d;\\n      if (conta == null || !d.contas[conta]) conta = Math.max(0, d.contas.findIndex((x) => x.on));\\n      tabs.innerHTML = d.contas.map((c, n) => '<button class=\\\"kx-tab' + (n === conta ? ' cur' : '') + (c.on ? '' : ' off') + '\\\" data-tab=\\\"' + n + '\\\">' +\\n          esc(c.name) + (c.on ? '<span class=\\\"kx-badge\\\">' + c.canais.length + '</span>' : '') + '</button>').join('') +\\n        '<span class=\\\"grow\\\"></span>' +\\n        '<label class=\\\"kx-sw kx-av\\\" title=\\\"Aviso quando um canal bater 300, 500 ou 1.000 pontos\\\"><span>Avisos</span><input type=\\\"checkbox\\\" class=\\\"sw\\\" id=\\\"twAvisos\\\" ' + (d.avisos === false ? '' : 'checked') + '></label>' +\\n        '<button class=\\\"kx-btn small\\\" id=\\\"twDiag\\\" title=\\\"Salva um arquivo na Área de Trabalho para análise\\\">Diagnóstico</button>' +\\n        '<button class=\\\"kx-btn small\\\" id=\\\"twNow\\\">' + (ocupado ? 'Atualizando...' : d.atualizado ? 'Atualizar &middot; ' + esc(d.atualizado) : 'Atualizar') + '</button>';\\n      const c = d.contas[conta];\\n      let h = '';\\n      if (d.abertasTotal > 2) {\\n        h += '<div class=\\\"tw-alert\\\"><div><b>' + d.abertasTotal + ' lives da Twitch abertas somando as 4 contas.</b> ' +\\n          'A Twitch só conta quem assiste até <b>2 lives ao mesmo tempo por computador</b> — as outras não rendem ponto nenhum. ' +\\n          'Se um canal mostra +120/h e outro mostra +0/h, é isto. Baixe \\\"Lives por conta\\\" ou desligue a Twitch em alguma conta.</div></div>';\\n      }\\n      if (!d.modoOk) {\\n        h += '<div class=\\\"tw-alert\\\"><div><b>A Twitch não está na página do canal.</b> ' +\\n          'O bônus do PokeIdle agora vem dos pontos do canal, e a Twitch só dá pontos com o vídeo rodando na página do canal. ' +\\n          'Os modos de chat não ganham mais nada. Troque em Lives &gt; Ajustes da Twitch.</div></div>';\\n      }\\n      if (!c.on) {\\n        h += '<div class=\\\"kx-empty big\\\"><b>Twitch desligada em ' + esc(c.name) + '</b><span>As lives oficiais abrem sozinhas (mutadas) para juntar os pontos dos canais.</span>' +\\n          '<div><button class=\\\"kx-btn go kx-on\\\" data-ton=\\\"' + c.i + '\\\">Ligar a Twitch nesta conta</button></div></div>';\\n      } else {\\n        if (!c.vinculo) {\\n          h += '<div class=\\\"tw-alert\\\"><div><b>Sem conta da Twitch vinculada em ' + esc(c.name) + '.</b> ' +\\n            'O vínculo é feito uma vez no painel Bônus Twitch dentro do jogo e vale para sempre. Resgate sem vínculo é recusado (a Twitch devolve os pontos).</div></div>';\\n        }\\n        const abertos = new Map(c.canais.map((k) => [k.slug, k]));\\n        const aoVivo = c.todos.filter((t) => t.live || abertos.has(t.slug))\\n          .sort((a, b2) => (abertos.has(b2.slug) - abertos.has(a.slug)) || ((b2.pts || 0) - (a.pts || 0)));\\n        const outros = c.todos.filter((t) => !t.live && !abertos.has(t.slug)).sort((a, b2) => (b2.pts || 0) - (a.pts || 0));\\n        h += '<div class=\\\"kx-sum\\\"><div><b>' + (c.sel.length ? 'Farmando só os ' + c.sel.length + ' ativados' : 'Farmando automático') + '</b>' +\\n          '<span>' + (c.sel.length ? 'Desative todos para voltar ao automático.' : 'Ative canais para escolher quais farmar.') + '</span>' +\\n          '<span class=\\\"tw-vinc\\\">Conta da Twitch: ' + (c.vinculo ? '<b>' + esc(c.vinculo) + '</b>' : 'não vinculada') + '</span></div>' +\\n          '<div class=\\\"kx-goalbar\\\">' + d.goals.map((g) => '<div><b>' + fmt(g.pts) + '</b><span>' + esc(g.nome) + '</span></div>').join('') + '</div>' +\\n          '<div class=\\\"kx-resgate\\\">' +\\n            '<label class=\\\"kx-sw\\\" title=\\\"Resgata os bônus sozinho, sem abrir janela nenhuma\\\"><span>Auto Resgate</span><input type=\\\"checkbox\\\" class=\\\"sw\\\" id=\\\"twAuto\\\" ' + (d.autoResgate ? 'checked' : '') + '></label>' +\\n            '<div class=\\\"kx-tiers\\\">' + d.tipos.map((t) => '<label class=\\\"kx-tier\\\"><input type=\\\"checkbox\\\" class=\\\"sw\\\" data-tier=\\\"' + t.id + '\\\" ' + (d.resgateTiers[t.id] === false ? '' : 'checked') + '>' + esc(t.nome.replace('+15% ', '')) + '</label>').join('') + '</div>' +\\n            '<label class=\\\"kx-sw\\\" title=\\\"Pega o maior pacote que der (3h, 5h, 10h) em vez de 1 hora de cada vez. Mesmo preço por hora e menos cliques.\\\"><span>Preferir pacotes</span><input type=\\\"checkbox\\\" class=\\\"sw\\\" id=\\\"twPack\\\" ' + (d.pacotes ? 'checked' : '') + '></label>' +\\n            '<div class=\\\"kx-tiers\\\" title=\\\"A Twitch conta poucas lives ao mesmo tempo. Se um canal render +120/h e o outro 0, teste com 1.\\\"><span class=\\\"tw-vinc\\\">Lives por conta:</span>' +\\n              [1, 2].map((n) => '<button class=\\\"kx-btn small' + (d.max === n ? ' sel' : '') + '\\\" data-max=\\\"' + n + '\\\">' + n + '</button>').join('') + '</div>' +\\n          '</div>' +\\n          '<label class=\\\"kx-sw\\\" title=\\\"Desliga a Twitch nesta conta (fecha as lives)\\\"><span>Twitch ligada</span><input type=\\\"checkbox\\\" class=\\\"sw\\\" checked data-toff=\\\"' + c.i + '\\\"></label></div>';\\n        const nFarm = aoVivo.filter((t) => abertos.has(t.slug)).length;\\n        h += '<h3 class=\\\"kx-h\\\">Ao vivo <small>' + aoVivo.length + ' live' + (aoVivo.length === 1 ? '' : 's') + ' &middot; ' + nFarm + ' farmando &middot; máximo ' + d.max + ' por conta' + (d.check ? ' &middot; ' + esc(d.check) : '') + (d.saldoInfo ? ' &middot; ' + esc(d.saldoInfo) : '') + '</small></h3>';\\n        h += aoVivo.length ? '<div class=\\\"kx-grid\\\">' + aoVivo.map((t) => cardFarm(c, t, abertos.get(t.slug), d.goals)).join('') + '</div>'\\n          : '<div class=\\\"kx-empty\\\">Nenhum canal oficial da Twitch ao vivo agora. Os pontos só sobem com a live aberta e o vídeo rodando.</div>';\\n        if (outros.length) h += '<h3 class=\\\"kx-h\\\">Offline <small>clique para ativar: o PokeLink farma quando o canal entrar ao vivo</small></h3><div class=\\\"kx-minis\\\">' + outros.map((t) => cardOutro(c, t)).join('') + '</div>';\\n      }\\n      if (d.removidos && d.removidos.length) {\\n        h += '<h3 class=\\\"kx-h\\\">Removidos da lista <small>clique para trazer de volta</small></h3><div class=\\\"kx-minis\\\">' +\\n          d.removidos.map((r) => '<button class=\\\"kx-mini rmv\\\" data-back=\\\"twitch|' + esc(r.slug) + '\\\"><span class=\\\"dot\\\"></span><span class=\\\"nm\\\">' + esc(r.slug) + '</span><b>' + (r.como === 'auto' ? 'automático' : 'você tirou') + '</b></button>').join('') + '</div>';\\n      }\\n      h += '<div class=\\\"kx-foot\\\">A Twitch dá 10 pontos a cada 5 minutos de vídeo (cerca de 120/h por canal) e mais 50 a cada baú de bônus, que o PokeLink clica sozinho (' + fmt(d.bau || 0) + ' ate agora). ' +\\n        'Só conta com o vídeo rodando, e só em até 2 canais ao mesmo tempo. Cada resgate vale 1 hora e as horas se somam até 3x. ' +\\n        'Segure Shift e clique em Resgatar para gastar de uma vez tudo o que o saldo do canal der. ' +\\n        'Atualiza sozinho a cada ' + d.poll + 's.</div>';\\n      body.innerHTML = h;\\n      tabs.querySelectorAll('[data-tab]').forEach((b2) => { b2.onclick = () => { conta = Number(b2.dataset.tab); draw(last); }; });\\n      root.querySelectorAll('[data-ton]').forEach((b2) => { b2.onclick = () => window.api.setLives(Number(b2.dataset.ton), 'twitch', true); });\\n      root.querySelectorAll('[data-toff]').forEach((b2) => { b2.onchange = () => window.api.setLives(Number(b2.dataset.toff), 'twitch', b2.checked); });\\n      root.querySelectorAll('[data-sel]').forEach((b2) => { const a = b2.dataset.sel.split('|'); b2.onclick = () => window.api.twitchSel(Number(a[0]), a[1]); });\\n      root.querySelectorAll('[data-rm]').forEach((b2) => { const a = b2.dataset.rm.split('|'); b2.onclick = (ev) => { ev.stopPropagation(); window.api.canalRemover(a[0], a[1]); }; });\\n      root.querySelectorAll('[data-back]').forEach((b2) => { const a = b2.dataset.back.split('|'); b2.onclick = () => window.api.canalVoltar(a[0], a[1]); });\\n      // clique normal: 1 resgate (o melhor pacote que couber). Shift + clique: resgata TUDO o que o saldo\\n      // daquele canal der, um atrás do outro, com uma confirmação antes.\\n      root.querySelectorAll('[data-live]').forEach((b2) => {\\n        const a = b2.dataset.live.split('|');\\n        b2.title = 'Resgatar o melhor pacote que o saldo deste canal der.\\\\nSegure Shift e clique para resgatar TUDO o que couber de uma vez.';\\n        b2.onclick = (ev) => window.api.twitchRedeemLive(Number(a[0]), a[1], !!(ev && ev.shiftKey));\\n      });\\n      const nb = document.getElementById('twNow');\\n      nb.disabled = ocupado;\\n      nb.onclick = async () => {\\n        if (ocupado) return;\\n        ocupado = true; nb.disabled = true; nb.textContent = 'Atualizando...';\\n        let r = null;\\n        try { r = await window.api.twitchRefresh(); } finally { ocupado = false; }\\n        draw(r || last);\\n      };\\n      document.getElementById('twAvisos').onchange = (ev) => window.api.twitchAvisos(ev.target.checked);\\n      const ar = document.getElementById('twAuto');\\n      if (ar) ar.onchange = (ev) => { if (last) last.autoResgate = ev.target.checked; window.api.twitchAutoResgate(ev.target.checked); };\\n      const pk = document.getElementById('twPack');\\n      if (pk) pk.onchange = (ev) => { if (last) last.pacotes = ev.target.checked; window.api.twitchPacotes(ev.target.checked); };\\n      root.querySelectorAll('[data-max]').forEach((b2) => {\\n        b2.onclick = () => { if (last) last.max = Number(b2.dataset.max); window.api.twitchMax(Number(b2.dataset.max)); draw(last); };\\n      });\\n      root.querySelectorAll('[data-tier]').forEach((b2) => {\\n        b2.onchange = () => {\\n          if (last && last.resgateTiers) last.resgateTiers[b2.dataset.tier] = b2.checked;\\n          window.api.twitchResgateTier(b2.dataset.tier, b2.checked);\\n        };\\n      });\\n      document.getElementById('twDiag').onclick = async () => {\\n        const f = await window.api.twitchDiag();\\n        alert(f ? 'Diagnóstico salvo em:\\\\n' + f : 'Não consegui gerar o diagnóstico. Confira se há alguma live da Twitch aberta agora.');\\n      };\\n    }\\n    let seqN = 0;\\n    const refresh = async () => {\\n      const seq = ++seqN;\\n      const d = await window.api.twitchGet().catch(() => last);\\n      if (seq === seqN) draw(d);\\n    };\\n    window.api.onTwitchUpdate(() => { if (!root.hidden) refresh(); });\\n    setInterval(() => { if (last && !root.hidden) draw(last); }, 15000);\\n    refresh();\\n  }\\n\\n  /* ------------------------- análise de PvP ------------------------- */\\n  const TYPE_COLOR = { NORMAL: '#9a9a78', FIRE: '#e8742a', WATER: '#4a82e8', GRASS: '#4caa3c', ELECTRIC: '#d8b416', ICE: '#58c4c8', FIGHTING: '#b82e26',\\n    POISON: '#94389a', GROUND: '#c8a24c', FLYING: '#8c78e0', PSYCHIC: '#e8487c', BUG: '#8ca01c', ROCK: '#a8902e', GHOST: '#5e4a8c',\\n    DRAGON: '#5a2ef0', DARK: '#5a4638', STEEL: '#8c8ca8', FAIRY: '#e07aa8' };\\n  function initPvp() {\\n    document.body.classList.add('pvp');\\n    document.title = 'PvP — PokeLink';\\n    app.hidden = true;\\n    const root = document.getElementById('pvp');\\n    root.hidden = false;\\n    let conta = Number.isInteger(I) ? I : 0;\\n    let aba = 'resumo', per = 'semana', dados = null, carregando = false;\\n    const esc = (t) => String(t == null ? '' : t).replace(/[&<>\\\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;' }[c]));\\n    const curto = (n) => { n = Number(n) || 0; const a = Math.abs(n);\\n      return a >= 1e9 ? (n / 1e9).toFixed(1).replace('.', ',') + 'B' : a >= 1e6 ? (n / 1e6).toFixed(1).replace('.', ',') + 'M' : a >= 1e3 ? (n / 1e3).toFixed(1).replace('.', ',') + 'k' : String(Math.round(n)); };\\n    const sinal = (v) => `<b class=\\\"${v > 0 ? 'pz-pos' : v < 0 ? 'pz-neg' : ''}\\\">${v > 0 ? '+' : ''}${Number(v).toLocaleString('pt-BR')}</b>`;\\n    const wl = (w, n) => `<div class=\\\"pz-wl\\\" title=\\\"${w} vitórias em ${n}\\\"><i style=\\\"width:${n ? (w / n) * 100 : 0}%\\\"></i></div>`;\\n    const quando = (t) => { const m = Math.round((Date.now() - t) / 60000); return m < 1 ? 'agora' : m < 60 ? `há ${m} min` : m < 1440 ? `há ${Math.round(m / 60)} h` : `há ${Math.round(m / 1440)} d`; };\\n    const ordem = (l) => `<div class=\\\"pz-ordem\\\">${l.map((n) => `<span>${esc(n)}</span>`).join('<i>→</i>')}</div>`;\\n    const PER = { hoje: 'Hoje', semana: '7 dias', tudo: 'Tudo' };\\n\\n    root.innerHTML = `<div class=\\\"ch\\\">${iconHtml(null)}<b>PvP</b><span>análise dos duelos</span></div><div class=\\\"pz\\\"><div class=\\\"mx\\\" id=\\\"pz\\\"></div></div>`;\\n    const pz = document.getElementById('pz');\\n\\n    async function load(force) {\\n      carregando = true; draw();\\n      const d = await window.api.pvpGet(conta, force);\\n      carregando = false; dados = d; draw();\\n    }\\n    window.api.onPvpAccount((i) => { conta = i; load(false); });\\n\\n    function topo() {\\n      const contas = (dados && dados.contas) || ['Conta 1', 'Conta 2', 'Conta 3', 'Conta 4'];\\n      return `<div class=\\\"pz-bar\\\">\\n        <div class=\\\"pz-contas\\\" role=\\\"tablist\\\">${contas.map((n, k) => `<button class=\\\"${k === conta ? 'on' : ''}\\\" data-conta=\\\"${k}\\\">${esc(n)}</button>`).join('')}</div>\\n        <span class=\\\"grow\\\"></span>\\n        <div class=\\\"pz-seg\\\" aria-label=\\\"Período\\\">${Object.entries(PER).map(([k, n]) => `<button class=\\\"${per === k ? 'on' : ''}\\\" data-per=\\\"${k}\\\">${n}</button>`).join('')}</div>\\n        <button class=\\\"mx-b gold\\\" data-atualizar=\\\"1\\\"${carregando ? ' disabled' : ''}>${carregando ? 'Lendo o tracker...' : 'Atualizar agora'}</button>\\n      </div>`;\\n    }\\n    function kpis(d, p) {\\n      const s = d.summary || {};\\n      const tw = (s.wins || 0), tl = (s.losses || 0);\\n      return `<div class=\\\"pz-kpis\\\">\\n        <section class=\\\"mx-frame mx-box\\\"><h3 class=\\\"hud\\\">PR · RANKING</h3>\\n          <div class=\\\"row\\\" style=\\\"display:flex;align-items:baseline;gap:10px\\\"><span class=\\\"pz-big hud\\\" style=\\\"color:var(--gold)\\\">${s.pr ? Number(s.pr).toLocaleString('pt-BR') : '—'}</span><span class=\\\"pz-sub\\\">${s.rank ? s.rank + 'º lugar' : ''}</span></div></section>\\n        <section class=\\\"mx-frame mx-box\\\"><h3 class=\\\"hud\\\">TEMPORADA</h3>\\n          <div style=\\\"display:flex;align-items:baseline;gap:10px\\\"><span class=\\\"pz-big hud\\\">${tw + tl ? Math.round((tw / (tw + tl)) * 100) + '%' : '—'}</span><span class=\\\"pz-sub\\\"><b class=\\\"pz-pos\\\">${tw}V</b> · <b class=\\\"pz-neg\\\">${tl}D</b></span></div>${wl(tw, tw + tl)}</section>\\n        <section class=\\\"mx-frame mx-box\\\"><h3 class=\\\"hud\\\">${PER[per].toUpperCase()} · ${p.n} PARTIDAS</h3>\\n          <div style=\\\"display:flex;align-items:baseline;gap:12px\\\"><span class=\\\"pz-big hud\\\">${p.n ? p.wr + '%' : '—'}</span><span class=\\\"pz-sub\\\">saldo de PR ${sinal(p.saldo)}</span></div>${wl(p.w, p.n)}</section>\\n        <section class=\\\"mx-frame mx-box\\\"><h3 class=\\\"hud\\\">ÚLTIMAS 20</h3>\\n          <div class=\\\"pz-ult\\\">${(d.ultimas || []).slice().reverse().map((m) => `<span class=\\\"${m.win ? 'v' : 'd'}\\\" title=\\\"${m.win ? 'Vitória' : 'Derrota'} contra ${esc(m.opp)} · ${m.delta > 0 ? '+' : ''}${m.delta} PR · ${esc(m.dur)} · ${quando(m.time)}\\\">${m.win ? 'V' : 'D'}</span>`).join('')}</div>\\n          <span class=\\\"pz-sub\\\">da mais antiga (esquerda) para a mais nova</span></section>\\n      </div>`;\\n    }\\n    const linhaAdv = (a, rival) => `<div class=\\\"pz-lin\\\"><div class=\\\"t\\\"><b>${esc(a.nome)}</b><span class=\\\"pz-sub\\\">${a.pr ? Number(a.pr).toLocaleString('pt-BR') + ' PR' : ''}</span>\\n        <span class=\\\"r\\\">${sinal(a.saldo)} <span class=\\\"pz-sub\\\">PR</span></span></div>\\n      <div style=\\\"display:flex;align-items:center;gap:10px\\\"><div style=\\\"flex:1\\\">${wl(a.w, a.n)}</div><span class=\\\"pz-sub\\\" style=\\\"flex:none\\\"><b class=\\\"pz-pos\\\">${a.w}V</b> <b class=\\\"pz-neg\\\">${a.l}D</b> · ${a.wr}%</span></div>\\n      ${rival && a.ameaca ? `<div class=\\\"d\\\">Maior ameaça: <b>${esc(a.ameaca.nome)}</b> · ${curto(a.ameaca.dano)} de dano por derrota</div>` : ''}\\n      ${rival && a.melhor ? `<div class=\\\"d\\\">Melhor time contra ele (${a.melhor.wr}% em ${a.melhor.n}):</div>${ordem(a.melhor.ordem)}` : ''}</div>`;\\n    const linhaAb = (x) => `<div class=\\\"pz-lin\\\"><div class=\\\"t\\\">${ordem(x.ordem)}<span class=\\\"r\\\">${sinal(x.porPartida)} <span class=\\\"pz-sub\\\">PR/partida</span></span></div>\\n      <div style=\\\"display:flex;align-items:center;gap:10px\\\"><div style=\\\"flex:1\\\">${wl(x.w, x.n)}</div><span class=\\\"pz-sub\\\" style=\\\"flex:none\\\">${x.wr}% em ${x.n} · saldo ${sinal(x.saldo)}</span></div></div>`;\\n    const linhaAmeaca = (c) => `<div class=\\\"pz-lin\\\"><div class=\\\"t\\\"><b>${esc(c.nome)}</b><span class=\\\"r pz-neg\\\">${String(c.abates).replace('.', ',')} abates/partida</span></div>\\n      <div class=\\\"d\\\">Aparece em <b>${c.n}</b> partidas · ${curto(c.dano)} de dano por partida · você vence <b>${c.wr}%</b></div>\\n      ${c.melhor ? `<div class=\\\"d\\\">Quem mais derruba quando ele aparece: <b>${esc(c.melhor.nome)}</b> (${String(c.melhor.abates).replace('.', ',')} abates/partida)</div>` : ''}</div>`;\\n    const vazio = (t) => `<div class=\\\"pz-nota\\\">${t}</div>`;\\n\\n    function resumo(p) {\\n      return `<div class=\\\"pz-grid2\\\">\\n        <section class=\\\"pz-card\\\"><h3 class=\\\"hud\\\">⚔ RIVAIS <span>quem mais te custa PR</span><a data-ir=\\\"adv\\\">ver todos →</a></h3>\\n          ${p.rivais.slice(0, 4).map((a) => linhaAdv(a, true)).join('') || vazio('Nenhum adversário tirou PR de você neste período.')}</section>\\n        <section class=\\\"pz-card\\\"><h3 class=\\\"hud\\\">⇅ ABERTURAS <span>1º e 2º pokémon que mais dão PR</span><a data-ir=\\\"time\\\">ver time →</a></h3>\\n          ${p.times.slice(0, 4).map(linhaAb).join('') || vazio('Ainda não há partidas suficientes para comparar aberturas.')}</section>\\n        <section class=\\\"pz-card\\\"><h3 class=\\\"hud\\\">★ PRESAS <span>de quem você mais ganha PR</span><a data-ir=\\\"adv\\\">ver todos →</a></h3>\\n          ${p.presas.slice(0, 4).map((a) => linhaAdv(a, false)).join('') || vazio('Nenhuma presa neste período.')}</section>\\n        <section class=\\\"pz-card\\\"><h3 class=\\\"hud\\\">🛡 AMEAÇAS <span>quem mais derruba seu time</span><a data-ir=\\\"counters\\\">ver todas →</a></h3>\\n          ${p.counters.slice(0, 4).map(linhaAmeaca).join('') || vazio('Ainda não há partidas suficientes.')}</section>\\n      </div>`;\\n    }\\n    function adversarios(p) {\\n      const lista = [...p.rivais.map((a) => Object.assign({ rival: true }, a)), ...p.presas].sort((a, b) => b.n - a.n);\\n      if (!lista.length) return vazio('Sem adversários frequentes neste período.');\\n      return `<section class=\\\"pz-card\\\"><h3 class=\\\"hud\\\">ADVERSÁRIOS FREQUENTES <span>${lista.length} · ordenados por partidas</span></h3>\\n        <div style=\\\"overflow:auto\\\"><table class=\\\"pz-tab\\\"><thead><tr><th>Adversário</th><th class=\\\"n\\\">PR dele</th><th class=\\\"n\\\">Partidas</th><th>Vitórias</th><th class=\\\"n\\\">Saldo de PR</th><th>Maior ameaça</th><th>Melhor time contra</th></tr></thead><tbody>\\n        ${lista.map((a) => `<tr><td><b>${esc(a.nome)}</b><div class=\\\"pz-sub\\\">${a.ult ? quando(a.ult) : ''}</div></td><td class=\\\"n\\\">${a.pr ? Number(a.pr).toLocaleString('pt-BR') : '—'}</td><td class=\\\"n\\\">${a.n}</td>\\n          <td><div class=\\\"pz-mini\\\">${wl(a.w, a.n)}</div><span class=\\\"pz-sub\\\">${a.wr}% · ${a.w}V ${a.l}D</span></td><td class=\\\"n\\\">${sinal(a.saldo)}</td>\\n          <td>${a.ameaca ? `${esc(a.ameaca.nome)}<div class=\\\"pz-sub\\\">${curto(a.ameaca.dano)} por derrota</div>` : '<span class=\\\"pz-sub\\\">—</span>'}</td>\\n          <td>${a.melhor ? `${ordem(a.melhor.ordem.slice(0, 3))}<div class=\\\"pz-sub\\\">${a.melhor.wr}% em ${a.melhor.n}</div>` : '<span class=\\\"pz-sub\\\">—</span>'}</td></tr>`).join('')}\\n        </tbody></table></div></section>`;\\n    }\\n    function seuTime(p) {\\n      return `<section class=\\\"pz-card\\\"><h3 class=\\\"hud\\\">⇅ ABERTURAS <span>1º e 2º pokémon · ordenadas por PR ganho por partida</span></h3>\\n          ${p.times.map(linhaAb).join('') || vazio('Ainda não há partidas suficientes.')}\\n          <div class=\\\"pz-nota\\\">Por que só a abertura? Nas vitórias rápidas o tracker mostra só os pokémon que chegaram a lutar, então o time inteiro não dá para comparar com justiça. O 1º e o 2º aparecem sempre.</div></section>\\n        <div class=\\\"pz-mons\\\">${p.mons.map((m) => `<article class=\\\"pz-mon\\\"><div class=\\\"h\\\"><b>${esc(m.nome)}</b><span class=\\\"pz-sub\\\">${m.n} partidas</span></div>\\n          <div><div style=\\\"display:flex;justify-content:space-between\\\" class=\\\"pz-sub\\\"><span>Parte do dano do time</span><b style=\\\"color:var(--gold)\\\">${m.parte}%</b></div><div class=\\\"parte\\\"><i style=\\\"width:${Math.min(100, m.parte)}%\\\"></i></div></div>\\n          <div class=\\\"mx-stats\\\" style=\\\"grid-template-columns:repeat(2,minmax(0,1fr))\\\">\\n            <div><small>Dano/partida</small><b>${curto(m.dano)}</b><em>recebe ${curto(m.recebido)}</em></div>\\n            <div><small>Abates/partida</small><b>${String(m.abates).replace('.', ',')}</b><em>&nbsp;</em></div>\\n            <div><small>De pé nas vitórias</small><b>${m.vivo}%</b><em>não caiu</em></div>\\n            <div><small>Abrindo o time</small><b>${m.lead ? m.leadWr + '%' : '—'}</b><em>${m.lead ? m.lead + ' partidas' : 'nunca abriu'}</em></div>\\n          </div></article>`).join('') || vazio('Ainda não há partidas com o time registrado.')}</div>`;\\n    }\\n    function ameacas(p, d) {\\n      const tc = (d.temporada && d.temporada.counters) || [];\\n      return `<div class=\\\"pz-grid2\\\"><section class=\\\"pz-card\\\"><h3 class=\\\"hud\\\">🛡 AMEAÇAS <span>pokémon que mais derrubam o seu time</span></h3>\\n          ${p.counters.map(linhaAmeaca).join('') || vazio('Ainda não há partidas suficientes.')}</section>\\n        <section class=\\\"pz-card\\\"><h3 class=\\\"hud\\\">MAIORES COUNTERS DA TEMPORADA <span>segundo o tracker do jogo</span></h3>\\n          ${tc.map((c) => `<div class=\\\"pz-lin\\\"><div class=\\\"t\\\"><b>${esc(c.name)}</b><span class=\\\"r\\\">você vence <b class=\\\"${c.wr < 40 ? 'pz-neg' : ''}\\\">${c.wr}%</b></span></div>\\n            <div style=\\\"display:flex;align-items:center;gap:10px\\\"><div style=\\\"flex:1\\\">${wl(c.wr, 100)}</div><span class=\\\"pz-sub\\\">${c.games} partidas</span></div></div>`).join('') || vazio('O tracker não mostrou counters.')}</section></div>`;\\n    }\\n\\n    function draw() {\\n      const d = dados;\\n      let corpo;\\n      if (!d) corpo = `<div class=\\\"pz-msg\\\">${carregando ? 'Lendo o tracker...' : 'Carregando...'}</div>`;\\n      else if (d.erro) corpo = `<div class=\\\"pz-msg\\\">${esc(d.erro)}</div>`;\\n      else {\\n        const p = (d.periodos && d.periodos[per]) || { n: 0, w: 0, l: 0, wr: 0, saldo: 0, times: [], rivais: [], presas: [], mons: [], counters: [] };\\n        const ABAS = [['resumo', 'Resumo'], ['adv', 'Adversários'], ['time', 'Seu time'], ['counters', 'Ameaças']];\\n        corpo = `${kpis(d, p)}\\n          <nav class=\\\"pz-abas\\\">${ABAS.map(([k, n]) => `<button class=\\\"${aba === k ? 'on' : ''}\\\" data-aba=\\\"${k}\\\">${n}</button>`).join('')}</nav>\\n          ${aba === 'adv' ? adversarios(p) : aba === 'time' ? seuTime(p) : aba === 'counters' ? ameacas(p, d) : resumo(p)}\\n          <div class=\\\"pz-nota\\\">${d.total.toLocaleString('pt-BR')} partidas guardadas${d.desde ? ' desde ' + new Date(d.desde).toLocaleDateString('pt-BR') : ''} · tracker lido ${d.updated ? quando(d.updated) : '—'}. O PokeLink guarda cada partida nova a cada 15 minutos.</div>`;\\n      }\\n      pz.innerHTML = topo() + corpo;\\n      pz.querySelectorAll('[data-conta]').forEach((b) => { b.onclick = () => { conta = Number(b.dataset.conta); dados = Object.assign({}, dados || {}, { periodos: null, erro: null }); load(false); }; });\\n      pz.querySelectorAll('[data-per]').forEach((b) => { b.onclick = () => { per = b.dataset.per; draw(); }; });\\n      pz.querySelectorAll('[data-aba]').forEach((b) => { b.onclick = () => { aba = b.dataset.aba; draw(); }; });\\n      pz.querySelectorAll('[data-ir]').forEach((b) => { b.onclick = () => { aba = b.dataset.ir; draw(); }; });\\n      const at = pz.querySelector('[data-atualizar]'); if (at) at.onclick = () => load(true);\\n    }\\n    load(false);\\n  }\\n\\n  /* ------------------------ barra de título ------------------------ */\\n  // ícone do PokeLink: esfera com um elo de corrente (o \\\"Link\\\" do nome)\\n  const POKEBALL = '<svg viewBox=\\\"0 0 36 36\\\"><defs><linearGradient id=\\\"pkTop\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"0\\\" y2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#b2f08c\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#494951\\\"/></linearGradient></defs><circle cx=\\\"18\\\" cy=\\\"18\\\" r=\\\"15.5\\\" fill=\\\"#eeeeef\\\" stroke=\\\"#19191b\\\" stroke-width=\\\"2.6\\\"/><path d=\\\"M2.5 18a15.5 15.5 0 0 1 31 0z\\\" fill=\\\"url(#pkTop)\\\"/><path d=\\\"M2.5 18H33.5\\\" stroke=\\\"#19191b\\\" stroke-width=\\\"2.6\\\"/><circle cx=\\\"18\\\" cy=\\\"18\\\" r=\\\"15.5\\\" fill=\\\"none\\\" stroke=\\\"#19191b\\\" stroke-width=\\\"2.6\\\"/><ellipse cx=\\\"11.5\\\" cy=\\\"9.5\\\" rx=\\\"4\\\" ry=\\\"2.2\\\" fill=\\\"#fff\\\" opacity=\\\".35\\\" transform=\\\"rotate(-30 11.5 9.5)\\\"/><g fill=\\\"none\\\" stroke-linecap=\\\"round\\\"><rect x=\\\"8.4\\\" y=\\\"14.2\\\" width=\\\"11\\\" height=\\\"7.6\\\" rx=\\\"3.8\\\" stroke=\\\"#19191b\\\" stroke-width=\\\"5\\\"/><rect x=\\\"16.6\\\" y=\\\"14.2\\\" width=\\\"11\\\" height=\\\"7.6\\\" rx=\\\"3.8\\\" stroke=\\\"#19191b\\\" stroke-width=\\\"5\\\"/><rect x=\\\"8.4\\\" y=\\\"14.2\\\" width=\\\"11\\\" height=\\\"7.6\\\" rx=\\\"3.8\\\" stroke=\\\"#96f75a\\\" stroke-width=\\\"2.2\\\"/><rect x=\\\"16.6\\\" y=\\\"14.2\\\" width=\\\"11\\\" height=\\\"7.6\\\" rx=\\\"3.8\\\" stroke=\\\"#96f75a\\\" stroke-width=\\\"2.2\\\"/><path d=\\\"M15.6 14.2a3.8 3.8 0 0 1 3.8 3.8\\\" stroke=\\\"#19191b\\\" stroke-width=\\\"5\\\"/><path d=\\\"M15.6 14.2a3.8 3.8 0 0 1 3.8 3.8\\\" stroke=\\\"#96f75a\\\" stroke-width=\\\"2.2\\\"/></g></svg>';\\n\\n  // usa a imagem escolhida pelo usuário, se existir; senão o ícone padrão\\n  function iconHtml(url) {\\n    if (!url) return POKEBALL;\\n    const img = document.createElement('img');\\n    img.className = 'appico';\\n    img.alt = '';\\n    img.src = url;\\n    return img.outerHTML;\\n  }\\n\\n  // ícones dos menus da barra de cima\\n  const MENU_ICO = {\\n    'Telas': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\"><rect x=\\\"1.5\\\" y=\\\"1.5\\\" width=\\\"5.5\\\" height=\\\"5.5\\\" rx=\\\"1.2\\\"/><rect x=\\\"9\\\" y=\\\"1.5\\\" width=\\\"5.5\\\" height=\\\"5.5\\\" rx=\\\"1.2\\\"/><rect x=\\\"1.5\\\" y=\\\"9\\\" width=\\\"5.5\\\" height=\\\"5.5\\\" rx=\\\"1.2\\\"/><rect x=\\\"9\\\" y=\\\"9\\\" width=\\\"5.5\\\" height=\\\"5.5\\\" rx=\\\"1.2\\\"/></svg>',\\n    'Desempenho': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"><path d=\\\"M2.5 12a5.5 5.5 0 1 1 11 0\\\"/><path d=\\\"M8 12l3-4\\\"/><circle cx=\\\"8\\\" cy=\\\"12\\\" r=\\\".8\\\" fill=\\\"currentColor\\\"/></svg>',\\n    'Contas': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"><circle cx=\\\"6\\\" cy=\\\"5\\\" r=\\\"2.6\\\"/><path d=\\\"M1.5 14c0-2.6 2-4.3 4.5-4.3s4.5 1.7 4.5 4.3\\\"/><path d=\\\"M10.5 2.6a2.5 2.5 0 0 1 0 4.8M12 9.9c1.6.5 2.6 1.9 2.6 4.1\\\"/></svg>',\\n    'Auto Compra': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"M1.5 2h2l1.6 8h7.4l1.5-5.5H4.3\\\"/><circle cx=\\\"6.2\\\" cy=\\\"13.2\\\" r=\\\"1.1\\\"/><circle cx=\\\"11.6\\\" cy=\\\"13.2\\\" r=\\\"1.1\\\"/></svg>',\\n    'Lives': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linejoin=\\\"round\\\"><rect x=\\\"1.5\\\" y=\\\"3.5\\\" width=\\\"13\\\" height=\\\"9.5\\\" rx=\\\"2\\\"/><path d=\\\"M6.6 6.2v4.2l3.6-2.1z\\\" fill=\\\"currentColor\\\"/></svg>',\\n    'PvP': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"><path d=\\\"M2 2l7.5 7.5M14 2L6.5 9.5M4 12l-2 2M12 12l2 2M3.2 10.8l2 2M12.8 10.8l-2 2\\\"/></svg>',\\n    'Atualizações': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"M8 2v8M4.8 7L8 10.2 11.2 7M2.5 12.5v1h11v-1\\\"/></svg>',\\n    'Ajuda': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"6.3\\\"/><path d=\\\"M6.2 6.2a1.9 1.9 0 0 1 3.6.6c0 1.3-1.8 1.6-1.8 2.8\\\"/><circle cx=\\\"8\\\" cy=\\\"11.6\\\" r=\\\".4\\\" fill=\\\"currentColor\\\"/></svg>',\\n    'Desenvolvedor': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"M5.5 4L1.8 8l3.7 4M10.5 4l3.7 4-3.7 4\\\"/></svg>',\\n  };\\n\\n  function initTitle() {\\n    document.body.classList.add('title');\\n    app.hidden = true;\\n    const tb = document.getElementById('tb');\\n    tb.hidden = false;\\n\\n    let MENUS = [];\\n    let openIdx = -1;     // menu de cima aberto (-1 = nenhum)\\n    let panels = [];      // painéis abertos: [0] = principal, [1] = submenu, ...\\n\\n    const closePanels = (fromDepth) => {\\n      panels.splice(fromDepth).forEach((p) => p.remove());\\n      const keep = panels[fromDepth - 1];\\n      if (keep) keep.querySelectorAll('.sub-open').forEach((x) => x.classList.remove('sub-open'));\\n    };\\n    const closeAll = () => {\\n      if (openIdx === -1) return;\\n      openIdx = -1;\\n      closePanels(0);\\n      const sh = document.getElementById('shade');\\n      if (sh) sh.remove();\\n      tb.querySelectorAll('.mbtn.open').forEach((b) => b.classList.remove('open'));\\n      window.api.titleOpen(false);\\n    };\\n\\n    // desenha um painel com os itens; \\\"path\\\" = índices até este nível\\n    function showPanel(items, path, x, y, depth, alignRightOf) {\\n      closePanels(depth);\\n      const p = el('div', 'dd');\\n      items.forEach((it, n) => {\\n        if (!it.visible) return;\\n        if (it.type === 'separator') { p.appendChild(el('div', 'hr')); return; }\\n        const b = el('button', 'it');\\n        if (!it.enabled) b.disabled = true;\\n        b.innerHTML = '<span class=\\\"ck\\\"></span><span class=\\\"lb\\\"></span><span class=\\\"ac\\\"></span><span class=\\\"ar\\\"></span>';\\n        b.querySelector('.lb').textContent = it.label;\\n        if (it.ico) { const ck = b.querySelector('.ck'); ck.innerHTML = it.ico; ck.classList.add('ico'); }\\n        if ((it.type === 'checkbox' || it.type === 'radio') && it.checked) b.querySelector('.ck').textContent = it.type === 'radio' ? '●' : '✓';\\n        b.querySelector('.ac').textContent = it.accel || '';\\n        if (it.submenu) {\\n          b.querySelector('.ar').textContent = '▶';\\n          const openSub = () => {\\n            if (b.classList.contains('sub-open')) return;\\n            closePanels(depth + 1);\\n            b.classList.add('sub-open');\\n            const r = b.getBoundingClientRect();\\n            const sp = showPanel(it.submenu, path.concat(n), r.right + 4, r.top - 6, depth + 1, r.left - 4);\\n            if (p._left) { // menu aberto pela engrenagem (canto direito): todos os níveis continuam abrindo para a ESQUERDA\\n              sp._left = true;\\n              sp._want.x = r.left - 4 - sp.getBoundingClientRect().width;\\n              fit(sp);\\n            }\\n          };\\n          b.onmouseenter = openSub;\\n          b.onclick = openSub;\\n        } else {\\n          b.onmouseenter = () => closePanels(depth + 1);\\n          b.onclick = () => { closeAll(); window.api.titleClick(path.concat(n)); };\\n        }\\n        p.appendChild(b);\\n      });\\n      document.body.appendChild(p);\\n      p._want = { x, y, alignRightOf };\\n      fit(p);\\n      panels[depth] = p;\\n      return p;\\n    }\\n\\n    // não deixa o painel sair da janela (refeito quando a barra termina de crescer)\\n    function fit(p) {\\n      let { x, y, alignRightOf } = p._want;\\n      const r = p.getBoundingClientRect();\\n      if (x + r.width > innerWidth - 4) x = alignRightOf != null ? alignRightOf - r.width : innerWidth - r.width - 4;\\n      if (innerHeight > 100 && y + r.height > innerHeight - 4) y = Math.max(38, innerHeight - r.height - 4);\\n      p.style.left = Math.max(4, x) + 'px';\\n      p.style.top = y + 'px';\\n    }\\n    window.addEventListener('resize', () => panels.forEach(fit));\\n\\n    // engrenagem da barra de baixo: as categorias do menu viram uma lista que abre PARA CIMA, com os submenus ao lado\\n    function abrirEngrenagem(g) {\\n      if (!MENUS.length) { window.api.titleOpen(false); return; }\\n      closeAll();\\n      openIdx = 0; // marca \\\"menu aberto\\\" (o closeAll só age se houver algo aberto)\\n      const sh = el('div', null, null, null, closeAll);\\n      sh.id = 'shade';\\n      document.body.appendChild(sh);\\n      window.api.titleOpen(true);\\n      const raiz = MENUS.map((m) => ({ label: m.label, type: 'normal', visible: m.visible !== false, enabled: true, accel: '', submenu: m.submenu || [], ico: MENU_ICO[m.label] || '' }));\\n      const p = showPanel(raiz, [], g.x, g.up, 0, null);\\n      p.classList.add('gear');\\n      p._left = true;\\n      const h = p.getBoundingClientRect().height;\\n      p._want.y = g.up - h - 8; // a base do painel fica logo acima da barra de baixo\\n      fit(p);\\n    }\\n\\n    function openTop(idx, btn) {\\n      if (openIdx === idx) return;\\n      const first = openIdx === -1;\\n      tb.querySelectorAll('.mbtn.open').forEach((b) => b.classList.remove('open'));\\n      openIdx = idx;\\n      btn.classList.add('open');\\n      if (first) {\\n        const sh = el('div', null, null, null, closeAll);\\n        sh.id = 'shade';\\n        document.body.appendChild(sh);\\n        window.api.titleOpen(true); // a barra cresce (transparente) para caber o menu\\n      }\\n      const r = btn.getBoundingClientRect();\\n      showPanel(MENUS[idx].submenu || [], [idx], r.left, r.bottom + 3, 0, null);\\n    }\\n\\n    // ---------- pop-ups ----------\\n    const dlgQueue = [];\\n    let dlgCur = null;\\n    function showDialog(d) {\\n      dlgQueue.push(d);\\n      if (!dlgCur) nextDialog();\\n    }\\n    function nextDialog() {\\n      const old = document.getElementById('dlgShade');\\n      if (old) old.remove();\\n      dlgCur = dlgQueue.shift() || null;\\n      if (!dlgCur) return;\\n      closeAll(); // fecha menus abertos\\n      const d = dlgCur;\\n      const ICON = { info: 'i', warning: '!', error: '✕', question: '?' };\\n      const shade = el('div');\\n      shade.id = 'dlgShade';\\n      const box = el('div', 'dlg' + (d.about ? ' is-about' : ''));\\n      box.setAttribute('role', 'dialog');\\n      box.setAttribute('aria-modal', 'true');\\n      box.innerHTML = '<div class=\\\"hd\\\"><span class=\\\"t\\\"></span><button class=\\\"x\\\" title=\\\"Fechar\\\">×</button></div>' +\\n        (d.about ? '<div class=\\\"about\\\">' + iconHtml(d.about.icon) + '<span class=\\\"nm\\\"></span><span class=\\\"ver\\\"></span></div>' : '') +\\n        '<div class=\\\"bd\\\">' + (d.about ? '' : '<span class=\\\"ico\\\"></span>') +\\n        '<div><p class=\\\"msg\\\"></p><p class=\\\"det\\\"></p><div class=\\\"note\\\"><span class=\\\"ni\\\">!</span><span class=\\\"nt\\\"></span></div><p class=\\\"foot\\\"></p></div></div>' +\\n        '<div class=\\\"ft\\\"></div>';\\n      box.querySelector('.t').textContent = d.title;\\n      if (d.about) {\\n        box.querySelector('.nm').textContent = d.about.name;\\n        box.querySelector('.ver').textContent = d.about.channel ? `${d.about.channel} ${d.about.version}` : `v${d.about.version}`;\\n      } else {\\n        const ic = box.querySelector('.ico');\\n        ic.classList.add(d.type);\\n        ic.textContent = ICON[d.type] || 'i';\\n      }\\n      box.querySelector('.msg').textContent = d.message;\\n      box.querySelector('.det').textContent = d.detail;\\n      if ((d.detail || '').length > 900) { box.querySelector('.det').classList.add('long'); box.classList.add('wide'); } // texto longo (ex.: termos): rola dentro de uma caixa\\n      if (d.form && d.form.length) {\\n        const fm = el('div', 'dform');\\n        let grid = null;\\n        d.form.forEach((f) => {\\n          if (f.section) {\\n            fm.appendChild(el('div', 'fsec')).textContent = f.section;\\n            grid = fm.appendChild(el('div', 'fgrid'));\\n            return;\\n          }\\n          if (!grid) grid = fm.appendChild(el('div', 'fgrid'));\\n          const row = el('label', 'frow' + (f.type === 'check' ? ' fchk' : ''));\\n          const txt = el('span', 'ftx');\\n          txt.appendChild(el('b')).textContent = f.label;\\n          if (f.hint) txt.appendChild(el('small')).textContent = f.hint;\\n          let ctl;\\n          if (f.type === 'check') {\\n            ctl = document.createElement('input'); ctl.type = 'checkbox'; ctl.className = 'sw'; ctl.checked = !!f.value;\\n            row.append(ctl, txt);\\n          } else if (f.type === 'textarea') {\\n            row.classList.add('fta');\\n            ctl = document.createElement('textarea'); ctl.value = f.value || ''; ctl.rows = 6; ctl.spellcheck = false;\\n            row.append(txt, ctl);\\n          } else if (f.type === 'select') {\\n            ctl = document.createElement('select');\\n            (f.options || []).forEach((o) => { const op = document.createElement('option'); op.textContent = o; op.value = o; ctl.appendChild(op); });\\n            ctl.value = f.value;\\n            row.append(txt, ctl);\\n          } else {\\n            ctl = document.createElement('input'); ctl.inputMode = 'decimal'; ctl.value = f.value == null ? '' : String(f.value).replace('.', ',');\\n            row.append(txt, ctl);\\n          }\\n          ctl.dataset.id = f.id;\\n          grid.appendChild(row);\\n        });\\n        box.querySelector('.det').after(fm);\\n        box.classList.add('wide');\\n      }\\n      if (d.lives) {\\n        const L = d.lives;\\n        const wrap = el('div', 'lv');\\n        const grid = wrap.appendChild(el('div', 'lv-grid'));\\n        L.contas.forEach((c) => {\\n          const card = grid.appendChild(el('div', 'lv-acc'));\\n          card.appendChild(el('b', 'lv-nm')).textContent = c.name;\\n          c.plats.forEach((pl) => {\\n            const row = card.appendChild(el('div', 'lv-row ' + pl.p));\\n            const head = row.appendChild(el('div', 'lv-h'));\\n            head.appendChild(el('span', 'lv-pf')).textContent = pl.name;\\n            head.appendChild(el('span', 'lv-st ' + (pl.on ? 'on' : 'off'))).textContent = pl.on ? (pl.open.length + (pl.open.length === 1 ? ' live' : ' lives')) : 'desligada';\\n            if (pl.on) {\\n              const chips = row.appendChild(el('div', 'lv-chips'));\\n              if (!pl.open.length) chips.appendChild(el('span', 'lv-none')).textContent = 'nenhum canal ao vivo agora';\\n              pl.open.forEach((ch) => {\\n                const b = chips.appendChild(el('button', 'lv-chip', null, 'Abrir esta live com a conta ' + c.name));\\n                b.textContent = ch;\\n                b.onclick = () => window.api.openLivePage(c.i, pl.p, ch);\\n              });\\n            }\\n          });\\n        });\\n        const ao = wrap.appendChild(el('div', 'lv-now'));\\n        ao.appendChild(el('b')).textContent = 'Ao vivo agora';\\n        L.aoVivo.forEach((pl) => {\\n          const r = ao.appendChild(el('div', 'lv-row ' + pl.p));\\n          r.appendChild(el('span', 'lv-pf')).textContent = pl.name;\\n          const chips = r.appendChild(el('div', 'lv-chips'));\\n          if (!pl.list.length) chips.appendChild(el('span', 'lv-none')).textContent = 'nenhum';\\n          pl.list.forEach((ch) => { chips.appendChild(el('span', 'lv-tag')).textContent = ch; });\\n        });\\n        wrap.appendChild(el('div', 'lv-foot')).textContent = L.quando\\n          ? `Última verificação: ${L.quando}` + (L.erros ? ` · ${L.erros} canal(is) não responderam` : '')\\n          : 'Ainda não verificado.';\\n        box.querySelector('.det').after(wrap);\\n        box.classList.add('wide');\\n      } else if (d.cards && d.cards.length) {\\n        const grid = el('div', 'rcards');\\n        d.cards.forEach((c, n) => {\\n          const card = el('div', 'rc r' + (n + 1));\\n          const top = el('div', 'rc-top');\\n          top.appendChild(el('span', 'rc-medal')).textContent = String(n + 1);\\n          top.appendChild(el('b', 'rc-title')).textContent = c.title;\\n          card.appendChild(top);\\n          const chips = el('div', 'rc-chips');\\n          (c.chips || []).forEach((t) => { chips.appendChild(el('span', 'rc-chip')).textContent = t; });\\n          card.appendChild(chips);\\n          const big = el('div', 'rc-big');\\n          big.appendChild(el('b')).textContent = c.big || '—';\\n          big.appendChild(el('span')).textContent = ' XP/h';\\n          card.appendChild(big);\\n          if (c.bigSub) card.appendChild(el('div', 'rc-sub')).textContent = c.bigSub;\\n          const st = el('div', 'rc-stats');\\n          (c.stats || []).forEach(([k, v]) => {\\n            const row = el('div', 'rc-stat');\\n            row.appendChild(el('span')).textContent = k;\\n            row.appendChild(el('b')).textContent = v;\\n            st.appendChild(row);\\n          });\\n          card.appendChild(st);\\n          grid.appendChild(card);\\n        });\\n        box.querySelector('.det').after(grid);\\n        box.classList.add('wide');\\n      } else if (d.table && d.table.rows && d.table.rows.length) {\\n        const wrap = el('div', 'dtab');\\n        const tb = document.createElement('table');\\n        const thead = tb.createTHead().insertRow();\\n        ['#', ...d.table.head].forEach((h) => { const th = document.createElement('th'); th.textContent = h; thead.appendChild(th); });\\n        const body = tb.createTBody();\\n        d.table.rows.forEach((r, n) => {\\n          const tr = body.insertRow();\\n          [String(n + 1), ...r].forEach((c) => { tr.insertCell().textContent = c; });\\n        });\\n        wrap.appendChild(tb);\\n        box.querySelector('.det').after(wrap);\\n        box.classList.add('wide');\\n      }\\n      box.querySelector('.nt').textContent = d.note || '';\\n      box.querySelector('.foot').textContent = d.foot || '';\\n      if (!d.note) box.querySelector('.note').remove();\\n      if (!d.foot) box.querySelector('.foot').remove();\\n      if (!d.message) box.querySelector('.msg').remove();\\n      if (!d.detail) box.querySelector('.det').remove();\\n      const ft = box.querySelector('.ft');\\n      let focusBtn = null;\\n      d.buttons.forEach((label, n) => {\\n        const b = el('button', 'btn' + (n === d.defaultId ? ' go' : ''), null, null, () => answer(n));\\n        b.textContent = label;\\n        ft.appendChild(b);\\n        if (n === d.defaultId) focusBtn = b;\\n      });\\n      box.querySelector('.x').onclick = () => answer(cancelOf(d));\\n      shade.appendChild(box);\\n      document.body.appendChild(shade);\\n      (focusBtn || ft.querySelector('button')).focus();\\n    }\\n    // Esc / X = botão de cancelar (ou o último, como no Windows)\\n    const cancelOf = (d) => (d.cancelId != null ? d.cancelId : d.buttons.length > 1 ? d.buttons.length - 1 : 0);\\n    function answer(n) {\\n      if (!dlgCur) return;\\n      let values = null;\\n      const fm = document.querySelector('#dlgShade .dform');\\n      if (fm) {\\n        values = {};\\n        fm.querySelectorAll('[data-id]').forEach((c) => { values[c.dataset.id] = c.type === 'checkbox' ? c.checked : c.value; });\\n      }\\n      window.api.dialogReply(dlgCur.id, n, values);\\n      nextDialog();\\n    }\\n    window.api.onDialog(showDialog);\\n\\n    // ---------- Extensões: ligar/desligar, atualizar, reinstalar ----------\\n    let extsAberto = null;\\n    function fecharExts() {\\n      if (!extsAberto) return;\\n      const id = extsAberto;\\n      extsAberto = null;\\n      const p = document.getElementById('extsPanel'); if (p) p.remove();\\n      const sh = document.getElementById('extsShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    function drawExts(lst) {\\n      const p = document.getElementById('extsPanel');\\n      if (!p || !lst) return;\\n      p.querySelector('.lp-body').innerHTML = lst.map((e) => {\\n        const st = e.busy ? `<span class=\\\"ex-st busy\\\">${escL(e.busy)}...</span>`\\n          : !e.on ? '<span class=\\\"ex-st off\\\">desativada</span>'\\n          : e.error ? '<span class=\\\"ex-st err\\\">com erro</span>'\\n          : e.version ? '<span class=\\\"ex-st ok\\\">ativa</span>' : '<span class=\\\"ex-st off\\\">não instalada</span>';\\n        return `<div class=\\\"ex-card${e.on ? '' : ' off'}\\\">\\n          <div class=\\\"ex-h\\\"><span class=\\\"ex-ico\\\">${SVG.puzzle}</span>\\n            <div class=\\\"ex-t\\\"><b>${escL(e.nome)}</b><span>${e.version ? 'versão ' + escL(e.version) : 'sem versão instalada'}${e.autor ? ' · por ' + escL(e.autor) : ''}</span></div>\\n            ${st}<input type=\\\"checkbox\\\" class=\\\"sw\\\" ${e.on ? 'checked' : ''} ${e.busy ? 'disabled' : ''} data-ex=\\\"${escL(e.id)}\\\" title=\\\"${e.on ? 'Desativar' : 'Ativar'} nas 4 contas\\\"></div>\\n          <div class=\\\"ex-d\\\">${escL(e.sobre || '')}</div>\\n          ${e.error ? `<div class=\\\"ex-err\\\">Último erro: ${escL(e.error)}</div>` : ''}\\n          ${e.on && e.contas ? `<div class=\\\"ex-d\\\" style=\\\"display:flex;flex-wrap:wrap;gap:6px;align-items:center\\\">Nas contas:\\n            ${e.contas.map((c, i) => `<span class=\\\"kx-mini${c.ok ? '' : ' rmv'}\\\" style=\\\"height:26px;cursor:default\\\" title=\\\"${c.ok ? 'carregada' : 'NÃO carregada' + (c.erro ? ': ' + escL(c.erro) : '')}\\\"><span class=\\\"dot\\\" style=\\\"background:${c.ok ? '#7fe08a' : '#ff5d6c'}\\\"></span><span class=\\\"nm\\\">${escL(c.nome)}</span></span>`).join('')}</div>\\n          <div class=\\\"ex-d\\\" style=\\\"display:flex;flex-wrap:wrap;gap:6px;align-items:center\\\">Não funciona numa conta? Reparar só nela:\\n            ${e.contas.map((c, i) => `<button class=\\\"kx-btn small\\\" data-exa=\\\"${escL(e.id)}|reparar:${i}\\\" ${e.busy ? 'disabled' : ''} title=\\\"Tira e coloca de novo a extensão só nesta conta e apaga as configurações dela ali (o login do jogo continua)\\\">${i + 1}</button>`).join('')}</div>` : ''}\\n          <div class=\\\"ex-a\\\">\\n            <button class=\\\"kx-btn small\\\" data-exa=\\\"${escL(e.id)}|update\\\" ${e.busy ? 'disabled' : ''} title=\\\"Baixa a versão mais nova da Chrome Web Store\\\">Atualizar</button>\\n            <button class=\\\"kx-btn small\\\" data-exa=\\\"${escL(e.id)}|reinstall\\\" ${e.busy ? 'disabled' : ''} title=\\\"Apaga a cópia atual e baixa de novo do zero\\\">Reinstalar</button>\\n          </div>\\n        </div>`;\\n      }).join('');\\n      p.querySelectorAll('[data-ex]').forEach((x) => { x.onchange = () => window.api.extAction(x.dataset.ex, x.checked ? 'on' : 'off'); });\\n      p.querySelectorAll('[data-exa]').forEach((x) => { const [id, a] = x.dataset.exa.split('|'); x.onclick = () => window.api.extAction(id, a); });\\n    }\\n    if (window.api.onExtsPanel) window.api.onExtsPanel(async (d) => {\\n      closeAll();\\n      if (extsAberto) fecharExts();\\n      extsAberto = d.id;\\n      const sh = el('div'); sh.id = 'extsShade'; sh.onclick = () => fecharExts();\\n      document.body.appendChild(sh);\\n      const p = el('div', 'lp ex'); p.id = 'extsPanel';\\n      p.innerHTML = `<div class=\\\"ch\\\"><span class=\\\"lp-ico\\\">${SVG.puzzle}</span><b>Extensões</b><span>nas 4 contas</span><button class=\\\"cfg-x\\\" title=\\\"Fechar\\\">×</button></div>\\n        <div class=\\\"cb lp-body\\\"><div class=\\\"pv-msg\\\">Carregando...</div></div>\\n        <div class=\\\"lp-foot\\\"><span>Baixadas da Chrome Web Store. Ao ativar, desativar, atualizar ou reinstalar, as 4 contas recarregam para aplicar.</span></div>`;\\n      document.body.appendChild(p);\\n      p.querySelector('.cfg-x').onclick = () => fecharExts();\\n      drawExts(await window.api.extGet());\\n    });\\n    if (window.api.onExtsUpdate) window.api.onExtsUpdate(async () => { if (extsAberto) drawExts(await window.api.extGet()); });\\n    document.addEventListener('keydown', (e) => { if (extsAberto && e.key === 'Escape') { e.preventDefault(); fecharExts(); } }, true);\\n\\n    // ---------- Lives: painel com todas as contas ----------\\n    let livesAberto = null;\\n    function fecharLives() {\\n      if (!livesAberto) return;\\n      const id = livesAberto;\\n      livesAberto = null;\\n      const p = document.getElementById('livesPanel'); if (p) p.remove();\\n      const sh = document.getElementById('livesShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    const escL = (t) => String(t == null ? '' : t).replace(/[&<>\\\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;' }[c]));\\n    const PLATI = { twitch: SVG.twitch, kick: SVG.kick };\\n    let livesTab = 'contas';\\n    function drawLives(o) {\\n      const p = document.getElementById('livesPanel');\\n      if (!p || !o) return;\\n      const vivos = Object.fromEntries(o.aoVivo.map((pl) => [pl.p, pl]));\\n      const abertas = o.contas.reduce((t, c) => t + c.plats.reduce((s, pl) => s + pl.open.length, 0), 0);\\n      const contando = o.contas.some((c) => c.plats.some((pl) => pl.contando && pl.contando.length));\\n      // resumo enxuto no topo (os nomes dos canais ficam só na aba \\\"Canais\\\", sem repetir)\\n      const totalDe = (p) => ((o.canais || []).find((x) => x.p === p) || { lista: [] }).lista.length;\\n      const boxVivo = (pl) => `<section class=\\\"lv-box lv-kpi ${pl.p === 'twitch' ? 'tw' : 'kk'}\\\">\\n          <span class=\\\"lp-ico\\\">${PLATI[pl.p]}</span><div><b class=\\\"lv-big hud\\\" style=\\\"color:${pl.p === 'twitch' ? 'var(--twTxt)' : 'var(--kkTxt)'}\\\">${pl.list.length}</b>\\n          <span class=\\\"lv-none\\\">de ${totalDe(pl.p)} canais da ${escL(pl.name)} ao vivo</span></div></section>`;\\n      const topo = `<div class=\\\"lv-top\\\">${o.aoVivo.map(boxVivo).join('')}\\n        <section class=\\\"lv-box lv-kpi res\\\"><div><b class=\\\"lv-big hud\\\">${abertas}</b>\\n          ${contando ? '<span class=\\\"lv-ok\\\">lives abertas · ✓ bônus da Twitch contando</span>' : '<span class=\\\"lv-none\\\">lives abertas nas 4 contas</span>'}</div></section></div>`;\\n      const abas = `<nav class=\\\"lv-abas\\\"><button class=\\\"${livesTab === 'contas' ? 'on' : ''}\\\" data-lvt=\\\"contas\\\">Contas</button><button class=\\\"${livesTab === 'canais' ? 'on' : ''}\\\" data-lvt=\\\"canais\\\">Canais e quem está ao vivo</button></nav>`;\\n      const cel = (c, pl) => `<div class=\\\"lv-cel ${pl.p === 'twitch' ? 'tw' : 'kk'}\\\">\\n          <div class=\\\"linha\\\"><input type=\\\"checkbox\\\" class=\\\"sw\\\" ${pl.on ? 'checked' : ''} data-lt=\\\"${c.i}|${pl.p}\\\" title=\\\"${pl.on ? 'Desligar' : 'Ligar'} ${escL(pl.name)} em ${escL(c.name)}\\\">\\n            <span class=\\\"est ${pl.on ? 'on' : 'off'}\\\">${pl.on ? `${pl.open.length} live${pl.open.length === 1 ? '' : 's'} aberta${pl.open.length === 1 ? '' : 's'}` : 'desligada'}</span></div>\\n          ${pl.on && pl.open.length ? `<div class=\\\"lv-chips\\\">${pl.open.map((ch) => `<button class=\\\"lv-ch\\\" data-lv=\\\"${c.i}|${pl.p}|${escL(ch)}\\\" title=\\\"Assistir com a conta ${escL(c.name)}\\\">${escL(ch)}</button>`).join('')}</div>` : ''}\\n          ${pl.on && !pl.open.length ? '<span class=\\\"lv-none\\\">nenhum canal ao vivo agora</span>' : ''}\\n          ${pl.on && pl.contando && pl.contando.length ? `<span class=\\\"lv-ok\\\">✓ contando o bônus em ${pl.contando.map(escL).join(', ')}</span>` : ''}</div>`;\\n      const plats = (o.contas[0] && o.contas[0].plats) || [];\\n      const contas = `<table class=\\\"lv-tab\\\"><thead><tr><th>Conta</th>${plats.map((pl) => `<th><span class=\\\"lp-ico\\\">${PLATI[pl.p]}</span>${escL(pl.name)}</th>`).join('')}</tr></thead><tbody>\\n        ${o.contas.map((c) => `<tr><td class=\\\"lv-acc\\\"><b>${escL(c.name)}</b><span>${c.plats.reduce((t, pl) => t + pl.open.length, 0)} abertas</span></td>${c.plats.map((pl) => `<td>${cel(c, pl)}</td>`).join('')}</tr>`).join('')}\\n        </tbody></table><div class=\\\"lv-nota\\\">Clique num canal para assistir com aquela conta. A chave liga ou desliga a plataforma na conta.</div>`;\\n      const canais = `<div class=\\\"lv-of\\\">${(o.canais || []).map((pl) => { const viv = new Set((vivos[pl.p] && vivos[pl.p].list) || []);\\n        return `<section class=\\\"lv-box ${pl.p === 'twitch' ? 'tw' : 'kk'}\\\"><div class=\\\"lv-h\\\"><span class=\\\"lp-ico\\\">${PLATI[pl.p]}</span><b>${escL(pl.name)}</b><span class=\\\"n\\\">${pl.lista.length} canais</span></div>\\n          <div class=\\\"lv-lista\\\">${pl.lista.slice().sort((a, b) => viv.has(b) - viv.has(a) || a.localeCompare(b)).map((c) => `<div class=\\\"it\\\"><span class=\\\"nm\\\">${escL(c)}</span>\\n            <span class=\\\"st${viv.has(c) ? ' vivo' : ''}\\\">${viv.has(c) ? '● ao vivo' : 'offline'}</span><button data-rm=\\\"${pl.p}|${escL(c)}\\\" title=\\\"Tirar ${escL(c)} da lista (não é mais parceiro)\\\">×</button></div>`).join('')}</div>\\n          ${pl.removidos.length ? `<div class=\\\"lv-rm\\\">${pl.removidos.map((r) => `<button data-back=\\\"${pl.p}|${escL(r.slug)}\\\" title=\\\"Trazer ${escL(r.slug)} de volta\\\">${escL(r.slug)} <small>${r.como === 'auto' ? 'automático' : 'você tirou'}</small></button>`).join('')}</div>` : ''}</section>`; }).join('')}</div>\\n        <div class=\\\"lv-nota\\\">× tira quem não é mais parceiro. Os riscados voltam com um clique. A lista também se ajusta sozinha pela conexão do jogo.</div>`;\\n      p.querySelector('.lp-body').innerHTML = `<div class=\\\"lv\\\">${topo}${abas}${livesTab === 'canais' ? canais : contas}</div>`;\\n      p.querySelector('.lp-quando').textContent = o.quando ? `Última verificação: ${o.quando}` + (o.erros ? ` · ${o.erros} canal(is) não responderam` : '') + (o.kickInfo ? (/^pelo jogo/.test(o.kickInfo) ? ` · ${o.kickInfo}` : ` · Kick ${o.kickInfo}`) : '') : 'Ainda não verificado.';\\n      p.querySelectorAll('[data-lvt]').forEach((x) => { x.onclick = () => { livesTab = x.dataset.lvt; drawLives(o); }; });\\n      p.querySelectorAll('[data-lt]').forEach((x) => { const [ci, pl] = x.dataset.lt.split('|'); x.onchange = () => window.api.setLives(Number(ci), pl, x.checked); });\\n      p.querySelectorAll('[data-lv]').forEach((x) => { const [ci, pl, ch] = x.dataset.lv.split('|'); x.onclick = () => window.api.openLivePage(Number(ci), pl, ch); });\\n      p.querySelectorAll('[data-rm]').forEach((x) => { const [pl, ch] = x.dataset.rm.split('|'); x.onclick = () => window.api.canalRemover(pl, ch); });\\n      p.querySelectorAll('[data-back]').forEach((x) => { const [pl, ch] = x.dataset.back.split('|'); x.onclick = () => window.api.canalVoltar(pl, ch); });\\n    }\\n    if (window.api.onLivesPanel) window.api.onLivesPanel(async (d) => {\\n      closeAll();\\n      if (livesAberto) fecharLives();\\n      livesAberto = d.id;\\n      const sh = el('div'); sh.id = 'livesShade'; sh.onclick = () => fecharLives();\\n      document.body.appendChild(sh);\\n      const p = el('div', 'lp'); p.id = 'livesPanel';\\n      p.innerHTML = `<div class=\\\"ch\\\"><span class=\\\"lp-ico\\\">${SVG.tv}</span><b>Lives</b><span>abertas em segundo plano</span><button class=\\\"cfg-x\\\" title=\\\"Fechar\\\">×</button></div>\\n        <div class=\\\"cb lp-body\\\"><div class=\\\"pv-msg\\\">Carregando...</div></div>\\n        <div class=\\\"lp-foot\\\"><span class=\\\"lp-quando\\\"></span><span class=\\\"grow\\\"></span><button class=\\\"kx-btn small\\\" id=\\\"lpLista\\\" title=\\\"Abre o painel de bônus do jogo escondido e atualiza a lista de parceiros\\\">Conferir lista</button><button class=\\\"kx-btn small\\\" id=\\\"lpNow\\\">Verificar agora</button></div>`;\\n      document.body.appendChild(p);\\n      p.querySelector('.cfg-x').onclick = () => fecharLives();\\n      p.querySelector('#lpLista').onclick = async (ev) => { const b1 = ev.currentTarget; b1.textContent = 'Conferindo...'; b1.disabled = true; drawLives(await window.api.listaConferir()); const b2 = p.querySelector('#lpLista'); if (b2) { b2.textContent = 'Conferir lista'; b2.disabled = false; } };\\n      p.querySelector('#lpNow').onclick = async (ev) => { ev.currentTarget.textContent = 'Verificando...'; drawLives(await window.api.livesCheckNow()); const b2 = p.querySelector('#lpNow'); if (b2) b2.textContent = 'Verificar agora'; };\\n      drawLives(await window.api.livesGet());\\n    });\\n    if (window.api.onLivesUpdate) window.api.onLivesUpdate(async () => { if (livesAberto) drawLives(await window.api.livesGet()); });\\n    document.addEventListener('keydown', (e) => { if (livesAberto && e.key === 'Escape') { e.preventDefault(); fecharLives(); } }, true);\\n\\n    // ---------- Novidades da versão (patch notes) ----------\\n    let novAberto = null;\\n    function fecharNov() {\\n      if (!novAberto) return;\\n      const id = novAberto; novAberto = null;\\n      const p = document.getElementById('novPanel'); if (p) p.remove();\\n      const sh = document.getElementById('novShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    // **texto** vira negrito (o resto é escapado)\\n    const rico = (t) => escL(t).replace(/\\\\*\\\\*(.+?)\\\\*\\\\*/g, '<b>$1</b>');\\n    const NOV_LOGO = `<svg class=\\\"nov-logo\\\" viewBox=\\\"0 0 64 64\\\"><circle cx=\\\"32\\\" cy=\\\"32\\\" r=\\\"28\\\" fill=\\\"#28282c\\\" stroke=\\\"#1b1b1d\\\" stroke-width=\\\"4\\\"/>\\n      <path d=\\\"M6 32a26 26 0 0 1 52 0z\\\" fill=\\\"#9cff5e\\\"/><path d=\\\"M6 32a26 26 0 0 1 52 0\\\" fill=\\\"none\\\" stroke=\\\"#43b000\\\" stroke-width=\\\"2\\\"/>\\n      <rect x=\\\"5\\\" y=\\\"29\\\" width=\\\"54\\\" height=\\\"6\\\" fill=\\\"#1b1b1d\\\"/><circle cx=\\\"32\\\" cy=\\\"32\\\" r=\\\"9\\\" fill=\\\"#e6ffd6\\\" stroke=\\\"#1b1b1d\\\" stroke-width=\\\"4\\\"/>\\n      <circle cx=\\\"32\\\" cy=\\\"32\\\" r=\\\"3.5\\\" fill=\\\"#c1ff9b\\\"/><path d=\\\"M20 15l3 3M44 15l-3 3\\\" stroke=\\\"#dbffc4\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\"/></svg>`;\\n    // pacote: { id, atual, lista: [novidades da versão mais nova, ..., a mais antiga] } (versões antigas: um objeto só)\\n    // Tudo numa tela só: a capa, o destaque e TODAS as seções, uma embaixo da outra, numa rolagem só.\\n    // Antes era um slideshow com setas e bolinhas, e quem não clicava nunca via metade das novidades.\\n    function abrirNov(pk, vi) {\\n      const lista = pk.lista && pk.lista.length ? pk.lista : [pk];\\n      vi = Math.min(lista.length - 1, Math.max(0, vi == null ? pk.atual || 0 : vi));\\n      const d = lista[vi];\\n      closeAll();\\n      fecharNov();\\n      novAberto = pk.id;\\n      const sh = el('div'); sh.id = 'novShade'; document.body.appendChild(sh);\\n      const p = el('div', 'nov'); p.id = 'novPanel';\\n      const capa = `<div class=\\\"nov-hero\\\">\\n          ${NOV_LOGO}\\n          <div><span class=\\\"nov-selo\\\">${escL(d.selo || 'NOVIDADES')}</span></div>\\n          <div class=\\\"nov-tit\\\">${escL(d.titulo || '')}</div>\\n          ${d.resumo ? `<div class=\\\"nov-res\\\">${rico(d.resumo)}</div>` : ''}\\n          ${(d.cartoes || []).length ? `<div class=\\\"nov-cards\\\">${d.cartoes.map((c) => `<div class=\\\"nov-card\\\"><div class=\\\"ic\\\">${escL(c.icone || '')}</div>\\n            <div class=\\\"vl\\\">${escL(c.valor || '')}</div><div class=\\\"nm\\\">${escL(c.nome || '')}</div><div class=\\\"sb\\\">${escL(c.sub || '')}</div></div>`).join('')}</div>` : ''}\\n        </div>`;\\n      const secoes = (d.paginas || []).map((x) => `<section class=\\\"nov-sec\\\"><h4>${escL(x.titulo || '')}</h4>\\n          <ul>${(x.itens || []).map((t) => `<li>${rico(t)}</li>`).join('')}</ul></section>`).join('');\\n      const seletor = lista.length > 1 ? `<label class=\\\"nov-ver\\\" title=\\\"Novidades das versões anteriores\\\"><span>Versão</span><select>${lista.map((v, k) =>\\n        `<option value=\\\"${k}\\\"${k === vi ? ' selected' : ''}>${escL(v.versao || '')}${k === 0 ? ' (mais nova)' : ''}</option>`).join('')}</select></label>` : '';\\n      p.innerHTML = `<div class=\\\"nov-hd\\\"><span>Novidades no PokeLink ${escL(d.versao || '')}${d.data ? `<i>${escL(d.data)}</i>` : ''}</span>${seletor}</div>\\n        <div class=\\\"nov-bd\\\">${capa}${d.destaque ? `<div class=\\\"nov-gold\\\">${rico(d.destaque)}</div>` : ''}${secoes}\\n          <div class=\\\"nov-fim\\\">Boa caçada! — PokeLink</div></div>\\n        <div class=\\\"nov-pe\\\"><button class=\\\"nov-go\\\">${escL(d.botao || 'JOGAR')}</button></div>`;\\n      document.body.appendChild(p);\\n      p.querySelector('.nov-go').onclick = () => fecharNov();\\n      const sv = p.querySelector('.nov-ver select');\\n      if (sv) sv.onchange = () => { // troca de versão sem fechar o card (não avisa o PokeLink)\\n        const id = novAberto; novAberto = null;\\n        p.remove(); const sh0 = document.getElementById('novShade'); if (sh0) sh0.remove();\\n        abrirNov(Object.assign({}, pk, { id }), Number(sv.value));\\n      };\\n    }\\n    if (window.api.onNovidades) window.api.onNovidades((d) => abrirNov(d));\\n    document.addEventListener('keydown', (e) => {\\n      if (!novAberto) return;\\n      if (e.key === 'Escape') { e.preventDefault(); fecharNov(); }\\n    }, true);\\n\\n    // ---------- Troca de hunt automática (segue a /hunt) ----------\\n    let ahAberto = null;\\n    function fecharAh() {\\n      if (!ahAberto) return;\\n      const id = ahAberto; ahAberto = null;\\n      const p = document.getElementById('ahPanel'); if (p) p.remove();\\n      const sh = document.getElementById('ahShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    const sel = (nome, atual, ops) => `<select data-ah=\\\"${nome}\\\">${ops.map(([v, t]) => `<option value=\\\"${v}\\\"${String(v) === String(atual) ? ' selected' : ''}>${t}</option>`).join('')}</select>`;\\n    function drawAh(d) {\\n      const p = document.getElementById('ahPanel');\\n      if (!p || !d) return;\\n      p.querySelector('.cb').innerHTML = `<div class=\\\"ah-aviso\\\">O PokeLink lê a recomendação da extensão <b>/hunt</b> e troca de mapa sozinho, como um jogador faria: só fora de combate, só para hunts liberadas e dentro do risco escolhido. Começa desligada. Confira se as regras do PokeIdle permitem antes de ligar.</div>\\n        <div class=\\\"ah-cfg\\\">\\n          <label>Critério ${sel('criterio', d.criterio, [['xp', 'Mais XP/h'], ['ouro', 'Mais ouro/h']])}</label>\\n          <label>Risco máximo ${sel('riscoMax', d.riscoMax, [[10, 'até 10%'], [20, 'até 20%'], [30, 'até 30%'], [50, 'até 50%'], [100, 'qualquer']])}</label>\\n          <label>Trocar se ganhar ${sel('margem', d.margem, [[5, '+5% ou mais'], [10, '+10% ou mais'], [20, '+20% ou mais'], [30, '+30% ou mais']])}</label>\\n          <label>Conferir a cada ${sel('intervaloMin', d.intervaloMin, [[10, '10 min'], [15, '15 min'], [30, '30 min'], [60, '1 hora']])}</label>\\n        </div>\\n        <h3 class=\\\"kx-h\\\">Contas <small>a chave liga/desliga em cada conta</small></h3>\\n        <div class=\\\"ah-g\\\">${d.contas.map((c) => `<div class=\\\"ah-c${c.on ? ' on' : ''}\\\">\\n          <div class=\\\"h\\\"><b>${escL(c.nome)}</b><input type=\\\"checkbox\\\" class=\\\"sw\\\" ${c.on ? 'checked' : ''} data-ahc=\\\"${c.i}\\\" title=\\\"${c.on ? 'Desligar' : 'Ligar'} nesta conta\\\"></div>\\n          <div class=\\\"ah-st\\\">${escL(c.status || '')}</div>\\n          ${c.on && c.proxima != null ? `<div class=\\\"px\\\">próxima conferência em ~${c.proxima} min</div>` : ''}\\n          ${c.hist.length ? `<div class=\\\"hs\\\">${c.hist.map((h) => `<span>${escL(h.hora)} · ${escL(h.de)} → <b>${escL(h.para)}</b>${h.ganho != null ? ` (+${h.ganho}%)` : ''}</span>`).join('')}</div>` : ''}\\n          <div class=\\\"bt\\\"><button class=\\\"kx-btn small\\\" data-aha=\\\"${c.i}\\\" title=\\\"Confere agora e troca se valer a pena\\\">Conferir agora</button></div>\\n        </div>`).join('')}</div>`;\\n      p.querySelectorAll('[data-ah]').forEach((x) => { x.onchange = () => window.api.huntSet({ [x.dataset.ah]: x.value }); });\\n      p.querySelectorAll('[data-ahc]').forEach((x) => { x.onchange = () => window.api.huntSet({ conta: Number(x.dataset.ahc), on: x.checked }); });\\n      p.querySelectorAll('[data-aha]').forEach((x) => { x.onclick = async () => { x.disabled = true; x.textContent = 'Conferindo...'; drawAh(await window.api.huntAgora(Number(x.dataset.aha))); }; });\\n    }\\n    if (window.api.onAutoHuntPanel) window.api.onAutoHuntPanel(async (d) => {\\n      closeAll();\\n      fecharAh();\\n      ahAberto = d.id;\\n      const sh = el('div'); sh.id = 'ahShade'; sh.onclick = () => fecharAh();\\n      document.body.appendChild(sh);\\n      const p = el('div', 'lp ah'); p.id = 'ahPanel';\\n      p.innerHTML = `<div class=\\\"ch\\\"><b>Troca de hunt automática</b><span>segue a recomendação da /hunt</span><button class=\\\"cfg-x\\\" title=\\\"Fechar\\\">×</button></div>\\n        <div class=\\\"cb\\\"><div class=\\\"pv-msg\\\">Carregando...</div></div>`;\\n      document.body.appendChild(p);\\n      p.querySelector('.cfg-x').onclick = () => fecharAh();\\n      drawAh(await window.api.huntGet());\\n    });\\n    if (window.api.onHuntUpdate) window.api.onHuntUpdate(async () => { if (ahAberto) drawAh(await window.api.huntGet()); });\\n    document.addEventListener('keydown', (e) => { if (ahAberto && e.key === 'Escape') { e.preventDefault(); fecharAh(); } }, true);\\n\\n    // ---------- Ver no celular: QR code e código para abrir o resumo no celular ----------\\n    // QR code simples (versão 4, correção L, modo byte): até 78 letras. Feito à mão para o PokeLink.\\n    function qrMatriz(texto) {\\n      const N = 33, DADOS = 80, EC = 20;\\n      const bytes = [...new TextEncoder().encode(texto)];\\n      if (bytes.length > 78) throw new Error('texto grande demais para o QR');\\n      // bits: modo byte (0100) + tamanho (8 bits) + bytes + fim\\n      const bits = [];\\n      const put = (v, n) => { for (let k = n - 1; k >= 0; k--) bits.push((v >> k) & 1); };\\n      put(4, 4); put(bytes.length, 8); bytes.forEach((b) => put(b, 8));\\n      put(0, Math.min(4, DADOS * 8 - bits.length));\\n      while (bits.length % 8) bits.push(0);\\n      const cw = [];\\n      for (let k = 0; k < bits.length; k += 8) cw.push(parseInt(bits.slice(k, k + 8).join(''), 2));\\n      for (let p = 0; cw.length < DADOS; p++) cw.push(p % 2 ? 0x11 : 0xEC);\\n      // correção de erros (Reed-Solomon)\\n      const exp = new Array(512), log = new Array(256);\\n      for (let k = 0, x = 1; k < 255; k++) { exp[k] = x; log[x] = k; x <<= 1; if (x & 256) x ^= 0x11D; }\\n      for (let k = 255; k < 512; k++) exp[k] = exp[k - 255];\\n      const mul = (a, b) => (a && b ? exp[log[a] + log[b]] : 0);\\n      let gen = [1];\\n      for (let k = 0; k < EC; k++) {\\n        const g = new Array(gen.length + 1).fill(0);\\n        gen.forEach((c, j) => { g[j] ^= c; g[j + 1] ^= mul(c, exp[k]); });\\n        gen = g;\\n      }\\n      const rest = new Array(EC).fill(0);\\n      for (const c of cw) {\\n        const f = c ^ rest.shift(); rest.push(0);\\n        for (let j = 0; j < EC; j++) rest[j] ^= mul(gen[j + 1], f);\\n      }\\n      const todos = cw.concat(rest);\\n      // matriz\\n      const m = Array.from({ length: N }, () => new Array(N).fill(false));\\n      const fixo = Array.from({ length: N }, () => new Array(N).fill(false));\\n      const set = (x, y, v) => { m[y][x] = v; fixo[y][x] = true; };\\n      const finder = (cx, cy) => {\\n        for (let dy = -4; dy <= 4; dy++) for (let dx = -4; dx <= 4; dx++) {\\n          const x = cx + dx, y = cy + dy;\\n          if (x < 0 || y < 0 || x >= N || y >= N) continue;\\n          const d = Math.max(Math.abs(dx), Math.abs(dy));\\n          set(x, y, d !== 2 && d !== 4);\\n        }\\n      };\\n      finder(3, 3); finder(N - 4, 3); finder(3, N - 4);\\n      for (let k = 0; k < N; k++) { if (!fixo[6][k]) set(k, 6, k % 2 === 0); if (!fixo[k][6]) set(6, k, k % 2 === 0); }\\n      for (let dy = -2; dy <= 2; dy++) for (let dx = -2; dx <= 2; dx++) set(26 + dx, 26 + dy, Math.max(Math.abs(dx), Math.abs(dy)) !== 1);\\n      // formato (correção L, máscara 0)\\n      const dado = (1 << 3) | 0;\\n      let r = dado; for (let k = 0; k < 10; k++) r = (r << 1) ^ ((r >> 9) * 0x537);\\n      const fmt = ((dado << 10) | r) ^ 0x5412;\\n      const b = (k) => ((fmt >> k) & 1) === 1;\\n      for (let k = 0; k <= 5; k++) set(8, k, b(k));\\n      set(8, 7, b(6)); set(8, 8, b(7)); set(7, 8, b(8));\\n      for (let k = 9; k < 15; k++) set(14 - k, 8, b(k));\\n      for (let k = 0; k < 8; k++) set(N - 1 - k, 8, b(k));\\n      for (let k = 8; k < 15; k++) set(8, N - 15 + k, b(k));\\n      set(8, N - 8, true);\\n      // dados em zigue-zague, com máscara 0\\n      let i = 0;\\n      for (let dir = N - 1; dir >= 1; dir -= 2) {\\n        if (dir === 6) dir = 5;\\n        for (let v = 0; v < N; v++) for (let j = 0; j < 2; j++) {\\n          const x = dir - j, sobe = ((dir + 1) & 2) === 0, y = sobe ? N - 1 - v : v;\\n          if (fixo[y][x]) continue;\\n          let bit = false;\\n          if (i < todos.length * 8) bit = ((todos[i >> 3] >> (7 - (i & 7))) & 1) === 1;\\n          i++;\\n          if ((x + y) % 2 === 0) bit = !bit;\\n          m[y][x] = bit;\\n        }\\n      }\\n      return m;\\n    }\\n\\n    const qrSvg = (texto) => {\\n      const m = qrMatriz(texto), q = 4, n = m.length + q * 2;\\n      let r = '';\\n      m.forEach((linha, y) => linha.forEach((v, x) => { if (v) r += `M${x + q},${y + q}h1v1h-1z`; }));\\n      return `<svg viewBox=\\\"0 0 ${n} ${n}\\\" shape-rendering=\\\"crispEdges\\\" role=\\\"img\\\" aria-label=\\\"QR code para abrir no celular\\\"><rect width=\\\"${n}\\\" height=\\\"${n}\\\" fill=\\\"#f3ffec\\\"/><path d=\\\"${r}\\\" fill=\\\"#111113\\\"/></svg>`;\\n    };\\n    let celAberto = null;\\n    function fecharCel() {\\n      if (!celAberto) return;\\n      const id = celAberto; celAberto = null;\\n      const p = document.getElementById('celPanel'); if (p) p.remove();\\n      const sh = document.getElementById('celShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    async function acaoCel(acao, btn) {\\n      if (btn) { btn.disabled = true; btn.textContent = 'Aguarde...'; }\\n      drawCel(await window.api.monitorAcao(acao));\\n    }\\n    function drawCel(d) {\\n      const p = document.getElementById('celPanel');\\n      if (!p || !d) return;\\n      const cb = p.querySelector('.cb'), ft = p.querySelector('.lp-foot');\\n      if (!d.ligado) {\\n        cb.innerHTML = `<div class=\\\"cel-off\\\">\\n          <div>Veja o resumo das 4 contas no celular, <b>de qualquer lugar</b>: nível, ouro, XP, capturas, hunt, pontos das lives e avisos (conta travada, meta da Kick, shiny...).</div>\\n          <ul><li>O celular só <b>vê</b>: não dá para mexer em nada por lá.</li>\\n          <li>O resumo vai a cada ${escL(d.freq)} para um servidor (avisos vão na hora), guardado sob um código que só você tem.</li>\\n          <li>Senhas e logins nunca são enviados. Ao desligar, o resumo é apagado do servidor.</li></ul>\\n          <div class=\\\"nota\\\">Só atualiza com o PC ligado e o PokeLink aberto.</div></div>`;\\n        ft.innerHTML = '<span class=\\\"grow\\\"></span><button class=\\\"kx-btn go\\\" data-cel=\\\"ligar\\\">Ligar</button>';\\n      } else {\\n        const st = d.enviando ? ['', 'Enviando o resumo...'] : d.erro ? ['erro', `Não consegui enviar: ${escL(d.erro)}`]\\n          : d.ultimo ? ['', `Último envio às ${escL(d.ultimo)} · atualiza a cada ${escL(d.freq)}`] : ['aviso', 'Preparando o primeiro envio...'];\\n        cb.innerHTML = `<div class=\\\"cel-g\\\"><div class=\\\"cel-qr\\\">${qrSvg(d.link)}</div>\\n          <div class=\\\"cel-i\\\"><ol><li>Aponte a <b>câmera do celular</b> para o QR code.</li>\\n            <li>Ou abra <b>${escL(d.site.replace(/^https:\\\\/\\\\//, ''))}</b> e digite o código:</li></ol>\\n            <div class=\\\"cel-cod\\\">${escL(d.codigoFmt)}</div>\\n            ${d.codigoNovo ? '<div class=\\\"cel-st aviso\\\">O código mudou: leia o QR de novo no celular.</div>' : ''}\\n            <div class=\\\"cel-st ${st[0]}\\\">${st[1]}</div>\\n            <div style=\\\"color:#6a6a75;font-size:12px\\\">Quem tiver este código vê o resumo. Se alguém viu, use \\\"Trocar código\\\".</div></div></div>`;\\n        ft.innerHTML = `<button class=\\\"kx-btn small\\\" data-cel=\\\"desligar\\\" title=\\\"Para de enviar e apaga o resumo do servidor\\\">Desligar</button>\\n          <button class=\\\"kx-btn small\\\" data-cel=\\\"trocar\\\" title=\\\"Cria um código novo; o antigo para de funcionar\\\">Trocar código</button>\\n          <span class=\\\"grow\\\"></span><button class=\\\"kx-btn small\\\" data-copiar=\\\"1\\\">Copiar link</button>\\n          <button class=\\\"kx-btn small go\\\" data-cel=\\\"agora\\\"${d.enviando ? ' disabled' : ''}>Enviar agora</button>`;\\n      }\\n      ft.querySelectorAll('[data-cel]').forEach((b) => { b.onclick = () => acaoCel(b.dataset.cel, b); });\\n      const cp = ft.querySelector('[data-copiar]');\\n      if (cp) cp.onclick = async () => { try { await navigator.clipboard.writeText(d.link); cp.textContent = 'Copiado!'; } catch (e) { cp.textContent = 'Não copiou'; } };\\n    }\\n    if (window.api.onMonitorPanel) window.api.onMonitorPanel(async (d) => {\\n      closeAll();\\n      fecharCel();\\n      celAberto = d.id;\\n      const sh = el('div'); sh.id = 'celShade'; sh.onclick = () => fecharCel();\\n      document.body.appendChild(sh);\\n      const p = el('div', 'lp cel'); p.id = 'celPanel';\\n      p.innerHTML = `<div class=\\\"ch\\\"><b>Ver no celular</b><span>resumo das contas de qualquer lugar</span><button class=\\\"cfg-x\\\" title=\\\"Fechar\\\">×</button></div>\\n        <div class=\\\"cb\\\"><div class=\\\"pv-msg\\\">Carregando...</div></div><div class=\\\"lp-foot\\\"></div>`;\\n      document.body.appendChild(p);\\n      p.querySelector('.cfg-x').onclick = () => fecharCel();\\n      drawCel(await window.api.monitorGet());\\n    });\\n    if (window.api.onMonitorUpdate) window.api.onMonitorUpdate(async () => { if (celAberto) drawCel(await window.api.monitorGet()); });\\n    document.addEventListener('keydown', (e) => { if (celAberto && e.key === 'Escape') { e.preventDefault(); fecharCel(); } }, true);\\n\\n    // ---------- Uso de CPU e memória: cartões coloridos (verde ok · amarelo médio · vermelho alto) ----------\\n    let usoAberto = null, usoTimer = null;\\n    function fecharUso() {\\n      if (!usoAberto) return;\\n      const id = usoAberto;\\n      usoAberto = null;\\n      clearInterval(usoTimer); usoTimer = null;\\n      const p = document.getElementById('usoPanel'); if (p) p.remove();\\n      const sh = document.getElementById('usoShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    const mb = (v) => (v >= 1024 ? (v / 1024).toFixed(1).replace('.', ',') + ' GB' : Math.round(v) + ' MB');\\n    const pct = (v) => Math.round(v || 0) + '%';\\n    const NIVEL = { ok: 'OK', medio: 'MÉDIO', alto: 'ALTO' };\\n    const cartao = (cls, titulo, valor, sub, det, nivel) => `<div class=\\\"uso-c ${nivel}${cls ? ' ' + cls : ''}\\\">\\n        <div class=\\\"t\\\" title=\\\"${escL(titulo)}\\\">${escL(titulo)}</div><div class=\\\"v\\\">${valor}</div>\\n        <div class=\\\"s\\\"><span>${sub}</span><span class=\\\"tag\\\">${NIVEL[nivel]}</span></div>${det ? `<div class=\\\"d\\\">${det}</div>` : ''}</div>`;\\n    function drawUso(d) {\\n      const p = document.getElementById('usoPanel');\\n      if (!p || !d) return;\\n      const t = d.total;\\n      let h = `<div class=\\\"uso-g\\\">${cartao('hero', 'PokeLink inteiro', mb(t.mem), `CPU ${pct(t.cpu)}`, `4 contas, barras e ${t.nLives} live${t.nLives === 1 ? '' : 's'}`, t.nivel)}</div>`;\\n      h += `<div class=\\\"uso-h\\\">Contas</div><div class=\\\"uso-g\\\">${d.contas.map((c) => cartao('', c.nome, mb(c.mem), `CPU ${pct(c.cpu)}`, c.modo, c.nivel)).join('')}</div>`;\\n      h += `<div class=\\\"uso-h\\\">Por grupo <span style=\\\"text-transform:none;letter-spacing:0;color:#6a6a75\\\">· do que mais gasta para o que menos gasta</span></div><div class=\\\"uso-g\\\">${d.grupos.map((g) =>\\n        cartao('', g.nome + (g.qtd ? ` (${g.qtd})` : ''), mb(g.mem), `CPU ${pct(g.cpu)}`, g.porItem != null ? `≈ ${mb(g.porItem)} por live${g.dica ? ' · ' + g.dica : ''}` : g.dica, g.nivel)).join('')}</div>`;\\n      if (d.outros && d.outros.length) h += `<div class=\\\"uso-h\\\">Dentro de \\\"Outros\\\"</div><div class=\\\"uso-out\\\">${d.outros.map((o) => `<span>${escL(o.nome)}: <b>${mb(o.mem)}</b></span>`).join('')}</div>`;\\n      p.querySelector('.cb').innerHTML = h;\\n    }\\n    if (window.api.onUsoPanel) window.api.onUsoPanel(async (d) => {\\n      closeAll();\\n      if (usoAberto) fecharUso();\\n      usoAberto = d.id;\\n      const sh = el('div'); sh.id = 'usoShade'; sh.onclick = () => fecharUso();\\n      document.body.appendChild(sh);\\n      const p = el('div', 'lp uso'); p.id = 'usoPanel';\\n      p.innerHTML = `<div class=\\\"ch\\\"><b>Uso de CPU e memória</b><span>atualiza sozinho a cada 5 s</span><button class=\\\"cfg-x\\\" title=\\\"Fechar\\\">×</button></div>\\n        <div class=\\\"cb\\\"><div class=\\\"pv-msg\\\">Medindo...</div></div>\\n        <div class=\\\"lp-foot\\\"><span class=\\\"uso-leg\\\"><span><i style=\\\"background:#7fe08a\\\"></i>ok</span><span><i style=\\\"background:#9ae76a\\\"></i>médio consumo</span><span><i style=\\\"background:#ff5d6c\\\"></i>alto consumo</span></span>\\n        <span class=\\\"grow\\\"></span><span style=\\\"color:#6a6a75;font-size:12px\\\">Dica: Eco e Mega Eco deixam as contas mais leves</span></div>`;\\n      document.body.appendChild(p);\\n      p.querySelector('.cfg-x').onclick = () => fecharUso();\\n      drawUso(await window.api.usoGet());\\n      usoTimer = setInterval(async () => { if (usoAberto) drawUso(await window.api.usoGet()); }, 5000);\\n    });\\n    document.addEventListener('keydown', (e) => { if (usoAberto && e.key === 'Escape') { e.preventDefault(); fecharUso(); } }, true);\\n\\n    // ---------- Pontos da Kick: painel que desce da moedinha ----------\\n    let kickAberto = null;\\n    let kickIniciado = false;\\n    function fecharKick() {\\n      if (!kickAberto) return;\\n      const id = kickAberto;\\n      kickAberto = null;\\n      const k = document.getElementById('kickw');\\n      k.hidden = true;\\n      const sh = document.getElementById('kickShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    if (window.api.onKickPanel) window.api.onKickPanel((d) => {\\n      closeAll();\\n      if (kickAberto) fecharKick();\\n      kickAberto = d.id;\\n      const sh = el('div'); sh.id = 'kickShade'; sh.onclick = () => fecharKick();\\n      document.body.appendChild(sh);\\n      const k = document.getElementById('kickw');\\n      k.classList.add('panel');\\n      k.hidden = false;\\n      if (!kickIniciado) { kickIniciado = true; initKick({ fechar: () => fecharKick(), conta: d.conta }); }\\n      else { window.__kickConta(d.conta); window.__kickRefresh(); }\\n      const fit = () => {\\n        const r = k.getBoundingClientRect();\\n        const x = Math.max(8, Math.min(d.x, innerWidth - r.width - 8));\\n        let y = d.y;\\n        if (innerHeight > 100 && y + r.height > innerHeight - 8) y = Math.max(40, (d.up || innerHeight) - r.height);\\n        k.style.left = x + 'px';\\n        k.style.top = Math.max(40, Math.min(y, innerHeight - r.height - 8)) + 'px';\\n      };\\n      requestAnimationFrame(fit);\\n      window.addEventListener('resize', fit);\\n    });\\n    document.addEventListener('keydown', (e) => { if (kickAberto && e.key === 'Escape') { e.preventDefault(); fecharKick(); } }, true);\\n\\n    // ---------- Otimizar a conta: painel que desce do botão de raio ----------\\n    let otimAberto = null;\\n    let otimIniciado = false;\\n    function fecharOtim() {\\n      if (!otimAberto) return;\\n      const id = otimAberto;\\n      otimAberto = null;\\n      const k = document.getElementById('otimw');\\n      k.hidden = true;\\n      const sh = document.getElementById('otimShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    function initOtimizar(painel) {\\n      const root = document.getElementById('otimw');\\n      let conta = Number.isInteger(painel.conta) ? painel.conta : 0;\\n      let d = null;\\n      root.innerHTML = '<div class=\\\"ch\\\"><b>⚡ Otimizar a conta</b><button class=\\\"cfg-x\\\" id=\\\"otX\\\">×</button></div><div class=\\\"cb\\\" id=\\\"otBody\\\"></div>';\\n      document.getElementById('otX').onclick = () => painel.fechar();\\n      const fmtMem = (m) => (m == null ? '—' : m + ' MB');\\n      function draw() {\\n        if (!d) return;\\n        const body = document.getElementById('otBody');\\n        const pct = Math.max(4, Math.min(100, Math.round((d.mem || 0) / 8)));\\n        body.innerHTML = `<div class=\\\"ot-mem\\\"><small>MEMÓRIA AGORA</small><b>${fmtMem(d.mem)}</b><div class=\\\"ot-bar\\\"><i style=\\\"width:${pct}%\\\"></i></div></div>` +\\n          `<button class=\\\"btn go\\\" id=\\\"otAgora\\\">⚡ Otimizar agora</button>` +\\n          `<div class=\\\"ot-row\\\"><b>Ao abrir de novo</b><div class=\\\"ot-opts\\\">` +\\n          `<div class=\\\"ot-opt${d.pagina === 'atual' ? ' sel' : ''}\\\" data-pag=\\\"atual\\\">Na página em que estava</div>` +\\n          `<div class=\\\"ot-opt${d.pagina === 'inicio' ? ' sel' : ''}\\\" data-pag=\\\"inicio\\\">No endereço da conta</div></div></div>` +\\n          `<div class=\\\"ot-row\\\"><b>Otimizar sozinho</b><div class=\\\"ot-opts\\\">` +\\n          [0, 30, 60, 120, 300].map((m) => `<div class=\\\"ot-opt${d.auto === m ? ' sel' : ''}\\\" data-auto=\\\"${m}\\\">${m === 0 ? 'Desligado' : m < 60 ? m + ' min' : (m / 60) + 'h'}</div>`).join('') +\\n          `</div><small class=\\\"ot-vazio\\\">Se você estiver mexendo na conta na hora, ele espera o próximo ciclo.</small></div>` +\\n          `<div class=\\\"ot-row\\\"><b>Histórico</b><div class=\\\"ot-hist\\\">` +\\n          (d.hist.length ? d.hist.map((h) => `<div><span>${h.hora}</span><span>${fmtMem(h.antes)} → ${fmtMem(h.depois)}</span></div>`).join('')\\n            : '<div class=\\\"ot-vazio\\\">Ainda não otimizou essa conta.</div>') + `</div></div>`;\\n        document.getElementById('otAgora').onclick = async (ev) => {\\n          ev.target.disabled = true; ev.target.textContent = 'Otimizando...';\\n          await window.api.otimizarAgora(conta);\\n          d = await window.api.otimizarGet(conta);\\n          draw();\\n        };\\n        body.querySelectorAll('[data-pag]').forEach((b) => { b.onclick = () => { window.api.otimizarPagina(conta, b.dataset.pag); d.pagina = b.dataset.pag; draw(); }; });\\n        body.querySelectorAll('[data-auto]').forEach((b) => { b.onclick = () => { const m = Number(b.dataset.auto); window.api.otimizarAuto(conta, m); d.auto = m; draw(); }; });\\n      }\\n      async function refresh() { d = await window.api.otimizarGet(conta); draw(); }\\n      window.api.onOtimizarUpdate(() => refresh());\\n      window.__otimConta = (n) => { conta = n; refresh(); };\\n      window.__otimRefresh = refresh;\\n      refresh();\\n    }\\n    if (window.api.onOtimizarPanel) window.api.onOtimizarPanel((d) => {\\n      closeAll();\\n      if (otimAberto) fecharOtim();\\n      otimAberto = d.id;\\n      const sh = el('div'); sh.id = 'otimShade'; sh.onclick = () => fecharOtim();\\n      document.body.appendChild(sh);\\n      const k = document.getElementById('otimw');\\n      k.classList.add('panel');\\n      k.hidden = false;\\n      if (!otimIniciado) { otimIniciado = true; initOtimizar({ fechar: () => fecharOtim(), conta: d.conta }); }\\n      else { window.__otimConta(d.conta); window.__otimRefresh(); }\\n      const fit = () => {\\n        const r = k.getBoundingClientRect();\\n        const x = Math.max(8, Math.min(d.x, innerWidth - r.width - 8));\\n        let y = d.y;\\n        if (innerHeight > 100 && y + r.height > innerHeight - 8) y = Math.max(40, (d.up || innerHeight) - r.height);\\n        k.style.left = x + 'px';\\n        k.style.top = Math.max(40, Math.min(y, innerHeight - r.height - 8)) + 'px';\\n      };\\n      requestAnimationFrame(fit);\\n      window.addEventListener('resize', fit);\\n    });\\n    document.addEventListener('keydown', (e) => { if (otimAberto && e.key === 'Escape') { e.preventDefault(); fecharOtim(); } }, true);\\n\\n    // ---------- Auto Compra: painel que desce do botão ----------\\n    let cfgAberto = null;\\n    function fecharCfg() {\\n      if (!cfgAberto) return;\\n      const id = cfgAberto;\\n      cfgAberto = null;\\n      const c = document.getElementById('cfg');\\n      c.hidden = true;\\n      c.classList.remove('panel');\\n      const sh = document.getElementById('cfgShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    let cfgIniciado = false;\\n    if (window.api.onAutoCfg) window.api.onAutoCfg((d) => {\\n      closeAll();\\n      if (cfgAberto) fecharCfg();\\n      cfgAberto = d.id;\\n      const sh = el('div'); sh.id = 'cfgShade'; sh.onclick = () => fecharCfg();\\n      document.body.appendChild(sh);\\n      const c = document.getElementById('cfg');\\n      c.classList.add('panel');\\n      // liga/desliga desta conta (antes era um botão separado na barra)\\n      const acc = document.getElementById('cfgAcc');\\n      acc.hidden = !Number.isInteger(d.conta);\\n      document.getElementById('cfgAccNome').textContent = `Auto Compra ligada em ${d.nome || 'nesta conta'}`;\\n      document.getElementById('cfgAccSt').textContent = d.on ? (d.status ? 'Status: ' + d.status : 'Ligada') : 'Desligada: liga aqui para começar a comprar sozinho';\\n      const sw = document.getElementById('cfgAccOn');\\n      sw.checked = !!d.on;\\n      sw.onchange = () => {\\n        window.api.setAuto(d.conta, sw.checked);\\n        document.getElementById('cfgAccSt').textContent = sw.checked ? 'Ligada' : 'Desligada';\\n      };\\n      // ações que antes ficavam no menu \\\"Auto Compra\\\" da barra de cima\\n      const now = document.getElementById('cfgNow');\\n      now.hidden = !Number.isInteger(d.conta);\\n      now.textContent = 'Verificar agora';\\n      now.title = `Confere o estoque de ${d.nome || 'esta conta'} agora`;\\n      now.onclick = () => { window.api.autoRunNow(Number.isInteger(window.__cfgContaAtual) ? window.__cfgContaAtual : d.conta); fecharCfg(); };\\n      document.getElementById('cfgLog').onclick = () => window.api.autoLog();\\n      if (!cfgIniciado) {\\n        cfgIniciado = true;\\n        initConfig({ fechar: () => fecharCfg(), conta: Number.isInteger(d.conta) ? d.conta : 0 });\\n        // botão de fechar no cabeçalho do painel\\n        const x = el('button', 'cfg-x', '×', 'Fechar', () => fecharCfg());\\n        c.querySelector('.ch').appendChild(x);\\n      } else {\\n        c.hidden = false;\\n        if (window.__cfgConta) window.__cfgConta(Number.isInteger(d.conta) ? d.conta : 0);\\n      }\\n      // posição: embaixo do botão, sem sair da janela\\n      const fit = () => {\\n        const r = c.getBoundingClientRect();\\n        const x = Math.max(8, Math.min(d.x, innerWidth - r.width - 8));\\n        let y = d.y;\\n        if (innerHeight > 100 && y + r.height > innerHeight - 8) y = Math.max(40, (d.up || innerHeight) - r.height);\\n        c.style.left = x + 'px';\\n        c.style.top = Math.max(40, Math.min(y, innerHeight - r.height - 8)) + 'px';\\n      };\\n      requestAnimationFrame(fit);\\n      window.addEventListener('resize', fit);\\n    });\\n    document.addEventListener('keydown', (e) => { if (cfgAberto && e.key === 'Escape') { e.preventDefault(); fecharCfg(); } }, true);\\n\\n    // ---------- menuzinho de escolha (ex.: Desempenho) ----------\\n    let popCur = null;\\n    function closePopup(value) {\\n      if (!popCur) return;\\n      const id = popCur.id;\\n      popCur = null;\\n      const sh = document.getElementById('popShade'); if (sh) sh.remove();\\n      const pn = document.getElementById('popPanel'); if (pn) pn.remove();\\n      window.api.popupReply(id, value == null ? null : value);\\n    }\\n    if (window.api.onPopup) window.api.onPopup((d) => {\\n      closePopup(null);\\n      closeAll();\\n      popCur = d;\\n      const sh = el('div'); sh.id = 'popShade'; sh.onclick = () => closePopup(null);\\n      document.body.appendChild(sh);\\n      const p = el('div', 'dd pop'); p.id = 'popPanel';\\n      if (d.title) p.appendChild(el('div', 'pop-t')).textContent = d.title;\\n      if (d.sub) p.appendChild(el('div', 'pop-sub')).textContent = d.sub;\\n      d.items.forEach((it) => {\\n        const b = el('button', 'it pop-it' + (it.checked ? ' cur' : ''));\\n        b.innerHTML = '<span class=\\\"pop-ic\\\"></span><span class=\\\"pop-tx\\\"><b></b><small></small></span><span class=\\\"pop-ok\\\"></span>';\\n        b.querySelector('.pop-ic').textContent = it.icon || '';\\n        b.querySelector('b').textContent = it.label;\\n        b.querySelector('small').textContent = it.desc || '';\\n        b.querySelector('.pop-ok').textContent = it.checked ? '✓' : '';\\n        b.onclick = () => closePopup(it.value);\\n        p.appendChild(b);\\n      });\\n      document.body.appendChild(p);\\n      // posiciona: embaixo do botão; se não couber, em cima; nunca fora da janela\\n      const fit = () => {\\n        const r = p.getBoundingClientRect();\\n        let x = Math.min(d.x, innerWidth - r.width - 6);\\n        let y = d.y;\\n        if (innerHeight > 100 && y + r.height > innerHeight - 6 && d.up) y = d.up - r.height;\\n        p.style.left = Math.max(6, x) + 'px';\\n        p.style.top = Math.max(38, y) + 'px';\\n      };\\n      fit();\\n      window.addEventListener('resize', fit, { once: true });\\n      (p.querySelector('.pop-it.cur') || p.querySelector('.pop-it')).focus();\\n    });\\n    document.addEventListener('keydown', (e) => { if (popCur && e.key === 'Escape') { e.preventDefault(); closePopup(null); } }, true);\\n    // o app pode fechar um pop-up sozinho (ex.: \\\"gerando...\\\" quando termina)\\n    if (window.api.onDialogClose) window.api.onDialogClose((id) => {\\n      if (dlgCur && dlgCur.id === id) { answer(cancelOf(dlgCur)); return; }\\n      const k = dlgQueue.findIndex((d) => d.id === id);\\n      if (k >= 0) { const [d] = dlgQueue.splice(k, 1); window.api.dialogReply(d.id, cancelOf(d), null); }\\n    });\\n\\n    document.addEventListener('keydown', (e) => {\\n      if (dlgCur) {\\n        if (e.key === 'Escape') { e.preventDefault(); answer(cancelOf(dlgCur)); }\\n        return; // Enter aciona o botão em foco (o padrão já começa focado)\\n      }\\n      if (e.key === 'Escape') closeAll();\\n    });\\n    window.addEventListener('blur', closeAll); // trocou de janela (Alt+Tab): fecha\\n\\n    window.api.onTitleState((d) => {\\n      const { title, version, channel, icon, menus } = d;\\n      if (d.gear) { abrirEngrenagem(d.gear); return; } // vindo da engrenagem: só abre o menu, sem refazer a barra\\n      MENUS = menus;\\n      closeAll();\\n      tb.innerHTML = '';\\n      document.title = title;\\n      const brand = el('div', 'brand', iconHtml(icon) + '<b></b>');\\n      brand.querySelector('b').textContent = title;\\n      if (channel || version) {\\n        const v = el('span', 'ver', null, `Versão ${version}${channel ? ' (' + channel.toLowerCase() + ')' : ''}`);\\n        v.textContent = channel ? `${channel} ${version}` : `v${version}`;\\n        brand.appendChild(v);\\n      }\\n      tb.appendChild(brand);\\n      // os menus (Contas, Lives, Desempenho, PvP, Atualizações, Ajuda) agora ficam na engrenagem da barra de baixo\\n      tb.appendChild(el('button', 'ibtn', '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.4\\\" stroke-linecap=\\\"round\\\"><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"6.2\\\"/><path d=\\\"M8 7.2v3.6\\\"/><circle cx=\\\"8\\\" cy=\\\"5.1\\\" r=\\\".5\\\" fill=\\\"currentColor\\\" stroke=\\\"none\\\"/></svg>', 'Sobre o PokeLink', () => window.api.showAbout()));\\n      if (window.__badges) applyBadges(window.__badges);\\n    });\\n    // selos com números nos menus (ex.: lives abertas)\\n    function applyBadges(bd) {\\n      window.__badges = bd;\\n      tb.querySelectorAll('.mbtn').forEach((btn) => {\\n        const n = bd[btn.dataset.label];\\n        let s = btn.querySelector('.mb-badge');\\n        if (n > 0) { if (!s) { s = el('i', 'mb-badge'); btn.appendChild(s); } s.textContent = n > 99 ? '99+' : String(n); }\\n        else if (s) s.remove();\\n      });\\n    }\\n    if (window.api.onTitleBadges) window.api.onTitleBadges(applyBadges);\\n    window.api.titleReady();\\n  }\\n\\n  /* ----------------------------- barra ----------------------------- */\\n  const LEVEL_NAMES = ['Normal', 'Eco', 'Mega Eco'];\\n  const CHIPS = ['▶', '🍃', '📊', '💤'];\\n  const SVG = {\\n    cel: '<svg viewBox=\\\"0 0 16 16\\\"><rect x=\\\"4.2\\\" y=\\\"1.5\\\" width=\\\"7.6\\\" height=\\\"13\\\" rx=\\\"1.6\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.6\\\"/><path d=\\\"M7 12.2h2\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"/></svg>',\\n    reload: '<svg viewBox=\\\"0 0 16 16\\\"><path d=\\\"M13 8a5 5 0 1 1-1.6-3.7\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\"/><path d=\\\"M13.5 2.5v3.3h-3.3\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/></svg>',\\n    spark: '<svg viewBox=\\\"0 0 16 16\\\"><path d=\\\"M9 1L3.5 9h3.2l-.9 6L12 7H8.8z\\\" fill=\\\"#fff\\\"/></svg>',\\n    on: '<svg viewBox=\\\"0 0 16 16\\\"><path d=\\\"M2 6h3l4-3v10l-4-3H2z\\\" fill=\\\"#fff\\\"/><path d=\\\"M11 5.5a3.5 3.5 0 0 1 0 5M12.8 3.8a6 6 0 0 1 0 8.4\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.5\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/></svg>',\\n    off: '<svg viewBox=\\\"0 0 16 16\\\"><path d=\\\"M2 6h3l4-3v10l-4-3H2z\\\" fill=\\\"#fff\\\"/><path d=\\\"M11 5.5l4 5M15 5.5l-4 5\\\" stroke=\\\"#ff8a8a\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"/></svg>',\\n    expand: '<svg viewBox=\\\"0 0 16 16\\\"><path d=\\\"M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/></svg>',\\n    grid: '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"#fff\\\"><rect x=\\\"2\\\" y=\\\"2\\\" width=\\\"5\\\" height=\\\"5\\\" rx=\\\"1\\\"/><rect x=\\\"9\\\" y=\\\"2\\\" width=\\\"5\\\" height=\\\"5\\\" rx=\\\"1\\\"/><rect x=\\\"2\\\" y=\\\"9\\\" width=\\\"5\\\" height=\\\"5\\\" rx=\\\"1\\\"/><rect x=\\\"9\\\" y=\\\"9\\\" width=\\\"5\\\" height=\\\"5\\\" rx=\\\"1\\\"/></svg>',\\n    map: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\"><path d=\\\"M8 1.5a4.5 4.5 0 0 0-4.5 4.5c0 3.4 4.5 8.5 4.5 8.5s4.5-5.1 4.5-8.5A4.5 4.5 0 0 0 8 1.5z\\\" fill=\\\"#fff\\\"/><circle cx=\\\"8\\\" cy=\\\"6\\\" r=\\\"1.7\\\" fill=\\\"#54545d\\\"/></svg>',\\n    mapa: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.6\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"M1.5 3.5l4-1.5 5 2 4-1.5v10l-4 1.5-5-2-4 1.5z\\\"/><path d=\\\"M5.5 2v10M10.5 4v10\\\"/></svg>',\\n    olho: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.6\\\"><path d=\\\"M1 8s2.6-5 7-5 7 5 7 5-2.6 5-7 5-7-5-7-5z\\\"/><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"2.2\\\" fill=\\\"#fff\\\"/></svg>',\\n    olhoOff: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"><path d=\\\"M1 8s2.6-5 7-5 7 5 7 5-2.6 5-7 5-7-5-7-5z\\\"/><path d=\\\"M2 2l12 12\\\"/></svg>',\\n    mira: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\"><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"5.2\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.6\\\"/><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"1.6\\\" fill=\\\"#fff\\\"/><path d=\\\"M8 .8v3M8 12.2v3M.8 8h3M12.2 8h3\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"/></svg>',\\n    puzzle: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\"><path d=\\\"M6 1.5a1.6 1.6 0 0 1 3.2 0V3h3a1 1 0 0 1 1 1v3h-1.5a1.6 1.6 0 0 0 0 3.2H13.2v3a1 1 0 0 1-1 1h-3v-1.5a1.6 1.6 0 0 0-3.2 0V14.5h-3a1 1 0 0 1-1-1v-3h1.5a1.6 1.6 0 0 0 0-3.2H2V4a1 1 0 0 1 1-1h3z\\\" fill=\\\"#fff\\\"/></svg>',\\n    coin: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\"><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"6.5\\\" fill=\\\"#96f75a\\\" stroke=\\\"#163a00\\\" stroke-width=\\\"1.4\\\"/><path d=\\\"M8 4.5v7M6 6.2h3.2a1.3 1.3 0 0 1 0 2.6H6.8a1.3 1.3 0 0 0 0 2.6H10\\\" fill=\\\"none\\\" stroke=\\\"#163a00\\\" stroke-width=\\\"1.3\\\" stroke-linecap=\\\"round\\\"/></svg>',\\n    twitch: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\"><path d=\\\"M3 1.5h11v7.5l-3 3H8.5L6 14.5V12H3z\\\" fill=\\\"#fff\\\"/><path d=\\\"M7 4.5v3M10.5 4.5v3\\\" stroke=\\\"#6a3bc4\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"/></svg>',\\n    kick: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\"><path d=\\\"M2.5 1.5h3.5v4h1.5v-2h2v-2h4v4h-2v2h-2v1h2v2h2v4h-4v-2h-2v-2H6v4H2.5z\\\" fill=\\\"currentColor\\\"/></svg>',\\n    tv: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\"><rect x=\\\"1.5\\\" y=\\\"3.5\\\" width=\\\"13\\\" height=\\\"9\\\" rx=\\\"2\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.8\\\"/><path d=\\\"M5 1.5l3 2 3-2\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.5\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/><path d=\\\"M6.5 6v4l3.5-2z\\\" fill=\\\"#fff\\\"/></svg>',\\n    gear: '<svg viewBox=\\\"0 0 16 16\\\"><path fill=\\\"#fff\\\" d=\\\"M9.3 1.4l.3 1.8c.4.1.8.3 1.2.6l1.7-.7 1.4 2.4-1.4 1.2c.1.4.1.8 0 1.2l1.4 1.2-1.4 2.4-1.7-.7c-.4.3-.8.5-1.2.6l-.3 1.8H6.7l-.3-1.8c-.4-.1-.8-.3-1.2-.6l-1.7.7-1.4-2.4 1.4-1.2a4 4 0 0 1 0-1.2L2.1 4.9l1.4-2.4 1.7.7c.4-.3.8-.5 1.2-.6l.3-1.8z\\\"/><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"2.1\\\" fill=\\\"#54545d\\\"/></svg>',\\n  };\\n\\n  function el(tag, cls, html, title, onclick) {\\n    const e = document.createElement(tag);\\n    if (cls) e.className = cls;\\n    if (html != null) e.innerHTML = html;\\n    if (title) e.title = title;\\n    if (onclick) e.onclick = onclick;\\n    return e;\\n  }\\n  const group = (cls) => el('div', 'grp ' + cls);\\n\\n  const NOME_NIVEL = ['Normal', 'Eco', 'Mega Eco', 'Hibernando'];\\n  function render({ level, names, auto, focused, sel, muted, pos, lives, loading, extBtns, hunt, celular, mem }) {\\n    app.innerHTML = '';\\n    document.body.classList.toggle('bottom', !!pos && pos[I] === 'bottom' && focused === -1); // ampliado: a faixa fica sempre em cima\\n    const zoomed = focused !== -1;\\n    const esc = (t) => String(t == null ? '' : t).replace(/[&<>\\\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;' }[c]));\\n    // na grade (fora do painel da direita), a telinha de cada conta mostra só o essencial — nome, status\\n    // e memória. Auto Compra, Troca de hunt, Twitch e Kick ficam só no painel Otimizar à direita, selecionando\\n    // a conta na lista; assim não fica repetido nas 4 telinhas ao mesmo tempo.\\n    const completo = MODE === 'otimside';\\n\\n    // 1) telinha da grade: bolinha de modo + nome + modo, e à direita memória + recarregar + ampliar\\n    if (!completo) {\\n      document.body.classList.add('tile');\\n      document.body.classList.toggle('zoom', zoomed); // desliga na volta para a grade, senão o estilo do ampliado fica preso\\n      document.body.classList.toggle('sel', !zoomed && sel === I); // a conta mostrada no painel da direita fica destacada\\n      const modo = Number.isInteger(level[I]) ? level[I] : 0;\\n      const mm = mem && mem[I] != null ? mem[I] : null;\\n      const nivelMem = mm == null ? '' : mm < 400 ? 'ok' : mm < 700 ? 'med' : 'alto';\\n      const busy = !!(loading && loading[I]);\\n      const idBtn = el('button', 'tl-id',\\n        `<span class=\\\"tl-dot m${modo}\\\"></span><b class=\\\"tl-nome\\\">${esc(names[I])}</b><span class=\\\"tl-st\\\">${NOME_NIVEL[modo] || 'Normal'}</span>`,\\n        'Selecionar esta conta (mostra os detalhes à direita)', () => window.api.contaSelecionar(I));\\n      app.appendChild(idBtn);\\n      const dir = el('div', 'tl-dir');\\n      if (mm != null && modo !== 3) dir.appendChild(el('span', 'tl-mem nivel-' + nivelMem, mm + ' MB'));\\n      dir.appendChild(el('button', 'tl-ic' + (busy ? ' spin' : ''), SVG.reload,\\n        busy ? 'Carregando...' : 'Recarregar esta conta', () => window.api.reload(I)));\\n      dir.appendChild(zoomed\\n        ? el('button', 'tl-ic', SVG.grid, 'Voltar para as 4 contas', () => window.api.setView(-1))\\n        : el('button', 'tl-ic', SVG.expand, 'Ampliar esta conta', () => window.api.setView(I)));\\n      app.appendChild(dir); // memória + recarregar + ampliar (no modo ampliado são levados para a segunda linha)\\n      if (zoomed) {\\n        // ampliado (como no IdleDeck): faixa com as abas das contas + \\\"Sair do foco\\\", e embaixo o cabeçalho da conta\\n        document.body.classList.add('zoom');\\n        const ICO_SAIR = '<svg viewBox=\\\"0 0 16 16\\\"><path d=\\\"M6 2v4H2M10 2v4h4M14 10h-4v4M2 10h4v4\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.8\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/></svg>';\\n        const tabs = el('div', 'zm-tabs');\\n        const grp = el('div', 'zm-grp');\\n        names.forEach((nm, k) => {\\n          const lv = Number.isInteger(level[k]) ? level[k] : 0;\\n          grp.appendChild(el('button', 'zm-tab' + (k === I ? ' on' : ''),\\n            `<span class=\\\"tl-dot m${lv}\\\"></span><span class=\\\"zm-nm\\\">${esc(nm)}</span>`,\\n            `${nm} · ${NOME_NIVEL[lv] || 'Normal'}`, () => { if (k !== I) window.api.setView(k); }));\\n        });\\n        tabs.appendChild(grp);\\n        tabs.appendChild(el('button', 'zm-sair', `${ICO_SAIR}<span>Sair do foco</span>`, 'Voltar para as 4 contas', () => window.api.setView(-1)));\\n        const head = el('div', 'zm-head');\\n        head.appendChild(idBtn); // bolinha + nome + modo\\n        head.appendChild(dir);   // memória + ícones\\n        const wrap = el('div', 'zm-wrap');\\n        wrap.appendChild(tabs);\\n        wrap.appendChild(head);\\n        app.appendChild(wrap);\\n        return;\\n      }\\n      return;\\n    }\\n\\n    // 2) jogo: desempenho + auto compra (com a engrenagem colada)\\n    const lv = level[I];\\n    const on = !!(auto && auto.enabled[I]);\\n    const mid = group('mid');\\n    // o modo de desempenho fica na barra de cima (menu Desempenho); aqui só a cena desta conta\\n    if (level[I] === 0 || level[I] === 1) {\\n      const eco = level[I] === 1;\\n      mid.appendChild(el('button', 'btn cena' + (eco ? '' : ' on'),\\n        `<span class=\\\"chip\\\">${eco ? SVG.olhoOff : SVG.olho}</span><span class=\\\"lbl\\\">${eco ? 'Ligar a cena' : 'Cena ligada'}</span>`,\\n        eco ? 'Esta conta está em Eco (cena desligada). Clique para ver o jogo nesta tela.' : 'Mostrando o jogo. Clique para desligar a cena desta conta (Eco).',\\n        () => window.api.cenaToggle(I)));\\n    }\\n    // um botão só: mostra se está ligada e abre o painel (com o liga/desliga e as regras)\\n    // botão dividido: clicar no nome liga/desliga; clicar na setinha (depois da barrinha) abre as configurações\\n    mid.appendChild(el('button', 'btn auto split' + (on ? ' on' : ''),\\n      `<span class=\\\"coin\\\"></span><span class=\\\"lbl\\\">Auto Compra</span><span class=\\\"split-c\\\" title=\\\"Configurar\\\">▼</span>`,\\n      'Auto Compra: ' + (on ? 'ligada' : 'desligada') + (auto && auto.status[I] ? '\\\\nStatus: ' + auto.status[I] : '') +\\n        '\\\\nClique para ' + (on ? 'desligar' : 'ligar') + ' · setinha: configurações',\\n      (ev) => {\\n        const r = ev.currentTarget.getBoundingClientRect();\\n        if (ev.target.closest('.split-c')) window.api.openAutoConfig({ left: r.left, top: r.top, bottom: r.bottom });\\n        else window.api.setAuto(I, !on);\\n      }));\\n    // troca de hunt automática: nome liga/desliga nesta conta · setinha abre as configurações\\n    if (hunt) {\\n      const hon = !!(hunt.on && hunt.on[I]);\\n      mid.appendChild(el('button', 'btn hunt split' + (hon ? ' on' : ''),\\n        `<span class=\\\"chip\\\">${SVG.mapa}</span><span class=\\\"lbl\\\">Troca de hunt</span><span class=\\\"split-c\\\" title=\\\"Configurar\\\">▼</span>`,\\n        'Troca de hunt automática: ' + (hon ? 'ligada' : 'desligada') + (hunt.status && hunt.status[I] ? '\\\\nStatus: ' + hunt.status[I] : '') +\\n          '\\\\nClique para ' + (hon ? 'desligar' : 'ligar') + ' · setinha: configurações',\\n        (ev) => {\\n          if (ev.target.closest('.split-c')) window.api.huntPanel();\\n          else window.api.huntSet({ conta: I, on: !hon });\\n        }));\\n    }\\n    app.appendChild(el('div', 'ot-sec ot-sec-auto', 'Automações'));\\n    app.appendChild(mid);\\n\\n    // 3) lives: Twitch e Kick (+ moedinha dos pontos da Kick)\\n    if (lives) {\\n      const o = (lives.open && lives.open[I]) || { twitch: [], kick: [] };\\n      app.appendChild(el('div', 'sep'));\\n      app.appendChild(el('div', 'ot-sec ot-sec-auto ot-sec-live', 'Live'));\\n      const lg = group('livesg');\\n      [\\n        ['twitch', 'Twitch', SVG.twitch, 'o bônus de XP da Twitch'],\\n        ['kick', 'Kick', SVG.kick, 'juntar os pontos dos canais da Kick'],\\n      ].forEach(([p, nm, ico, para]) => {\\n        const lon = !!(lives[p] && lives[p][I]);\\n        const lst = o[p] || [];\\n        const tip = lon\\n          ? `${nm} ligada (clique para desligar)\\\\nAbertas: ${lst.join(', ') || 'nenhuma ao vivo agora'}` + (lives.checked ? '' : '\\\\nVerificando quem está ao vivo...')\\n          : `Abrir as lives oficiais da ${nm} automaticamente, mutadas, para ${para}`;\\n        // Twitch: clique liga/desliga. Kick: um botão só, que abre o painel (liga/desliga + pontos + resgate)\\n        // Kick: botão dividido (nome liga/desliga · setinha abre os pontos e o resgate)\\n        lg.appendChild(el('button', `btn lives ${p}` + (lon ? ' on' : '') + ' split',\\n          `<span class=\\\"chip\\\">${ico}</span><span class=\\\"lbl\\\">${nm}${lon ? ' <b>' + lst.length + '</b>' : ''}</span>${lon ? '<span class=\\\"rec\\\"></span>' : ''}` +\\n            '<span class=\\\"split-c\\\" title=\\\"Pontos e resgate\\\">▼</span>',\\n          tip + '\\\\nSetinha: pontos, resgate e canais',\\n          (ev) => {\\n            if (ev.target.closest('.split-c')) {\\n              if (p === 'twitch') { window.api.twitchOpen(); return; }\\n              const r = ev.currentTarget.getBoundingClientRect();\\n              window.api.kickOpen(I, { left: r.left, top: r.top, bottom: r.bottom });\\n            } else window.api.setLives(I, p, !lon);\\n          }));\\n      });\\n      app.appendChild(lg);\\n    }\\n\\n    // 4) ações (encostadas na direita): extensões, recarregar, som, ampliar/grade\\n    const right = group('right');\\n    // painel da direita: ações rápidas em quadrados arredondados com rótulo embaixo (estilo \\\"Início/Recarregar/Som/Destacar\\\")\\n    right.className = 'grp right qa-grid';\\n    const busy = !!(loading && loading[I]);\\n    const qa = (svg, label, title, onclick, extraCls) => right.appendChild(el('button', 'qa-btn' + (extraCls ? ' ' + extraCls : ''),\\n      `<span class=\\\"qa-ico\\\">${svg}</span><span class=\\\"qa-lbl\\\">${label}</span>`, title, onclick));\\n    qa(SVG.reload, 'Recarr.', busy ? 'Carregando...' : 'Recarregar esta conta', () => window.api.reload(I), busy ? 'spin' : '');\\n    qa(muted && muted[I] ? SVG.off : SVG.on, muted && muted[I] ? 'Mudo' : 'Som', muted && muted[I] ? 'Som desligado (clique para ligar)' : 'Som ligado (clique para silenciar)', () => window.api.toggleMute(I));\\n    qa(SVG.cel, 'Celular', 'Ver no celular' + (celular ? ' (ligado)' : ' (desligado)') + ': resumo das contas no celular', () => window.api.monitorPanel(), celular ? 'on' : '');\\n    (extBtns || []).forEach((x) => { qa(SVG.mira, esc(x.botao || x.nome), `${x.nome}: abrir nesta conta`, () => window.api.openExt(I, x.id)); });\\n    app.appendChild(right);\\n  }\\n\\n  // ---------- modo Ampliar: lista de contas (esquerda) ----------\\n  // ---------- ajudantes das duas barras laterais ----------\\n  const AV_CORES = ['#7a3a9a', '#2f6b9a', '#1d6b3a', '#9a582f', '#8a2a5a', '#4a4a9a', '#9a2f2f', '#2f9a8a'];\\n  const iniciaisDe = (nome) => (String(nome || '?').replace(/[^A-Za-zÀ-ÿ0-9]/g, '').slice(0, 2).toUpperCase() || '?');\\n  const MODOS = ['Normal', 'Eco', 'Mega Eco', 'Hibernando'];\\n  const LOGO = '<svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"9\\\"/><path d=\\\"M3 12h5.5M15.5 12H21\\\"/><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"3.2\\\" fill=\\\"currentColor\\\" stroke=\\\"none\\\"/></svg>';\\n  const ICO_EXPANDIR = (dir) => `<svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"${dir === 'dir' ? 'M6 6l6 6-6 6M13 6l6 6-6 6' : 'M18 6l-6 6 6 6M11 6l-6 6 6 6'}\\\"/></svg>`;\\n\\n  // ---------- modo Ampliar: lista de contas (esquerda) ----------\\n  function initSidebar() {\\n    document.body.classList.add('sidebar');\\n    document.title = 'PokeLink';\\n    app.hidden = true;\\n    const root = el('div', 'sd-wrap');\\n    const rail = el('div', 'rail');\\n    document.body.appendChild(root);\\n    document.body.appendChild(rail);\\n    const esc = (t) => String(t == null ? '' : t).replace(/[&<>\\\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;' }[c]));\\n    const fmtMem = (m) => (m == null ? '—' : m + ' MB');\\n    const fmtTot = (m) => (m >= 1000 ? (m / 1000).toFixed(1).replace('.', ',') + ' GB' : Math.round(m) + ' MB');\\n    const modoDe = (c) => (Number.isInteger(c.modo) && c.modo >= 0 && c.modo <= 3 ? c.modo : 0);\\n    // na grade, clicar só escolhe de qual conta mostrar os detalhes à direita; ampliado, troca a conta mesmo\\n    const escolher = (d, i) => (d.grade ? window.api.contaSelecionar(i) : window.api.setView(i));\\n\\n    function desenharRail(d) {\\n      const ligadas = d.contas.filter((c) => modoDe(c) !== 3).length;\\n      const total = d.contas.reduce((s, c) => s + (c.mem || 0), 0);\\n      rail.innerHTML = '';\\n      const b = (cls, html, title, fn) => rail.appendChild(el('button', cls, html, title, fn));\\n      b('rl-btn logo', LOGO, 'PokeLink — mostrar a lista de contas', () => window.api.sideladoToggle('left'));\\n      b('rl-btn all' + (d.grade ? ' cur' : ''), 'PL', `Todas as contas · ${ligadas} ligadas · ${fmtTot(total)}`, () => window.api.setView(-1));\\n      rail.appendChild(el('div', 'rl-sep'));\\n      d.contas.forEach((c, i) => {\\n        const modo = modoDe(c);\\n        b('rl-ct' + (i === d.atual ? ' cur' : '') + (modo === 3 ? ' off' : ''),\\n          `<span class=\\\"sd-av\\\" style=\\\"background:${AV_CORES[i % AV_CORES.length]}\\\">${esc(iniciaisDe(c.nome))}<i class=\\\"sd-dot m${modo}\\\"></i></span>`,\\n          `${c.nome} · ${MODOS[modo]}${c.mem != null && modo !== 3 ? ' · ' + c.mem + ' MB' : ''}`, () => escolher(d, i));\\n      });\\n      rail.appendChild(el('div', 'rl-spacer'));\\n      b('rl-btn', ICO_EXPANDIR('dir'), 'Mostrar a lista de contas', () => window.api.sideladoToggle('left'));\\n    }\\n\\n    function draw(d) {\\n      if (!d) return;\\n      const aberto = d.leftOpen !== false;\\n      document.body.classList.toggle('fechado', !aberto);\\n      if (!aberto) { desenharRail(d); return; }\\n      const ligadas = d.contas.filter((c) => modoDe(c) !== 3).length;\\n      const total = d.contas.reduce((s, c) => s + (c.mem || 0), 0);\\n      const resumo = `${ligadas} ${ligadas === 1 ? 'ligada' : 'ligadas'} · ${fmtTot(total)}`;\\n      root.innerHTML =\\n        `<div class=\\\"sd-top\\\"><span class=\\\"sd-logo\\\">${LOGO}</span><b>PokeLink</b>` +\\n        `<button class=\\\"sd-collapse\\\" id=\\\"sdCol\\\" title=\\\"Esconder a lista de contas\\\">«</button></div>` +\\n        `<button class=\\\"sd-all${d.grade ? ' cur' : ''}\\\" id=\\\"sdAll\\\" title=\\\"Ver as 4 contas juntas\\\">` +\\n        `<span class=\\\"sd-av\\\">PL</span><span class=\\\"sd-txt\\\"><b>Todas as contas</b><span class=\\\"sd-sub\\\">${esc(resumo)}</span></span></button>` +\\n        `<div class=\\\"sd-grp\\\"><div class=\\\"sd-gh\\\"><span class=\\\"sd-gdot${ligadas ? '' : ' off'}\\\"></span>` +\\n        `<div><b>PokeIdle</b><small>${d.contas.length} contas · ${esc(fmtTot(total))}</small></div></div>` +\\n        d.contas.map((c, i) => {\\n          const modo = modoDe(c);\\n          const nivel = c.mem == null ? '' : c.mem < 400 ? 'ok' : c.mem < 700 ? 'med' : 'alto';\\n          return `<button class=\\\"sd-row${i === d.atual ? ' cur' : ''}${modo === 3 ? ' off' : ''}\\\" data-ct=\\\"${i}\\\">` +\\n            `<span class=\\\"sd-av\\\" style=\\\"background:${AV_CORES[i % AV_CORES.length]}\\\">${iniciaisDe(c.nome)}<i class=\\\"sd-dot m${modo}\\\"></i></span>` +\\n            `<span class=\\\"sd-txt\\\"><span class=\\\"sd-nm\\\">${esc(c.nome)}</span><span class=\\\"sd-sub\\\">${MODOS[modo]}</span></span>` +\\n            `<span class=\\\"sd-mm nivel-${nivel}\\\">${modo === 3 ? '' : fmtMem(c.mem)}</span>` +\\n            `<span class=\\\"sd-rl\\\" data-rl=\\\"${i}\\\" title=\\\"Recarregar esta conta\\\">⟳</span></button>`;\\n        }).join('') + `</div>`;\\n      document.getElementById('sdCol').onclick = () => window.api.sideladoToggle('left');\\n      document.getElementById('sdAll').onclick = () => window.api.setView(-1);\\n      root.querySelectorAll('[data-ct]').forEach((b) => {\\n        const i = Number(b.dataset.ct);\\n        b.onclick = (ev) => {\\n          if (ev.target.closest('.sd-rl')) { window.api.reload(i); return; }\\n          escolher(d, i);\\n        };\\n      });\\n    }\\n    window.api.onTitleFoco(draw);\\n  }\\n\\n  // ---------- modo Ampliar: painel Otimizar (direita), com a barra da conta reaproveitada em cima ----------\\n  function initOtimSide() {\\n    document.body.classList.add('otimside');\\n    document.title = 'PokeLink';\\n    const col = el('div', 'ot-col'); // cabeçalho + barra reaproveitada (app) + Otimizar + rodapé fixo\\n    const rail = el('div', 'rail');\\n    document.body.appendChild(col);\\n    document.body.appendChild(rail);\\n    const head = el('div', 'ot-head');\\n    col.appendChild(head);\\n    col.appendChild(app); // tira o #app de onde estava e bota dentro da coluna, empilhado\\n    const root = el('div', 'ot-wrap');\\n    col.appendChild(root);\\n    const foot = el('div', 'ot-foot');\\n    col.appendChild(foot);\\n    const esc = (s) => String(s == null ? '' : s).replace(/[&<>\\\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;' }[c]));\\n    const fmtMem = (m) => (m == null ? '—' : m + ' MB');\\n    const ICO_RELOGIO = '<svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"9\\\"/><path d=\\\"M12 7v5l3 2\\\"/></svg>';\\n    const ICO_PAGINA = '<svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"M4 12a8 8 0 0 1 14-5.3L20 9\\\"/><path d=\\\"M20 4v5h-5\\\"/><path d=\\\"M20 12a8 8 0 0 1-14 5.3L4 15\\\"/><path d=\\\"M4 20v-5h5\\\"/></svg>';\\n    const ICO_ECO = '<svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"M5 19c0-9 5-14 14-14 0 9-5 14-14 14z\\\"/><path d=\\\"M5 19l8-8\\\"/></svg>';\\n    const ICO_MEGA = '<svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"M5 20V11M12 20V5M19 20v-7\\\"/></svg>';\\n    let conta = 0;\\n    let ultimoEstado = null;\\n    let abertoAuto = false, abertoPag = false, abertoComo = false; // sobrevivem ao redesenho (o painel redesenha a cada 5 s)\\n\\n    // ----- histórico de consumo (últimos 5 min = 60 amostras de 5 s), por conta, só na memória desta janela -----\\n    const SLOTS = 60;\\n    const hist = {};\\n    let ultimaAmostra = 0;\\n    async function amostrar() {\\n      const agora = Date.now();\\n      if (agora - ultimaAmostra < 4000) return; // o aviso chega a cada 5 s; evita amostra dupla\\n      ultimaAmostra = agora;\\n      let u = null;\\n      try { u = await window.api.usoGet(); } catch (e) { u = null; }\\n      if (!u || !u.contas) return;\\n      u.contas.forEach((c, i) => {\\n        const h = hist[i] || (hist[i] = []);\\n        h.push({ mem: Number(c.mem) || 0, cpu: Number(c.cpu) || 0 });\\n        if (h.length > SLOTS) h.shift();\\n      });\\n      desenharGraficos();\\n    }\\n    // a linha ocupa a largura toda desde as primeiras amostras (como no IdleDeck)\\n    function sparkline(vals, cor, piso, topoMin) {\\n      if (vals.length < 3) return '<div class=\\\"vazio\\\">coletando dados...</div>';\\n      const W = 220, H = 54, pad = 4;\\n      let lo = Math.min(...vals), hi = Math.max(...vals);\\n      if (piso != null) lo = Math.min(lo, piso);\\n      if (topoMin != null) hi = Math.max(hi, topoMin);\\n      if (hi - lo < 1e-6) hi = lo + 1;\\n      const marg = (hi - lo) * 0.15; if (piso == null) lo -= marg; hi += marg;\\n      const x = (k) => (k / (vals.length - 1)) * W;\\n      const y = (v) => pad + (1 - (v - lo) / (hi - lo)) * (H - pad * 2);\\n      const pts = vals.map((v, k) => `${x(k).toFixed(1)},${y(v).toFixed(1)}`);\\n      const id = 'g' + cor.replace('#', '');\\n      return `<svg viewBox=\\\"0 0 ${W} ${H}\\\" preserveAspectRatio=\\\"none\\\" aria-hidden=\\\"true\\\">` +\\n        `<defs><linearGradient id=\\\"${id}\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"0\\\" y2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"${cor}\\\" stop-opacity=\\\".30\\\"/><stop offset=\\\"1\\\" stop-color=\\\"${cor}\\\" stop-opacity=\\\".02\\\"/></linearGradient></defs>` +\\n        `<polygon points=\\\"0,${H} ${pts.join(' ')} ${W},${H}\\\" fill=\\\"url(#${id})\\\"/>` +\\n        `<polyline points=\\\"${pts.join(' ')}\\\" fill=\\\"none\\\" stroke=\\\"${cor}\\\" stroke-width=\\\"1.6\\\" stroke-linejoin=\\\"round\\\" stroke-linecap=\\\"round\\\" vector-effect=\\\"non-scaling-stroke\\\"/></svg>`;\\n    }\\n    function desenharGraficos() {\\n      const box = root.querySelector('#otGraf');\\n      if (!box) return;\\n      const h = hist[conta] || [];\\n      const ult = h[h.length - 1];\\n      const seg = Math.max(0, (h.length - 1) * 5);\\n      const tT = root.querySelector('#otGrafT');\\n      if (tT) tT.textContent = 'Consumo nos últimos ' + (h.length < 3 ? '5 min' : seg < 60 ? seg + ' seg' : Math.round(seg / 60) + ' min');\\n      const cpuTxt = ult ? ult.cpu.toFixed(1).replace('.', ',') + '%' : '—';\\n      box.innerHTML =\\n        `<div class=\\\"ot-graf\\\"><div class=\\\"ot-graf-top\\\"><span>Memória</span><b>${ult ? fmtMem(Math.round(ult.mem)) : '—'}</b></div>${sparkline(h.map((s) => s.mem), '#53fc18', null, null)}</div>` +\\n        `<div class=\\\"ot-graf\\\"><div class=\\\"ot-graf-top\\\"><span>CPU</span><b>${cpuTxt}</b></div>${sparkline(h.map((s) => s.cpu), '#5ad1c4', 0, 5)}</div>`;\\n    }\\n\\n    // ----- cabeçalho: nome da conta + modo atual -----\\n    function desenharCabecalho() {\\n      const s = ultimoEstado;\\n      if (!s) return;\\n      const nome = (s.names && s.names[conta]) || ('Conta ' + (conta + 1));\\n      const modo = NOME_NIVEL[s.level && s.level[conta]] || 'Normal';\\n      const m = s.mem && s.mem[conta] != null ? ' · ' + s.mem[conta] + ' MB' : '';\\n      head.innerHTML = `<button class=\\\"ot-fechar\\\" id=\\\"otFechar\\\" title=\\\"Esconder este painel\\\">»</button>` +\\n        `<div class=\\\"ot-head-t\\\"><b>${esc(nome)}</b><small><i></i>${esc(modo)}${esc(m)}</small></div>`;\\n      document.getElementById('otFechar').onclick = () => window.api.sideladoToggle('right');\\n    }\\n\\n    // ----- rodapé fixo: Foco (ampliar/grade) + modos de desempenho (valem para todas as contas) -----\\n    const bFoco = el('button', 'of-btn primary', '', '', () => {\\n      const z = !!(ultimoEstado && ultimoEstado.focused !== -1);\\n      window.api.setView(z ? -1 : conta);\\n    });\\n    const alternar = (lv) => () => {\\n      const atualLv = ultimoEstado && ultimoEstado.level ? ultimoEstado.level[conta] : 0;\\n      window.api.setLevel(conta, atualLv === lv ? 0 : lv);\\n    };\\n    const bEco = el('button', 'of-btn', `${ICO_ECO}<span>Eco</span>`,\\n      'Eco: liga o Modo Economia do jogo (vale para todas as contas). Clique de novo para voltar ao Normal.', alternar(1));\\n    const bMega = el('button', 'of-btn', `${ICO_MEGA}<span>Mega Eco</span>`,\\n      'Mega Eco: troca as telas por um painel com o resumo do farm; os jogos continuam rodando (todas as contas). Clique de novo para voltar ao Normal.', alternar(2));\\n    foot.appendChild(bFoco); foot.appendChild(bEco); foot.appendChild(bMega);\\n    function desenharRodape() {\\n      const s = ultimoEstado;\\n      const z = !!(s && s.focused !== -1);\\n      bFoco.innerHTML = `${z ? SVG.grid : SVG.expand}<span>${z ? 'Grade' : 'Foco'}</span>`;\\n      bFoco.title = z ? 'Voltar para as 4 contas' : 'Ampliar esta conta';\\n      const lv = s && s.level ? s.level[conta] : 0;\\n      bEco.classList.toggle('on', lv === 1);\\n      bMega.classList.toggle('on', lv === 2);\\n    }\\n\\n    const ICO_RAIO = '<svg viewBox=\\\"0 0 24 24\\\" fill=\\\"currentColor\\\"><path d=\\\"M13 2 4 14h6l-1 8 9-12h-6z\\\"/></svg>';\\n    // barra recolhida: a conta atual + ações rápidas, só ícones (a dica mostra o nome)\\n    function desenharRail() {\\n      const s = ultimoEstado;\\n      if (!s) return;\\n      const modo = Number.isInteger(s.level && s.level[conta]) ? s.level[conta] : 0;\\n      const nome = (s.names && s.names[conta]) || ('Conta ' + (conta + 1));\\n      const z = s.focused !== -1;\\n      const mudo = !!(s.muted && s.muted[conta]);\\n      rail.innerHTML = '';\\n      const b = (cls, html, title, fn) => { const x = el('button', 'rl-btn' + (cls ? ' ' + cls : ''), html, title, fn); rail.appendChild(x); return x; };\\n      rail.appendChild(el('button', 'rl-ct', `<span class=\\\"sd-av\\\" style=\\\"background:${AV_CORES[conta % AV_CORES.length]}\\\">${esc(iniciaisDe(nome))}<i class=\\\"sd-dot m${modo}\\\"></i></span>`,\\n        `${nome} · ${MODOS[modo]} — mostrar o painel`, () => window.api.sideladoToggle('right')));\\n      rail.appendChild(el('div', 'rl-sep'));\\n      b('', SVG.reload, 'Recarregar esta conta', () => window.api.reload(conta));\\n      b(mudo ? '' : 'on', mudo ? SVG.off : SVG.on, mudo ? 'Som desligado (clique para ligar)' : 'Som ligado (clique para silenciar)', () => window.api.toggleMute(conta));\\n      b(s.celular ? 'on' : '', SVG.cel, 'Ver no celular' + (s.celular ? ' (ligado)' : ' (desligado)'), () => window.api.monitorPanel());\\n      (s.extBtns || []).forEach((x) => b('', SVG.mira, `${x.nome}: abrir nesta conta`, () => window.api.openExt(conta, x.id)));\\n      rail.appendChild(el('div', 'rl-sep'));\\n      const bo = b('', ICO_RAIO, 'Otimizar esta conta (libera a memória acumulada)', async () => {\\n        if (bo.classList.contains('spin')) return;\\n        bo.classList.add('spin');\\n        try { await window.api.otimizarAgora(conta); } catch (e) { /* segue */ }\\n        bo.classList.remove('spin');\\n      });\\n      b('', z ? SVG.grid : SVG.expand, z ? 'Voltar para as 4 contas' : 'Ampliar esta conta (Foco)', () => window.api.setView(z ? -1 : conta));\\n      b(modo === 1 ? 'sel' : '', ICO_ECO, 'Eco (todas as contas)', alternar(1));\\n      b(modo === 2 ? 'sel' : '', ICO_MEGA, 'Mega Eco (todas as contas)', alternar(2));\\n      rail.appendChild(el('div', 'rl-spacer'));\\n      b('', ICO_EXPANDIR('esq'), 'Mostrar o painel', () => window.api.sideladoToggle('right'));\\n    }\\n\\n    // redesenhar tudo a cada 5 s gerava lixo no Chromium (medido: +10 MB/min); só redesenha se algo MUDOU (a memória não entra aqui: ela só aparece no cabeçalho)\\n    let sigRender = '';\\n    const renderSeMudou = () => {\\n      if (!ultimoEstado) return;\\n      const sg = JSON.stringify(Object.assign({}, ultimoEstado, { mem: null })) + '|' + conta;\\n      if (sg !== sigRender) { sigRender = sg; render(ultimoEstado); }\\n    };\\n    window.api.onState((s) => { ultimoEstado = s; renderSeMudou(); desenharCabecalho(); desenharRodape(); if (document.body.classList.contains('fechado')) desenharRail(); });\\n    window.api.ready();\\n\\n    let ultimaSigOt = '';\\n    const LBL_AUTO = { 0: 'desligado', 30: 'a cada 30 min', 60: 'a cada 1 h', 120: 'a cada 2 h', 300: 'a cada 5 h' };\\n    const LBL_PAG = { atual: 'página atual', inicio: 'início' };\\n    async function drawOt() {\\n      const otim = await window.api.otimizarGet(conta);\\n      if (!otim) return;\\n      // nada mudou desde o último desenho (o gráfico é atualizado à parte): não refaz a tela toda\\n      const sigOt = JSON.stringify([otim.hist, otim.pagina, otim.auto, abertoAuto, abertoPag, abertoComo, conta]);\\n      if (sigOt === ultimaSigOt && root.querySelector('#otAgora')) { desenharGraficos(); return; }\\n      ultimaSigOt = sigOt;\\n      const opcAuto = [0, 30, 60, 120, 300].map((m) => `<div class=\\\"ot-opt${otim.auto === m ? ' sel' : ''}\\\" data-auto=\\\"${m}\\\">${m === 0 ? 'Desligado' : m < 60 ? m + ' min' : (m / 60) + ' h'}</div>`).join('');\\n      const opcPag = `<div class=\\\"ot-opt${otim.pagina === 'atual' ? ' sel' : ''}\\\" data-pag=\\\"atual\\\">Página atual</div><div class=\\\"ot-opt${otim.pagina === 'inicio' ? ' sel' : ''}\\\" data-pag=\\\"inicio\\\">Início</div>`;\\n      const hist5 = otim.hist.length\\n        ? otim.hist.map((h) => `<div><span>${esc(h.hora)}</span><span>${fmtMem(h.antes)} → ${fmtMem(h.depois)}</span></div>`).join('')\\n        : '<div class=\\\"ot-vazio\\\">Ainda não otimizou essa conta.</div>';\\n      root.innerHTML =\\n        `<div class=\\\"ot-bloco\\\"><div class=\\\"ot-sec\\\" id=\\\"otGrafT\\\">Consumo nos últimos 5 min</div><div id=\\\"otGraf\\\"></div></div>` +\\n        `<div class=\\\"ot-bloco\\\"><div class=\\\"ot-sec ot-sec-row\\\"><span>Otimizar</span><button class=\\\"ot-link\\\" id=\\\"otComo\\\">? Como funciona</button></div>` +\\n        (abertoComo ? `<div class=\\\"ot-como\\\">Recarrega só o jogo desta conta, mantendo o login, para liberar a memória que ele foi acumulando. Dá para agendar para fazer sozinho.</div>` : '') +\\n        `<button class=\\\"ot-big\\\" id=\\\"otAgora\\\"><span class=\\\"ot-big-ico\\\">⚡</span><span><b>Otimizar</b><small>Libera a memória acumulada</small></span></button>` +\\n        `<button class=\\\"ot-line\\\" id=\\\"otLnAuto\\\">${ICO_RELOGIO}<span>Sozinho: <b>${LBL_AUTO[otim.auto] || otim.auto + ' min'}</b></span><i>${abertoAuto ? '▴' : '▾'}</i></button>` +\\n        (abertoAuto ? `<div class=\\\"ot-opts ot-opts-in\\\">${opcAuto}</div>` : '') +\\n        `<button class=\\\"ot-line\\\" id=\\\"otLnPag\\\" style=\\\"margin-top:2px\\\">${ICO_PAGINA}<span>Ao abrir de novo: <b>${LBL_PAG[otim.pagina] || otim.pagina}</b></span><i>${abertoPag ? '▴' : '▾'}</i></button>` +\\n        (abertoPag ? `<div class=\\\"ot-opts ot-opts-in\\\">${opcPag}</div>` : '') + `</div>` +\\n        `<div class=\\\"ot-bloco\\\"><div class=\\\"ot-sec\\\">Histórico desta conta</div><div class=\\\"ot-hist\\\">${hist5}</div></div>`;\\n      desenharGraficos();\\n      const bt = document.getElementById('otAgora');\\n      bt.onclick = async () => {\\n        bt.disabled = true; bt.querySelector('b').textContent = 'Otimizando...';\\n        await window.api.otimizarAgora(conta);\\n        drawOt();\\n      };\\n      document.getElementById('otComo').onclick = () => { abertoComo = !abertoComo; drawOt(); };\\n      document.getElementById('otLnAuto').onclick = () => { abertoAuto = !abertoAuto; drawOt(); };\\n      document.getElementById('otLnPag').onclick = () => { abertoPag = !abertoPag; drawOt(); };\\n      root.querySelectorAll('[data-pag]').forEach((b) => { b.onclick = () => { window.api.otimizarPagina(conta, b.dataset.pag); drawOt(); }; });\\n      root.querySelectorAll('[data-auto]').forEach((b) => { b.onclick = () => { window.api.otimizarAuto(conta, Number(b.dataset.auto)); drawOt(); }; });\\n    }\\n    window.api.onTitleFoco((d) => {\\n      if (!d) return;\\n      const aberto = d.rightOpen !== false;\\n      document.body.classList.toggle('fechado', !aberto);\\n      conta = d.atual;\\n      I = d.atual;\\n      amostrar(); // segue coletando mesmo com o painel fechado, pro gráfico já vir cheio ao abrir\\n      if (!aberto) { desenharRail(); return; }\\n      if (ultimoEstado) { renderSeMudou(); desenharCabecalho(); desenharRodape(); }\\n      drawOt();\\n    });\\n    amostrar();\\n  }\\n\\n  // ---------- barra de baixo: layout da grade, modos de desempenho, uso de CPU/memória e versão ----------\\n  // ---- Histórico das lives: tudo o que aconteceu, com filtro e contagem ----\\n  function initHistorico() {\\n    document.body.classList.add('histw');\\n    document.title = 'Histórico das lives — PokeLink';\\n    app.hidden = true;\\n    const root = document.getElementById('histw');\\n    root.hidden = false;\\n    const esc = (t) => String(t == null ? '' : t).replace(/[&<>\\\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;' }[c]));\\n    const hora = (ms) => new Date(ms).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });\\n    const diaDe = (ms) => { const d = new Date(ms); d.setHours(0, 0, 0, 0); return d.getTime(); };\\n    const nomeDia = (ms) => {\\n      const hoje = diaDe(Date.now());\\n      const d = diaDe(ms);\\n      if (d === hoje) return 'Hoje';\\n      if (d === hoje - 86400000) return 'Ontem';\\n      return new Date(ms).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long' });\\n    };\\n    const ICO = { problema: '⚠', ok: '✓', info: '•' };\\n    root.innerHTML =\\n      '<div class=\\\"ch\\\">' + iconHtml(null) + '<b>Histórico</b><span>lives</span></div>' +\\n      '<div class=\\\"hx-top\\\"><div id=\\\"hxRes\\\"></div><div class=\\\"hx-tabs\\\">' +\\n        '<button class=\\\"hx-tab on\\\" data-f=\\\"tudo\\\">Tudo <i>0</i></button>' +\\n        '<button class=\\\"hx-tab\\\" data-f=\\\"problemas\\\">Só problemas <i>0</i></button>' +\\n      '</div></div>' +\\n      '<div class=\\\"cb\\\" id=\\\"hxBody\\\"></div>' +\\n      '<div class=\\\"hx-pe\\\"><button class=\\\"hx-lp\\\">🗑 Limpar histórico</button><button class=\\\"hx-fx\\\">Fechar</button></div>';\\n    const body = document.getElementById('hxBody');\\n    const resumo = document.getElementById('hxRes');\\n    const tabs = [...root.querySelectorAll('.hx-tab')];\\n    let filtro = 'tudo';\\n    let dados = { eventos: [], problemas: 0, total: 0, problemasTotal: 0, novos: 0 };\\n\\n    tabs.forEach((t) => { t.onclick = () => { filtro = t.dataset.f; tabs.forEach((x) => x.classList.toggle('on', x === t)); desenhar(); }; });\\n    root.querySelector('.hx-fx').onclick = () => window.api.closeSelf();\\n    root.querySelector('.hx-lp').onclick = () => { window.api.histLimpar(); setTimeout(carregar, 150); };\\n\\n    function desenhar() {\\n      const problemasHoje = dados.problemas || 0;\\n      const ultimo = (dados.eventos || []).find((e) => e.nivel === 'problema');\\n      resumo.innerHTML = '<div class=\\\"hx-res' + (problemasHoje ? ' mal' : '') + '\\\">' +\\n        '<span class=\\\"hx-ico\\\">' + (problemasHoje ? '⚠' : '✓') + '</span><span style=\\\"min-width:0\\\">' +\\n        '<b>' + (problemasHoje ? problemasHoje + (problemasHoje === 1 ? ' problema hoje' : ' problemas hoje') : 'Nenhum problema hoje') + '</b>' +\\n        '<small>' + (ultimo ? 'O último às ' + hora(ultimo.at) + ': ' + esc((ultimo.conta ? ultimo.conta + ' ' : '') + ultimo.texto)\\n          : 'As lives estão rodando sem queda nem travamento.') + '</small></span>' +\\n        (dados.novos ? '<span class=\\\"hx-novos\\\">' + dados.novos + ' novos</span>' : '') + '</div>';\\n      tabs[0].querySelector('i').textContent = dados.total || 0;\\n      tabs[1].querySelector('i').textContent = dados.problemasTotal || 0;\\n      const lista = (dados.eventos || []).filter((e) => filtro === 'tudo' || e.nivel === 'problema')\\n        .slice().sort((a, b) => b.at - a.at); // o mais novo em cima\\n      if (!lista.length) {\\n        body.innerHTML = '<div class=\\\"hx-vazio\\\">' + (filtro === 'problemas'\\n          ? 'Nenhum problema registrado. As lives estão se virando sozinhas.'\\n          : 'Nada por aqui ainda. O que acontecer com as lives aparece nesta lista.') + '</div>';\\n        return;\\n      }\\n      let h = '';\\n      let dia = null;\\n      for (const e of lista) {\\n        const d = diaDe(e.at);\\n        if (d !== dia) { dia = d; h += '<div class=\\\"hx-dia\\\">' + esc(nomeDia(e.at)) + '</div>'; }\\n        h += '<div class=\\\"hx-li ' + (e.nivel || 'info') + (e.at > (dados.vistoAt || 0) ? '' : ' lido') + '\\\">' +\\n          '<span class=\\\"b\\\">' + (ICO[e.nivel] || ICO.info) + '</span>' +\\n          '<span class=\\\"t\\\">' + (e.conta ? '<b>' + esc(e.conta) + '</b> ' : '') + esc(e.texto) + '</span>' +\\n          '<span class=\\\"h\\\">' + hora(e.at) + '<i class=\\\"pt\\\"></i></span></div>';\\n      }\\n      body.innerHTML = h;\\n    }\\n    async function carregar() {\\n      try { dados = (await window.api.histGet()) || dados; } catch (e) {}\\n      desenhar();\\n    }\\n    if (window.api.onHistUpdate) window.api.onHistUpdate(() => carregar());\\n    carregar();\\n  }\\n\\n  function initBottomBar() {\\n    document.body.classList.add('bottombar');\\n    document.title = 'PokeLink';\\n    app.hidden = true;\\n    const ic = (p) => `<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.5\\\" stroke-linejoin=\\\"round\\\" stroke-linecap=\\\"round\\\">${p}</svg>`;\\n    const ICO = {\\n      grade: ic('<rect x=\\\"2\\\" y=\\\"2\\\" width=\\\"5\\\" height=\\\"5\\\" rx=\\\"1\\\"/><rect x=\\\"9\\\" y=\\\"2\\\" width=\\\"5\\\" height=\\\"5\\\" rx=\\\"1\\\"/><rect x=\\\"2\\\" y=\\\"9\\\" width=\\\"5\\\" height=\\\"5\\\" rx=\\\"1\\\"/><rect x=\\\"9\\\" y=\\\"9\\\" width=\\\"5\\\" height=\\\"5\\\" rx=\\\"1\\\"/>'),\\n      principal: ic('<rect x=\\\"2\\\" y=\\\"2\\\" width=\\\"7\\\" height=\\\"12\\\" rx=\\\"1\\\"/><rect x=\\\"10.5\\\" y=\\\"2\\\" width=\\\"3.5\\\" height=\\\"3.2\\\" rx=\\\".8\\\"/><rect x=\\\"10.5\\\" y=\\\"6.4\\\" width=\\\"3.5\\\" height=\\\"3.2\\\" rx=\\\".8\\\"/><rect x=\\\"10.5\\\" y=\\\"10.8\\\" width=\\\"3.5\\\" height=\\\"3.2\\\" rx=\\\".8\\\"/>'),\\n      colunas: ic('<rect x=\\\"1.8\\\" y=\\\"2\\\" width=\\\"2.6\\\" height=\\\"12\\\" rx=\\\".8\\\"/><rect x=\\\"5.4\\\" y=\\\"2\\\" width=\\\"2.6\\\" height=\\\"12\\\" rx=\\\".8\\\"/><rect x=\\\"9\\\" y=\\\"2\\\" width=\\\"2.6\\\" height=\\\"12\\\" rx=\\\".8\\\"/><rect x=\\\"12.6\\\" y=\\\"2\\\" width=\\\"2.2\\\" height=\\\"12\\\" rx=\\\".8\\\"/>'),\\n      ampliado: ic('<rect x=\\\"2\\\" y=\\\"3\\\" width=\\\"12\\\" height=\\\"10\\\" rx=\\\"1.5\\\"/><path d=\\\"M2 6h12\\\"/>'),\\n      eco: ic('<path d=\\\"M3 13c0-6 3.5-9.5 10-9.5 0 6-3.5 9.5-10 9.5z\\\"/><path d=\\\"M3 13l5.5-5.5\\\"/>'),\\n      mega: ic('<path d=\\\"M3.5 13.5V8M8 13.5V3M12.5 13.5V9.5\\\"/>'),\\n    };\\n    const root = el('div', 'bb-wrap');\\n    const seg = el('div', 'bb-seg');\\n    const DICAS = {\\n      grade: 'Grade 2×2: as 4 contas do mesmo tamanho',\\n      principal: 'Principal + 3: a conta selecionada fica grande e as outras ao lado',\\n      colunas: 'Colunas: as 4 contas lado a lado',\\n      ampliado: 'Ampliar a conta selecionada (clique de novo para voltar para a grade)',\\n    };\\n    const btns = {};\\n    ['grade', 'principal', 'colunas', 'ampliado'].forEach((k) => {\\n      btns[k] = el('button', 'bb-ib', ICO[k], DICAS[k], () => window.api.layoutSet(k));\\n      seg.appendChild(btns[k]);\\n    });\\n    root.appendChild(seg);\\n    root.appendChild(el('div', 'bb-sep'));\\n    // tamanho do jogo (zoom) do modo em que você está: grade ou ampliado\\n    const zseg = el('div', 'bb-seg bb-zoom');\\n    const zMenos = el('button', 'bb-ib', ic('<path d=\\\"M3.5 8h9\\\"/>'), 'Jogo menor: mostra mais coisas de uma vez', () => window.api.layoutSet('tam:menos'));\\n    const zTxt = el('span', 'bb-zv', '—%');\\n    zTxt.title = 'Tamanho do jogo nas telas (zoom)';\\n    const zMais = el('button', 'bb-ib', ic('<path d=\\\"M3.5 8h9M8 3.5v9\\\"/>'), 'Jogo maior: as letras e botões ficam maiores (o jogo usa o layout mais compacto)', () => window.api.layoutSet('tam:mais'));\\n    zseg.appendChild(zMenos); zseg.appendChild(zTxt); zseg.appendChild(zMais);\\n    root.appendChild(zseg);\\n    root.appendChild(el('div', 'bb-sep'));\\n    let nivel = 0;\\n    const alternar = (lv) => () => window.api.setLevel(0, nivel === lv ? 0 : lv); // vale para todas as contas\\n    const pEco = el('button', 'bb-pill', `${ICO.eco}<span>Eco</span>`, 'Eco: liga o Modo Economia do jogo em todas as contas. Clique de novo para voltar ao Normal.', alternar(1));\\n    const pMega = el('button', 'bb-pill', `${ICO.mega}<span>Mega Eco</span>`, 'Mega Eco: troca as telas por um painel com o resumo do farm; os jogos continuam rodando. Clique de novo para voltar ao Normal.', alternar(2));\\n    root.appendChild(pEco); root.appendChild(pMega);\\n    root.appendChild(el('div', 'bb-fill'));\\n    const mk = (rot) => el('button', 'bb-stat', `<span class=\\\"bb-mini\\\"><i style=\\\"height:0%\\\"></i></span><span class=\\\"bb-st\\\"><small>${rot}</small><b>—</b></span>`,\\n      'Clique para ver o uso detalhado de cada parte do PokeLink', () => window.api.usoOpen());\\n    const sCpu = mk('CPU'), sRam = mk('RAM');\\n    const ver = el('button', 'bb-ver', 'v—', 'Sobre o PokeLink', () => window.api.showAbout());\\n    const ICO_GEAR = '<svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.8\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"3\\\"/><path d=\\\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\\\"/></svg>';\\n    const gear = el('button', 'bb-gear', ICO_GEAR, 'Menu: Contas, Lives, Desempenho, PvP, Atualizações e Ajuda', () => {\\n      const r = gear.getBoundingClientRect();\\n      const rect = { left: r.left, top: r.top, right: r.right, bottom: r.bottom };\\n      if (window.api.gearOpen) window.api.gearOpen(rect); else window.api.layoutSet('gear:' + JSON.stringify(rect)); // tolera um preload.js antigo\\n    });\\n    // 🕘 histórico das lives: o que parou, o que voltou, resgates e baús\\n    const hist = el('button', 'bb-hist', ic('<circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"6\\\"/><path d=\\\"M8 4.6V8l2.4 1.6\\\"/>') + '<em>0</em>',\\n      'Histórico das lives: o que parou, o que voltou, resgates e baús', () => window.api.histOpen());\\n    if (window.api.onHistUpdate) window.api.onHistUpdate((d) => {\\n      const n = (d && d.novos) || 0;\\n      hist.classList.toggle('tem', n > 0);\\n      hist.querySelector('em').textContent = n > 99 ? '99+' : n;\\n      hist.title = n ? `Histórico das lives: ${n} ${n === 1 ? 'novidade' : 'novidades'} desde a última vez` + ((d && d.problemas) ? ` · ${d.problemas} ${d.problemas === 1 ? 'problema' : 'problemas'} hoje` : '')\\n        : 'Histórico das lives: o que parou, o que voltou, resgates e baús';\\n    });\\n    root.appendChild(sCpu); root.appendChild(sRam); root.appendChild(hist); root.appendChild(ver); root.appendChild(gear);\\n    document.body.appendChild(root);\\n    const setStat = (box, pct, txt, dica) => {\\n      const p = Math.max(0, Math.min(100, pct));\\n      const mini = box.querySelector('.bb-mini');\\n      mini.querySelector('i').style.height = Math.max(6, p) + '%';\\n      mini.classList.toggle('med', p >= 40 && p < 70); mini.classList.toggle('alto', p >= 70);\\n      box.querySelector('b').textContent = txt;\\n      if (dica) box.title = dica + '\\\\nClique para ver o uso detalhado de cada parte do PokeLink';\\n    };\\n    window.api.onUsoTotal((d) => {\\n      if (!d) return;\\n      nivel = Number.isInteger(d.nivel) ? d.nivel : 0;\\n      const ativo = d.focused ? 'ampliado' : d.layout;\\n      Object.keys(btns).forEach((k) => btns[k].classList.toggle('on', k === ativo));\\n      if (Number.isFinite(d.zoom) && d.zoom > 0) zTxt.textContent = d.zoom + '%';\\n      pEco.classList.toggle('on', nivel === 1);\\n      pMega.classList.toggle('on', nivel === 2);\\n      setStat(sCpu, d.cpu, d.cpu + '%', 'CPU usada pelo PokeLink (soma das contas e painéis)');\\n      const gb = d.mem >= 1000 ? (d.mem / 1000).toFixed(1).replace('.', ',') + ' GB' : d.mem + ' MB';\\n      const pct = d.memTotal ? (d.mem / d.memTotal) * 100 : 0;\\n      setStat(sRam, pct, gb, `Memória usada pelo PokeLink: ${gb}` + (d.memTotal ? ` (${Math.round(pct)}% dos ${(d.memTotal / 1000).toFixed(1).replace('.', ',')} GB do computador)` : ''));\\n      ver.textContent = (d.canal ? d.canal + ' ' : '') + 'v' + d.versao;\\n    });\\n  }\\n\\n  if (MODE === 'config') {\\n    initConfig();\\n  } else if (MODE === 'title') {\\n    initTitle();\\n  } else if (MODE === 'pvp') {\\n    initPvp();\\n  } else if (MODE === 'resumo') {\\n    initResumo();\\n  } else if (MODE === 'kick') {\\n    initKick();\\n  } else if (MODE === 'twitch') {\\n    initTwitch();\\n  } else if (MODE === 'historico') {\\n    initHistorico();\\n  } else if (MODE === 'sidebar') {\\n    initSidebar();\\n  } else if (MODE === 'otimside') {\\n    initOtimSide();\\n  } else if (MODE === 'bottombar') {\\n    initBottomBar();\\n  } else {\\n    window.api.onState(render);\\n    window.api.ready();\\n  }\\n</script>\"}}","sig":"ZC4fXQF1OnlZSRJsah5rKB8MLeTi0ABO6I7UjNL5f1fFIFQSWNie4NWHF2utjEwVfOWL4Xs7C9nQ6SxqPfucBA=="}
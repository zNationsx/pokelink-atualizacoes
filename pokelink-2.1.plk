{"payload":"{\"app\":\"PokeLink\",\"version\":\"2.1\",\"created\":\"2026-10-21T21:46:21.314Z\",\"files\":{\"main.js\":\"const { app, BaseWindow, BrowserWindow, WebContentsView, View, Menu, ipcMain, dialog, shell, nativeImage, session, clipboard, webContents, powerMonitor, powerSaveBlocker } = require('electron');\\nconst path = require('path');\\nconst fs = require('fs');\\nconst vm = require('vm');\\n\\n// Mesma pasta de dados no modo dev e no .exe, para os logins das contas serem os mesmos\\napp.setPath('userData', path.join(app.getPath('appData'), 'pokeidle-multi'));\\n\\n// As lives abertas em segundo plano ficam com a GUIA mutada (como \\\"mutar guia\\\" no navegador);\\n// o player em si continua com som, então precisa poder tocar sem clique do usuário.\\napp.commandLine.appendSwitch('autoplay-policy', 'no-user-gesture-required');\\n// O Windows volta a poder avisar quando a janela está coberta/bloqueada (antes isso era desligado, e o vídeo\\n// das lives segurava a TELA acesa até com o PC bloqueado). Para o farm não parar quando a janela some:\\n// - os vídeos continuam tocando mesmo escondidos (disable-background-media-suspend);\\n// - as páginas não ficam mais lentas atrás de outra janela (as duas opções de \\\"backgrounding\\\");\\n// - a página da Kick sempre \\\"se acha\\\" visível (KICK_VISIVEL_JS), e o plano B do player confere os pontos.\\napp.commandLine.appendSwitch('disable-background-media-suspend');\\napp.commandLine.appendSwitch('disable-backgrounding-occluded-windows');\\napp.commandLine.appendSwitch('disable-renderer-backgrounding');\\n\\n// Por padrão o Electron se identifica como \\\"... PokeLink/x Electron/y ...\\\", o que alguns sites bloqueiam.\\n// Todas as páginas passam a se identificar como o Chrome equivalente.\\nconst CLEAN_UA = `Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/${process.versions.chrome} Safari/537.36`;\\napp.userAgentFallback = CLEAN_UA;\\n// esconde a marca de \\\"navegador controlado por automação\\\"\\napp.commandLine.appendSwitch('disable-blink-features', 'AutomationControlled');\\n\\n// Silencia os avisos \\\"Failed to load URL ... ERR_BLOCKED_BY_CSP\\\" (pixel do Facebook, inofensivo)\\nprocess.removeAllListeners('warning');\\n\\n// ====== CONFIGURE AQUI ======\\nconst GAME_URL = 'https://pokeidle.io';\\nconst ACCOUNTS = ['Conta 1', 'Conta 2', 'Conta 3', 'Conta 4'];\\n// ============================\\n\\n// ====== VERSÃO ======\\nconst APP_NAME = 'PokeLink';\\nconst APP_VERSION = '2.1'; // aumente a cada atualização que você distribuir\\nconst APP_CHANNEL = 'Beta';  // troque para '' quando sair do beta\\n// Contato para pedidos de remoção (aparece em \\\"Direitos e marcas\\\"). Ex.: 'contato@seudominio.com'\\n// Enquanto estiver vazio, esse trecho não é exibido.\\nconst SUPPORT_CONTACT = '';\\n// ====================\\n\\n// Modo desenvolvedor: só quando o app roda pelo código (npm start / electron .).\\n// No .exe gerado, as opções de desenvolvedor (atualizar arquivos, pasta do app, F12) não existem.\\nconst DEV = !app.isPackaged;\\n\\n// Ícone do app: definido por você (desenvolvedor), não pelo usuário.\\n// Para trocar, coloque \\\"icone.png\\\" (ou .jpg/.ico) na pasta do projeto ANTES de gerar o .exe.\\n// Sem arquivo, usa o ícone padrão do PokeLink (o elo dourado).\\nconst ICON_MIME = { png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', ico: 'image/x-icon' };\\nfunction customIconPath() {\\n  for (const ext of Object.keys(ICON_MIME)) {\\n    const f = path.join(__dirname, 'icone.' + ext);\\n    try { if (fs.statSync(f).isFile()) return f; } catch {}\\n  }\\n  return null;\\n}\\n// a imagem vai para a barra já embutida (data:), assim não depende de caminho de pasta\\nfunction customIconUrl() {\\n  const f = customIconPath();\\n  if (!f) return null;\\n  try {\\n    const buf = fs.readFileSync(f);\\n    return `data:${ICON_MIME[path.extname(f).slice(1).toLowerCase()]};base64,${buf.toString('base64')}`;\\n  } catch { return null; }\\n}\\nfunction applyWindowIcon() {\\n  const f = customIconPath();\\n  if (!f || !win) return;\\n  const img = nativeImage.createFromPath(f);\\n  if (!img.isEmpty()) win.setIcon(img);\\n}\\n\\nconst BAR_H = 38;\\n// barra de título customizada (substitui a barra de menu nativa do Windows)\\nconst TITLE_H = 34;\\nconst TITLE_BG = '#3a1820';   // precisa ser cor sólida: é a mesma dos botões min/max/fechar\\nconst TITLE_FG = '#ffdef0';\\nlet titleBar = null;\\nlet menuOpen = false; // com um menu aberto, a barra de título cobre a janela toda (transparente)\\nlet appMenu = null;\\nlet win;\\nlet bars = [];\\nlet views = [];\\nlet focused = -1; // -1 = grade 2x2, 0..3 = tela cheia de uma conta\\nconst level = ACCOUNTS.map(() => 0); // 0 normal, 1 ECO, 2 ECO MAX, 3 dormindo\\nconst ecoCss = ACCOUNTS.map(() => null);\\n\\n// ---------- Zoom (largura \\\"virtual\\\" do jogo) ----------\\nlet REF_WIDTH = 1920;\\nconst cfgFile = () => path.join(app.getPath('userData'), 'zoom.json');\\nconst barsEdge = true; // barras das contas 3 e 4 sempre na borda de baixo da janela\\nfunction loadRef() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(cfgFile(), 'utf8'));\\n    REF_WIDTH = j.ref || REF_WIDTH;\\n  } catch {}\\n}\\nfunction saveCfg() {\\n  try { fs.writeFileSync(cfgFile(), JSON.stringify({ ref: REF_WIDTH })); } catch {}\\n}\\nfunction changeRef(delta) {\\n  REF_WIDTH = Math.min(2600, Math.max(900, REF_WIDTH + delta));\\n  saveCfg();\\n  layout();\\n}\\n// 'top' = barra em cima do jogo | 'bottom' = barra embaixo do jogo\\nfunction barPos(i) {\\n  return focused === -1 && barsEdge && i >= 2 ? 'bottom' : 'top';\\n}\\nfunction applyZoom(v, width) {\\n  const z = width / REF_WIDTH;\\n  if (!isFinite(z) || z <= 0) return; // janela minimizada / em transição\\n  v.webContents.setZoomFactor(z);\\n}\\n\\n// ---------- Layout ----------\\nfunction layout() {\\n  if (tela.off) return; // tela apagada: as páginas ficam fora da janela até você voltar\\n  if (!win || win.isDestroyed() || bars.length < ACCOUNTS.length) return;\\n  const { width, height: fullH } = win.getContentBounds();\\n  const top = titleH();\\n  const height = fullH - top;\\n  if (width < 100 || height < 100) return;\\n  if (titleBar) {\\n    titleBar.setVisible(top > 0);\\n    if (liveCover) liveCover.setBounds({ x: 0, y: 0, width, height: fullH });\\n    titleBar.setBounds({ x: 0, y: 0, width, height: menuOpen || dialogOpen ? fullH : TITLE_H });\\n  }\\n  const w = Math.floor(width / 2);\\n  const h = Math.floor(height / 2);\\n  views.forEach((v, i) => {\\n    const grid = focused === -1;\\n    if (!grid && focused !== i) { // modo ampliado: esconde as outras contas\\n      v.setVisible(false);\\n      bars[i].setVisible(false);\\n      return;\\n    }\\n    const row = grid ? Math.floor(i / 2) : 0;\\n    const x = grid ? (i % 2) * w : 0;\\n    const y = (grid ? row * h : 0) + top;\\n    const bw = grid ? w : width;\\n    const bh = grid ? (row === 0 ? h : height - h) : height; // a linha de baixo ocupa o resto\\n    const bottom = barPos(i) === 'bottom';\\n    bars[i].setVisible(true);\\n    bars[i].setBounds({ x, y: bottom ? y + bh - BAR_H : y, width: bw, height: BAR_H });\\n    if (level[i] === 3) { detachView(i); return; } // hibernando: só a barra fica\\n    attachView(i);\\n    v.setVisible(true);\\n    const area = { x, y: bottom ? y : y + BAR_H, width: bw, height: bh - BAR_H };\\n    v.setBounds(area);\\n    applyZoom(v, bw);\\n  });\\n  // Mega Eco (todas as contas): um painel só cobre as 4 telas; os jogos continuam rodando por baixo\\n  if (megaEco()) {\\n    const d = dashView();\\n    d.setVisible(true);\\n    d.setBounds({ x: 0, y: top, width, height });\\n    // uma tela reanexada iria para cima do painel: traz o painel (e os menus) de volta para o topo\\n    win.contentView.addChildView(d);\\n    if (titleBar) win.contentView.addChildView(titleBar);\\n  }\\n  else if (dash && !dash.webContents.isDestroyed()) dash.setVisible(false);\\n}\\n\\n// em tela cheia (F11) a barra de título some, como no Windows\\nfunction titleH() {\\n  return titleBar && !win.isFullScreen() ? TITLE_H : 0;\\n}\\n\\n// Hibernar TIRA a conta da janela (em vez de só escondê-la) e, ao voltar, coloca de novo.\\n// Só esconder com setVisible deixava a área da conta vazia/cinza ao voltar em alguns PCs.\\nconst attached = ACCOUNTS.map(() => true);\\nfunction detachView(i) {\\n  if (!attached[i]) return;\\n  try { win.contentView.removeChildView(views[i]); } catch {}\\n  attached[i] = false;\\n}\\nfunction attachView(i) {\\n  if (attached[i]) return;\\n  win.contentView.addChildView(views[i]);\\n  attached[i] = true;\\n  // a barra de título (menus e pop-ups) precisa continuar por cima de tudo\\n  if (titleBar) win.contentView.addChildView(titleBar);\\n}\\n\\nfunction setFocus(n) {\\n  focused = n;\\n  layout();\\n  sendState();\\n}\\n\\n// ---------- Níveis de economia ----------\\n// 1 = Eco (~4 fps) | 2 = Super Eco (~1 fps, esconde o mapa/canvas) | 3 = Hibernar (tela escondida)\\nconst ECO_CSS = `\\n  *, *::before, *::after {\\n    animation: none !important;\\n    transition: none !important;\\n    scroll-behavior: auto !important;\\n    filter: none !important;\\n    backdrop-filter: none !important;\\n    box-shadow: none !important;\\n    text-shadow: none !important;\\n  }`;\\nconst MAX_CSS = ` canvas { visibility: hidden !important; }`;\\n\\nconst ecoOn = (ms) => `(() => {\\n  if (window.__eco) return;\\n  const o = { raf: window.requestAnimationFrame, caf: window.cancelAnimationFrame };\\n  window.__eco = o;\\n  window.requestAnimationFrame = (cb) => setTimeout(() => cb(performance.now()), ${ms});\\n  window.cancelAnimationFrame = (id) => { clearTimeout(id); try { o.caf.call(window, id); } catch (e) {} };\\n})()`;\\n\\nconst ECO_OFF = `(() => {\\n  if (!window.__eco) return;\\n  window.requestAnimationFrame = window.__eco.raf;\\n  window.cancelAnimationFrame = window.__eco.caf;\\n  delete window.__eco;\\n})()`;\\n\\n// promessa com limite de tempo: página escondida/pausada pode nunca responder\\nconst withTimeout = (p, ms) => Promise.race([p, new Promise((_, rej) => setTimeout(() => rej(new Error('timeout')), ms))]);\\nconst levelSeq = ACCOUNTS.map(() => 0);\\n\\n// liga/desliga o botão \\\"Modo Economia\\\" do jogo (#hunt-eco), só se o estado atual for diferente\\n// O PokeLink lembra se foi ele que ligou (gameEco) e também tenta ver na tela se a cena da batalha está escondida.\\nconst gameEco = ACCOUNTS.map(() => false);\\nconst GAME_ECO_JS = (on, sabido) => `(() => {\\n const b = document.getElementById('hunt-eco');\\n  const cena = document.getElementById('cena');\\n  // com o Modo Economia ligado, o jogo mostra o botão \\\"LIGAR A CENA\\\"\\n  const ligarCena = [...document.querySelectorAll('button, [role=button]')]\\n    .find((e) => /ligar a cena/i.test(e.textContent || '') && e.getClientRects().length);\\n  let ligado = ligarCena ? true : null;\\n  if (ligado === null && b && (b.classList.contains('on') || b.classList.contains('ativo') || b.classList.contains('active') || b.getAttribute('aria-pressed') === 'true')) ligado = true;\\n  else if (/\\\\\\\\beco|economia/i.test(document.body.className || '')) ligado = true;\\n  else if (cena) { const cs = getComputedStyle(cena); ligado = cena.getClientRects().length === 0 || cs.display === 'none' || cs.visibility === 'hidden'; }\\n  if (ligado === null) ligado = ${sabido ? 'true' : 'false'};\\n  if (ligado === ${on ? 'true' : 'false'}) return 'ok';\\n  if (!${on ? 'true' : 'false'} && ligarCena) { ligarCena.click(); return 'trocou'; }\\n  if (b) { b.click(); return 'trocou'; }\\n  return 'sem botão';\\n})()`;\\n\\n// ---------- Mega Eco: um painel com o resumo do farm das 4 contas ----------\\n// Vale para todas as contas ao mesmo tempo: os jogos ficam em Modo Economia e continuam rodando,\\n// e um painel único com o resumo de cada conta cobre as telas.\\nconst megaEco = () => level.every((l) => l === 2);\\nlet dash = null;\\nfunction dashView() {\\n  if (dash && !dash.webContents.isDestroyed()) return dash;\\n  dash = new WebContentsView({ webPreferences: { preload: path.join(__dirname, 'preload.js') } });\\n  dash.setBackgroundColor('#140a12');\\n  dash.webContents.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'resumo' } });\\n  win.contentView.addChildView(dash);\\n  if (titleBar) win.contentView.addChildView(titleBar); // menus e pop-ups continuam por cima\\n  return dash;\\n}\\n// lê da página do jogo tudo o que o resumo mostra\\n// Lê a tela do \\\"Modo Economia\\\" do próprio jogo (números da sessão, gastos, achados, capturas e itens).\\n// É uma função normal: vai para dentro da página do jogo como texto (ecoScrape.toString()).\\nfunction ecoScrape() {\\n  const vis = (e) => !!(e && e.getClientRects().length);\\n  const label = (re) => [...document.querySelectorAll('div,span,h2,h3,h4,b,small,p,strong')]\\n    .find((e) => e.children.length <= 2 && re.test((e.textContent || '').trim()) && vis(e));\\n  const linhas = (e) => (e && e.innerText ? e.innerText : '').split('\\\\n').map((x) => x.trim()).filter(Boolean);\\n  const tile = (re) => {\\n    const l = label(re);\\n    if (!l) return null;\\n    let box = l.parentElement;\\n    for (let k = 0; k < 3 && box && linhas(box).length < 3; k++) box = box.parentElement;\\n    return box ? linhas(box).slice(0, 5) : null;\\n  };\\n  const icones = (box) => [...box.querySelectorAll('img')].map((im) => {\\n    let b = im.parentElement;\\n    for (let k = 0; k < 3 && b && !/\\\\d/.test(b.textContent || ''); k++) b = b.parentElement;\\n    const m = b && (b.textContent || '').replace(/\\\\s+/g, ' ').match(/×?\\\\s*([\\\\d.]+)/);\\n    return { img: im.src, n: m ? m[1] : '' };\\n  }).filter((x) => x.img && x.n);\\n  // ícones de um grupo (Achados, Gastos): só os que vêm depois do título e antes do próximo título\\n  const grupo = (re, reProx) => {\\n    const l = label(re);\\n    if (!l) return [];\\n    let box = l.parentElement;\\n    for (let k = 0; k < 3 && box && !box.querySelector('img'); k++) box = box.parentElement;\\n    if (!box) return [];\\n    const prox = reProx ? label(reProx) : null;\\n    const depois = (a, b) => !!(a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING);\\n    const lista = icones(box).filter((x) => {\\n      const im = [...box.querySelectorAll('img')].find((i) => i.src === x.img);\\n      return im && depois(l, im) && (!prox || !box.contains(prox) || depois(im, prox));\\n    });\\n    return lista.slice(0, 10);\\n  };\\n  // cartões de captura: imagem + \\\"Nv\\\" + horário, sem pegar os blocos que contêm vários cartões\\n  const cards = [...document.querySelectorAll('div, li, article')].filter((e) => {\\n    if ((e.textContent || '').length > 160 || !e.querySelector('img') || !vis(e)) return false;\\n    const t = e.innerText || '';\\n    return /Nv\\\\s*\\\\d+/.test(t) && /(?<!\\\\d)\\\\d{1,2}:\\\\d{2}(?!\\\\d)/.test(t) &&\\n      /\\\\bIV\\\\s*\\\\d/.test(t) && /\\\\bQ\\\\s*[\\\\d,]/.test(t) && !/an[uú]ncio|\\\\[\\\\d+\\\\]:/i.test(t);\\n  });\\n  const caps = cards.filter((c) => !cards.some((o) => o !== c && c.contains(o))).slice(0, 6).map((c) => ({\\n    img: c.querySelector('img').src,\\n    linhas: linhas(c).slice(0, 8),\\n  }));\\n  // itens do painel \\\"Itens\\\" (texto \\\"×64.866\\\")\\n  const itens = [];\\n  for (const im of document.querySelectorAll('img')) {\\n    const b = im.parentElement;\\n    const m = b && (b.textContent || '').trim().match(/^×\\\\s*([\\\\d.]+)$/);\\n    if (m && vis(im) && !itens.some((x) => x.img === im.src)) itens.push({ img: im.src, n: m[1] });\\n  }\\n  const tempo = ((document.body.innerText || '').match(/(?<![\\\\d:])(\\\\d{1,2}:\\\\d{2}:\\\\d{2})(?![\\\\d:])/) || [])[1] || '';\\n  return {\\n    xpT: tile(/^XP TREINADOR$/i), xpP: tile(/^XP POKÉMON$/i), lucro: tile(/^LUCRO LÍQUIDO$/i),\\n    abates: tile(/^ABATES$/i), capturas: tile(/^CAPTURAS$/i),\\n    gastos: grupo(/^GASTOS$/i), achados: grupo(/^ACHADOS/i, /^GASTOS$/i), caps, itens: itens.slice(0, 12), tempo,\\n  };\\n}\\n\\nconst RESUMO_JS = `(() => {\\n  const q = (s) => document.querySelector(s);\\n  const t = (s) => ((q(s) || {}).textContent || '').trim();\\n  const J = (k) => { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch (e) { return null; } };\\n  const nick = t('#tr-nick');\\n  const key = nick.toLowerCase();\\n  const card = q('#ativo-card');\\n  let sprite = null;\\n  try { const cv = card && card.querySelector('canvas'); if (cv && cv.width) sprite = cv.toDataURL('image/png'); } catch (e) {}\\n  const nomeEl = card && card.querySelector('.ativo-nome');\\n  const pkNome = nomeEl ? [...nomeEl.childNodes].filter((n) => n.nodeType === 3).map((n) => n.textContent).join('').trim() : '';\\n  const ativos = [...document.querySelectorAll('.tr-ativo')].map((a) => ({\\n    nome: ((a.querySelector('.tr-ativo-nome') || {}).textContent || '').trim(),\\n    valor: ((a.querySelector('.tr-ativo-valor') || {}).textContent || '').trim(),\\n    tempo: ((a.querySelector('.tr-ativo-tempo') || {}).textContent || '').trim(),\\n  })).filter((a) => a.nome);\\n  // painel de automação do jogo: interruptores (bola, poção, mapa...) e itens com quantidade\\n  const pa = q('#p-auto');\\n  const auto = [];\\n  const itens = [];\\n  if (pa) {\\n    for (const el of pa.querySelectorAll('input[type=checkbox], [role=switch], [aria-pressed], [aria-checked]')) {\\n      const box = el.closest('label, .auto-item, .toggle, li, div') || el;\\n      const nome = (box.textContent || el.getAttribute('aria-label') || el.title || '').replace(/\\\\\\\\s+/g, ' ').trim().slice(0, 24);\\n      const on = el.type === 'checkbox' ? el.checked : (el.getAttribute('aria-checked') === 'true' || el.getAttribute('aria-pressed') === 'true');\\n      if (nome && !auto.some((x) => x.nome === nome)) auto.push({ nome, on: !!on });\\n    }\\n    for (const im of pa.querySelectorAll('img')) {\\n      let box = im.parentElement;\\n      for (let k = 0; k < 3 && box && !/\\\\\\\\d/.test(box.textContent || ''); k++) box = box.parentElement;\\n      const m = box && (box.textContent || '').replace(/\\\\\\\\s+/g, ' ').match(/([\\\\\\\\d.]{1,9})/);\\n      if (m && im.src && !itens.some((x) => x.img === im.src)) itens.push({ img: im.src, n: m[1], nome: im.alt || im.title || '' });\\n    }\\n  }\\n  const logEl = q('#hud-log');\\n  const log = logEl ? [...logEl.children].slice(-5).map((e) => e.textContent.trim()).filter(Boolean) : [];\\n  return {\\n    auto: auto.slice(0, 8), itens: itens.slice(0, 12),\\n    eco: (() => { try { return (${ecoScrape.toString()})(); } catch (e) { return null; } })(),\\n    nick, nivel: t('#tr-level'), ouro: t('#tr-gold'), gemas: t('#tr-gemas'), diamantes: t('#tr-diamantes'), guild: t('#tr-guild'),\\n    ativos, hunt: t('#hud-hunt'), log,\\n    pk: { nome: pkNome, lv: t('#ativo-card .pl-lv'), hp: t('#ativo-card .barra.hp span'), xp: t('#ativo-card .barra.xp span'), sprite },\\n    ses: J('sessao-hunt:' + key) || {},\\n    caps: (J('capturas-hist:' + key) || []).slice(0, 8).map((c) => ({ nome: c.nome, lv: c.level, shiny: !!c.shiny, em: c.em, pot: c.potencia })),\\n  };\\n})()`;\\nasync function refreshDash() {\\n  if (!megaEco() || !dash || dash.webContents.isDestroyed()) return;\\n  const contas = await Promise.all(views.map(async (v, i) => {\\n    let d = null;\\n    try { d = await withTimeout(v.webContents.executeJavaScript(RESUMO_JS), 4000); } catch {}\\n    return Object.assign({ conta: i, nome: nameOf(i) }, d || { erro: true });\\n  }));\\n  if (!dash.webContents.isDestroyed()) dash.webContents.send('resumo', { at: Date.now(), contas });\\n}\\nconst refreshResumo = () => refreshDash();\\nipcMain.on('resumo-ready', () => refreshDash());\\n// botões do painel: \\\"Normal\\\", \\\"Ver os jogos (Eco)\\\" ou abrir uma conta\\n// botão \\\"Ligar a cena\\\" de cada conta: troca só aquela conta entre Eco e Normal\\nipcMain.on('cena-toggle', (_, i) => {\\n  if (!Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return;\\n  setLevel(i, level[i] === 1 ? 0 : 1, true);\\n  buildMenu();\\n});\\n// modo de desempenho: vale para as 4 contas (menu \\\"Desempenho\\\" da barra de cima)\\nfunction setAllLevel(lv) {\\n  if (!(lv >= 0 && lv <= 2)) return;\\n  ACCOUNTS.forEach((_, k) => setLevel(k, lv, true));\\n  if (lv === 2) setFocus(-1);\\n  layout();\\n  buildMenu();\\n  refreshDash();\\n}\\nipcMain.on('resumo-nivel', (_, i, lv) => {\\n  setAllLevel(lv);\\n  if (Number.isInteger(i) && i >= 0 && i < ACCOUNTS.length) setFocus(i);\\n});\\n\\nasync function applyLevel(i, waking) {\\n  const wc = views[i].webContents;\\n  if (wc.isDestroyed()) return;\\n  const lv = level[i];\\n  const seq = ++levelSeq[i]; // se o nível mudar de novo no meio, esta aplicação para\\n\\n  // 1) PRIMEIRO mostra/esconde a tela. Antes isso ficava no fim, depois de rodar scripts na página;\\n  //    vindo do Hibernar, a página pausada podia não responder e a tela nunca voltava (ficava preta).\\n  wc.setBackgroundThrottling(lv === 3); // hibernando: deixa o Chromium pausar a página escondida\\n  layout();\\n  if (waking) {\\n    // Depois de hibernar, o jogo pode não voltar a se desenhar sozinho (tela vazia).\\n    // Recarregar a conta garante que ela volta funcionando; o nível é reaplicado no dom-ready.\\n    ecoCss[i] = null;\\n    wc.reload();\\n    return;\\n  }\\n  if (lv !== 3) { try { wc.invalidate(); } catch {} } // força redesenhar\\n\\n  // 2) depois ajusta a página (efeitos/quadros), sem travar se ela demorar\\n  try {\\n    // limpa ajustes de versões antigas do PokeLink (se houver)\\n    if (ecoCss[i]) { const k = ecoCss[i]; ecoCss[i] = null; await withTimeout(wc.removeInsertedCSS(k), 3000); }\\n    await withTimeout(wc.executeJavaScript(ECO_OFF), 3000);\\n    if (seq !== levelSeq[i]) return;\\n    // Eco e Mega Eco: liga o \\\"Modo Economia\\\" do próprio jogo; Normal: desliga\\n    const querEco = lv === 1 || lv === 2;\\n    const r = await withTimeout(wc.executeJavaScript(GAME_ECO_JS(querEco, gameEco[i])), 3000);\\n    if (r === 'ok' || r === 'trocou') gameEco[i] = querEco;\\n  } catch {}\\n  if (lv === 2) refreshResumo(i);\\n\\n}\\n\\nfunction sendState() {\\n  bars.forEach((b) => {\\n    if (!b.webContents.isDestroyed()) b.webContents.send('state', {\\n      level, names: displayNames(), focused, muted, pos: ACCOUNTS.map((_, i) => barPos(i)),\\n      auto: { enabled: auto.enabled, dry: auto.contas.map((c) => c.dry), status: autoStatus },\\n      lives: livesState(),\\n      loading,\\n      extBtns: EXTENSIONS.filter((e) => e.botao && !extOff.has(e.id)).map((e) => ({ id: e.id, botao: e.botao, nome: e.nome })),\\n      hunt: { on: autoHunt.contas, status: huntStatus },\\n    });\\n  });\\n}\\n\\nipcMain.on('bar-ready', sendState);\\n// ----- medição de uso (CPU e memória) de cada conta, para ver se o modo de desempenho faz diferença -----\\nconst usage = { porPid: new Map(), total: { cpu: 0, mem: 0 }, gpu: { cpu: 0, mem: 0 }, lista: [] };\\n// memória \\\"própria\\\" de cada processo (a mesma que o Gerenciador de Tarefas mostra). Antes somava a memória\\n// compartilhada entre os processos várias vezes, e o total aparecia bem maior do que o real.\\nconst memDe = (m) => (m.memory.privateBytes || m.memory.workingSetSize) / 1024;\\nfunction sampleUsage() {\\n  try {\\n    const ms = app.getAppMetrics();\\n    usage.lista = ms;\\n    usage.porPid = new Map(ms.map((m) => [m.pid, { cpu: m.cpu.percentCPUUsage, mem: memDe(m) }]));\\n    usage.total = ms.reduce((t, m) => ({ cpu: t.cpu + m.cpu.percentCPUUsage, mem: t.mem + memDe(m) }), { cpu: 0, mem: 0 });\\n    const g = ms.find((m) => m.type === 'GPU');\\n    usage.gpu = g ? { cpu: g.cpu.percentCPUUsage, mem: memDe(g) } : { cpu: 0, mem: 0 };\\n  } catch {}\\n}\\nfunction usageOf(i) {\\n  const wc = views[i] && views[i].webContents;\\n  if (!wc || wc.isDestroyed()) return null;\\n  try { return usage.porPid.get(wc.getOSProcessId()) || null; } catch { return null; }\\n}\\nconst fmtUso = (u) => (u ? `CPU ${u.cpu.toFixed(0)}% · ${Math.round(u.mem)} MB` : 'medindo...');\\n\\nconst LEVELS = [\\n  { name: 'Normal', desc: 'o jogo como ele é, sem nada desligado' },\\n  { name: 'Eco', desc: 'liga o Modo Economia do próprio jogo (desliga a cena da batalha)' },\\n  { name: 'Mega Eco', desc: 'todas as contas: troca as telas por um painel com o resumo do farm; os jogos continuam rodando' },\\n];\\n// medidor: junta o uso de cada conta e de cada grupo, com o nível (ok / médio / alto)\\nconst FAIXAS = { conta: [400, 700], jogo: [1600, 2800], kick: [200, 350], twitch: [60, 150], barras: [300, 500], gpu: [600, 1000], outros: [500, 900], total: [3000, 5000] };\\nfunction nivelDe(mem, faixa, cpu, cpuF = [20, 50]) {\\n  const n = (v, [x, y]) => (v >= y ? 2 : v >= x ? 1 : 0);\\n  return ['ok', 'medio', 'alto'][Math.max(n(mem, faixa), n(cpu || 0, cpuF))];\\n}\\nfunction usoDados() {\\n  const soma = (wcs) => {\\n    const pids = new Set();\\n    wcs.forEach((wc) => { try { if (wc && !wc.isDestroyed()) pids.add(wc.getOSProcessId()); } catch {} });\\n    return [...pids].reduce((t, pid) => { const u = usage.porPid.get(pid); return u ? { cpu: t.cpu + u.cpu, mem: t.mem + u.mem } : t; }, { cpu: 0, mem: 0 });\\n  };\\n  const livesDe = (p) => liveOpen.flatMap((o) => [...o[p].values()].map((sl) => sl.view && sl.view.webContents));\\n  const nTw = liveOpen.reduce((t, o) => t + o.twitch.size, 0);\\n  const nKk = liveOpen.reduce((t, o) => t + o.kick.size, 0);\\n  const contas = ACCOUNTS.map((_, i) => {\\n    const u = usageOf(i) || { cpu: 0, mem: 0 };\\n    return { nome: nameOf(i), modo: LEVELS[level[i]] ? LEVELS[level[i]].name : 'hibernando', cpu: u.cpu, mem: u.mem, nivel: nivelDe(u.mem, FAIXAS.conta, u.cpu, [15, 40]) };\\n  });\\n  const gJogo = soma(views.map((v) => v.webContents));\\n  const gTw = soma([...livesDe('twitch'), ...ircs.map((c) => c && c.view.webContents)]);\\n  const gKk = soma(livesDe('kick'));\\n  const gBar = soma([...bars.map((b) => b.webContents), titleBar && titleBar.webContents]);\\n  const conhecidos = new Set();\\n  [...views.map((v) => v.webContents), ...livesDe('twitch'), ...livesDe('kick'), ...ircs.map((c) => c && c.view.webContents),\\n    ...bars.map((b) => b.webContents), titleBar && titleBar.webContents]\\n    .forEach((wc) => { try { if (wc && !wc.isDestroyed()) conhecidos.add(wc.getOSProcessId()); } catch {} });\\n  const outrosProc = usage.lista.filter((m) => m.type !== 'GPU' && !conhecidos.has(m.pid));\\n  const nomeProc = (m) => {\\n    if (m.type === 'Browser') return 'programa principal';\\n    const n = String(m.name || m.serviceName || '');\\n    if (/network/i.test(n)) return 'internet';\\n    if (/audio/i.test(n)) return 'som';\\n    if (/storage/i.test(n)) return 'arquivos';\\n    if (/video capture/i.test(n)) return 'captura de vídeo';\\n    if (m.type === 'Tab') {\\n      try {\\n        const wc = webContents.getAllWebContents().find((w) => !w.isDestroyed() && w.getOSProcessId() === m.pid);\\n        if (wc) { const u = wc.getURL(); return 'página escondida: ' + (u.startsWith('file:') ? 'PokeLink' : (u.split('/')[2] || 'vazia')); }\\n      } catch {}\\n      return 'extensão ou página escondida';\\n    }\\n    return n || m.type;\\n  };\\n  const porNome = new Map();\\n  outrosProc.forEach((m) => { const k = nomeProc(m); porNome.set(k, (porNome.get(k) || 0) + memDe(m)); });\\n  const gOutros = outrosProc.reduce((t, m) => ({ cpu: t.cpu + m.cpu.percentCPUUsage, mem: t.mem + memDe(m) }), { cpu: 0, mem: 0 });\\n  const grupo = (id, nome, u, faixa, qtd, dica) => {\\n    const porItem = qtd ? u.mem / qtd : u.mem;\\n    return { id, nome, cpu: u.cpu, mem: u.mem, qtd: qtd || 0, porItem: qtd ? porItem : null, dica,\\n      nivel: qtd === 0 && (id === 'kick' || id === 'twitch') ? 'ok' : nivelDe(porItem, faixa, u.cpu) };\\n  };\\n  const grupos = [\\n    grupo('jogo', 'As 4 contas do jogo', gJogo, FAIXAS.jogo, null, 'Eco e Mega Eco diminuem'),\\n    grupo('gpu', 'Placa de vídeo', usage.gpu, FAIXAS.gpu, null, 'desenho das telas'),\\n    grupo('kick', `Lives da Kick`, gKk, FAIXAS.kick, nKk, 'player pequeno: menos'),\\n    grupo('twitch', `Lives da Twitch`, gTw, FAIXAS.twitch, nTw, 'conexão direta: quase nada'),\\n    grupo('barras', 'Barras e painéis', gBar, FAIXAS.barras, null, 'interface do PokeLink'),\\n    grupo('outros', `Outros`, gOutros, FAIXAS.outros, null, `${outrosProc.length} processos`),\\n  ].sort((x, y) => y.mem - x.mem);\\n  const nLives = nTw + nKk;\\n  return {\\n    contas, grupos,\\n    outros: [...porNome].sort((a, b) => b[1] - a[1]).slice(0, 8).map(([nome, mem]) => ({ nome, mem })),\\n    total: { cpu: usage.total.cpu, mem: usage.total.mem, nivel: nivelDe(usage.total.mem, FAIXAS.total, usage.total.cpu, [25, 60]), nLives },\\n  };\\n}\\nipcMain.handle('uso-get', () => usoDados());\\n// painel de uso: desce na própria janela (cartões coloridos); sem a barra de cima, mostra em texto\\nfunction showUsage() {\\n  sampleUsage();\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (canDraw) {\\n    const id = ++cfgPanelSeq;\\n    cfgPanels.add(id);\\n    dialogOpen = true;\\n    layout();\\n    titleBar.webContents.focus();\\n    titleBar.webContents.send('title-uso', { id });\\n    return;\\n  }\\n  const d = usoDados();\\n  const f = (u) => fmtUso(u);\\n  uiDialog({\\n    type: 'info',\\n    title: 'Uso de CPU e memória',\\n    message: 'Quanto cada conta está usando agora',\\n    detail: d.contas.map((c) => `${c.nome} — ${c.modo}: ${f(c)}`).join('\\\\n') +\\n      '\\\\n\\\\nPor grupo:\\\\n' + d.grupos.map((g) => `${g.nome}${g.qtd ? ` (${g.qtd})` : ''}: ${f(g)}`).join('\\\\n') +\\n      `\\\\n\\\\nPokeLink inteiro (${d.total.nLives} lives): ${f(d.total)}`,\\n  });\\n}\\nfunction setLevel(i, lv, soEsta) {\\n  if (!(i >= 0 && i < ACCOUNTS.length) || !(lv >= 0 && lv <= 2)) return; // 0 Normal, 1 Eco, 2 Mega Eco\\n  // Mega Eco é para todas as contas de uma vez\\n  if (!soEsta) { setAllLevel(lv); return; } // o modo vale para todas as contas\\n  const waking = level[i] === 3 && lv !== 3;\\n  level[i] = lv;\\n  applyLevel(i, waking);\\n  sendState();\\n}\\nipcMain.on('level-set', (_, i, lv) => setLevel(i, lv));\\n\\nlet lastPerfMenu = null;\\nipcMain.on('perf-menu', async (e, i, rect) => {\\n  if (!(i >= 0 && i < ACCOUNTS.length)) return;\\n  // menu no tema do PokeLink, desenhado pela barra de título (que cobre a janela enquanto ele está aberto)\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (canDraw && rect) {\\n    const b = bars[i].getBounds();\\n    const r = await uiPopup({\\n      x: b.x + Math.round(rect.left), y: b.y + Math.round(rect.bottom) + 4,\\n      up: b.y + Math.round(rect.top) - 4, // se não couber embaixo, abre para cima\\n      title: `Desempenho — ${nameOf(i)}`,\\n      sub: `Agora esta conta usa: ${fmtUso(usageOf(i))}` + (level[i] === 3 ? ' (hibernando)' : ''),\\n      items: LEVELS.map((L, lv) => ({ value: lv, label: L.name, desc: L.desc, checked: level[i] === lv, icon: ['▶', '🍃', '📊', '💤'][lv] })),\\n    });\\n    if (r != null) setLevel(i, r);\\n    return;\\n  }\\n  lastPerfMenu = Menu.buildFromTemplate([\\n    { label: `Desempenho — ${nameOf(i)}`, enabled: false },\\n    { type: 'separator' },\\n    ...LEVELS.map((L, lv) => ({\\n      label: `${L.name}  —  ${L.desc}`,\\n      type: 'radio',\\n      checked: level[i] === lv,\\n      click: () => setLevel(i, lv),\\n    })),\\n  ]);\\n  lastPerfMenu.popup({ window: win });\\n});\\n\\n// ---------- Som, recarregar e troca de tela (acionados pela barra) ----------\\nconst muted = ACCOUNTS.map((_, i) => i > 0); // contas 2, 3 e 4 começam sem som\\n\\nfunction setMuted(i, m) {\\n  muted[i] = !!m;\\n  views[i].webContents.setAudioMuted(muted[i]);\\n  const menu = Menu.getApplicationMenu();\\n  const item = menu && menu.getMenuItemById('mute' + i);\\n  if (item) item.checked = muted[i]; // mantém o menu Áudio em sincronia com a barra\\n  sendState();\\n}\\n\\nipcMain.on('view-set', (_, n) => {\\n  if (Number.isInteger(n) && n >= -1 && n < ACCOUNTS.length) setFocus(n);\\n});\\n// Recarregar uma conta de forma confiável.\\n// Antes falhava às vezes porque: (1) o jogo pedia \\\"tem certeza que quer sair?\\\" e o Electron\\n// cancelava o recarregamento em silêncio; (2) a página estava travada e não respondia.\\nconst loading = ACCOUNTS.map(() => false);\\nfunction reloadAccount(i) {\\n  const wc = views[i] && views[i].webContents;\\n  if (!wc || wc.isDestroyed()) return;\\n  let started = false;\\n  const onStart = () => { started = true; };\\n  wc.once('did-start-loading', onStart);\\n  wc.reloadIgnoringCache();\\n  setTimeout(() => {\\n    if (wc.isDestroyed()) return;\\n    wc.removeListener('did-start-loading', onStart);\\n    if (started) return;\\n    // não começou a carregar: a página está travada; reinicia o processo dela e carrega de novo\\n    try { wc.forcefullyCrashRenderer(); } catch {}\\n    setTimeout(() => { if (!wc.isDestroyed()) wc.loadURL(GAME_URL).catch(() => {}); }, 300);\\n  }, 4000);\\n}\\n// ---------- Vigia anti-travamento ----------\\n// Se a página de uma conta parar de responder (jogo congelado), o PokeLink reinicia só aquela conta sozinho,\\n// em vez de o jogador ter que fechar e abrir o programa.\\nconst travada = ACCOUNTS.map(() => null);      // quando a página começou a não responder\\nconst pingFalhas = ACCOUNTS.map(() => 0);      // checagens seguidas sem resposta\\nconst ultimaRecup = ACCOUNTS.map(() => 0);     // evita ficar reiniciando sem parar\\nfunction logTravamento(msg) {\\n  try {\\n    const f = path.join(app.getPath('userData'), 'travamentos.log');\\n    try { if (fs.statSync(f).size > 200 * 1024) fs.writeFileSync(f, ''); } catch {}\\n    fs.appendFileSync(f, new Date().toLocaleString('pt-BR') + ' - ' + msg + '\\\\n');\\n  } catch {}\\n}\\nfunction recuperarConta(i, motivo) {\\n  const wc = views[i] && views[i].webContents;\\n  if (!wc || wc.isDestroyed()) return;\\n  if (Date.now() - ultimaRecup[i] < 2 * 60 * 1000) return; // no máximo 1 vez a cada 2 min por conta\\n  ultimaRecup[i] = Date.now();\\n  travada[i] = null; pingFalhas[i] = 0;\\n  autoBusy[i] = false; // a Auto Compra que estava presa na página travada é liberada\\n  logTravamento(`${nameOf(i)} travou (${motivo}); reiniciando a conta`);\\n  avisoCelular('erro', `${nameOf(i)} travou`, 'Foi reiniciada sozinha e já está voltando a farmar.');\\n  try { wc.forcefullyCrashRenderer(); } catch {} // o aviso de \\\"processo fechou\\\" já recarrega o jogo\\n  setTimeout(() => { if (!wc.isDestroyed() && wc.getURL() === '') wc.loadURL(GAME_URL).catch(() => {}); }, 2500);\\n}\\nasync function vigiaContas() {\\n  if (sono.ausente) return;\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    const wc = views[i] && views[i].webContents;\\n    if (!wc || wc.isDestroyed() || level[i] === 3 || wc.isLoading()) { pingFalhas[i] = 0; continue; }\\n    // aviso do próprio Chromium: travada há mais de 30 s\\n    if (travada[i] && Date.now() - travada[i] > 30000) { recuperarConta(i, 'sem responder'); continue; }\\n    // checagem simples: a página responde a um \\\"oi\\\" em até 10 s?\\n    const ok = await withTimeout(wc.executeJavaScript('1'), 10000).then(() => true, () => false);\\n    pingFalhas[i] = ok ? 0 : pingFalhas[i] + 1;\\n    if (pingFalhas[i] >= 3) recuperarConta(i, 'não respondeu 3 checagens');\\n  }\\n}\\n// ---------- Deixar o PC dormir/hibernar ----------\\n// As lives e o jogo tocando vídeo/áudio seguram o Windows acordado (\\\"Video Wake Lock\\\" no powercfg /requests).\\n// Com esta opção (DESLIGADA por padrão: quem farma quer o PC acordado), quando você fica sem mexer no PC quase o tempo que o Windows espera\\n// para dormir/hibernar, o PokeLink pausa tudo (fecha as lives e deixa as contas em branco) e o PC dorme\\n// normalmente. Quando você volta, as contas carregam de novo sozinhas.\\n// Se o Windows estiver configurado para \\\"Nunca\\\" dormir, nada muda: o PokeLink continua farmando.\\nconst sono = { ligado: false, ausente: false, desde: 0, timeout: 0, naoRepetir: false };\\nconst sonoFile = () => path.join(app.getPath('userData'), 'sono.json');\\nfunction loadSono() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(sonoFile(), 'utf8'));\\n    if (typeof j.ligado === 'boolean' && j.v2) sono.ligado = j.ligado; // (versão anterior vinha ligada sem você escolher)\\n    if (typeof j.tela === 'boolean') tela.ligado = j.tela;\\n  } catch {}\\n}\\nconst salvarSono = () => { try { fs.writeFileSync(sonoFile(), JSON.stringify({ v2: true, ligado: sono.ligado, tela: tela.ligado })); } catch {} };\\n// Mantém o PC LIGADO para o farm continuar (a tela pode apagar normalmente: isto não segura o monitor).\\n// Só fica desligado se você escolheu \\\"Pausar o farm para o PC dormir\\\".\\nlet pcAcordadoId = null;\\nfunction manterPcAcordado() { }\\nfunction setSono(on) {\\n  sono.ligado = !!on;\\n  salvarSono();\\n  manterPcAcordado();\\n  if (!on && sono.ausente) voltarDoAusente();\\n  buildMenu();\\n}\\n// lê do Windows em quantos segundos ele dorme/hiberna sozinho (0 = nunca); na bateria vale o tempo da bateria\\nfunction lerTempoWindows() {\\n  if (process.platform !== 'win32') return;\\n  const { execFile } = require('child_process');\\n  const ler = (nome) => new Promise((ok) => {\\n    execFile('powercfg', ['/q', 'SCHEME_CURRENT', 'SUB_SLEEP', nome], { windowsHide: true, timeout: 10000 }, (err, out) => {\\n      const hex = String(out || '').match(/0x[0-9a-f]{8}/gi) || [];\\n      if (err || hex.length < 2) return ok(0);\\n      const [ca, cc] = hex.slice(-2).map((h) => parseInt(h, 16)); // os dois últimos: na tomada e na bateria\\n      let bat = false; try { bat = powerMonitor.isOnBatteryPower(); } catch {}\\n      ok((bat ? cc : ca) || 0);\\n    });\\n  });\\n  Promise.all([ler('STANDBYIDLE'), ler('HIBERNATEIDLE')]).then((t) => {\\n    const v = t.filter((x) => x > 0);\\n    sono.timeout = v.length ? Math.min(...v) : 0;\\n  }).catch(() => {});\\n}\\nfunction entrarAusente() {\\n  sono.ausente = true;\\n  sono.desde = Date.now();\\n  logTravamento('PC sem uso: PokeLink pausado para o Windows poder dormir/hibernar');\\n  avisoCelular('pc', 'Farm pausado', 'O PC ficou sem uso e o PokeLink pausou tudo para ele dormir.');\\n  monitorEnviar(true); // avisa o celular antes de o PC dormir\\n  syncLives(); // fecha as lives (com o PC ausente nenhuma fica aberta)\\n  ACCOUNTS.forEach((_, i) => { if (ircs[i]) closeIrc(i); });\\n  views.forEach((v) => {\\n    const wc = v && v.webContents;\\n    if (!wc || wc.isDestroyed()) return;\\n    wc.setAudioMuted(true);\\n    wc.loadURL('about:blank').catch(() => {}); // página vazia: solta o vídeo e o som\\n  });\\n  sendState();\\n}\\nfunction voltarDoAusente() {\\n  if (!sono.ausente) return;\\n  sono.ausente = false;\\n  avisoCelular('pc', 'Farm voltou', 'O PC acordou e as contas estão carregando de novo.');\\n  views.forEach((v, i) => {\\n    const wc = v && v.webContents;\\n    if (!wc || wc.isDestroyed()) return;\\n    wc.setAudioMuted(!!muted[i]);\\n    wc.loadURL(GAME_URL).catch(() => {});\\n  });\\n  ACCOUNTS.forEach((_, i) => { autoLast[i] = Date.now() - checkMs() + 60000; }); // Auto Compra volta depois de ~1 min\\n  setTimeout(checkLives, 15000);\\n  syncLives();\\n  sendState();\\n}\\n// ---------- Deixar a tela apagar (o farm continua) ----------\\n// O PokeLink impede o Windows de saber quando a janela está escondida (para a Kick não pausar). Por isso o\\n// vídeo das lives e do jogo seguravam a TELA acesa (\\\"Video Wake Lock\\\"), até com o PC bloqueado.\\n// Agora, ao bloquear o PC (Windows+L) ou quando a tela iria apagar por falta de uso, o PokeLink esconde a\\n// própria janela: o Windows apaga a tela normalmente, e o jogo e as lives continuam rodando por trás.\\n// Quando você volta (mexe no mouse/teclado ou desbloqueia), a janela aparece de novo.\\nconst tela = { ligado: true, off: false, bloqueada: false, voltou: 0, apagaEm: 0 };\\nfunction setTela(on) { tela.ligado = !!on; salvarSono(); if (!on) acenderTela(); buildMenu(); }\\n// Só esconder a janela não bastava: as páginas continuavam se achando \\\"na tela\\\" e o vídeo segurava o monitor\\n// aceso. Agora as páginas também saem da janela enquanto a tela está apagada (aí o Windows sabe que ninguém\\n// está vendo vídeo); o jogo e as lives continuam rodando normalmente por trás.\\nlet telaFilhos = [];\\nfunction apagarTela() { }\\nfunction acenderTela() { }\\nfunction checarTela() { }\\n// lê em quantos segundos o Windows apaga a tela (0 = nunca)\\nfunction lerTempoTela() { }\\nfunction checarAusencia() {\\n  if (process.platform !== 'win32') return;\\n  let idle = 0; try { idle = powerMonitor.getSystemIdleTime(); } catch { return; }\\n  if (idle < 60) sono.naoRepetir = false; // você mexeu no PC\\n  if (sono.ausente) {\\n    if (idle < 60) { voltarDoAusente(); return; }\\n    // passou bem do tempo e o PC não dormiu (outro programa segurando): volta a farmar e não pausa de novo até você mexer\\n    if (Date.now() - sono.desde > 15 * 60 * 1000) { sono.naoRepetir = true; voltarDoAusente(); }\\n    return;\\n  }\\n  if (!sono.ligado || !sono.timeout || sono.naoRepetir) return;\\n  if (idle >= Math.max(60, sono.timeout - 60)) entrarAusente(); // 1 minuto antes do Windows dormir\\n}\\nipcMain.on('reload-account', (_, i) => {\\n  if (Number.isInteger(i) && i >= 0 && i < ACCOUNTS.length) reloadAccount(i);\\n});\\nipcMain.on('mute-toggle', (_, i) => {\\n  if (views[i]) setMuted(i, !muted[i]);\\n});\\n\\n// ---------- Atualização dentro do app ----------\\nconst UPDATABLE = ['main.js', 'preload.js', 'bar.html'];\\n\\nfunction restartApp() {\\n  app.relaunch();\\n  app.exit(0);\\n}\\n\\n// Atualizações vêm num pacote \\\".plk\\\" ASSINADO por você (veja assinar-atualizacao.js).\\n// O app só instala pacotes cuja assinatura bate com esta chave pública, então ninguém além de você\\n// consegue colocar código no PokeLink por esse menu. Esta linha é preenchida pelo script na 1ª vez.\\nconst UPDATE_PUBLIC_KEY = `-----BEGIN PUBLIC KEY-----\\nMCowBQYDK2VwAyEAVcB59cUlJYYtgWKZjWaxLmSemRouKoYPqNnlAxj4nyI=\\n-----END PUBLIC KEY-----`;\\n\\nconst verParts = (v) => String(v).split(/[^0-9]+/).filter(Boolean).map(Number);\\nfunction compareVersions(a, b) {\\n  const x = verParts(a), y = verParts(b);\\n  for (let k = 0; k < Math.max(x.length, y.length); k++) {\\n    const d = (x[k] || 0) - (y[k] || 0);\\n    if (d) return d > 0 ? 1 : -1;\\n  }\\n  return 0;\\n}\\n\\n// confere se cada arquivo tem o conteúdo certo (evita, por ex., código JS salvo como bar.html)\\nfunction checkFileContent(name, content) {\\n  if (typeof content !== 'string' || !content.trim()) return `${name} está vazio.`;\\n  if (name.endsWith('.html')) {\\n    if (!/^\\\\s*<!doctype html/i.test(content)) return `${name} não é uma página HTML (o arquivo parece trocado).`;\\n    return null;\\n  }\\n  if (/^\\\\s*</.test(content)) return `${name} parece ser HTML, não JavaScript (o arquivo parece trocado).`;\\n  if (name === 'main.js' && !content.includes('BaseWindow')) return 'main.js não parece ser o arquivo principal do PokeLink.';\\n  if (name === 'preload.js' && (!content.includes('exposeInMainWorld') || content.includes('BaseWindow'))) return 'preload.js não parece ser o preload do PokeLink.';\\n  try { new vm.Script(content, { filename: name }); } catch (e) { return `${name} tem erro de sintaxe: ${e.message}`; }\\n  return null;\\n}\\n\\n// lê e confere um pacote; devolve { version, files } ou lança um erro com mensagem amigável\\nfunction readUpdatePackage(file) {\\n  let pkg;\\n  try { pkg = JSON.parse(fs.readFileSync(file, 'utf8')); }\\n  catch { throw new Error('O arquivo não é um pacote de atualização do PokeLink.'); }\\n  if (!pkg || typeof pkg.payload !== 'string' || typeof pkg.sig !== 'string') {\\n    throw new Error('O arquivo não é um pacote de atualização do PokeLink.');\\n  }\\n  let ok = false;\\n  try {\\n    ok = require('crypto').verify(null, Buffer.from(pkg.payload, 'utf8'), UPDATE_PUBLIC_KEY, Buffer.from(pkg.sig, 'base64'));\\n  } catch { ok = false; }\\n  if (!ok) throw new Error('A assinatura do pacote não é válida. Ele não foi gerado pelo desenvolvedor do PokeLink ou foi alterado.');\\n  const data = JSON.parse(pkg.payload);\\n  const names = Object.keys(data.files || {});\\n  if (!names.length || names.some((n) => !UPDATABLE.includes(n))) throw new Error('O pacote tem arquivos inesperados.');\\n  for (const n of names) {\\n    const err = checkFileContent(n, data.files[n]);\\n    if (err) throw new Error(err);\\n  }\\n  return { version: String(data.version || '?'), files: data.files };\\n}\\n\\nasync function applyUpdate() {\\n  if (!UPDATE_PUBLIC_KEY) {\\n    showError('Atualizações', 'As atualizações ainda não foram configuradas nesta versão do PokeLink.');\\n    return;\\n  }\\n  const r = await dialog.showOpenDialog({\\n    title: 'Escolha o pacote de atualização do PokeLink',\\n    properties: ['openFile'],\\n    filters: [{ name: 'Atualização do PokeLink', extensions: ['plk'] }],\\n  });\\n  if (r.canceled || !r.filePaths.length) return;\\n\\n  let up;\\n  try { up = readUpdatePackage(r.filePaths[0]); }\\n  catch (e) { showError('Atualização recusada', e.message); return; }\\n\\n  const cmp = compareVersions(up.version, APP_VERSION);\\n  const c = await uiDialog({\\n    type: cmp > 0 ? 'question' : 'warning',\\n    title: 'Atualização',\\n    message: cmp > 0\\n      ? `Atualizar de ${APP_VERSION} para ${up.version}?`\\n      : `Este pacote (${up.version}) não é mais novo que a versão instalada (${APP_VERSION}).`,\\n    detail: cmp > 0\\n      ? 'O PokeLink reinicia ao final. Os logins e configurações das contas são mantidos.'\\n      : 'Instalar mesmo assim vai substituir a versão atual por esta.',\\n    buttons: [cmp > 0 ? 'Atualizar' : 'Instalar mesmo assim', 'Cancelar'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (c.response !== 0) return;\\n\\n  installPackage(up);\\n}\\n\\n// grava os arquivos do pacote (já conferido) e reinicia\\nfunction installPackage(up) {\\n  try {\\n    for (const [name, content] of Object.entries(up.files)) {\\n      const dest = path.join(__dirname, name);\\n      if (fs.existsSync(dest)) fs.copyFileSync(dest, dest + '.bak'); // guarda a versão anterior\\n      fs.writeFileSync(dest, content, 'utf8');\\n    }\\n  } catch (e) {\\n    showError('Falha ao instalar', e.message);\\n    return false;\\n  }\\n  restartApp();\\n  return true;\\n}\\n\\n// ---------- Atualização online ----------\\n// O PokeLink confere de tempos em tempos um arquivo \\\"latest.json\\\" publicado por você na internet\\n// (ex.: num repositório do GitHub). Se houver versão nova, avisa o usuário e instala com um clique.\\n// O pacote baixado passa pela MESMA conferência de assinatura: só pacotes assinados por você entram,\\n// mesmo que alguém mexa no site onde os arquivos estão.\\n// Coloque aqui o endereço do seu latest.json (enquanto estiver vazio, a atualização online fica desligada):\\nconst UPDATE_FEED_URL = 'https://raw.githubusercontent.com/zNationsx/pokelink-atualizacoes/main/latest.json';\\nconst UPDATE_CHECK_HOURS = 3;\\nlet updateOffered = null;\\nlet updateBusy = false;\\n\\n// Lê o latest.json. No GitHub, o endereço \\\"raw\\\" fica alguns minutos em cache depois de você subir um\\n// arquivo novo; a API do GitHub entrega a versão mais recente na hora. Usa a API e, se falhar, o raw.\\nasync function fetchFeed(ses) {\\n  const m = UPDATE_FEED_URL.match(/^https:\\\\/\\\\/raw\\\\.githubusercontent\\\\.com\\\\/([^/]+)\\\\/([^/]+)\\\\/([^/]+)\\\\/(.+)$/);\\n  if (m) {\\n    try {\\n      const api = `https://api.github.com/repos/${m[1]}/${m[2]}/contents/${m[4]}?ref=${m[3]}`;\\n      const r = await withTimeout(ses.fetch(api, { headers: { Accept: 'application/vnd.github.raw+json', 'User-Agent': 'PokeLink' } }), 15000);\\n      if (r.ok) return JSON.parse(await r.text());\\n    } catch {}\\n  }\\n  const r = await withTimeout(ses.fetch(UPDATE_FEED_URL + (UPDATE_FEED_URL.includes('?') ? '&' : '?') + 't=' + Date.now(), { cache: 'no-store' }), 20000);\\n  if (!r.ok) throw new Error('servidor respondeu ' + r.status);\\n  return r.json();\\n}\\n\\nasync function checkOnlineUpdate(manual) {\\n  if (updateBusy) return;\\n  if (!UPDATE_FEED_URL || !UPDATE_PUBLIC_KEY) {\\n    if (manual) uiDialog({ type: 'info', title: 'Atualizações', message: 'A atualização online ainda não foi configurada.', detail: `Versão instalada: ${APP_VERSION}.` });\\n    return;\\n  }\\n  updateBusy = true;\\n  try {\\n    const ses = session.fromPartition('persist:lives-check');\\n    const feed = await fetchFeed(ses);\\n    if (!feed || !feed.version || !feed.file) throw new Error('arquivo latest.json incompleto');\\n    if (compareVersions(feed.version, APP_VERSION) <= 0) {\\n      if (manual) uiDialog({ type: 'info', title: 'Atualizações', message: 'Você já está na versão mais recente.',\\n        detail: `Versão instalada: ${APP_VERSION}.\\\\nVersão publicada online: ${feed.version}.` });\\n      return;\\n    }\\n    if (!manual && updateOffered === feed.version) return; // já ofereceu esta versão; não insiste\\n    updateOffered = feed.version;\\n    const c = await uiDialog({\\n      type: 'question',\\n      title: 'Atualização disponível',\\n      message: `Nova versão do PokeLink: ${feed.version}`,\\n      detail: (feed.notes ? `Novidades:\\\\n${feed.notes}\\\\n\\\\n` : '') + `Versão instalada: ${APP_VERSION}. O PokeLink reinicia ao final; logins e configurações são mantidos.`,\\n      buttons: ['Atualizar agora', 'Depois'],\\n      defaultId: 0,\\n      cancelId: 1,\\n    });\\n    if (c.response !== 0) return;\\n    // baixa o pacote, confere a assinatura e instala\\n    const url = new URL(feed.file, UPDATE_FEED_URL).href;\\n    const pr = await withTimeout(ses.fetch(url + (url.includes('?') ? '&' : '?') + 't=' + Date.now(), { cache: 'no-store' }), 60000);\\n    if (!pr.ok) throw new Error('não consegui baixar o pacote (' + pr.status + ')');\\n    const tmp = path.join(app.getPath('temp'), `pokelink-${feed.version}.plk`);\\n    fs.writeFileSync(tmp, Buffer.from(await pr.arrayBuffer()));\\n    let up;\\n    try { up = readUpdatePackage(tmp); } finally { try { fs.unlinkSync(tmp); } catch {} }\\n    if (compareVersions(up.version, APP_VERSION) <= 0) throw new Error('o pacote baixado não é mais novo que a versão instalada');\\n    installPackage(up);\\n  } catch (e) {\\n    if (manual) showError('Atualizações', 'Não consegui atualizar: ' + e.message);\\n  } finally {\\n    updateBusy = false;\\n  }\\n}\\n\\nasync function undoUpdate() {\\n  const c = await uiDialog({\\n    type: 'question',\\n    title: 'Desfazer atualização',\\n    message: 'Voltar para a versão anterior?',\\n    detail: 'O PokeLink reinicia ao final.',\\n    buttons: ['Voltar versão', 'Cancelar'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (c.response !== 0) return;\\n  let n = 0;\\n  try {\\n    for (const name of UPDATABLE) {\\n      const dest = path.join(__dirname, name);\\n      if (fs.existsSync(dest + '.bak')) { fs.copyFileSync(dest + '.bak', dest); n++; }\\n    }\\n  } catch (e) {\\n    showError('Falha ao restaurar', e.message);\\n    return;\\n  }\\n  if (!n) { showError('Desfazer', 'Não há versão anterior guardada.'); return; }\\n  restartApp();\\n}\\n\\n// ---------- Auto Compra (loja \\\"Market\\\" do jogo, paga em OURO): pokébolas, poções e revives ----------\\nconst DEFAULT_CFG = {\\n  dry: true, // começa em MODO TESTE\\n  rules: [\\n    // compra `buy` unidades quando você tiver menos de `min`. `cat` = aba do Market.\\n    { cat: 'Pokébolas', name: 'Poké Ball', on: true, min: 2000, buy: 5000 },\\n    { cat: 'Pokébolas', name: 'Great Ball', on: false, min: 500, buy: 1000 },\\n    { cat: 'Pokébolas', name: 'Super Ball', on: false, min: 500, buy: 1000 },\\n    { cat: 'Pokébolas', name: 'Ultra Ball', on: true, min: 1000, buy: 3000 },\\n    { cat: 'Poções', name: 'Small Potion', on: false, min: 100, buy: 500 },\\n    { cat: 'Poções', name: 'Great Potion', on: false, min: 5000, buy: 10000 },\\n    { cat: 'Poções', name: 'Ultra Potion', on: false, min: 1000, buy: 2000 },\\n    { cat: 'Poções', name: 'Hyper Potion', on: false, min: 500, buy: 1000 },\\n    { cat: 'Poções', name: 'Ultimate Potion', on: false, min: 200, buy: 500 },\\n    { cat: 'Poções', name: 'Golden Potion', on: false, min: 100, buy: 200 },\\n    { cat: 'Revives', name: 'Revive', on: false, min: 500, buy: 1000 },\\n    { cat: 'Revives', name: 'Max Revive', on: false, min: 200, buy: 300 },\\n  ],\\n  reserve: 1000000,  // nunca gasta o ouro abaixo disso\\n  maxHour: 5000000,  // limite de ouro gasto por conta a cada hora\\n  intervalMin: 3,    // verifica a cada N minutos\\n};\\n\\n// valida/limpa qualquer configuração (vinda do arquivo ou da janela de configuração)\\nfunction sanitizeCfg(c) {\\n  c = c || {};\\n  const n = (v, lo, hi, d) => { if (v === '' || v == null) return d; v = Math.floor(Number(v)); return Number.isFinite(v) ? Math.min(hi, Math.max(lo, v)) : d; };\\n  // só aceita itens conhecidos (nome e aba vêm da lista padrão, nunca de fora)\\n  const rules = DEFAULT_CFG.rules.map((d) => {\\n    const r = (Array.isArray(c.rules) && c.rules.find((x) => x && x.name === d.name)) || {};\\n    return { cat: d.cat, name: d.name, on: r.on === undefined ? d.on : !!r.on, min: n(r.min, 0, 100000000, d.min), buy: n(r.buy, 1, 10000000, d.buy) };\\n  });\\n  return {\\n    dry: typeof c.dry === 'boolean' ? c.dry : true,\\n    rules,\\n    reserve: n(c.reserve, 0, 2000000000, DEFAULT_CFG.reserve),\\n    maxHour: n(c.maxHour, 0, 20000000000, DEFAULT_CFG.maxHour),\\n    intervalMin: n(c.intervalMin, 1, 120, DEFAULT_CFG.intervalMin),\\n  };\\n}\\n\\nconst auto = Object.assign({ enabled: ACCOUNTS.map(() => false) }, sanitizeCfg({}));\\n// configuração própria de cada conta (itens, quantidades, reserva, limite, modo teste)\\nauto.contas = ACCOUNTS.map(() => sanitizeCfg({}));\\nconst cfgDe = (i) => auto.contas[i] || auto;\\nconst checkMs = () => auto.intervalMin * 60 * 1000;\\nconst autoStatus = ACCOUNTS.map(() => 'desligado');\\nconst autoBusy = ACCOUNTS.map(() => false);\\nconst autoLast = ACCOUNTS.map(() => 0);\\nconst spendLog = ACCOUNTS.map(() => []);\\nconst autoFile = () => path.join(app.getPath('userData'), 'autobuy.json');\\nconst autoLogFile = () => path.join(app.getPath('userData'), 'autobuy-log.txt');\\n\\nfunction loadAuto() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(autoFile(), 'utf8'));\\n    if (Array.isArray(j.enabled)) ACCOUNTS.forEach((_, i) => { auto.enabled[i] = !!j.enabled[i]; });\\n    Object.assign(auto, sanitizeCfg(j)); // arquivos antigos (só enabled/dry) continuam funcionando\\n    // versões antigas tinham uma configuração só: vira a configuração inicial de todas as contas\\n    ACCOUNTS.forEach((_, i) => { auto.contas[i] = sanitizeCfg(Array.isArray(j.contas) && j.contas[i] ? j.contas[i] : j); });\\n  } catch {}\\n  ACCOUNTS.forEach((_, i) => { autoStatus[i] = auto.enabled[i] ? 'ligado' : 'desligado'; });\\n}\\nfunction saveAuto() {\\n  try {\\n    fs.writeFileSync(autoFile(), JSON.stringify({\\n      enabled: auto.enabled, dry: auto.dry, rules: auto.rules,\\n      reserve: auto.reserve, maxHour: auto.maxHour, intervalMin: auto.intervalMin,\\n      contas: auto.contas,\\n    }));\\n  } catch {}\\n}\\nfunction autoLog(i, text) {\\n  try { fs.appendFileSync(autoLogFile(), `[${new Date().toLocaleString('pt-BR')}] ${nameOf(i)}: ${text}\\\\n`); } catch {}\\n}\\n\\n// Script que roda DENTRO da página do jogo (String.raw: sem crases e sem \\\"${\\\" aqui dentro)\\nconst AUTOBUY_PAGE = String.raw`(async (opts) => {\\n  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n  const vis = (el) => {\\n    if (!el) return false;\\n    const r = el.getBoundingClientRect();\\n    const cs = getComputedStyle(el);\\n    return r.width > 0 && r.height > 0 && cs.display !== 'none' && cs.visibility !== 'hidden';\\n  };\\n  const num = (t) => { const d = String(t == null ? '' : t).replace(/\\\\D/g, ''); return d ? parseInt(d, 10) : null; };\\n  const norm = (s) => String(s || '').normalize('NFD').replace(/[\\\\u0300-\\\\u036f]/g, '').toLowerCase().trim();\\n  const waitFor = async (fn, ms) => {\\n    const t0 = Date.now();\\n    while (Date.now() - t0 < (ms || 4000)) { const v = fn(); if (v) return v; await sleep(150); }\\n    return null;\\n  };\\n  const txt = (el) => (el && el.textContent ? el.textContent.trim() : '');\\n  const res = { lines: [], bought: 0, spent: 0, failed: false, skipped: false };\\n  const say = (s) => res.lines.push(s);\\n  const modalEl = () => document.getElementById('modal');\\n  const isOpen = () => { const m = modalEl(); return !!m && vis(m.querySelector('.modal-caixa')); };\\n  const closeModal = async () => {\\n    if (!isOpen()) return;\\n    const x = document.getElementById('modal-fechar');\\n    if (x) x.click();\\n    await waitFor(() => !isOpen(), 3000);\\n  };\\n  const linhas = (el) => String((el && el.innerText) || '').split('\\\\n').map((x) => x.trim()).filter(Boolean);\\n  const raizM = () => document.getElementById('modal') || document.body;\\n  // Market novo (sem as classes antigas): acha cada item pelo botão \\\"Comprar N\\\" e pelo texto \\\"você tem ×N\\\"\\n  // lê quantidade, nome e preço pelo TEXTO do cartão (\\\"você tem ×54.150\\\", \\\"Ultra Ball\\\", \\\"130 /un.\\\")\\n  const lerTexto = (c) => {\\n    const ls = linhas(c);\\n    const iTem = ls.findIndex((l) => /voc[eêÊ]\\\\s*tem/i.test(l));\\n    if (iTem < 0) return null;\\n    const temL = ls[iTem];\\n    const have = num((temL.match(/[×xX]\\\\s*([\\\\d.]+)/) || [])[1] || (ls[iTem + 1] && /^[×xX]?\\\\s*[\\\\d.]+$/.test(ls[iTem + 1]) ? ls[iTem + 1] : ''));\\n    const iNome = ls.findIndex((l, k) => k > iTem && !/^[×xX]?\\\\s*[\\\\d.]+$/.test(l));\\n    const iUn = ls.findIndex((l) => /\\\\/\\\\s*un/i.test(l));\\n    let price = null;\\n    if (iUn >= 0) { const m = ls[iUn].match(/([\\\\d.]+)\\\\s*\\\\/\\\\s*un/i); price = m ? num(m[1]) : num(ls[iUn - 1]); }\\n    return { name: iNome >= 0 ? ls[iNome] : '', have, price };\\n  };\\n  const cardsNovos = () => Array.from(raizM().querySelectorAll('button')).filter((b) => /^comprar\\\\b/i.test(txt(b)) && /\\\\d/.test(txt(b))).map((b) => {\\n    let c = b.parentElement;\\n    for (let k = 0; k < 6 && c && !/voc[eêÊ]\\\\s*tem/i.test(c.innerText || ''); k++) c = c.parentElement;\\n    if (!c) return null;\\n    const ls = linhas(c);\\n    const iTem = ls.findIndex((l) => /voc[eê] tem/i.test(l));\\n    if (iTem < 0) return null;\\n    const temL = ls[iTem];\\n    const have = num((temL.match(/[×x]\\\\s*([\\\\d.]+)/i) || [])[1] || (ls[iTem + 1] && /^[×x]?\\\\s*[\\\\d.]+$/.test(ls[iTem + 1]) ? ls[iTem + 1] : ''));\\n    const iNome = ls.findIndex((l, k) => k > iTem && !/^[×x]?\\\\s*[\\\\d.]+$/.test(l));\\n    const name = iNome >= 0 ? ls[iNome] : '';\\n    const iUn = ls.findIndex((l) => /\\\\/\\\\s*un/i.test(l));\\n    let price = null;\\n    if (iUn >= 0) { const m = ls[iUn].match(/([\\\\d.]+)\\\\s*\\\\/\\\\s*un/i); price = m ? num(m[1]) : num(ls[iUn - 1]); }\\n    return { el: c, name, have, price, buyBtn: b, input: c.querySelector('input') };\\n  }).filter((x) => x && x.name);\\n  const readCards = () => {\\n    const antigos = Array.from(document.querySelectorAll('#mk-corpo .mk-card'));\\n    if (!antigos.length) return cardsNovos();\\n    return antigos.map((c) => {\\n      const nome = c.querySelector('.mk-nome');\\n      const tem = c.querySelector('.mk-tem');\\n      const preco = c.querySelector('.mk-preco .mk-moeda') || c.querySelector('.mk-preco');\\n      const card = {\\n        el: c,\\n        name: (nome && nome.getAttribute('title')) || txt(nome),\\n        have: tem ? num((txt(tem).match(/[×xX]\\\\s*([\\\\d.]+)/) || [])[1] || txt(tem)) : null,\\n        price: preco ? num((txt(preco).match(/([\\\\d.]+)/) || [])[1]) : null,\\n        buyBtn: c.querySelector('button.mk-acao') || Array.from(c.querySelectorAll('button')).find((b) => /^comprar\\\\b/i.test(txt(b))) || null,\\n        input: c.querySelector('input[type=number]') || c.querySelector('input'),\\n      };\\n      // o Market mudou e manteve algumas classes antigas: o que não der para ler pelas classes, lê pelo texto\\n      if (card.have === null || !card.price || !card.name) {\\n        const t = lerTexto(c);\\n        if (t) {\\n          if (card.have === null) card.have = t.have;\\n          if (!card.price) card.price = t.price;\\n          if (!card.name) card.name = t.name;\\n        }\\n      }\\n      return card;\\n    });\\n  };\\n  // ouro: o número grande do Market que não está dentro de nenhum item\\n  const readGold = () => {\\n    const velho = document.querySelector('#mk-saldo .mk-moeda');\\n    if (velho) return num(txt(velho));\\n    const cards = readCards().map((c) => c.el);\\n    const nums = Array.from(raizM().querySelectorAll('div, span, b, strong'))\\n      .filter((e) => e.children.length <= 2 && /^[\\\\d.]{4,}$/.test(txt(e)) && !cards.some((c) => c.contains(e)))\\n      .map((e) => num(txt(e)));\\n    return nums.length ? Math.max.apply(null, nums) : null;\\n  };\\n  const temItens = () => readCards().length > 0;\\n\\n  if (isOpen()) {\\n    const m = modalEl();\\n    const titulo = txt(document.getElementById('modal-titulo')).slice(0, 40);\\n    const eMarket = norm(titulo) === 'market';\\n    // aviso/propaganda do jogo (ex.: \\\"Entrar no Discord\\\"): pode fechar pelo X. Qualquer outra janela é sua: não mexe.\\n    if (!eMarket && /discord/i.test(txt(m))) {\\n      const fechar = document.getElementById('modal-fechar')\\n        || m.querySelector('[aria-label*=\\\"echar\\\" i], [title*=\\\"echar\\\" i], .modal-fechar, .fechar')\\n        || Array.from(m.querySelectorAll('button')).find((b) => /^(×|✕|✖|x)$/i.test(txt(b)));\\n      if (fechar) { fechar.click(); await waitFor(() => !isOpen(), 3000); }\\n      if (!isOpen()) say('fechei um aviso do jogo (Discord) que estava na tela');\\n    }\\n    if (isOpen()) {\\n      res.reason = eMarket ? 'Market aberto por você' : 'janela aberta';\\n      say('uma janela do jogo está aberta' + (titulo ? ' (\\\"' + titulo + '\\\")' : '') + ', pulei. Feche-a que eu tento de novo em ~1 min');\\n      res.skipped = true;\\n      return res;\\n    }\\n  }\\n  // O Market abre INVISÍVEL durante a verificação: os cliques funcionam normalmente,\\n  // mas a janela não pisca na sua tela (ela some de novo no final, de qualquer jeito).\\n  const oculto = document.createElement('style');\\n  oculto.id = 'pokelink-market-oculto';\\n  oculto.textContent = '#modal, #modal * { opacity: 0 !important; transition: none !important; animation: none !important; }';\\n  document.head.appendChild(oculto);\\n  const mostrarModal = () => { try { oculto.remove(); } catch (e) {} };\\n  // Modo Economia do jogo (Eco/Mega Eco): a cena e os menus podem ficar escondidos.\\n  // Nesse caso liga a cena só durante a compra e desliga de novo no final.\\n  const acharBtnCena = () => Array.from(document.querySelectorAll('button, [role=button]'))\\n    .find((e) => /ligar a cena/i.test(txt(e)) && vis(e));\\n  let religarEco = false;\\n  const achaMarket = () => {\\n    const todos = Array.from(document.querySelectorAll('nav.menu-topo button, nav button, button, a, [role=button]'));\\n    const ok = (b) => norm(txt(b)) === 'market' || (norm(txt(b)).length < 24 && /\\bmarket\\b/.test(norm(txt(b))));\\n    return todos.find((b) => ok(b) && vis(b)) || todos.find(ok) || null;\\n  };\\n  let btn = achaMarket();\\n  const abrir = async () => {\\n    btn.click();\\n    return waitFor(() => isOpen() && temItens(), 5000);\\n  };\\n  if ((!btn || !vis(btn)) && acharBtnCena()) {\\n    acharBtnCena().click(); religarEco = true;\\n    await waitFor(() => { const b = achaMarket(); return b && vis(b); }, 4000);\\n    btn = achaMarket();\\n    if (religarEco) say('liguei a cena por um instante para usar o Market (Modo Economia)');\\n  }\\n  if (!btn) { mostrarModal(); say('botão Market não encontrado (a conta está logada?)'); res.reason = 'sem botão Market'; res.skipped = true; return res; }\\n  let origKey = null;\\n  try {\\n    let opened = await abrir();\\n    if (!opened && !religarEco && acharBtnCena()) {\\n      // o Market não abriu com a cena desligada: tenta de novo com a cena ligada\\n      acharBtnCena().click(); religarEco = true;\\n      say('liguei a cena por um instante para usar o Market (Modo Economia)');\\n      await sleep(1200);\\n      btn = achaMarket() || btn;\\n      opened = await abrir();\\n    }\\n    if (!opened) { say('o Market não abriu'); res.failed = true; return res; }\\n    // aba de compra (\\\"Compra\\\" no Market antigo, \\\"Comprar\\\" no novo)\\n    const aba = Array.from(document.querySelectorAll('.mk-aba')).find((b) => /^compra(r)?$/i.test(txt(b)))\\n      || Array.from(raizM().querySelectorAll('button, [role=tab]')).find((b) => /^compra(r)?$/i.test(txt(b)) && !/voc[eê] tem/i.test((b.parentElement && b.parentElement.innerText) || ''));\\n    if (aba && !aba.classList.contains('on')) { aba.click(); await sleep(500); }\\n    // abas do Market: aceita nome com ícone, número ou singular/plural (ex.: \\\"🧪 Poções 3\\\", \\\"Poção\\\")\\n    const raiz = (k) => norm(k).replace(/[^a-z]/g, '').replace(/(oes|aos|as|os|es|s)$/, '').slice(0, 3);\\n    // categorias: no Market novo ficam na coluna \\\"Categorias\\\", com o nome na 1ª linha (ex.: \\\"Poções / Curam em campo\\\")\\n    const abasCat = () => {\\n      const velhas = Array.from(document.querySelectorAll('.mk-cat'));\\n      if (velhas.length) return velhas;\\n      const nomes = ['pokebolas', 'pocoes', 'revives', 'ovos', 'itens', 'pedras'];\\n      return Array.from(raizM().querySelectorAll('button, [role=tab], li, a, div')).filter((e) => {\\n        const l = linhas(e);\\n        return l.length >= 1 && l.length <= 3 && nomes.some((n) => norm(l[0]).includes(n)) && !/voc[eê] tem/i.test(e.innerText || '') &&\\n          !Array.from(e.children).some((ch) => linhas(ch).length && norm(linhas(ch)[0]) === norm(l[0]) && linhas(ch).length === l.length);\\n      });\\n    };\\n    const catBtn = (key) => {\\n      const abas = abasCat().map((b) => Object.assign(b, { __t: linhas(b)[0] || txt(b) }));\\n      return abas.find((b) => norm(b.__t) === key)\\n        || abas.find((b) => norm(b.__t).includes(key))\\n        || abas.find((b) => raiz(b.__t) && raiz(b.__t) === raiz(key)) || null;\\n    };\\n    // se não achar a aba pelo nome, procura o item passando pelas abas\\n    const acharAbaDoItem = async (nome) => {\\n      for (const b of abasCat()) {\\n        if (!b.classList.contains('on')) { b.click(); await sleep(400); }\\n        if (readCards().some((c) => norm(c.name) === norm(nome))) return b;\\n      }\\n      return null;\\n    };\\n    const cur = document.querySelector('.mk-cat.on');\\n    origKey = cur ? norm(txt(cur)) : null;\\n    const cats = [];\\n    opts.rules.forEach((r) => { if (cats.indexOf(r.cat) < 0) cats.push(r.cat); });\\n\\n    let remaining = opts.maxSpend;\\n    let stop = false;\\n    for (const catName of cats) {\\n      if (stop) break;\\n      const group = opts.rules.filter((r) => r.cat === catName);\\n      let cb = catBtn(norm(catName));\\n      if (!cb) cb = await acharAbaDoItem(group[0].name);\\n      if (!cb) { say('aba \\\"' + catName + '\\\" não encontrada no Market (abas: ' + abasCat().map((b) => linhas(b)[0]).join(', ') + '), pulei'); continue; }\\n      if (!readCards().some((c) => norm(c.name) === norm(group[0].name))) {\\n        cb.click();\\n        const shown = await waitFor(() => readCards().some((c) => norm(c.name) === norm(group[0].name)), 4000);\\n        if (!shown) { say('não consegui abrir a aba ' + catName + ', pulei'); continue; }\\n        await sleep(200);\\n      }\\n      for (const rule of group) {\\n        const find = () => readCards().find((c) => norm(c.name) === norm(rule.name));\\n        const card = find();\\n        if (!card) { say(rule.name + ': não achei na loja'); continue; }\\n        if (card.have === null || !card.price) {\\n          say(rule.name + ': não consegui ler quantidade/preço, pulei (tela: \\\"' + linhas(card.el).slice(0, 8).join(' | ') + '\\\")');\\n          continue;\\n        }\\n        if (card.have >= rule.min) { say(rule.name + ': tem ' + card.have + ' (ok, mínimo ' + rule.min + ')'); continue; }\\n        const gold = readGold();\\n        if (gold === null) { say('não consegui ler o ouro, pulei'); stop = true; break; }\\n        const qty = Math.min(rule.buy, Math.floor(Math.max(0, gold - opts.reserve) / card.price), Math.floor(remaining / card.price));\\n        if (qty < 1) { say(rule.name + ': tem ' + card.have + ' (baixo), mas sem ouro livre ou limite por hora atingido'); continue; }\\n        const custo = qty * card.price;\\n        const input = card.input;\\n        if (!input) { say(rule.name + ': campo de quantidade não encontrado'); res.failed = true; stop = true; break; }\\n        const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set;\\n        setter.call(input, String(qty));\\n        input.dispatchEvent(new Event('input', { bubbles: true }));\\n        input.dispatchEvent(new Event('change', { bubbles: true }));\\n        await sleep(300);\\n        const totEl = card.el.querySelector('.mk-total .mk-moeda');\\n        const total = totEl ? num(txt(totEl)) : num(txt((find() || card).buyBtn)); // Market novo: o total fica no botão \\\"Comprar N\\\"\\n        if (total !== custo) { say(rule.name + ': total na tela (' + total + ') difere do esperado (' + custo + '), NÃO comprei'); res.failed = true; stop = true; break; }\\n        if (opts.dry) { say('TESTE: compraria ' + qty + ' ' + rule.name + ' por ' + custo + ' ouro (tem ' + card.have + '). Total conferido, não cliquei em Comprar'); continue; }\\n        const compra = (find() || card).buyBtn;\\n        if (!compra) { say(rule.name + ': botão Comprar não encontrado'); res.failed = true; stop = true; break; }\\n        const antes = card.have;\\n        compra.click();\\n        const ok = await waitFor(() => { const c = find(); return c && c.have !== null && c.have >= antes + qty; }, 5000);\\n        if (!ok) { say(rule.name + ': cliquei em Comprar mas a quantidade não subiu, parei por segurança'); res.failed = true; stop = true; break; }\\n        remaining -= custo; res.spent += custo; res.bought += qty;\\n        say('Comprei ' + qty + ' ' + rule.name + ' por ' + custo + ' ouro (tinha ' + antes + ')');\\n      }\\n    }\\n    return res;\\n  } finally {\\n    // deixa o Market na aba em que estava antes de fechar\\n    try {\\n      const k = origKey && Array.from(document.querySelectorAll('.mk-cat')).find((b) => norm(txt(b)) === origKey);\\n      if (k && !k.classList.contains('on') && isOpen()) { k.click(); await sleep(150); }\\n    } catch (e) {}\\n    await closeModal();\\n    await sleep(150);\\n    mostrarModal(); // as janelas do jogo voltam a aparecer normalmente\\n    // volta ao Modo Economia, se a cena foi ligada só para a compra\\n    if (religarEco) {\\n      await sleep(400);\\n      const eco = document.getElementById('hunt-eco');\\n      if (eco && !acharBtnCena()) { eco.click(); say('voltei ao Modo Economia'); }\\n    }\\n  }\\n})`;\\n\\nasync function runAutoBuy(i) {\\n  if (sono.ausente) return; // PC ausente: as contas estão em branco\\n  if (autoBusy[i]) return;\\n  const wc = views[i] && views[i].webContents;\\n  if (!wc || wc.isDestroyed()) return;\\n  if (wc.isLoading()) { autoStatus[i] = 'carregando...'; autoLast[i] = Date.now() - checkMs() + 30000; sendState(); return; }\\n  if (level[i] === 3) { autoStatus[i] = 'hibernando, pulou'; sendState(); return; }\\n  const cfg = cfgDe(i);\\n  const rules = cfg.rules.filter((r) => r.on);\\n  if (!rules.length) { autoStatus[i] = 'nenhum item ativo'; sendState(); return; }\\n  autoBusy[i] = true;\\n  try {\\n    const spentHour = spendLog[i].filter((e) => Date.now() - e.t < 3600000).reduce((a, e) => a + e.v, 0);\\n    const opts = { rules, dry: cfg.dry, reserve: cfg.reserve, maxSpend: Math.max(0, cfg.maxHour - spentHour) };\\n    const r = await withTimeout(wc.executeJavaScript(AUTOBUY_PAGE + '(' + JSON.stringify(opts) + ')'), 180000);\\n    const hora = new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });\\n    r.lines.forEach((l) => autoLog(i, l));\\n    if (r.spent > 0) spendLog[i].push({ t: Date.now(), v: r.spent });\\n    if (r.failed) {\\n      auto.enabled[i] = false; // para tudo nessa conta e avisa\\n      avisoCelular('compra', 'Auto Compra parou', `${nameOf(i)}: parou por segurança. Confira no PC.`);\\n      saveAuto();\\n      autoStatus[i] = `PAROU ${hora}`;\\n      uiDialog({\\n        type: 'warning',\\n        message: `${nameOf(i)}: a Auto Compra parou por segurança.`,\\n        detail: r.lines.join('\\\\n') + '\\\\n\\\\nO histórico completo está em Auto Compra > Ver histórico de compras.',\\n      });\\n    } else if (r.skipped) {\\n      autoStatus[i] = `${hora} ${r.reason || 'pulou'}`;\\n      autoLast[i] = Date.now() - checkMs() + 60000; // tenta de novo em ~1 min\\n    }\\n    else if (r.bought > 0) autoStatus[i] = `${hora} comprou`;\\n    else autoStatus[i] = `${hora} ok${cfg.dry ? ' (teste)' : ''}`;\\n  } catch (e) {\\n    autoStatus[i] = 'erro';\\n    autoLog(i, 'erro: ' + e.message);\\n  } finally {\\n    autoBusy[i] = false;\\n    sendState();\\n  }\\n}\\n\\nfunction startAutoBuyTimer() {\\n  // escalona as contas para não abrirem o Market todas ao mesmo tempo\\n  ACCOUNTS.forEach((_, i) => { autoLast[i] = Date.now() - checkMs() + 30000 + i * 15000; });\\n  setInterval(() => {\\n    ACCOUNTS.forEach((_, i) => {\\n      if (auto.enabled[i] && Date.now() - autoLast[i] >= checkMs()) {\\n        autoLast[i] = Date.now();\\n        runAutoBuy(i);\\n      }\\n    });\\n  }, 10000);\\n}\\n\\n// ---------- Troca de hunt automática (segue a recomendação da extensão /hunt) ----------\\n// Igual à Auto Compra: o PokeLink faz o que um jogador faria, com as janelas invisíveis.\\n// 1) abre a /hunt, marca \\\"só hunts liberadas\\\" e o critério (XP/h ou Ouro/h) e lê o ranking;\\n// 2) escolhe a melhor hunt SEGURA (risco até o limite) que ganhe da atual pela margem escolhida;\\n// 3) abre o Mapa no modo Lista, vai na região e clica na hunt; depois confere se o jogo trocou mesmo.\\n// Começa DESLIGADA em todas as contas. Nunca troca com janela do jogo aberta nem em combate.\\nconst HUNT_LER = String.raw`(async (o) => {\\n  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n  const vis = (el) => { if (!el) return false; const r = el.getBoundingClientRect(); const cs = getComputedStyle(el); return r.width > 0 && r.height > 0 && cs.display !== 'none' && cs.visibility !== 'hidden'; };\\n  const txt = (el) => (el && el.textContent ? el.textContent.trim() : '');\\n  const waitFor = async (fn, ms) => { const t0 = Date.now(); while (Date.now() - t0 < ms) { const v = fn(); if (v) return v; await sleep(150); } return null; };\\n  const valor = (t) => {\\n    t = String(t || '').toLowerCase().replace(/\\\\s/g, '');\\n    const m = t.match(/([\\\\d.,]+)(bi|mi|mil|k|m|b)?/);\\n    if (!m) return 0;\\n    let n = parseFloat(m[1].replace(/\\\\./g, '').replace(',', '.')) || 0;\\n    const s = m[2] || '';\\n    if (s === 'bi' || s === 'b') n *= 1e9; else if (s === 'mi' || s === 'm') n *= 1e6; else if (s === 'mil' || s === 'k') n *= 1e3;\\n    return n;\\n  };\\n  const modal = document.getElementById('modal');\\n  const caixa = modal && modal.querySelector('.modal-caixa');\\n  if (caixa && vis(caixa)) return { motivo: 'janela do jogo aberta' };\\n  const ic = document.getElementById('ir-centro') || document.getElementById('eco-ir-centro');\\n  if (ic && ic.disabled) return { motivo: 'em combate' };\\n  const atualTxt = txt(document.getElementById('eco-onde')) || txt(document.getElementById('hud-hunt'));\\n  const barra = document.querySelector('button.pih-barra');\\n  if (!barra) return { motivo: 'extensão /hunt não encontrada nesta conta', atualTxt };\\n  const st = document.createElement('style');\\n  st.id = 'pokelink-hunt-oculto';\\n  st.textContent = '.pih-painel, .pih-painel * { opacity: 0 !important; transition: none !important; animation: none !important; }';\\n  document.head.appendChild(st);\\n  let painel = document.querySelector('.pih-painel');\\n  const jaAberto = painel && vis(painel);\\n  try {\\n    if (!jaAberto) barra.click();\\n    painel = await waitFor(() => { const p = document.querySelector('.pih-painel'); return p && vis(p) && p.querySelector('table.pih-tab tbody tr') ? p : null; }, 10000);\\n    if (!painel) return { motivo: 'a /hunt não abriu', atualTxt };\\n    const seg = Array.from(painel.querySelectorAll('.pih-seg button'));\\n    const quer = o.criterio === 'ouro' ? /ouro/i : /xp/i;\\n    const bt = seg.find((x) => quer.test(txt(x)));\\n    if (bt && !bt.classList.contains('on')) { bt.click(); await sleep(1200); }\\n    const lab = Array.from(painel.querySelectorAll('label')).find((l) => /liberadas/i.test(txt(l)));\\n    const cb = lab && lab.querySelector('input[type=checkbox]');\\n    if (cb && !cb.checked) { cb.click(); await sleep(1500); }\\n    await sleep(500);\\n    const ths = Array.from(painel.querySelectorAll('table.pih-tab thead th')).map((t) => txt(t).toLowerCase());\\n    const col = (re, def) => { const k = ths.findIndex((t) => re.test(t)); return k >= 0 ? k : def; };\\n    const cXp = col(/xp/, 2), cOuro = col(/ouro/, 6), cRisco = col(/risco/, 5);\\n    const rows = Array.from(painel.querySelectorAll('table.pih-tab tbody tr')).slice(0, 40).map((tr) => {\\n      const tds = tr.querySelectorAll('td');\\n      const sub = txt(tr.querySelector('td.pih-hunt small'));\\n      const partes = sub.split('·');\\n      const rTxt = txt(tds[cRisco]);\\n      const rm = rTxt.match(/(\\\\d+)\\\\s*%/);\\n      return {\\n        nome: txt(tr.querySelector('td.pih-hunt b')),\\n        regiao: (partes[0] || '').trim(),\\n        nv: parseInt(String(partes[1] || '').replace(/\\\\D/g, ''), 10) || 0,\\n        val: valor(txt(tds[o.criterio === 'ouro' ? cOuro : cXp])),\\n        risco: rm ? Number(rm[1]) : null,\\n        seguro: !!(tds[cRisco] && tds[cRisco].querySelector('.pih-ok')),\\n      };\\n    }).filter((r) => r.nome);\\n    return { ok: true, atualTxt, rows };\\n  } finally {\\n    if (!jaAberto) { const f = document.querySelector('.pih-painel .pih-fechar'); if (f) f.click(); else document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true })); }\\n    await sleep(300);\\n    st.remove();\\n  }\\n})`;\\nconst HUNT_IR = String.raw`(async (o) => {\\n  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n  const vis = (el) => { if (!el) return false; const r = el.getBoundingClientRect(); const cs = getComputedStyle(el); return r.width > 0 && r.height > 0 && cs.display !== 'none' && cs.visibility !== 'hidden'; };\\n  const txt = (el) => (el && el.textContent ? el.textContent.trim() : '');\\n  const norm = (s) => String(s || '').normalize('NFD').replace(/[\\\\u0300-\\\\u036f]/g, '').toLowerCase().trim();\\n  const num = (s) => parseInt(String(s || '').replace(/\\\\D/g, ''), 10) || 0;\\n  const waitFor = async (fn, ms) => { const t0 = Date.now(); while (Date.now() - t0 < ms) { const v = fn(); if (v) return v; await sleep(150); } return null; };\\n  const modal = () => document.getElementById('modal');\\n  const aberto = () => { const m = modal(); const c = m && m.querySelector('.modal-caixa'); return !!c && vis(c); };\\n  if (aberto()) return { motivo: 'janela do jogo aberta' };\\n  const atualTxt = () => txt(document.getElementById('eco-onde')) || txt(document.getElementById('hud-hunt'));\\n  const ehAlvo = () => { const a = norm(atualTxt()); return a.includes(norm(o.nome)) && (!o.nv || num(a.split(norm(o.nome))[1]) === o.nv || num(a) === o.nv); };\\n  const st = document.createElement('style');\\n  st.id = 'pokelink-mapa-oculto';\\n  st.textContent = '#modal, #modal * { opacity: 0 !important; transition: none !important; animation: none !important; }';\\n  document.head.appendChild(st);\\n  let busca = null;\\n  try {\\n    const btMapa = Array.from(document.querySelectorAll('button')).find((b) => !b.closest('#modal') && norm(txt(b)) === 'mapa');\\n    if (!btMapa) return { motivo: 'botão Mapa não encontrado' };\\n    btMapa.click();\\n    const ok = await waitFor(() => aberto() && /mapa/i.test(txt(document.getElementById('modal-titulo'))), 6000);\\n    if (!ok) return { motivo: 'o Mapa não abriu' };\\n    const lista = document.querySelector('.mapa-modo-bt[aria-label=\\\"Lista\\\"]');\\n    if (lista && !lista.classList.contains('on')) { lista.click(); await sleep(500); }\\n    const reg = Array.from(document.querySelectorAll('.mapa-reg-bt')).find((b) => norm(txt(b.querySelector('.mapa-reg-nome'))) === norm(o.regiao));\\n    if (!reg) return { motivo: 'região ' + o.regiao + ' não encontrada' };\\n    if (reg.classList.contains('mapa-area-travada')) return { motivo: 'região ' + o.regiao + ' travada' };\\n    if (!reg.classList.contains('on')) { reg.click(); await sleep(700); }\\n    const acha = () => Array.from(document.querySelectorAll('#ml-corpo .ml-linha')).find((r) => norm(txt(r.querySelector('.ml-nome'))) === norm(o.nome) && (!o.nv || num(txt(r.querySelector('.ml-nv'))) === o.nv));\\n    let linha = await waitFor(acha, 3000);\\n    if (!linha) { // usa a busca do mapa\\n      busca = document.getElementById('f-mapa');\\n      if (busca) { busca.value = o.nome; busca.dispatchEvent(new Event('input', { bubbles: true })); linha = await waitFor(acha, 3000); }\\n    }\\n    if (!linha) return { motivo: o.nome + ' não encontrado no mapa' };\\n    if (linha.classList.contains('on')) return { ok: true, ja: true };\\n    if (/trav/i.test(linha.className) || txt(linha.querySelector('.ml-trava'))) return { motivo: o.nome + ' está travado' };\\n    linha.click();\\n    const foi = await waitFor(ehAlvo, 9000);\\n    return foi ? { ok: true } : { motivo: 'o jogo não trocou (talvez em combate)' };\\n  } finally {\\n    if (busca) { busca.value = ''; busca.dispatchEvent(new Event('input', { bubbles: true })); }\\n    if (aberto()) { const x = document.getElementById('modal-fechar'); if (x) x.click(); await sleep(400); }\\n    st.remove();\\n  }\\n})`;\\nconst autoHunt = { contas: ACCOUNTS.map(() => false), criterio: 'xp', riscoMax: 30, margem: 10, intervaloMin: 15 };\\nconst huntStatus = ACCOUNTS.map(() => 'desligado');\\nconst huntUlt = ACCOUNTS.map(() => 0);       // última verificação\\nconst huntUltTroca = ACCOUNTS.map(() => 0);  // última troca feita\\nconst huntHist = ACCOUNTS.map(() => []);     // trocas feitas (mais recentes primeiro)\\nconst autoHuntFile = () => path.join(app.getPath('userData'), 'autohunt.json');\\nfunction loadAutoHunt() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(autoHuntFile(), 'utf8'));\\n    (Array.isArray(j.contas) ? j.contas : []).forEach((v, i) => { if (i < ACCOUNTS.length) autoHunt.contas[i] = !!v; });\\n    if (['xp', 'ouro'].includes(j.criterio)) autoHunt.criterio = j.criterio;\\n    if ([10, 20, 30, 50, 100].includes(j.riscoMax)) autoHunt.riscoMax = j.riscoMax;\\n    if ([5, 10, 20, 30].includes(j.margem)) autoHunt.margem = j.margem;\\n    if ([10, 15, 30, 60].includes(j.intervaloMin)) autoHunt.intervaloMin = j.intervaloMin;\\n    autoHunt.contas.forEach((on, i) => { huntStatus[i] = on ? 'ligada' : 'desligado'; });\\n  } catch {}\\n}\\nconst saveAutoHunt = () => { try { fs.writeFileSync(autoHuntFile(), JSON.stringify(autoHunt)); } catch {} };\\nconst avisarHunt = () => { if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('hunt-update'); sendState(); };\\nconst huntHora = () => new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });\\n// \\\"Shedinja · nível 500\\\" -> { nome, nv }\\nconst lerAtual = (t) => { const m = String(t || '').match(/^(.+?)\\\\s*[·-]\\\\s*n[ií]vel\\\\s*([\\\\d.]+)/i); return m ? { nome: m[1].trim(), nv: parseInt(m[2].replace(/\\\\D/g, ''), 10) } : { nome: String(t || '').trim(), nv: 0 }; };\\nconst mesmaHunt = (a, b) => a && b && a.nome.toLowerCase() === b.nome.toLowerCase() && (!a.nv || !b.nv || a.nv === b.nv);\\nasync function rodarAutoHunt(i, forcar) {\\n  const wc = views[i] && views[i].webContents;\\n  if (sono.ausente || !wc || wc.isDestroyed() || wc.isLoading() || level[i] === 3) return;\\n  if (autoBusy[i]) { huntStatus[i] = 'esperando outra tarefa terminar'; huntUlt[i] = Date.now() - autoHunt.intervaloMin * 60000 + 60000; avisarHunt(); return; }\\n  autoBusy[i] = true;\\n  huntStatus[i] = 'conferindo...'; avisarHunt();\\n  const deNovoEm = (min) => { huntUlt[i] = Date.now() - autoHunt.intervaloMin * 60000 + min * 60000; };\\n  try {\\n    const r = await withTimeout(wc.executeJavaScript(HUNT_LER + '(' + JSON.stringify({ criterio: autoHunt.criterio }) + ')'), 30000).catch(() => null);\\n    if (!r || !r.ok) { huntStatus[i] = `${huntHora()} ${(r && r.motivo) || 'não consegui ler a /hunt'}`; deNovoEm(2); return; }\\n    const atual = lerAtual(r.atualTxt);\\n    const seguras = r.rows.filter((x) => x.val > 0 && x.regiao && (x.risco == null ? x.seguro : x.risco <= autoHunt.riscoMax))\\n      .sort((a, b) => b.val - a.val);\\n    const melhor = seguras[0];\\n    if (!melhor) { huntStatus[i] = `${huntHora()} nenhuma hunt dentro do risco de ${autoHunt.riscoMax}%`; return; }\\n    if (mesmaHunt(atual, melhor)) { huntStatus[i] = `${huntHora()} já está na melhor: ${melhor.nome} Nv ${melhor.nv}`; return; }\\n    const linhaAtual = r.rows.find((x) => mesmaHunt(atual, x));\\n    const ganho = linhaAtual && linhaAtual.val > 0 ? (melhor.val / linhaAtual.val - 1) * 100 : null;\\n    if (ganho != null && ganho < autoHunt.margem) { huntStatus[i] = `${huntHora()} ${atual.nome} já está perto da melhor (${melhor.nome} só +${Math.floor(ganho)}%)`; return; }\\n    if (!forcar && Date.now() - huntUltTroca[i] < 10 * 60000) { huntStatus[i] = `${huntHora()} trocou há pouco; espera para não ficar pulando`; return; }\\n    huntStatus[i] = `indo para ${melhor.nome} (${melhor.regiao} Nv ${melhor.nv})...`; avisarHunt();\\n    const ir = await withTimeout(wc.executeJavaScript(HUNT_IR + '(' + JSON.stringify({ nome: melhor.nome, regiao: melhor.regiao, nv: melhor.nv }) + ')'), 40000).catch(() => null);\\n    if (ir && ir.ok) {\\n      huntUltTroca[i] = Date.now();\\n      const linha = { em: Date.now(), de: atual.nome ? `${atual.nome}${atual.nv ? ' Nv ' + atual.nv : ''}` : '?', para: `${melhor.nome} Nv ${melhor.nv}`, regiao: melhor.regiao, ganho: ganho != null ? Math.round(ganho) : null, criterio: autoHunt.criterio };\\n      if (!ir.ja) { huntHist[i].unshift(linha); huntHist[i].length = Math.min(huntHist[i].length, 20); avisoCelular('hunt', 'Hunt trocada', `${nameOf(i)}: ${linha.de} → ${linha.para}${linha.ganho != null ? ` (+${linha.ganho}%)` : ''}.`); }\\n      huntStatus[i] = `${huntHora()} ${ir.ja ? 'já estava em' : 'trocou para'} ${melhor.nome} Nv ${melhor.nv}${ganho != null && !ir.ja ? ` (+${Math.round(ganho)}%)` : ''}`;\\n    } else {\\n      huntStatus[i] = `${huntHora()} não trocou: ${(ir && ir.motivo) || 'sem resposta'}`;\\n      deNovoEm(2); // tenta de novo em ~2 min\\n    }\\n  } finally {\\n    autoBusy[i] = false;\\n    avisarHunt();\\n  }\\n}\\nfunction startAutoHuntTimer() {\\n  ACCOUNTS.forEach((_, i) => { huntUlt[i] = Date.now() - autoHunt.intervaloMin * 60000 + 90000 + i * 20000; }); // 1ª conferência ~1,5 min depois de abrir\\n  setInterval(() => {\\n    ACCOUNTS.forEach((_, i) => {\\n      if (autoHunt.contas[i] && Date.now() - huntUlt[i] >= autoHunt.intervaloMin * 60000) { huntUlt[i] = Date.now(); rodarAutoHunt(i); }\\n    });\\n  }, 15000);\\n}\\nconst huntDados = () => ({\\n  criterio: autoHunt.criterio, riscoMax: autoHunt.riscoMax, margem: autoHunt.margem, intervaloMin: autoHunt.intervaloMin,\\n  contas: ACCOUNTS.map((_, i) => ({ i, nome: nameOf(i), on: autoHunt.contas[i], status: huntStatus[i],\\n    proxima: autoHunt.contas[i] ? Math.max(0, Math.round((huntUlt[i] + autoHunt.intervaloMin * 60000 - Date.now()) / 60000)) : null,\\n    hist: huntHist[i].slice(0, 5).map((h) => ({ ...h, hora: new Date(h.em).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) })) })),\\n});\\nipcMain.handle('hunt-get', () => huntDados());\\nipcMain.on('hunt-set', (_, d) => {\\n  d = d || {};\\n  if (Number.isInteger(d.conta) && d.conta >= 0 && d.conta < ACCOUNTS.length) {\\n    autoHunt.contas[d.conta] = !!d.on;\\n    huntStatus[d.conta] = d.on ? 'ligada · primeira conferência em ~10 s' : 'desligado';\\n    if (d.on) huntUlt[d.conta] = Date.now() - autoHunt.intervaloMin * 60000 + 10000;\\n  }\\n  if (['xp', 'ouro'].includes(d.criterio)) autoHunt.criterio = d.criterio;\\n  if ([10, 20, 30, 50, 100].includes(Number(d.riscoMax))) autoHunt.riscoMax = Number(d.riscoMax);\\n  if ([5, 10, 20, 30].includes(Number(d.margem))) autoHunt.margem = Number(d.margem);\\n  if ([10, 15, 30, 60].includes(Number(d.intervaloMin))) autoHunt.intervaloMin = Number(d.intervaloMin);\\n  saveAutoHunt();\\n  avisarHunt();\\n});\\nipcMain.on('hunt-panel', () => showAutoHunt());\\nipcMain.handle('hunt-agora', async (_, i) => { if (Number.isInteger(i) && i >= 0 && i < ACCOUNTS.length) await rodarAutoHunt(i, true); return huntDados(); });\\nfunction showAutoHunt() {\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (!canDraw) return;\\n  const id = ++cfgPanelSeq;\\n  cfgPanels.add(id);\\n  dialogOpen = true;\\n  layout();\\n  titleBar.webContents.focus();\\n  titleBar.webContents.send('title-autohunt', { id });\\n}\\n\\nipcMain.on('auto-set', (_, i, on) => {\\n  if (!(i >= 0 && i < ACCOUNTS.length)) return;\\n  auto.enabled[i] = !!on;\\n  autoStatus[i] = on ? 'ligado' : 'desligado';\\n  if (on) autoLast[i] = Date.now() - checkMs() + 5000; // primeira verificação em ~5s\\n  saveAuto();\\n  sendState();\\n});\\n\\n// ---------- Janela de configuração da Auto Compra ----------\\nlet cfgWin = null;\\nfunction openAutoConfig() {\\n  if (cfgWin && !cfgWin.isDestroyed()) { cfgWin.show(); cfgWin.focus(); return; }\\n  cfgWin = new BrowserWindow({\\n    width: 680, height: 820, minWidth: 520, minHeight: 560,\\n    title: 'Auto Compra — Configurações', backgroundColor: '#24101a', autoHideMenuBar: true,\\n    titleBarStyle: 'hidden', // mesma barra de título do PokeLink\\n    titleBarOverlay: { color: TITLE_BG, symbolColor: TITLE_FG, height: TITLE_H },\\n    ...(customIconPath() ? { icon: customIconPath() } : {}),\\n    webPreferences: { preload: path.join(__dirname, 'preload.js') },\\n  });\\n  cfgWin.setMenu(null);\\n  cfgWin.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'config' } });\\n}\\n// salva a configuração de uma conta (ou de todas, com \\\"todas\\\")\\nfunction saveAutoCfg(c, conta, todas) {\\n  const nova = sanitizeCfg(c);\\n  auto.intervalMin = nova.intervalMin; // o intervalo entre verificações vale para todas\\n  ACCOUNTS.forEach((_, i) => {\\n    if (todas || i === conta || !Number.isInteger(conta)) auto.contas[i] = sanitizeCfg(nova);\\n    auto.contas[i].intervalMin = nova.intervalMin;\\n  });\\n  if (todas || !Number.isInteger(conta)) Object.assign(auto, nova);\\n  saveAuto();\\n  buildMenu(); // atualiza o item \\\"Modo teste\\\" do menu\\n  sendState();\\n  return { ok: true };\\n}\\n// engrenagem da barra: a configuração desce do botão como um painel (desenhado pela barra de título)\\nlet cfgPanelSeq = 0;\\nconst cfgPanels = new Set();\\nipcMain.on('auto-config', (e, rect) => {\\n  const bi = bars.findIndex((b) => b.webContents === e.sender);\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (!canDraw || bi < 0 || !rect) { openAutoConfig(); return; }\\n  const b = bars[bi].getBounds();\\n  const id = ++cfgPanelSeq;\\n  cfgPanels.add(id);\\n  dialogOpen = true; // a barra de título cobre a janela enquanto o painel está aberto\\n  layout();\\n  titleBar.webContents.focus();\\n  titleBar.webContents.send('title-autocfg', {\\n    id, conta: bi, nome: nameOf(bi), on: !!auto.enabled[bi], status: autoStatus[bi] || '', x: b.x + Math.round(rect.left) - 8, y: b.y + Math.round(rect.bottom) + 4, up: b.y + Math.round(rect.top) - 4,\\n  });\\n});\\nipcMain.on('auto-run-now', (_, i) => { if (Number.isInteger(i) && i >= 0 && i < ACCOUNTS.length) runAutoBuy(i); });\\nipcMain.on('auto-log', () => { try { fs.appendFileSync(autoLogFile(), ''); } catch {} shell.openPath(autoLogFile()); });\\nipcMain.on('title-autocfg-closed', (_, id) => {\\n  cfgPanels.delete(id);\\n  dialogOpen = dlgWait.size > 0 || popWait.size > 0 || cfgPanels.size > 0;\\n  layout();\\n});\\nipcMain.handle('autocfg-get', (_, defaults, conta) => {\\n  const i = Number.isInteger(conta) && conta >= 0 && conta < ACCOUNTS.length ? conta : 0;\\n  const src = defaults ? sanitizeCfg({}) : cfgDe(i);\\n  return { dry: src.dry, rules: src.rules, reserve: src.reserve, maxHour: src.maxHour, intervalMin: auto.intervalMin, icon: customIconUrl(),\\n    conta: i, contas: ACCOUNTS.map((_, k) => ({ nome: nameOf(k), on: !!auto.enabled[k] })) };\\n});\\nipcMain.handle('autocfg-save', (_, c, conta, todas) => saveAutoCfg(c, Number.isInteger(conta) ? conta : null, !!todas));\\nipcMain.on('close-self', (e) => {\\n  const w = BrowserWindow.fromWebContents(e.sender);\\n  if (w && !w.isDestroyed()) w.close();\\n});\\n\\n// ---------- Diagnóstico (mapa da tela, para eu poder criar leitura/compra) ----------\\nconst OUTLINE_JS = `(() => {\\n  const SKIP = new Set(['SCRIPT', 'STYLE', 'SVG', 'PATH', 'NOSCRIPT', 'LINK', 'META']);\\n  const ATTRS = ['id', 'role', 'data-id', 'data-action', 'data-item', 'data-type', 'title', 'aria-label', 'alt', 'type'];\\n  const out = [];\\n  const walk = (el, d) => {\\n    if (d > 16 || out.length > 8000 || SKIP.has(el.tagName.toUpperCase())) return;\\n    const cs = getComputedStyle(el);\\n    if (cs.display === 'none' || cs.visibility === 'hidden') return;\\n    const own = [...el.childNodes].filter((n) => n.nodeType === 3).map((n) => n.textContent.trim()).filter(Boolean).join(' ').slice(0, 90);\\n    const cls = (typeof el.className === 'string' ? el.className : '').trim().replace(/\\\\\\\\s+/g, '.').slice(0, 70);\\n    const at = ATTRS.map((a) => (el.getAttribute(a) ? a + '=\\\"' + el.getAttribute(a).slice(0, 40) + '\\\"' : '')).filter(Boolean).join(' ');\\n    out.push('  '.repeat(d) + el.tagName.toLowerCase() + (cls ? '.' + cls : '') + (at ? ' ' + at : '') + (own ? ' \\\"' + own + '\\\"' : ''));\\n    for (const c of el.children) walk(c, d + 1);\\n  };\\n  walk(document.body, 0);\\n  return out.join('\\\\\\\\n');\\n})()`;\\n\\nasync function saveOutline(i) {\\n  try {\\n    const txt = await withTimeout(views[i].webContents.executeJavaScript(OUTLINE_JS), 15000);\\n    const file = path.join(app.getPath('desktop'), `diagnostico-conta${i + 1}.txt`);\\n    fs.writeFileSync(file, txt, 'utf8');\\n    uiDialog({\\n      type: 'info',\\n      message: 'Diagnóstico salvo na área de trabalho.',\\n      detail: `${path.basename(file)}\\\\n\\\\nO arquivo tem só a estrutura e os textos visíveis da tela (sem senhas nem valores digitados). Pode abrir e conferir antes de me enviar.`,\\n    });\\n  } catch (e) {\\n    showError('Diagnóstico', e.message);\\n  }\\n}\\n\\n// ---------- Nick das contas (lido do próprio jogo: #tr-nick) ----------\\nconst nicks = ACCOUNTS.map(() => null);\\nconst nickMiss = ACCOUNTS.map(() => 0);\\nconst nickFile = () => path.join(app.getPath('userData'), 'nicks.json');\\nconst nameOf = (i) => nicks[i] || ACCOUNTS[i];\\nconst displayNames = () => ACCOUNTS.map((_, i) => nameOf(i));\\n\\nfunction loadNicks() { // mostra o último nick conhecido já na abertura\\n  try {\\n    const j = JSON.parse(fs.readFileSync(nickFile(), 'utf8'));\\n    if (Array.isArray(j)) ACCOUNTS.forEach((_, i) => { if (typeof j[i] === 'string' && j[i]) nicks[i] = j[i].slice(0, 24); });\\n  } catch {}\\n}\\nfunction saveNicks() {\\n  try { fs.writeFileSync(nickFile(), JSON.stringify(nicks)); } catch {}\\n}\\nasync function readNick(i) {\\n  if (sono.ausente) return;\\n  const wc = views[i] && views[i].webContents;\\n  if (!wc || wc.isDestroyed() || wc.isLoading()) return;\\n  try {\\n    const t = await withTimeout(wc.executeJavaScript(\\\"(() => { const e = document.getElementById('tr-nick'); return e ? e.textContent.trim() : ''; })()\\\"), 3000);\\n    const nick = String(t || '').slice(0, 24);\\n    let changed = false;\\n    if (nick) {\\n      nickMiss[i] = 0;\\n      if (nicks[i] !== nick) { nicks[i] = nick; changed = true; }\\n    } else if (++nickMiss[i] >= 3 && nicks[i]) { // tela de login por um tempo: volta para \\\"Conta N\\\"\\n      nicks[i] = null; changed = true;\\n    }\\n    if (changed) { saveNicks(); buildMenu(); sendState(); }\\n  } catch {}\\n}\\nfunction startNickTimer() {\\n  setInterval(() => ACCOUNTS.forEach((_, i) => readNick(i)), 8000);\\n  setTimeout(() => ACCOUNTS.forEach((_, i) => readNick(i)), 4000);\\n}\\n\\nfunction buildMenu() {\\n  const each = (fn) => ACCOUNTS.map((_, i) => fn(i));\\n\\n  // Menus organizados: o que se usa sempre fica no 1º nível; ajustes e logins ficam agrupados.\\n  // (ligar/desligar Twitch, Kick, Auto Compra e Troca de hunt ficam nos botões da barra de cada conta)\\n  const template = [\\n    {\\n      label: 'Contas',\\n      submenu: [\\n        // atalhos escondidos: Ctrl+0 (as 4 contas) e Ctrl+1..4 (ampliar uma conta)\\n        { label: 'Ver as 4 contas', accelerator: 'CmdOrCtrl+0', visible: false, click: () => setFocus(-1) },\\n        ...each((i) => ({ label: `Ampliar ${nameOf(i)}`, accelerator: `CmdOrCtrl+${i + 1}`, visible: false, click: () => setFocus(i) })),\\n        { label: 'Recarregar todas', click: () => views.forEach((_, i) => reloadAccount(i)) },\\n        { label: 'Silenciar todas', click: () => each((i) => setMuted(i, true)) },\\n        { label: 'Ligar o som de todas', click: () => each((i) => setMuted(i, false)) },\\n        { type: 'separator' },\\n        { label: `Ver no celular...${monitor.ligado ? '  ✓ ligado' : ''}`, click: showMonitor },\\n        { label: 'Troca de hunt automática...', click: showAutoHunt },\\n        { type: 'separator' },\\n        { label: 'Tamanho do jogo', submenu: [\\n          { label: 'Aumentar', accelerator: 'CmdOrCtrl+=', click: () => changeRef(-100) },\\n          { label: 'Diminuir', accelerator: 'CmdOrCtrl+-', click: () => changeRef(100) },\\n        ] },\\n        { label: 'Tela cheia', accelerator: 'F11', click: () => win.setFullScreen(!win.isFullScreen()) },\\n        { type: 'separator' },\\n        { label: 'Copiar login para o celular (PokeLink Lite)', submenu: each((i) => ({ label: nameOf(i), click: () => copyLoginForPhone(i) })) },\\n      ],\\n    },\\n    {\\n      label: 'Lives',\\n      submenu: [\\n        { label: 'Ver lives abertas', click: showLives },\\n        { label: 'Verificar agora', click: () => { checkLives(); } },\\n        { type: 'separator' },\\n        { label: 'Avisar ao juntar 300 / 500 / 1.000 pontos da Kick', type: 'checkbox', checked: kickAvisos, click: (item) => setKickAvisos(item.checked) },\\n        { type: 'separator' },\\n        {\\n          label: 'Ajustes da Kick',\\n          submenu: [\\n            { label: 'Player pequeno (recomendado)', type: 'radio', checked: kickPlayer === 'auto', click: () => setKickPlayer('auto') },\\n            { label: 'Página inteira (mais pesado)', type: 'radio', checked: kickPlayer === 'completa', click: () => setKickPlayer('completa') },\\n            { type: 'separator' },\\n            { label: 'Kick leve (sem imagens, vídeo mínimo)', type: 'checkbox', checked: kickLeve, click: (item) => setKickLeve(item.checked) },\\n          ],\\n        },\\n        {\\n          label: 'Ajustes da Twitch',\\n          submenu: [\\n            { label: 'Automático (recomendado)', type: 'radio', checked: twitchModo === 'auto', click: () => setTwitchModo('auto') },\\n            { label: 'Conexão direta de chat (levíssimo)', type: 'radio', checked: twitchModo === 'irc', click: () => setTwitchModo('irc') },\\n            { label: 'Só o chat (leve)', type: 'radio', checked: twitchModo === 'chat', click: () => setTwitchModo('chat') },\\n            { label: 'Só o vídeo (médio)', type: 'radio', checked: twitchModo === 'player', click: () => setTwitchModo('player') },\\n            { label: 'Página completa (mais pesado)', type: 'radio', checked: twitchModo === 'completo', click: () => setTwitchModo('completo') },\\n          ],\\n        },\\n        {\\n          label: 'Logins da Twitch e da Kick',\\n          submenu: each((i) => ({\\n            label: nameOf(i),\\n            submenu: [\\n              { label: 'Entrar na Twitch...', click: () => openLiveLogin(i, 'twitch') },\\n              { label: 'Entrar na Kick...', click: () => openLiveLogin(i, 'kick') },\\n              { label: 'Importar login da Kick do navegador...', click: () => importKickLogin(i) },\\n            ],\\n          })),\\n        },\\n      ],\\n    },\\n    {\\n      label: 'Desempenho',\\n      submenu: LEVELS.map((L, lv) => ({\\n        label: ['Normal', 'Eco — sem a cena da batalha', 'Mega Eco — painel com o resumo'][lv] || L.name,\\n        type: 'radio', checked: level.every((x) => x === lv), click: () => setAllLevel(lv),\\n      })).concat([\\n        { type: 'separator' },\\n        { label: 'Pausar o farm para o PC dormir', type: 'checkbox', checked: sono.ligado, click: (item) => setSono(item.checked) },\\n        { label: 'Uso de CPU e memória', click: showUsage },\\n      ]),\\n    },\\n    {\\n      label: 'PvP',\\n      submenu: [\\n        ...each((i) => ({ label: `Análise de PvP — ${nameOf(i)}`, click: () => openPvp(i) })),\\n        { type: 'separator' },\\n        { label: 'Gerar relatório do tracker', submenu: each((i) => ({ label: nameOf(i), click: () => captureTracker(i) })) },\\n      ],\\n    },\\n    {\\n      label: 'Atualizações',\\n      submenu: [\\n        { label: 'Procurar atualização', click: () => checkOnlineUpdate(true) },\\n        { label: 'Ver novidades', click: showNovidades },\\n        { type: 'separator' },\\n        { label: 'Instalar atualização de arquivo...', click: applyUpdate },\\n        // o atalho funciona mesmo se a barra de cima quebrar depois de uma atualização ruim\\n        { label: 'Desfazer última atualização', accelerator: 'CmdOrCtrl+Shift+Z', click: undoUpdate },\\n        { type: 'separator' },\\n        { label: `Versão instalada: ${APP_CHANNEL ? APP_CHANNEL + ' ' : ''}${APP_VERSION}`, enabled: false },\\n      ],\\n    },\\n    {\\n      label: 'Ajuda',\\n      submenu: [\\n        { label: 'Extensões (/hunt, Rotom Sniper)', click: showExtensions },\\n        { label: 'Gerar relatório de erro', submenu: each((i) => ({ label: nameOf(i), click: () => saveOutline(i) })) },\\n        { label: 'Reiniciar o PokeLink', accelerator: 'CmdOrCtrl+Shift+R', click: restartApp },\\n        { type: 'separator' },\\n        { label: 'Sobre o PokeLink', click: showAbout },\\n        { label: 'Termos de Uso', click: showTerms },\\n      ],\\n    },\\n  ];\\n  if (DEV) {\\n    // só aparece rodando pelo código, nunca no .exe\\n    template.push({\\n      label: 'Desenvolvedor',\\n      submenu: [\\n        { label: 'Abrir pasta do app', click: () => shell.openPath(__dirname) },\\n        { label: 'Ferramentas de desenvolvedor: F12 na tela desejada', enabled: false },\\n      ],\\n    });\\n  }\\n\\n  appMenu = Menu.buildFromTemplate(template);\\n  // o menu continua registrado: atalhos (Ctrl+1, F11, Ctrl+0...) seguem funcionando\\n  Menu.setApplicationMenu(appMenu);\\n  sendTitleState();\\n}\\n\\nasync function showAbout() {\\n  const r = await uiDialog({\\n    about: true, // cabeçalho com o ícone, o nome e a versão\\n    title: 'Sobre o PokeLink',\\n    message: 'Plataforma PokeLink, criada por Nations.',\\n    detail:\\n      'O PokeLink foi desenvolvido para melhorar a qualidade de vida de quem joga com 4 contas no mesmo computador, ' +\\n      'reunindo todas em uma única janela.\\\\n\\\\n' +\\n      'O PokeLink é uma plataforma independente. Nations é o desenvolvedor do PokeLink, não do PokeIdle, ' +\\n      'e não tem vínculo com a equipe do jogo. Se preferir jogar sem a plataforma, use o site oficial: www.pokeidle.io',\\n    note: 'O uso de mais de 4 contas está sujeito a banimento no jogo. O PokeLink foi feito para no máximo 4 contas.',\\n    foot: 'Versão beta: se algo der errado, use Ajuda > Gerar relatório de erro.',\\n    buttons: ['Fechar', 'Direitos e marcas', 'Abrir www.pokeidle.io'],\\n    defaultId: 0,\\n    cancelId: 0,\\n  });\\n  if (r.response === 1) showRights();\\n  if (r.response === 2) shell.openExternal('https://www.pokeidle.io');\\n}\\n\\nasync function showRights() {\\n  const contato = SUPPORT_CONTACT\\n    ? '\\\\n\\\\nPedido de remoção: se você é titular de direitos sobre algo presente no PokeLink e quer que seja removido, ' +\\n      `escreva para ${SUPPORT_CONTACT}. Pedidos legítimos são atendidos sem necessidade de ordem judicial.`\\n    : '';\\n  const r = await uiDialog({\\n    type: 'info',\\n    title: 'Direitos e marcas',\\n    message: 'Projeto de fã, independente e não oficial.',\\n    detail:\\n      'Pokémon e todos os elementos da franquia são marcas e obras de Nintendo, Game Freak, Creatures e ' +\\n      'The Pokémon Company. O PokeIdle e seu conteúdo pertencem à equipe do PokeIdle.\\\\n\\\\n' +\\n      'O PokeLink não tem vínculo com nenhum deles. O jogo exibido nas janelas é carregado diretamente de ' +\\n      'www.pokeidle.io: o PokeLink não copia, hospeda nem distribui esse conteúdo.\\\\n\\\\n' +\\n      'O código e a interface do PokeLink são de autoria de Nations.' + contato,\\n    note: 'Funções automáticas, como a Auto Compra, podem não ser permitidas pelas regras do PokeIdle. ' +\\n      'Confira os termos do jogo antes de usar. O uso é por sua conta e risco.',\\n    buttons: ['Voltar', 'Fechar'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (r.response === 0) showAbout();\\n}\\nipcMain.on('show-about', showAbout);\\n\\n// ---------- Pop-ups no tema do app ----------\\n// Mesmo formato do dialog.showMessageBox do Electron: uiDialog({ type, title, message, detail, buttons, defaultId, cancelId })\\n// devolve uma Promise com { response } = índice do botão clicado.\\nconst dlgWait = new Map();\\nlet dlgSeq = 0;\\nlet dialogOpen = false;\\nfunction uiDialog(o) {\\n  o = o || {};\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && !titleBar.webContents.isLoading()\\n    && win && !win.isDestroyed() && !win.isFullScreen() && !win.isMinimized();\\n  if (!canDraw) return dialog.showMessageBox(o); // tela cheia/minimizado: usa o do Windows\\n  const id = ++dlgSeq;\\n  const pr = new Promise((resolve) => {\\n    dlgWait.set(id, resolve);\\n    dialogOpen = true;\\n    layout();\\n    titleBar.webContents.focus();\\n    titleBar.webContents.send('title-dialog', {\\n      id,\\n      type: o.type || 'info',\\n      title: o.title || APP_NAME,\\n      message: o.message || '',\\n      detail: o.detail || '',\\n      note: o.note || '',  // aviso destacado (só nos pop-ups do app)\\n      foot: o.foot || '',  // texto pequeno no fim\\n      table: o.table || null, // { head: [...], rows: [[...], ...] }\\n      form: o.form || null,\\n      cards: o.cards || null, // [{ title, chips, big, bigSub, stats: [[rótulo, valor]] }]\\n      lives: o.lives || null, // painel das lives (showLives)   // [{ section } | { id, label, hint, type: 'check'|'number'|'select', options, value }]\\n      buttons: o.buttons && o.buttons.length ? o.buttons : ['OK'],\\n      defaultId: Number.isInteger(o.defaultId) ? o.defaultId : 0,\\n      cancelId: Number.isInteger(o.cancelId) ? o.cancelId : null,\\n      about: o.about ? { name: APP_NAME, version: APP_VERSION, channel: APP_CHANNEL, icon: customIconUrl() } : null,\\n    });\\n  });\\n  pr.id = id; // permite fechar este pop-up pelo código (uiDialogClose)\\n  return pr;\\n}\\n// fecha um pop-up aberto pelo código (ex.: o aviso de \\\"gerando...\\\" quando o trabalho termina)\\nfunction uiDialogClose(p) {\\n  if (p && p.id && titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('title-dialog-close', p.id);\\n}\\nconst showError = (title, text) => uiDialog({ type: 'error', title, message: title, detail: text });\\n\\n// menuzinho de escolha no tema do app (ex.: Desempenho). Devolve o \\\"value\\\" escolhido ou null.\\nlet popSeq = 0;\\nconst popWait = new Map();\\nfunction uiPopup(o) {\\n  return new Promise((resolve) => {\\n    const id = ++popSeq;\\n    popWait.set(id, resolve);\\n    dialogOpen = true; // a barra de título cresce para cobrir a janela\\n    layout();\\n    titleBar.webContents.focus();\\n    titleBar.webContents.send('title-popup', Object.assign({ id }, o));\\n  });\\n}\\nipcMain.on('title-popup-reply', (_, id, value) => {\\n  const done = popWait.get(id);\\n  if (!done) return;\\n  popWait.delete(id);\\n  dialogOpen = dlgWait.size > 0 || popWait.size > 0 || cfgPanels.size > 0;\\n  layout();\\n  done(value == null ? null : value);\\n});\\nipcMain.on('title-dialog-reply', (_, id, response, values) => {\\n  const done = dlgWait.get(id);\\n  if (!done) return;\\n  dlgWait.delete(id);\\n  dialogOpen = dlgWait.size > 0 || popWait.size > 0 || cfgPanels.size > 0;\\n  layout();\\n  done({ response: Number(response) || 0, values: values && typeof values === 'object' ? values : null });\\n});\\n\\n// F12 ou Ctrl+Shift+I abre as ferramentas de desenvolvedor da tela em que você clicou por último\\n// Ctrl+0 (as 4 contas) e Ctrl+1..4 (ampliar conta) funcionam em qualquer parte da janela\\nfunction viewKeys(wc) {\\n  wc.on('before-input-event', (e, input) => {\\n    if (input.type !== 'keyDown' || !(input.control || input.meta) || input.shift || input.alt) return;\\n    const k = String(input.key);\\n    if (k === '0') { e.preventDefault(); setFocus(-1); }\\n    else if (/^[1-4]$/.test(k) && Number(k) <= ACCOUNTS.length) { e.preventDefault(); setFocus(Number(k) - 1); }\\n  });\\n}\\nfunction devKeys(wc) {\\n  viewKeys(wc);\\n  if (!DEV) return; // no .exe não existe atalho para as ferramentas de desenvolvedor\\n  wc.on('before-input-event', (e, input) => {\\n    if (input.type !== 'keyDown') return;\\n    const k = String(input.key).toLowerCase();\\n    if (k === 'f12' || (input.control && input.shift && k === 'i')) {\\n      e.preventDefault();\\n      wc.toggleDevTools();\\n    }\\n  });\\n}\\n\\n// ---------- Barra de título customizada ----------\\nfunction sendTitleState() {\\n  if (!titleBar || titleBar.webContents.isDestroyed() || !appMenu) return;\\n  titleBar.webContents.send('title-state', {\\n    title: APP_NAME,\\n    icon: customIconUrl(),\\n    version: APP_VERSION,\\n    channel: APP_CHANNEL,\\n    menus: serializeMenu(appMenu),\\n  });\\n}\\n\\n// transforma o Menu do Electron em dados simples para a barra desenhar os menus em HTML\\nconst prettyAccel = (a) => (a ? String(a).replace(/CmdOrCtrl|CommandOrControl/g, 'Ctrl') : '');\\nfunction serializeMenu(menu) {\\n  return menu.items.map((it) => ({\\n    label: it.label,\\n    type: it.type,\\n    checked: !!it.checked,\\n    enabled: it.enabled !== false,\\n    visible: it.visible !== false,\\n    accel: prettyAccel(it.accelerator),\\n    submenu: it.submenu ? serializeMenu(it.submenu) : null,\\n  }));\\n}\\n\\nipcMain.on('title-ready', sendTitleState);\\nipcMain.on('title-open', (_, open) => {\\n  menuOpen = !!open;\\n  layout();\\n});\\n// clique num item: chega o \\\"caminho\\\" de índices até ele (ex.: [1, 4, 2] = Contas > Som por conta > 3º item)\\nipcMain.on('title-click', (_, pathIdx) => {\\n  if (!appMenu || !Array.isArray(pathIdx)) return;\\n  let items = appMenu.items;\\n  let item = null;\\n  for (const n of pathIdx) {\\n    item = items && items[n];\\n    if (!item) return;\\n    items = item.submenu && item.submenu.items;\\n  }\\n  if (!item || item.submenu || item.enabled === false || item.type === 'separator') return;\\n  item.click({}); // checkbox: o próprio Electron inverte o \\\"checked\\\" antes de chamar o click\\n  sendTitleState(); // atualiza os ✓ na barra\\n});\\n\\n// ---------- Lives: bônus da Twitch e pontos da Kick ----------\\n// Cada conta do jogo usa o próprio login da Twitch/Kick (mesma sessão da conta: persist:contaN).\\n// Twitch e Kick ligam separadas, cada uma com o seu botão na barra da conta.\\n// Quando um canal oficial entra ao vivo, a live abre escondida com a GUIA mutada (o player segue\\n// tocando, como uma janela visível) e sem economia de segundo plano; quando a live acaba, ela fecha.\\nconst LIVE_CHANNELS = {\\n  twitch: ['tftoddy', 'clovaobengala', 'patopapao', 'rodil', 'matta', 'cogu', 'biscoitao', 'xdaren_', 'luccatv', 'faasii', 'axtlol', 'surskity11', 'guaxilol1'],\\n  // lista oficial completa da Kick (painel \\\"Bônus na Kick\\\" do jogo)\\n  kick: ['rodil', 'clovaobengalalol', 'axt', 'xdaren', 'yetz', 'patopapao2', 'biscoitao', 'matta', 'cogu', 'tftoddy', 'luccatv', 'surskity'],\\n};\\n// Máximo de lives abertas POR CONTA em cada plataforma (cada live gasta ~200-300 MB).\\n// Kick: abre todas as lives oficiais ao vivo (até 6 por conta). A janela de Resgate marca\\n// \\\"sem render\\\" quando uma live aberta há 20+ min não ganhou nenhum ponto (ex.: limite da Kick).\\nconst LIVE_MAX = { twitch: 99, kick: 6 };\\nconst LIVE_PLATS = () => Object.keys(LIVE_CHANNELS).filter((p) => LIVE_MAX[p] > 0 && lives[p].some(Boolean));\\nconst LIVE_CHECK_MIN = 3; // de quantos em quantos minutos verificar quem está ao vivo\\nconst PLAT = {\\n  // Twitch em 3 modos (Lives > Modo da Twitch): página completa, só o player (vídeo) ou só o chat\\n  twitch: {\\n    name: 'Twitch', login: 'https://www.twitch.tv/login',\\n    url: (c, m = twitchModo) => (m === 'chat' || m === 'auto' || m === 'irc' ? `https://www.twitch.tv/popout/${c}/chat?popout=`\\n      : m === 'player' ? `https://player.twitch.tv/?channel=${c}&parent=twitch.tv&muted=false&quality=160p30`\\n        : `https://www.twitch.tv/${c}`),\\n  },\\n  kick: { name: 'Kick', url: (c) => `https://kick.com/${c}`, login: 'https://kick.com/' },\\n};\\n// Identificação de navegador igual à de um Chrome normal, com a MESMA versão do Chromium que roda por dentro.\\n// Antes era um \\\"Chrome 124\\\" fixo enquanto o motor era outra versão: essa diferença faz sites com proteção\\n// anti-robô (como a Kick) recusarem o login com \\\"Muitas tentativas\\\".\\nconst LIVE_UA = CLEAN_UA;\\n\\n// ----- canais novos: aprendidos quando o painel de bônus do jogo está aberto -----\\nconst learnedFile = () => path.join(app.getPath('userData'), 'lives-canais.json');\\nfunction loadLearnedChannels() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(learnedFile(), 'utf8'));\\n    for (const p of Object.keys(LIVE_CHANNELS)) {\\n      (j[p] || []).forEach((c) => { if (!LIVE_CHANNELS[p].includes(c)) LIVE_CHANNELS[p].push(c); });\\n    }\\n  } catch {}\\n}\\n// lê a lista \\\"CANAIS OFICIAIS\\\" (Twitch) e \\\"CANAIS OFICIAIS NA KICK\\\" do painel aberto no jogo\\nconst LIVE_DISCOVER = `(() => {\\n  // atalho leve: se o painel de canais não está na tela, não varre a página toda (era pesado com o jogo aberto há horas)\\n  if (!document.body || !/canais oficiais/i.test(document.body.textContent || '')) return { twitch: [], kick: [] };\\n  const read = (headRe) => {\\n    const head = [...document.querySelectorAll('div,span,p,h1,h2,h3,h4,b,strong')]\\n      .find((e) => headRe.test((e.textContent || '').trim()) && e.getClientRects().length);\\n    if (!head) return { rows: [], completo: false };\\n    let box = head.parentElement;\\n    for (let k = 0; k < 4 && box && !/AO VIVO|OFFLINE/i.test(box.innerText || ''); k++) box = box.parentElement;\\n    if (!box) return { rows: [], completo: false };\\n    // sobe mais um pouco para pegar também a parte \\\\\\\"CANAIS OFFLINE (N)\\\\\\\", sem entrar na lista da outra plataforma\\n    const nHead = (el) => ((el.textContent || '').match(/CANAIS OFICIAIS/gi) || []).length;\\n    for (let k = 0; k < 4 && !/CANAIS OFFLINE\\\\\\\\s*\\\\\\\\(\\\\\\\\d+\\\\\\\\)/i.test(box.textContent || ''); k++) {\\n      const up = box.parentElement;\\n      if (!up || nHead(up) > 1) break;\\n      box = up;\\n    }\\n    const skip = /^(OFFLINE|AO VIVO|COPIAR|CANAIS|DISCORD)$/i;\\n    const out = [];\\n    const vistos = new Set();\\n    for (const e of box.querySelectorAll('*')) {\\n      if (e.children.length) continue;\\n      const t = (e.textContent || '').trim();\\n      if (!/^[A-Za-z0-9_]{2,25}$/.test(t) || !/[A-Za-z]/.test(t) || skip.test(t)) continue;\\n      let row = e.parentElement;\\n      for (let k = 0; k < 3 && row && !/AO VIVO|OFFLINE/i.test(row.textContent || ''); k++) row = row.parentElement;\\n      if (!(row && row !== box && /AO VIVO|OFFLINE/i.test(row.textContent || ''))) continue;\\n      if ((row.textContent || '').length > 100 || vistos.has(row)) continue; // uma linha de canal é curta; ignora avisos e faixas\\n      vistos.add(row);\\n      // o nome mostrado pode ser diferente do endereço do canal: usa o link, se a linha tiver um\\n      const a = row.querySelector('a[href*=\\\"kick.com/\\\"], a[href*=\\\"twitch.tv/\\\"]') || row.closest('a[href]');\\n      const m = a ? String(a.href).match(/(?:kick\\\\\\\\.com|twitch\\\\\\\\.tv)\\\\\\\\/([A-Za-z0-9_-]+)/i) : null;\\n      out.push({ name: t, slug: (m ? m[1] : t).toLowerCase(), live: /AO VIVO/i.test(row.textContent || ''), link: !!m });\\n    }\\n    // a lista veio inteira? confere com o contador \\\\\\\"CANAIS OFFLINE (N)\\\\\\\" (se a parte offline estiver fechada, não vem)\\n    const cont = (box.textContent || '').match(/CANAIS OFFLINE\\\\\\\\s*\\\\\\\\((\\\\\\\\d+)\\\\\\\\)/i);\\n    const nOff = out.filter((r) => !r.live).length;\\n    const completo = cont ? nOff === Number(cont[1]) : (out.length >= 3 && nOff > 0);\\n    return { rows: out, completo };\\n  };\\n  const tw = read(/^CANAIS OFICIAIS$/i), kk = read(/^CANAIS OFICIAIS NA KICK$/i);\\n  return { twitch: tw.rows, kick: kk.rows, completo: { twitch: tw.completo, kick: kk.completo } };\\n})()`;\\n// ----- lives lidas DIRETO da conexão do jogo (WebSocket) -----\\n// O servidor do jogo manda para a página os canais oficiais da Kick/Twitch, quem está ao vivo e em quais\\n// lives da Twitch ele já está contando o bônus. Este script roda na página ANTES do jogo e só escuta:\\n// guarda os blocos \\\"kick\\\" e \\\"twitch\\\" que chegam. Não manda nada para o servidor.\\n// Para ficar leve, só abre (JSON.parse) as mensagens que citam kick/twitch.\\nconst LIVE_HOOK_JS = `(() => {\\n  if (window.__plLiveHook) return;\\n  window.__plLiveHook = true;\\n  const Nativo = window.WebSocket;\\n  if (!Nativo) return;\\n  const L = (window.__plLive = window.__plLive || { at: 0, ligado: false });\\n  const guardar = (est) => {\\n    if (!est || typeof est !== 'object') return;\\n    let mudou = false;\\n    if ('kick' in est) { L.kick = est.kick; mudou = true; }\\n    if ('twitch' in est) { L.twitch = est.twitch; mudou = true; }\\n    if (mudou) L.at = Date.now();\\n  };\\n  const ouvir = (ws) => {\\n    ws.addEventListener('open', () => { L.ligado = true; });\\n    ws.addEventListener('close', () => { L.ligado = false; });\\n    ws.addEventListener('message', (ev) => {\\n      const d = ev.data;\\n      if (typeof d !== 'string' || (d.indexOf('\\\"kick\\\"') < 0 && d.indexOf('\\\"twitch\\\"') < 0)) return;\\n      let m; try { m = JSON.parse(d); } catch (e) { return; }\\n      if (m && (m.t === 'welcome' || m.t === 'estado')) guardar(m.estado);\\n    });\\n  };\\n  class WS extends Nativo {\\n    constructor(...a) {\\n      super(...a);\\n      try { if (new URL(String(a[0]), location.href).host === location.host) ouvir(this); } catch (e) {}\\n    }\\n  }\\n  try { Object.defineProperty(WS, 'name', { value: 'WebSocket' }); } catch (e) {}\\n  window.WebSocket = WS;\\n})();`;\\n// resumo pequeno do que a conta recebeu (lido a cada 20 s pelo PokeLink)\\nconst LIVE_STATE_JS = `(() => {\\n  const L = window.__plLive;\\n  if (!L || !L.at) return null;\\n  const arr = (x) => (Array.isArray(x) ? x : []);\\n  const k = L.kick || {}, t = L.twitch || {};\\n  return {\\n    ligado: !!L.ligado,\\n    kick: { tem: !!L.kick, login: k.login || null,\\n      oficiais: arr(k.oficiais).map((c) => ({ slug: String(c.slug || '').toLowerCase(), aoVivo: !!c.aoVivo, esp: Number(c.espectadores) || 0, ativo: c.ativo !== false })).filter((c) => c.slug) },\\n    twitch: { tem: !!L.twitch, login: t.login || null,\\n      oficiais: arr(t.oficiais).map((o) => String(o.login || '').toLowerCase()).filter(Boolean),\\n      lives: arr(t.lives).map((l) => String(l.login || '').toLowerCase()).filter(Boolean),\\n      contando: arr(t.assistindoEm).map((x) => String(x).toLowerCase()) },\\n  };\\n})()`;\\n// liga o script na página da conta antes de o jogo carregar (vale para os recarregamentos também)\\nfunction ligarLeituraLives(wc) {\\n  const ligar = () => {\\n    if (wc.isDestroyed() || wc.debugger.isAttached()) return;\\n    try {\\n      wc.debugger.attach('1.3');\\n      wc.debugger.sendCommand('Page.enable').catch(() => {});\\n      wc.debugger.sendCommand('Page.addScriptToEvaluateOnNewDocument', { source: LIVE_HOOK_JS }).catch(() => {});\\n    } catch {}\\n  };\\n  ligar();\\n  wc.debugger.on('detach', () => setTimeout(ligar, 2000)); // se soltar (ex.: travou e reiniciou), liga de novo\\n}\\nconst jogoInfo = ACCOUNTS.map(() => null); // última leitura de cada conta\\nasync function lerLivesDoJogo() {\\n  if (sono.ausente) return;\\n  await Promise.all(views.map(async (v, i) => {\\n    const wc = v && v.webContents;\\n    if (!wc || wc.isDestroyed() || wc.isLoading()) return;\\n    const r = await withTimeout(wc.executeJavaScript(LIVE_STATE_JS), 3000).catch(() => null);\\n    if (r) jogoInfo[i] = Object.assign(r, { lido: Date.now() });\\n    else if (jogoInfo[i] && Date.now() - jogoInfo[i].lido > 5 * 60 * 1000) jogoInfo[i] = null;\\n  }));\\n}\\n// a leitura do jogo vale se a conexão está ligada e foi lida há pouco\\nconst jogoFresco = (p) => jogoInfo.find((x) => x && x.ligado && x[p] && x[p].tem && x[p].oficiais.length >= 3 && Date.now() - x.lido < 2 * 60 * 1000) || null;\\n// quem está ao vivo segundo o jogo (só canais oficiais com pontos ativos)\\nfunction aoVivoDoJogo(p) {\\n  const j = jogoFresco(p);\\n  if (!j) return null;\\n  if (p === 'kick') return new Set(j.kick.oficiais.filter((c) => c.ativo && c.aoVivo).map((c) => c.slug));\\n  return new Set(j.twitch.lives.filter((c) => j.twitch.oficiais.includes(c)));\\n}\\nlet fonteLives = ''; // de onde veio a última informação (aparece no rodapé do painel Lives)\\n// \\\"ao vivo\\\" segundo o painel do jogo (quando ele estiver aberto): ajuda quando a Kick/Twitch não responde\\nconst gameLive = { twitch: new Map(), kick: new Map() }; // slug -> horário em que o jogo mostrou AO VIVO\\nasync function discoverChannels(lido) {\\n  let found;\\n  if (lido) found = [lido];\\n  else {\\n    await lerLivesDoJogo();\\n    // lista oficial vinda da conexão do jogo (confiável)\\n    const doJogo = { completo: {}, doJogo: true, twitch: [], kick: [] };\\n    for (const p of Object.keys(LIVE_CHANNELS)) {\\n      const j = jogoFresco(p);\\n      if (!j) continue;\\n      doJogo[p] = p === 'kick'\\n        ? j.kick.oficiais.filter((c) => c.ativo).map((c) => ({ slug: c.slug, live: c.aoVivo, link: true }))\\n        : j.twitch.oficiais.map((c) => ({ slug: c, live: j.twitch.lives.includes(c), link: true }));\\n      doJogo.completo[p] = true;\\n    }\\n    const faltam = Object.keys(LIVE_CHANNELS).filter((p) => !doJogo.completo[p]);\\n    // só lê a tela se a conexão não trouxe alguma das plataformas (mais leve)\\n    const daTela = !faltam.length ? [] : await Promise.all(views.map((v) => (v && !v.webContents.isDestroyed()\\n      ? withTimeout(v.webContents.executeJavaScript(LIVE_DISCOVER), 3000).catch(() => ({})) : {})));\\n    found = [doJogo, ...daTela];\\n  }\\n  let j = null;\\n  let mudou = false;\\n  for (const p of Object.keys(LIVE_CHANNELS)) {\\n    const rows = found.flatMap((f) => (f && f[p]) || []).map((r) => (typeof r === 'string' ? { slug: r.toLowerCase(), live: false } : r));\\n    // lista oficial completa lida do painel do jogo: o que não está nela deixou de ser parceiro\\n    // (Twitch: só com o endereço do canal na linha, porque lá o nome mostrado costuma ser diferente do canal)\\n    const inteira = found.find((f) => f && f.completo && f.completo[p] && f[p] && f[p].length >= 3 && (p === 'kick' || f[p].every((r) => r.link)));\\n    if (inteira) mudou = conferirOficiais(p, inteira[p].map((r) => r.slug), !!inteira.doJogo) || mudou;\\n    for (const r of rows) if (r.live && !removidos[p][r.slug]) gameLive[p].set(r.slug, Date.now()); else gameLive[p].delete(r.slug);\\n    const novos = [...new Set(rows.map((r) => r.slug))]\\n      .filter((c) => !LIVE_CHANNELS[p].includes(c) && !removidos[p][c]);\\n    if (!novos.length) continue;\\n    LIVE_CHANNELS[p].push(...novos);\\n    if (!j) { try { j = JSON.parse(fs.readFileSync(learnedFile(), 'utf8')); } catch { j = {}; } }\\n    j[p] = [...new Set([...(j[p] || []), ...novos])];\\n  }\\n  if (j) { try { fs.writeFileSync(learnedFile(), JSON.stringify(j)); } catch {} }\\n  if (!lido && usarAoVivoDoJogo()) syncLives(); // alguém entrou/saiu do ar: abre/fecha já\\n  if (!lido) conferirTwitchDireta();\\n  return !!j || mudou;\\n}\\n// Twitch automática: se a conexão direta está nos canais há 12 min e o jogo não contou nenhum, volta para a página do chat\\nfunction conferirTwitchDireta() {\\n  if (twitchModo !== 'auto') return;\\n  ACCOUNTS.forEach((_, i) => {\\n    if (ircFalhou[i] || modoTw(i) !== 'irc' || !ircDesde[i] || Date.now() - ircDesde[i] < 12 * 60 * 1000) return;\\n    const j = jogoInfo[i];\\n    const abertos = [...liveOpen[i].twitch.keys()];\\n    const contando = (j && j.twitch && j.twitch.contando) || [];\\n    const erroLogin = ircState[i] === 'erro de login' || ircState[i] === 'sem login';\\n    if (erroLogin || (abertos.length && !abertos.some((c) => contando.includes(c)))) {\\n      ircFalhou[i] = true;\\n      logTravamento(`${nameOf(i)}: Twitch pela conexão direta não contou o bônus; voltando para a página do chat`);\\n      saveLives();\\n      syncLives();\\n    }\\n  });\\n}\\n// copia \\\"quem está ao vivo\\\" do jogo para o PokeLink; devolve true se mudou algo\\nfunction usarAoVivoDoJogo() {\\n  let mudou = false;\\n  const partes = [];\\n  for (const p of Object.keys(LIVE_CHANNELS)) {\\n    const s = aoVivoDoJogo(p);\\n    if (!s) continue;\\n    const novo = LIVE_CHANNELS[p].filter((c) => s.has(c));\\n    if (novo.length !== liveNow[p].size || novo.some((c) => !liveNow[p].has(c))) { liveNow[p] = new Set(novo); mudou = true; }\\n    partes.push(`${PLAT[p].name} ${novo.length} ao vivo`);\\n  }\\n  if (partes.length) { fonteLives = 'pelo jogo: ' + partes.join(', '); liveLastCheck = Date.now(); }\\n  return mudou;\\n}\\n\\n// junta canais novos (de qualquer fonte) na lista e guarda\\n// ----- canais removidos (deixaram de ser parceiros) -----\\n// 'auto' = sumiu da lista oficial do painel do jogo · 'manual' = você tirou pelo painel\\nconst removidosFile = () => path.join(app.getPath('userData'), 'lives-removidos.json');\\nconst removidos = { twitch: {}, kick: {} };\\nconst fixos = { twitch: new Set(), kick: new Set() }; // você trouxe de volta: a remoção automática não mexe mais\\nfunction loadRemovidos() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(removidosFile(), 'utf8'));\\n    for (const p of Object.keys(removidos)) if (j[p] && typeof j[p] === 'object') Object.assign(removidos[p], j[p]);\\n    for (const p of Object.keys(fixos)) ((j.fixos && j.fixos[p]) || []).forEach((c) => fixos[p].add(String(c)));\\n  } catch {}\\n  aplicarRemovidos();\\n}\\nfunction saveRemovidos() {\\n  try { fs.writeFileSync(removidosFile(), JSON.stringify({ ...removidos, fixos: { twitch: [...fixos.twitch], kick: [...fixos.kick] } })); } catch {}\\n}\\n// tira da lista, da seleção da Kick e fecha as lives abertas desses canais\\nfunction aplicarRemovidos() {\\n  for (const p of Object.keys(LIVE_CHANNELS)) {\\n    for (const c of LIVE_CHANNELS[p].filter((x) => removidos[p][x])) {\\n      LIVE_CHANNELS[p].splice(LIVE_CHANNELS[p].indexOf(c), 1);\\n      liveNow[p].delete(c);\\n      gameLive[p].delete(c);\\n    }\\n    for (const c of Object.keys(removidos[p])) {\\n      if (p === 'kick') kickSel.forEach((sel) => { const k = sel.indexOf(c); if (k >= 0) sel.splice(k, 1); });\\n      liveOpen.forEach((o) => { const slot = o[p].get(c); if (slot) { closeLive(slot); o[p].delete(c); } });\\n    }\\n  }\\n}\\nfunction avisarCanais() {\\n  saveRemovidos();\\n  saveLives();\\n  syncLives(); // também redesenha o painel das Lives\\n  sendState();\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('kick-update');\\n  if (kickWin && !kickWin.isDestroyed()) kickWin.webContents.send('kick-update');\\n}\\nfunction removerCanal(p, slug, como) {\\n  slug = String(slug || '').toLowerCase();\\n  if (!LIVE_CHANNELS[p] || !/^[a-z0-9_]{2,25}$/.test(slug)) return false;\\n  if (removidos[p][slug] === 'manual') return false;\\n  if (como === 'auto' && fixos[p].has(slug)) return false;\\n  if (como !== 'auto') fixos[p].delete(slug);\\n  removidos[p][slug] = como === 'auto' ? 'auto' : 'manual';\\n  aplicarRemovidos();\\n  return true;\\n}\\nfunction voltarCanal(p, slug) {\\n  slug = String(slug || '').toLowerCase();\\n  if (!removidos[p] || !removidos[p][slug]) return false;\\n  delete removidos[p][slug];\\n  if (!LIVE_CHANNELS[p].includes(slug)) LIVE_CHANNELS[p].push(slug);\\n  return true;\\n}\\n// compara com a lista oficial completa lida no jogo: quem saiu é removido sozinho, quem voltou volta\\nfunction conferirOficiais(p, slugs, confiavel) {\\n  const oficial = new Set(slugs.map((c) => String(c).toLowerCase()));\\n  let mudou = false;\\n  for (const [c, como] of Object.entries(removidos[p])) if (como === 'auto' && oficial.has(c)) mudou = voltarCanal(p, c) || mudou;\\n  const sairam = LIVE_CHANNELS[p].filter((c) => !oficial.has(c));\\n  // segurança: se quase todos \\\"saíram\\\", provavelmente a leitura falhou; não remove nada\\n  if (sairam.length && (confiavel || sairam.length <= Math.max(3, Math.floor(LIVE_CHANNELS[p].length / 2)))) {\\n    for (const c of sairam) mudou = removerCanal(p, c, 'auto') || mudou;\\n  }\\n  if (mudou) avisarCanais();\\n  return mudou;\\n}\\nconst listaCanais = () => Object.keys(LIVE_CHANNELS).map((p) => ({\\n  p, name: PLAT[p].name, lista: [...LIVE_CHANNELS[p]],\\n  removidos: Object.entries(removidos[p]).map(([slug, como]) => ({ slug, como })),\\n}));\\n// ----- confere a lista oficial sozinho (igual à Auto Compra com o Market) -----\\n// Ao abrir o PokeLink e a cada 3 horas: abre o painel \\\"Bônus na Kick\\\" (e o da Twitch, se houver) INVISÍVEL\\n// numa conta, lê a lista oficial inteira, fecha e ajusta a lista do PokeLink.\\nconst BONUS_ABRIR = (plat) => `(async () => {\\n  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n  const modal = document.getElementById('modal');\\n  const aberto = () => { const c = modal && modal.querySelector('.modal-caixa'); if (!c) return false; const r = c.getBoundingClientRect(); return r.width > 0 && r.height > 0; };\\n  if (aberto()) return 'janela';\\n  const b = document.querySelector('button.tr-ativo.${plat}') ||\\n    [...document.querySelectorAll('button,[role=button]')].find((e) => e.classList.contains('tr-ativo') && /${plat}/i.test((e.getAttribute('aria-label') || '') + ' ' + (e.textContent || '') + ' ' + e.className));\\n  if (!b) return 'sem botao';\\n  let st = document.getElementById('pokelink-bonus-oculto');\\n  if (!st) { st = document.createElement('style'); st.id = 'pokelink-bonus-oculto'; document.head.appendChild(st); }\\n  st.textContent = '#modal, #modal * { opacity: 0 !important; transition: none !important; animation: none !important; }';\\n  b.click();\\n  const titulo = () => [...document.querySelectorAll('h1,h2,h3,h4,div,span,b,strong')].some((e) => !e.children.length && /^CANAIS OFICIAIS/i.test((e.textContent || '').trim()));\\n  for (let k = 0; k < 30; k++) { if (titulo()) return 'ok'; await sleep(200); }\\n  return 'nao abriu';\\n})()`;\\nconst BONUS_OFFLINE = `(() => {\\n  const t = [...document.querySelectorAll('button,[role=button],div,span')].find((e) => /^CANAIS OFFLINE\\\\\\\\s*\\\\\\\\(\\\\\\\\d+\\\\\\\\)/i.test((e.textContent || '').trim()) && (e.textContent || '').trim().length < 40);\\n  if (!t) return false;\\n  (t.closest('button,[role=button]') || t).click();\\n  return true;\\n})()`;\\nconst BONUS_FECHAR = `(async () => {\\n  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n  const x = document.getElementById('modal-fechar');\\n  if (x) x.click(); else document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));\\n  await sleep(400);\\n  const st = document.getElementById('pokelink-bonus-oculto'); if (st) st.remove();\\n  return true;\\n})()`;\\nlet listaInfo = '';\\nlet listaBusy = false;\\nasync function lerBonus(i, plat) {\\n  const wc = views[i].webContents;\\n  const js = (code, ms) => withTimeout(wc.executeJavaScript(code), ms).catch(() => null);\\n  const abriu = await js(BONUS_ABRIR(plat), 9000);\\n  if (abriu !== 'ok') { if (abriu && abriu !== 'janela' && abriu !== 'sem botao') await js(BONUS_FECHAR, 3000); return { erro: abriu || 'sem resposta' }; }\\n  try {\\n    await new Promise((r) => setTimeout(r, 800)); // deixa a lista terminar de aparecer\\n    let d = await js(LIVE_DISCOVER, 4000);\\n    if (d && d.completo && !d.completo[plat] && (await js(BONUS_OFFLINE, 2000))) { // parte \\\"offline\\\" fechada: abre e lê de novo\\n      await new Promise((r) => setTimeout(r, 700));\\n      d = await js(LIVE_DISCOVER, 4000);\\n    }\\n    return d || { erro: 'não leu' };\\n  } finally { await js(BONUS_FECHAR, 3000); }\\n}\\nasync function conferirListaOficial() {\\n  if (sono.ausente) return listaInfo;\\n  await lerLivesDoJogo();\\n  if (jogoFresco('kick')) { await discoverChannels(); listaInfo = 'lista oficial vem direto do jogo'; return listaInfo; }\\n  if (listaBusy) return listaInfo;\\n  listaBusy = true;\\n  try {\\n    // prefere uma conta que você não está usando agora (o painel invisível segura os cliques por uns segundos)\\n    const ordem = ACCOUNTS.map((_, i) => i).sort((a, b) => (a === focused) - (b === focused));\\n    for (const i of ordem) {\\n      const wc = views[i] && views[i].webContents;\\n      if (!wc || wc.isDestroyed() || wc.isLoading() || level[i] === 3 || autoBusy[i]) continue;\\n      autoBusy[i] = true; // não deixa a Auto Compra abrir o Market ao mesmo tempo\\n      try {\\n        const res = {};\\n        for (const plat of ['kick', 'twitch']) res[plat] = await lerBonus(i, plat);\\n        const k = res.kick;\\n        if (k && !k.erro) {\\n          await discoverChannels(k);\\n          const t = res.twitch;\\n          if (t && !t.erro) await discoverChannels({ twitch: t.twitch, kick: [], completo: { twitch: t.completo && t.completo.twitch, kick: false } });\\n          const hora = new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });\\n          listaInfo = k.completo && k.completo.kick ? `lista oficial conferida às ${hora} (Kick: ${k.kick.length} canais)` : `lista oficial às ${hora}: veio incompleta, não removi ninguém`;\\n          avisarCanais();\\n          return listaInfo;\\n        }\\n        if (k && k.erro === 'janela') continue; // tem uma janela aberta nessa conta: tenta outra\\n      } finally { autoBusy[i] = false; }\\n    }\\n    listaInfo = 'lista oficial: não consegui abrir o painel de bônus agora (tento de novo mais tarde)';\\n    return listaInfo;\\n  } finally { listaBusy = false; }\\n}\\nipcMain.handle('lista-conferir', async () => { await conferirListaOficial(); return livesOverview(); });\\n\\nipcMain.on('canal-remover', (_, p, slug) => { if (removerCanal(p, slug, 'manual')) avisarCanais(); });\\nipcMain.on('canal-voltar', (_, p, slug) => {\\n  const era = removidos[p] && removidos[p][String(slug || '').toLowerCase()];\\n  if (!voltarCanal(p, slug)) return;\\n  if (era === 'auto') fixos[p].add(String(slug).toLowerCase()); // a remoção automática errou: não tira de novo\\n  avisarCanais();\\n  checkLives();\\n});\\n\\nfunction addChannels(novos) {\\n  let mudou = false;\\n  let j = null;\\n  for (const p of Object.keys(LIVE_CHANNELS)) {\\n    const add = [...(novos[p] || [])].map((c) => String(c).toLowerCase()).filter((c) => /^[a-z0-9_]{2,25}$/.test(c) && !LIVE_CHANNELS[p].includes(c) && !removidos[p][c]);\\n    if (!add.length) continue;\\n    LIVE_CHANNELS[p].push(...add);\\n    if (!j) { try { j = JSON.parse(fs.readFileSync(learnedFile(), 'utf8')); } catch { j = {}; } }\\n    j[p] = [...new Set([...(j[p] || []), ...add])];\\n    mudou = true;\\n  }\\n  if (j) { try { fs.writeFileSync(learnedFile(), JSON.stringify(j)); } catch {} }\\n  return mudou;\\n}\\n\\n// Aprende canais pelas respostas que o próprio jogo recebe do servidor (lista de parceiros),\\n// sem depender do painel \\\"Bônus Twitch/Kick\\\" estar aberto.\\n// Procura, no JSON, listas onde a maioria dos nomes já é de canais conhecidos e pega os outros nomes da mesma lista.\\nfunction learnFromJson(json) {\\n  const out = { twitch: new Set(), kick: new Set() };\\n  const so = (p) => { const outro = p === 'twitch' ? 'kick' : 'twitch'; return LIVE_CHANNELS[p].filter((c) => !LIVE_CHANNELS[outro].includes(c)); };\\n  const exclusivos = { twitch: so('twitch'), kick: so('kick') };\\n  const walk = (o, d) => {\\n    if (!o || typeof o !== 'object' || d > 7) return;\\n    if (Array.isArray(o)) {\\n      const objs = o.filter((x) => x && typeof x === 'object' && !Array.isArray(x));\\n      const strs = o.filter((x) => typeof x === 'string');\\n      const listas = [];\\n      if (strs.length >= 2) listas.push({ vals: strs, objs: null });\\n      if (objs.length >= 2) {\\n        for (const key of Object.keys(objs[0])) {\\n          const vals = objs.map((x) => x[key]);\\n          if (vals.filter((v) => typeof v === 'string' && /^[A-Za-z0-9_]{2,25}$/.test(v)).length >= objs.length * 0.8) listas.push({ vals, objs });\\n        }\\n      }\\n      for (const { vals, objs: os } of listas) {\\n        const low = vals.map((v) => (typeof v === 'string' ? v.toLowerCase() : ''));\\n        const conhecidos = low.filter((v) => LIVE_CHANNELS.twitch.includes(v) || LIVE_CHANNELS.kick.includes(v)).length;\\n        if (conhecidos < 2) continue;\\n        low.forEach((v, k) => {\\n          if (!/^[a-z0-9_]{2,25}$/.test(v)) return;\\n          // plataforma: pelo campo do próprio item (ex.: plataforma: \\\"kick\\\"), senão pelos nomes exclusivos da lista\\n          const item = os ? JSON.stringify(os[k]).toLowerCase() : '';\\n          let p = /\\\"(?:plataforma|platform|tipo|type|provedor|origem)\\\"\\\\s*:\\\\s*\\\"kick\\\"/.test(item) ? 'kick'\\n            : /\\\"(?:plataforma|platform|tipo|type|provedor|origem)\\\"\\\\s*:\\\\s*\\\"twitch\\\"/.test(item) ? 'twitch' : null;\\n          if (!p) {\\n            const tw = low.filter((x) => exclusivos.twitch.includes(x)).length;\\n            const kk = low.filter((x) => exclusivos.kick.includes(x)).length;\\n            p = tw > kk ? 'twitch' : kk > tw ? 'kick' : null;\\n          }\\n          if (p) out[p].add(v);\\n        });\\n      }\\n      o.forEach((x) => walk(x, d + 1));\\n    } else Object.values(o).forEach((v) => walk(v, d + 1));\\n  };\\n  walk(json, 0);\\n  return out;\\n}\\nconst apiUrls = new Set(); // respostas do jogo que podem ter a lista de parceiros\\nfunction watchGameApi(i) {\\n  const ses = session.fromPartition(`persist:conta${i + 1}`);\\n  try {\\n    ses.webRequest.onCompleted({ urls: ['https://pokeidle.io/*', 'https://*.pokeidle.io/*'] }, (d) => {\\n      if (d.method !== 'GET' || d.statusCode !== 200 || !/xhr|fetch/i.test(d.resourceType || '')) return;\\n      if (!/twitch|kick|stream|live|parceir|canais|canal|bonus|b%C3%B4nus/i.test(d.url)) return;\\n      if (apiUrls.size < 30 && !apiUrls.has(d.url)) { apiUrls.add(d.url); setTimeout(learnFromApi, 2000); }\\n    });\\n  } catch {}\\n}\\nlet apiLearning = false;\\nasync function learnFromApi() {\\n  if (apiLearning || !apiUrls.size) return;\\n  apiLearning = true;\\n  try {\\n    const ses = session.fromPartition('persist:conta1');\\n    let achou = false;\\n    for (const u of apiUrls) {\\n      try {\\n        const r = await withTimeout(ses.fetch(u, { headers: { Accept: 'application/json' } }), 10000);\\n        if (!r.ok) continue;\\n        const j = await r.json().catch(() => null);\\n        if (j && addChannels(learnFromJson(j))) achou = true;\\n      } catch {}\\n    }\\n    if (achou) checkLives(); // canal novo: já confere se está ao vivo e abre\\n  } finally { apiLearning = false; }\\n}\\n\\n// ----- quais contas estão com Twitch / Kick ligadas -----\\nconst livesFile = () => path.join(app.getPath('userData'), 'lives.json');\\n// \\\"chat\\\" = só o chat (padrão: testado, conta o bônus e é bem mais leve)\\n// \\\"player\\\" = só o vídeo · \\\"completo\\\" = página do canal (vídeo + chat)\\n// \\\"auto\\\" (padrão) = conexão direta de chat (quase não gasta nada), conferida pelo jogo: se o jogo não contar o\\n// bônus, aquela conta volta sozinha para a página do chat. Sem a confirmação do jogo, usa a página do chat.\\nlet twitchModo = 'auto';\\nconst ircFalhou = ACCOUNTS.map(() => false); // conta em que a conexão direta não contou: usa a página do chat\\nconst ircDesde = ACCOUNTS.map(() => 0);      // desde quando a conexão direta está nos canais\\nfunction modoTw(i) {\\n  if (twitchModo !== 'auto') return twitchModo;\\n  const j = jogoInfo[i];\\n  const confere = j && j.twitch && j.twitch.tem && Date.now() - j.lido < 5 * 60 * 1000; // 5 min de folga: não fica trocando à toa\\n  return !ircFalhou[i] && confere ? 'irc' : 'chat';\\n}\\n// fecha a Twitch de uma conta para reabrir no modo certo\\nfunction reabrirTwitch(i) {\\n  for (const slot of liveOpen[i].twitch.values()) closeLive(slot);\\n  liveOpen[i].twitch.clear();\\n  closeIrc(i);\\n  ircDesde[i] = 0;\\n}\\nconst modoTwAtual = ACCOUNTS.map(() => '');\\nfunction setTwitchModo(m) {\\n  if (twitchModo === m) return;\\n  twitchModo = m;\\n  ircFalhou.fill(false);\\n  saveLives();\\n  buildMenu();\\n  // fecha tudo da Twitch e reabre no modo novo\\n  ACCOUNTS.forEach((_, i) => {\\n    for (const slot of liveOpen[i].twitch.values()) closeLive(slot);\\n    liveOpen[i].twitch.clear();\\n    closeIrc(i);\\n  });\\n  syncLives();\\n}\\n\\n// ---------- Twitch por conexão direta de chat (modo \\\"irc\\\") ----------\\n// Em vez de abrir uma página de chat por canal (~100+ MB cada), cada conta mantém UMA conexão de chat\\n// da Twitch, com o próprio login da conta, e entra nos chats dos canais oficiais ao vivo (JOIN).\\nconst ircs = ACCOUNTS.map(() => null); // { view, joined: Set }\\nconst ircState = ACCOUNTS.map(() => '');\\nfunction closeIrc(i) {\\n  const c = ircs[i];\\n  ircs[i] = null;\\n  ircState[i] = '';\\n  try { if (c && c.view && !c.view.webContents.isDestroyed()) c.view.webContents.close(); } catch {}\\n}\\nconst IRC_JS = (token, nick, chans) => `(() => {\\n  try { if (window.__irc) window.__irc.close(); } catch (e) {}\\n  const ws = new WebSocket('wss://irc-ws.chat.twitch.tv:443');\\n  window.__irc = ws; window.__ircState = 'conectando';\\n  ws.onopen = () => {\\n    ws.send('CAP REQ :twitch.tv/membership');\\n    ws.send('PASS oauth:' + ${JSON.stringify(token)});\\n    ws.send('NICK ' + ${JSON.stringify(nick)});\\n    for (const c of ${JSON.stringify(chans)}) ws.send('JOIN #' + c);\\n  };\\n  ws.onmessage = (e) => {\\n    for (const l of String(e.data).split('\\\\\\\\r\\\\\\\\n')) {\\n      if (l.startsWith('PING')) ws.send('PONG' + l.slice(4));\\n      else if (/ 001 /.test(l)) window.__ircState = 'ok';\\n      else if (/Login authentication failed|Improperly formatted auth/i.test(l)) window.__ircState = 'erro de login';\\n    }\\n  };\\n  ws.onclose = () => { if (window.__ircState !== 'erro de login') window.__ircState = 'fechado'; };\\n  return true;\\n})()`;\\nlet ircBusy = ACCOUNTS.map(() => false);\\nasync function ensureIrc(i, chans) {\\n  if (ircBusy[i]) return;\\n  ircBusy[i] = true;\\n  try {\\n    if (!chans.length || !lives.twitch[i]) { closeIrc(i); return; }\\n    const ses = accountSession(i);\\n    const tok = ((await ses.cookies.get({ domain: 'twitch.tv', name: 'auth-token' }))[0] || {}).value;\\n    const nick = ((await ses.cookies.get({ domain: 'twitch.tv', name: 'login' }))[0] || {}).value;\\n    if (!tok || !nick) { ircState[i] = 'sem login'; return; }\\n    let c = ircs[i];\\n    if (!c || c.view.webContents.isDestroyed()) {\\n      const v = new WebContentsView({ webPreferences: { partition: `persist:conta${i + 1}`, backgroundThrottling: false } });\\n      await v.webContents.loadURL('about:blank').catch(() => {});\\n      c = ircs[i] = { view: v, joined: new Set() };\\n    }\\n    const wc = c.view.webContents;\\n    const st = await withTimeout(wc.executeJavaScript('window.__ircState || \\\"\\\"'), 3000).catch(() => '');\\n    ircState[i] = st;\\n    if (st !== 'ok' && st !== 'conectando') {\\n      if (st === 'erro de login') return; // não insiste com login inválido\\n      await withTimeout(wc.executeJavaScript(IRC_JS(tok, nick.toLowerCase(), chans)), 5000).catch(() => {});\\n      c.joined = new Set(chans);\\n      return;\\n    }\\n    // entra nos canais novos e sai dos que não estão mais ao vivo\\n    const cmds = [];\\n    for (const ch of chans) if (!c.joined.has(ch)) { cmds.push('JOIN #' + ch); c.joined.add(ch); }\\n    for (const ch of [...c.joined]) if (!chans.includes(ch)) { cmds.push('PART #' + ch); c.joined.delete(ch); }\\n    if (cmds.length) await withTimeout(wc.executeJavaScript(`(() => { for (const m of ${JSON.stringify(cmds)}) window.__irc.send(m); return true; })()`), 3000).catch(() => {});\\n  } finally { ircBusy[i] = false; }\\n}\\nconst lives = { twitch: ACCOUNTS.map(() => false), kick: ACCOUNTS.map(() => false) };\\n// canais da Kick escolhidos para farmar em cada conta (vazio = automático)\\nconst kickSel = ACCOUNTS.map(() => []);\\nfunction loadLives() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(livesFile(), 'utf8'));\\n    const tw = Array.isArray(j.twitch) ? j.twitch : Array.isArray(j.on) ? j.on : []; // \\\"on\\\" = versão antiga (só Twitch)\\n    tw.forEach((v, i) => { if (i < ACCOUNTS.length) lives.twitch[i] = !!v; });\\n    (Array.isArray(j.kick) ? j.kick : []).forEach((v, i) => { if (i < ACCOUNTS.length) lives.kick[i] = !!v; });\\n    (Array.isArray(j.kickSel) ? j.kickSel : []).forEach((v, i) => { if (i < ACCOUNTS.length && Array.isArray(v)) kickSel[i] = v.map(String); });\\n    if (['completo', 'player', 'chat', 'irc', 'auto'].includes(j.twitchModo)) twitchModo = j.twitchModo;\\n    // quem estava no antigo padrão (\\\"só o chat\\\") passa para o novo padrão automático (uma vez só)\\n    if (!j.v2 && twitchModo === 'chat') twitchModo = 'auto';\\n    if (['auto', 'completa'].includes(j.kickPlayer)) kickPlayer = j.kickPlayer;\\n    (Array.isArray(j.kickCompleta) ? j.kickCompleta : []).forEach((v, i) => { if (i < ACCOUNTS.length) kickCompleta[i] = !!v; });\\n    (Array.isArray(j.ircFalhou) ? j.ircFalhou : []).forEach((v, i) => { if (i < ACCOUNTS.length) ircFalhou[i] = !!v; });\\n    if (typeof j.kickLeve === 'boolean') kickLeve = j.kickLeve;\\n    if (typeof j.kickAvisos === 'boolean') kickAvisos = j.kickAvisos;\\n  } catch {}\\n}\\nconst saveLives = () => { try { fs.writeFileSync(livesFile(), JSON.stringify({ v2: true, twitch: lives.twitch, kick: lives.kick, kickSel, twitchModo, kickLeve, kickAvisos, kickPlayer, kickCompleta, ircFalhou })); } catch {} };\\n// avisos ao bater 300/500/1.000 pontos da Kick (liga/desliga no painel de pontos ou no menu Lives)\\nlet kickAvisos = true;\\nfunction setKickAvisos(on) {\\n  kickAvisos = !!on;\\n  saveLives();\\n  buildMenu();\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('kick-update');\\n  if (kickWin && !kickWin.isDestroyed()) kickWin.webContents.send('kick-update');\\n}\\nipcMain.on('kick-avisos', (_, on) => setKickAvisos(on));\\n\\nconst liveNow = { twitch: new Set(), kick: new Set() };                        // canais ao vivo agora\\nconst liveOpen = ACCOUNTS.map(() => ({ twitch: new Map(), kick: new Map() })); // canal -> live escondida\\nlet liveChecking = false;\\nlet liveLastCheck = 0;\\nlet liveErrors = 0;\\n\\nconst checkSession = () => session.fromPartition('persist:lives-check');\\nconst accountSession = (i) => session.fromPartition(`persist:conta${i + 1}`);\\nasync function isLive(plat, c) {\\n  if (plat === 'twitch') {\\n    const r = await withTimeout(checkSession().fetch(`https://www.twitch.tv/${c}`, { headers: { 'User-Agent': LIVE_UA } }), 15000);\\n    if (!r.ok) throw new Error('HTTP ' + r.status);\\n    return /\\\"isLiveBroadcast\\\"\\\\s*:\\\\s*true/.test(await r.text());\\n  }\\n  // Kick: tenta pela sessão de uma conta logada (passa pela proteção anti-robô da Kick) e depois pela sessão neutra\\n  const sess = [...ACCOUNTS.map((_, i) => i).filter((i) => lives.kick[i]).map(accountSession), checkSession()];\\n  let lastErr = null;\\n  for (const ses of sess) {\\n    try {\\n      const r = await withTimeout(ses.fetch(`https://kick.com/api/v2/channels/${c}`, {\\n        headers: { 'User-Agent': LIVE_UA, Accept: 'application/json' },\\n      }), 15000);\\n      if (!r.ok) { lastErr = new Error('HTTP ' + r.status); continue; }\\n      const j = await r.json();\\n      return !!(j && j.livestream && j.livestream.is_live !== false);\\n    } catch (e) { lastErr = e; }\\n  }\\n  throw lastErr || new Error('sem resposta');\\n}\\n\\n// Kick: a proteção anti-robô dela às vezes recusa as consultas feitas \\\"de fora\\\" (o PokeLink perguntando direto).\\n// Por isso a verificação principal é feita DE DENTRO de uma página da kick.com aberta por um instante,\\n// com o login de uma conta (igual a um navegador normal). Depois a página é fechada.\\nconst KICK_LIVE_JS = (slugs) => `(async () => {\\n  const out = {};\\n  await Promise.all(${JSON.stringify([])}.concat(SLUGS).map(async (s) => {\\n    try {\\n      const r = await fetch('/api/v2/channels/' + s, { headers: { Accept: 'application/json' }, credentials: 'include' });\\n      if (!r.ok) { out[s] = 'http ' + r.status; return; }\\n      const j = await r.json();\\n      out[s] = !!(j && j.livestream && j.livestream.is_live !== false);\\n    } catch (e) { out[s] = 'erro'; }\\n  }));\\n  return out;\\n})()`.replace('SLUGS', JSON.stringify(slugs));\\nlet kickCheckInfo = ''; // resumo da última verificação da Kick (aparece no painel das Lives)\\nasync function kickLiveViaPage() {\\n  const i = ACCOUNTS.findIndex((_, k) => lives.kick[k]);\\n  if (i < 0) return {};\\n  const v = new WebContentsView({ webPreferences: { partition: `persist:conta${i + 1}`, backgroundThrottling: false } });\\n  const wc = v.webContents;\\n  wc.setAudioMuted(true);\\n  kickViewIds.add(wc.id); // modo leve: não baixa imagens nessa página\\n  try {\\n    await withTimeout(wc.loadURL('https://kick.com/', { userAgent: LIVE_UA }), 30000).catch(() => {});\\n    let r = {};\\n    for (let k = 0; k < 3; k++) { // a proteção da Kick pode levar uns segundos para liberar a página\\n      r = (await withTimeout(wc.executeJavaScript(KICK_LIVE_JS(LIVE_CHANNELS.kick)), 25000).catch(() => null)) || {};\\n      if (Object.values(r).some((x) => typeof x === 'boolean')) break;\\n      await new Promise((ok) => setTimeout(ok, 4000));\\n    }\\n    const ok = Object.values(r).filter((x) => typeof x === 'boolean').length;\\n    const falhas = Object.entries(r).filter(([, x]) => typeof x !== 'boolean');\\n    kickCheckInfo = `pela página: ${ok}/${LIVE_CHANNELS.kick.length} canais` + (falhas.length ? ` (${falhas.slice(0, 3).map(([c, x]) => c + ': ' + x).join(', ')})` : '');\\n    return r;\\n  } catch (e) {\\n    kickCheckInfo = 'pela página: erro ' + e.message;\\n    return {};\\n  } finally {\\n    kickViewIds.delete(wc.id);\\n    try { wc.close(); } catch {}\\n  }\\n}\\n\\nasync function twitchLogged(i) {\\n  try { return (await accountSession(i).cookies.get({ domain: 'twitch.tv', name: 'auth-token' })).length > 0; }\\n  catch { return false; }\\n}\\nasync function kickLogged(i) {\\n  const ses = accountSession(i);\\n  try {\\n    const r = await withTimeout(ses.fetch('https://kick.com/api/v1/user', { headers: { 'User-Agent': LIVE_UA, Accept: 'application/json' } }), 10000);\\n    if (r.ok) { const j = await r.json().catch(() => null); if (j && (j.username || j.id)) return true; }\\n    if (r.status === 401) return false;\\n  } catch {}\\n  // a Kick não respondeu direito: usa o cookie de sessão como referência\\n  try { return (await ses.cookies.get({ domain: 'kick.com' })).some((c) => /session_token/i.test(c.name)); }\\n  catch { return false; }\\n}\\nconst isLogged = (i, plat) => (plat === 'twitch' ? twitchLogged(i) : kickLogged(i));\\n\\nasync function checkLives() {\\n  if (liveChecking) return;\\n  if (sono.ausente) { syncLives(); return; }\\n  if (!LIVE_PLATS().length) { syncLives(); return; }\\n  liveChecking = true;\\n  let errs = 0;\\n  try {\\n    // conta que saiu da Twitch/Kick: desliga só aquela plataforma (sem login não conta)\\n    let changed = false;\\n    for (let i = 0; i < ACCOUNTS.length; i++) {\\n      for (const p of Object.keys(LIVE_CHANNELS)) {\\n        if (lives[p][i] && !(await isLogged(i, p))) { lives[p][i] = false; changed = true; }\\n      }\\n    }\\n    if (changed) { saveLives(); buildMenu(); }\\n    await discoverChannels(); // lista oficial e quem está ao vivo pela conexão do jogo (ou pela tela)\\n    const peloJogo = LIVE_PLATS().filter((p) => aoVivoDoJogo(p));\\n    usarAoVivoDoJogo();\\n    const resto = LIVE_PLATS().filter((p) => !peloJogo.includes(p));\\n    if (!resto.length) fonteLives = fonteLives || 'pelo jogo';\\n    // Kick: só abre a página escondida da kick.com se o jogo não informou (bem mais leve)\\n    const kickPage = resto.includes('kick') ? await kickLiveViaPage() : {};\\n    await Promise.all(resto.flatMap((plat) => LIVE_CHANNELS[plat].map(async (c) => {\\n      if (plat === 'kick' && typeof kickPage[c] === 'boolean') { kickPage[c] ? liveNow.kick.add(c) : liveNow.kick.delete(c); return; }\\n      try { (await isLive(plat, c)) ? liveNow[plat].add(c) : liveNow[plat].delete(c); }\\n      catch {\\n        errs++;\\n        // não deu para verificar: se o painel do jogo mostrou AO VIVO há pouco (15 min), considera ao vivo\\n        const t = gameLive[plat].get(c);\\n        if (t && Date.now() - t < 15 * 60 * 1000) liveNow[plat].add(c);\\n      }\\n    })));\\n  } finally {\\n    liveChecking = false;\\n    liveErrors = errs;\\n    liveLastCheck = Date.now();\\n  }\\n  syncLives();\\n}\\n\\nfunction openLive(i, plat, c) {\\n  const v = new WebContentsView({ webPreferences: { partition: `persist:conta${i + 1}`, backgroundThrottling: false } });\\n  const wc = v.webContents;\\n  wc.setAudioMuted(true); // igual a \\\"mutar guia\\\": ninguém ouve, mas o player segue tocando normalmente\\n  if (plat === 'kick') {\\n    // modo leve da Kick: menos coisas carregando e desenhando na página da live\\n    kickViewIds.add(wc.id);\\n    wc.once('destroyed', () => kickViewIds.delete(wc.id));\\n    // roda antes da página da Kick: ela sempre \\\"se acha\\\" visível (a janela pode estar escondida com a tela apagada)\\n    try { wc.debugger.attach('1.3'); wc.debugger.sendCommand('Page.addScriptToEvaluateOnNewDocument', { source: KICK_VISIVEL_JS }).catch(() => {}); } catch {}\\n    wc.on('dom-ready', () => { if (kickLeve) wc.insertCSS(KICK_LEVE_CSS).catch(() => {}); });\\n  }\\n  if (plat === 'kick' && win && !win.isDestroyed()) {\\n    // A Kick só conta pontos com o player TOCANDO e a página VISÍVEL. Fora da área da janela, a página fica\\n    // \\\"hidden\\\" e o vídeo nem carrega (confirmado no diagnóstico). Então a live fica DENTRO da janela, em tamanho\\n    // de computador (para o chat e a contagem funcionarem), por baixo de uma \\\"capa\\\" escura e das contas do jogo.\\n    // Ninguém vê, mas para a Kick ela está aberta na tela.\\n    try {\\n      ensureLiveCover();\\n      if (!tela.off) win.contentView.addChildView(v, 0); // fica por baixo da capa (com a tela apagada, entra ao acender)\\n      // player pequeno: 640x360 basta (e puxa vídeo de qualidade menor); página inteira precisa de tamanho de computador\\n      v.setBounds(kickUrl(i, c).includes('player.kick.com') ? { x: 0, y: TITLE_H, width: 640, height: 360 } : { x: 0, y: TITLE_H, width: 1024, height: 576 });\\n      slotAttached.add(v);\\n    } catch {}\\n  }\\n  wc.setWindowOpenHandler(() => ({ action: 'deny' }));\\n  if (plat === 'twitch' && ['player', 'completo'].includes(modoTw(i))) {\\n    // menor qualidade possível (160p) para gastar pouco; na 1ª vez recarrega para aplicar\\n    wc.on('dom-ready', () => {\\n      wc.executeJavaScript(`(() => { try {\\n        const before = localStorage.getItem('video-quality');\\n        localStorage.setItem('video-quality', JSON.stringify({ default: '160p30' }));\\n        localStorage.setItem('video-muted', JSON.stringify({ default: false }));\\n        return before;\\n      } catch (e) { return 'erro'; } })()`).then((before) => {\\n        if (before === null && !wc.isDestroyed()) wc.reload();\\n      }).catch(() => {});\\n    });\\n  }\\n  wc.loadURL(plat === 'kick' ? kickUrl(i, c) : PLAT[plat].url(c, modoTw(i)), { userAgent: LIVE_UA }).catch(() => {});\\n  return v;\\n}\\n// As lives abrem uma de cada vez, para não travar o PC abrindo dezenas de páginas no mesmo segundo.\\nconst LIVE_OPEN_GAP = 1500;\\nlet liveOpenAt = 0;\\nfunction scheduleLive(i, plat, c) {\\n  const now = Date.now();\\n  liveOpenAt = Math.max(liveOpenAt, now);\\n  const slot = { view: null, timer: null, openedAt: Date.now() + (liveOpenAt - now), miss: 0 };\\n  slot.timer = setTimeout(() => { slot.timer = null; slot.view = openLive(i, plat, c); }, liveOpenAt - now);\\n  liveOpenAt += LIVE_OPEN_GAP;\\n  return slot;\\n}\\nconst slotAttached = new Set(); // lives que estão dentro da janela (Kick)\\n// capa escura por cima das lives da Kick (e por baixo das contas do jogo), para elas nunca aparecerem\\nlet liveCover = null;\\nfunction ensureLiveCover() {\\n  if (liveCover || !win) return;\\n  liveCover = new View();\\n  liveCover.setBackgroundColor('#15151a');\\n  win.contentView.addChildView(liveCover, 0);\\n  const { width, height } = win.getContentBounds();\\n  liveCover.setBounds({ x: 0, y: 0, width, height });\\n}\\n// ---------- Kick leve ----------\\n// A Kick só conta pontos com o player tocando numa página visível, então não dá para tirar o vídeo.\\n// Mas dá para cortar o resto: imagens (miniaturas, avatares, emotes), fontes, rastreadores/anúncios,\\n// animações, e deixar o vídeo minúsculo (o player tende a escolher a menor qualidade).\\nlet kickLeve = true;\\nconst kickViewIds = new Set();\\nconst KICK_LEVE_CSS = `\\n  *, *::before, *::after { animation: none !important; transition: none !important; }\\n  video { width: 192px !important; height: 108px !important; max-width: 192px !important; object-fit: contain; }\\n  img { visibility: hidden !important; }\\n`;\\nconst KICK_BLOQUEIO = /doubleclick|googlesyndication|google-analytics|googletagmanager|datadoghq|sentry\\\\.io|amplitude|hotjar|facebook\\\\.net|clarity\\\\.ms|onetrust|cookielaw/i;\\nfunction watchKickRequests(i) {\\n  const ses = session.fromPartition(`persist:conta${i + 1}`);\\n  try {\\n    ses.webRequest.onBeforeRequest({ urls: ['*://*/*'] }, (d, cb) => {\\n      if (kickLeve && kickViewIds.has(d.webContentsId) &&\\n          (d.resourceType === 'image' || d.resourceType === 'font' || KICK_BLOQUEIO.test(d.url))) return cb({ cancel: true });\\n      cb({});\\n    });\\n  } catch {}\\n}\\n// Player da Kick: \\\"auto\\\" (padrão) = player pequeno (player.kick.com, só o vídeo). Se numa conta os pontos\\n// não subirem em 15 min, aquela conta volta sozinha para a página inteira. \\\"completa\\\" = sempre a página inteira.\\nlet kickPlayer = 'auto';\\nconst kickCompleta = ACCOUNTS.map(() => false); // conta em que o player pequeno não contou pontos\\nconst kickUrl = (i, c) => (kickPlayer === 'completa' || kickCompleta[i]\\n  ? `https://kick.com/${c}` : `https://player.kick.com/${c}?autoplay=true&muted=false`);\\nfunction setKickPlayer(m) {\\n  kickPlayer = m;\\n  kickCompleta.fill(false);\\n  saveLives();\\n  buildMenu();\\n  ACCOUNTS.forEach((_, i) => { for (const sl of liveOpen[i].kick.values()) closeLive(sl); liveOpen[i].kick.clear(); });\\n  syncLives();\\n}\\nfunction setKickLeve(on) {\\n  kickLeve = !!on;\\n  saveLives();\\n  buildMenu();\\n  // recarrega as lives da Kick para aplicar\\n  ACCOUNTS.forEach((_, i) => { for (const sl of liveOpen[i].kick.values()) { try { if (sl.view) sl.view.webContents.reload(); } catch {} } });\\n}\\n\\nfunction closeLive(slot) {\\n  if (slot.timer) clearTimeout(slot.timer);\\n  const v = slot.view;\\n  if (v && slotAttached.has(v)) { try { win.contentView.removeChildView(v); } catch {} slotAttached.delete(v); }\\n  try { if (v && !v.webContents.isDestroyed()) v.webContents.close(); } catch {}\\n}\\n\\n// abre/fecha as lives de cada conta conforme quem está ao vivo, o que está ligado e os limites\\nfunction syncLives() {\\n  ACCOUNTS.forEach((_, i) => {\\n    for (const plat of Object.keys(LIVE_CHANNELS)) {\\n      const open = liveOpen[i][plat];\\n      let want = [];\\n      if (lives[plat][i] && !sono.ausente) {\\n        const aoVivo = LIVE_CHANNELS[plat].filter((c) => liveNow[plat].has(c));\\n        if (plat === 'kick' && kickSel[i].length) {\\n          // você escolheu os canais: abre só eles (quando estiverem ao vivo)\\n          want = kickSel[i].filter((c) => liveNow.kick.has(c)).slice(0, LIVE_MAX.kick);\\n        } else if (plat === 'kick') {\\n          // mantém as que já estão abertas (reabrir zera o tempo assistido) e completa com os canais\\n          // que já têm mais pontos: concentrar num canal chega antes nos 300/500/1.000 de cada bônus\\n          const pts = (c) => (kickPts[i][c] && kickPts[i][c].pts) || 0;\\n          const ganho = (c) => (kickPts[i][c] && kickPts[i][c].pts != null ? kickPts[i][c].pts - kickPts[i][c].base : 0);\\n          const abertas = aoVivo.filter((c) => open.has(c)).sort((a, b) => ganho(b) - ganho(a)); // as que estão rendendo primeiro\\n          const resto = aoVivo.filter((c) => !open.has(c)).sort((a, b) => pts(b) - pts(a));\\n          want = [...abertas, ...resto].slice(0, LIVE_MAX.kick);\\n        } else {\\n          want = aoVivo.slice(0, LIVE_MAX[plat]);\\n        }\\n      }\\n      for (const [c, v] of open) {\\n        if (want.includes(c)) { v.miss = 0; continue; }\\n        // Fecha NA HORA quando foi você que tirou (plataforma desligada, canal desativado, fora do limite).\\n        // Só espera 2 verificações quando o motivo é o canal ter aparecido offline (pode ser falha momentânea\\n        // da Kick/Twitch, e reabrir zeraria o tempo assistido).\\n        const tiradoPorVoce = !lives[plat][i] ||\\n          (plat === 'kick' && kickSel[i].length && !kickSel[i].includes(c)) ||\\n          liveNow[plat].has(c);\\n        v.miss = (v.miss || 0) + 1;\\n        if (tiradoPorVoce || v.miss >= 2) { closeLive(v); open.delete(c); }\\n      }\\n      if (plat === 'twitch') {\\n        // o modo desta conta mudou (ex.: conexão direta não contou): fecha e reabre no modo novo\\n        const m = modoTw(i);\\n        if (modoTwAtual[i] && modoTwAtual[i] !== m) reabrirTwitch(i);\\n        modoTwAtual[i] = m;\\n      }\\n      if (plat === 'twitch' && modoTw(i) === 'irc') {\\n        // modo conexão direta: nenhuma página por canal, só uma conexão de chat por conta\\n        for (const c of want) if (!open.has(c)) open.set(c, { view: null, timer: null, openedAt: Date.now(), miss: 0 });\\n        if (open.size && !ircDesde[i]) ircDesde[i] = Date.now();\\n        if (!open.size) ircDesde[i] = 0;\\n        ensureIrc(i, [...open.keys()]);\\n      } else {\\n        for (const c of want) if (!open.has(c)) open.set(c, scheduleLive(i, plat, c));\\n      }\\n    }\\n  });\\n  sendState();\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('lives-update'); // painel das lives\\n}\\n\\nfunction livesState() {\\n  return {\\n    twitch: lives.twitch,\\n    kick: lives.kick,\\n    open: liveOpen.map((o) => ({ twitch: [...o.twitch.keys()], kick: [...o.kick.keys()] })),\\n    checked: liveLastCheck > 0,\\n  };\\n}\\n\\n// liga/desliga Twitch ou Kick de uma conta; só liga se a conta estiver logada naquela plataforma\\nasync function setLivesOn(i, plat, on) {\\n  if (!PLAT[plat]) return;\\n  if (on && !(await isLogged(i, plat))) {\\n    sendState(); buildMenu(); // mantém o botão e o menu desligados\\n    const nm = PLAT[plat].name;\\n    const r = await uiDialog({\\n      type: 'warning',\\n      title: nm,\\n      message: `${nameOf(i)} não está conectada na ${nm}.`,\\n      detail: `Para ${plat === 'twitch' ? 'o bônus' : 'os pontos'} contar${plat === 'twitch' ? '' : 'em'}, as lives precisam abrir com a conta da ${nm} vinculada a esta conta do jogo.\\\\n\\\\n` +\\n        `Entre na ${nm} e o botão liga sozinho quando você fechar a janela de login.`,\\n      buttons: plat === 'kick' ? ['Importar login do navegador', `Entrar na ${nm}`, 'Cancelar'] : [`Entrar na ${nm}`, 'Cancelar'],\\n      defaultId: 0,\\n      cancelId: plat === 'kick' ? 2 : 1,\\n    });\\n    if (plat === 'kick') {\\n      // o login direto na Kick costuma ser recusado pela proteção anti-robô dela; importar do navegador funciona\\n      if (r.response === 0) importKickLogin(i);\\n      if (r.response === 1) openLiveLogin(i, plat, true);\\n    } else if (r.response === 0) openLiveLogin(i, plat, true);\\n    return;\\n  }\\n  lives[plat][i] = !!on;\\n  saveLives();\\n  buildMenu();\\n  if (on) checkLives(); else syncLives();\\n  // avisa o painel de pontos da Kick (o liga/desliga também fica lá)\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('kick-update');\\n  if (kickWin && !kickWin.isDestroyed()) kickWin.webContents.send('kick-update');\\n}\\nipcMain.on('lives-set', (_, i, plat, on) => {\\n  if (!Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return;\\n  if (typeof plat === 'boolean') { on = plat; plat = 'twitch'; } // compatível com a barra antiga\\n  setLivesOn(i, plat, !!on);\\n});\\n\\n// janela para entrar na Twitch/Kick com a sessão daquela conta\\nfunction openLiveLogin(i, plat, enableAfter) {\\n  const w = new BrowserWindow({\\n    width: 560, height: 780, title: `${PLAT[plat].name} — ${nameOf(i)}`,\\n    backgroundColor: '#24101a', autoHideMenuBar: true,\\n    ...(customIconPath() ? { icon: customIconPath() } : {}),\\n    webPreferences: { partition: `persist:conta${i + 1}` },\\n  });\\n  w.setMenu(null);\\n  // janelinhas que o login abre (captcha, \\\"entrar com...\\\"): abrem de verdade, na mesma sessão, como num navegador\\n  w.webContents.setWindowOpenHandler(() => ({\\n    action: 'allow',\\n    overrideBrowserWindowOptions: { width: 520, height: 700, autoHideMenuBar: true, backgroundColor: '#ffffff', webPreferences: { partition: `persist:conta${i + 1}` } },\\n  }));\\n  w.loadURL(PLAT[plat].login, { userAgent: LIVE_UA });\\n  // Twitch: quando o login termina, fecha a janela sozinha\\n  const ses = accountSession(i);\\n  const onCookie = (_, cookie, cause, removed) => {\\n    if (plat === 'twitch' && !removed && cookie.name === 'auth-token' && /twitch\\\\.tv$/.test(cookie.domain)) {\\n      setTimeout(() => { if (!w.isDestroyed()) w.close(); }, 1500);\\n    }\\n  };\\n  ses.cookies.on('changed', onCookie);\\n  // ao fechar, recarrega as lives abertas dessa conta para já contarem com o login\\n  w.on('closed', async () => {\\n    ses.cookies.removeListener('changed', onCookie);\\n    for (const slot of liveOpen[i][plat].values()) { try { if (slot.view) slot.view.webContents.reload(); } catch {} }\\n    if (enableAfter) {\\n      if (await isLogged(i, plat)) setLivesOn(i, plat, true);\\n      else uiDialog({ type: 'info', title: PLAT[plat].name, message: `O login na ${PLAT[plat].name} não foi concluído.`, detail: 'As lives desta conta continuam desligadas.' });\\n    }\\n  });\\n}\\n\\nfunction livesOverview() {\\n  return {\\n    contas: ACCOUNTS.map((_, i) => ({\\n      i, name: nameOf(i),\\n      plats: Object.keys(LIVE_CHANNELS).map((p) => ({ p, name: PLAT[p].name, on: !!lives[p][i], open: [...liveOpen[i][p].keys()],\\n        contando: p === 'twitch' && jogoInfo[i] && jogoInfo[i].twitch ? jogoInfo[i].twitch.contando : null })),\\n    })),\\n    aoVivo: Object.keys(LIVE_CHANNELS).map((p) => ({ p, name: PLAT[p].name, list: [...liveNow[p]] })),\\n    quando: liveLastCheck ? new Date(liveLastCheck).toLocaleTimeString('pt-BR') : '',\\n    erros: liveErrors,\\n    kickInfo: fonteLives || kickCheckInfo,\\n    canais: listaCanais(),\\n    listaInfo,\\n  };\\n}\\nipcMain.handle('lives-get', () => livesOverview());\\nipcMain.handle('lives-check-now', async () => { await checkLives(); return livesOverview(); });\\n\\n// painel \\\"Lives\\\" no estilo do painel da Kick (desenhado pela barra de título)\\nasync function showLives() {\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (canDraw) {\\n    const id = ++cfgPanelSeq;\\n    cfgPanels.add(id);\\n    dialogOpen = true;\\n    layout();\\n    titleBar.webContents.focus();\\n    titleBar.webContents.send('title-lives', { id });\\n    return;\\n  }\\n  const o = livesOverview();\\n  const r = await uiDialog({\\n    type: 'info',\\n    title: 'Lives',\\n    message: 'Lives abertas em segundo plano',\\n    detail: 'Clique num canal aberto para ver a live com a sua conta.',\\n    lives: o,\\n    buttons: ['Fechar', 'Verificar agora'],\\n    defaultId: 0,\\n    cancelId: 0,\\n  });\\n  if (r.response === 1) { await checkLives(); showLives(); }\\n}\\n\\n// abre a live numa janela visível, com a sessão da conta (para conferir os pontos da Kick, por exemplo)\\nconst livePageWins = new Map();\\nfunction openLivePage(i, plat, c) {\\n  if (!PLAT[plat] || !Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return;\\n  const key = `${i}|${plat}|${c}`;\\n  const old = livePageWins.get(key);\\n  if (old && !old.isDestroyed()) { old.focus(); return; }\\n  const w = new BrowserWindow({\\n    width: 1200, height: 820, title: `${PLAT[plat].name} — ${c} — ${nameOf(i)}`,\\n    backgroundColor: '#0b0b0e', autoHideMenuBar: true,\\n    ...(customIconPath() ? { icon: customIconPath() } : {}),\\n    webPreferences: { partition: `persist:conta${i + 1}` },\\n  });\\n  w.setMenu(null);\\n  w.webContents.setAudioMuted(true); // a live escondida já está tocando; esta só serve para olhar\\n  w.on('page-title-updated', (e) => e.preventDefault());\\n  w.webContents.setWindowOpenHandler(({ url }) => { if (/^https?:/i.test(url)) shell.openExternal(url); return { action: 'deny' }; });\\n  w.loadURL(PLAT[plat].url(c), { userAgent: LIVE_UA });\\n  w.on('closed', () => livePageWins.delete(key));\\n  livePageWins.set(key, w);\\n}\\nipcMain.on('live-page-open', (_, i, plat, c) => openLivePage(i, plat, String(c)));\\n\\n// ---------- Extensões do Chrome dentro do PokeLink ----------\\n// O PokeLink baixa cada extensão da Chrome Web Store no PC do usuário (não vem dentro do PokeLink),\\n// guarda em %APPDATA%\\\\pokeidle-multi\\\\extensoes\\\\<id> e carrega nas 4 contas. Atualizam sozinhas.\\n// Para adicionar outra, basta incluir aqui o id dela (o código no fim do link da Chrome Web Store).\\nconst EXTENSIONS = [\\n  { id: 'mhnplloljgchpfpcpbhmcokmnefodjnh', nome: '/hunt for PokeIdle', autor: 'Liang',\\n    sobre: 'Mostra, acima do pokémon em campo, as melhores hunts por XP/h e ouro/h. Clique na barra /hunt dentro do jogo.' },\\n  { id: 'olccbpdjdkbfgondiiaicmlifhbcggmk', nome: 'Rotom Sniper', autor: '', botao: 'Sniper',\\n    sobre: 'Cockpit Auto-Sniper: regras de compra no mercado da comunidade, radar de pokémon, estatísticas de farm.' },\\n];\\nconst extUrl = (id) => 'https://clients2.google.com/service/update2/crx?response=redirect' +\\n  `&prodversion=${process.versions.chrome}&acceptformat=crx2,crx3&x=id%3D${id}%26uc`;\\nconst extRoot = (id) => path.join(app.getPath('userData'), 'extensoes', id);\\nconst extState = Object.fromEntries(EXTENSIONS.map((e) => [e.id, { version: null, error: null, name: null }]));\\n\\n// .crx = cabeçalho do Chrome + um .zip\\nfunction crxToZip(buf) {\\n  if (buf.toString('ascii', 0, 4) !== 'Cr24') throw new Error('o arquivo baixado não é uma extensão');\\n  const v = buf.readUInt32LE(4);\\n  if (v === 3) return buf.subarray(12 + buf.readUInt32LE(8));\\n  if (v === 2) return buf.subarray(16 + buf.readUInt32LE(8) + buf.readUInt32LE(12));\\n  throw new Error('formato de extensão desconhecido');\\n}\\n// descompacta um .zip (sem bibliotecas extras)\\nfunction unzipTo(zip, dir) {\\n  const zlib = require('zlib');\\n  let eocd = -1;\\n  for (let p = zip.length - 22; p >= Math.max(0, zip.length - 65557); p--) {\\n    if (zip.readUInt32LE(p) === 0x06054b50) { eocd = p; break; }\\n  }\\n  if (eocd < 0) throw new Error('zip inválido');\\n  const count = zip.readUInt16LE(eocd + 10);\\n  let p = zip.readUInt32LE(eocd + 16);\\n  const base = path.resolve(dir);\\n  for (let n = 0; n < count; n++) {\\n    if (zip.readUInt32LE(p) !== 0x02014b50) throw new Error('zip inválido');\\n    const method = zip.readUInt16LE(p + 10);\\n    const csize = zip.readUInt32LE(p + 20);\\n    const nlen = zip.readUInt16LE(p + 28), xlen = zip.readUInt16LE(p + 30), clen = zip.readUInt16LE(p + 32);\\n    const local = zip.readUInt32LE(p + 42);\\n    const name = zip.toString('utf8', p + 46, p + 46 + nlen);\\n    p += 46 + nlen + xlen + clen;\\n    const dest = path.resolve(base, name);\\n    if (!dest.startsWith(base + path.sep)) continue; // nunca escreve fora da pasta\\n    if (name.endsWith('/')) { fs.mkdirSync(dest, { recursive: true }); continue; }\\n    const start = local + 30 + zip.readUInt16LE(local + 26) + zip.readUInt16LE(local + 28);\\n    const data = zip.subarray(start, start + csize);\\n    fs.mkdirSync(path.dirname(dest), { recursive: true });\\n    fs.writeFileSync(dest, method === 0 ? data : zlib.inflateRawSync(data));\\n  }\\n}\\nfunction localExt(id) {\\n  try {\\n    const vs = fs.readdirSync(extRoot(id)).filter((v) => fs.existsSync(path.join(extRoot(id), v, 'manifest.json')) && /^\\\\d/.test(v));\\n    vs.sort((a, b) => compareVersions(b, a));\\n    return vs.length ? { id, version: vs[0], dir: path.join(extRoot(id), vs[0]) } : null;\\n  } catch { return null; }\\n}\\nasync function downloadExt(id) {\\n  const r = await withTimeout(session.fromPartition('persist:lives-check').fetch(extUrl(id)), 30000);\\n  if (!r.ok) throw new Error('Chrome Web Store respondeu ' + r.status);\\n  const buf = Buffer.from(await r.arrayBuffer());\\n  const tmp = path.join(extRoot(id), '_baixando');\\n  fs.rmSync(tmp, { recursive: true, force: true });\\n  unzipTo(crxToZip(buf), tmp);\\n  const version = JSON.parse(fs.readFileSync(path.join(tmp, 'manifest.json'), 'utf8')).version;\\n  const dir = path.join(extRoot(id), version);\\n  if (fs.existsSync(path.join(dir, 'manifest.json'))) fs.rmSync(tmp, { recursive: true, force: true });\\n  else { fs.rmSync(dir, { recursive: true, force: true }); fs.renameSync(tmp, dir); }\\n  for (const v of fs.readdirSync(extRoot(id))) if (v !== version) fs.rmSync(path.join(extRoot(id), v), { recursive: true, force: true });\\n  return { id, version, dir };\\n}\\nasync function loadExtInto(ext) {\\n  const st = extState[ext.id];\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    const api = (() => { const ses = session.fromPartition(`persist:conta${i + 1}`); return ses.extensions || ses; })();\\n    try {\\n      // tira versões antigas desta mesma extensão (mesma pasta-base)\\n      for (const e of api.getAllExtensions()) if (e.path !== ext.dir && e.path && e.path.startsWith(extRoot(ext.id))) api.removeExtension(e.id);\\n      if (!api.getAllExtensions().some((e) => e.path === ext.dir)) {\\n        const loaded = await api.loadExtension(ext.dir, { allowFileAccess: false });\\n        if (loaded && loaded.name) st.name = loaded.name;\\n      }\\n      extErroConta[ext.id][i] = null;\\n    } catch (e) { st.error = `conta ${i + 1}: ${e.message}`; extErroConta[ext.id][i] = e.message; }\\n  }\\n  st.version = ext.version;\\n}\\n// carrega as cópias locais (antes das contas abrirem); devolve quais extensões ainda não tinham cópia\\n// extensões desligadas pelo usuário (Ajuda > Extensões)\\nconst extCfgFile = () => path.join(app.getPath('userData'), 'extensoes.json');\\nconst extOff = new Set();\\ntry { (JSON.parse(fs.readFileSync(extCfgFile(), 'utf8')).desligadas || []).forEach((id) => extOff.add(id)); } catch {}\\nconst saveExtCfg = () => { try { fs.writeFileSync(extCfgFile(), JSON.stringify({ desligadas: [...extOff] })); } catch {} };\\nconst extBusy = new Map(); // id -> 'atualizando' | 'reinstalando' | ...\\n\\nasync function loadLocalExtensions() {\\n  const faltando = [];\\n  for (const e of EXTENSIONS) {\\n    if (extOff.has(e.id)) continue;\\n    const loc = localExt(e.id);\\n    if (loc) await loadExtInto(loc); else faltando.push(e.id);\\n  }\\n  return faltando;\\n}\\n// em segundo plano: baixa as que faltam (e recarrega as contas) e atualiza as outras para o próximo início\\nasync function updateExtensions(faltando) {\\n  let novas = false;\\n  for (const e of EXTENSIONS) {\\n    if (extOff.has(e.id)) continue;\\n    try {\\n      const ext = await downloadExt(e.id);\\n      extState[e.id].error = null;\\n      if (faltando.includes(e.id)) { await loadExtInto(ext); novas = true; }\\n    } catch (err) { extState[e.id].error = err.message; }\\n  }\\n  if (novas) views.forEach((_, i) => reloadAccount(i)); // 1ª vez: recarrega para as extensões aparecerem\\n}\\n// No Chrome, a extensão abre pelo botão dela na barra do navegador (uma janelinha). O PokeLink não tem essa\\n// barra, então abre a mesma página da extensão numa janela própria, com a sessão (login) daquela conta.\\nconst extWins = new Map();\\nfunction openExtPage(i, id) {\\n  const def = EXTENSIONS.find((e) => e.id === id);\\n  if (!def || !Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return;\\n  const key = `${i}|${id}`;\\n  const old = extWins.get(key);\\n  if (old && !old.isDestroyed()) { old.show(); old.focus(); return; }\\n  const ses = session.fromPartition(`persist:conta${i + 1}`);\\n  const api = ses.extensions || ses;\\n  const loc = localExt(id);\\n  const ext = loc && api.getAllExtensions().find((e) => e.path === loc.dir);\\n  if (!ext) {\\n    uiDialog({ type: 'warning', title: def.nome, message: `${def.nome} ainda não está instalada.`, detail: 'Ela é baixada sozinha ao abrir o PokeLink. Confira em Ajuda → Extensões.' });\\n    return;\\n  }\\n  const m = ext.manifest || {};\\n  let page = (m.action && m.action.default_popup) || (m.browser_action && m.browser_action.default_popup) ||\\n    (m.side_panel && m.side_panel.default_path) || m.options_page || (m.options_ui && m.options_ui.page);\\n  let grande = false;\\n  if (!page) {\\n    // Sem janelinha: no Chrome, o clique no ícone faz a extensão abrir uma página própria (ex.: o \\\"Cockpit\\\").\\n    // Procura essa página: primeiro as citadas no código de fundo da extensão, depois pelo nome do arquivo.\\n    try {\\n      const norm = (f) => String(f).replace(/\\\\\\\\/g, '/').replace(/^\\\\//, '');\\n      const htmls = fs.readdirSync(loc.dir, { recursive: true }).map(norm).filter((f) => /\\\\.html?$/i.test(f));\\n      const bg = m.background && (m.background.service_worker || (m.background.scripts || [])[0]);\\n      let citadas = [];\\n      if (bg) {\\n        const code = fs.readFileSync(path.join(loc.dir, bg), 'utf8');\\n        citadas = [...code.matchAll(/['\\\"`]\\\\/?([\\\\w\\\\-/.]+\\\\.html?)/g)].map((x) => norm(x[1]));\\n      }\\n      page = citadas.find((c) => htmls.includes(c)) ||\\n        htmls.find((f) => /cockpit|dashboard|painel|panel|sniper|app|index|main/i.test(f)) || htmls[0];\\n      grande = !!page;\\n    } catch {}\\n  }\\n  if (!page) {\\n    uiDialog({ type: 'info', title: def.nome, message: `${def.nome} funciona direto dentro do jogo.`, detail: 'Ela não tem uma janela própria: os recursos dela aparecem na página do jogo.' });\\n    return;\\n  }\\n  const w = new BrowserWindow({\\n    width: grande ? 1180 : 460, height: grande ? 800 : 700, minWidth: 320, minHeight: 400, title: `${def.botao || def.nome} — ${nameOf(i)}`,\\n    backgroundColor: '#24101a', autoHideMenuBar: true,\\n    ...(customIconPath() ? { icon: customIconPath() } : {}),\\n    webPreferences: { session: ses },\\n  });\\n  w.setMenu(null);\\n  w.on('page-title-updated', (e) => e.preventDefault());\\n  w.webContents.setWindowOpenHandler(({ url }) => { if (/^https?:/i.test(url)) shell.openExternal(url); return { action: 'deny' }; });\\n  w.loadURL(`chrome-extension://${ext.id}/${String(page).replace(/^\\\\//, '')}`).catch(() => {});\\n  w.on('closed', () => extWins.delete(key));\\n  extWins.set(key, w);\\n}\\nipcMain.on('ext-open', (_, i, id) => openExtPage(i, String(id)));\\n\\n// tira a extensão das 4 contas (sem apagar os arquivos)\\nfunction unloadExt(id) {\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    const ses = session.fromPartition(`persist:conta${i + 1}`);\\n    const api = ses.extensions || ses;\\n    try { for (const e of api.getAllExtensions()) if (e.path && e.path.startsWith(extRoot(id))) api.removeExtension(e.id); } catch {}\\n  }\\n  extState[id].version = null;\\n}\\nconst reloadAllAccounts = () => views.forEach((_, i) => reloadAccount(i));\\n\\n// ligar / desligar / atualizar / reinstalar uma extensão\\n// erro de carregamento por conta (para saber em qual conta a extensão não entrou)\\nconst extErroConta = Object.fromEntries(EXTENSIONS.map((e) => [e.id, ACCOUNTS.map(() => null)]));\\nconst extApi = (i) => { const ses = session.fromPartition(`persist:conta${i + 1}`); return ses.extensions || ses; };\\nfunction extNaConta(id, i) {\\n  try { return extApi(i).getAllExtensions().some((e) => e.path && e.path.startsWith(extRoot(id))); } catch { return false; }\\n}\\n// Reparar numa conta: tira a extensão só daquela conta, apaga os dados que ela guardou ali (configurações\\n// que podem ter estragado) e coloca de novo. O login do jogo e as outras contas não mudam.\\nasync function repararExt(id, i) {\\n  const api = extApi(i);\\n  for (const e of api.getAllExtensions()) if (e.path && e.path.startsWith(extRoot(id))) { try { api.removeExtension(e.id); } catch {} }\\n  const ses = session.fromPartition(`persist:conta${i + 1}`);\\n  const base = (typeof ses.getStoragePath === 'function' && ses.getStoragePath()) || path.join(app.getPath('userData'), 'Partitions', `conta${i + 1}`);\\n  for (const pasta of ['Local Extension Settings', 'Sync Extension Settings', 'Managed Extension Settings']) {\\n    try { fs.rmSync(path.join(base, pasta, id), { recursive: true, force: true }); } catch {}\\n  }\\n  try { await ses.clearStorageData({ origin: `chrome-extension://${id}` }); } catch {}\\n  let ext = localExt(id);\\n  if (!ext) ext = await downloadExt(id);\\n  await api.loadExtension(ext.dir, { allowFileAccess: false });\\n  extErroConta[id][i] = null;\\n  reloadAccount(i);\\n}\\nasync function extAction(id, acao) {\\n  if (!extState[id] || extBusy.has(id)) return;\\n  const rep = /^reparar:(\\\\d)$/.exec(acao);\\n  if (rep) {\\n    const i = Number(rep[1]);\\n    if (!(i >= 0 && i < ACCOUNTS.length)) return;\\n    extBusy.set(id, `reparando na conta ${i + 1}`);\\n    notifyExts();\\n    try { await repararExt(id, i); extState[id].error = null; }\\n    catch (e) { extState[id].error = `conta ${i + 1}: ${e.message}`; extErroConta[id][i] = e.message; }\\n    finally { extBusy.delete(id); sendState(); notifyExts(); }\\n    return;\\n  }\\n  extBusy.set(id, { on: 'ativando', off: 'desativando', update: 'atualizando', reinstall: 'reinstalando' }[acao] || acao);\\n  notifyExts();\\n  try {\\n    if (acao === 'off') {\\n      extOff.add(id); saveExtCfg();\\n      unloadExt(id);\\n      reloadAllAccounts();\\n    } else if (acao === 'on') {\\n      extOff.delete(id); saveExtCfg();\\n      let ext = localExt(id);\\n      if (!ext) ext = await downloadExt(id);\\n      await loadExtInto(ext);\\n      reloadAllAccounts();\\n    } else if (acao === 'update' || acao === 'reinstall') {\\n      unloadExt(id);\\n      if (acao === 'reinstall') fs.rmSync(extRoot(id), { recursive: true, force: true }); // apaga a cópia local\\n      const ext = await downloadExt(id);\\n      extOff.delete(id); saveExtCfg();\\n      await loadExtInto(ext);\\n      reloadAllAccounts();\\n    }\\n    extState[id].error = null;\\n  } catch (e) {\\n    extState[id].error = e.message;\\n    // se a reinstalação falhou no download, tenta voltar a cópia que tiver\\n    const loc = !extOff.has(id) && localExt(id);\\n    if (loc) { try { await loadExtInto(loc); } catch {} }\\n  } finally {\\n    extBusy.delete(id);\\n    sendState(); // atualiza o botão Sniper na barra\\n    notifyExts();\\n  }\\n}\\nfunction extOverview() {\\n  return EXTENSIONS.map((e) => ({\\n    id: e.id, nome: extState[e.id].name || e.nome, autor: e.autor, sobre: e.sobre,\\n    on: !extOff.has(e.id), version: extState[e.id].version || (localExt(e.id) || {}).version || null, error: extState[e.id].error, busy: extBusy.get(e.id) || null,\\n    contas: ACCOUNTS.map((_, i) => ({ nome: nameOf(i), ok: extNaConta(e.id, i), erro: extErroConta[e.id][i] })),\\n  }));\\n}\\nfunction notifyExts() { if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('exts-update'); }\\nipcMain.handle('ext-get', () => extOverview());\\nipcMain.on('ext-action', (_, id, acao) => { extAction(String(id), String(acao)); });\\n\\nfunction showExtensions() {\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (canDraw) {\\n    const id = ++cfgPanelSeq;\\n    cfgPanels.add(id);\\n    dialogOpen = true;\\n    layout();\\n    titleBar.webContents.focus();\\n    titleBar.webContents.send('title-exts', { id });\\n    return;\\n  }\\n  showExtensionsDialog();\\n}\\nfunction showExtensionsDialog() {\\n  const linhas = EXTENSIONS.map((e) => {\\n    const st = extState[e.id];\\n    return `${st.version ? '✓' : '✗'} ${st.name || e.nome}${st.version ? ' ' + st.version : ' (ainda não instalada)'}` +\\n      (e.autor ? ` · por ${e.autor}` : '') + `\\\\n   ${e.sobre}` + (st.error ? `\\\\n   Último erro: ${st.error}` : '');\\n  });\\n  uiDialog({\\n    type: EXTENSIONS.every((e) => extState[e.id].version) ? 'info' : 'warning',\\n    title: 'Extensões',\\n    message: 'Extensões ativas nas 4 contas',\\n    detail: linhas.join('\\\\n\\\\n') + '\\\\n\\\\nBaixadas da Chrome Web Store e atualizadas automaticamente.',\\n  });\\n}\\n\\n// ---------- PvP: captura dos dados do tracker (1º passo da análise de duelos) ----------\\n// Abre o tracker do jogo (pokeidle.io/tracker/j/<nick>) escondido, com a sessão da conta, e salva\\n// tudo o que a página recebe (respostas JSON) + o texto da página num arquivo na Área de Trabalho.\\n// Com esse arquivo dá para montar a leitura dos duelos e o painel de análise.\\nasync function captureTracker(i) {\\n  const nick = nameOf(i);\\n  if (/^Conta \\\\d$/.test(nick)) {\\n    uiDialog({ type: 'warning', title: 'PvP', message: 'Ainda não sei o nick desta conta.', detail: 'Espere a conta carregar o jogo e tente de novo.' });\\n    return;\\n  }\\n  const url = `https://pokeidle.io/tracker/j/${encodeURIComponent(nick.toLowerCase())}`;\\n  // avisa na hora que começou (antes não aparecia nada até terminar)\\n  const aviso = uiDialog({\\n    type: 'info', title: 'PvP', message: `Gerando o relatório do PvP de ${nick}...`,\\n    detail: 'Leva uns 15 segundos. Um novo aviso aparece quando o arquivo estiver pronto.',\\n  });\\n  // Página escondida numa sessão própria (o tracker é público). Usar a sessão da conta podia\\n  // conflitar com o jogo aberto e a janela era fechada no meio (\\\"Object has been destroyed\\\").\\n  const v = new WebContentsView({ webPreferences: { partition: 'persist:tracker', backgroundThrottling: false } });\\n  const wc = v.webContents;\\n  v.setBounds({ x: 0, y: 0, width: 1400, height: 1000 });\\n  const log = [];\\n  const nota = (t) => log.push(`${new Date().toISOString().slice(11, 19)} ${t}`);\\n  wc.on('did-start-loading', () => nota('carregando'));\\n  wc.on('did-finish-load', () => nota('carregou'));\\n  wc.on('did-fail-load', (_, code, desc, u) => nota(`falhou ${code} ${desc} ${u}`));\\n  wc.on('did-navigate', (_, u) => nota('navegou ' + u));\\n  wc.on('render-process-gone', (_, d) => nota('página caiu: ' + d.reason));\\n  wc.on('destroyed', () => nota('página destruída'));\\n  wc.on('console-message', (...args) => { const m = args[0] && args[0].message ? args[0].message : args[2]; if (m) nota('console: ' + String(m).slice(0, 200)); });\\n  wc.setWindowOpenHandler(({ url: u }) => { nota('tentou abrir ' + u); return { action: 'deny' }; });\\n  const alive = () => !wc.isDestroyed();\\n  const dbg = wc.debugger;\\n  const reqs = new Map();\\n  const respostas = [];\\n  try {\\n    dbg.attach('1.3');\\n    await withTimeout(dbg.sendCommand('Network.enable'), 3000);\\n    dbg.on('message', async (_, method, p) => {\\n      if (method === 'Network.responseReceived' && /json|text\\\\/plain/i.test(p.response.mimeType || '')) reqs.set(p.requestId, p.response.url);\\n      if (method === 'Network.loadingFinished' && reqs.has(p.requestId) && alive()) {\\n        try {\\n          const b = await dbg.sendCommand('Network.getResponseBody', { requestId: p.requestId });\\n          respostas.push({ url: reqs.get(p.requestId), body: b.base64Encoded ? Buffer.from(b.body, 'base64').toString('utf8') : b.body });\\n        } catch {}\\n      }\\n    });\\n  } catch (e) { nota('sem captura de rede: ' + e.message); }\\n  const espera = (ms) => new Promise((r) => setTimeout(r, ms));\\n  // cada leitura tem limite de tempo: com a página ainda carregando, o executeJavaScript podia ficar esperando para sempre\\n  const ler = () => (alive() ? withTimeout(wc.executeJavaScript('document.body ? document.body.innerText : \\\"\\\"'), 2500).catch(() => '') : Promise.resolve(''));\\n  let texto = '', turno = '';\\n  try {\\n    wc.loadURL(url).catch((e) => nota('loadURL: ' + e.message)); // não espera o \\\"fim do carregamento\\\"\\n    for (let k = 0; k < 10; k++) { await espera(1000); const t = await ler(); if (t) texto = t; } // guarda o que tiver a cada segundo\\n    nota(texto ? `texto lido (${texto.length} letras)` : 'texto vazio');\\n    if (alive()) {\\n      await withTimeout(wc.executeJavaScript(`(() => {\\n        const b = [...document.querySelectorAll('button,a,[role=button]')].find((e) => /turno a turno/i.test(e.textContent || ''));\\n        if (b) b.click(); return !!b;\\n      })()`), 3000).then((ok) => nota(ok ? 'abriu turno a turno' : 'botão turno a turno não encontrado')).catch(() => {});\\n      await espera(4000);\\n      turno = await ler();\\n    }\\n  } catch (e) {\\n    nota('erro: ' + e.message);\\n  } finally {\\n    try { dbg.detach(); } catch {}\\n    try { if (alive()) wc.close(); } catch {}\\n  }\\n  // salva na Área de Trabalho; se não der, na pasta Downloads; e sempre uma cópia na pasta de dados do app\\n  const nome = `pvp-tracker-${nick}.json`;\\n  const dados = JSON.stringify({ versao: APP_VERSION, nick, url, data: new Date().toISOString(), log, respostas, texto, turno }, null, 1);\\n  let f = null;\\n  for (const dir of ['desktop', 'downloads', 'userData']) {\\n    try { const p = path.join(app.getPath(dir), nome); fs.writeFileSync(p, dados, 'utf8'); f = p; break; } catch {}\\n  }\\n  uiDialogClose(aviso); // fecha o \\\"gerando...\\\" e mostra o resultado\\n  if (!f) { showError('PvP', 'Não consegui salvar o relatório em nenhuma pasta.'); return; }\\n  const r = await uiDialog({\\n    type: 'info', title: 'PvP', message: 'Relatório do PvP pronto.',\\n    detail: `Arquivo: ${f}\\\\n\\\\n${respostas.length} resposta(s) do tracker capturadas` +\\n      (texto ? '' : ' (a página do tracker não carregou o texto)') + '. Envie esse arquivo para montar a análise dos duelos.',\\n    buttons: ['Mostrar o arquivo', 'OK'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (r.response === 0) shell.showItemInFolder(f);\\n}\\n\\n// ---------- PvP: histórico e análise dos duelos (dados do tracker do jogo) ----------\\n// O tracker (pokeidle.io/tracker/j/<nick>) mostra só as últimas 20 partidas. O PokeLink lê o tracker\\n// de cada conta de tempos em tempos e guarda cada partida nova em %APPDATA%\\\\pokeidle-multi\\\\pvp,\\n// montando um histórico maior para calcular vitórias/derrotas por adversário e dar sugestões.\\nconst PVP_EVERY_MIN = 15;\\nconst pvpDir = () => path.join(app.getPath('userData'), 'pvp');\\nconst pvpFile = (nick) => path.join(pvpDir(), nick.toLowerCase().replace(/[^a-z0-9_-]/g, '_') + '.json');\\nconst pvpBusy = new Set();\\nconst TYPES = ['NORMAL', 'FIRE', 'WATER', 'GRASS', 'ELECTRIC', 'ICE', 'FIGHTING', 'POISON', 'GROUND', 'FLYING',\\n  'PSYCHIC', 'BUG', 'ROCK', 'GHOST', 'DRAGON', 'DARK', 'STEEL', 'FAIRY'];\\nconst splitTypes = (t) => (String(t).toUpperCase().match(new RegExp(TYPES.join('|'), 'g')) || []);\\n// tabela de tipos (ataque -> defesa): 2 = super efetivo, 0.5 = pouco efetivo, 0 = imune\\nconst TYPE_CHART = {\\n  NORMAL: { ROCK: 0.5, GHOST: 0, STEEL: 0.5 },\\n  FIRE: { FIRE: 0.5, WATER: 0.5, GRASS: 2, ICE: 2, BUG: 2, ROCK: 0.5, DRAGON: 0.5, STEEL: 2 },\\n  WATER: { FIRE: 2, WATER: 0.5, GRASS: 0.5, GROUND: 2, ROCK: 2, DRAGON: 0.5 },\\n  GRASS: { FIRE: 0.5, WATER: 2, GRASS: 0.5, POISON: 0.5, GROUND: 2, FLYING: 0.5, BUG: 0.5, ROCK: 2, DRAGON: 0.5, STEEL: 0.5 },\\n  ELECTRIC: { WATER: 2, GRASS: 0.5, ELECTRIC: 0.5, GROUND: 0, FLYING: 2, DRAGON: 0.5 },\\n  ICE: { FIRE: 0.5, WATER: 0.5, GRASS: 2, ICE: 0.5, GROUND: 2, FLYING: 2, DRAGON: 2, STEEL: 0.5 },\\n  FIGHTING: { NORMAL: 2, ICE: 2, POISON: 0.5, FLYING: 0.5, PSYCHIC: 0.5, BUG: 0.5, ROCK: 2, GHOST: 0, DARK: 2, STEEL: 2, FAIRY: 0.5 },\\n  POISON: { GRASS: 2, POISON: 0.5, GROUND: 0.5, ROCK: 0.5, GHOST: 0.5, STEEL: 0, FAIRY: 2 },\\n  GROUND: { FIRE: 2, GRASS: 0.5, ELECTRIC: 2, POISON: 2, FLYING: 0, BUG: 0.5, ROCK: 2, STEEL: 2 },\\n  FLYING: { GRASS: 2, ELECTRIC: 0.5, FIGHTING: 2, BUG: 2, ROCK: 0.5, STEEL: 0.5 },\\n  PSYCHIC: { FIGHTING: 2, POISON: 2, PSYCHIC: 0.5, DARK: 0, STEEL: 0.5 },\\n  BUG: { FIRE: 0.5, GRASS: 2, FIGHTING: 0.5, POISON: 0.5, FLYING: 0.5, PSYCHIC: 2, GHOST: 0.5, DARK: 2, STEEL: 0.5, FAIRY: 0.5 },\\n  ROCK: { FIRE: 2, ICE: 2, FIGHTING: 0.5, GROUND: 0.5, FLYING: 2, BUG: 2, STEEL: 0.5 },\\n  GHOST: { NORMAL: 0, PSYCHIC: 2, GHOST: 2, DARK: 0.5 },\\n  DRAGON: { DRAGON: 2, STEEL: 0.5, FAIRY: 0 },\\n  DARK: { FIGHTING: 0.5, PSYCHIC: 2, GHOST: 2, DARK: 0.5, FAIRY: 0.5 },\\n  STEEL: { FIRE: 0.5, WATER: 0.5, ELECTRIC: 0.5, ICE: 2, ROCK: 2, STEEL: 0.5, FAIRY: 2 },\\n  FAIRY: { FIRE: 0.5, FIGHTING: 2, POISON: 0.5, DRAGON: 2, DARK: 2, STEEL: 0.5 },\\n};\\nconst eff = (atk, defTypes) => defTypes.reduce((m, d) => m * ((TYPE_CHART[atk] || {})[d] ?? 1), 1);\\nconst bestHit = (atkTypes, defTypes) => Math.max(...atkTypes.map((a) => eff(a, defTypes)), 0);\\nconst num = (t) => { const s = String(t).trim().toLowerCase(); const n = parseFloat(s.replace(/\\\\./g, '').replace(',', '.'));\\n  if (!isFinite(n)) return 0; return /mi$/.test(s) ? n * 1e6 : /k$/.test(s) ? n * 1e3 : n; };\\nconst fmtN = (n) => (n >= 1e6 ? (n / 1e6).toFixed(1).replace('.', ',') + ' mi' : n >= 1e3 ? (n / 1e3).toFixed(1).replace('.', ',') + ' k' : String(Math.round(n)));\\n\\n// \\\"há 4 min\\\" / \\\"há 2 h\\\" / \\\"há 3 dias\\\" / \\\"agora\\\" -> horário aproximado\\nfunction agoToTime(t, now) {\\n  const m = String(t).match(/(\\\\d+)\\\\s*(s|min|h|dia)/i);\\n  if (!m) return now;\\n  const n = Number(m[1]);\\n  const mult = { s: 1e3, min: 6e4, h: 36e5, dia: 864e5 }[m[2].toLowerCase()] || 6e4;\\n  return now - n * mult;\\n}\\n\\n// transforma o texto da página do tracker em dados\\nfunction parseTracker(text) {\\n  const tk = String(text).split(/[\\\\n\\\\t]/).map((x) => x.trim()).filter(Boolean);\\n  const out = { summary: {}, counters: [], presas: [], mons: [], matches: [] };\\n  const idx = (re) => tk.findIndex((x) => re.test(x));\\n  // cabeçalho\\n  for (const x of tk.slice(0, 40)) {\\n    let m;\\n    if (!out.summary.pr && (m = x.match(/^([\\\\d.]+) PR$/))) out.summary.pr = num(m[1]);\\n    else if (!out.summary.rank && (m = x.match(/^(\\\\d+)º$/))) out.summary.rank = Number(m[1]);\\n    else if (out.summary.wins == null && (m = x.match(/^([\\\\d.]+)V$/))) out.summary.wins = num(m[1]);\\n    else if (out.summary.losses == null && (m = x.match(/^([\\\\d.]+)D$/))) out.summary.losses = num(m[1]);\\n    else if (!out.summary.level && (m = x.match(/^Nível ([\\\\d.]+)$/))) out.summary.level = num(m[1]);\\n  }\\n  // listas \\\"nome / TIPOS / partidas / %\\\"\\n  const readList = (startRe, endRe) => {\\n    const a = idx(startRe); if (a < 0) return [];\\n    let b = tk.findIndex((x, k) => k > a && endRe.test(x)); if (b < 0) b = tk.length;\\n    const seg = tk.slice(a + 1, b).filter((x) => !/^(ADVERSÁRIO|PARTIDAS|VITÓRIAS)$/i.test(x));\\n    const res = [];\\n    for (let k = 0; k + 3 < seg.length + 1; k++) {\\n      if (splitTypes(seg[k + 1]).length && /^[A-Z]+$/.test(seg[k + 1]) && /^[\\\\d.]+$/.test(seg[k + 2] || '') && /%$/.test(seg[k + 3] || '')) {\\n        res.push({ name: seg[k], types: splitTypes(seg[k + 1]), games: num(seg[k + 2]), wr: num(seg[k + 3]) });\\n        k += 3;\\n      }\\n    }\\n    return res;\\n  };\\n  out.counters = readList(/^MAIORES COUNTERS$/i, /^PRESAS FAVORITAS$/i);\\n  out.presas = readList(/^PRESAS FAVORITAS$/i, /^GOLPES$/i);\\n  // os seus pokémon: nome / TIPOS / partidas / % / dano / abates\\n  {\\n    const a = idx(/^OS SEUS POKÉMON$/i); const b = idx(/^ÚLTIMAS 20 PARTIDAS$/i);\\n    if (a >= 0) {\\n      const seg = tk.slice(a + 1, b > a ? b : tk.length);\\n      for (let k = 0; k + 5 < seg.length + 1; k++) {\\n        if (/^[A-Z]+$/.test(seg[k + 1] || '') && splitTypes(seg[k + 1]).length && /^[\\\\d.]+$/.test(seg[k + 2] || '') && /%$/.test(seg[k + 3] || '')) {\\n          out.mons.push({ name: seg[k], types: splitTypes(seg[k + 1]), games: num(seg[k + 2]), wr: num(seg[k + 3]), dmg: num(seg[k + 4]), kills: num(seg[k + 5]) });\\n          k += 5;\\n        }\\n      }\\n    }\\n  }\\n  // partidas: \\\"Vitória|Derrota\\\" / \\\"há X · 1:49\\\" / \\\"contra NICK 1.930 PR\\\" / \\\"+9 ▼\\\" / (detalhes, se abertos)\\n  {\\n    const now = Date.now();\\n    const a = idx(/^ÚLTIMAS 20 PARTIDAS$/i);\\n    const seg = a >= 0 ? tk.slice(a + 1) : [];\\n    const starts = [];\\n    seg.forEach((x, k) => { if (/^(Vitória|Derrota)$/.test(x) && /^contra /.test(seg[k + 2] || '')) starts.push(k); });\\n    starts.forEach((k, n) => {\\n      const end = n + 1 < starts.length ? starts[n + 1] : seg.length;\\n      const blk = seg.slice(k, end);\\n      const t = (blk[1] || '').match(/^(.*?)\\\\s*·\\\\s*(\\\\d+:\\\\d+)$/);\\n      const c = (blk[2] || '').match(/^contra (.+?) ([\\\\d.]+) PR$/);\\n      const d = (blk[3] || '').match(/^([+-]\\\\d+)/);\\n      if (!c) return;\\n      const match = {\\n        win: blk[0] === 'Vitória', opp: c[1], oppPr: num(c[2]), delta: d ? Number(d[1]) : 0,\\n        dur: t ? t[2] : '', time: agoToTime(t ? t[1] : '', now),\\n      };\\n      // times (aparecem quando a partida é aberta): nome seguido de \\\"Nv 100 · caiu\\\"\\n      const det = blk.slice(4);\\n      const cut = det.findIndex((x) => /^O TIME DE /i.test(x));\\n      const team = (part) => {\\n        const r = [];\\n        part.forEach((x, j) => {\\n          const nv = (part[j + 1] || '').match(/^Nv\\\\s*([\\\\d.]+)\\\\s*·?\\\\s*(.*)$/i);\\n          if (!nv) return;\\n          const nums = part.slice(j + 2, j + 6).filter((y) => /^[\\\\d.,]+\\\\s*(k|mi)?$/i.test(y)).slice(0, 3).map(num);\\n          r.push({ name: x, lv: num(nv[1]), fainted: /caiu/i.test(nv[2]), dmg: nums[0] || 0, taken: nums[1] || 0, kills: nums[2] || 0 });\\n        });\\n        return r;\\n      };\\n      if (cut >= 0) { match.mine = team(det.slice(0, cut)); match.theirs = team(det.slice(cut)); }\\n      match.key = [match.opp, match.oppPr, match.delta, match.dur, match.win ? 'V' : 'D'].join('|');\\n      out.matches.push(match);\\n    });\\n  }\\n  return out;\\n}\\n\\n// abre o tracker escondido (sessão própria), abre todas as partidas e devolve o texto da página\\nasync function loadTrackerText(nick) {\\n  const url = `https://pokeidle.io/tracker/j/${encodeURIComponent(nick.toLowerCase())}`;\\n  const v = new WebContentsView({ webPreferences: { partition: 'persist:tracker', backgroundThrottling: false } });\\n  const wc = v.webContents;\\n  v.setBounds({ x: 0, y: 0, width: 1400, height: 1000 });\\n  const alive = () => !wc.isDestroyed();\\n  const js = (code, ms = 3000) => (alive() ? withTimeout(wc.executeJavaScript(code), ms).catch(() => null) : Promise.resolve(null));\\n  const espera = (ms) => new Promise((r) => setTimeout(r, ms));\\n  let text = '';\\n  try {\\n    wc.loadURL(url).catch(() => {});\\n    for (let k = 0; k < 15; k++) {\\n      await espera(1000);\\n      text = (await js('document.body ? document.body.innerText : \\\"\\\"')) || '';\\n      if (/ÚLTIMAS 20 PARTIDAS/i.test(text) && /contra /.test(text)) break;\\n    }\\n    // abre (▼) cada partida para aparecerem os times\\n    await js(`(async () => {\\n      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\\n      const alvos = [...document.querySelectorAll('*')].filter((e) => e.children.length === 0 && /▼/.test(e.textContent || '') && e.getClientRects().length);\\n      for (const e of alvos) { (e.closest('button,[role=button],summary,[onclick]') || e).click(); await sleep(120); }\\n      return alvos.length;\\n    })()`, 15000);\\n    await espera(1500);\\n    const t2 = await js('document.body ? document.body.innerText : \\\"\\\"');\\n    if (t2) text = t2;\\n  } finally {\\n    try { if (alive()) wc.close(); } catch {}\\n  }\\n  return text;\\n}\\n\\nfunction loadPvp(nick) {\\n  try { return JSON.parse(fs.readFileSync(pvpFile(nick), 'utf8')); } catch { return { nick, matches: [], tracker: null, updated: 0 }; }\\n}\\nfunction savePvp(data) {\\n  try { fs.mkdirSync(pvpDir(), { recursive: true }); fs.writeFileSync(pvpFile(data.nick), JSON.stringify(data)); } catch {}\\n}\\n\\n// lê o tracker e junta as partidas novas no histórico\\nasync function refreshPvp(nick) {\\n  if (!nick || /^Conta \\\\d$/.test(nick) || pvpBusy.has(nick)) return null;\\n  pvpBusy.add(nick);\\n  try {\\n    const text = await loadTrackerText(nick);\\n    const p = parseTracker(text);\\n    if (!p.matches.length && !p.mons.length) return null;\\n    const data = loadPvp(nick);\\n    const known = new Map(data.matches.map((m) => [m.key, m]));\\n    for (const m of p.matches) {\\n      const old = known.get(m.key);\\n      if (!old) { data.matches.push(m); known.set(m.key, m); }\\n      else if (!old.mine && m.mine) Object.assign(old, { mine: m.mine, theirs: m.theirs }); // completa detalhes\\n    }\\n    data.matches.sort((a, b) => b.time - a.time);\\n    data.tracker = { summary: p.summary, counters: p.counters, presas: p.presas, mons: p.mons };\\n    data.updated = Date.now();\\n    savePvp(data);\\n    return data;\\n  } finally { pvpBusy.delete(nick); }\\n}\\n\\n// análise: vitórias/derrotas por adversário + sugestões\\nfunction analyzePvp(data) {\\n  const t = data.tracker || { summary: {}, counters: [], presas: [], mons: [] };\\n  const byOpp = new Map();\\n  for (const m of data.matches) {\\n    const o = byOpp.get(m.opp) || { name: m.opp, w: 0, l: 0, last: 0, lastWin: false, pr: m.oppPr, ms: [] };\\n    m.win ? o.w++ : o.l++;\\n    if (m.time > o.last) { o.last = m.time; o.lastWin = m.win; o.pr = m.oppPr; }\\n    o.ms.push(m);\\n    byOpp.set(m.opp, o);\\n  }\\n  const opps = [...byOpp.values()].sort((a, b) => (b.w + b.l) - (a.w + a.l) || b.last - a.last);\\n  const sug = [];\\n\\n  // 1) adversários difíceis\\n  const rivais = [];\\n  for (const o of opps.filter((x) => x.w + x.l >= 3 && x.w / (x.w + x.l) < 0.4).slice(0, 8)) {\\n    // o pokémon dele que mais causou dano nas suas derrotas\\n    const dano = new Map();\\n    for (const m of o.ms.filter((x) => !x.win && x.theirs)) for (const p of m.theirs) dano.set(p.name, (dano.get(p.name) || 0) + p.dmg);\\n    const top = [...dano.entries()].sort((a, b) => b[1] - a[1])[0];\\n    const nDer = Math.max(1, o.ms.filter((x) => !x.win && x.theirs).length);\\n    rivais.push({ nome: o.name, w: o.w, l: o.l, top: top ? top[0] : null, topDano: top ? fmtN(top[1] / nDer) : null });\\n    if (rivais.length > 3) continue;\\n    sug.push({ tipo: 'rival', texto: `${o.name} te vence com frequência (${o.w}V ${o.l}D).` +\\n      (top ? ` O maior problema é o ${top[0]} dele (${fmtN(top[1] / Math.max(1, o.ms.filter((x) => !x.win && x.theirs).length))} de dano por derrota).` : '') });\\n  }\\n\\n  // 2) ordem do time contra cada adversário (quando há times registrados)\\n  const leads = [];\\n  for (const o of opps) {\\n    const comTime = o.ms.filter((m) => m.mine && m.mine.length);\\n    if (comTime.length < 2) continue;\\n    const porLead = new Map();\\n    for (const m of comTime) {\\n      const ld = m.mine[0].name;\\n      const r = porLead.get(ld) || { w: 0, l: 0, ordem: m.mine.map((p) => p.name) };\\n      m.win ? r.w++ : r.l++;\\n      porLead.set(ld, r);\\n    }\\n    const melhor = [...porLead.entries()].sort((a, b) => (b[1].w / (b[1].w + b[1].l)) - (a[1].w / (a[1].w + a[1].l)) || (b[1].w - a[1].w))[0];\\n    if (melhor && melhor[1].w > 0) leads.push({ opp: o.name, lead: melhor[0], w: melhor[1].w, l: melhor[1].l, ordem: melhor[1].ordem });\\n  }\\n  leads.sort((a, b) => (b.w + b.l) - (a.w + a.l));\\n  for (const ld of leads.slice(0, 3)) {\\n    sug.push({ tipo: 'ordem', texto: `Contra ${ld.opp}: começar com ${ld.lead} deu ${ld.w}V ${ld.l}D. Ordem que funcionou: ${ld.ordem.join(' → ')}.` });\\n  }\\n\\n  // 3) quem do seu time cai sem render (nas partidas registradas com time)\\n  const caem = [];\\n  {\\n    const st = new Map();\\n    for (const m of data.matches.filter((x) => x.mine)) for (const p of m.mine) {\\n      const s = st.get(p.name) || { n: 0, caiu: 0, dmg: 0 };\\n      s.n++; if (p.fainted) s.caiu++; s.dmg += p.dmg; st.set(p.name, s);\\n    }\\n    const fracos = [...st.entries()].filter(([, s]) => s.n >= 5 && s.caiu / s.n > 0.85).sort((a, b) => a[1].dmg / a[1].n - b[1].dmg / b[1].n).slice(0, 2);\\n    for (const [nm, s] of fracos) caem.push({ nome: nm, pct: Math.round((s.caiu / s.n) * 100), dano: fmtN(s.dmg / s.n) });\\n    for (const [nm, s] of fracos) sug.push({ tipo: 'fraco', texto: `${nm} cai em ${Math.round((s.caiu / s.n) * 100)}% das partidas causando em média ${fmtN(s.dmg / s.n)} de dano. Vale testar outra posição ou trocar.` });\\n  }\\n\\n  // 4) seus pokémon com rendimento baixo (dados da temporada do tracker)\\n  const mons = t.mons.filter((m) => m.games >= 50).map((m) => ({ ...m, dmgPer: m.dmg / m.games, killsPer: m.kills / m.games }));\\n  if (mons.length >= 3) {\\n    const media = mons.reduce((s, m) => s + m.wr, 0) / mons.length;\\n    for (const m of mons.filter((x) => x.wr < media - 5).sort((a, b) => a.wr - b.wr).slice(0, 2)) {\\n      sug.push({ tipo: 'fraco', texto: `${m.name} tem ${m.wr}% de vitórias em ${m.games} partidas, abaixo da média do seu time (${Math.round(media)}%).` });\\n    }\\n    const destaque = [...mons].sort((a, b) => b.dmgPer - a.dmgPer)[0];\\n    sug.push({ tipo: 'forte', texto: `${destaque.name} é quem mais rende: ${fmtN(destaque.dmgPer)} de dano e ${destaque.killsPer.toFixed(1).replace('.', ',')} abates por partida.` });\\n  }\\n\\n  // 5) contra os maiores counters: quem do seu time bate forte e aguenta\\n  const counterTips = [];\\n  for (const c of t.counters.slice(0, 4)) {\\n    const bons = mons.map((m) => ({ m, atk: bestHit(m.types, c.types), def: bestHit(c.types, m.types) }))\\n      .filter((x) => x.atk >= 2 && x.def <= 1).sort((a, b) => b.atk - a.atk || a.def - b.def || b.m.wr - a.m.wr).slice(0, 2);\\n    const ruins = mons.filter((m) => bestHit(c.types, m.types) >= 2).map((m) => m.name).slice(0, 3);\\n    counterTips.push({ name: c.name, types: c.types, wr: c.wr, games: c.games, bons: bons.map((x) => x.m.name), ruins });\\n    if (bons.length) sug.push({ tipo: 'counter', texto: `Contra ${c.name} (${c.types.join('/')}, você vence só ${c.wr}%): ${bons.map((x) => x.m.name).join(' e ')} bate${bons.length > 1 ? 'm' : ''} forte e aguenta${bons.length > 1 ? 'm' : ''} os golpes dele.` +\\n      (ruins.length ? ` Evite deixar ${ruins.join(', ')} na frente dele.` : '') });\\n  }\\n\\n  const recent = data.matches.slice(0, 20);\\n  return {\\n    nick: data.nick, updated: data.updated, total: data.matches.length,\\n    summary: t.summary, recentW: recent.filter((m) => m.win).length, recentL: recent.filter((m) => !m.win).length,\\n    opps: opps.slice(0, 40).map((o) => ({ name: o.name, w: o.w, l: o.l, pr: o.pr, last: o.last, lastWin: o.lastWin })),\\n    counters: counterTips, presas: t.presas, mons: mons.map((m) => ({ name: m.name, types: m.types, games: m.games, wr: m.wr, dmgPer: fmtN(m.dmgPer), killsPer: m.killsPer.toFixed(1).replace('.', ',') })),\\n    sug, hasTeams: data.matches.some((m) => m.mine && m.mine.length),\\n    rivais, leads: leads.slice(0, 12), caem,\\n  };\\n}\\n\\n// janela do PvP\\nlet pvpWin = null;\\nfunction openPvp(i) {\\n  if (pvpWin && !pvpWin.isDestroyed()) { pvpWin.webContents.send('pvp-account', i); pvpWin.show(); pvpWin.focus(); return; }\\n  pvpWin = new BrowserWindow({\\n    width: 1100, height: 820, minWidth: 760, minHeight: 560, title: 'PvP — PokeLink',\\n    backgroundColor: '#24101a', autoHideMenuBar: true,\\n    titleBarStyle: 'hidden', titleBarOverlay: { color: TITLE_BG, symbolColor: TITLE_FG, height: TITLE_H },\\n    ...(customIconPath() ? { icon: customIconPath() } : {}),\\n    webPreferences: { preload: path.join(__dirname, 'preload.js') },\\n  });\\n  pvpWin.setMenu(null);\\n  pvpWin.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'pvp', i: String(i) } });\\n  pvpWin.on('closed', () => { pvpWin = null; });\\n}\\nipcMain.handle('pvp-get', async (_, i, force) => {\\n  if (!Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return null;\\n  const nick = nameOf(i);\\n  if (/^Conta \\\\d$/.test(nick)) return { erro: 'Ainda não sei o nick desta conta. Espere o jogo carregar.' };\\n  let data = loadPvp(nick);\\n  if (force || !data.updated || Date.now() - data.updated > 5 * 60 * 1000) data = (await refreshPvp(nick)) || data;\\n  if (!data.updated) return { erro: 'Não consegui ler o tracker desta conta. Confira a internet e tente \\\"Atualizar\\\".' };\\n  return Object.assign(analyzePvp(data), { contas: ACCOUNTS.map((_, k) => nameOf(k)), conta: i });\\n});\\n// coleta em segundo plano: guarda as partidas novas antes que saiam das \\\"últimas 20\\\"\\nasync function pvpCollectAll() {\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    try { await refreshPvp(nameOf(i)); } catch {}\\n  }\\n}\\n\\n// ---------- Importar o login da Kick de um navegador normal ----------\\n// A proteção anti-robô da Kick recusa o login feito dentro do PokeLink. Em vez de logar aqui,\\n// o usuário loga no Chrome/Edge, exporta os cookies da kick.com (extensão \\\"Cookie-Editor\\\" → Export → JSON)\\n// e cola no PokeLink. Os cookies ficam só na sessão daquela conta, neste PC.\\nfunction parseCookieText(txt) {\\n  const t = String(txt || '').trim();\\n  if (!t) return [];\\n  // 1) JSON (Cookie-Editor, EditThisCookie...)\\n  if (/^[\\\\[{]/.test(t)) {\\n    try {\\n      const j = JSON.parse(t);\\n      const arr = Array.isArray(j) ? j : Array.isArray(j.cookies) ? j.cookies : [j];\\n      return arr.filter((c) => c && c.name).map((c) => ({\\n        name: String(c.name), value: String(c.value ?? ''), domain: c.domain || '.kick.com', path: c.path || '/',\\n        secure: c.secure !== false, httpOnly: !!c.httpOnly,\\n        expirationDate: Number(c.expirationDate || c.expires || 0) || undefined,\\n        sameSite: ({ no_restriction: 'no_restriction', none: 'no_restriction', lax: 'lax', strict: 'strict' })[String(c.sameSite || '').toLowerCase()] || 'unspecified',\\n      }));\\n    } catch {}\\n  }\\n  // 2) formato Netscape (cookies.txt): domínio  flag  caminho  seguro  expira  nome  valor\\n  const net = t.split(/\\\\r?\\\\n/).filter((l) => l && !l.startsWith('#')).map((l) => l.split('\\\\t')).filter((p) => p.length >= 7);\\n  if (net.length) {\\n    return net.map((p) => ({ domain: p[0], path: p[2], secure: /true/i.test(p[3]), expirationDate: Number(p[4]) || undefined, name: p[5], value: p[6], httpOnly: false, sameSite: 'unspecified' }));\\n  }\\n  // 3) \\\"nome=valor; nome2=valor2\\\"\\n  return t.replace(/^cookie:\\\\s*/i, '').split(';').map((x) => x.trim()).filter((x) => x.includes('='))\\n    .map((x) => { const k = x.indexOf('='); return { name: x.slice(0, k).trim(), value: x.slice(k + 1).trim(), domain: '.kick.com', path: '/', secure: true, httpOnly: false, sameSite: 'unspecified' }; });\\n}\\n\\nasync function importKickLogin(i) {\\n  const f = await uiDialog({\\n    type: 'question',\\n    title: `Kick — ${nameOf(i)}`,\\n    message: 'Importar o login da Kick do seu navegador',\\n    detail: '1. No Chrome ou Edge, instale a extensão \\\"Cookie-Editor\\\".\\\\n' +\\n      '2. Entre em kick.com com a conta da Kick desta conta do jogo.\\\\n' +\\n      '3. Clique na extensão → Export → JSON (copia sozinho).\\\\n' +\\n      '4. Cole aqui embaixo e clique em Importar.\\\\n\\\\n' +\\n      'Isso é o seu login: cole só aqui no PokeLink e não mande para ninguém.',\\n    form: [{ id: 'cookies', label: 'Cookies da kick.com', hint: 'cole o texto copiado pela extensão', type: 'textarea', value: '' }],\\n    buttons: ['Importar', 'Cancelar'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (f.response !== 0 || !f.values) return;\\n  const list = parseCookieText(f.values.cookies).filter((c) => /kick\\\\.com$/i.test(String(c.domain).replace(/^\\\\./, '')));\\n  if (!list.length) {\\n    showError('Kick', 'Não encontrei cookies da kick.com no texto colado. Confira se você estava em kick.com ao exportar.');\\n    return;\\n  }\\n  const ses = accountSession(i);\\n  let ok = 0;\\n  for (const c of list) {\\n    const host = String(c.domain).replace(/^\\\\./, '');\\n    try {\\n      await ses.cookies.set({\\n        url: `https://${host}${c.path || '/'}`, name: c.name, value: c.value,\\n        domain: c.domain.startsWith('.') || c.domain.includes('kick.com') ? c.domain : undefined,\\n        path: c.path || '/', secure: c.secure, httpOnly: c.httpOnly,\\n        expirationDate: c.expirationDate, sameSite: c.sameSite,\\n      });\\n      ok++;\\n    } catch {}\\n  }\\n  try { await ses.cookies.flushStore(); } catch {}\\n  if (await kickLogged(i)) {\\n    uiDialog({ type: 'info', title: 'Kick', message: `Login da Kick importado na ${nameOf(i)}.`, detail: `${ok} cookie(s) importados. O botão Kick desta conta foi ligado.` });\\n    setLivesOn(i, 'kick', true);\\n  } else {\\n    uiDialog({\\n      type: 'warning', title: 'Kick', message: 'Os cookies foram importados, mas a Kick ainda não reconheceu o login.',\\n      detail: `${ok} cookie(s) importados. Confira se você estava logado em kick.com ao exportar e exporte de novo.`,\\n    });\\n  }\\n}\\n\\n// ---------- Pontos da Kick: leitura em tempo real + aviso + atalho para o resgate ----------\\n// O saldo de pontos de cada canal é lido de dentro das lives da Kick que já estão abertas\\n// escondidas (mesma conta). Primeiro pela API da própria página; se não der, pela tela do chat.\\nconst KICK_GOALS = [\\n  { pts: 300, nome: '+15% XP' },\\n  { pts: 500, nome: '+15% Capture Boost' },\\n  { pts: 1000, nome: '+15% Secret Lure' },\\n];\\nconst KICK_POLL_SEC = 60;\\nconst kickPts = ACCOUNTS.map(() => ({})); // slug -> { pts, at, base, baseAt, via, avisado: {300: true...} }\\nconst liveStatus = new Map(); // \\\"conta|canal\\\" -> { tocando, visivel }\\nconst KICK_POINTS_JS = `(async () => {\\n  const slug = (location.pathname.split('/').filter(Boolean)[0] || '').toLowerCase();\\n  const out = { slug, points: null, via: null, visivel: document.visibilityState, tocando: false };\\n  // o player precisa estar tocando para a Kick contar os pontos: se pausou, dá play de novo\\n  for (const v of document.querySelectorAll('video')) {\\n    if (v.paused) {\\n      try { await v.play(); } catch (e) {\\n        // o navegador recusou o play direto: tenta o botão de play do próprio player\\n        const b = [...document.querySelectorAll('button,[role=button]')].find((x) => /play|reproduzir|assistir/i.test((x.getAttribute('aria-label') || '') + ' ' + (x.title || '')));\\n        if (b) b.click();\\n      }\\n    }\\n    if (!v.paused && v.readyState >= 2) out.tocando = true;\\n  }\\n  out.erroPlay = document.querySelectorAll('video').length ? null : 'sem player na página';\\n  const parse = (t) => {\\n    const m = String(t).replace(/\\\\\\\\s/g, '').match(/^([\\\\\\\\d.,]+)([kKmM]?)$/);\\n    if (!m) return null;\\n    let n = parseFloat(m[1].replace(/\\\\\\\\.(?=\\\\\\\\d{3}(\\\\\\\\D|$))/g, '').replace(',', '.'));\\n    if (/k/i.test(m[2])) n *= 1e3; if (/m/i.test(m[2])) n *= 1e6;\\n    return isFinite(n) ? Math.round(n) : null;\\n  };\\n  // 1) API da Kick, de dentro da página (usa o login da própria página)\\n  try {\\n    const tok = decodeURIComponent((document.cookie.match(/(?:^|; )session_token=([^;]+)/) || [])[1] || '');\\n    const h = { Accept: 'application/json' };\\n    if (tok) h.Authorization = 'Bearer ' + tok;\\n    const find = (o, d) => {\\n      if (!o || typeof o !== 'object' || d > 5) return null;\\n      for (const [k, v] of Object.entries(o)) {\\n        if (/point/i.test(k) && typeof v === 'number') return v;\\n        if (/point/i.test(k) && v && typeof v === 'object' && typeof v.points === 'number') return v.points;\\n        const x = find(v, d + 1); if (x != null) return x;\\n      }\\n      return null;\\n    };\\n    for (const u of ['/api/v2/channels/' + slug + '/me', '/api/v2/channels/' + slug + '/points']) {\\n      const r = await fetch(u, { headers: h, credentials: 'include' });\\n      if (!r.ok) continue;\\n      const p = find(await r.json(), 0);\\n      if (p != null) { out.points = Math.round(p); out.via = 'api'; return out; }\\n    }\\n  } catch (e) {}\\n  // 2) tela: botão/elemento de pontos perto do chat\\n  const els = [...document.querySelectorAll('[aria-label],[title],[data-testid],[class*=point],[class*=Point]')]\\n    .filter((e) => /point|ponto/i.test([e.getAttribute('aria-label'), e.getAttribute('title'), e.getAttribute('data-testid'), e.className].join(' ')));\\n  for (const e of els) {\\n    const p = parse(e.textContent || '');\\n    if (p != null) { out.points = p; out.via = 'tela'; return out; }\\n    for (const s of e.querySelectorAll('*')) { const q = s.children.length ? null : parse(s.textContent || ''); if (q != null) { out.points = q; out.via = 'tela'; return out; } }\\n  }\\n  return out;\\n})()`;\\n\\nconst kickAll = ACCOUNTS.map(() => ({})); // slug -> pontos (todos os canais, não só os abertos)\\nconst kickAllAt = ACCOUNTS.map(() => 0);\\nconst KICK_ALL_JS = (slugs) => `(async () => {\\n  const tok = decodeURIComponent((document.cookie.match(/(?:^|; )session_token=([^;]+)/) || [])[1] || '');\\n  const h = { Accept: 'application/json' }; if (tok) h.Authorization = 'Bearer ' + tok;\\n  const out = {};\\n  for (const s of ${JSON.stringify([])}.concat(SLUGS)) {\\n    try { const r = await fetch('/api/v2/channels/' + s + '/points', { headers: h, credentials: 'include' });\\n      if (r.ok) { const j = await r.json(); const p = j && j.data && j.data.points; if (typeof p === 'number') out[s] = p; } } catch (e) {}\\n  }\\n  return out;\\n})()`.replace('SLUGS', JSON.stringify(slugs));\\nasync function pollKickAll(i) {\\n  if (Date.now() - kickAllAt[i] < (kickApiOk[i] ? 15 : 5) * 60 * 1000) return;\\n  if (kickApiOk[i] !== false) {\\n    kickAllAt[i] = Date.now();\\n    for (const slug of LIVE_CHANNELS.kick) {\\n      if (liveOpen[i].kick.has(slug)) continue; // os abertos já são lidos a cada minuto\\n      const n = await saldoKick(i, slug);\\n      if (n == null) break;\\n      kickAll[i][slug] = n;\\n    }\\n    if (kickApiOk[i]) return;\\n  }\\n  const slot = [...liveOpen[i].kick.values()].find((x) => x.view && !x.view.webContents.isDestroyed() && !x.view.webContents.isLoading());\\n  if (!slot) return;\\n  kickAllAt[i] = Date.now();\\n  try { Object.assign(kickAll[i], await withTimeout(slot.view.webContents.executeJavaScript(KICK_ALL_JS(LIVE_CHANNELS.kick)), 20000)); } catch {}\\n}\\n\\n// Saldo de pontos pedido DIRETO à Kick, com o login da própria conta (sem precisar ler de dentro da live)\\nconst acharPontos = (o, d = 0) => {\\n  if (o == null || d > 5) return null;\\n  if (typeof o === 'number') return o;\\n  if (typeof o !== 'object') return null;\\n  for (const k of ['points', 'balance', 'amount']) if (typeof o[k] === 'number') return o[k];\\n  for (const v of Object.values(o)) { const x = acharPontos(v, d + 1); if (x != null) return x; }\\n  return null;\\n};\\nconst kickApiOk = ACCOUNTS.map(() => null); // true/false: a consulta direta funciona nesta conta?\\nasync function saldoKick(i, slug) {\\n  try {\\n    const ses = accountSession(i);\\n    const ck = (await ses.cookies.get({ url: 'https://kick.com', name: 'session_token' }))[0];\\n    if (!ck) return null;\\n    const r = await withTimeout(ses.fetch(`https://kick.com/api/v2/channels/${encodeURIComponent(slug)}/points`, {\\n      headers: { Accept: 'application/json', 'User-Agent': LIVE_UA, Authorization: 'Bearer ' + decodeURIComponent(ck.value) },\\n    }), 10000);\\n    if (!r.ok) { kickApiOk[i] = false; return null; }\\n    const n = acharPontos(await r.json().catch(() => null));\\n    kickApiOk[i] = n != null;\\n    return n;\\n  } catch { kickApiOk[i] = false; return null; }\\n}\\n// vídeo tocando? (serve para o player pequeno e para a página inteira)\\nconst KICK_VISIVEL_JS = `(() => {\\n  if (window.__plVisivel) return;\\n  window.__plVisivel = true;\\n  try {\\n    Object.defineProperty(Document.prototype, 'hidden', { get: () => false, configurable: true });\\n    Object.defineProperty(Document.prototype, 'visibilityState', { get: () => 'visible', configurable: true });\\n    Object.defineProperty(Document.prototype, 'webkitHidden', { get: () => false, configurable: true });\\n    Document.prototype.hasFocus = () => true;\\n  } catch (e) {}\\n  const parar = (e) => e.stopImmediatePropagation();\\n  for (const t of ['visibilitychange', 'webkitvisibilitychange', 'blur', 'pagehide', 'freeze']) {\\n    window.addEventListener(t, parar, true); document.addEventListener(t, parar, true);\\n  }\\n})();`;\\nconst KICK_TOCANDO_JS = `(() => { const v = document.querySelector('video');\\n  return { tocando: !!(v && !v.paused && v.readyState > 2), visivel: document.visibilityState === 'visible' }; })()`;\\n// player pequeno que não está rendendo pontos: aquela conta passa para a página inteira\\nfunction conferirPlayerKick(i) {\\n  if (kickPlayer !== 'auto' || kickCompleta[i]) return;\\n  if (tela.off || Date.now() - tela.voltou < 15 * 60 * 1000) return; // tela apagada há pouco: espera para julgar\\n  for (const [slug, slot] of liveOpen[i].kick) {\\n    if (!slot.view || Date.now() - slot.openedAt < 15 * 60 * 1000) continue;\\n    const s = kickPts[i][slug];\\n    // sem saldo há 15 min (não dá para conferir) ou saldo parado desde que abriu (sem resgate no meio)\\n    const semDados = !s || !s.at || Date.now() - s.at > 10 * 60 * 1000;\\n    const parado = s && s.inicio != null && s.pts <= s.inicio && Date.now() - s.inicioAt >= 15 * 60 * 1000;\\n    if (semDados || parado) {\\n      kickCompleta[i] = true;\\n      logTravamento(`${nameOf(i)}: player pequeno da Kick não contou pontos em ${slug}; usando a página inteira nesta conta`);\\n      saveLives();\\n      for (const sl of liveOpen[i].kick.values()) closeLive(sl);\\n      liveOpen[i].kick.clear();\\n      syncLives();\\n      return;\\n    }\\n  }\\n}\\nasync function pollKickPoints() {\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    for (const [slug, slot] of liveOpen[i].kick) {\\n      const wc = slot.view && slot.view.webContents;\\n      if (!wc || wc.isDestroyed() || wc.isLoading()) continue;\\n      let r = null;\\n      const n = await saldoKick(i, slug); // 1º: direto na Kick\\n      if (n != null) {\\n        try { r = await withTimeout(wc.executeJavaScript(KICK_TOCANDO_JS), 4000); } catch {}\\n        r = Object.assign(r || {}, { points: n, via: 'kick' });\\n      } else if (!wc.getURL().includes('player.kick.com')) {\\n        try { r = await withTimeout(wc.executeJavaScript(KICK_POINTS_JS), 8000); } catch {} // 2º: de dentro da página inteira\\n      } else {\\n        try { r = await withTimeout(wc.executeJavaScript(KICK_TOCANDO_JS), 4000); } catch {}\\n      }\\n      if (r) liveStatus.set(`${i}|${slug}`, { tocando: !!r.tocando, visivel: r.visivel, at: Date.now() });\\n      if (!r || r.points == null) continue;\\n      const now = Date.now();\\n      const s = kickPts[i][slug] || { base: r.points, baseAt: now, avisado: {} };\\n      if (r.points < (s.pts ?? r.points)) { s.base = r.points; s.baseAt = now; s.avisado = {}; } // resgatou: recomeça a contagem\\n      s.pts = r.points; s.at = now; s.via = r.via;\\n      // ponto de partida para conferir se o player pequeno está rendendo (zera ao reabrir ou resgatar)\\n      if (s.inicioSlot !== slot.openedAt || r.points < (s.inicio ?? r.points)) { s.inicio = r.points; s.inicioAt = now; s.inicioSlot = slot.openedAt; }\\n      kickPts[i][slug] = s;\\n      // avisa quando cruza 300 / 500 / 1.000\\n      const meta = [...KICK_GOALS].reverse().find((g) => r.points >= g.pts && !s.avisado[g.pts]);\\n      if (meta) {\\n        KICK_GOALS.forEach((g) => { if (r.points >= g.pts) s.avisado[g.pts] = true; });\\n        kickGoalAlert(i, slug, r.points, meta);\\n      }\\n    }\\n  }\\n  for (let i = 0; i < ACCOUNTS.length; i++) if (lives.kick[i]) { conferirPlayerKick(i); await pollKickAll(i); }\\n  if (kickWin && !kickWin.isDestroyed()) kickWin.webContents.send('kick-update');\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('kick-update'); // painel da barra\\n}\\nasync function kickGoalAlert(i, slug, pts, meta) {\\n  avisoCelular('kick', `${pts.toLocaleString('pt-BR')} pontos na Kick`, `${nameOf(i)} · ${slug}: já dá para resgatar ${meta.nome}.`);\\n  if (!kickAvisos) return; // avisos desligados (a meta continua marcada, então não acumula avisos)\\n  const r = await uiDialog({\\n    type: 'info',\\n    title: 'Pontos da Kick',\\n    message: `${nameOf(i)}: ${pts.toLocaleString('pt-BR')} pontos em ${slug}`,\\n    detail: `Já dá para resgatar ${meta.nome} (${meta.pts.toLocaleString('pt-BR')} pontos). ` +\\n      'O resgate é feito na live: abra os pontos do canal (embaixo do chat) e escolha o bônus. Em segundos ele aparece no jogo.',\\n    buttons: ['Resgatar na live', 'Depois'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (r.response === 0) openLivePage(i, 'kick', slug);\\n}\\n// leva até o resgate: amplia a conta e abre o painel \\\"Bônus na Kick\\\" do jogo\\nasync function openKickRedeem(i) {\\n  setFocus(i);\\n  if (win) win.focus();\\n  const wc = views[i] && views[i].webContents;\\n  if (!wc || wc.isDestroyed()) return;\\n  const ok = await withTimeout(wc.executeJavaScript(`(() => {\\n    const b = document.querySelector('button.tr-ativo.kick') ||\\n      [...document.querySelectorAll('button,[role=button]')].find((e) => /kick/i.test((e.getAttribute('aria-label') || '') + ' ' + (e.textContent || '')));\\n    if (b) b.click(); return !!b;\\n  })()`), 3000).catch(() => false);\\n  if (!ok) uiDialog({ type: 'info', title: 'Pontos da Kick', message: 'Abra o painel \\\"Bônus na Kick\\\" no jogo para resgatar.', detail: 'Não achei o botão da Kick no painel do treinador desta conta.' });\\n}\\n\\nfunction kickState() {\\n  return {\\n    avisos: kickAvisos,\\n    goals: KICK_GOALS,\\n    poll: KICK_POLL_SEC,\\n    removidos: listaCanais().find((x) => x.p === 'kick').removidos,\\n    contas: ACCOUNTS.map((_, i) => ({\\n      i, name: nameOf(i), on: !!lives.kick[i],\\n      sel: kickSel[i],\\n      todos: LIVE_CHANNELS.kick.map((slug) => ({\\n        slug, live: liveNow.kick.has(slug), sel: kickSel[i].includes(slug),\\n        pts: kickPts[i][slug] && kickPts[i][slug].pts != null ? kickPts[i][slug].pts : (kickAll[i][slug] ?? null),\\n      })),\\n      canais: [...liveOpen[i].kick.keys()].map((slug) => {\\n        const s = kickPts[i][slug];\\n        const horas = s && s.at > s.baseAt ? (s.at - s.baseAt) / 36e5 : 0;\\n        const st = liveStatus.get(`${i}|${slug}`);\\n        const slot = liveOpen[i].kick.get(slug);\\n        return { slug, pts: s ? s.pts : null, via: s ? s.via : null, at: s ? s.at : 0, tocando: st ? st.tocando : null,\\n          aberta: slot && slot.view ? slot.openedAt : 0,\\n          // aberta há 20+ min e o saldo não subiu nada desde a 1ª leitura = não está rendendo\\n          semRender: !!(slot && slot.view && Date.now() - slot.openedAt > 20 * 60 * 1000 && s && s.pts != null && s.pts === s.base && Date.now() - s.baseAt > 15 * 60 * 1000),\\n          porHora: horas >= 0.1 ? Math.round((s.pts - s.base) / horas) : null };\\n      }),\\n    })),\\n  };\\n}\\nipcMain.handle('kick-get', () => kickState());\\nipcMain.handle('kick-refresh', async () => { await pollKickPoints(); return kickState(); });\\nipcMain.on('kick-redeem', (_, i) => { if (Number.isInteger(i) && i >= 0 && i < ACCOUNTS.length) openKickRedeem(i); });\\nipcMain.on('kick-redeem-live', (_, i, slug) => openLivePage(i, 'kick', String(slug)));\\n// escolher/desmarcar um canal para farmar\\nipcMain.on('kick-sel', (_, i, slug) => {\\n  if (!Number.isInteger(i) || i < 0 || i >= ACCOUNTS.length) return;\\n  slug = String(slug).toLowerCase();\\n  if (!LIVE_CHANNELS.kick.includes(slug)) return;\\n  const k = kickSel[i].indexOf(slug);\\n  if (k >= 0) kickSel[i].splice(k, 1); else kickSel[i].push(slug);\\n  saveLives();\\n  syncLives();\\n  if (kickWin && !kickWin.isDestroyed()) kickWin.webContents.send('kick-update');\\n  if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('kick-update'); // painel da barra\\n});\\nipcMain.on('kick-open', (e, i, rect) => {\\n  if (!Number.isInteger(i)) return;\\n  // moedinha da barra: os pontos descem do botão como um painel (desenhado pela barra de título)\\n  const bi = bars.findIndex((b) => b.webContents === e.sender);\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (!canDraw || bi < 0 || !rect) { openKickWin(); return; }\\n  const b = bars[bi].getBounds();\\n  const id = ++cfgPanelSeq;\\n  cfgPanels.add(id);\\n  dialogOpen = true;\\n  layout();\\n  titleBar.webContents.focus();\\n  titleBar.webContents.send('title-kick', {\\n    id, conta: i, x: b.x + Math.round(rect.left) - 8, y: b.y + Math.round(rect.bottom) + 4, up: b.y + Math.round(rect.top) - 4,\\n  });\\n  pollKickPoints();\\n});\\nipcMain.handle('kick-diag', async () => {\\n  // diagnóstico: o que a página da Kick mostra perto do chat (para ajustar a leitura dos pontos)\\n  for (let i = 0; i < ACCOUNTS.length; i++) {\\n    for (const [slug, slot] of liveOpen[i].kick) {\\n      const wc = slot.view && slot.view.webContents;\\n      if (!wc || wc.isDestroyed()) continue;\\n      const dump = await withTimeout(wc.executeJavaScript(`(async () => {\\n        const slug = ${JSON.stringify(slug)};\\n        const tok = decodeURIComponent((document.cookie.match(/(?:^|; )session_token=([^;]+)/) || [])[1] || '');\\n        const h = { Accept: 'application/json' }; if (tok) h.Authorization = 'Bearer ' + tok;\\n        const api = {};\\n        for (const u of ['/api/v2/channels/' + slug + '/me', '/api/v2/channels/' + slug + '/points']) {\\n          try { const r = await fetch(u, { headers: h, credentials: 'include' }); api[u] = r.status + ' ' + (await r.text()).slice(0, 3000); } catch (e) { api[u] = 'erro ' + e.message; }\\n        }\\n        const rot = [...document.querySelectorAll('[aria-label],[title],[data-testid]')].map((e) => e.tagName + ' | ' + [e.getAttribute('aria-label'), e.getAttribute('title'), e.getAttribute('data-testid')].filter(Boolean).join(' | ') + ' | ' + (e.textContent || '').trim().slice(0, 40)).slice(0, 400);\\n        const chat = document.querySelector('#chatroom-footer, [id*=chat] footer, [class*=chat-input], [class*=ChatInput]');\\n        const videos = [...document.querySelectorAll('video')].map((v) => ({ paused: v.paused, muted: v.muted, readyState: v.readyState, t: v.currentTime }));\\n        return { url: location.href, logado: !!tok, visivel: document.visibilityState, videos, api, rotulos: rot, chat: chat ? chat.outerHTML.slice(0, 8000) : null };\\n      })()`), 15000).catch((e) => ({ erro: e.message }));\\n      const f = path.join(app.getPath('desktop'), 'kick-diagnostico.json');\\n      try { fs.writeFileSync(f, JSON.stringify({ versao: APP_VERSION, conta: nameOf(i), slug, dump }, null, 1)); } catch { return null; }\\n      return f;\\n    }\\n  }\\n  return '';\\n});\\n\\n// janela \\\"Resgate\\\" (pontos em tempo real)\\nlet kickWin = null;\\nfunction openKickWin() {\\n  if (kickWin && !kickWin.isDestroyed()) { kickWin.show(); kickWin.focus(); return; }\\n  kickWin = new BrowserWindow({\\n    width: 980, height: 760, minWidth: 640, minHeight: 480, title: 'Pontos da Kick — PokeLink',\\n    backgroundColor: '#24101a', autoHideMenuBar: true,\\n    titleBarStyle: 'hidden', titleBarOverlay: { color: TITLE_BG, symbolColor: TITLE_FG, height: TITLE_H },\\n    ...(customIconPath() ? { icon: customIconPath() } : {}),\\n    webPreferences: { preload: path.join(__dirname, 'preload.js') },\\n  });\\n  kickWin.setMenu(null);\\n  kickWin.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'kick' } });\\n  kickWin.on('closed', () => { kickWin = null; });\\n  pollKickPoints();\\n}\\n\\n// ---------- Levar o login de uma conta para o PokeLink Lite (Android) ----------\\n// O login com Google/Cloudflare é recusado dentro de apps no celular. Como aqui a conta já está logada,\\n// o PokeLink copia o login (cookies do pokeidle.io) e o usuário cola no app do celular.\\nasync function copyLoginForPhone(i) {\\n  const c = await uiDialog({\\n    type: 'warning',\\n    title: 'Login para o celular',\\n    message: `Copiar o login da ${nameOf(i)}?`,\\n    detail: 'O texto copiado É o seu login no jogo: quem tiver ele entra na sua conta. Mande só para você mesmo ' +\\n      '(ex.: WhatsApp \\\"mensagem para mim\\\") e apague a mensagem depois de colar no PokeLink Lite.',\\n    buttons: ['Copiar', 'Cancelar'],\\n    defaultId: 0,\\n    cancelId: 1,\\n  });\\n  if (c.response !== 0) return;\\n  const ses = session.fromPartition(`persist:conta${i + 1}`);\\n  const list = (await ses.cookies.get({})).filter((k) => /(^|\\\\.)pokeidle\\\\.io$/i.test(String(k.domain).replace(/^\\\\./, '')));\\n  // o login do jogo pode estar em cookies E no armazenamento da página (localStorage / IndexedDB)\\n  let store = { ls: {}, idb: [] };\\n  const wc = views[i] && views[i].webContents;\\n  if (wc && !wc.isDestroyed()) {\\n    try { store = JSON.parse(await withTimeout(wc.executeJavaScript(LOGIN_EXPORT_JS), 10000)); } catch {}\\n  }\\n  const nLs = Object.keys(store.ls || {}).length;\\n  const nIdb = (store.idb || []).reduce((s2, d) => s2 + d.stores.reduce((t, st) => t + st.items.length, 0), 0);\\n  if (!list.length && !nLs && !nIdb) { showError('Login para o celular', 'Esta conta não está logada no jogo.'); return; }\\n  const texto = JSON.stringify({\\n    v: 2,\\n    cookies: list.map((k) => ({ name: k.name, value: k.value, domain: k.domain, path: k.path, secure: k.secure, httpOnly: k.httpOnly, expirationDate: k.expirationDate })),\\n    ls: store.ls || {},\\n    idb: store.idb || [],\\n  });\\n  clipboard.writeText(texto);\\n  uiDialog({\\n    type: texto.length > 60000 ? 'warning' : 'info', title: 'Login para o celular', message: 'Login copiado.',\\n    detail: `${nameOf(i)}: ${list.length} cookie(s), ${nLs} item(ns) de armazenamento e ${nIdb} registro(s) de banco da página.\\\\n\\\\n` +\\n      'No PokeLink Lite: escolha a conta, toque em \\\"Login\\\" e cole.' +\\n      (texto.length > 60000 ? `\\\\n\\\\nO texto ficou grande (${Math.round(texto.length / 1000)} mil letras). Se o WhatsApp cortar, mande como arquivo .txt (cole no Bloco de Notas, salve e envie).` : ''),\\n  });\\n}\\n// lê o armazenamento da página do jogo (prioriza o que parece ser login)\\nconst LOGIN_EXPORT_JS = `(async () => {\\n  const pri = /auth|token|session|user|login|firebase|sb-|supabase|jwt|account|conta|cred/i;\\n  const ls = {}; let size = 0;\\n  const keys = Object.keys(localStorage).sort((a, b) => (pri.test(b) ? 1 : 0) - (pri.test(a) ? 1 : 0));\\n  for (const k of keys) {\\n    const v = localStorage.getItem(k);\\n    if (v == null || v.length > 40000) continue;\\n    if (!pri.test(k) && size + v.length > 30000) continue;\\n    ls[k] = v; size += k.length + v.length;\\n  }\\n  const idb = [];\\n  try {\\n    const dbs = (indexedDB.databases ? await indexedDB.databases() : []).filter((d) => pri.test(d.name || ''));\\n    for (const d of dbs) {\\n      const r = await new Promise((res, rej) => { const q = indexedDB.open(d.name); q.onsuccess = () => res(q.result); q.onerror = () => rej(q.error); });\\n      const out = { name: d.name, version: r.version, stores: [] };\\n      for (const sn of r.objectStoreNames) {\\n        const st = r.transaction(sn, 'readonly').objectStore(sn);\\n        const vals = await new Promise((res) => { const q = st.getAll(); q.onsuccess = () => res(q.result); q.onerror = () => res([]); });\\n        const st2 = r.transaction(sn, 'readonly').objectStore(sn);\\n        const ks = await new Promise((res) => { const q = st2.getAllKeys(); q.onsuccess = () => res(q.result); q.onerror = () => res([]); });\\n        out.stores.push({ name: sn, keyPath: st.keyPath, autoIncrement: st.autoIncrement, items: vals.slice(0, 200).map((v, n) => ({ key: ks[n], value: v })) });\\n      }\\n      r.close();\\n      idb.push(out);\\n    }\\n  } catch (e) {}\\n  return JSON.stringify({ ls, idb });\\n})()`;\\n\\n// ---------- Ver no celular (PokeLink Monitor) ----------\\n// Manda um RESUMO das contas (o mesmo do Mega Eco) para um banco de dados online (Firebase), guardado sob um\\n// código aleatório. No celular, a página do PokeLink Monitor mostra esse resumo de qualquer lugar.\\n// O celular só LÊ: só o PokeLink deste PC consegue gravar no código dele (login anônimo do Firebase).\\n// Começa DESLIGADO. Nada do jogo é mandado para o servidor do jogo: o PokeLink só lê a tela, como no Mega Eco.\\nconst MONITOR_DB = 'https://pokelink-monitor-default-rtdb.firebaseio.com';\\nconst MONITOR_KEY = 'AIzaSyAGo6qRvEUBXKTsAFZXFF94_zeO7CTIuYY'; // chave pública do app (não é senha)\\nconst MONITOR_SITE = 'https://znationsx.github.io/pokelink-monitor/';\\nconst MONITOR_MIN = 2; // envia a cada 2 minutos\\nconst monitor = { ligado: false, codigo: '', refresh: '', uid: '', token: '', tokenAte: 0, ultimo: 0, erro: '', enviando: false,\\n  avisos: [], cache: ACCOUNTS.map(() => null), vistos: ACCOUNTS.map(() => null), codigoNovo: false };\\nconst monitorFile = () => path.join(app.getPath('userData'), 'celular.json');\\nfunction loadMonitor() {\\n  try {\\n    const j = JSON.parse(fs.readFileSync(monitorFile(), 'utf8'));\\n    monitor.ligado = !!j.ligado;\\n    if (typeof j.codigo === 'string' && /^[A-Z0-9]{20,}$/.test(j.codigo)) monitor.codigo = j.codigo;\\n    if (typeof j.refresh === 'string') monitor.refresh = j.refresh;\\n    if (typeof j.uid === 'string') monitor.uid = j.uid;\\n    if (Array.isArray(j.avisos)) monitor.avisos = j.avisos.slice(0, 30);\\n  } catch {}\\n  if (monitor.ligado && !monitor.codigo) monitor.ligado = false;\\n}\\nconst saveMonitor = () => { try { fs.writeFileSync(monitorFile(), JSON.stringify({ ligado: monitor.ligado, codigo: monitor.codigo, refresh: monitor.refresh, uid: monitor.uid, avisos: monitor.avisos })); } catch {} };\\n// código de 20 letras/números (sem 0/O, 1/I): impossível de adivinhar\\nfunction novoCodigo() {\\n  const A = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\\n  return [...require('crypto').randomBytes(20)].map((b) => A[b % 32]).join('');\\n}\\nconst avisarMonitor = () => { if (titleBar && !titleBar.webContents.isDestroyed()) titleBar.webContents.send('monitor-update'); };\\n// guarda um aviso para a tela \\\"Avisos\\\" do celular (só quando a função está ligada)\\nfunction avisoCelular(tipo, titulo, texto) {\\n  if (!monitor.ligado) return;\\n  monitor.avisos.unshift({ tipo, titulo, texto, em: Date.now() });\\n  monitor.avisos.length = Math.min(monitor.avisos.length, 30);\\n  saveMonitor();\\n}\\n// login anônimo no Firebase (fica guardado; renova sozinho)\\nasync function monitorLogin() {\\n  if (monitor.token && Date.now() < monitor.tokenAte - 60000) return monitor.token;\\n  const ses = checkSession();\\n  if (monitor.refresh) {\\n    const r = await withTimeout(ses.fetch(`https://securetoken.googleapis.com/v1/token?key=${MONITOR_KEY}`, {\\n      method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' },\\n      body: 'grant_type=refresh_token&refresh_token=' + encodeURIComponent(monitor.refresh),\\n    }), 15000);\\n    if (r.ok) {\\n      const j = await r.json();\\n      Object.assign(monitor, { token: j.id_token, refresh: j.refresh_token, uid: j.user_id, tokenAte: Date.now() + Number(j.expires_in || 3600) * 1000 });\\n      saveMonitor();\\n      return monitor.token;\\n    }\\n  }\\n  const r = await withTimeout(ses.fetch(`https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=${MONITOR_KEY}`, {\\n    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ returnSecureToken: true }),\\n  }), 15000);\\n  if (!r.ok) throw new Error(`o servidor recusou o login (${r.status}). Confira se o login anônimo está ativado no Firebase`);\\n  const j = await r.json();\\n  Object.assign(monitor, { token: j.idToken, refresh: j.refreshToken, uid: j.localId, tokenAte: Date.now() + Number(j.expiresIn || 3600) * 1000 });\\n  saveMonitor();\\n  return monitor.token;\\n}\\n// transforma o resumo do Mega Eco de uma conta no formato pequeno que o celular mostra\\nfunction celConta(i, d, status) {\\n  const num = (t) => { const n = Number(String(t == null ? '' : t).replace('−', '-').replace(/\\\\./g, '').replace(',', '.').replace(/[^\\\\d.-]/g, '')); return isFinite(n) ? n : 0; };\\n  const curto = (n) => { n = Number(n) || 0; const a = Math.abs(n);\\n    return a >= 1e9 ? (n / 1e9).toFixed(1).replace('.', ',') + 'B' : a >= 1e6 ? (n / 1e6).toFixed(1).replace('.', ',') + 'M' : a >= 1e3 ? (n / 1e3).toFixed(1).replace('.', ',') + 'k' : String(Math.round(n)); };\\n  const hora = (t) => (t ? new Date(t).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) : '');\\n  const s = d.ses || {}, e = d.eco || {};\\n  const h = (s.ms || 0) / 3600000;\\n  const porH = (v) => (h > 0.02 ? (Number(v) || 0) / h : 0);\\n  const ritmo = (l, v) => (l && /\\\\/h$/.test(l[2] || '') ? num(l[2]) : porH(v));\\n  const tile = (l, v) => ({\\n    v: l && l[1] ? (/^[\\\\d.,−-]+$/.test(l[1]) && Math.abs(num(l[1])) >= 1e6 ? curto(num(l[1])) : l[1]) : curto(v),\\n    h: curto(ritmo(l, v)),\\n  });\\n  const hp = String((d.pk && d.pk.hp) || '').match(/([\\\\d.]+)\\\\s*\\\\/\\\\s*([\\\\d.]+)/);\\n  const sprite = d.pk && d.pk.sprite && d.pk.sprite.length < 20000 ? d.pk.sprite : null;\\n  const caps = (e.caps || []).length\\n    ? e.caps.slice(0, 5).map((c) => {\\n      const ls = c.linhas || [];\\n      return { img: c.img || null, nome: ls[0] || '', nv: ls.find((x) => /^Nv\\\\s*\\\\d/.test(x)) || '', hora: ls.find((x) => /^\\\\d{1,2}:\\\\d{2}$/.test(x)) || '',\\n        info: ls.filter((x) => /^(IV\\\\s|Q\\\\s)/.test(x)).join(' · '), shiny: /shiny|✨/i.test(ls.join(' ')) };\\n    })\\n    : (d.caps || []).slice(0, 5).map((c) => ({ img: null, nome: c.nome || '', nv: c.lv ? 'Nv ' + c.lv : '', hora: hora(c.em), info: '', shiny: !!c.shiny }));\\n  const kick = lives.kick[i] ? LIVE_CHANNELS.kick.map((slug) => {\\n    const p = kickPts[i][slug] && kickPts[i][slug].pts != null ? kickPts[i][slug].pts : kickAll[i][slug];\\n    return { slug, pts: p == null ? null : p, aberta: liveOpen[i].kick.has(slug) };\\n  }).filter((k) => k.pts != null).sort((a, b) => b.pts - a.pts).slice(0, 3) : null;\\n  const j = jogoInfo[i];\\n  return {\\n    n: i + 1, nick: d.nick || nameOf(i), nivel: d.nivel || '', status, modo: LEVELS[level[i]] ? LEVELS[level[i]].name : '',\\n    ouro: curto(num(d.ouro)), gemas: curto(num(d.gemas)), diam: curto(num(d.diamantes)),\\n    hunt: d.hunt || '', tempo: e.tempo || '',\\n    pk: { nome: (d.pk && d.pk.nome) || '', lv: (d.pk && d.pk.lv) || '', hp: hp ? Math.round(Math.max(0, Math.min(100, (num(hp[1]) / Math.max(1, num(hp[2]))) * 100))) : null, img: sprite },\\n    xpT: tile(e.xpT, s.xpTreinador), xpP: tile(e.xpP, s.xpPokemon), lucro: tile(e.lucro, s.gold), abates: tile(e.abates, s.abates), capturas: tile(e.capturas, s.capturas),\\n    ouroH: Math.round(ritmo(e.lucro, s.gold)), xpH: Math.round(ritmo(e.xpT, s.xpTreinador)), capsN: num(e.capturas && e.capturas[1]) || Number(s.capturas) || 0,\\n    gastos: (e.gastos || []).slice(0, 6), achados: (e.achados || []).slice(0, 6), caps,\\n    ativos: (d.ativos || []).slice(0, 6).map((a) => `${a.nome} ${a.valor}`.replace(/\\\\s+/g, ' ').trim()),\\n    auto: auto.enabled[i] ? autoStatus[i] : null,\\n    troca: autoHunt.contas[i] ? huntStatus[i] : null,\\n    kick, twitch: lives.twitch[i] ? ((j && j.twitch && j.twitch.contando) || []).slice(0, 5) : null,\\n    exts: EXTENSIONS.filter((x) => !extOff.has(x.id)).map((x) => ({ nome: x.botao || x.nome.replace(/ for PokeIdle$/i, ''), ok: extNaConta(x.id, i) })),\\n  };\\n}\\n// shiny novo no histórico de capturas da conta vira aviso no celular\\nfunction celShiny(i, caps) {\\n  const lista = (caps || []).filter((c) => c && c.shiny);\\n  const chaves = lista.map((c) => `${c.nome}|${c.em}`);\\n  if (!monitor.vistos[i]) { monitor.vistos[i] = new Set(chaves); return; } // 1ª leitura: só guarda\\n  lista.forEach((c, k) => {\\n    if (monitor.vistos[i].has(chaves[k])) return;\\n    monitor.vistos[i].add(chaves[k]);\\n    avisoCelular('shiny', 'Shiny capturado', `${nameOf(i)}: ${c.nome}${c.lv ? ' Nv ' + c.lv : ''}.`);\\n  });\\n}\\nasync function monitorDados() {\\n  const contas = await Promise.all(views.map(async (v, i) => {\\n    const wc = v && v.webContents;\\n    const viva = wc && !wc.isDestroyed();\\n    let d = null;\\n    if (!sono.ausente && viva && !wc.isLoading()) d = await withTimeout(wc.executeJavaScript(RESUMO_JS), 5000).catch(() => null);\\n    const status = sono.ausente ? 'pausado' : !viva ? 'fechada' : travada[i] ? 'travada' : wc.isLoading() ? 'carregando' : !d ? 'sem resposta' : !d.nick ? 'sem login' : d.hunt ? 'farmando' : 'parada';\\n    if (!d || !d.nick) return Object.assign({}, monitor.cache[i] || { n: i + 1, nick: nameOf(i) }, { status, antigo: !!monitor.cache[i] });\\n    celShiny(i, d.caps);\\n    return (monitor.cache[i] = celConta(i, d, status));\\n  }));\\n  return { v: 1, at: { '.sv': 'timestamp' }, versao: APP_VERSION, pausado: !!sono.ausente, intervalo: MONITOR_MIN, contas, avisos: monitor.avisos.slice(0, 20) };\\n}\\nasync function monitorEnviar(forcar) {\\n  if (!monitor.ligado || monitor.enviando || !monitor.codigo) return;\\n  if (!forcar && Date.now() - monitor.ultimo < MONITOR_MIN * 60000 - 5000) return;\\n  monitor.enviando = true;\\n  avisarMonitor();\\n  try {\\n    const corpo = await monitorDados();\\n    for (let tent = 0; ; tent++) {\\n      const tok = await monitorLogin();\\n      corpo.dono = monitor.uid;\\n      const r = await withTimeout(checkSession().fetch(`${MONITOR_DB}/m/${monitor.codigo}.json?auth=${encodeURIComponent(tok)}`, {\\n        method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo),\\n      }), 20000);\\n      if (r.ok) { monitor.ultimo = Date.now(); monitor.erro = ''; return; }\\n      if (r.status === 401 && tent === 0) { monitor.token = ''; continue; } // login vencido: renova e tenta de novo\\n      if (r.status === 401 && tent === 1) { // o código ficou com outro login (ex.: o login foi refeito): cria um código novo\\n        monitor.codigo = novoCodigo(); monitor.codigoNovo = true; saveMonitor(); continue;\\n      }\\n      throw new Error('o servidor respondeu ' + r.status);\\n    }\\n  } catch (e) {\\n    monitor.erro = e.message;\\n  } finally {\\n    monitor.enviando = false;\\n    avisarMonitor();\\n  }\\n}\\nasync function monitorApagar(codigo) {\\n  if (!codigo) return;\\n  try {\\n    const tok = await monitorLogin();\\n    await withTimeout(checkSession().fetch(`${MONITOR_DB}/m/${codigo}.json?auth=${encodeURIComponent(tok)}`, { method: 'DELETE' }), 15000);\\n  } catch {}\\n}\\nfunction monitorEstado() {\\n  return {\\n    ligado: monitor.ligado, codigo: monitor.codigo, codigoFmt: (monitor.codigo.match(/.{1,4}/g) || []).join('-'),\\n    link: monitor.codigo ? MONITOR_SITE + '#' + monitor.codigo : '', site: MONITOR_SITE,\\n    ultimo: monitor.ultimo ? new Date(monitor.ultimo).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) : '',\\n    erro: monitor.erro, enviando: monitor.enviando, min: MONITOR_MIN, codigoNovo: monitor.codigoNovo,\\n  };\\n}\\nipcMain.handle('monitor-get', () => monitorEstado());\\nipcMain.handle('monitor-acao', async (_, acao) => {\\n  monitor.codigoNovo = false;\\n  if (acao === 'ligar') {\\n    if (!monitor.codigo) monitor.codigo = novoCodigo();\\n    monitor.ligado = true; saveMonitor();\\n    await monitorEnviar(true);\\n  } else if (acao === 'desligar') {\\n    monitor.ligado = false; monitor.erro = ''; saveMonitor();\\n    await monitorApagar(monitor.codigo); // o resumo some do servidor\\n  } else if (acao === 'trocar') {\\n    const velho = monitor.codigo;\\n    monitor.codigo = novoCodigo(); saveMonitor();\\n    await monitorApagar(velho); // o código antigo para de funcionar\\n    if (monitor.ligado) await monitorEnviar(true);\\n  } else if (acao === 'agora') {\\n    await monitorEnviar(true);\\n  }\\n  buildMenu();\\n  return monitorEstado();\\n});\\nfunction showMonitor() {\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (!canDraw) return;\\n  const id = ++cfgPanelSeq;\\n  cfgPanels.add(id);\\n  dialogOpen = true;\\n  layout();\\n  titleBar.webContents.focus();\\n  titleBar.webContents.send('title-monitor', { id });\\n}\\n\\n// ---------- Termos de Uso (aceite obrigatório na 1ª vez e quando os termos mudarem) ----------\\n// Mude TERMS_VERSION sempre que alterar o texto: todo mundo terá de aceitar de novo.\\nconst TERMS_VERSION = '2';\\nconst TERMS_TEXT = [\\n  'TERMOS DE USO DO POKELINK',\\n  '',\\n  '1. O que é o PokeLink',\\n  'O PokeLink é um programa independente e não oficial, criado por Nations, que reúne contas do jogo PokeIdle em uma única janela. Ele não tem vínculo com a equipe do PokeIdle, com a Nintendo, Game Freak, Creatures, The Pokémon Company, Twitch, Kick ou Google. Todas as marcas citadas pertencem aos seus donos.',\\n  '',\\n  '2. Uso por sua conta e risco',\\n  'Funções automáticas (Auto Compra, abertura automática de lives, extensões e outras) podem não ser permitidas pelas regras do jogo ou das plataformas. Cabe a você conferir essas regras antes de usar. Advertências, suspensões, banimentos, perdas de itens, ouro, pontos ou progresso decorrentes do uso do PokeLink são de sua inteira responsabilidade.',\\n  '',\\n  '3. Suas contas e a segurança delas',\\n  'Os logins que você faz no PokeLink (jogo, Twitch, Kick e outros) ficam guardados apenas no seu computador. O desenvolvedor não recebe, não armazena e não tem acesso às suas senhas ou sessões. A segurança das contas é responsabilidade sua, incluindo: manter o computador livre de vírus e programas maliciosos, não compartilhar senhas e não compartilhar os textos de login exportados pelo PokeLink (eles dão acesso à conta).',\\n  '',\\n  '4. Seus dados',\\n  'O PokeLink não envia seus dados pessoais ao desenvolvedor. Para funcionar, ele se comunica diretamente com: pokeidle.io (o jogo e o tracker), Twitch, Kick, Chrome Web Store (extensões) e o endereço de atualizações do PokeLink. Cada um desses serviços tem suas próprias políticas de privacidade.',\\n  '',\\n  'Ver no celular (opcional, desligado por padrão): se você ligar essa função, um resumo das suas contas (nick, nível, ouro, XP, capturas, hunt atual, pontos das lives e avisos) é enviado a cada 2 minutos para um banco de dados do Google Firebase usado pelo PokeLink. O resumo fica guardado sob um código aleatório que só você conhece e pode ser visto por quem tiver esse código. Senhas e logins nunca são enviados. Ao desligar a função ou trocar o código, o resumo é apagado do servidor.',\\n  '',\\n  '5. Sem garantias',\\n  'O PokeLink foi testado, mas é fornecido \\\"no estado em que se encontra\\\", sem garantia de que funcionará sem erros, sem interrupções ou de que continuará compatível com o jogo e com as plataformas, que podem mudar a qualquer momento.',\\n  '',\\n  '6. Limitação de responsabilidade',\\n  'Na máxima extensão permitida pela lei, o desenvolvedor não se responsabiliza por danos diretos ou indiretos decorrentes do uso ou da impossibilidade de uso do PokeLink, incluindo perda ou invasão de contas, vazamento de dados causado por vírus, programas maliciosos, compartilhamento de logins ou falhas de segurança do seu computador, e ações de terceiros (jogo, plataformas, extensões).',\\n  '',\\n  '7. Extensões de terceiros',\\n  'As extensões que o PokeLink baixa da Chrome Web Store são feitas por terceiros. O desenvolvedor do PokeLink não controla nem responde pelo funcionamento delas. Você pode desativá-las em Ajuda > Extensões.',\\n  '',\\n  '8. Atualizações',\\n  'O PokeLink procura e instala atualizações assinadas pelo desenvolvedor. Ao usar o programa, você concorda em recebê-las.',\\n  '',\\n  '9. Mudanças nestes termos',\\n  'Estes termos podem mudar. Quando isso acontecer, o PokeLink pedirá um novo aceite. Se você não concordar, deve parar de usar o programa.',\\n  '',\\n  'Ao clicar em \\\"Aceitar\\\", você declara que leu, entendeu e concorda com estes Termos de Uso.',\\n].join('\\\\n');\\n// ---------- Novidades (patch notes) ----------\\n// As novidades de cada atualização ficam AQUI. Elas aparecem sozinhas uma vez, na primeira vez que o\\n// PokeLink abre numa versão nova (só para quem já usava; quem acabou de instalar vê os Termos de Uso).\\n// Também dá para abrir em Atualizações > Ver novidades. **texto** vira negrito.\\nconst NOVIDADES_HIST = [\\n{\\n  versao: '2.1',\\n  data: '21/10/2026',\\n  selo: 'ATUALIZAÇÃO',\\n  titulo: 'SUAS CONTAS NO CELULAR',\\n  cartoes: [\\n    { icone: '📱', valor: '2 min', nome: 'resumo no celular', sub: 'de qualquer lugar' },\\n    { icone: '🔔', valor: '6', nome: 'tipos de aviso', sub: 'travou, Kick, shiny...' },\\n    { icone: '🗺️', valor: 'auto', nome: 'troca de hunt', sub: 'segue a /hunt' },\\n  ],\\n  resumo: 'Agora dá para **acompanhar as 4 contas pelo celular**, de qualquer lugar: nível, ouro, XP, capturas, hunt atual, pontos das lives e avisos. E as contas podem **trocar de hunt sozinhas**, seguindo a recomendação da extensão /hunt.',\\n  destaque: 'Abra **Contas > Ver no celular**, clique em **Ligar** e aponte a câmera do celular para o QR code. Pronto!',\\n  paginas: [\\n    { titulo: 'VER NO CELULAR', itens: [\\n      '**Como ligar:** Contas > Ver no celular > Ligar. Leia o QR code com a câmera do celular, ou abra **znationsx.github.io/pokelink-monitor** e digite o código.',\\n      '**Resumo das 4 contas:** ouro/h, XP/h e capturas somados, e um cartão por conta com a hunt atual e se ela está farmando.',\\n      '**Detalhe de cada conta:** toque numa conta para ver ouro, gemas, pokémon em campo, sessão, últimas capturas, pontos da Kick e os automáticos.',\\n      '**Avisos:** conta travada e reiniciada, meta da Kick, shiny capturado, hunt trocada, Auto Compra parada e farm pausado.',\\n      '**Só para ver:** pelo celular não dá para mexer em nada. Atualiza a cada 2 minutos, com o PC ligado e o PokeLink aberto.',\\n      '**Dica:** no celular, use \\\"Adicionar à tela inicial\\\" para virar um ícone, como um app.',\\n    ] },\\n    { titulo: 'SEGURANÇA DO CELULAR', itens: [\\n      '**Desligado por padrão:** nada é enviado até você clicar em Ligar.',\\n      '**Código só seu:** o resumo fica guardado sob um código aleatório de 20 letras e números. Só quem tem o código vê.',\\n      '**Trocar código:** se alguém viu o seu código, um clique cria outro e o antigo para de funcionar.',\\n      '**Senhas nunca saem do PC:** só o resumo é enviado. Ao desligar, o resumo é apagado do servidor.',\\n      '**Termos de Uso atualizados** com essa função. Por isso eles aparecem de novo para você aceitar.',\\n    ] },\\n    { titulo: 'TROCA DE HUNT AUTOMÁTICA', itens: [\\n      '**Botão novo na barra de cada conta:** \\\"Troca de hunt\\\". Clique no nome para ligar ou desligar naquela conta; a setinha abre as configurações.',\\n      '**Como funciona:** o PokeLink lê o ranking da /hunt e leva a conta para a melhor hunt, pelo Mapa, como um jogador faria.',\\n      '**Você escolhe:** mais XP/h ou mais ouro/h, risco máximo, quanto a hunt nova precisa ganhar e de quanto em quanto tempo conferir.',\\n      '**Seguro:** só hunts liberadas, nunca em combate nem com uma janela do jogo aberta, e espera 10 minutos entre trocas para não ficar pulando.',\\n      '**Por conta:** cada conta liga separada, e todas começam desligadas. O botão \\\"Conferir agora\\\" testa na hora.',\\n    ] },\\n    { titulo: 'OUTRAS MUDANÇAS', itens: [\\n      '**Menus mais organizados:** ajustes da Kick e da Twitch e os logins ficaram agrupados no menu Lives, e o tamanho do jogo e a tela cheia foram para Contas. O número de lives em cima do menu Lives saiu.',\\n      '**Tela e energia:** a opção \\\"Deixar a tela apagar\\\" saiu do menu Desempenho. A tela e o descanso do PC agora seguem só as configurações do Windows.',\\n      '**Novidades sempre aparecem:** antes, quando os Termos de Uso mudavam, quem atualizava não via este card. Corrigido.',\\n      '**Histórico:** use o seletor no topo deste card para ver as novidades das versões anteriores.',\\n    ] },\\n  ],\\n  botao: 'JOGAR',\\n},\\n{\\n  versao: '2.0',\\n  data: '20/10/2026',\\n  selo: 'ATUALIZAÇÃO',\\n  titulo: 'LIVES MAIS LEVES E MAIS ESPERTAS',\\n  cartoes: [\\n    { icone: '📺', valor: '−55%', nome: 'memória da Kick', sub: 'player pequeno' },\\n    { icone: '💬', valor: '−80%', nome: 'memória da Twitch', sub: 'conexão direta' },\\n    { icone: '⚡', valor: '20 s', nome: 'para abrir a live', sub: 'lista direto do jogo' },\\n  ],\\n  resumo: 'Agora o PokeLink sabe **direto do jogo** quais são os canais oficiais e quem está ao vivo. As lives abrem mais rápido, gastam bem menos memória, ex-parceiros somem sozinhos e as contas travadas se recuperam sem precisar fechar o programa.',\\n  destaque: 'Bloqueou o PC (Windows+L)? Agora **a tela apaga normalmente e o farm continua** rodando por trás. Ao voltar, tudo aparece de novo.',\\n  paginas: [\\n    { titulo: 'LIVES PELO JOGO', itens: [\\n      '**Lista oficial direto do jogo:** os canais parceiros e quem está ao vivo chegam pela própria conexão do jogo, sempre atualizados.',\\n      '**Lives abrem em até 20 segundos** quando um canal entra no ar (antes podia levar até 3 minutos).',\\n      '**Sem página escondida da Kick:** a verificação que abria o site inteiro da Kick a cada 3 minutos acabou, e com ela os picos de processador.',\\n      '**Twitch confirmada pelo jogo:** o painel Lives mostra \\\"✓ o jogo já está contando o bônus em: ...\\\" para você ter certeza de que está valendo.',\\n      '**Plano B:** se o jogo parar de informar as lives, o PokeLink volta sozinho para o jeito antigo de verificar. Nada para de funcionar.',\\n    ] },\\n    { titulo: 'EX-PARCEIROS', itens: [\\n      '**Saem sozinhos:** quem deixou de ser parceiro oficial some da lista, a live fecha e sai da seleção \\\"Ativado\\\". Quem voltar a ser parceiro volta sozinho.',\\n      '**Tirar à mão:** um **×** em cada canal no painel de Pontos da Kick e na nova seção \\\"Canais oficiais\\\" do painel Lives (Twitch e Kick).',\\n      '**Trazer de volta:** os removidos ficam riscados em \\\"Removidos da lista\\\", com um clique para voltar. Se você trouxer de volta, a remoção automática não mexe mais nele.',\\n      '**Conferir lista:** botão novo no painel Lives. Se o jogo não informar a lista, o PokeLink abre o painel de bônus escondido ao abrir e a cada 3 horas, sem atrapalhar.',\\n    ] },\\n    { titulo: 'KICK E TWITCH MAIS LEVES', itens: [\\n      '**Kick com player pequeno:** só o vídeo, num tamanho menor, em vez da página inteira. Gasta bem menos memória e internet.',\\n      '**Plano B da Kick:** se numa conta os pontos não subirem em 15 minutos, aquela conta volta sozinha para a página inteira. Escolha em Lives > Lives da Kick.',\\n      '**Saldo da Kick direto da Kick:** os pontos são consultados com o login da conta, sem ler de dentro da live, e os canais offline também são atualizados a cada 15 minutos.',\\n      '**Twitch automática (novo padrão):** uma única conexão de chat por conta, sem nenhuma página aberta. Se o jogo não contar o bônus em 12 minutos, a conta volta sozinha para a página do chat.',\\n      'As trocas automáticas ficam anotadas no arquivo **travamentos.log**, dizendo qual conta mudou e por quê.',\\n    ] },\\n    { titulo: 'TELA E ENERGIA', itens: [\\n      '**A tela apaga com o farm rodando:** ao bloquear o PC ou ficar sem mexer até o horário de a tela apagar, o PokeLink esconde a janela e o Windows apaga o monitor. O jogo e as lives continuam.',\\n      '**Volta na hora:** ao desbloquear ou mexer no mouse/teclado, a janela aparece de novo em até 2 segundos.',\\n      '**Kick contando com a tela apagada:** as lives da Kick continuam se considerando visíveis com a janela escondida.',\\n      '**Opção em Desempenho:** \\\"Deixar a tela apagar (o farm continua)\\\", ligada por padrão.',\\n      '**Pausar o farm para o PC dormir:** opção nova (desligada por padrão). Segue o tempo de suspensão do Windows e, ao voltar, as contas recarregam sozinhas.',\\n    ] },\\n    { titulo: 'ESTABILIDADE', itens: [\\n      '**Vigia anti-travamento:** a cada 30 segundos o PokeLink confere se cada conta responde. Se uma conta congelar, só ela é reiniciada sozinha, sem fechar o programa.',\\n      '**Sem pedidos presos:** a leitura do nome da conta e a Auto Compra agora têm limite de tempo. Uma conta travada não acumula pedidos nem deixa a Auto Compra parada para sempre.',\\n      '**Leitura mais leve dos canais:** a busca de canais só varre a tela quando o painel de bônus está aberto (antes pesava cada vez mais com o jogo aberto por horas).',\\n      '**Registro de travamentos:** cada travamento e recuperação fica anotado no **travamentos.log**, na pasta de dados do PokeLink.',\\n    ] },\\n    { titulo: 'PAINÉIS E FERRAMENTAS', itens: [\\n      '**Uso de CPU e memória em cartões:** desce dentro da janela, com cada conta e cada grupo num cartão. **Verde** ok, **amarelo** médio e **vermelho** alto. Atualiza sozinho a cada 5 segundos.',\\n      '**Medição correta:** agora mostra a memória real de cada parte (a mesma do Gerenciador de Tarefas), quanto gasta cada live e o grupo \\\"Outros\\\", com o que tem dentro.',\\n      '**Extensões por conta:** o painel de Extensões mostra em quais contas cada extensão carregou (bolinha verde ou vermelha).',\\n      '**Reparar só nesta conta:** se uma extensão não funcionar numa conta, ela é tirada, limpa e colocada de novo só ali. O login do jogo e as outras contas não mudam.',\\n      '**Novidades:** este card aparece uma vez a cada versão nova e pode ser aberto de novo em Atualizações > Ver novidades desta versão.',\\n    ] },\\n  ],\\n  botao: 'JOGAR',\\n},\\n];\\nconst novidadesFile = () => path.join(app.getPath('userData'), 'novidades.json');\\nfunction showNovidades() {\\n  const canDraw = titleBar && !titleBar.webContents.isDestroyed() && win && !win.isFullScreen() && !win.isMinimized();\\n  if (!canDraw) return false;\\n  const id = ++cfgPanelSeq;\\n  cfgPanels.add(id);\\n  dialogOpen = true;\\n  layout();\\n  titleBar.webContents.focus();\\n  const k = Math.max(0, NOVIDADES_HIST.findIndex((n) => n.versao === APP_VERSION));\\n  titleBar.webContents.send('title-novidades', { id, canal: APP_CHANNEL, atual: k,\\n    lista: NOVIDADES_HIST.map((n) => Object.assign({}, n, { versao: `v${n.versao}${APP_CHANNEL ? ' ' + APP_CHANNEL : ''}` })) });\\n  try { fs.writeFileSync(novidadesFile(), JSON.stringify({ versao: APP_VERSION })); } catch {}\\n  return true;\\n}\\n// mostra uma vez por versão; quem acabou de instalar só marca como vista\\nfunction talvezNovidades(jaUsava) {\\n  let vista = null;\\n  try { vista = JSON.parse(fs.readFileSync(novidadesFile(), 'utf8')).versao; } catch {}\\n  if (vista === APP_VERSION) return;\\n  if (!jaUsava) { try { fs.writeFileSync(novidadesFile(), JSON.stringify({ versao: APP_VERSION })); } catch {} return; }\\n  setTimeout(showNovidades, 2500);\\n}\\nconst termsFile = () => path.join(app.getPath('userData'), 'termos.json');\\nconst termsAccepted = () => { try { return JSON.parse(fs.readFileSync(termsFile(), 'utf8')).versao === TERMS_VERSION; } catch { return false; } };\\nasync function askTerms() {\\n  if (termsAccepted()) return true;\\n  for (;;) {\\n    const r = await uiDialog({\\n      type: 'info',\\n      title: 'Termos de Uso',\\n      message: 'Antes de começar, leia e aceite os Termos de Uso',\\n      detail: TERMS_TEXT,\\n      form: [{ id: 'li', label: 'Li e aceito os Termos de Uso', type: 'check', value: false }],\\n      buttons: ['Aceitar', 'Recusar e sair'],\\n      defaultId: 0,\\n      cancelId: 1,\\n    });\\n    if (r.response !== 0) { app.quit(); return false; }\\n    if (r.values && r.values.li) {\\n      try { fs.writeFileSync(termsFile(), JSON.stringify({ versao: TERMS_VERSION, em: new Date().toISOString(), app: APP_VERSION })); } catch {}\\n      return true;\\n    }\\n    await uiDialog({ type: 'warning', title: 'Termos de Uso', message: 'Marque \\\"Li e aceito os Termos de Uso\\\" para continuar.' });\\n  }\\n}\\nfunction showTerms() {\\n  uiDialog({ type: 'info', title: 'Termos de Uso', message: 'Termos de Uso do PokeLink', detail: TERMS_TEXT });\\n}\\n\\n// ---------- Janela ----------\\nfunction createWindow() {\\n  loadRef();\\n  loadNicks();\\n  loadAuto();\\n  loadAutoHunt();\\n  loadLives();\\n  loadLearnedChannels();\\n  loadRemovidos();\\n  loadSono();\\n  loadMonitor();\\n  win = new BaseWindow({\\n    width: 1600, height: 900, title: APP_NAME, backgroundColor: '#15151a',\\n    titleBarStyle: 'hidden', // esconde a barra nativa (título + menu)\\n    titleBarOverlay: { color: TITLE_BG, symbolColor: TITLE_FG, height: TITLE_H }, // mantém min/max/fechar\\n  });\\n\\n  views = ACCOUNTS.map((name, i) => {\\n    const view = new WebContentsView({\\n      webPreferences: {\\n        partition: `persist:conta${i + 1}`, // cookies/login próprios de cada conta\\n        backgroundThrottling: false,        // não pausa quando a view não está visível\\n      },\\n    });\\n    view.webContents.on('did-fail-load', () => {}); // ignora recursos bloqueados (ex: tracker)\\n    // ignora o \\\"tem certeza que quer sair desta página?\\\" do jogo (ele bloqueava o recarregar)\\n    view.webContents.on('will-prevent-unload', (e) => e.preventDefault());\\n    // se a página da conta travar de vez ou fechar sozinha, carrega de novo\\n    view.webContents.on('render-process-gone', (_, d) => {\\n      if (d.reason !== 'clean-exit' && !view.webContents.isDestroyed()) setTimeout(() => view.webContents.loadURL(GAME_URL).catch(() => {}), 1000);\\n    });\\n    view.webContents.on('unresponsive', () => { if (!travada[i]) { travada[i] = Date.now(); logTravamento(`${nameOf(i)} parou de responder`); } });\\n    view.webContents.on('responsive', () => { if (travada[i]) logTravamento(`${nameOf(i)} voltou sozinha`); travada[i] = null; });\\n    // mostra na barra que a conta está carregando (ícone girando)\\n    view.webContents.on('did-start-loading', () => { if (!loading[i]) { loading[i] = true; sendState(); } });\\n    view.webContents.on('did-stop-loading', () => { if (loading[i]) { loading[i] = false; sendState(); } });\\n    view.webContents.on('did-finish-load', layout);\\n    view.webContents.on('did-finish-load', () => setTimeout(() => readNick(i), 2500));\\n    view.webContents.on('did-navigate', layout);\\n    view.webContents.on('dom-ready', () => { ecoCss[i] = null; applyLevel(i); }); // reaplica o nível após recarregar\\n    devKeys(view.webContents);\\n    ligarLeituraLives(view.webContents); // lê as lives pela conexão do jogo\\n    view.webContents.loadURL(GAME_URL);\\n    win.contentView.addChildView(view);\\n    return view;\\n  });\\n\\n  bars = ACCOUNTS.map((name, i) => {\\n    const b = new WebContentsView({\\n      webPreferences: { preload: path.join(__dirname, 'preload.js') },\\n    });\\n    devKeys(b.webContents);\\n    b.webContents.loadFile(path.join(__dirname, 'bar.html'), { query: { i: String(i) } });\\n    win.contentView.addChildView(b);\\n    return b;\\n  });\\n\\n  titleBar = new WebContentsView({\\n    webPreferences: { preload: path.join(__dirname, 'preload.js') },\\n  });\\n  titleBar.setBackgroundColor('#00000000'); // transparente: quando o menu abre, o jogo continua aparecendo atrás\\n  devKeys(titleBar.webContents);\\n  titleBar.webContents.loadFile(path.join(__dirname, 'bar.html'), { query: { mode: 'title' } });\\n  // termos de uso: pede o aceite assim que a barra de cima (que desenha o pop-up) estiver pronta\\n  titleBar.webContents.once('did-finish-load', () => setTimeout(async () => {\\n    // já tinha aceitado alguma versão dos termos = já usava (atualizou) e deve ver as novidades\\n    const jaUsava = (() => { try { return fs.statSync(termsFile()).isFile(); } catch { return false; } })();\\n    if (await askTerms()) talvezNovidades(jaUsava);\\n  }, 600));\\n  win.contentView.addChildView(titleBar);\\n\\n  applyWindowIcon(); // ícone personalizado também na barra de tarefas\\n\\n  win.on('resize', layout);\\n  win.on('enter-full-screen', layout);\\n  win.on('leave-full-screen', layout);\\n  layout();\\n\\n  buildMenu();\\n\\n  startAutoBuyTimer();\\n  startAutoHuntTimer();\\n  startNickTimer();\\n\\n  // começa com as contas 2, 3 e 4 sem som\\n  muted.forEach((m, i) => views[i].webContents.setAudioMuted(m));\\n}\\n\\napp.whenReady().then(async () => {\\n  // extensões: carrega as cópias locais antes das contas abrirem e procura atualização em segundo plano\\n  const extFaltando = await loadLocalExtensions();\\n  createWindow();\\n  updateExtensions(extFaltando);\\n  win.on('closed', () => app.quit()); // fecha tudo junto (inclusive janelas de login abertas)\\n  setTimeout(checkLives, 3000); // já verifica logo ao abrir\\n  setInterval(checkLives, LIVE_CHECK_MIN * 60 * 1000);\\n  setInterval(vigiaContas, 30 * 1000); // vigia anti-travamento\\n  lerTempoWindows(); setInterval(lerTempoWindows, 10 * 60 * 1000); // tempo para dormir do Windows\\n  setInterval(checarAusencia, 30 * 1000);\\n  manterPcAcordado();\\n  lerTempoTela(); setInterval(lerTempoTela, 10 * 60 * 1000);\\n  setInterval(checarTela, 2000); // leve: só pergunta ao Windows há quanto tempo ninguém mexe\\n  powerMonitor.on('lock-screen', () => { tela.bloqueada = true; apagarTela(); });\\n  powerMonitor.on('unlock-screen', () => { tela.bloqueada = false; acenderTela(); });\\n  powerMonitor.on('resume', () => { sono.naoRepetir = false; voltarDoAusente(); }); // PC acordou\\n  powerMonitor.on('on-ac', () => { lerTempoWindows(); lerTempoTela(); }); powerMonitor.on('on-battery', () => { lerTempoWindows(); lerTempoTela(); });\\n  sampleUsage(); setInterval(sampleUsage, 5000); // mede CPU/memória de cada conta\\n  setInterval(refreshDash, 5000); // Mega Eco: atualiza o painel\\n  // canais novos: o painel \\\"Bônus Twitch/Kick\\\" é lido a cada 20 s, e a lista do servidor a cada 10 min\\n  setInterval(async () => { if (LIVE_PLATS().length && (await discoverChannels())) checkLives(); }, 20 * 1000);\\n  setInterval(learnFromApi, 10 * 60 * 1000);\\n  setTimeout(conferirListaOficial, 45 * 1000); // confere a lista oficial ao abrir (com o jogo já carregado)...\\n  setInterval(conferirListaOficial, 3 * 3600 * 1000); // ...e a cada 3 horas\\n  views.forEach((_, i) => watchGameApi(i));\\n  views.forEach((_, i) => watchKickRequests(i)); // Kick leve: corta imagens, fontes e rastreadores nas lives\\n  setTimeout(pvpCollectAll, 60 * 1000); // PvP: guarda as partidas novas de cada conta\\n  setTimeout(() => checkOnlineUpdate(false), 20 * 1000); // atualização online: confere ao abrir...\\n  setInterval(() => checkOnlineUpdate(false), UPDATE_CHECK_HOURS * 3600 * 1000); // ...e de tempos em tempos\\n  setInterval(pollKickPoints, KICK_POLL_SEC * 1000); // pontos da Kick em tempo real\\n  setInterval(pvpCollectAll, PVP_EVERY_MIN * 60 * 1000);\\n  setTimeout(() => monitorEnviar(true), 40 * 1000); // ver no celular: 1º envio com o jogo já carregado...\\n  setInterval(() => monitorEnviar(false), 30 * 1000); // ...e depois a cada 2 minutos\\n});\\napp.on('window-all-closed', () => app.quit());\",\"preload.js\":\"const { contextBridge, ipcRenderer } = require('electron');\\n\\ncontextBridge.exposeInMainWorld('api', {\\n  // barra de cada conta\\n  setLevel: (i, lv) => ipcRenderer.send('level-set', i, lv),\\n  perfMenu: (i, rect) => ipcRenderer.send('perf-menu', i, rect || null),\\n  setAuto: (i, on) => ipcRenderer.send('auto-set', i, on),\\n  setLives: (i, plat, on) => ipcRenderer.send('lives-set', i, plat, on),\\n  openAutoConfig: (rect) => ipcRenderer.send('auto-config', rect || null),\\n  onAutoCfg: (cb) => ipcRenderer.on('title-autocfg', (_, d) => cb(d)),\\n  autoCfgClosed: (id) => ipcRenderer.send('title-autocfg-closed', id),\\n  autoRunNow: (i) => ipcRenderer.send('auto-run-now', i),\\n  autoLog: () => ipcRenderer.send('auto-log'),\\n  setView: (i) => ipcRenderer.send('view-set', i),\\n  reload: (i) => ipcRenderer.send('reload-account', i),\\n  toggleMute: (i) => ipcRenderer.send('mute-toggle', i),\\n  ready: () => ipcRenderer.send('bar-ready'),\\n  onState: (cb) => ipcRenderer.on('state', (_, s) => cb(s)),\\n  // janela de configuração da Auto Compra\\n  autoGet: (defaults, conta) => ipcRenderer.invoke('autocfg-get', !!defaults, Number.isInteger(conta) ? conta : null),\\n  autoSave: (c, conta, todas) => ipcRenderer.invoke('autocfg-save', c, Number.isInteger(conta) ? conta : null, !!todas),\\n  closeSelf: () => ipcRenderer.send('close-self'),\\n  // Mega Eco (resumo do farm)\\n  onResumo: (cb) => ipcRenderer.on('resumo', (_, d) => cb(d)),\\n  resumoReady: () => ipcRenderer.send('resumo-ready'),\\n  resumoNivel: (i, lv) => ipcRenderer.send('resumo-nivel', i, lv),\\n  cenaToggle: (i) => ipcRenderer.send('cena-toggle', i),\\n  // pontos da Kick\\n  kickGet: () => ipcRenderer.invoke('kick-get'),\\n  kickRefresh: () => ipcRenderer.invoke('kick-refresh'),\\n  kickRedeem: (i) => ipcRenderer.send('kick-redeem', i),\\n  kickRedeemLive: (i, slug) => ipcRenderer.send('kick-redeem-live', i, slug),\\n  kickSel: (i, slug) => ipcRenderer.send('kick-sel', i, slug),\\n  kickAvisos: (on) => ipcRenderer.send('kick-avisos', !!on),\\n  kickOpen: (i, rect) => ipcRenderer.send('kick-open', i, rect || null),\\n  onKickPanel: (cb) => ipcRenderer.on('title-kick', (_, d) => cb(d)),\\n  onLivesPanel: (cb) => ipcRenderer.on('title-lives', (_, d) => cb(d)),\\n  onExtsPanel: (cb) => ipcRenderer.on('title-exts', (_, d) => cb(d)),\\n  onExtsUpdate: (cb) => ipcRenderer.on('exts-update', () => cb()),\\n  extGet: () => ipcRenderer.invoke('ext-get'),\\n  extAction: (id, acao) => ipcRenderer.send('ext-action', id, acao),\\n  onLivesUpdate: (cb) => ipcRenderer.on('lives-update', () => cb()),\\n  livesGet: () => ipcRenderer.invoke('lives-get'),\\n  livesCheckNow: () => ipcRenderer.invoke('lives-check-now'),\\n  kickDiag: () => ipcRenderer.invoke('kick-diag'),\\n  canalRemover: (plat, slug) => ipcRenderer.send('canal-remover', plat, slug),\\n  canalVoltar: (plat, slug) => ipcRenderer.send('canal-voltar', plat, slug),\\n  listaConferir: () => ipcRenderer.invoke('lista-conferir'),\\n  onUsoPanel: (cb) => ipcRenderer.on('title-uso', (_, d) => cb(d)),\\n  usoGet: () => ipcRenderer.invoke('uso-get'),\\n  onNovidades: (cb) => ipcRenderer.on('title-novidades', (_, d) => cb(d)),\\n  onAutoHuntPanel: (cb) => ipcRenderer.on('title-autohunt', (_, d) => cb(d)),\\n  onHuntUpdate: (cb) => ipcRenderer.on('hunt-update', () => cb()),\\n  huntGet: () => ipcRenderer.invoke('hunt-get'),\\n  huntSet: (d) => ipcRenderer.send('hunt-set', d),\\n  huntAgora: (i) => ipcRenderer.invoke('hunt-agora', i),\\n  huntPanel: () => ipcRenderer.send('hunt-panel'),\\n  onKickUpdate: (cb) => ipcRenderer.on('kick-update', () => cb()),\\n  // ver no celular (PokeLink Monitor)\\n  onMonitorPanel: (cb) => ipcRenderer.on('title-monitor', (_, d) => cb(d)),\\n  onMonitorUpdate: (cb) => ipcRenderer.on('monitor-update', () => cb()),\\n  monitorGet: () => ipcRenderer.invoke('monitor-get'),\\n  monitorAcao: (acao) => ipcRenderer.invoke('monitor-acao', acao),\\n  // análise de PvP\\n  pvpGet: (i, force) => ipcRenderer.invoke('pvp-get', i, !!force),\\n  onPvpAccount: (cb) => ipcRenderer.on('pvp-account', (_, i) => cb(i)),\\n  // barra de título customizada\\n  titleReady: () => ipcRenderer.send('title-ready'),\\n  titleOpen: (open) => ipcRenderer.send('title-open', !!open),\\n  titleClick: (pathIdx) => ipcRenderer.send('title-click', pathIdx),\\n  showAbout: () => ipcRenderer.send('show-about'),\\n  onDialog: (cb) => ipcRenderer.on('title-dialog', (_, d) => cb(d)),\\n  onPopup: (cb) => ipcRenderer.on('title-popup', (_, d) => cb(d)),\\n  popupReply: (id, value) => ipcRenderer.send('title-popup-reply', id, value),\\n  openLivePage: (i, plat, c) => ipcRenderer.send('live-page-open', i, plat, c),\\n  openExt: (i, id) => ipcRenderer.send('ext-open', i, id),\\n  onDialogClose: (cb) => ipcRenderer.on('title-dialog-close', (_, id) => cb(id)),\\n  dialogReply: (id, n, values) => ipcRenderer.send('title-dialog-reply', id, n, values || null),\\n  onTitleState: (cb) => ipcRenderer.on('title-state', (_, s) => cb(s)),\\n  onTitleBadges: (cb) => ipcRenderer.on('title-badges', (_, b) => cb(b)),\\n});\",\"bar.html\":\"<!doctype html>\\n<meta charset=\\\"utf-8\\\">\\n<style>\\n  :root {\\n    --frame-dark: #2a0a12;\\n    --frame: #5a3038;\\n    --frame-hi: #8a5840;\\n    --frame-top: #78493d;\\n    --btn-top: #5a2878;\\n    --btn-bot: #9a58a8;\\n    --btn-edge: #c878a8;\\n    --chip-1: #a355c4;\\n    --chip-2: #7a4098;\\n    --cream: #ffdef0;\\n    --panel: #bd6951;\\n    --box: #2a1520;\\n  }\\n  * { box-sizing: border-box; }\\n  [hidden] { display: none !important; }\\n  html, body { margin: 0; height: 100%; }\\n  body {\\n    background: linear-gradient(var(--frame-top), var(--frame) 22%, var(--frame) 78%, #36171d);\\n    border-top: 1px solid var(--frame-hi);\\n    border-bottom: 2px solid var(--frame-dark);\\n    color: #fff; font: 700 11px \\\"Segoe UI\\\", system-ui, sans-serif;\\n    user-select: none; overflow: hidden; white-space: nowrap;\\n  }\\n  /* barra na borda de baixo: moldura espelhada */\\n  body.bottom {\\n    background: linear-gradient(#36171d, var(--frame) 22%, var(--frame) 78%, var(--frame-top));\\n    border-top: 2px solid var(--frame-dark);\\n    border-bottom: 1px solid var(--frame-hi);\\n  }\\n  #app { display: flex; align-items: center; gap: 10px; height: 100%; padding: 0 9px; }\\n  .grp { display: flex; align-items: center; gap: 8px; }\\n  .grp.right { margin-left: auto; }\\n\\n  /* botão no estilo do menu do jogo: dois tons de roxo + moldura dupla */\\n  .btn {\\n    display: flex; align-items: center; gap: 6px;\\n    height: 24px; padding: 0 10px 0 4px; margin: 0;\\n    font: inherit; color: #fff; cursor: pointer;\\n    text-shadow: 1px 1px 0 var(--frame-dark);\\n    background: linear-gradient(var(--btn-top) 0 48%, var(--btn-bot) 48% 90%, var(--btn-edge) 90%);\\n    border: 2px solid var(--frame-dark); border-radius: 6px;\\n    box-shadow: 0 0 0 1px var(--frame-hi), 0 0 0 2px var(--frame-dark);\\n  }\\n  .btn:hover { filter: brightness(1.15); }\\n  .btn:active { transform: translateY(1px); }\\n  .btn.icon { padding: 0 6px 0 6px; }\\n  .btn.icon svg { width: 14px; height: 14px; display: block; }\\n  .btn.spin svg { animation: spin .8s linear infinite; }\\n  @keyframes spin { to { transform: rotate(360deg); } }\\n  @media (prefers-reduced-motion: reduce) { .btn.spin svg { animation: none; opacity: .6; } }\\n\\n  /* medalhão redondo do ícone */\\n  .chip {\\n    width: 16px; height: 16px; border-radius: 50%; flex: none;\\n    display: grid; place-items: center; font-size: 10px; line-height: 1;\\n    background: radial-gradient(circle at 35% 30%, var(--chip-1), var(--chip-2));\\n    border: 1px solid var(--frame-dark);\\n  }\\n\\n  /* ativo: realce rosa */\\n  .btn.on {\\n    background: linear-gradient(#8d49b8 0 48%, #e77ad2 48% 90%, #ffa7d7 90%);\\n    outline: 2px solid var(--cream); outline-offset: 1px;\\n  }\\n\\n  /* Desempenho */\\n  .perf .caret { font-size: 9px; opacity: .9; margin-left: 2px; }\\n  .perf b { font-weight: 800; }\\n  .perf.l0 .chip { background: radial-gradient(circle at 35% 30%, #7d97ff, #3357e3); }\\n  .perf.l1 .chip { background: radial-gradient(circle at 35% 30%, #8ee08e, #009c3b); }\\n  .perf.l2 .chip { background: radial-gradient(circle at 35% 30%, #f7d85a, #c98a12); }\\n  .perf.l3 .chip { background: radial-gradient(circle at 35% 30%, #5a3a70, var(--frame-dark)); }\\n\\n  /* Auto Compra */\\n  .coin {\\n    width: 16px; height: 16px; border-radius: 50%; flex: none;\\n    background: radial-gradient(circle at 35% 30%, #fff3b0, #e0a91f 55%, #b8860b);\\n    border: 1px solid var(--frame-dark); box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .25);\\n  }\\n  .btn.lives.kick .chip { background: radial-gradient(circle at 35% 30%, #a8ff8a, #3cd61b); }\\n  .btn.lives.kick.on {\\n    background: linear-gradient(#1d6b1a 0 48%, #3cb32a 48% 90%, #8ef07a 90%);\\n    animation: livePulseK 1.6s ease-in-out infinite;\\n  }\\n  @keyframes livePulseK {\\n    0%, 100% { filter: brightness(1); box-shadow: 0 0 0 1px var(--frame-hi), 0 0 0 2px var(--frame-dark), 0 0 0 0 rgba(83, 252, 24, 0); }\\n    50% { filter: brightness(1.25); box-shadow: 0 0 0 1px var(--frame-hi), 0 0 0 2px var(--frame-dark), 0 0 10px 3px rgba(83, 252, 24, .6); }\\n  }\\n  .btn.lives.twitch.on {\\n    background: linear-gradient(#5b2fb0 0 48%, #8f5ee8 48% 90%, #c9a8ff 90%);\\n    animation: livePulse 1.6s ease-in-out infinite; /* pisca enquanto as lives estão ligadas */\\n  }\\n  @keyframes livePulse {\\n    0%, 100% { filter: brightness(1); box-shadow: 0 0 0 1px var(--frame-hi), 0 0 0 2px var(--frame-dark), 0 0 0 0 rgba(201, 168, 255, 0); }\\n    50% { filter: brightness(1.3); box-shadow: 0 0 0 1px var(--frame-hi), 0 0 0 2px var(--frame-dark), 0 0 10px 3px rgba(201, 168, 255, .75); }\\n  }\\n  /* bolinha vermelha de \\\"ao vivo\\\" */\\n  .btn.lives .rec { width: 7px; height: 7px; border-radius: 50%; background: #ff4d5e; box-shadow: 0 0 4px #ff4d5e; animation: recBlink 1s steps(1) infinite; }\\n  @keyframes recBlink { 50% { opacity: 0; } }\\n  @media (prefers-reduced-motion: reduce) {\\n    .btn.lives.on, .btn.lives.kick.on, .btn.lives .rec { animation: none; }\\n  }\\n  .btn.lives b { font-weight: 800; }\\n  .btn.auto.on { background: linear-gradient(#1d6b3a 0 48%, #4aa85a 48% 90%, #8ee08e 90%); }\\n  /* Troca de hunt automática */\\n  .btn.hunt .chip { background: radial-gradient(circle at 35% 30%, #c9a46a, #7a5a2c); }\\n  .btn.hunt.on { background: linear-gradient(#1f4f8a 0 48%, #3f7fd0 48% 90%, #8ec5ff 90%); }\\n  .btn.hunt.on .chip { background: radial-gradient(circle at 35% 30%, #ffe08a, #c98a12); }\\n  .st { font-size: 10px; color: var(--cream); opacity: .9; max-width: 120px; overflow: hidden; text-overflow: ellipsis; text-shadow: 1px 1px 0 var(--frame-dark); }\\n\\n  /* nome da conta / abas */\\n  .name .chip { font-size: 9px; }\\n  .tab.cur { background: linear-gradient(#b8860b 0 48%, #e0a91f 48% 90%, #f7d85a 90%); color: var(--frame-dark); text-shadow: none; }\\n  .name .lbl, .tab .lbl { max-width: 130px; overflow: hidden; text-overflow: ellipsis; }\\n  .sep { width: 2px; height: 20px; background: var(--frame-dark); border-right: 1px solid var(--frame-hi); }\\n\\n  /* barra estreita: primeiro some o texto dos botões menos importantes, depois de todos */\\n  @media (max-width: 1000px) {\\n    .perf .lbl, .perf .caret { display: none; }\\n    .perf { padding-right: 4px; }\\n  }\\n  /* ícone da Kick escuro sobre a bolinha verde */\\n  .btn.lives.kick .chip { color: #0b2e0b; }\\n  .btn.cena .chip { background: radial-gradient(circle at 35% 30%, #8a7aa8, #4a3a68); }\\n  .btn.cena.on .chip { background: radial-gradient(circle at 35% 30%, #8ec5ff, #2f6fd6); }\\n  .btn.cena:not(.on) { background: linear-gradient(#5a2878 0 48%, #9a58a8 48% 90%, #c878a8 90%); box-shadow: 0 0 0 1px #f7d85a, 0 0 0 2px var(--frame-dark); }\\n  /* botão dividido: barrinha separando a setinha */\\n  .btn.split { padding-right: 0; }\\n  .btn.split .split-c {\\n    align-self: stretch; display: grid; place-items: center; width: 22px; margin-left: 4px;\\n    font-size: 8px; border-left: 2px solid rgba(42, 10, 18, .55); box-shadow: inset 1px 0 0 rgba(255, 255, 255, .25);\\n    border-radius: 0 4px 4px 0;\\n  }\\n  .btn.split .split-c:hover { background: rgba(255, 255, 255, .18); }\\n  .btn.split:hover { filter: none; }\\n  .btn.split:hover > :not(.split-c) { filter: brightness(1.15); }\\n  /* grupos: um pouco mais juntos, separadores mais leves */\\n  #app .grp { gap: 6px; }\\n  @media (max-width: 900px) { .lbl, .st { display: none; } .btn { padding-right: 4px; } }\\n\\n  /* ======== Mega Eco: painel das 4 contas ======== */\\n  body.resumo { background: radial-gradient(ellipse at top, #2a1320, #120910 70%); border: 0; overflow: auto; white-space: normal;\\n    font: 600 12px \\\"Segoe UI\\\", system-ui, sans-serif; color: var(--cream); user-select: text; }\\n  .dz { display: flex; flex-direction: column; gap: 10px; padding: 10px 12px 8px; min-height: 100%; }\\n  .dz-top { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; padding: 10px 14px; border-radius: 12px;\\n    background: linear-gradient(90deg, #3a1820, #24101a); border: 2px solid var(--frame-dark); box-shadow: 0 0 0 1px #5a3038; }\\n  .dz-tit b { display: block; font-size: 16px; color: #f7d85a; text-shadow: 1px 1px 0 var(--frame-dark); }\\n  .dz-tit span { font-size: 11px; color: #b98aa6; font-weight: 500; }\\n  .dz-tot { display: flex; gap: 18px; flex-wrap: wrap; }\\n  .dz-tot small { display: block; font-size: 10px; color: #b98aa6; }\\n  .dz-tot b { font-size: 17px; color: #fff; }\\n  .ouro { color: #f7d85a !important; }\\n  .dz-bt { margin-left: auto; display: grid; gap: 4px; }\\n  .dz-b { height: 26px; padding: 0 14px; cursor: pointer; font: 700 12px \\\"Segoe UI\\\", sans-serif; color: var(--cream);\\n    background: #3a1c28; border: 1px solid #5a3038; border-radius: 7px; }\\n  .dz-b.n { color: #3a1d00; background: linear-gradient(#f7d85a, #e0a91f); border-color: var(--frame-dark); }\\n  .dz-b:hover { filter: brightness(1.15); }\\n  .dz-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 10px; align-items: stretch; align-content: start; }\\n  .dz-c { display: flex; flex-direction: column; gap: 9px; padding: 12px; border-radius: 14px; min-width: 0;\\n    background: linear-gradient(170deg, #2e1622, #1e0f17 80%); border: 1px solid #4a2530; box-shadow: 0 8px 20px rgba(0,0,0,.25); }\\n  .dz-h { display: flex; align-items: center; gap: 7px; }\\n  .dz-dot { width: 9px; height: 9px; border-radius: 50%; background: #6a5a62; flex: none; }\\n  .dz-dot.on { background: #3ccf6a; box-shadow: 0 0 6px #3ccf6a; } .dz-dot.boss { background: #ff8a3a; box-shadow: 0 0 6px #ff8a3a; }\\n  .dz-nick { font-size: 14px; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .dz-nv { font-size: 11px; color: #b98aa6; white-space: nowrap; }\\n  .dz-st { margin-left: auto; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 9px; background: #2a1a22; color: #8a6a7a; }\\n  .dz-st.on { background: #0e2a0b; color: #8ef07a; } .dz-st.boss { background: #3a2210; color: #ffb07a; }\\n  .dz-ver { height: 22px; padding: 0 9px; cursor: pointer; font: 700 11px \\\"Segoe UI\\\", sans-serif; color: var(--cream); background: #3a1c28; border: 1px solid #5a3038; border-radius: 6px; }\\n  .dz-chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: -3px; }\\n  .dz-chip { font-size: 10px; font-weight: 800; padding: 1px 7px; border-radius: 7px; background: #2a1a22; color: #d9a7c4; border: 1px solid #4a2530; }\\n  .dz-chip.v { background: #3a2a10; color: #f7d85a; border-color: #6a5a20; } .dz-chip.tw { background: #2a1a48; color: #c9a8ff; border-color: #4a2f7a; }\\n  .dz-chip.kk { background: #14301a; color: #8ef07a; border-color: #2f6b22; } .dz-chip.g { background: #102a30; color: #8ee6f0; border-color: #20606a; }\\n  .dz-chip.b { background: #2e1a10; color: #ffb07a; border-color: #6a3a20; }\\n  .dz-pk { display: flex; align-items: center; gap: 10px; }\\n  .dz-pk img, .dz-pk-sem { width: 58px; height: 58px; object-fit: contain; image-rendering: pixelated; flex: none; }\\n  .dz-pk-sem { border-radius: 50%; background: #3a1c28; }\\n  .dz-pk-i { flex: 1; min-width: 0; display: grid; gap: 4px; }\\n  .dz-pk-i b { color: #fff; font-size: 13px; } .dz-pk-i span { color: #b98aa6; font-size: 11px; }\\n  .dz-hp { height: 6px; border-radius: 3px; background: #140a10; overflow: hidden; }\\n  .dz-hp i { display: block; height: 100%; border-radius: 3px; }\\n  .dz-hunt { font-size: 11px; color: #d9a7c4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  /* quadrinhos no estilo do Modo Economia do jogo */\\n  .dz-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }\\n  .dz-t { display: grid; gap: 1px; padding: 7px 9px; border-radius: 9px; background: #1a0e14; border: 1px solid #3e1f2c; min-width: 0; }\\n  .dz-t small { font-size: 9.5px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: #b98aa6; }\\n  .dz-t b { font-size: 17px; color: #fff; line-height: 1.15; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .dz-t .r { font-size: 11px; font-weight: 700; color: #e77ad2; }\\n  .dz-t .s { font-size: 10px; color: #8a6a7a; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .dz-t.lucro b { color: #4ccf6a; }\\n  .dz-t.ouroT { background: #20180a; border-color: #4a3a14; }\\n  .dz-ga { display: flex; flex-wrap: wrap; gap: 6px 16px; padding: 7px 9px; border-radius: 9px; background: #1a0e14; border: 1px solid #3e1f2c; }\\n  .dz-ga h4 { margin: 0 0 3px; font-size: 9.5px; letter-spacing: .05em; text-transform: uppercase; color: #ffa7d7; }\\n  .dz-it.g { background: #2a1a10; border-color: #5a3a20; }\\n  .dz-ccs { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }\\n  .dz-cc { display: flex; gap: 6px; align-items: center; padding: 5px 7px; border-radius: 8px; background: #2a1220; border: 1px solid #4a2530; min-width: 0; }\\n  .dz-cc img { width: 32px; height: 32px; object-fit: contain; image-rendering: pixelated; flex: none; }\\n  .dz-cc > div { min-width: 0; flex: 1; }\\n  .dz-cc-n { display: flex; align-items: baseline; gap: 4px; }\\n  .dz-cc-n b { font-size: 12px; color: #fff; } .dz-cc-n span { font-size: 10px; color: #b98aa6; } .dz-cc-n i { margin-left: auto; font-style: normal; font-size: 10px; color: #8a6a7a; }\\n  .dz-cc-c { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 2px; }\\n  .dz-cc-c span { font-size: 9px; font-weight: 800; padding: 0 4px; border-radius: 4px; border: 1px solid; }\\n  .dz-cc-c .p { color: #f0c8ff; background: #4a2a5a; border-color: #7a4a9a; } .dz-cc-c .iv { color: #c8f5c8; background: #1d4d2a; border-color: #2f7a40; }\\n  .dz-cc-c .q { color: #c8e0ff; background: #1a3a5a; border-color: #2f5a8a; } .dz-cc-c .n { color: #fff; background: #3a3a3a; border-color: #8a8a8a; }\\n  .dz-rates { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }\\n  .dz-rates div { padding: 6px 8px; border-radius: 8px; background: rgba(0,0,0,.22); }\\n  .dz-rates small { display: block; font-size: 10px; color: #b98aa6; }\\n  .dz-rates b { font-size: 17px; color: #fff; }\\n  .dz-cart, .dz-ses { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 11px; color: #b98aa6; font-weight: 500; }\\n  .dz-cart b, .dz-ses b { color: #fff; font-weight: 800; }\\n  .dz-sec h4 { margin: 0 0 4px; font-size: 10px; letter-spacing: .05em; text-transform: uppercase; color: #ffa7d7; }\\n  .dz-itens { display: flex; flex-wrap: wrap; gap: 4px; }\\n  .dz-it { display: inline-flex; align-items: center; gap: 4px; padding: 2px 7px 2px 3px; border-radius: 8px; background: #1b2238; border: 1px solid #2f3a5a; font-size: 11px; font-weight: 800; color: #fff; }\\n  .dz-it img { width: 18px; height: 18px; object-fit: contain; image-rendering: pixelated; }\\n  .dz-caps { display: flex; flex-wrap: wrap; gap: 4px; }\\n  .dz-cap { font-size: 10.5px; font-weight: 700; padding: 1px 7px; border-radius: 8px; background: #1d4d2a; color: #c8f5c8; }\\n  .dz-cap i { font-style: normal; color: #8ee08e; font-weight: 600; }\\n  .dz-cap.sh { background: #4a3a10; color: #ffe9a8; }\\n  .dz-log { display: grid; gap: 1px; padding-top: 6px; border-top: 1px solid #3e1f2c; min-height: 52px; align-content: start; }\\n  .dz-caps { min-height: 22px; }\\n  .dz-auto { margin-top: auto; }\\n  .dz-log div { font-size: 10.5px; color: #b98aa6; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .dz-log .ruim { color: #ff8a8a; } .dz-log .bom { color: #8ee08e; }\\n  .dz-auto { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; padding-top: 6px; border-top: 1px solid #3e1f2c; }\\n  .dz-auto-t { font-size: 10px; font-weight: 800; color: #ffa7d7; margin-right: 2px; }\\n  .dz-tg { display: inline-flex; align-items: center; gap: 5px; font-size: 10.5px; font-weight: 700; padding: 2px 8px 2px 4px; border-radius: 10px; background: #2a1a22; color: #8a6a7a; }\\n  .dz-tg i { width: 18px; height: 10px; border-radius: 5px; background: #4a3a42; position: relative; }\\n  .dz-tg i::after { content: \\\"\\\"; position: absolute; top: 1px; left: 1px; width: 8px; height: 8px; border-radius: 50%; background: #8a6a7a; }\\n  .dz-tg.on { color: #c8f5c8; background: #14301a; } .dz-tg.on i { background: #2f9a4c; } .dz-tg.on i::after { left: 9px; background: #fff; }\\n  .dz-none { font-size: 11px; color: #6a5a62; font-weight: 500; } .dz-none.big { margin: auto; font-size: 14px; }\\n  .dz-foot { font-size: 10px; color: #6a5a62; text-align: right; }\\n  /* ======== barra de título (substitui o menu nativo) ======== */\\n  body.title {\\n    background: transparent; border: 0;\\n    font: 600 12px \\\"Segoe UI\\\", system-ui, sans-serif;\\n  }\\n  #tb {\\n    position: relative; z-index: 2;\\n    display: flex; align-items: center; height: 34px;\\n    background: #3a1820;\\n    padding: 0 150px 0 8px;            /* à direita: espaço dos botões min/max/fechar */\\n    -webkit-app-region: drag;          /* arrastar a janela / duplo clique maximiza */\\n    box-shadow: inset 0 -2px 0 var(--frame-dark), inset 0 -3px 0 #5a3038;\\n  }\\n  #tb .brand { display: flex; align-items: center; gap: 7px; margin-right: 14px; color: var(--cream); }\\n  #tb .brand svg, #tb .brand .appico { width: 18px; height: 18px; display: block; flex: none; object-fit: contain; }\\n  #tb .brand b { font-size: 12px; font-weight: 800; letter-spacing: .02em; text-shadow: 1px 1px 0 var(--frame-dark); }\\n  #tb .ver { margin-left: 2px; }\\n  #tb nav { display: flex; align-items: center; gap: 2px; }\\n  #tb nav { gap: 3px; padding-left: 10px; margin-left: 4px; border-left: 1px solid #5a3038; height: 22px; }\\n  .mbtn {\\n    -webkit-app-region: no-drag; position: relative;\\n    display: inline-flex; align-items: center; gap: 6px;\\n    height: 26px; padding: 0 10px 0 8px; margin: 0;\\n    font: 600 12px \\\"Segoe UI\\\", system-ui, sans-serif; color: #e8c2d8; cursor: pointer;\\n    background: none; border: 1px solid transparent; border-radius: 8px;\\n    transition: background .12s, color .12s;\\n  }\\n  .mbtn svg { width: 14px; height: 14px; flex: none; opacity: .75; transition: opacity .12s; }\\n  .mbtn:hover { color: #fff; background: rgba(255, 255, 255, .07); }\\n  .mbtn:hover svg { opacity: 1; }\\n  .mbtn.open, .mbtn:focus-visible {\\n    color: #fff; outline: none;\\n    background: linear-gradient(#6a2c8c, #8f4aa8);\\n    border-color: var(--frame-dark);\\n    box-shadow: 0 0 0 1px #b06cc8, 0 2px 8px rgba(122, 64, 152, .45);\\n    text-shadow: 1px 1px 0 var(--frame-dark);\\n  }\\n  .mbtn.open svg, .mbtn:focus-visible svg { opacity: 1; }\\n  /* selo com número (ex.: lives abertas) */\\n  .mbtn .mb-badge {\\n    min-width: 16px; height: 16px; padding: 0 4px; border-radius: 8px; display: grid; place-items: center;\\n    font-size: 10px; font-weight: 800; color: #fff; background: #e0405a; box-shadow: 0 0 0 2px #3a1820;\\n  }\\n  @media (prefers-reduced-motion: reduce) { .mbtn, .mbtn svg { transition: none; } }\\n\\n  /* botão de informações (bolinha com \\\"i\\\") */\\n  .ibtn {\\n    -webkit-app-region: no-drag;\\n    width: 22px; height: 22px; margin: 0 0 0 auto; padding: 0;\\n    display: grid; place-items: center; cursor: pointer;\\n    font: italic 800 13px Georgia, \\\"Times New Roman\\\", serif; color: #fff;\\n    text-shadow: 1px 1px 0 var(--frame-dark);\\n    background: radial-gradient(circle at 35% 30%, var(--chip-1), var(--chip-2));\\n    border: 1px solid var(--frame-dark); border-radius: 50%;\\n    box-shadow: 0 0 0 1px var(--frame-hi);\\n  }\\n  .ibtn:hover, .ibtn:focus-visible { outline: none; filter: brightness(1.2); box-shadow: 0 0 0 1px var(--cream); }\\n\\n  /* ---- pop-ups (substituem as caixas de mensagem do Windows) ---- */\\n  #dlgShade {\\n    position: fixed; inset: 0; z-index: 10;\\n    display: grid; place-items: center; padding: 50px 16px 16px;\\n    background: rgba(26, 4, 12, .55);\\n  }\\n  .dlg {\\n    width: min(460px, 100%); max-height: 100%; overflow: auto;\\n    background: var(--box); color: var(--cream); white-space: normal;\\n    border: 2px solid var(--frame-dark); border-radius: 10px;\\n    box-shadow: 0 0 0 1px #914850, 0 18px 40px rgba(20, 0, 8, .6);\\n    font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif;\\n    animation: dlgIn .12s ease-out;\\n  }\\n  @keyframes dlgIn { from { opacity: 0; transform: scale(.97); } }\\n  @media (prefers-reduced-motion: reduce) { .dlg { animation: none; } }\\n  .dlg .hd {\\n    display: flex; align-items: center; gap: 8px; height: 32px; padding: 0 6px 0 12px;\\n    background: linear-gradient(var(--frame-top), var(--frame));\\n    border-bottom: 2px solid var(--frame-dark); border-radius: 8px 8px 0 0;\\n    color: #fff; font-size: 12px; text-shadow: 1px 1px 0 var(--frame-dark);\\n  }\\n  .dlg .hd .t { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .dlg .x {\\n    width: 24px; height: 24px; padding: 0; border: 0; border-radius: 5px; cursor: pointer;\\n    background: none; color: var(--cream); font: 700 16px/1 \\\"Segoe UI\\\", sans-serif;\\n  }\\n  .dlg .x:hover, .dlg .x:focus-visible { outline: none; background: #8a2a3a; color: #fff; }\\n  .dlg .bd { display: flex; gap: 14px; padding: 18px 18px 6px; }\\n  .dlg .ico {\\n    flex: none; width: 34px; height: 34px; border-radius: 50%;\\n    display: grid; place-items: center; color: #fff;\\n    font: italic 800 19px Georgia, serif; text-shadow: 1px 1px 0 var(--frame-dark);\\n    border: 2px solid var(--frame-dark); box-shadow: 0 0 0 1px var(--frame-hi);\\n    background: radial-gradient(circle at 35% 30%, var(--chip-1), var(--chip-2));\\n  }\\n  .dlg .ico.warning { background: radial-gradient(circle at 35% 30%, #f7d85a, #c98a12); color: #3a1d00; text-shadow: none; font: 800 19px \\\"Segoe UI\\\", sans-serif; }\\n  .dlg .ico.error { background: radial-gradient(circle at 35% 30%, #ff8a8a, #b8283c); font: 800 17px \\\"Segoe UI\\\", sans-serif; }\\n  .dlg .ico.question { font: 800 18px \\\"Segoe UI\\\", sans-serif; }\\n  .dlg .msg { margin: 6px 0 8px; font-size: 15px; font-weight: 700; color: #fff; }\\n  .dlg .det { margin: 0; color: #e8bcd6; font-weight: 500; line-height: 1.45; white-space: pre-line; word-break: break-word; }\\n  .dlg .ft { display: flex; justify-content: flex-end; gap: 10px; padding: 14px 18px 16px; }\\n  .dlg .ft .btn { height: 30px; padding: 0 16px; font-size: 13px; }\\n  .dlg .ft .btn:focus-visible { outline: 2px solid var(--cream); outline-offset: 2px; }\\n  /* \\\"Sobre\\\": cabeçalho com a marca */\\n  .dlg .about { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 22px 18px 4px; text-align: center; }\\n  .dlg .about svg, .dlg .about .appico { width: 54px; height: 54px; object-fit: contain; filter: drop-shadow(0 3px 0 var(--frame-dark)); }\\n  .dlg .about .nm { font-size: 22px; font-weight: 800; color: #fff; text-shadow: 2px 2px 0 var(--frame-dark); }\\n  .dlg .about .ver { font-size: 11px; }\\n  .dlg.is-about { width: min(500px, 100%); }\\n  .dlg.is-about .bd { padding: 14px 22px 4px; }\\n  .dlg.is-about .msg { text-align: center; margin-top: 0; }\\n  .dlg .note {\\n    display: flex; gap: 10px; align-items: flex-start; margin: 14px 0 4px; padding: 10px 12px;\\n    background: #3a2410; border: 1px solid #c98a12; border-radius: 7px;\\n    color: #ffe9a8; font-weight: 600; line-height: 1.4;\\n  }\\n  .dlg .note .ni {\\n    flex: none; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center;\\n    background: radial-gradient(circle at 35% 30%, #f7d85a, #c98a12); color: #3a1d00;\\n    border: 1px solid var(--frame-dark); font-weight: 800; font-size: 12px;\\n  }\\n  .dlg.wide { width: min(820px, 100%); }\\n  .dlg .dform { margin-top: 10px; }\\n  .dlg .det.long { max-height: min(52vh, 460px); overflow: auto; padding: 10px 12px; margin-top: 6px;\\n    background: #1d0f17; border: 1px solid #4a2530; border-radius: 8px; font-size: 12px; }\\n  /* painel das lives */\\n  .dlg .lv { margin-top: 12px; }\\n  /* Auto Compra como painel que desce do botão */\\n  #cfgShade { position: fixed; inset: 0; z-index: 9; background: rgba(20, 0, 8, .25); }\\n  #cfg.panel {\\n    position: fixed; z-index: 12; display: flex; flex-direction: column;\\n    width: min(680px, calc(100vw - 16px)); height: min(760px, calc(100vh - 56px));\\n    background: #24101a; color: var(--cream); white-space: normal; font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif;\\n    border: 2px solid var(--frame-dark); border-radius: 12px; overflow: hidden;\\n    box-shadow: 0 0 0 1px #914850, 0 18px 40px rgba(20, 0, 8, .6);\\n    animation: ddIn .1s ease-out;\\n  }\\n  #cfg.panel .ch { -webkit-app-region: no-drag; padding-right: 6px; }\\n  #extsShade { position: fixed; inset: 0; z-index: 9; background: rgba(20, 0, 8, .35); }\\n  .lp.ex { width: min(640px, calc(100vw - 24px)); height: auto; max-height: calc(100vh - 60px); }\\n  .lp.ex .cb { display: grid; gap: 12px; }\\n  .ex-card { padding: 14px; border-radius: 12px; background: linear-gradient(160deg, #2e1a2a, #24121c 70%); border: 1px solid #5a3038; display: grid; gap: 8px; }\\n  .ex-card.off { opacity: .6; }\\n  .ex-h { display: flex; align-items: center; gap: 10px; }\\n  .ex-ico { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; flex: none;\\n    background: radial-gradient(circle at 35% 30%, var(--chip-1), var(--chip-2)); border: 1px solid var(--frame-dark); }\\n  .ex-ico svg { width: 16px; height: 16px; }\\n  .ex-t { flex: 1; min-width: 0; display: grid; }\\n  .ex-t b { color: #fff; font-size: 15px; } .ex-t span { font-size: 11px; color: #b98aa6; }\\n  .ex-st { font-size: 10px; font-weight: 800; padding: 3px 9px; border-radius: 10px; white-space: nowrap; }\\n  .ex-st.ok { background: #0e2a0b; color: #8ef07a; } .ex-st.off { background: #2a1a22; color: #8a6a7a; }\\n  .ex-st.err { background: #3a1018; color: #ff8a8a; } .ex-st.busy { background: #3a2a10; color: #f7d85a; }\\n  .ex-d { font-size: 12px; color: #d9a7c4; font-weight: 500; line-height: 1.4; }\\n  .ex-err { font-size: 11px; color: #ff8a8a; font-weight: 500; word-break: break-word; }\\n  .ex-a { display: flex; gap: 8px; }\\n  .ex-a .kx-btn:disabled { opacity: .5; cursor: default; }\\n  /* painel de uso (CPU e memória) em cartões */\\n  .lp.uso { width: min(860px, calc(100vw - 24px)); height: auto; max-height: calc(100vh - 60px); }\\n  .uso-leg { display: flex; gap: 14px; align-items: center; color: #b98aa6; font-size: 12px; font-weight: 600; }\\n  .uso-leg i { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 5px; vertical-align: -1px; }\\n  .uso-h { margin: 14px 0 8px; color: #d9b8c6; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }\\n  .uso-g { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }\\n  .uso-c { position: relative; padding: 12px 14px 11px; border-radius: 10px; background: #2e1520; border: 1px solid #4a2632; overflow: hidden; }\\n  .uso-c::before { content: \\\"\\\"; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--n); }\\n  .uso-c .t { color: #e6cfd8; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\\n  .uso-c .v { margin-top: 4px; color: #fff; font: 800 24px/1.1 \\\"Segoe UI\\\", system-ui, sans-serif; }\\n  .uso-c .s { margin-top: 3px; display: flex; align-items: center; justify-content: space-between; gap: 8px; color: var(--n); font-size: 13px; font-weight: 700; }\\n  .uso-c .d { margin-top: 2px; color: #9d7a8a; font-size: 12px; font-weight: 600; }\\n  .uso-c .tag { flex: none; padding: 1px 7px; border-radius: 99px; font-size: 10px; font-weight: 800;\\n    letter-spacing: .05em; color: #1a0a10; background: var(--n); }\\n  .uso-c.ok { --n: #7fe08a; } .uso-c.medio { --n: #e7c46a; } .uso-c.alto { --n: #ff5d6c; }\\n  .uso-c.ok { background: #1e2a1e; border-color: #2f4a30; } .uso-c.medio { background: #2c2617; border-color: #5a4a22; } .uso-c.alto { background: #331419; border-color: #6a2630; }\\n  .uso-c.hero { grid-column: 1 / -1; display: flex; align-items: center; gap: 24px; }\\n  .uso-c.hero .s { margin-top: 0; gap: 14px; }\\n  .uso-c.hero .v { font-size: 30px; }\\n  .uso-out { display: flex; flex-wrap: wrap; gap: 6px 14px; color: #b98aa6; font-size: 12px; }\\n  .uso-out b { color: #e6cfd8; }\\n  /* ---------- Novidades (patch notes) ---------- */\\n  #novShade { position: fixed; inset: 0; z-index: 9; background: rgba(12, 0, 6, .62); }\\n  .nov { position: fixed; z-index: 12; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(560px, calc(100vw - 24px));\\n    max-height: calc(100vh - 40px); display: flex; flex-direction: column; background: #4a1f2b; color: var(--cream); white-space: normal;\\n    font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif; border: 2px solid #2a0d16; border-radius: 6px;\\n    box-shadow: 0 0 0 2px #8a4a52, 0 0 0 4px #2a0d16, 0 24px 60px rgba(0, 0, 0, .7); animation: novIn .18s ease-out; }\\n  @keyframes novIn { from { opacity: 0; transform: translate(-50%, -47%) scale(.97); } }\\n  .nov-hd { flex: none; padding: 12px 16px 10px; color: #fff3d6; font: 900 15px/1.2 \\\"Segoe UI\\\", sans-serif; letter-spacing: .03em;\\n    border-bottom: 2px solid #2a0d16; box-shadow: 0 1px 0 #8a4a52; }\\n  .nov-hd { display: flex; align-items: center; gap: 10px; }\\n  .nov-hd > span { flex: 1; min-width: 0; }\\n  .nov-ver { display: flex; align-items: center; gap: 6px; flex: none; font: 700 11px \\\"Segoe UI\\\", sans-serif; color: #d9b8c6; letter-spacing: 0; }\\n  .nov-ver select { height: 26px; padding: 0 6px; border-radius: 4px; cursor: pointer; color: #fff3d6; background: #2a0d16; border: 1px solid #8a4a52; font: 700 12px \\\"Segoe UI\\\", sans-serif; }\\n  .nov-ver select:focus-visible { outline: 2px solid #ffd75e; outline-offset: 1px; }\\n  .nov-bd { flex: 1; overflow: auto; padding: 12px 14px 4px; }\\n  .nov-hero { position: relative; overflow: hidden; padding: 18px 14px 14px; text-align: center; border-radius: 6px;\\n    background: radial-gradient(circle at 50% 18%, #7a3fb0 0, #4a1f7a 38%, #2a1046 100%); border: 2px solid #c79bff; box-shadow: inset 0 0 0 2px #2a1046; }\\n  .nov-hero .spark { position: absolute; color: #fff; opacity: .8; font-size: 12px; animation: novTw 2.4s ease-in-out infinite; }\\n  @keyframes novTw { 50% { opacity: .15; transform: scale(.7); } }\\n  .nov-logo { width: 74px; height: 74px; margin: 0 auto; filter: drop-shadow(0 4px 0 #1a0830); }\\n  .nov-selo { display: inline-block; margin-top: 4px; padding: 2px 10px; border-radius: 3px; font: 900 10px \\\"Segoe UI\\\", sans-serif; letter-spacing: .1em;\\n    color: #fff; background: #8a3fd0; border: 1px solid #e0c0ff; }\\n  .nov-tit { margin: 10px 0 12px; font: 900 26px/1.1 \\\"Segoe UI\\\", sans-serif; letter-spacing: .02em; color: #ffd75e;\\n    text-shadow: 0 2px 0 #7a3a00, 0 -1px 0 #7a3a00, 2px 0 0 #7a3a00, -2px 0 0 #7a3a00, 0 4px 8px rgba(0,0,0,.4); }\\n  .nov-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }\\n  .nov-card { padding: 9px 6px 8px; border-radius: 4px; background: rgba(20, 8, 40, .55); border: 2px solid #8fb8ff; }\\n  .nov-card:nth-child(2) { border-color: #c79bff; } .nov-card:nth-child(3) { border-color: #ffd75e; }\\n  .nov-card .ic { font-size: 26px; line-height: 1.1; }\\n  .nov-card .vl { margin-top: 2px; color: #fff; font: 900 18px \\\"Segoe UI\\\", sans-serif; }\\n  .nov-card .nm { color: #8fd0ff; font-weight: 800; font-size: 12px; } .nov-card:nth-child(2) .nm { color: #d9b8ff; } .nov-card:nth-child(3) .nm { color: #ffd75e; }\\n  .nov-card .sb { color: #c9b8d9; font-size: 10.5px; }\\n  .nov-res { margin: 10px 4px 0; color: #f3e6ff; font-size: 12.5px; line-height: 1.45; }\\n  .nov-gold { margin-top: 10px; padding: 10px 14px; border-radius: 4px; text-align: center; color: #ffe08a; font-size: 12.5px; line-height: 1.45;\\n    background: linear-gradient(#6a3418, #4a2210); border: 2px solid #d89a3a; box-shadow: inset 0 0 0 2px #2a1206; }\\n  .nov-sec { padding: 12px 14px; border-radius: 4px; background: #1e0c14; border: 1px solid #5a2a36; }\\n  .nov-sec h4 { margin: 0 0 8px; color: #fff; font: 900 13px \\\"Segoe UI\\\", sans-serif; letter-spacing: .04em; }\\n  .nov-sec ul { margin: 0; padding: 0; list-style: none; }\\n  .nov-sec li { position: relative; margin: 0 0 8px; padding-left: 14px; color: #d9c4cf; font-size: 12.5px; line-height: 1.45; }\\n  .nov-sec li::before { content: \\\"▸\\\"; position: absolute; left: 0; color: #ffd75e; }\\n  .nov b, .nov strong { color: #fff; }\\n  .nov-gold b { color: #fff3c4; }\\n  .nov-nav { flex: none; display: flex; align-items: center; gap: 10px; padding: 8px 14px 4px; }\\n  .nov-arr { width: 38px; height: 28px; flex: none; cursor: pointer; border-radius: 4px; color: #fff; font: 900 15px/1 \\\"Segoe UI\\\", sans-serif;\\n    background: linear-gradient(#9a5ad8, #6a2aa8); border: 2px solid #2a0d16; box-shadow: inset 0 0 0 1px #d0a8ff; }\\n  .nov-arr:disabled { opacity: .35; cursor: default; }\\n  .nov-dots { flex: 1; display: flex; justify-content: center; gap: 7px; }\\n  .nov-dots i { width: 10px; height: 10px; border-radius: 50%; cursor: pointer; background: #2a0d16; border: 1px solid #6a3a46; }\\n  .nov-dots i.on { background: #ffd75e; border-color: #fff3c4; box-shadow: 0 0 6px #ffd75e; }\\n  .nov-go { flex: none; margin: 8px 14px 14px; height: 36px; cursor: pointer; border-radius: 4px; color: #3a1a00; font: 900 14px \\\"Segoe UI\\\", sans-serif;\\n    letter-spacing: .14em; background: linear-gradient(#ffe36a, #f2b51e); border: 2px solid #2a0d16; box-shadow: inset 0 0 0 2px #fff0a8, 0 3px 0 #7a4a00; }\\n  .nov-go:hover { filter: brightness(1.06); }\\n  /* troca de hunt automática */\\n  .lp.ah { width: min(760px, calc(100vw - 24px)); height: auto; max-height: calc(100vh - 60px); }\\n  /* ver no celular */\\n  #celShade { position: fixed; inset: 0; z-index: 9; background: rgba(20, 0, 8, .35); }\\n  .lp.cel { width: min(640px, calc(100vw - 24px)); height: auto; max-height: calc(100vh - 60px); }\\n  .cel-g { display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap; }\\n  .cel-qr { flex: none; padding: 10px; border-radius: 10px; background: #fff8ec; border: 2px solid #c99a3e; box-shadow: 0 0 0 2px #24101a, 0 0 0 3px #7a5a2c; line-height: 0; }\\n  .cel-qr svg { width: 200px; height: 200px; display: block; }\\n  .cel-i { flex: 1; min-width: 240px; display: grid; gap: 10px; color: #e6cfd8; font-size: 13px; line-height: 1.45; }\\n  .cel-i ol { margin: 0; padding-left: 18px; display: grid; gap: 4px; }\\n  .cel-cod { padding: 8px 10px; border-radius: 8px; background: #2e1520; border: 1px solid #4a2632; color: #f2c75c; font: 800 17px/1.2 Consolas, \\\"Courier New\\\", monospace; letter-spacing: 1px; text-align: center; user-select: all; }\\n  .cel-st { padding: 7px 10px; border-radius: 8px; background: #1e2a1e; border: 1px solid #2f4a30; color: #9fe6a8; font-size: 12px; }\\n  .cel-st.erro { background: #331419; border-color: #6a2630; color: #ff9aa5; }\\n  .cel-st.aviso { background: #2c2617; border-color: #5a4a22; color: #e7c46a; }\\n  .cel-off { display: grid; gap: 10px; color: #e6cfd8; font-size: 13px; line-height: 1.5; }\\n  .cel-off ul { margin: 0; padding-left: 18px; display: grid; gap: 4px; }\\n  .cel-off .nota { color: #9d7a8a; font-size: 12px; }\\n  .ah-aviso { padding: 9px 12px; border-radius: 8px; background: #2c2617; border: 1px solid #5a4a22; color: #e7c46a; font-size: 12px; line-height: 1.45; }\\n  .ah-cfg { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-top: 12px; }\\n  .ah-cfg label { display: flex; flex-direction: column; gap: 4px; color: #b98aa6; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; }\\n  .ah-cfg select { height: 30px; border-radius: 6px; padding: 0 8px; background: #1e0c14; color: #fff; border: 1px solid #5a2a36; font: 700 12px \\\"Segoe UI\\\", sans-serif; }\\n  .ah-g { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }\\n  .ah-c { padding: 11px 12px; border-radius: 10px; background: #2e1520; border: 1px solid #4a2632; }\\n  .ah-c.on { background: #1e2a1e; border-color: #2f4a30; }\\n  .ah-c .h { display: flex; align-items: center; gap: 8px; } .ah-c .h b { color: #fff; font-size: 13px; flex: 1; }\\n  .ah-c .ah-st { margin-top: 6px; color: #d9c4cf; font-size: 12px; min-height: 16px; }\\n  .ah-c .px { color: #9d7a8a; font-size: 11px; }\\n  .ah-c .hs { margin-top: 6px; display: grid; gap: 2px; color: #b98aa6; font-size: 11px; }\\n  .ah-c .hs b { color: #e6cfd8; }\\n  .ah-c .bt { margin-top: 8px; }\\n  #kickShade, #livesShade, #usoShade, #ahShade { position: fixed; inset: 0; z-index: 9; background: rgba(20, 0, 8, .35); }\\n  /* painel das Lives */\\n  .lp {\\n    position: fixed; z-index: 12; left: 50%; top: 50%; transform: translate(-50%, -48%); display: flex; flex-direction: column;\\n    width: min(940px, calc(100vw - 24px)); height: min(720px, calc(100vh - 60px));\\n    background: #24101a; color: var(--cream); white-space: normal; font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif;\\n    border: 2px solid var(--frame-dark); border-radius: 12px; overflow: hidden;\\n    box-shadow: 0 0 0 1px #914850, 0 18px 40px rgba(20, 0, 8, .6); animation: ddIn .1s ease-out;\\n  }\\n  .lp .ch { flex: none; display: flex; align-items: center; gap: 8px; height: 38px; padding: 0 8px 0 12px; background: #3a1820;\\n    box-shadow: inset 0 -2px 0 var(--frame-dark), inset 0 -3px 0 #5a3038; }\\n  .lp .ch b { color: #fff; font-size: 13px; } .lp .ch > span:not(.lp-ico) { color: #b98aa6; font-size: 12px; }\\n  .lp .ch .cfg-x { margin-left: auto; width: 26px; height: 26px; padding: 0; border: 0; border-radius: 6px; cursor: pointer; background: none; color: var(--cream); font: 700 18px/1 \\\"Segoe UI\\\", sans-serif; }\\n  .lp .ch .cfg-x:hover { background: #8a2a3a; color: #fff; }\\n  .lp .cb { flex: 1; overflow: auto; padding: 14px 18px; }\\n  .lp-ico { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; flex: none; }\\n  .lp-ico svg { width: 12px; height: 12px; }\\n  .lp .ch .lp-ico { background: radial-gradient(circle at 35% 30%, var(--chip-1), var(--chip-2)); }\\n  .twitch .lp-ico { background: radial-gradient(circle at 35% 30%, #a78bfa, #6a3bc4); }\\n  .kick .lp-ico { background: radial-gradient(circle at 35% 30%, #a8ff8a, #3cd61b); color: #0b2e0b; }\\n  .lp-nowg { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }\\n  .lp-now { padding: 12px; border-radius: 12px; background: #2e1622; }\\n  .lp-now.twitch { border: 1px solid #5b2fb0; background: linear-gradient(160deg, #241a3a, #24121c 70%); }\\n  .lp-now.kick { border: 1px solid #2f6b22; background: linear-gradient(160deg, #1d2a18, #24121c 70%); }\\n  .lp-now-h { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }\\n  .lp-now-h b { color: #fff; font-size: 14px; }\\n  .lp-n { margin-left: auto; font-size: 11px; font-weight: 700; color: #d9a7c4; }\\n  .lp-chips { display: flex; flex-wrap: wrap; gap: 6px; }\\n  .lp-tag { display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 10px; border-radius: 12px; font-size: 12px; font-weight: 700; color: #fff; background: rgba(0, 0, 0, .25); }\\n  .lp-dot { width: 7px; height: 7px; border-radius: 50%; background: #ff3b4e; box-shadow: 0 0 5px #ff3b4e; }\\n  .lp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 12px; }\\n  .lp-acc { padding: 12px 14px; border-radius: 12px; background: #2e1622; border: 1px solid #4a2530; }\\n  .lp-acc-h { display: flex; align-items: baseline; gap: 8px; margin-bottom: 6px; }\\n  .lp-acc-h b { font-size: 15px; color: #fff; } .lp-acc-h span { font-size: 11px; color: #b98aa6; margin-left: auto; }\\n  .lp-row { padding: 8px 0; border-top: 1px solid #3e1f2c; display: grid; gap: 6px; }\\n  .lp-row-h { display: flex; align-items: center; gap: 8px; }\\n  .lp-row-h b { color: #fff; }\\n  .lp-row-h .sw { margin-left: 8px; }\\n  .lp-count { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 800; padding: 2px 9px; border-radius: 10px; color: #fff; }\\n  .lp-row.twitch .lp-count { background: #5b2fb0; } .lp-row.kick .lp-count { background: #2a8a1f; }\\n  .lp-count .rec { width: 7px; height: 7px; border-radius: 50%; background: #ff3b4e; box-shadow: 0 0 5px #ff3b4e; animation: recBlink 1s steps(1) infinite; }\\n  .lp-off { margin-left: auto; font-size: 11px; font-weight: 700; color: #8a6a7a; }\\n  .lp-chip { height: 26px; padding: 0 11px; border-radius: 13px; cursor: pointer; font: 700 12px \\\"Segoe UI\\\", sans-serif; color: #fff; border: 1px solid var(--frame-dark); }\\n  .lp-row.twitch .lp-chip { background: #3d2470; } .lp-row.kick .lp-chip { background: #1d4d1a; }\\n  .lp-chip:hover { filter: brightness(1.3); box-shadow: 0 0 0 1px var(--cream); }\\n  .lp-none { font-size: 11px; color: #8a6a7a; font-weight: 500; }\\n  .lp-foot { flex: none; display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: #3a1820; font-size: 11px; color: #b98aa6;\\n    box-shadow: inset 0 2px 0 var(--frame-dark), inset 0 3px 0 #5a3038; }\\n  .lp-foot .grow { flex: 1; }\\n  @media (max-width: 700px) { .lp-nowg { grid-template-columns: 1fr; } .lp-grid { grid-template-columns: 1fr; } }\\n  #kickw.panel {\\n    position: fixed; z-index: 12; display: flex; flex-direction: column;\\n    width: min(1000px, calc(100vw - 16px)); height: min(780px, calc(100vh - 56px));\\n    background: #24101a; color: var(--cream); white-space: normal; font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif;\\n    border: 2px solid var(--frame-dark); border-radius: 12px; overflow: hidden;\\n    box-shadow: 0 0 0 1px #2f6b22, 0 18px 40px rgba(20, 0, 8, .6);\\n    animation: ddIn .1s ease-out;\\n  }\\n  #kickw.panel .ch { -webkit-app-region: no-drag; padding-right: 6px; }\\n  #kickw .ch .cfg-x, #cfg.panel .ch .cfg-x { margin-left: auto; width: 26px; height: 26px; padding: 0; border: 0; border-radius: 6px; cursor: pointer;\\n    background: none; color: var(--cream); font: 700 18px/1 \\\"Segoe UI\\\", sans-serif; }\\n  #kickw .ch .cfg-x:hover { background: #8a2a3a; color: #fff; }\\n  #cfg.panel .ch .cfg-x { margin-left: auto; width: 26px; height: 26px; padding: 0; border: 0; border-radius: 6px; cursor: pointer;\\n    background: none; color: var(--cream); font: 700 18px/1 \\\"Segoe UI\\\", sans-serif; }\\n  #cfg.panel .ch .cfg-x:hover { background: #8a2a3a; color: #fff; }\\n  #cfg.panel .cb { padding: 14px 16px 6px; }\\n  .cfg-contas { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }\\n  .cfg-contas > span { font-size: 12px; color: #b98aa6; }\\n  #cfgContas { display: flex; gap: 4px; flex-wrap: wrap; }\\n  .cfg-ct { height: 28px; padding: 0 12px; cursor: pointer; font: 700 12px \\\"Segoe UI\\\", sans-serif; color: var(--cream);\\n    background: #3a1c28; border: 2px solid var(--frame-dark); border-radius: 8px; position: relative; }\\n  .cfg-ct.on::after { content: \\\"\\\"; position: absolute; top: 3px; right: 3px; width: 6px; height: 6px; border-radius: 50%; background: #3ccf6a; }\\n  .cfg-ct.cur { color: #3a1d00; background: linear-gradient(#f7d85a, #e0a91f); }\\n  .cfg-ct:hover { filter: brightness(1.15); }\\n  .cfg-todas { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--cream); cursor: pointer; margin-left: auto; white-space: nowrap; }\\n  #cfg .acc-row { box-shadow: 0 0 0 1px #2f6b22; background: linear-gradient(90deg, #1a2a16, #2e1622); }\\n  #cfg .acc-row .tx b { font-size: 15px; }\\n  #cfg.panel .cf { padding: 10px 16px; }\\n  #cfg .cf .btn { white-space: nowrap; }\\n  /* menuzinho de escolha (Desempenho) */\\n  #popShade { position: fixed; inset: 0; z-index: 9; }\\n  .dd.pop { z-index: 11; min-width: 300px; padding: 6px; }\\n  .pop-t { padding: 6px 10px 8px; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #ffa7d7; border-bottom: 1px solid #4a2530; margin-bottom: 4px; }\\n  .dd.pop .it.pop-it { grid-template-columns: 26px 1fr 16px; height: auto; min-height: 44px; padding: 7px 8px; gap: 8px; margin-bottom: 2px; }\\n  .pop-ic { font-size: 14px; text-align: center; }\\n  .pop-tx b { display: block; font-size: 13px; color: #fff; }\\n  .pop-tx small { display: block; font-size: 11px; font-weight: 500; color: #b98aa6; white-space: normal; line-height: 1.3; }\\n  .dd .pop-it:hover .pop-tx small, .dd .pop-it:focus-visible .pop-tx small { color: var(--cream); }\\n  .pop-ok { color: #f7d85a; font-weight: 800; text-align: center; }\\n  .pop-sub { padding: 0 10px 8px; margin-top: -4px; font-size: 11px; color: #8ee08e; font-weight: 600; }\\n  .dd .pop-it.cur { background: rgba(247, 216, 90, .08); border-color: #5a4a20; }\\n  .dlg .lv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\\n  @media (max-width: 640px) { .dlg .lv-grid { grid-template-columns: 1fr; } }\\n  .dlg .lv-acc { padding: 10px 12px; background: #2e1622; border: 2px solid var(--frame-dark); border-radius: 10px; box-shadow: 0 0 0 1px #5a3038; min-width: 0; }\\n  .dlg .lv-nm { display: block; margin-bottom: 6px; font-size: 14px; color: #fff; }\\n  .dlg .lv-row { padding: 6px 0; border-top: 1px solid #3e1f2c; }\\n  .dlg .lv-h { display: flex; align-items: center; justify-content: space-between; gap: 8px; }\\n  .dlg .lv-pf { font-size: 11px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }\\n  .dlg .lv-row.twitch .lv-pf { color: #c9a8ff; } .dlg .lv-row.kick .lv-pf { color: #8ef07a; }\\n  .dlg .lv-st { font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 9px; border: 1px solid var(--frame-dark); }\\n  .dlg .lv-st.off { background: #3a1c28; color: #8a6a7a; }\\n  .dlg .lv-row.twitch .lv-st.on { background: #5b2fb0; color: #fff; }\\n  .dlg .lv-row.kick .lv-st.on { background: #2a8a1f; color: #fff; }\\n  .dlg .lv-chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }\\n  .dlg .lv-chip, .dlg .lv-tag { font: 700 11px \\\"Segoe UI\\\", sans-serif; padding: 3px 9px; border-radius: 10px; border: 1px solid var(--frame-dark); }\\n  .dlg .lv-chip { cursor: pointer; color: #fff; }\\n  .dlg .lv-row.twitch .lv-chip { background: #3d2470; } .dlg .lv-row.kick .lv-chip { background: #1d4d1a; }\\n  .dlg .lv-chip:hover, .dlg .lv-chip:focus-visible { outline: none; filter: brightness(1.3); box-shadow: 0 0 0 1px var(--cream); }\\n  .dlg .lv-tag { background: #3a1c28; color: var(--cream); }\\n  .dlg .lv-none { font-size: 11px; color: #8a6a7a; font-weight: 500; }\\n  .dlg .lv-now { margin-top: 10px; padding: 8px 12px; background: #2a1320; border-radius: 8px; border: 1px solid #4a2530; }\\n  .dlg .lv-now > b { font-size: 12px; color: #ffa7d7; }\\n  .dlg .lv-now .lv-row { display: flex; gap: 10px; align-items: center; }\\n  .dlg .lv-now .lv-chips { margin-top: 0; }\\n  .dlg .lv-foot { margin-top: 8px; font-size: 11px; color: #8a6a7a; }\\n  /* cartões da Rota de UP */\\n  .dlg .rcards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 12px; }\\n  @media (max-width: 700px) { .dlg .rcards { grid-template-columns: 1fr; } }\\n  .dlg .rc {\\n    display: flex; flex-direction: column; gap: 8px; padding: 12px; min-width: 0;\\n    background: #2e1622; border: 2px solid var(--frame-dark); border-radius: 10px; box-shadow: 0 0 0 1px #5a3038;\\n  }\\n  .dlg .rc.r1 { background: linear-gradient(#3a2a10, #2e1622 60%); box-shadow: 0 0 0 1px #c98a12, 0 0 14px rgba(247, 216, 90, .25); }\\n  .dlg .rc-top { display: flex; align-items: center; gap: 8px; min-width: 0; }\\n  .dlg .rc-medal {\\n    flex: none; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center;\\n    font-weight: 800; font-size: 13px; color: #3a1d00; border: 2px solid var(--frame-dark);\\n    background: radial-gradient(circle at 35% 30%, #fff3b0, #e0a91f 60%, #b8860b);\\n  }\\n  .dlg .rc.r2 .rc-medal { background: radial-gradient(circle at 35% 30%, #ffffff, #c9c9d6 60%, #8d8da0); }\\n  .dlg .rc.r3 .rc-medal { background: radial-gradient(circle at 35% 30%, #ffd2a8, #cd7f32 60%, #8a4f1c); }\\n  .dlg .rc-title { font-size: 15px; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .dlg .rc-chips { display: flex; flex-wrap: wrap; gap: 4px; }\\n  .dlg .rc-chip { font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 9px; background: #4a2434; color: #ffd6ec; border: 1px solid #6a3444; }\\n  .dlg .rc-big b { font-size: 22px; font-weight: 800; color: #fff; text-shadow: 1px 1px 0 var(--frame-dark); }\\n  .dlg .rc.r1 .rc-big b { color: #f7d85a; }\\n  .dlg .rc-big span { font-size: 11px; color: #d9a7c4; font-weight: 700; }\\n  .dlg .rc-sub { margin-top: -6px; font-size: 11px; color: #b98aa6; }\\n  .dlg .rc-stats { display: grid; gap: 3px; padding-top: 8px; border-top: 1px solid #4a2530; }\\n  .dlg .rc-stat { display: flex; justify-content: space-between; gap: 8px; font-size: 11px; }\\n  .dlg .rc-stat span { color: #b98aa6; font-weight: 500; white-space: nowrap; }\\n  .dlg .rc-stat b { color: var(--cream); text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .dlg .fsec { margin: 12px 0 6px; font-size: 11px; letter-spacing: .05em; text-transform: uppercase; color: #ffa7d7; font-weight: 700; }\\n  .dlg .fgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 14px; }\\n  .dlg .frow { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 7px 10px; background: #2e1622; border: 1px solid #4a2530; border-radius: 7px; cursor: pointer; }\\n  .dlg .frow.fchk { justify-content: flex-start; }\\n  .dlg .frow.fta { grid-column: 1 / -1; flex-direction: column; align-items: stretch; cursor: default; }\\n  .dlg .frow textarea { width: 100%; min-height: 110px; resize: vertical; padding: 7px 9px; font: 500 11px Consolas, monospace;\\n    color: var(--cream); background: #1b0c14; border: 1px solid #6a3444; border-radius: 6px; outline: none; }\\n  .dlg .frow textarea:focus { border-color: #e77ad2; box-shadow: 0 0 0 1px #e77ad2; }\\n  .dlg .ftx b { display: block; color: #fff; font-size: 12px; }\\n  .dlg .ftx small { color: #b98aa6; font-size: 11px; font-weight: 500; }\\n  .dlg .frow input:not([type=checkbox]), .dlg .frow select {\\n    width: 140px; flex: none; padding: 5px 8px; font: inherit; font-size: 12px; color: var(--cream);\\n    background: #1b0c14; border: 1px solid #6a3444; border-radius: 6px; outline: none;\\n  }\\n  .dlg .frow input:not([type=checkbox]) { text-align: right; width: 90px; }\\n  .dlg .frow input:focus, .dlg .frow select:focus { border-color: #e77ad2; box-shadow: 0 0 0 1px #e77ad2; }\\n  @media (max-width: 620px) { .dlg .fgrid { grid-template-columns: 1fr; } }\\n  .dlg .dtab { margin-top: 12px; overflow-x: auto; border: 1px solid #5a3038; border-radius: 8px; }\\n  .dlg .dtab table { width: 100%; border-collapse: collapse; font-size: 12px; }\\n  .dlg .dtab th { text-align: left; padding: 7px 9px; background: #3a1820; color: #ffa7d7; font-weight: 700; white-space: nowrap; }\\n  .dlg .dtab td { padding: 8px 9px; border-top: 1px solid #3e1f2c; color: var(--cream); font-weight: 600; white-space: nowrap; }\\n  .dlg .dtab tr:first-child td { color: #fff; background: #3a2a10; }\\n  .dlg .dtab td:first-child { color: #f7d85a; font-weight: 800; }\\n  .dlg .foot { margin: 12px 0 0; color: #b98aa6; font-size: 11px; font-weight: 500; }\\n  .dlg.is-about .bd > div { flex: 1; }\\n  .dlg.is-about .ft { justify-content: center; }\\n  .ver {\\n    padding: 1px 7px 2px; border-radius: 9px;\\n    font-size: 10px; font-weight: 700; color: #3a1d00; text-shadow: none;\\n    background: linear-gradient(#f7d85a 0 50%, #e0a91f 50%);\\n    border: 1px solid var(--frame-dark);\\n  }\\n\\n  /* ---- menus suspensos (desenhados em HTML) ---- */\\n  #shade { position: fixed; inset: 34px 0 0 0; z-index: 1; }   /* clique fora = fecha */\\n  .dd {\\n    position: fixed; z-index: 3; min-width: 230px; padding: 5px;\\n    background: var(--box); color: var(--cream);\\n    border: 2px solid var(--frame-dark); border-radius: 8px;\\n    box-shadow: 0 0 0 1px #914850, 0 10px 24px rgba(20, 0, 8, .55);\\n    font: 600 12px \\\"Segoe UI\\\", system-ui, sans-serif;\\n    animation: ddIn .09s ease-out;\\n  }\\n  @keyframes ddIn { from { opacity: 0; transform: translateY(-4px); } }\\n  @media (prefers-reduced-motion: reduce) { .dd { animation: none; } }\\n  .dd .it {\\n    display: grid; grid-template-columns: 18px 1fr auto 12px; align-items: center; gap: 6px;\\n    width: 100%; height: 28px; padding: 0 8px 0 6px; margin: 0;\\n    font: inherit; color: inherit; text-align: left; cursor: pointer;\\n    background: none; border: 1px solid transparent; border-radius: 5px;\\n  }\\n  .dd .it:hover, .dd .it:focus-visible, .dd .it.sub-open {\\n    outline: none; color: #fff; border-color: var(--frame-dark);\\n    background: linear-gradient(var(--btn-top) 0 50%, var(--btn-bot) 50%);\\n    text-shadow: 1px 1px 0 var(--frame-dark);\\n  }\\n  .dd .it[disabled] { opacity: .45; cursor: default; background: none; border-color: transparent; text-shadow: none; }\\n  .dd .ck { color: #ffa7d7; font-size: 12px; text-align: center; }\\n  .dd .it:hover .ck, .dd .it.sub-open .ck { color: #fff; }\\n  .dd .ac { color: #d9a7c4; font-size: 11px; font-weight: 500; padding-left: 18px; }\\n  .dd .it:hover .ac { color: var(--cream); }\\n  .dd .ar { font-size: 9px; opacity: .8; }\\n  .dd .hr { height: 1px; margin: 5px 6px; background: #4a2530; }\\n\\n  /* ======== janela de configuração da Auto Compra ======== */\\n  .btn.go {\\n    color: #3a1d00; text-shadow: none;\\n    background: linear-gradient(#f7d85a 0 48%, #e0a91f 48% 90%, #c98a12 90%);\\n  }\\n  body.config {\\n    background: #24101a; border: 0; overflow: hidden; white-space: normal;\\n    font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif; color: var(--cream);\\n  }\\n  #cfg { display: flex; flex-direction: column; height: 100%; }\\n  /* cabeçalho = barra de título da janela (arrastável) */\\n  #cfg .ch {\\n    flex: none; display: flex; align-items: center; gap: 8px; height: 34px;\\n    padding: 0 150px 0 10px; background: #3a1820; -webkit-app-region: drag;\\n    box-shadow: inset 0 -2px 0 var(--frame-dark), inset 0 -3px 0 #5a3038;\\n  }\\n  #cfg .ch svg, #cfg .ch .appico { width: 18px; height: 18px; display: block; object-fit: contain; }\\n  #cfg .ch b { font-size: 12px; font-weight: 800; color: #fff; text-shadow: 1px 1px 0 var(--frame-dark); }\\n  #cfg .ch span { font-size: 12px; font-weight: 600; color: #b98aa6; }\\n  #cfg .cb { flex: 1; overflow: auto; padding: 18px max(20px, calc((100% - 620px) / 2)) 8px; }\\n  #cfg h1 { margin: 0 0 4px; font-size: 22px; font-weight: 800; color: #fff; text-shadow: 2px 2px 0 var(--frame-dark); }\\n  #cfg .sub { margin: 0 0 14px; color: #d9a7c4; font-weight: 500; line-height: 1.45; }\\n\\n  .pn {\\n    background: #2e1622; border: 2px solid var(--frame-dark); border-radius: 10px;\\n    box-shadow: 0 0 0 1px #5a3038; margin-bottom: 14px;\\n  }\\n  .pn-h { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 14px 0; }\\n  .pn-h h2 { margin: 0; font-size: 14px; font-weight: 800; color: #fff; }\\n  .pn-h small { color: #b98aa6; font-weight: 500; font-size: 12px; }\\n\\n  .cfg-note {\\n    display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; margin-bottom: 14px;\\n    background: #3a2410; border: 1px solid #c98a12; border-radius: 8px;\\n    color: #ffe9a8; font-weight: 500; line-height: 1.4; font-size: 12px;\\n  }\\n  .cfg-note .ni {\\n    flex: none; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center;\\n    background: radial-gradient(circle at 35% 30%, #f7d85a, #c98a12); color: #3a1d00;\\n    border: 1px solid var(--frame-dark); font-weight: 800; font-size: 12px;\\n  }\\n\\n  /* chave liga/desliga */\\n  .sw {\\n    appearance: none; -webkit-appearance: none; flex: none; margin: 0; cursor: pointer;\\n    width: 38px; height: 22px; border-radius: 11px; position: relative;\\n    background: #4a2530; border: 2px solid var(--frame-dark); box-shadow: 0 0 0 1px #5a3038;\\n    transition: background .12s;\\n  }\\n  .sw::after {\\n    content: \\\"\\\"; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%;\\n    background: #d9a7c4; transition: transform .12s, background .12s;\\n  }\\n  .sw:checked { background: linear-gradient(var(--btn-top), #e77ad2); }\\n  .sw:checked::after { transform: translateX(16px); background: #fff; }\\n  .sw:focus-visible { outline: 2px solid var(--cream); outline-offset: 2px; }\\n  @media (prefers-reduced-motion: reduce) { .sw, .sw::after { transition: none; } }\\n\\n  /* modo teste */\\n  .mode { display: flex; align-items: center; gap: 12px; padding: 12px 14px; }\\n  .mode .tx { flex: 1; }\\n  .mode .tx b { display: block; color: #fff; font-size: 14px; }\\n  .mode .tx small { color: #b98aa6; font-weight: 500; font-size: 12px; }\\n  .mode .tag { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 9px; border: 1px solid var(--frame-dark); }\\n  .mode .tag.on { background: linear-gradient(#f7d85a 0 50%, #e0a91f 50%); color: #3a1d00; }\\n  .mode .tag.off { background: #1d6b3a; color: #c8f5c8; }\\n\\n  /* abas das categorias (iguais às do Market) */\\n  .tabs { display: flex; gap: 6px; padding: 12px 14px 0; flex-wrap: wrap; }\\n  .tabs button {\\n    display: flex; align-items: center; gap: 6px; height: 28px; padding: 0 12px; cursor: pointer;\\n    font: inherit; font-size: 12px; color: var(--cream);\\n    background: #3a1c28; border: 2px solid var(--frame-dark); border-radius: 6px; box-shadow: 0 0 0 1px #5a3038;\\n  }\\n  .tabs button:hover { background: #4a2434; }\\n  .tabs button.cur {\\n    color: #fff; text-shadow: 1px 1px 0 var(--frame-dark);\\n    background: linear-gradient(var(--btn-top) 0 48%, var(--btn-bot) 48% 90%, var(--btn-edge) 90%);\\n    box-shadow: 0 0 0 1px var(--frame-hi);\\n  }\\n  .tabs .cnt {\\n    min-width: 18px; height: 16px; padding: 0 4px; border-radius: 8px; display: grid; place-items: center;\\n    font-size: 10px; background: var(--frame-dark); color: #ffa7d7;\\n  }\\n  .tabs .cnt.z { color: #7a5868; }\\n\\n  /* lista de itens */\\n  .items { padding: 10px 8px 8px; }\\n  .irow {\\n    display: grid; grid-template-columns: 44px 1fr 128px 128px; align-items: center; gap: 10px;\\n    padding: 8px 8px; border-radius: 8px;\\n  }\\n  .irow + .irow { border-top: 1px solid #3e1f2c; }\\n  .irow:hover { background: #351a27; }\\n  .irow .nm { font-weight: 700; color: #fff; }\\n  .irow.off .nm { color: #b98aa6; }\\n  .irow.off .fld { opacity: .45; }\\n  .ihead { display: grid; grid-template-columns: 44px 1fr 128px 128px; gap: 10px; padding: 0 8px 2px; font-size: 11px; color: #b98aa6; font-weight: 600; }\\n\\n  .fld { display: flex; align-items: center; background: #1b0c14; border: 1px solid #6a3444; border-radius: 6px; }\\n  .fld:focus-within { border-color: #e77ad2; box-shadow: 0 0 0 1px #e77ad2; }\\n  .fld input {\\n    width: 100%; min-width: 0; padding: 6px 8px; text-align: right; font: inherit;\\n    color: var(--cream); background: none; border: 0; outline: none;\\n  }\\n  .fld i { font-style: normal; font-size: 11px; color: #8a6a7a; padding-right: 8px; }\\n\\n  /* segurança */\\n  .sec { padding: 6px 14px 10px; }\\n  .srow { display: grid; grid-template-columns: 1fr 170px; align-items: center; gap: 14px; padding: 10px 0; }\\n  .srow + .srow { border-top: 1px solid #3e1f2c; }\\n  .srow b { display: block; color: #fff; }\\n  .srow small { color: #b98aa6; font-weight: 500; font-size: 12px; }\\n\\n  /* rodapé fixo */\\n  #cfg .cf {\\n    flex: none; display: flex; gap: 10px; align-items: center; padding: 12px 20px;\\n    background: #3a1820; box-shadow: inset 0 2px 0 var(--frame-dark), inset 0 3px 0 #5a3038;\\n  }\\n  #cfg .cf .grow { flex: 1; }\\n  #cfg .cf .btn { height: 30px; padding: 0 16px; font-size: 13px; }\\n  #cfg .cf .btn.plain { background: #3a1c28; box-shadow: 0 0 0 1px #5a3038, 0 0 0 2px var(--frame-dark); }\\n\\n  @media (max-width: 560px) {\\n    .irow, .ihead { grid-template-columns: 44px 1fr 100px 100px; }\\n    .srow { grid-template-columns: 1fr 130px; }\\n  }\\n  /* ======== janela de análise de PvP ======== */\\n  body.pvp { background: #24101a; border: 0; overflow: hidden; white-space: normal; font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif; color: var(--cream); }\\n  #pvp { display: flex; flex-direction: column; height: 100%; }\\n  #pvp .ch { flex: none; display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 150px 0 10px; background: #3a1820; -webkit-app-region: drag;\\n    box-shadow: inset 0 -2px 0 var(--frame-dark), inset 0 -3px 0 #5a3038; }\\n  #pvp .ch svg, #pvp .ch .appico { width: 18px; height: 18px; display: block; }\\n  #pvp .ch b { font-size: 12px; font-weight: 800; color: #fff; text-shadow: 1px 1px 0 var(--frame-dark); }\\n  #pvp .ch span { font-size: 12px; color: #b98aa6; }\\n  #pvp .tb { flex: none; display: flex; align-items: center; gap: 6px; padding: 10px 18px; background: #2a1320; border-bottom: 1px solid #3e1f2c; flex-wrap: wrap; }\\n  #pvp .tb .grow { flex: 1; }\\n  #pvp .tb button.acc { height: 28px; padding: 0 12px; font: inherit; font-size: 12px; color: var(--cream); cursor: pointer;\\n    background: #3a1c28; border: 2px solid var(--frame-dark); border-radius: 6px; box-shadow: 0 0 0 1px #5a3038; }\\n  #pvp .tb button.acc.cur { color: #fff; text-shadow: 1px 1px 0 var(--frame-dark); box-shadow: 0 0 0 1px var(--frame-hi);\\n    background: linear-gradient(var(--btn-top) 0 48%, var(--btn-bot) 48% 90%, var(--btn-edge) 90%); }\\n  #pvp .tb .btn { height: 28px; padding: 0 12px; }\\n  #pvp .cb { flex: 1; overflow: auto; padding: 16px 18px 24px; }\\n  .pv-msg { padding: 40px 10px; text-align: center; color: #d9a7c4; font-size: 14px; }\\n  .pv-cards { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin-bottom: 14px; }\\n  .pv-card { background: #2e1622; border: 2px solid var(--frame-dark); border-radius: 10px; box-shadow: 0 0 0 1px #5a3038; padding: 10px 12px; }\\n  .pv-card small { display: block; font-size: 10px; letter-spacing: .05em; text-transform: uppercase; color: #b98aa6; }\\n  .pv-card b { display: block; margin-top: 3px; font-size: 20px; font-weight: 800; color: #fff; }\\n  .pv-card b .w { color: #8ee08e; } .pv-card b .l { color: #ff8a8a; }\\n  .pv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }\\n  .pv-pn { background: #2e1622; border: 2px solid var(--frame-dark); border-radius: 10px; box-shadow: 0 0 0 1px #5a3038; margin-bottom: 14px; min-width: 0; }\\n  .pv-pn h2 { margin: 0; padding: 12px 14px 8px; font-size: 14px; font-weight: 800; color: #fff; }\\n  .pv-pn h2 small { font-weight: 500; color: #b98aa6; font-size: 11px; margin-left: 6px; }\\n  .pv-sug { list-style: none; margin: 0; padding: 0 12px 12px; display: grid; gap: 6px; }\\n  .pv-sug li { display: flex; gap: 10px; align-items: flex-start; padding: 8px 10px; background: #351a27; border-radius: 7px; line-height: 1.4; font-weight: 500; }\\n  .pv-sug li i { flex: none; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-style: normal; font-size: 11px; font-weight: 800;\\n    border: 1px solid var(--frame-dark); color: #fff; background: radial-gradient(circle at 35% 30%, var(--chip-1), var(--chip-2)); }\\n  .pv-sug li.rival i { background: radial-gradient(circle at 35% 30%, #ff8a8a, #b8283c); }\\n  .pv-sug li.forte i { background: radial-gradient(circle at 35% 30%, #fff3b0, #e0a91f 60%, #b8860b); color: #3a1d00; }\\n  .pv-sug li.counter i { background: radial-gradient(circle at 35% 30%, #8ec5ff, #2f6fd6); }\\n  .pv-sug li.ordem i { background: radial-gradient(circle at 35% 30%, #8ee08e, #009c3b); }\\n  .pv-tab { width: 100%; border-collapse: collapse; font-size: 12px; }\\n  .pv-tab th { text-align: left; padding: 6px 10px; color: #ffa7d7; font-size: 11px; font-weight: 700; background: #3a1820; white-space: nowrap; }\\n  .pv-tab td { padding: 7px 10px; border-top: 1px solid #3e1f2c; white-space: nowrap; }\\n  .pv-tab td.n { color: #fff; font-weight: 700; }\\n  .pv-tab .w { color: #8ee08e; } .pv-tab .l { color: #ff8a8a; }\\n  .pv-bar { display: inline-block; vertical-align: middle; width: 60px; height: 7px; border-radius: 4px; background: #4a2530; overflow: hidden; margin-right: 6px; }\\n  .pv-bar span { display: block; height: 100%; background: linear-gradient(90deg, #e05a6a, #f7d85a 50%, #4ccf6a); }\\n  .pv-scroll { max-height: 360px; overflow: auto; }\\n  .pv-type { display: inline-block; font-size: 9px; font-weight: 800; padding: 1px 5px; border-radius: 4px; margin-right: 3px; color: #fff; text-shadow: 0 1px 0 rgba(0,0,0,.4); }\\n  .pv-chip { display: inline-block; font-size: 11px; font-weight: 700; padding: 1px 7px; border-radius: 9px; margin: 1px 3px 1px 0; }\\n  .pv-chip.ok { background: #1d4d2a; color: #b6f5c0; } .pv-chip.no { background: #5a1c26; color: #ffc2c8; }\\n  .pv-ct { padding: 8px 14px; border-top: 1px solid #3e1f2c; }\\n  .pv-ct .t { display: flex; justify-content: space-between; gap: 8px; align-items: center; }\\n  .pv-ct .t b { color: #fff; }\\n  .pv-ct .t span { font-size: 11px; color: #ff8a8a; }\\n  .pv-ct .u { margin-top: 4px; font-size: 11px; color: #b98aa6; }\\n  /* abas e blocos organizados */\\n  .pv-nav { flex: none; display: flex; gap: 2px; padding: 0 18px; background: #2a1320; border-bottom: 1px solid #3e1f2c; }\\n  .pv-tab { height: 36px; padding: 0 16px; cursor: pointer; font: 700 13px \\\"Segoe UI\\\", sans-serif; color: #b98aa6;\\n    background: none; border: 0; border-bottom: 3px solid transparent; }\\n  .pv-tab:hover { color: #fff; }\\n  .pv-tab.cur { color: #fff; border-bottom-color: #c878a8; }\\n  .pv-pn h2 { display: flex; align-items: baseline; gap: 6px; }\\n  .pv-more { margin-left: auto; padding: 0; border: 0; background: none; cursor: pointer; font: 700 11px \\\"Segoe UI\\\", sans-serif; color: #ffa7d7; }\\n  .pv-more:hover { text-decoration: underline; }\\n  .pv-pb { padding: 0 12px 12px; display: grid; gap: 6px; }\\n  .pv-pn.rival { box-shadow: 0 0 0 1px #6a2a34; } .pv-pn.ordem { box-shadow: 0 0 0 1px #2f6b22; }\\n  .pv-pn.counter { box-shadow: 0 0 0 1px #2f5a8a; } .pv-pn.time { box-shadow: 0 0 0 1px #6a5a20; }\\n  .pv-row { padding: 8px 10px; background: #351a27; border-radius: 8px; display: grid; gap: 4px; }\\n  .pv-row-a { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }\\n  .pv-row-a > b { color: #fff; font-size: 13px; }\\n  .pv-row-b { display: flex; align-items: center; gap: 6px; font-size: 11px; color: #d9a7c4; }\\n  .pv-row-c { font-size: 12px; color: #d9a7c4; font-weight: 500; }\\n  .pv-row-c b { color: #fff; }\\n  .pv-rec { margin-left: auto; font-size: 12px; } .pv-rec .w { color: #8ee08e; } .pv-rec .l { color: #ff8a8a; }\\n  .pv-wr { margin-left: auto; font-size: 11px; font-weight: 700; } .pv-wr.l { color: #ff8a8a; } .pv-wr.w { color: #8ee08e; }\\n  .pv-ordem { display: flex; align-items: center; flex-wrap: wrap; gap: 4px; }\\n  .pv-mon { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 9px; background: #1d4d2a; color: #c8f5c8; }\\n  .pv-arr { color: #8a6a7a; font-size: 11px; }\\n  .pv-hl { display: flex; gap: 10px; align-items: flex-start; padding: 8px 10px; border-radius: 8px; background: #351a27; font-weight: 500; line-height: 1.4; }\\n  .pv-hl i { flex: none; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font-style: normal; font-size: 11px; font-weight: 800; color: #fff; }\\n  .pv-hl.good i { background: radial-gradient(circle at 35% 30%, #fff3b0, #e0a91f 60%, #b8860b); color: #3a1d00; }\\n  .pv-hl.bad i { background: radial-gradient(circle at 35% 30%, #ff8a8a, #b8283c); }\\n  .pv-hl.warn i { background: radial-gradient(circle at 35% 30%, var(--chip-1), var(--chip-2)); }\\n  .pv-none { font-size: 12px; color: #8a6a7a; padding: 4px 2px; font-weight: 500; }\\n  .pv-foot { margin-top: 6px; font-size: 11px; color: #8a6a7a; line-height: 1.5; }\\n  @media (max-width: 900px) { .pv-grid { grid-template-columns: 1fr; } .pv-cards { grid-template-columns: repeat(3, 1fr); } }\\n  /* ======== janela de pontos da Kick ======== */\\n  body.kickw { background: #24101a; border: 0; overflow: hidden; white-space: normal; font: 600 13px \\\"Segoe UI\\\", system-ui, sans-serif; color: var(--cream); }\\n  #kickw { display: flex; flex-direction: column; height: 100%; }\\n  #kickw .ch { flex: none; display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 150px 0 10px; background: #3a1820; -webkit-app-region: drag;\\n    box-shadow: inset 0 -2px 0 var(--frame-dark), inset 0 -3px 0 #5a3038; }\\n  #kickw .ch svg, #kickw .ch .appico { width: 18px; height: 18px; display: block; }\\n  #kickw .ch b { font-size: 12px; font-weight: 800; color: #fff; text-shadow: 1px 1px 0 var(--frame-dark); }\\n  #kickw .ch span { font-size: 12px; color: #b98aa6; }\\n  #kickw .cb { flex: 1; overflow: auto; padding: 16px 18px 24px; }\\n  #kickw .cb { padding: 14px 18px 22px; }\\n  .kx-top { flex: none; display: flex; align-items: center; gap: 6px; padding: 10px 18px; background: #2a1320; border-bottom: 1px solid #3e1f2c; flex-wrap: wrap; }\\n  .kx-top .grow { flex: 1; }\\n  .kx-tab { display: inline-flex; align-items: center; gap: 7px; height: 30px; padding: 0 12px; cursor: pointer;\\n    font: 700 12px \\\"Segoe UI\\\", sans-serif; color: var(--cream); background: #3a1c28; border: 2px solid var(--frame-dark); border-radius: 8px; }\\n  .kx-tab:hover { filter: brightness(1.15); }\\n  .kx-tab.cur { color: #fff; background: linear-gradient(#1d6b1a 0 48%, #2f9a22 48%); box-shadow: 0 0 0 1px #53fc18; }\\n  .kx-tab.off { opacity: .55; }\\n  .kx-badge { min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px; display: grid; place-items: center; font-size: 11px; background: #0e1f0b; color: #8ef07a; }\\n  .kx-btn { height: 30px; padding: 0 14px; cursor: pointer; font: 700 12px \\\"Segoe UI\\\", sans-serif; color: var(--cream);\\n    background: #3a1c28; border: 2px solid var(--frame-dark); border-radius: 8px; white-space: nowrap; }\\n  .kx-btn:hover { filter: brightness(1.2); }\\n  .kx-btn.small { height: 28px; padding: 0 10px; font-size: 11px; }\\n  .kx-btn.go { color: #0b2e0b; background: linear-gradient(#a8ff8a, #53fc18); border-color: #12210e; }\\n  .kx-btn:disabled, .kx-btn.go:disabled { cursor: not-allowed; filter: none; color: #6a5a62; background: #2a1a22; border-color: #3a2430; }\\n  .kx-btn.sel { color: #fff; background: #1d4d1a; box-shadow: 0 0 0 1px #53fc18; }\\n  .kx-sum { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding: 12px 14px; margin-bottom: 14px;\\n    background: linear-gradient(90deg, #142112, #1d1420); border: 1px solid #2f4a26; border-radius: 12px; }\\n  .kx-sum > div:first-child { flex: 1; min-width: 220px; }\\n  .kx-sum > div:first-child b { display: block; color: #fff; font-size: 14px; }\\n  .kx-sum > div:first-child span { font-size: 12px; color: #b98aa6; font-weight: 500; }\\n  .kx-goalbar { display: flex; gap: 8px; }\\n  .kx-goalbar div { padding: 6px 10px; border-radius: 8px; background: #0e1a0b; border: 1px solid #2f6b22; text-align: center; }\\n  .kx-goalbar b { display: block; color: #8ef07a; font-size: 13px; }\\n  .kx-goalbar span { font-size: 10px; color: #d8f5cf; }\\n  .kx-h { margin: 6px 2px 10px; font-size: 13px; color: #fff; letter-spacing: .02em; }\\n  .kx-h small { margin-left: 6px; font-size: 11px; font-weight: 500; color: #b98aa6; }\\n  .kx-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin-bottom: 18px; }\\n  .kx-card { display: flex; flex-direction: column; gap: 12px; padding: 14px; border-radius: 14px;\\n    background: linear-gradient(160deg, #1d2a18, #24121c 70%); border: 1px solid #2f6b22; box-shadow: 0 6px 18px rgba(0,0,0,.25); }\\n  .kx-card.idle { background: linear-gradient(160deg, #1e1a1e, #22121a 70%); border-color: #4a2530; }\\n  .kx-card.idle .kx-ring { filter: saturate(.35) brightness(.8); }\\n  .kx-off { color: #f7d85a; }\\n  .kx-card.done { border-color: #f7d85a; box-shadow: 0 0 0 1px #f7d85a, 0 6px 18px rgba(0,0,0,.25); }\\n  .kx-ch { display: flex; align-items: center; justify-content: space-between; gap: 8px; }\\n  .kx-ch b { font-size: 15px; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .kx-st { font-size: 10px; font-weight: 800; padding: 3px 8px; border-radius: 10px; background: #2a1a22; color: #b98aa6; white-space: nowrap; }\\n  .kx-st.ok { background: #0e2a0b; color: #8ef07a; }\\n  .kx-st.live { display: inline-flex; align-items: center; gap: 6px; background: #3a1018; color: #fff; letter-spacing: .04em; }\\n  .kx-st.live .rec { display: inline-block; flex: none; width: 8px; height: 8px; border-radius: 50%; background: #ff3b4e; box-shadow: 0 0 6px #ff3b4e; animation: recBlink 1s steps(1) infinite; }\\n  @media (prefers-reduced-motion: reduce) { .kx-st.live .rec { animation: none; } }\\n  .kx-st.warn { background: #3a2a10; color: #f7d85a; }\\n  .kx-st.bad { background: #3a1018; color: #ff8a8a; }\\n  .kx-mid { display: flex; align-items: center; gap: 14px; }\\n  .kx-ringbox { position: relative; width: 92px; height: 92px; flex: none; }\\n  .kx-ring { position: absolute; inset: 0; border-radius: 50%;\\n    background: conic-gradient(#53fc18 calc(var(--p) * 1%), #2a1a22 0); }\\n  .kx-ring.full { background: conic-gradient(#f7d85a 100%, #2a1a22 0); }\\n  .kx-ring-in { position: absolute; inset: 8px; border-radius: 50%; background: #1c1a1e; }\\n  .kx-ringtx { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }\\n  .kx-ringtx b { font-size: 22px; font-weight: 800; color: #fff; line-height: 1; }\\n  .kx-ringtx span { font-size: 10px; color: #b98aa6; }\\n  .kx-info { flex: 1; min-width: 0; display: grid; gap: 3px; }\\n  .kx-next { font-size: 12px; color: #d9a7c4; }\\n  .kx-next b { color: #fff; }\\n  .kx-falta { font-size: 13px; color: #d8f5cf; }\\n  .kx-falta b { color: #8ef07a; }\\n  .kx-meta { font-size: 11px; color: #b98aa6; }\\n  .kx-meta b { color: #8ef07a; }\\n  .kx-goals { display: flex; gap: 4px; margin-top: 3px; }\\n  .kx-goals span { font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 6px; background: #2a1a22; color: #8a6a7a; }\\n  .kx-goals span.on { background: #1d4d1a; color: #8ef07a; }\\n  .kx-act { display: flex; gap: 8px; }\\n  .kx-act .kx-btn { flex: 1; }\\n  .kx-minis { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 8px; margin-bottom: 14px; }\\n  .kx-mini { display: flex; align-items: center; gap: 8px; height: 38px; padding: 0 12px; cursor: pointer; text-align: left;\\n    font: 700 12px \\\"Segoe UI\\\", sans-serif; color: var(--cream); background: #2e1622; border: 1px solid #4a2530; border-radius: 10px; }\\n  .kx-mini:hover { filter: brightness(1.2); }\\n  /* remover canal (não é mais parceiro) */\\n  .kx-x { display: inline-grid; place-items: center; width: 18px; height: 18px; flex: none; border-radius: 4px; cursor: pointer;\\n    font: 700 13px/1 inherit; color: #c9a3ad; background: transparent; border: 1px solid transparent; padding: 0; }\\n  .kx-x:hover { color: #fff; background: #7a2232; border-color: #b8474f; }\\n  .kx-chr { display: flex; align-items: center; gap: 6px; }\\n  .kx-mini.rmv { opacity: .7; }\\n  .kx-mini.rmv .nm { text-decoration: line-through; }\\n  .kx-mini.rmv b { font-weight: 600; color: #e7c46a; }\\n  .kx-mini .dot { width: 8px; height: 8px; flex: none; border-radius: 50%; background: #5a4650; }\\n  .kx-mini.live .dot { background: #53fc18; box-shadow: 0 0 6px #53fc18; }\\n  .kx-mini .nm { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\\n  .kx-mini b { color: #b98aa6; font-weight: 700; }\\n  .kx-mini i { font-style: normal; color: #8ef07a; }\\n  .kx-mini.sel { background: #1d3a18; border-color: #53fc18; }\\n  .kx-mini.sel b { color: #c8f5c8; }\\n  .kx-empty { padding: 14px; margin-bottom: 16px; font-size: 12px; color: #b98aa6; background: #2a1320; border-radius: 10px; }\\n  .kx-empty.big { display: grid; gap: 4px; padding: 30px; text-align: center; }\\n  .kx-empty.big b { color: #fff; font-size: 15px; }\\n  .kx-empty.big .kx-on { margin-top: 10px; height: 34px; padding: 0 18px; font-size: 13px; }\\n  .kx-av { margin-right: 6px; color: var(--cream); }\\n  .kx-sw { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; color: #d8f5cf; cursor: pointer; }\\n  .kx-foot { margin-top: 4px; font-size: 11px; color: #8a6a7a; line-height: 1.5; }\\n  .btn.resg .chip { background: radial-gradient(circle at 35% 30%, #a8ff8a, #3cd61b); }\\n</style>\\n<div id=\\\"tb\\\" hidden></div>\\n<div id=\\\"kickw\\\" hidden></div>\\n<div id=\\\"pvp\\\" hidden></div>\\n<div id=\\\"app\\\"></div>\\n<div id=\\\"cfg\\\" hidden>\\n  <div class=\\\"ch\\\"><span id=\\\"cfgIco\\\"></span><b>Auto Compra</b><span>Configurações</span></div>\\n  <div class=\\\"cb\\\">\\n    <div class=\\\"cfg-contas\\\"><span>Configurando:</span><div id=\\\"cfgContas\\\"></div>\\n      <label class=\\\"cfg-todas\\\" title=\\\"Ao salvar, copia estas regras para todas as contas\\\"><input type=\\\"checkbox\\\" id=\\\"cfgTodas\\\"> Salvar para todas</label></div>\\n    <div class=\\\"pn acc-row\\\" id=\\\"cfgAcc\\\" hidden>\\n      <label class=\\\"mode\\\">\\n        <span class=\\\"tx\\\"><b id=\\\"cfgAccNome\\\">Auto Compra nesta conta</b><small id=\\\"cfgAccSt\\\"></small></span>\\n        <input type=\\\"checkbox\\\" class=\\\"sw\\\" id=\\\"cfgAccOn\\\">\\n      </label>\\n    </div>\\n    <h1>Auto Compra</h1>\\n    <p class=\\\"sub\\\">Compra pokébolas, poções e revives no Market quando estiverem acabando. Cada conta tem as próprias regras: escolha a conta no topo. O liga/desliga vale na hora; as regras, ao clicar em Salvar.</p>\\n\\n    <div class=\\\"cfg-note\\\"><span class=\\\"ni\\\">!</span><span>Compras automáticas podem não ser permitidas pelas regras do PokeIdle. Confira os termos do jogo antes de ligar. O uso é por sua conta e risco.</span></div>\\n\\n    <div class=\\\"pn\\\">\\n      <label class=\\\"mode\\\">\\n        <span class=\\\"tx\\\"><b>Modo teste</b><small>Só registra no histórico o que compraria, sem gastar ouro. Desligue quando tiver conferido.</small></span>\\n        <span class=\\\"tag\\\" id=\\\"dryTag\\\"></span>\\n        <input type=\\\"checkbox\\\" class=\\\"sw\\\" id=\\\"dry\\\">\\n      </label>\\n    </div>\\n\\n    <div class=\\\"pn\\\">\\n      <div class=\\\"pn-h\\\"><h2>O que comprar</h2><small>Ligue os itens que você quer manter em estoque</small></div>\\n      <div class=\\\"tabs\\\" id=\\\"tabs\\\"></div>\\n      <div class=\\\"items\\\">\\n        <div class=\\\"ihead\\\"><span></span><span>Item</span><span>Comprar abaixo de</span><span>Quantidade</span></div>\\n        <div id=\\\"rules\\\"></div>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"pn\\\">\\n      <div class=\\\"pn-h\\\"><h2>Segurança</h2></div>\\n      <div class=\\\"sec\\\">\\n        <label class=\\\"srow\\\"><span><b>Ouro mínimo que deve sobrar</b><small>Nunca compra se o ouro for ficar abaixo disso</small></span>\\n          <span class=\\\"fld\\\"><input id=\\\"reserve\\\" inputmode=\\\"numeric\\\" class=\\\"num\\\"><i>ouro</i></span></label>\\n        <label class=\\\"srow\\\"><span><b>Limite de gasto por hora</b><small>Máximo gasto por conta a cada hora</small></span>\\n          <span class=\\\"fld\\\"><input id=\\\"maxHour\\\" inputmode=\\\"numeric\\\" class=\\\"num\\\"><i>ouro</i></span></label>\\n        <label class=\\\"srow\\\"><span><b>Verificar a cada</b><small>De quanto em quanto tempo olhar o estoque (1 a 120)</small></span>\\n          <span class=\\\"fld\\\"><input id=\\\"intervalMin\\\" inputmode=\\\"numeric\\\" class=\\\"num\\\"><i>min</i></span></label>\\n      </div>\\n    </div>\\n  </div>\\n  <div class=\\\"cf\\\">\\n    <button class=\\\"btn plain\\\" id=\\\"defaults\\\" title=\\\"Volta as regras para o padrão\\\">Padrões</button>\\n    <button class=\\\"btn plain\\\" id=\\\"cfgLog\\\" title=\\\"Abre o histórico de compras (todas as contas)\\\">Histórico</button>\\n    <button class=\\\"btn plain\\\" id=\\\"cfgNow\\\" hidden title=\\\"Confere o estoque desta conta agora\\\">Verificar agora</button>\\n\\n    <span class=\\\"grow\\\"></span>\\n    <button class=\\\"btn plain\\\" id=\\\"cancel\\\">Cancelar</button>\\n    <button class=\\\"btn go\\\" id=\\\"save\\\">Salvar</button>\\n  </div>\\n</div>\\n<script>\\n  const params = new URLSearchParams(location.search);\\n  const MODE = params.get('mode');\\n  const I = Number(params.get('i'));\\n  const app = document.getElementById('app');\\n\\n  /* ------------------------- configuração ------------------------- */\\n  function initConfig(painel) {\\n    // painel = { fechar }: a configuração abre como um painel que desce do botão (sem janela separada)\\n    const fechar = painel ? painel.fechar : () => window.api.closeSelf();\\n    if (!painel) {\\n      document.body.classList.add('config');\\n      document.title = 'Auto Compra — Configurações';\\n      app.hidden = true;\\n    }\\n    document.getElementById('cfg').hidden = false;\\n    const $ = (id) => document.getElementById(id);\\n\\n    // números com separador de milhar (1.000.000); ao salvar, só os dígitos\\n    const fmt = (v) => { const d = String(v == null ? '' : v).replace(/\\\\D/g, ''); return d ? Number(d).toLocaleString('pt-BR') : ''; };\\n    const raw = (v) => String(v || '').replace(/\\\\D/g, '');\\n    const numInput = (inp, v) => {\\n      inp.value = fmt(v);\\n      inp.oninput = () => {\\n        const pos = inp.value.length - inp.selectionStart;\\n        inp.value = fmt(inp.value);\\n        const p = Math.max(0, inp.value.length - pos);\\n        inp.setSelectionRange(p, p);\\n      };\\n    };\\n\\n    let RULES = [];\\n    let curCat = null;\\n\\n    function dryTag() {\\n      const on = $('dry').checked;\\n      $('dryTag').textContent = on ? 'Ligado: não compra' : 'Desligado: compra de verdade';\\n      $('dryTag').className = 'tag ' + (on ? 'on' : 'off');\\n    }\\n    $('dry').onchange = dryTag;\\n\\n    function drawTabs() {\\n      const cats = [...new Set(RULES.map((r) => r.cat))];\\n      if (!cats.includes(curCat)) curCat = cats[0];\\n      const tabs = $('tabs');\\n      tabs.innerHTML = '';\\n      cats.forEach((c) => {\\n        const n = RULES.filter((r) => r.cat === c && r.on).length;\\n        const b = el('button', c === curCat ? 'cur' : '', '<span></span><span class=\\\"cnt' + (n ? '' : ' z') + '\\\">' + n + '</span>');\\n        b.firstChild.textContent = c;\\n        b.title = n + ' ite' + (n === 1 ? 'm ligado' : 'ns ligados');\\n        b.onclick = () => { curCat = c; drawTabs(); drawRules(); };\\n        tabs.appendChild(b);\\n      });\\n    }\\n\\n    function drawRules() {\\n      const body = $('rules');\\n      body.innerHTML = '';\\n      RULES.filter((r) => r.cat === curCat).forEach((r) => {\\n        const row = el('label', 'irow' + (r.on ? '' : ' off'));\\n        row.innerHTML =\\n          '<input type=\\\"checkbox\\\" class=\\\"sw\\\">' +\\n          '<span class=\\\"nm\\\"></span>' +\\n          '<span class=\\\"fld\\\"><input class=\\\"min\\\" inputmode=\\\"numeric\\\"></span>' +\\n          '<span class=\\\"fld\\\"><input class=\\\"buy\\\" inputmode=\\\"numeric\\\"></span>';\\n        row.querySelector('.nm').textContent = r.name;\\n        const sw = row.querySelector('.sw');\\n        sw.checked = !!r.on;\\n        sw.onchange = () => { r.on = sw.checked; row.classList.toggle('off', !r.on); drawTabs(); };\\n        const mi = row.querySelector('.min'), bu = row.querySelector('.buy');\\n        numInput(mi, r.min); numInput(bu, r.buy);\\n        mi.onchange = () => { r.min = raw(mi.value); };\\n        bu.onchange = () => { r.buy = raw(bu.value); };\\n        mi.addEventListener('input', () => { r.min = raw(mi.value); });\\n        bu.addEventListener('input', () => { r.buy = raw(bu.value); });\\n        body.appendChild(row);\\n      });\\n    }\\n\\n    let fill = function (c) {\\n      $('dry').checked = !!c.dry;\\n      dryTag();\\n      numInput($('reserve'), c.reserve);\\n      numInput($('maxHour'), c.maxHour);\\n      numInput($('intervalMin'), c.intervalMin);\\n      RULES = c.rules.map((r) => ({ ...r }));\\n      drawTabs();\\n      drawRules();\\n      if (c.icon !== undefined) $('cfgIco').innerHTML = iconHtml(c.icon);\\n    }\\n    function collect() {\\n      return {\\n        dry: $('dry').checked,\\n        reserve: raw($('reserve').value),\\n        maxHour: raw($('maxHour').value),\\n        intervalMin: raw($('intervalMin').value),\\n        rules: RULES.map((r) => ({ name: r.name, on: !!r.on, min: raw(r.min), buy: raw(r.buy) })),\\n      };\\n    }\\n    // cada conta tem a própria configuração: abas no topo para escolher qual conta editar\\n    let conta = painel && Number.isInteger(painel.conta) ? painel.conta : 0;\\n    function abasContas(c) {\\n      const box = $('cfgContas');\\n      window.__cfgContaAtual = conta;\\n      if (!box || !c.contas) return;\\n      box.innerHTML = '';\\n      c.contas.forEach((k, n) => {\\n        const bt = document.createElement('button');\\n        bt.className = 'cfg-ct' + (n === conta ? ' cur' : '') + (k.on ? ' on' : '');\\n        bt.textContent = k.nome;\\n        bt.title = k.on ? 'Auto Compra ligada nesta conta' : 'Auto Compra desligada nesta conta';\\n        bt.onclick = () => { conta = n; window.api.autoGet(false, conta).then(fill); };\\n        box.appendChild(bt);\\n      });\\n      const k = c.contas[conta];\\n      const sw = $('cfgAccOn');\\n      if (k && sw && $('cfgAcc') && !$('cfgAcc').hidden) {\\n        $('cfgAccNome').textContent = `Auto Compra ligada em ${k.nome}`;\\n        sw.checked = !!k.on;\\n        $('cfgAccSt').textContent = k.on ? 'Ligada' : 'Desligada: ligue aqui para começar a comprar sozinho';\\n        sw.onchange = () => { window.api.setAuto(conta, sw.checked); k.on = sw.checked; $('cfgAccSt').textContent = sw.checked ? 'Ligada' : 'Desligada'; abasContas(c); };\\n      }\\n    }\\n    const fillBase = fill;\\n    fill = (c) => { fillBase(c); abasContas(c); };\\n    window.__cfgFill = fill;\\n    window.__cfgConta = (n) => { conta = n; window.api.autoGet(false, conta).then(fill); };\\n    if ($('cfgLog')) $('cfgLog').onclick = () => window.api.autoLog();\\n    window.api.autoGet(false, conta).then(fill);\\n    $('defaults').onclick = () => window.api.autoGet(true, conta).then(fill);\\n    $('cancel').onclick = () => fechar();\\n    $('save').onclick = async () => { await window.api.autoSave(collect(), conta, $('cfgTodas') && $('cfgTodas').checked); fechar(); };\\n    if (!painel) document.addEventListener('keydown', (e) => { if (e.key === 'Escape') fechar(); });\\n  }\\n\\n  /* ---------------------- Mega Eco: painel das 4 contas ---------------------- */\\n  function initResumo() {\\n    document.body.classList.add('resumo');\\n    document.title = 'Mega Eco';\\n    app.hidden = true;\\n    const root = el('div', 'dz');\\n    document.body.appendChild(root);\\n    const esc = (t) => String(t == null ? '' : t).replace(/[&<>\\\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;' }[c]));\\n    const num = (t) => { const n = Number(String(t || '').replace(/\\\\./g, '').replace(',', '.').replace(/[^\\\\d.-]/g, '')); return isFinite(n) ? n : 0; };\\n    const curto = (n) => { n = Number(n) || 0; const a = Math.abs(n);\\n      return a >= 1e9 ? (n / 1e9).toFixed(1).replace('.', ',') + 'B' : a >= 1e6 ? (n / 1e6).toFixed(1).replace('.', ',') + 'M' : a >= 1e3 ? (n / 1e3).toFixed(1).replace('.', ',') + 'k' : String(Math.round(n)); };\\n    const dur = (ms) => { const m = Math.max(0, Math.round(ms / 60000)); return m < 60 ? `${m} min` : `${Math.floor(m / 60)}h${String(m % 60).padStart(2, '0')}`; };\\n    const soma = (o) => Object.values(o || {}).reduce((t, v) => t + (Number(v) || 0), 0);\\n    const hora = (t) => (t ? new Date(t).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) : '');\\n    // nomes curtos para os bônus do jogo\\n    const chipCurto = (a) => {\\n      const n = `${a.nome} ${a.valor}`.replace(/\\\\s+/g, ' ').trim();\\n      if (/twitch/i.test(n)) return { t: 'Twitch ' + ((n.match(/\\\\+[\\\\d,]+%/) || [''])[0]), c: 'tw' };\\n      if (/kick/i.test(n)) return { t: 'Kick', c: 'kk' };\\n      if (/guild/i.test(n)) return { t: 'Guild ' + ((n.match(/\\\\+[\\\\d,]+%/) || [''])[0]), c: 'g' };\\n      if (/vip/i.test(n) || /^\\\\+50% XP$/.test(n)) return { t: 'VIP', c: 'v' };\\n      if (/passe/i.test(n)) return { t: 'Passe', c: 'v' };\\n      if (/boost pok/i.test(n)) return { t: 'Boost Pk', c: 'b' };\\n      if (/boost/i.test(n)) return { t: 'Boost', c: 'b' };\\n      return { t: n.slice(0, 16), c: '' };\\n    };\\n    // ritmo por hora: usa o que o Modo Economia do jogo mostra; se não tiver, calcula pela sessão\\n    const rates = (d) => { const s = d.ses || {}; const h = (s.ms || 0) / 3600000; const r = (v) => (h > 0.02 ? (Number(v) || 0) / h : 0);\\n      const e = d.eco || {};\\n      const doJogo = (l, alt) => (l && /\\\\/h$/.test(l[2] || '') ? num(l[2]) : alt);\\n      return { xp: doJogo(e.xpT, r(s.xpTreinador)), xpPk: doJogo(e.xpP, r(s.xpPokemon)), ouro: doJogo(e.lucro, r(s.gold)),\\n        abates: doJogo(e.abates, r(s.abates)), caps: doJogo(e.capturas, r(s.capturas)) }; };\\n\\n    // itens: só os que você tem (quantidade maior que zero)\\n    const itensDe = (d) => ((d.eco && d.eco.itens && d.eco.itens.length ? d.eco.itens : d.itens) || []).filter((it) => num(it.n) > 0);\\n    // um quadrinho de número no estilo do Modo Economia do jogo\\n    const tile = (cls, rot, l, fallback) => {\\n      const v = l && l[1] ? l[1] : fallback.v;\\n      const rate = l && l[2] ? l[2] : fallback.r;\\n      const sub = l && l[3] ? l[3] : (fallback.s || '');\\n      const rateCurto = /\\\\/h$/.test(rate || '') ? curto(num(rate)) + '/h' : (rate || '');\\n      return `<div class=\\\"dz-t ${cls}\\\"><small>${rot}</small><b>${esc(/^[\\\\d.,−-]+$/.test(v) && num(v) >= 1e6 ? curto(num(v)) : v)}</b>` +\\n        `${rateCurto ? `<span class=\\\"r\\\">${esc(rateCurto)}</span>` : ''}${sub ? `<span class=\\\"s\\\">${esc(sub)}</span>` : ''}</div>`;\\n    };\\n    const capCard = (c) => {\\n      const ls = c.linhas || [];\\n      const nome = ls[0] || '';\\n      const nv = ls.find((x) => /^Nv\\\\s*\\\\d/.test(x)) || '';\\n      const hr = ls.find((x) => /^\\\\d{1,2}:\\\\d{2}$/.test(x)) || '';\\n      const chips = ls.filter((x) => /^(P\\\\d|IV\\\\s|Q\\\\s|N\\\\s)/.test(x));\\n      return `<div class=\\\"dz-cc\\\"><img src=\\\"${esc(c.img)}\\\" alt=\\\"\\\"><div><div class=\\\"dz-cc-n\\\"><b>${esc(nome)}</b> <span>${esc(nv)}</span><i>${esc(hr)}</i></div>` +\\n        `<div class=\\\"dz-cc-c\\\">${chips.map((x) => `<span class=\\\"${/^P/.test(x) ? 'p' : /^IV/.test(x) ? 'iv' : /^Q/.test(x) ? 'q' : 'n'}\\\">${esc(x)}</span>`).join('')}</div></div></div>`;\\n    };\\n    function card(d) {\\n      if (d.erro) return `<article class=\\\"dz-c\\\"><div class=\\\"dz-h\\\"><span class=\\\"dz-dot\\\"></span><b>${esc(d.nome)}</b></div><div class=\\\"dz-none\\\">Carregando o jogo...</div></article>`;\\n      const s = d.ses || {};\\n      const r = rates(d);\\n      const e = d.eco || {};\\n      const hunt = d.hunt || '';\\n      const st = !hunt ? ['parado', ''] : /boss|arena/i.test(hunt) ? ['boss', 'boss'] : ['caçando', 'on'];\\n      const hp = (d.pk.hp || '').match(/([\\\\d.]+)\\\\s*\\\\/\\\\s*([\\\\d.]+)/);\\n      const hpPct = hp ? Math.max(0, Math.min(100, (num(hp[1]) / Math.max(1, num(hp[2]))) * 100)) : 0;\\n      const hpCor = hpPct > 50 ? '#3ccf6a' : hpPct > 20 ? '#f7d85a' : '#ff5a6a';\\n      const huntNome = hunt.split('·')[0].trim();\\n      const huntNv = (hunt.split('·')[1] || '').trim();\\n      const its = itensDe(d);\\n      const capsEco = (e.caps || []).slice(0, 4);\\n      return `<article class=\\\"dz-c\\\">\\n        <div class=\\\"dz-h\\\">\\n          <span class=\\\"dz-dot ${st[1]}\\\"></span><b class=\\\"dz-nick\\\">${esc(d.nick || d.nome)}</b><span class=\\\"dz-nv\\\">Nv ${esc(d.nivel)}</span>\\n          <span class=\\\"dz-st ${st[1]}\\\">${e.tempo ? esc(e.tempo) + ' · ' : ''}${st[0]}</span>\\n          <button class=\\\"dz-ver\\\" data-ver=\\\"${d.conta}\\\" title=\\\"Abre esta conta (todas voltam ao Eco)\\\">Ver</button>\\n        </div>\\n        <div class=\\\"dz-chips\\\">${(d.ativos || []).map((a) => { const c = chipCurto(a); return `<span class=\\\"dz-chip ${c.c}\\\" title=\\\"${esc(a.nome + ' ' + a.valor + (a.tempo ? ' · ' + a.tempo : ''))}\\\">${esc(c.t)}</span>`; }).join('')}</div>\\n        <div class=\\\"dz-pk\\\">\\n          ${d.pk.sprite ? `<img src=\\\"${d.pk.sprite}\\\" alt=\\\"\\\">` : '<span class=\\\"dz-pk-sem\\\"></span>'}\\n          <div class=\\\"dz-pk-i\\\">\\n            <div><b>${esc(d.pk.nome || '—')}</b> <span>${esc(d.pk.lv)}</span></div>\\n            <div class=\\\"dz-hp\\\" title=\\\"${esc(d.pk.hp)}\\\"><i style=\\\"width:${hpPct}%;background:${hpCor}\\\"></i></div>\\n            <div class=\\\"dz-hunt\\\">${hunt ? `${esc(huntNome)}${huntNv ? ` <span>· ${esc(huntNv)}</span>` : ''}` : 'sem hunt agora'}</div>\\n          </div>\\n        </div>\\n        <div class=\\\"dz-tiles\\\">\\n          ${tile('xp', 'XP treinador', e.xpT, { v: curto(s.xpTreinador), r: curto(r.xp) + '/h' })}\\n          ${tile('xp', 'XP pokémon', e.xpP, { v: curto(s.xpPokemon), r: curto(r.xpPk) + '/h' })}\\n          ${tile('lucro', 'Lucro líquido', e.lucro, { v: curto(s.gold), r: curto(r.ouro) + '/h' })}\\n          ${tile('', 'Abates', e.abates, { v: curto(s.abates), r: curto(r.abates) + '/h' })}\\n          ${tile('', 'Capturas', e.capturas, { v: curto(s.capturas), r: curto(r.caps) + '/h' })}\\n          <div class=\\\"dz-t ouroT\\\"><small>Carteira</small><b class=\\\"ouro\\\">${curto(num(d.ouro))}</b><span class=\\\"s\\\">${esc(d.gemas || 0)} gemas · ${esc(d.diamantes || 0)} diam.</span></div>\\n        </div>\\n        ${(e.gastos || []).length || (e.achados || []).length ? `<div class=\\\"dz-ga\\\">\\n          ${(e.achados || []).length ? `<div><h4>Achados</h4><div class=\\\"dz-itens\\\">${e.achados.map((it) => `<span class=\\\"dz-it\\\"><img src=\\\"${esc(it.img)}\\\" alt=\\\"\\\">${esc(it.n)}</span>`).join('')}</div></div>` : ''}\\n          ${(e.gastos || []).length ? `<div><h4>Gastos</h4><div class=\\\"dz-itens\\\">${e.gastos.map((it) => `<span class=\\\"dz-it g\\\"><img src=\\\"${esc(it.img)}\\\" alt=\\\"\\\">${esc(it.n)}</span>`).join('')}</div></div>` : ''}\\n        </div>` : ''}\\n        ${its.length ? `<div class=\\\"dz-sec\\\"><h4>Itens</h4><div class=\\\"dz-itens\\\">${its.map((it) => `<span class=\\\"dz-it\\\" title=\\\"${esc(it.nome || '')}\\\"><img src=\\\"${esc(it.img)}\\\" alt=\\\"\\\">${esc(it.n)}</span>`).join('')}</div></div>` : ''}\\n        <div class=\\\"dz-sec\\\"><h4>Capturas</h4>\\n          ${capsEco.length ? `<div class=\\\"dz-ccs\\\">${capsEco.map(capCard).join('')}</div>`\\n            : `<div class=\\\"dz-caps\\\">${(d.caps || []).length ? d.caps.slice(0, 6).map((c) => `<span class=\\\"dz-cap${c.shiny ? ' sh' : ''}\\\" title=\\\"${hora(c.em)}\\\">${c.shiny ? '✨' : ''}${esc(c.nome)} <i>${esc(c.lv)}</i></span>`).join('') : '<span class=\\\"dz-none\\\">nenhuma ainda</span>'}</div>`}\\n        </div>\\n        <div class=\\\"dz-log\\\">${(d.log || []).slice(-3).map((l) => `<div class=\\\"${/desmai|morre|caiu|derrot.*seu/i.test(l) ? 'ruim' : /captur/i.test(l) ? 'bom' : ''}\\\">${esc(l)}</div>`).join('') || '<div class=\\\"dz-none\\\">sem eventos</div>'}</div>\\n        ${(d.auto || []).length ? `<div class=\\\"dz-auto\\\"><span class=\\\"dz-auto-t\\\">Automação</span>${d.auto.map((a) => `<span class=\\\"dz-tg${a.on ? ' on' : ''}\\\"><i></i>${esc(a.nome)}</span>`).join('')}</div>` : ''}\\n      </article>`;\\n    }\\n\\n    function draw(pkt) {\\n      const cs = pkt.contas || [];\\n      const ok = cs.filter((d) => !d.erro);\\n      const t = ok.reduce((a, d) => { const r = rates(d); return { ouroH: a.ouroH + r.ouro, xpH: a.xpH + r.xp, ouro: a.ouro + num(d.ouro), gemas: a.gemas + num(d.gemas),\\n        diam: a.diam + num(d.diamantes), caps: a.caps + ((d.ses || {}).capturas || 0) }; }, { ouroH: 0, xpH: 0, ouro: 0, gemas: 0, diam: 0, caps: 0 });\\n      root.innerHTML = `\\n        <header class=\\\"dz-top\\\">\\n          <div class=\\\"dz-tit\\\"><b>Mega Eco</b><span>os jogos seguem rodando, só não são desenhados</span></div>\\n          <div class=\\\"dz-tot\\\"><div><small>Ouro/h</small><b class=\\\"ouro\\\">${curto(t.ouroH)}</b></div><div><small>XP/h somado</small><b class=\\\"ouro\\\">${curto(t.xpH)}</b></div>\\n            <div><small>Ouro (todas)</small><b>${curto(t.ouro)}</b></div><div><small>Gemas (todas)</small><b>${curto(t.gemas)}</b></div>\\n            <div><small>Diamantes</small><b>${curto(t.diam)}</b></div><div><small>Capturas</small><b>${curto(t.caps)}</b></div></div>\\n          <div class=\\\"dz-bt\\\"><button class=\\\"dz-b\\\" data-lv=\\\"1\\\" title=\\\"Mostra os jogos em Modo Economia\\\">Ver os jogos (Eco)</button><button class=\\\"dz-b n\\\" data-lv=\\\"0\\\" title=\\\"Volta tudo ao normal\\\">Normal</button></div>\\n        </header>\\n        <div class=\\\"dz-grid\\\">${cs.map(card).join('')}</div>\\n        <div class=\\\"dz-foot\\\">Atualiza a cada 5 segundos · ${hora(pkt.at)}</div>`;\\n      root.querySelectorAll('[data-lv]').forEach((b) => { b.onclick = () => window.api.resumoNivel(-1, Number(b.dataset.lv)); });\\n      root.querySelectorAll('[data-ver]').forEach((b) => { b.onclick = () => window.api.resumoNivel(Number(b.dataset.ver), 1); });\\n    }\\n    window.api.onResumo(draw);\\n    root.innerHTML = '<div class=\\\"dz-none big\\\">Montando o painel...</div>';\\n    window.api.resumoReady();\\n  }\\n\\n  /* ---------------------- pontos da Kick (resgate) ---------------------- */\\n  function initKick(painel) {\\n    // painel = { fechar, conta }: abre como painel que desce do botão (sem janela separada)\\n    if (!painel) {\\n      document.body.classList.add('kickw');\\n      document.title = 'Pontos da Kick — PokeLink';\\n      app.hidden = true;\\n    }\\n    const root = document.getElementById('kickw');\\n    root.hidden = false;\\n    const esc = (t) => String(t == null ? '' : t).replace(/[&<>\\\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;' }[c]));\\n    const fmt = (n) => Number(n).toLocaleString('pt-BR');\\n    const dur = (ms) => { const m = Math.max(0, Math.round(ms / 60000)); return m < 60 ? `${m} min` : `${Math.floor(m / 60)}h${String(m % 60).padStart(2, '0')}`; };\\n    root.innerHTML = `<div class=\\\"ch\\\">${iconHtml(null)}<b>Pontos da Kick</b><span>resgate</span>${painel ? '<button class=\\\"cfg-x\\\" id=\\\"kwX\\\" title=\\\"Fechar\\\">×</button>' : ''}</div>\\n      <div class=\\\"kx-top\\\" id=\\\"kxTabs\\\"></div><div class=\\\"cb\\\" id=\\\"kwBody\\\"><div class=\\\"pv-msg\\\">Carregando...</div></div>`;\\n    if (painel) document.getElementById('kwX').onclick = () => painel.fechar();\\n    const tabs = document.getElementById('kxTabs');\\n    const body = document.getElementById('kwBody');\\n    let last = null;\\n    let conta = painel && Number.isInteger(painel.conta) ? painel.conta : null;\\n    if (painel) window.__kickConta = (k) => { conta = k; if (last) draw(last); };\\n\\n    // próxima meta e progresso de um saldo\\n    const meta = (goals, pts) => goals.find((g) => pts < g.pts) || null;\\n\\n    function ring(pct, cls) {\\n      return `<div class=\\\"kx-ring ${cls || ''}\\\" style=\\\"--p:${Math.max(0, Math.min(100, pct))}\\\"><div class=\\\"kx-ring-in\\\"></div></div>`;\\n    }\\n\\n    function cardFarm(c, t, k, goals) {\\n      const farmando = !!k;\\n      k = k || {};\\n      const pts = t.pts;\\n      const m = pts == null ? goals[0] : meta(goals, pts);\\n      const pct = pts == null ? 0 : m ? (pts / m.pts) * 100 : 100;\\n      const falta = m && pts != null ? m.pts - pts : 0;\\n      const eta = m && k && k.porHora > 0 ? dur((falta / k.porHora) * 3600000) : null;\\n      const st = !farmando ? '<span class=\\\"kx-st live\\\"><i class=\\\"rec\\\"></i>AO VIVO</span>'\\n        : k.semRender ? '<span class=\\\"kx-st warn\\\">⚠ sem render</span>'\\n        : k.tocando == null ? '<span class=\\\"kx-st\\\">abrindo...</span>'\\n        : k.tocando ? '<span class=\\\"kx-st live\\\"><i class=\\\"rec\\\"></i>AO VIVO</span>' : '<span class=\\\"kx-st bad\\\">⏸ parado</span>';\\n      return `<div class=\\\"kx-card farm${!m ? ' done' : ''}${farmando ? '' : ' idle'}\\\">\\n        <div class=\\\"kx-ch\\\"><b>${esc(t.slug)}</b><span class=\\\"kx-chr\\\">${st}<button class=\\\"kx-x\\\" data-rm=\\\"kick|${esc(t.slug)}\\\" title=\\\"Remover ${esc(t.slug)} da lista (não é mais parceiro)\\\">×</button></span></div>\\n        <div class=\\\"kx-mid\\\">\\n          <div class=\\\"kx-ringbox\\\">${ring(pct, !m ? 'full' : '')}<div class=\\\"kx-ringtx\\\"><b>${pts == null ? '—' : fmt(pts)}</b><span>pontos</span></div></div>\\n          <div class=\\\"kx-info\\\">\\n            ${m ? `<div class=\\\"kx-next\\\">Próximo: <b>${esc(m.nome)}</b></div><div class=\\\"kx-falta\\\">faltam <b>${fmt(falta)}</b> pts${eta ? ` · ~${eta}` : ''}</div>`\\n              : `<div class=\\\"kx-next\\\"><b>Pode resgatar tudo!</b></div><div class=\\\"kx-falta\\\">1.000+ pontos</div>`}\\n            <div class=\\\"kx-meta\\\">${farmando\\n              ? `${k.porHora != null ? `<b>+${fmt(k.porHora)}</b>/h · ` : ''}farmando há ${dur(Date.now() - (k.aberta || Date.now()))}`\\n              : '<span class=\\\"kx-off\\\">não está farmando · ative para farmar</span>'}</div>\\n            <div class=\\\"kx-goals\\\">${goals.map((g) => `<span class=\\\"${pts != null && pts >= g.pts ? 'on' : ''}\\\">${fmt(g.pts)}</span>`).join('')}</div>\\n          </div>\\n        </div>\\n        <div class=\\\"kx-act\\\">\\n          ${pts != null && pts >= goals[0].pts\\n            ? `<button class=\\\"kx-btn go\\\" data-live=\\\"${c.i}|${esc(t.slug)}\\\" title=\\\"Abre a live com a sua conta para resgatar nos pontos do canal\\\">Resgatar</button>`\\n            : `<button class=\\\"kx-btn go\\\" disabled title=\\\"Disponível a partir de ${fmt(goals[0].pts)} pontos\\\">Resgatar</button>`}\\n          <button class=\\\"kx-btn${t.sel ? ' sel' : ''}\\\" data-sel=\\\"${c.i}|${esc(t.slug)}\\\" title=\\\"${t.sel ? 'Clique para desativar este canal' : 'Ativar este canal para farmar'}\\\">${t.sel ? '✓ Ativado' : 'Ativar'}</button>\\n        </div>\\n      </div>`;\\n    }\\n\\n    function cardOutro(c, t) {\\n      return `<button class=\\\"kx-mini${t.sel ? ' sel' : ''}${t.live ? ' live' : ''}\\\" data-sel=\\\"${c.i}|${esc(t.slug)}\\\" title=\\\"${t.live ? 'Ao vivo agora' : 'Offline'} · clique para ${t.sel ? 'desativar' : 'ativar e farmar quando entrar ao vivo'}\\\">\\n        <span class=\\\"dot\\\"></span><span class=\\\"nm\\\">${esc(t.slug)}</span><b>${t.pts != null ? fmt(t.pts) : '—'}</b>${t.sel ? '<i>✓</i>' : ''}<span class=\\\"kx-x\\\" data-rm=\\\"kick|${esc(t.slug)}\\\" title=\\\"Remover ${esc(t.slug)} da lista (não é mais parceiro)\\\">×</span></button>`;\\n    }\\n\\n    function draw(d) {\\n      if (!d) return;\\n      last = d;\\n      if (conta == null || !d.contas[conta]) conta = Math.max(0, d.contas.findIndex((x) => x.on));\\n      // abas das contas\\n      tabs.innerHTML = d.contas.map((c, n) => `<button class=\\\"kx-tab${n === conta ? ' cur' : ''}${c.on ? '' : ' off'}\\\" data-tab=\\\"${n}\\\">\\n        ${esc(c.name)}${c.on ? `<span class=\\\"kx-badge\\\">${c.canais.length}</span>` : ''}</button>`).join('') +\\n        '<span class=\\\"grow\\\"></span>' +\\n        `<label class=\\\"kx-sw kx-av\\\" title=\\\"Aviso quando um canal bater 300, 500 ou 1.000 pontos\\\"><span>🔔 Avisos</span><input type=\\\"checkbox\\\" class=\\\"sw\\\" id=\\\"kwAvisos\\\" ${d.avisos === false ? '' : 'checked'}></label>` +\\n        '<button class=\\\"kx-btn small\\\" id=\\\"kwDiag\\\" title=\\\"Salva um arquivo para análise\\\">Diagnóstico</button><button class=\\\"kx-btn small\\\" id=\\\"kwNow\\\">Atualizar</button>';\\n      const c = d.contas[conta];\\n      let h = '';\\n      if (!c.on) {\\n        h = `<div class=\\\"kx-empty big\\\"><b>Kick desligada em ${esc(c.name)}</b><span>As lives oficiais da Kick abrem sozinhas (mutadas) para juntar os pontos dos canais.</span>\\n          <div><button class=\\\"kx-btn go kx-on\\\" data-kon=\\\"${c.i}\\\">Ligar a Kick nesta conta</button></div></div>`;\\n      } else {\\n        const abertos = new Map(c.canais.map((k) => [k.slug, k]));\\n        // \\\"Ao vivo\\\": todos os canais ao vivo (farmando primeiro); \\\"Outros canais\\\": os offline\\n        const aoVivo = c.todos.filter((t) => t.live || abertos.has(t.slug))\\n          .sort((a, b2) => (abertos.has(b2.slug) - abertos.has(a.slug)) || ((b2.pts || 0) - (a.pts || 0)));\\n        const outros = c.todos.filter((t) => !t.live && !abertos.has(t.slug)).sort((a, b2) => (b2.pts || 0) - (a.pts || 0));\\n        h += `<div class=\\\"kx-sum\\\"><div><b>${c.sel.length ? `Farmando só os ${c.sel.length} ativados` : 'Farmando automático'}</b>\\n          <span>${c.sel.length ? 'Desative todos para voltar ao automático.' : 'Ative canais para escolher quais farmar.'}</span></div>\\n          <div class=\\\"kx-goalbar\\\">${d.goals.map((g) => `<div><b>${fmt(g.pts)}</b><span>${esc(g.nome)}</span></div>`).join('')}</div>\\n          <label class=\\\"kx-sw\\\" title=\\\"Desliga a Kick nesta conta (fecha as lives)\\\"><span>Kick ligada</span><input type=\\\"checkbox\\\" class=\\\"sw\\\" checked data-koff=\\\"${c.i}\\\"></label></div>`;\\n        const nFarm = aoVivo.filter((t) => abertos.has(t.slug)).length;\\n        h += `<h3 class=\\\"kx-h\\\">Ao vivo <small>${aoVivo.length} live${aoVivo.length === 1 ? '' : 's'} · ${nFarm} farmando</small></h3>`;\\n        h += aoVivo.length ? `<div class=\\\"kx-grid\\\">${aoVivo.map((t) => cardFarm(c, t, abertos.get(t.slug), d.goals)).join('')}</div>`\\n          : '<div class=\\\"kx-empty\\\">Nenhum canal oficial da Kick ao vivo agora. Os pontos só sobem com live aberta.</div>';\\n        if (outros.length) h += `<h3 class=\\\"kx-h\\\">Offline <small>clique para ativar: o PokeLink farma quando o canal entrar ao vivo</small></h3><div class=\\\"kx-minis\\\">${outros.map((t) => cardOutro(c, t)).join('')}</div>`;\\n      }\\n      if (d.removidos && d.removidos.length) h += `<h3 class=\\\"kx-h\\\">Removidos da lista <small>não são mais parceiros · clique para trazer de volta</small></h3><div class=\\\"kx-minis\\\">${d.removidos.map((r) => `<button class=\\\"kx-mini rmv\\\" data-back=\\\"kick|${esc(r.slug)}\\\" title=\\\"Trazer ${esc(r.slug)} de volta para a lista\\\"><span class=\\\"dot\\\"></span><span class=\\\"nm\\\">${esc(r.slug)}</span><b>${r.como === 'auto' ? 'automático' : 'você tirou'}</b></button>`).join('')}</div>`;\\n      h += `<div class=\\\"kx-foot\\\">A Kick dá 10 pontos a cada 5 minutos de live (≈120/h por canal; assinante 20). Resgatar abre a live com a sua conta: abra os pontos do canal embaixo do chat. Atualiza sozinho a cada ${d.poll}s e avisa ao bater ${d.goals.map((g) => fmt(g.pts)).join(', ')}.</div>`;\\n      body.innerHTML = h;\\n      tabs.querySelectorAll('[data-tab]').forEach((b2) => { b2.onclick = () => { conta = Number(b2.dataset.tab); draw(last); }; });\\n      root.querySelectorAll('[data-kon]').forEach((b2) => { b2.onclick = () => window.api.setLives(Number(b2.dataset.kon), 'kick', true); });\\n      root.querySelectorAll('[data-koff]').forEach((b2) => { b2.onchange = () => window.api.setLives(Number(b2.dataset.koff), 'kick', b2.checked); });\\n      root.querySelectorAll('[data-sel]').forEach((b2) => { const [ci, sl] = b2.dataset.sel.split('|'); b2.onclick = () => window.api.kickSel(Number(ci), sl); });\\n      root.querySelectorAll('[data-rm]').forEach((b2) => { const [pl, sl] = b2.dataset.rm.split('|'); b2.onclick = (ev) => { ev.stopPropagation(); window.api.canalRemover(pl, sl); }; });\\n      root.querySelectorAll('[data-back]').forEach((b2) => { const [pl, sl] = b2.dataset.back.split('|'); b2.onclick = () => window.api.canalVoltar(pl, sl); });\\n      root.querySelectorAll('[data-live]').forEach((b2) => { const [ci, sl] = b2.dataset.live.split('|'); b2.onclick = () => window.api.kickRedeemLive(Number(ci), sl); });\\n      document.getElementById('kwNow').onclick = async () => draw(await window.api.kickRefresh());\\n      document.getElementById('kwAvisos').onchange = (ev) => window.api.kickAvisos(ev.target.checked);\\n      document.getElementById('kwDiag').onclick = async () => {\\n        const f = await window.api.kickDiag();\\n        alert(f ? 'Diagnóstico salvo na Área de Trabalho: kick-diagnostico.json' : 'Nenhuma live da Kick aberta agora para gerar o diagnóstico.');\\n      };\\n    }\\n    const refresh = async () => draw(await window.api.kickGet().catch(() => last));\\n    window.api.onKickUpdate(() => { if (!root.hidden) refresh(); });\\n    setInterval(() => { if (last && !root.hidden) draw(last); }, 15000); // atualiza os tempos\\n    if (painel) window.__kickRefresh = refresh;\\n    refresh();\\n  }\\n\\n  /* ------------------------- análise de PvP ------------------------- */\\n  const TYPE_COLOR = { NORMAL: '#9a9a78', FIRE: '#e8742a', WATER: '#4a82e8', GRASS: '#4caa3c', ELECTRIC: '#d8b416', ICE: '#58c4c8', FIGHTING: '#b82e26',\\n    POISON: '#94389a', GROUND: '#c8a24c', FLYING: '#8c78e0', PSYCHIC: '#e8487c', BUG: '#8ca01c', ROCK: '#a8902e', GHOST: '#5e4a8c',\\n    DRAGON: '#5a2ef0', DARK: '#5a4638', STEEL: '#8c8ca8', FAIRY: '#e07aa8' };\\n  function initPvp() {\\n    document.body.classList.add('pvp');\\n    document.title = 'PvP — PokeLink';\\n    app.hidden = true;\\n    const root = document.getElementById('pvp');\\n    root.hidden = false;\\n    let conta = Number.isInteger(I) ? I : 0;\\n    let aba = 'resumo';\\n    let ultimo = null;\\n    const esc = (t) => String(t == null ? '' : t).replace(/[&<>\\\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;' }[c]));\\n    const types = (ts) => (ts || []).map((t) => `<span class=\\\"pv-type\\\" style=\\\"background:${TYPE_COLOR[t] || '#666'}\\\">${esc(t)}</span>`).join('');\\n    const bar = (p) => { const v = Math.max(0, Math.min(100, p)); return `<span class=\\\"pv-bar\\\"><span style=\\\"width:${v}%;background:hsl(${Math.round(v * 1.2)},65%,52%)\\\"></span></span>`; };\\n    const quando = (t) => { const m = Math.round((Date.now() - t) / 60000); return m < 1 ? 'agora' : m < 60 ? `há ${m} min` : m < 1440 ? `há ${Math.round(m / 60)} h` : `há ${Math.round(m / 1440)} d`; };\\n    const pct = (w, l) => Math.round((w / Math.max(1, w + l)) * 100);\\n    const rec = (w, l) => `<span class=\\\"pv-rec\\\"><b class=\\\"w\\\">${w}V</b> <b class=\\\"l\\\">${l}D</b></span>`;\\n    const ordem = (lst) => lst.map((n) => `<span class=\\\"pv-mon\\\">${esc(n)}</span>`).join('<span class=\\\"pv-arr\\\">→</span>');\\n\\n    root.innerHTML = `<div class=\\\"ch\\\">${iconHtml(null)}<b>PvP</b><span>análise dos duelos</span></div>\\n      <div class=\\\"tb\\\" id=\\\"pvTabs\\\"></div><div class=\\\"pv-nav\\\" id=\\\"pvNav\\\"></div><div class=\\\"cb\\\" id=\\\"pvBody\\\"><div class=\\\"pv-msg\\\">Carregando...</div></div>`;\\n    const tabs = document.getElementById('pvTabs');\\n    const nav = document.getElementById('pvNav');\\n    const body = document.getElementById('pvBody');\\n\\n    function drawTabs(contas) {\\n      tabs.innerHTML = '';\\n      (contas || ['Conta 1', 'Conta 2', 'Conta 3', 'Conta 4']).forEach((nm, k) => {\\n        const b = el('button', 'acc' + (k === conta ? ' cur' : ''));\\n        b.textContent = nm;\\n        b.onclick = () => { conta = k; load(false); };\\n        tabs.appendChild(b);\\n      });\\n      tabs.appendChild(el('span', 'grow'));\\n      tabs.appendChild(el('button', 'btn', 'Atualizar agora', 'Lê o tracker de novo', () => load(true)));\\n    }\\n    function drawNav() {\\n      const A = [['resumo', 'Resumo'], ['adv', 'Adversários'], ['time', 'Seu time'], ['counters', 'Counters']];\\n      nav.innerHTML = A.map(([k, n]) => `<button class=\\\"pv-tab${aba === k ? ' cur' : ''}\\\" data-aba=\\\"${k}\\\">${n}</button>`).join('');\\n      nav.querySelectorAll('[data-aba]').forEach((b) => { b.onclick = () => { aba = b.dataset.aba; drawNav(); draw(); }; });\\n    }\\n\\n    // ---------- conteúdo de cada aba ----------\\n    function blocoRivais(lst, limite) {\\n      if (!lst.length) return '<div class=\\\"pv-none\\\">Nenhum adversário te vence com frequência (mín. 3 duelos e menos de 40% de vitórias).</div>';\\n      return lst.slice(0, limite).map((r) => `<div class=\\\"pv-row\\\">\\n        <div class=\\\"pv-row-a\\\"><b>${esc(r.nome)}</b>${rec(r.w, r.l)}</div>\\n        <div class=\\\"pv-row-b\\\">${bar(pct(r.w, r.l))}<span>${pct(r.w, r.l)}%</span></div>\\n        ${r.top ? `<div class=\\\"pv-row-c\\\">Maior problema: <b>${esc(r.top)}</b> · ${esc(r.topDano)} de dano por derrota</div>` : ''}\\n      </div>`).join('');\\n    }\\n    function blocoOrdem(lst, limite) {\\n      if (!lst.length) return '<div class=\\\"pv-none\\\">Aparece quando houver pelo menos 2 duelos registrados com os times contra o mesmo adversário.</div>';\\n      return lst.slice(0, limite).map((o) => `<div class=\\\"pv-row\\\">\\n        <div class=\\\"pv-row-a\\\"><b>${esc(o.opp)}</b>${rec(o.w, o.l)}</div>\\n        <div class=\\\"pv-row-c\\\">Começar com <b>${esc(o.lead)}</b></div>\\n        <div class=\\\"pv-ordem\\\">${ordem(o.ordem)}</div>\\n      </div>`).join('');\\n    }\\n    function blocoTime(d, limite) {\\n      const forte = d.sug.find((x) => x.tipo === 'forte');\\n      const fracos = d.sug.filter((x) => x.tipo === 'fraco' && !/ cai em /.test(x.texto));\\n      let h = '';\\n      if (forte) h += `<div class=\\\"pv-hl good\\\"><i>★</i><span>${esc(forte.texto)}</span></div>`;\\n      for (const c of d.caem.slice(0, limite)) h += `<div class=\\\"pv-hl bad\\\"><i>▼</i><span><b>${esc(c.nome)}</b> cai em ${c.pct}% das partidas, com ${esc(c.dano)} de dano em média. Teste outra posição ou troque.</span></div>`;\\n      for (const f of fracos.slice(0, limite)) h += `<div class=\\\"pv-hl warn\\\"><i>!</i><span>${esc(f.texto)}</span></div>`;\\n      return h || '<div class=\\\"pv-none\\\">Sem dados suficientes.</div>';\\n    }\\n    function blocoCounters(lst, limite) {\\n      if (!lst.length) return '<div class=\\\"pv-none\\\">Sem dados.</div>';\\n      return lst.slice(0, limite).map((c) => `<div class=\\\"pv-row\\\">\\n        <div class=\\\"pv-row-a\\\"><b>${esc(c.name)}</b> ${types(c.types)}<span class=\\\"pv-wr l\\\">você vence ${c.wr}%</span></div>\\n        <div class=\\\"pv-row-c\\\">${c.bons.length ? 'Use: ' + c.bons.map((n) => `<span class=\\\"pv-chip ok\\\">${esc(n)}</span>`).join('') : 'Nenhum do seu time tem vantagem clara de tipo.'}</div>\\n        ${c.ruins.length ? `<div class=\\\"pv-row-c\\\">Evite na frente: ${c.ruins.map((n) => `<span class=\\\"pv-chip no\\\">${esc(n)}</span>`).join('')}</div>` : ''}\\n      </div>`).join('');\\n    }\\n    const card = (titulo, sub, cls, html, ir) => `<div class=\\\"pv-pn ${cls}\\\"><h2>${titulo}<small>${sub || ''}</small>${ir ? `<button class=\\\"pv-more\\\" data-ir=\\\"${ir}\\\">ver tudo →</button>` : ''}</h2><div class=\\\"pv-pb\\\">${html}</div></div>`;\\n\\n    function draw() {\\n      const d = ultimo;\\n      if (!d) return;\\n      const s = d.summary || {};\\n      const tot = (s.wins || 0) + (s.losses || 0);\\n      let h = `<div class=\\\"pv-cards\\\">\\n        <div class=\\\"pv-card\\\"><small>PR</small><b>${esc((s.pr || 0).toLocaleString('pt-BR'))}</b></div>\\n        <div class=\\\"pv-card\\\"><small>Ranking</small><b>${s.rank ? esc(s.rank) + 'º' : '—'}</b></div>\\n        <div class=\\\"pv-card\\\"><small>Temporada</small><b><span class=\\\"w\\\">${esc(s.wins || 0)}V</span> <span class=\\\"l\\\">${esc(s.losses || 0)}D</span></b></div>\\n        <div class=\\\"pv-card\\\"><small>Vitórias</small><b>${tot ? Math.round((s.wins / tot) * 100) : 0}%</b></div>\\n        <div class=\\\"pv-card\\\"><small>Últimas 20</small><b><span class=\\\"w\\\">${d.recentW}V</span> <span class=\\\"l\\\">${d.recentL}D</span></b></div>\\n      </div>`;\\n      if (aba === 'resumo') {\\n        h += '<div class=\\\"pv-grid\\\">';\\n        h += card('⚔ Rivais difíceis', 'quem mais te vence', 'rival', blocoRivais(d.rivais, 3), 'adv');\\n        h += card('⇅ Ordem que funciona', 'por adversário', 'ordem', blocoOrdem(d.leads, 3), 'adv');\\n        h += card('★ Seu time', 'quem rende e quem não rende', 'time', blocoTime(d, 2), 'time');\\n        h += card('🛡 Counters', 'pokémon que mais te vencem', 'counter', blocoCounters(d.counters, 2), 'counters');\\n        h += '</div>';\\n      } else if (aba === 'adv') {\\n        const lead = new Map(d.leads.map((o) => [o.opp, o]));\\n        h += '<div class=\\\"pv-grid\\\">';\\n        h += card('⚔ Rivais difíceis', `${d.rivais.length}`, 'rival', blocoRivais(d.rivais, 8));\\n        h += card('⇅ Ordem que funciona', `${d.leads.length}`, 'ordem', blocoOrdem(d.leads, 12));\\n        h += '</div>';\\n        h += `<div class=\\\"pv-pn\\\"><h2>Todos os adversários<small>${d.total} partidas registradas</small></h2><div class=\\\"pv-scroll\\\"><table class=\\\"pv-tab\\\">\\n          <thead><tr><th>Adversário</th><th>V</th><th>D</th><th>Vitórias</th><th>PR</th><th>Última</th><th>Começar com</th></tr></thead><tbody>` +\\n          d.opps.map((o) => { const p = pct(o.w, o.l); const ld = lead.get(o.name);\\n            return `<tr><td class=\\\"n\\\">${esc(o.name)}</td><td class=\\\"w\\\">${o.w}</td><td class=\\\"l\\\">${o.l}</td><td>${bar(p)}${p}%</td><td>${esc((o.pr || 0).toLocaleString('pt-BR'))}</td><td class=\\\"${o.lastWin ? 'w' : 'l'}\\\">${o.lastWin ? 'V' : 'D'} · ${quando(o.last)}</td><td>${ld ? esc(ld.lead) : '—'}</td></tr>`; }).join('') +\\n          '</tbody></table></div></div>';\\n      } else if (aba === 'time') {\\n        h += card('★ Destaques', '', 'time', blocoTime(d, 6));\\n        h += `<div class=\\\"pv-pn\\\"><h2>Seus pokémon<small>temporada</small></h2><div class=\\\"pv-scroll\\\"><table class=\\\"pv-tab\\\">\\n          <thead><tr><th>Pokémon</th><th>Partidas</th><th>Vitórias</th><th>Dano/partida</th><th>Abates/partida</th></tr></thead><tbody>` +\\n          d.mons.map((m) => `<tr><td class=\\\"n\\\">${esc(m.name)}<br>${types(m.types)}</td><td>${esc(m.games.toLocaleString('pt-BR'))}</td><td>${bar(m.wr)}${m.wr}%</td><td>${esc(m.dmgPer)}</td><td>${esc(m.killsPer)}</td></tr>`).join('') +\\n          '</tbody></table></div></div>';\\n      } else {\\n        h += '<div class=\\\"pv-grid\\\">';\\n        h += card('🛡 Maiores counters', 'pokémon que mais te vencem', 'counter', blocoCounters(d.counters, 8));\\n        h += card('🎯 Presas favoritas', 'pokémon que você mais vence', 'presa', (d.presas || []).map((c) =>\\n          `<div class=\\\"pv-row\\\"><div class=\\\"pv-row-a\\\"><b>${esc(c.name)}</b> ${types(c.types)}<span class=\\\"pv-wr w\\\">você vence ${c.wr}%</span></div><div class=\\\"pv-row-c\\\">${c.games} partidas</div></div>`).join('') || '<div class=\\\"pv-none\\\">Sem dados.</div>');\\n        h += '</div>';\\n      }\\n      h += `<div class=\\\"pv-foot\\\">Dados do tracker do jogo (PvP ranqueado), atualizados ${quando(d.updated)}. O PokeLink guarda cada partida nova a cada 15 minutos para montar o histórico por adversário.</div>`;\\n      body.innerHTML = h;\\n      body.querySelectorAll('[data-ir]').forEach((b) => { b.onclick = () => { aba = b.dataset.ir; drawNav(); draw(); body.scrollTop = 0; }; });\\n    }\\n\\n    async function load(force) {\\n      drawTabs(window.__pvContas);\\n      drawNav();\\n      body.innerHTML = `<div class=\\\"pv-msg\\\">${force ? 'Lendo o tracker...' : 'Carregando...'} (pode levar uns 20 segundos)</div>`;\\n      const d = await window.api.pvpGet(conta, force).catch(() => null);\\n      if (d && d.contas) { window.__pvContas = d.contas; drawTabs(d.contas); }\\n      if (!d || d.erro) { body.innerHTML = `<div class=\\\"pv-msg\\\">${esc((d && d.erro) || 'Não consegui carregar.')}</div>`; return; }\\n      d.rivais = d.rivais || []; d.leads = d.leads || []; d.caem = d.caem || [];\\n      ultimo = d;\\n      draw();\\n    }\\n    if (window.api.onPvpAccount) window.api.onPvpAccount((k) => { conta = k; load(false); });\\n    load(false);\\n  }\\n\\n  /* ------------------------ barra de título ------------------------ */\\n  // ícone do PokeLink: esfera com um elo de corrente (o \\\"Link\\\" do nome)\\n  const POKEBALL = '<svg viewBox=\\\"0 0 36 36\\\"><defs><linearGradient id=\\\"pkTop\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"0\\\" y2=\\\"1\\\"><stop offset=\\\"0\\\" stop-color=\\\"#d58cf0\\\"/><stop offset=\\\"1\\\" stop-color=\\\"#6a2c8c\\\"/></linearGradient></defs><circle cx=\\\"18\\\" cy=\\\"18\\\" r=\\\"15.5\\\" fill=\\\"#ffdef0\\\" stroke=\\\"#2a0a12\\\" stroke-width=\\\"2.6\\\"/><path d=\\\"M2.5 18a15.5 15.5 0 0 1 31 0z\\\" fill=\\\"url(#pkTop)\\\"/><path d=\\\"M2.5 18H33.5\\\" stroke=\\\"#2a0a12\\\" stroke-width=\\\"2.6\\\"/><circle cx=\\\"18\\\" cy=\\\"18\\\" r=\\\"15.5\\\" fill=\\\"none\\\" stroke=\\\"#2a0a12\\\" stroke-width=\\\"2.6\\\"/><ellipse cx=\\\"11.5\\\" cy=\\\"9.5\\\" rx=\\\"4\\\" ry=\\\"2.2\\\" fill=\\\"#fff\\\" opacity=\\\".35\\\" transform=\\\"rotate(-30 11.5 9.5)\\\"/><g fill=\\\"none\\\" stroke-linecap=\\\"round\\\"><rect x=\\\"8.4\\\" y=\\\"14.2\\\" width=\\\"11\\\" height=\\\"7.6\\\" rx=\\\"3.8\\\" stroke=\\\"#2a0a12\\\" stroke-width=\\\"5\\\"/><rect x=\\\"16.6\\\" y=\\\"14.2\\\" width=\\\"11\\\" height=\\\"7.6\\\" rx=\\\"3.8\\\" stroke=\\\"#2a0a12\\\" stroke-width=\\\"5\\\"/><rect x=\\\"8.4\\\" y=\\\"14.2\\\" width=\\\"11\\\" height=\\\"7.6\\\" rx=\\\"3.8\\\" stroke=\\\"#f7d85a\\\" stroke-width=\\\"2.2\\\"/><rect x=\\\"16.6\\\" y=\\\"14.2\\\" width=\\\"11\\\" height=\\\"7.6\\\" rx=\\\"3.8\\\" stroke=\\\"#f7d85a\\\" stroke-width=\\\"2.2\\\"/><path d=\\\"M15.6 14.2a3.8 3.8 0 0 1 3.8 3.8\\\" stroke=\\\"#2a0a12\\\" stroke-width=\\\"5\\\"/><path d=\\\"M15.6 14.2a3.8 3.8 0 0 1 3.8 3.8\\\" stroke=\\\"#f7d85a\\\" stroke-width=\\\"2.2\\\"/></g></svg>';\\n\\n  // usa a imagem escolhida pelo usuário, se existir; senão o ícone padrão\\n  function iconHtml(url) {\\n    if (!url) return POKEBALL;\\n    const img = document.createElement('img');\\n    img.className = 'appico';\\n    img.alt = '';\\n    img.src = url;\\n    return img.outerHTML;\\n  }\\n\\n  // ícones dos menus da barra de cima\\n  const MENU_ICO = {\\n    'Telas': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\"><rect x=\\\"1.5\\\" y=\\\"1.5\\\" width=\\\"5.5\\\" height=\\\"5.5\\\" rx=\\\"1.2\\\"/><rect x=\\\"9\\\" y=\\\"1.5\\\" width=\\\"5.5\\\" height=\\\"5.5\\\" rx=\\\"1.2\\\"/><rect x=\\\"1.5\\\" y=\\\"9\\\" width=\\\"5.5\\\" height=\\\"5.5\\\" rx=\\\"1.2\\\"/><rect x=\\\"9\\\" y=\\\"9\\\" width=\\\"5.5\\\" height=\\\"5.5\\\" rx=\\\"1.2\\\"/></svg>',\\n    'Desempenho': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"><path d=\\\"M2.5 12a5.5 5.5 0 1 1 11 0\\\"/><path d=\\\"M8 12l3-4\\\"/><circle cx=\\\"8\\\" cy=\\\"12\\\" r=\\\".8\\\" fill=\\\"currentColor\\\"/></svg>',\\n    'Contas': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"><circle cx=\\\"6\\\" cy=\\\"5\\\" r=\\\"2.6\\\"/><path d=\\\"M1.5 14c0-2.6 2-4.3 4.5-4.3s4.5 1.7 4.5 4.3\\\"/><path d=\\\"M10.5 2.6a2.5 2.5 0 0 1 0 4.8M12 9.9c1.6.5 2.6 1.9 2.6 4.1\\\"/></svg>',\\n    'Auto Compra': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"M1.5 2h2l1.6 8h7.4l1.5-5.5H4.3\\\"/><circle cx=\\\"6.2\\\" cy=\\\"13.2\\\" r=\\\"1.1\\\"/><circle cx=\\\"11.6\\\" cy=\\\"13.2\\\" r=\\\"1.1\\\"/></svg>',\\n    'Lives': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linejoin=\\\"round\\\"><rect x=\\\"1.5\\\" y=\\\"3.5\\\" width=\\\"13\\\" height=\\\"9.5\\\" rx=\\\"2\\\"/><path d=\\\"M6.6 6.2v4.2l3.6-2.1z\\\" fill=\\\"currentColor\\\"/></svg>',\\n    'PvP': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"><path d=\\\"M2 2l7.5 7.5M14 2L6.5 9.5M4 12l-2 2M12 12l2 2M3.2 10.8l2 2M12.8 10.8l-2 2\\\"/></svg>',\\n    'Atualizações': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"M8 2v8M4.8 7L8 10.2 11.2 7M2.5 12.5v1h11v-1\\\"/></svg>',\\n    'Ajuda': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"6.3\\\"/><path d=\\\"M6.2 6.2a1.9 1.9 0 0 1 3.6.6c0 1.3-1.8 1.6-1.8 2.8\\\"/><circle cx=\\\"8\\\" cy=\\\"11.6\\\" r=\\\".4\\\" fill=\\\"currentColor\\\"/></svg>',\\n    'Desenvolvedor': '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"M5.5 4L1.8 8l3.7 4M10.5 4l3.7 4-3.7 4\\\"/></svg>',\\n  };\\n\\n  function initTitle() {\\n    document.body.classList.add('title');\\n    app.hidden = true;\\n    const tb = document.getElementById('tb');\\n    tb.hidden = false;\\n\\n    let MENUS = [];\\n    let openIdx = -1;     // menu de cima aberto (-1 = nenhum)\\n    let panels = [];      // painéis abertos: [0] = principal, [1] = submenu, ...\\n\\n    const closePanels = (fromDepth) => {\\n      panels.splice(fromDepth).forEach((p) => p.remove());\\n      const keep = panels[fromDepth - 1];\\n      if (keep) keep.querySelectorAll('.sub-open').forEach((x) => x.classList.remove('sub-open'));\\n    };\\n    const closeAll = () => {\\n      if (openIdx === -1) return;\\n      openIdx = -1;\\n      closePanels(0);\\n      const sh = document.getElementById('shade');\\n      if (sh) sh.remove();\\n      tb.querySelectorAll('.mbtn.open').forEach((b) => b.classList.remove('open'));\\n      window.api.titleOpen(false);\\n    };\\n\\n    // desenha um painel com os itens; \\\"path\\\" = índices até este nível\\n    function showPanel(items, path, x, y, depth, alignRightOf) {\\n      closePanels(depth);\\n      const p = el('div', 'dd');\\n      items.forEach((it, n) => {\\n        if (!it.visible) return;\\n        if (it.type === 'separator') { p.appendChild(el('div', 'hr')); return; }\\n        const b = el('button', 'it');\\n        if (!it.enabled) b.disabled = true;\\n        b.innerHTML = '<span class=\\\"ck\\\"></span><span class=\\\"lb\\\"></span><span class=\\\"ac\\\"></span><span class=\\\"ar\\\"></span>';\\n        b.querySelector('.lb').textContent = it.label;\\n        if ((it.type === 'checkbox' || it.type === 'radio') && it.checked) b.querySelector('.ck').textContent = it.type === 'radio' ? '●' : '✓';\\n        b.querySelector('.ac').textContent = it.accel || '';\\n        if (it.submenu) {\\n          b.querySelector('.ar').textContent = '▶';\\n          const openSub = () => {\\n            if (b.classList.contains('sub-open')) return;\\n            closePanels(depth + 1);\\n            b.classList.add('sub-open');\\n            const r = b.getBoundingClientRect();\\n            showPanel(it.submenu, path.concat(n), r.right + 4, r.top - 6, depth + 1, r.left - 4);\\n          };\\n          b.onmouseenter = openSub;\\n          b.onclick = openSub;\\n        } else {\\n          b.onmouseenter = () => closePanels(depth + 1);\\n          b.onclick = () => { closeAll(); window.api.titleClick(path.concat(n)); };\\n        }\\n        p.appendChild(b);\\n      });\\n      document.body.appendChild(p);\\n      p._want = { x, y, alignRightOf };\\n      fit(p);\\n      panels[depth] = p;\\n      return p;\\n    }\\n\\n    // não deixa o painel sair da janela (refeito quando a barra termina de crescer)\\n    function fit(p) {\\n      let { x, y, alignRightOf } = p._want;\\n      const r = p.getBoundingClientRect();\\n      if (x + r.width > innerWidth - 4) x = alignRightOf != null ? alignRightOf - r.width : innerWidth - r.width - 4;\\n      if (innerHeight > 100 && y + r.height > innerHeight - 4) y = Math.max(38, innerHeight - r.height - 4);\\n      p.style.left = Math.max(4, x) + 'px';\\n      p.style.top = y + 'px';\\n    }\\n    window.addEventListener('resize', () => panels.forEach(fit));\\n\\n    function openTop(idx, btn) {\\n      if (openIdx === idx) return;\\n      const first = openIdx === -1;\\n      tb.querySelectorAll('.mbtn.open').forEach((b) => b.classList.remove('open'));\\n      openIdx = idx;\\n      btn.classList.add('open');\\n      if (first) {\\n        const sh = el('div', null, null, null, closeAll);\\n        sh.id = 'shade';\\n        document.body.appendChild(sh);\\n        window.api.titleOpen(true); // a barra cresce (transparente) para caber o menu\\n      }\\n      const r = btn.getBoundingClientRect();\\n      showPanel(MENUS[idx].submenu || [], [idx], r.left, r.bottom + 3, 0, null);\\n    }\\n\\n    // ---------- pop-ups ----------\\n    const dlgQueue = [];\\n    let dlgCur = null;\\n    function showDialog(d) {\\n      dlgQueue.push(d);\\n      if (!dlgCur) nextDialog();\\n    }\\n    function nextDialog() {\\n      const old = document.getElementById('dlgShade');\\n      if (old) old.remove();\\n      dlgCur = dlgQueue.shift() || null;\\n      if (!dlgCur) return;\\n      closeAll(); // fecha menus abertos\\n      const d = dlgCur;\\n      const ICON = { info: 'i', warning: '!', error: '✕', question: '?' };\\n      const shade = el('div');\\n      shade.id = 'dlgShade';\\n      const box = el('div', 'dlg' + (d.about ? ' is-about' : ''));\\n      box.setAttribute('role', 'dialog');\\n      box.setAttribute('aria-modal', 'true');\\n      box.innerHTML = '<div class=\\\"hd\\\"><span class=\\\"t\\\"></span><button class=\\\"x\\\" title=\\\"Fechar\\\">×</button></div>' +\\n        (d.about ? '<div class=\\\"about\\\">' + iconHtml(d.about.icon) + '<span class=\\\"nm\\\"></span><span class=\\\"ver\\\"></span></div>' : '') +\\n        '<div class=\\\"bd\\\">' + (d.about ? '' : '<span class=\\\"ico\\\"></span>') +\\n        '<div><p class=\\\"msg\\\"></p><p class=\\\"det\\\"></p><div class=\\\"note\\\"><span class=\\\"ni\\\">!</span><span class=\\\"nt\\\"></span></div><p class=\\\"foot\\\"></p></div></div>' +\\n        '<div class=\\\"ft\\\"></div>';\\n      box.querySelector('.t').textContent = d.title;\\n      if (d.about) {\\n        box.querySelector('.nm').textContent = d.about.name;\\n        box.querySelector('.ver').textContent = d.about.channel ? `${d.about.channel} ${d.about.version}` : `v${d.about.version}`;\\n      } else {\\n        const ic = box.querySelector('.ico');\\n        ic.classList.add(d.type);\\n        ic.textContent = ICON[d.type] || 'i';\\n      }\\n      box.querySelector('.msg').textContent = d.message;\\n      box.querySelector('.det').textContent = d.detail;\\n      if ((d.detail || '').length > 900) { box.querySelector('.det').classList.add('long'); box.classList.add('wide'); } // texto longo (ex.: termos): rola dentro de uma caixa\\n      if (d.form && d.form.length) {\\n        const fm = el('div', 'dform');\\n        let grid = null;\\n        d.form.forEach((f) => {\\n          if (f.section) {\\n            fm.appendChild(el('div', 'fsec')).textContent = f.section;\\n            grid = fm.appendChild(el('div', 'fgrid'));\\n            return;\\n          }\\n          if (!grid) grid = fm.appendChild(el('div', 'fgrid'));\\n          const row = el('label', 'frow' + (f.type === 'check' ? ' fchk' : ''));\\n          const txt = el('span', 'ftx');\\n          txt.appendChild(el('b')).textContent = f.label;\\n          if (f.hint) txt.appendChild(el('small')).textContent = f.hint;\\n          let ctl;\\n          if (f.type === 'check') {\\n            ctl = document.createElement('input'); ctl.type = 'checkbox'; ctl.className = 'sw'; ctl.checked = !!f.value;\\n            row.append(ctl, txt);\\n          } else if (f.type === 'textarea') {\\n            row.classList.add('fta');\\n            ctl = document.createElement('textarea'); ctl.value = f.value || ''; ctl.rows = 6; ctl.spellcheck = false;\\n            row.append(txt, ctl);\\n          } else if (f.type === 'select') {\\n            ctl = document.createElement('select');\\n            (f.options || []).forEach((o) => { const op = document.createElement('option'); op.textContent = o; op.value = o; ctl.appendChild(op); });\\n            ctl.value = f.value;\\n            row.append(txt, ctl);\\n          } else {\\n            ctl = document.createElement('input'); ctl.inputMode = 'decimal'; ctl.value = f.value == null ? '' : String(f.value).replace('.', ',');\\n            row.append(txt, ctl);\\n          }\\n          ctl.dataset.id = f.id;\\n          grid.appendChild(row);\\n        });\\n        box.querySelector('.det').after(fm);\\n        box.classList.add('wide');\\n      }\\n      if (d.lives) {\\n        const L = d.lives;\\n        const wrap = el('div', 'lv');\\n        const grid = wrap.appendChild(el('div', 'lv-grid'));\\n        L.contas.forEach((c) => {\\n          const card = grid.appendChild(el('div', 'lv-acc'));\\n          card.appendChild(el('b', 'lv-nm')).textContent = c.name;\\n          c.plats.forEach((pl) => {\\n            const row = card.appendChild(el('div', 'lv-row ' + pl.p));\\n            const head = row.appendChild(el('div', 'lv-h'));\\n            head.appendChild(el('span', 'lv-pf')).textContent = pl.name;\\n            head.appendChild(el('span', 'lv-st ' + (pl.on ? 'on' : 'off'))).textContent = pl.on ? (pl.open.length + (pl.open.length === 1 ? ' live' : ' lives')) : 'desligada';\\n            if (pl.on) {\\n              const chips = row.appendChild(el('div', 'lv-chips'));\\n              if (!pl.open.length) chips.appendChild(el('span', 'lv-none')).textContent = 'nenhum canal ao vivo agora';\\n              pl.open.forEach((ch) => {\\n                const b = chips.appendChild(el('button', 'lv-chip', null, 'Abrir esta live com a conta ' + c.name));\\n                b.textContent = ch;\\n                b.onclick = () => window.api.openLivePage(c.i, pl.p, ch);\\n              });\\n            }\\n          });\\n        });\\n        const ao = wrap.appendChild(el('div', 'lv-now'));\\n        ao.appendChild(el('b')).textContent = 'Ao vivo agora';\\n        L.aoVivo.forEach((pl) => {\\n          const r = ao.appendChild(el('div', 'lv-row ' + pl.p));\\n          r.appendChild(el('span', 'lv-pf')).textContent = pl.name;\\n          const chips = r.appendChild(el('div', 'lv-chips'));\\n          if (!pl.list.length) chips.appendChild(el('span', 'lv-none')).textContent = 'nenhum';\\n          pl.list.forEach((ch) => { chips.appendChild(el('span', 'lv-tag')).textContent = ch; });\\n        });\\n        wrap.appendChild(el('div', 'lv-foot')).textContent = L.quando\\n          ? `Última verificação: ${L.quando}` + (L.erros ? ` · ${L.erros} canal(is) não responderam` : '')\\n          : 'Ainda não verificado.';\\n        box.querySelector('.det').after(wrap);\\n        box.classList.add('wide');\\n      } else if (d.cards && d.cards.length) {\\n        const grid = el('div', 'rcards');\\n        d.cards.forEach((c, n) => {\\n          const card = el('div', 'rc r' + (n + 1));\\n          const top = el('div', 'rc-top');\\n          top.appendChild(el('span', 'rc-medal')).textContent = String(n + 1);\\n          top.appendChild(el('b', 'rc-title')).textContent = c.title;\\n          card.appendChild(top);\\n          const chips = el('div', 'rc-chips');\\n          (c.chips || []).forEach((t) => { chips.appendChild(el('span', 'rc-chip')).textContent = t; });\\n          card.appendChild(chips);\\n          const big = el('div', 'rc-big');\\n          big.appendChild(el('b')).textContent = c.big || '—';\\n          big.appendChild(el('span')).textContent = ' XP/h';\\n          card.appendChild(big);\\n          if (c.bigSub) card.appendChild(el('div', 'rc-sub')).textContent = c.bigSub;\\n          const st = el('div', 'rc-stats');\\n          (c.stats || []).forEach(([k, v]) => {\\n            const row = el('div', 'rc-stat');\\n            row.appendChild(el('span')).textContent = k;\\n            row.appendChild(el('b')).textContent = v;\\n            st.appendChild(row);\\n          });\\n          card.appendChild(st);\\n          grid.appendChild(card);\\n        });\\n        box.querySelector('.det').after(grid);\\n        box.classList.add('wide');\\n      } else if (d.table && d.table.rows && d.table.rows.length) {\\n        const wrap = el('div', 'dtab');\\n        const tb = document.createElement('table');\\n        const thead = tb.createTHead().insertRow();\\n        ['#', ...d.table.head].forEach((h) => { const th = document.createElement('th'); th.textContent = h; thead.appendChild(th); });\\n        const body = tb.createTBody();\\n        d.table.rows.forEach((r, n) => {\\n          const tr = body.insertRow();\\n          [String(n + 1), ...r].forEach((c) => { tr.insertCell().textContent = c; });\\n        });\\n        wrap.appendChild(tb);\\n        box.querySelector('.det').after(wrap);\\n        box.classList.add('wide');\\n      }\\n      box.querySelector('.nt').textContent = d.note || '';\\n      box.querySelector('.foot').textContent = d.foot || '';\\n      if (!d.note) box.querySelector('.note').remove();\\n      if (!d.foot) box.querySelector('.foot').remove();\\n      if (!d.message) box.querySelector('.msg').remove();\\n      if (!d.detail) box.querySelector('.det').remove();\\n      const ft = box.querySelector('.ft');\\n      let focusBtn = null;\\n      d.buttons.forEach((label, n) => {\\n        const b = el('button', 'btn' + (n === d.defaultId ? ' go' : ''), null, null, () => answer(n));\\n        b.textContent = label;\\n        ft.appendChild(b);\\n        if (n === d.defaultId) focusBtn = b;\\n      });\\n      box.querySelector('.x').onclick = () => answer(cancelOf(d));\\n      shade.appendChild(box);\\n      document.body.appendChild(shade);\\n      (focusBtn || ft.querySelector('button')).focus();\\n    }\\n    // Esc / X = botão de cancelar (ou o último, como no Windows)\\n    const cancelOf = (d) => (d.cancelId != null ? d.cancelId : d.buttons.length > 1 ? d.buttons.length - 1 : 0);\\n    function answer(n) {\\n      if (!dlgCur) return;\\n      let values = null;\\n      const fm = document.querySelector('#dlgShade .dform');\\n      if (fm) {\\n        values = {};\\n        fm.querySelectorAll('[data-id]').forEach((c) => { values[c.dataset.id] = c.type === 'checkbox' ? c.checked : c.value; });\\n      }\\n      window.api.dialogReply(dlgCur.id, n, values);\\n      nextDialog();\\n    }\\n    window.api.onDialog(showDialog);\\n\\n    // ---------- Extensões: ligar/desligar, atualizar, reinstalar ----------\\n    let extsAberto = null;\\n    function fecharExts() {\\n      if (!extsAberto) return;\\n      const id = extsAberto;\\n      extsAberto = null;\\n      const p = document.getElementById('extsPanel'); if (p) p.remove();\\n      const sh = document.getElementById('extsShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    function drawExts(lst) {\\n      const p = document.getElementById('extsPanel');\\n      if (!p || !lst) return;\\n      p.querySelector('.lp-body').innerHTML = lst.map((e) => {\\n        const st = e.busy ? `<span class=\\\"ex-st busy\\\">${escL(e.busy)}...</span>`\\n          : !e.on ? '<span class=\\\"ex-st off\\\">desativada</span>'\\n          : e.error ? '<span class=\\\"ex-st err\\\">com erro</span>'\\n          : e.version ? '<span class=\\\"ex-st ok\\\">ativa</span>' : '<span class=\\\"ex-st off\\\">não instalada</span>';\\n        return `<div class=\\\"ex-card${e.on ? '' : ' off'}\\\">\\n          <div class=\\\"ex-h\\\"><span class=\\\"ex-ico\\\">${SVG.puzzle}</span>\\n            <div class=\\\"ex-t\\\"><b>${escL(e.nome)}</b><span>${e.version ? 'versão ' + escL(e.version) : 'sem versão instalada'}${e.autor ? ' · por ' + escL(e.autor) : ''}</span></div>\\n            ${st}<input type=\\\"checkbox\\\" class=\\\"sw\\\" ${e.on ? 'checked' : ''} ${e.busy ? 'disabled' : ''} data-ex=\\\"${escL(e.id)}\\\" title=\\\"${e.on ? 'Desativar' : 'Ativar'} nas 4 contas\\\"></div>\\n          <div class=\\\"ex-d\\\">${escL(e.sobre || '')}</div>\\n          ${e.error ? `<div class=\\\"ex-err\\\">Último erro: ${escL(e.error)}</div>` : ''}\\n          ${e.on && e.contas ? `<div class=\\\"ex-d\\\" style=\\\"display:flex;flex-wrap:wrap;gap:6px;align-items:center\\\">Nas contas:\\n            ${e.contas.map((c, i) => `<span class=\\\"kx-mini${c.ok ? '' : ' rmv'}\\\" style=\\\"height:26px;cursor:default\\\" title=\\\"${c.ok ? 'carregada' : 'NÃO carregada' + (c.erro ? ': ' + escL(c.erro) : '')}\\\"><span class=\\\"dot\\\" style=\\\"background:${c.ok ? '#7fe08a' : '#ff5d6c'}\\\"></span><span class=\\\"nm\\\">${escL(c.nome)}</span></span>`).join('')}</div>\\n          <div class=\\\"ex-d\\\" style=\\\"display:flex;flex-wrap:wrap;gap:6px;align-items:center\\\">Não funciona numa conta? Reparar só nela:\\n            ${e.contas.map((c, i) => `<button class=\\\"kx-btn small\\\" data-exa=\\\"${escL(e.id)}|reparar:${i}\\\" ${e.busy ? 'disabled' : ''} title=\\\"Tira e coloca de novo a extensão só nesta conta e apaga as configurações dela ali (o login do jogo continua)\\\">${i + 1}</button>`).join('')}</div>` : ''}\\n          <div class=\\\"ex-a\\\">\\n            <button class=\\\"kx-btn small\\\" data-exa=\\\"${escL(e.id)}|update\\\" ${e.busy ? 'disabled' : ''} title=\\\"Baixa a versão mais nova da Chrome Web Store\\\">Atualizar</button>\\n            <button class=\\\"kx-btn small\\\" data-exa=\\\"${escL(e.id)}|reinstall\\\" ${e.busy ? 'disabled' : ''} title=\\\"Apaga a cópia atual e baixa de novo do zero\\\">Reinstalar</button>\\n          </div>\\n        </div>`;\\n      }).join('');\\n      p.querySelectorAll('[data-ex]').forEach((x) => { x.onchange = () => window.api.extAction(x.dataset.ex, x.checked ? 'on' : 'off'); });\\n      p.querySelectorAll('[data-exa]').forEach((x) => { const [id, a] = x.dataset.exa.split('|'); x.onclick = () => window.api.extAction(id, a); });\\n    }\\n    if (window.api.onExtsPanel) window.api.onExtsPanel(async (d) => {\\n      closeAll();\\n      if (extsAberto) fecharExts();\\n      extsAberto = d.id;\\n      const sh = el('div'); sh.id = 'extsShade'; sh.onclick = () => fecharExts();\\n      document.body.appendChild(sh);\\n      const p = el('div', 'lp ex'); p.id = 'extsPanel';\\n      p.innerHTML = `<div class=\\\"ch\\\"><span class=\\\"lp-ico\\\">${SVG.puzzle}</span><b>Extensões</b><span>nas 4 contas</span><button class=\\\"cfg-x\\\" title=\\\"Fechar\\\">×</button></div>\\n        <div class=\\\"cb lp-body\\\"><div class=\\\"pv-msg\\\">Carregando...</div></div>\\n        <div class=\\\"lp-foot\\\"><span>Baixadas da Chrome Web Store. Ao ativar, desativar, atualizar ou reinstalar, as 4 contas recarregam para aplicar.</span></div>`;\\n      document.body.appendChild(p);\\n      p.querySelector('.cfg-x').onclick = () => fecharExts();\\n      drawExts(await window.api.extGet());\\n    });\\n    if (window.api.onExtsUpdate) window.api.onExtsUpdate(async () => { if (extsAberto) drawExts(await window.api.extGet()); });\\n    document.addEventListener('keydown', (e) => { if (extsAberto && e.key === 'Escape') { e.preventDefault(); fecharExts(); } }, true);\\n\\n    // ---------- Lives: painel com todas as contas ----------\\n    let livesAberto = null;\\n    function fecharLives() {\\n      if (!livesAberto) return;\\n      const id = livesAberto;\\n      livesAberto = null;\\n      const p = document.getElementById('livesPanel'); if (p) p.remove();\\n      const sh = document.getElementById('livesShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    const escL = (t) => String(t == null ? '' : t).replace(/[&<>\\\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;' }[c]));\\n    const PLATI = { twitch: SVG.twitch, kick: SVG.kick };\\n    function drawLives(o) {\\n      const p = document.getElementById('livesPanel');\\n      if (!p || !o) return;\\n      const ao = o.aoVivo.map((pl) => `<div class=\\\"lp-now ${pl.p}\\\">\\n          <div class=\\\"lp-now-h\\\"><span class=\\\"lp-ico\\\">${PLATI[pl.p]}</span><b>${escL(pl.name)}</b><span class=\\\"lp-n\\\">${pl.list.length} ao vivo</span></div>\\n          <div class=\\\"lp-chips\\\">${pl.list.length ? pl.list.map((c) => `<span class=\\\"lp-tag\\\"><i class=\\\"lp-dot\\\"></i>${escL(c)}</span>`).join('') : '<span class=\\\"lp-none\\\">nenhum canal oficial ao vivo agora</span>'}</div>\\n        </div>`).join('');\\n      const contas = o.contas.map((c) => `<div class=\\\"lp-acc\\\">\\n          <div class=\\\"lp-acc-h\\\"><b>${escL(c.name)}</b><span>${c.plats.reduce((t, pl) => t + pl.open.length, 0)} lives abertas</span></div>\\n          ${c.plats.map((pl) => `<div class=\\\"lp-row ${pl.p}${pl.on ? ' on' : ''}\\\">\\n            <div class=\\\"lp-row-h\\\"><span class=\\\"lp-ico\\\">${PLATI[pl.p]}</span><b>${escL(pl.name)}</b>\\n              ${pl.on ? `<span class=\\\"lp-count\\\">${pl.open.length} live${pl.open.length === 1 ? '' : 's'}${pl.open.length ? '<i class=\\\"rec\\\"></i>' : ''}</span>` : '<span class=\\\"lp-off\\\">desligada</span>'}\\n              <input type=\\\"checkbox\\\" class=\\\"sw\\\" ${pl.on ? 'checked' : ''} data-lt=\\\"${c.i}|${pl.p}\\\" title=\\\"${pl.on ? 'Desligar' : 'Ligar'} ${escL(pl.name)} em ${escL(c.name)}\\\"></div>\\n            ${pl.on && pl.open.length ? `<div class=\\\"lp-chips\\\">${pl.open.map((ch) => `<button class=\\\"lp-chip\\\" data-lv=\\\"${c.i}|${pl.p}|${escL(ch)}\\\" title=\\\"Abrir esta live com a conta ${escL(c.name)}\\\">${escL(ch)}</button>`).join('')}</div>` : ''}\\n            ${pl.on && !pl.open.length ? '<div class=\\\"lp-none\\\">ligada · nenhum canal ao vivo agora</div>' : ''}\\n            ${pl.on && pl.contando && pl.contando.length ? `<div class=\\\"lp-none\\\" style=\\\"color:#7fe08a\\\">✓ o jogo já está contando o bônus em: ${pl.contando.map(escL).join(', ')}</div>` : ''}\\n          </div>`).join('')}\\n        </div>`).join('');\\n      const lista = (o.canais || []).map((pl) => `<div class=\\\"lp-now ${pl.p}\\\">\\n          <div class=\\\"lp-now-h\\\"><span class=\\\"lp-ico\\\">${PLATI[pl.p]}</span><b>${escL(pl.name)}</b><span class=\\\"lp-n\\\">${pl.lista.length} canais</span></div>\\n          <div class=\\\"lp-chips\\\">${pl.lista.map((c) => `<span class=\\\"lp-tag\\\">${escL(c)}<button class=\\\"kx-x\\\" data-rm=\\\"${pl.p}|${escL(c)}\\\" title=\\\"Remover ${escL(c)} da lista (não é mais parceiro)\\\">×</button></span>`).join('')}</div>\\n          ${pl.removidos.length ? `<div class=\\\"lp-chips\\\">${pl.removidos.map((r) => `<button class=\\\"kx-mini rmv\\\" data-back=\\\"${pl.p}|${escL(r.slug)}\\\" title=\\\"Trazer ${escL(r.slug)} de volta para a lista\\\"><span class=\\\"dot\\\"></span><span class=\\\"nm\\\">${escL(r.slug)}</span><b>${r.como === 'auto' ? 'automático' : 'você tirou'}</b></button>`).join('')}</div>` : ''}\\n        </div>`).join('');\\n      p.querySelector('.lp-body').innerHTML = `<h3 class=\\\"kx-h\\\">Ao vivo agora</h3><div class=\\\"lp-nowg\\\">${ao}</div>\\n        <h3 class=\\\"kx-h\\\">Contas <small>clique num canal para assistir com a conta · a chave liga/desliga</small></h3><div class=\\\"lp-grid\\\">${contas}</div>\\n        ${lista ? `<h3 class=\\\"kx-h\\\">Canais oficiais <small>× tira quem não é mais parceiro · os riscados voltam com um clique · a lista também se ajusta sozinha quando você abre o painel de bônus no jogo</small></h3><div class=\\\"lp-nowg\\\">${lista}</div>` : ''}`;\\n      p.querySelector('.lp-quando').textContent = o.quando ? `Última verificação: ${o.quando}` + (o.erros ? ` · ${o.erros} canal(is) não responderam` : '') + (o.kickInfo ? (/^pelo jogo/.test(o.kickInfo) ? ` · ${o.kickInfo}` : ` · Kick ${o.kickInfo}`) : '') + (o.listaInfo ? ` · ${o.listaInfo}` : '') : 'Ainda não verificado.';\\n      p.querySelectorAll('[data-lt]').forEach((x) => { const [ci, pl] = x.dataset.lt.split('|'); x.onchange = () => window.api.setLives(Number(ci), pl, x.checked); });\\n      p.querySelectorAll('[data-lv]').forEach((x) => { const [ci, pl, ch] = x.dataset.lv.split('|'); x.onclick = () => window.api.openLivePage(Number(ci), pl, ch); });\\n      p.querySelectorAll('[data-rm]').forEach((x) => { const [pl, ch] = x.dataset.rm.split('|'); x.onclick = () => window.api.canalRemover(pl, ch); });\\n      p.querySelectorAll('[data-back]').forEach((x) => { const [pl, ch] = x.dataset.back.split('|'); x.onclick = () => window.api.canalVoltar(pl, ch); });\\n    }\\n    if (window.api.onLivesPanel) window.api.onLivesPanel(async (d) => {\\n      closeAll();\\n      if (livesAberto) fecharLives();\\n      livesAberto = d.id;\\n      const sh = el('div'); sh.id = 'livesShade'; sh.onclick = () => fecharLives();\\n      document.body.appendChild(sh);\\n      const p = el('div', 'lp'); p.id = 'livesPanel';\\n      p.innerHTML = `<div class=\\\"ch\\\"><span class=\\\"lp-ico\\\">${SVG.tv}</span><b>Lives</b><span>abertas em segundo plano</span><button class=\\\"cfg-x\\\" title=\\\"Fechar\\\">×</button></div>\\n        <div class=\\\"cb lp-body\\\"><div class=\\\"pv-msg\\\">Carregando...</div></div>\\n        <div class=\\\"lp-foot\\\"><span class=\\\"lp-quando\\\"></span><span class=\\\"grow\\\"></span><button class=\\\"kx-btn small\\\" id=\\\"lpLista\\\" title=\\\"Abre o painel de bônus do jogo escondido e atualiza a lista de parceiros\\\">Conferir lista</button><button class=\\\"kx-btn small\\\" id=\\\"lpNow\\\">Verificar agora</button></div>`;\\n      document.body.appendChild(p);\\n      p.querySelector('.cfg-x').onclick = () => fecharLives();\\n      p.querySelector('#lpLista').onclick = async (ev) => { const b1 = ev.currentTarget; b1.textContent = 'Conferindo...'; b1.disabled = true; drawLives(await window.api.listaConferir()); const b2 = p.querySelector('#lpLista'); if (b2) { b2.textContent = 'Conferir lista'; b2.disabled = false; } };\\n      p.querySelector('#lpNow').onclick = async (ev) => { ev.currentTarget.textContent = 'Verificando...'; drawLives(await window.api.livesCheckNow()); const b2 = p.querySelector('#lpNow'); if (b2) b2.textContent = 'Verificar agora'; };\\n      drawLives(await window.api.livesGet());\\n    });\\n    if (window.api.onLivesUpdate) window.api.onLivesUpdate(async () => { if (livesAberto) drawLives(await window.api.livesGet()); });\\n    document.addEventListener('keydown', (e) => { if (livesAberto && e.key === 'Escape') { e.preventDefault(); fecharLives(); } }, true);\\n\\n    // ---------- Novidades da versão (patch notes) ----------\\n    let novAberto = null;\\n    function fecharNov() {\\n      if (!novAberto) return;\\n      const id = novAberto; novAberto = null;\\n      const p = document.getElementById('novPanel'); if (p) p.remove();\\n      const sh = document.getElementById('novShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    // **texto** vira negrito (o resto é escapado)\\n    const rico = (t) => escL(t).replace(/\\\\*\\\\*(.+?)\\\\*\\\\*/g, '<b>$1</b>');\\n    const NOV_LOGO = `<svg class=\\\"nov-logo\\\" viewBox=\\\"0 0 64 64\\\"><circle cx=\\\"32\\\" cy=\\\"32\\\" r=\\\"28\\\" fill=\\\"#2a1046\\\" stroke=\\\"#1a0830\\\" stroke-width=\\\"4\\\"/>\\n      <path d=\\\"M6 32a26 26 0 0 1 52 0z\\\" fill=\\\"#ffd75e\\\"/><path d=\\\"M6 32a26 26 0 0 1 52 0\\\" fill=\\\"none\\\" stroke=\\\"#b07a00\\\" stroke-width=\\\"2\\\"/>\\n      <rect x=\\\"5\\\" y=\\\"29\\\" width=\\\"54\\\" height=\\\"6\\\" fill=\\\"#1a0830\\\"/><circle cx=\\\"32\\\" cy=\\\"32\\\" r=\\\"9\\\" fill=\\\"#fff3d6\\\" stroke=\\\"#1a0830\\\" stroke-width=\\\"4\\\"/>\\n      <circle cx=\\\"32\\\" cy=\\\"32\\\" r=\\\"3.5\\\" fill=\\\"#c79bff\\\"/><path d=\\\"M20 15l3 3M44 15l-3 3\\\" stroke=\\\"#fff3c4\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\"/></svg>`;\\n    // pacote: { id, atual, lista: [novidades da versão mais nova, ..., a mais antiga] } (versões antigas: um objeto só)\\n    function abrirNov(pk, vi) {\\n      const lista = pk.lista && pk.lista.length ? pk.lista : [pk];\\n      vi = Math.min(lista.length - 1, Math.max(0, vi == null ? pk.atual || 0 : vi));\\n      const d = lista[vi];\\n      closeAll();\\n      fecharNov();\\n      novAberto = pk.id;\\n      const sh = el('div'); sh.id = 'novShade'; document.body.appendChild(sh);\\n      const paginas = [null, ...(d.paginas || [])]; // a 1ª é a capa\\n      let pag = 0;\\n      const p = el('div', 'nov'); p.id = 'novPanel';\\n      const capa = () => `<div class=\\\"nov-hero\\\">\\n          <span class=\\\"spark\\\" style=\\\"left:8%;top:12%\\\">✦</span><span class=\\\"spark\\\" style=\\\"right:10%;top:18%;animation-delay:.6s\\\">✦</span>\\n          <span class=\\\"spark\\\" style=\\\"left:16%;top:46%;animation-delay:1.2s\\\">✧</span><span class=\\\"spark\\\" style=\\\"right:14%;top:52%;animation-delay:1.8s\\\">✧</span>\\n          ${NOV_LOGO}<div><span class=\\\"nov-selo\\\">${escL(d.selo || 'NOVIDADES')}</span></div>\\n          <div class=\\\"nov-tit\\\">${escL(d.titulo || '')}</div>\\n          ${(d.cartoes || []).length ? `<div class=\\\"nov-cards\\\">${d.cartoes.map((c) => `<div class=\\\"nov-card\\\"><div class=\\\"ic\\\">${escL(c.icone || '')}</div>\\n            <div class=\\\"vl\\\">${escL(c.valor || '')}</div><div class=\\\"nm\\\">${escL(c.nome || '')}</div><div class=\\\"sb\\\">${escL(c.sub || '')}</div></div>`).join('')}</div>` : ''}\\n          ${d.resumo ? `<div class=\\\"nov-res\\\">${rico(d.resumo)}</div>` : ''}\\n        </div>${d.destaque ? `<div class=\\\"nov-gold\\\">${rico(d.destaque)}</div>` : ''}`;\\n      const secao = (s) => `<div class=\\\"nov-hero\\\" style=\\\"padding:12px 14px 10px;margin-bottom:10px\\\"><span class=\\\"spark\\\" style=\\\"left:8%;top:30%\\\">✦</span><span class=\\\"spark\\\" style=\\\"right:9%;top:35%;animation-delay:.9s\\\">✧</span>\\n          <div class=\\\"nov-tit\\\" style=\\\"margin:2px 0;font-size:22px\\\">${escL(s.titulo || '')}</div></div>\\n        <div class=\\\"nov-sec\\\"><ul>${(s.itens || []).map((x) => `<li>${rico(x)}</li>`).join('')}</ul></div>`;\\n      const desenhar = () => {\\n        p.querySelector('.nov-bd').innerHTML = pag === 0 ? capa() : secao(paginas[pag]);\\n        p.querySelector('.nov-bd').scrollTop = 0;\\n        p.querySelector('.nov-dots').innerHTML = paginas.map((_, k) => `<i class=\\\"${k === pag ? 'on' : ''}\\\" data-pg=\\\"${k}\\\"></i>`).join('');\\n        p.querySelectorAll('[data-pg]').forEach((x) => { x.onclick = () => { pag = Number(x.dataset.pg); desenhar(); }; });\\n        p.querySelector('.nov-prev').disabled = pag === 0;\\n        p.querySelector('.nov-next').disabled = pag === paginas.length - 1;\\n      };\\n      const seletor = lista.length > 1 ? `<label class=\\\"nov-ver\\\" title=\\\"Novidades das versões anteriores\\\"><span>Versão</span><select>${lista.map((v, k) =>\\n        `<option value=\\\"${k}\\\"${k === vi ? ' selected' : ''}>${escL(v.versao || '')}${k === 0 ? ' (mais nova)' : ''}</option>`).join('')}</select></label>` : '';\\n      p.innerHTML = `<div class=\\\"nov-hd\\\"><span>NOVIDADES NO POKELINK ${escL(d.versao || '')}${d.data ? ' — ' + escL(d.data) : ''}</span>${seletor}</div>\\n        <div class=\\\"nov-bd\\\"></div>\\n        <div class=\\\"nov-nav\\\"><button class=\\\"nov-arr nov-prev\\\" title=\\\"Anterior\\\">◀</button><div class=\\\"nov-dots\\\"></div><button class=\\\"nov-arr nov-next\\\" title=\\\"Próxima\\\">▶</button></div>\\n        <button class=\\\"nov-go\\\">${escL(d.botao || 'JOGAR')}</button>`;\\n      document.body.appendChild(p);\\n      p.querySelector('.nov-prev').onclick = () => { if (pag > 0) { pag--; desenhar(); } };\\n      p.querySelector('.nov-next').onclick = () => { if (pag < paginas.length - 1) { pag++; desenhar(); } };\\n      p.querySelector('.nov-go').onclick = () => fecharNov();\\n      const sv = p.querySelector('.nov-ver select');\\n      if (sv) sv.onchange = () => { // troca de versão sem fechar o card (não avisa o PokeLink)\\n        const id = novAberto; novAberto = null;\\n        p.remove(); const sh0 = document.getElementById('novShade'); if (sh0) sh0.remove();\\n        abrirNov(Object.assign({}, pk, { id }), Number(sv.value));\\n      };\\n      desenhar();\\n      // a caixa fica sempre do tamanho da capa (não pula de tamanho ao trocar de página)\\n      const bd = p.querySelector('.nov-bd'); bd.style.minHeight = bd.offsetHeight + 'px';\\n    }\\n    if (window.api.onNovidades) window.api.onNovidades((d) => abrirNov(d));\\n    document.addEventListener('keydown', (e) => {\\n      if (!novAberto) return;\\n      if (e.key === 'Escape') { e.preventDefault(); fecharNov(); }\\n      else if (e.key === 'ArrowRight') { const b = document.querySelector('.nov-next'); if (b && !b.disabled) b.click(); }\\n      else if (e.key === 'ArrowLeft') { const b = document.querySelector('.nov-prev'); if (b && !b.disabled) b.click(); }\\n    }, true);\\n\\n    // ---------- Troca de hunt automática (segue a /hunt) ----------\\n    let ahAberto = null;\\n    function fecharAh() {\\n      if (!ahAberto) return;\\n      const id = ahAberto; ahAberto = null;\\n      const p = document.getElementById('ahPanel'); if (p) p.remove();\\n      const sh = document.getElementById('ahShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    const sel = (nome, atual, ops) => `<select data-ah=\\\"${nome}\\\">${ops.map(([v, t]) => `<option value=\\\"${v}\\\"${String(v) === String(atual) ? ' selected' : ''}>${t}</option>`).join('')}</select>`;\\n    function drawAh(d) {\\n      const p = document.getElementById('ahPanel');\\n      if (!p || !d) return;\\n      p.querySelector('.cb').innerHTML = `<div class=\\\"ah-aviso\\\">O PokeLink lê a recomendação da extensão <b>/hunt</b> e troca de mapa sozinho, como um jogador faria: só fora de combate, só para hunts liberadas e dentro do risco escolhido. Começa desligada. Confira se as regras do PokeIdle permitem antes de ligar.</div>\\n        <div class=\\\"ah-cfg\\\">\\n          <label>Critério ${sel('criterio', d.criterio, [['xp', 'Mais XP/h'], ['ouro', 'Mais ouro/h']])}</label>\\n          <label>Risco máximo ${sel('riscoMax', d.riscoMax, [[10, 'até 10%'], [20, 'até 20%'], [30, 'até 30%'], [50, 'até 50%'], [100, 'qualquer']])}</label>\\n          <label>Trocar se ganhar ${sel('margem', d.margem, [[5, '+5% ou mais'], [10, '+10% ou mais'], [20, '+20% ou mais'], [30, '+30% ou mais']])}</label>\\n          <label>Conferir a cada ${sel('intervaloMin', d.intervaloMin, [[10, '10 min'], [15, '15 min'], [30, '30 min'], [60, '1 hora']])}</label>\\n        </div>\\n        <h3 class=\\\"kx-h\\\">Contas <small>a chave liga/desliga em cada conta</small></h3>\\n        <div class=\\\"ah-g\\\">${d.contas.map((c) => `<div class=\\\"ah-c${c.on ? ' on' : ''}\\\">\\n          <div class=\\\"h\\\"><b>${escL(c.nome)}</b><input type=\\\"checkbox\\\" class=\\\"sw\\\" ${c.on ? 'checked' : ''} data-ahc=\\\"${c.i}\\\" title=\\\"${c.on ? 'Desligar' : 'Ligar'} nesta conta\\\"></div>\\n          <div class=\\\"ah-st\\\">${escL(c.status || '')}</div>\\n          ${c.on && c.proxima != null ? `<div class=\\\"px\\\">próxima conferência em ~${c.proxima} min</div>` : ''}\\n          ${c.hist.length ? `<div class=\\\"hs\\\">${c.hist.map((h) => `<span>${escL(h.hora)} · ${escL(h.de)} → <b>${escL(h.para)}</b>${h.ganho != null ? ` (+${h.ganho}%)` : ''}</span>`).join('')}</div>` : ''}\\n          <div class=\\\"bt\\\"><button class=\\\"kx-btn small\\\" data-aha=\\\"${c.i}\\\" title=\\\"Confere agora e troca se valer a pena\\\">Conferir agora</button></div>\\n        </div>`).join('')}</div>`;\\n      p.querySelectorAll('[data-ah]').forEach((x) => { x.onchange = () => window.api.huntSet({ [x.dataset.ah]: x.value }); });\\n      p.querySelectorAll('[data-ahc]').forEach((x) => { x.onchange = () => window.api.huntSet({ conta: Number(x.dataset.ahc), on: x.checked }); });\\n      p.querySelectorAll('[data-aha]').forEach((x) => { x.onclick = async () => { x.disabled = true; x.textContent = 'Conferindo...'; drawAh(await window.api.huntAgora(Number(x.dataset.aha))); }; });\\n    }\\n    if (window.api.onAutoHuntPanel) window.api.onAutoHuntPanel(async (d) => {\\n      closeAll();\\n      fecharAh();\\n      ahAberto = d.id;\\n      const sh = el('div'); sh.id = 'ahShade'; sh.onclick = () => fecharAh();\\n      document.body.appendChild(sh);\\n      const p = el('div', 'lp ah'); p.id = 'ahPanel';\\n      p.innerHTML = `<div class=\\\"ch\\\"><b>Troca de hunt automática</b><span>segue a recomendação da /hunt</span><button class=\\\"cfg-x\\\" title=\\\"Fechar\\\">×</button></div>\\n        <div class=\\\"cb\\\"><div class=\\\"pv-msg\\\">Carregando...</div></div>`;\\n      document.body.appendChild(p);\\n      p.querySelector('.cfg-x').onclick = () => fecharAh();\\n      drawAh(await window.api.huntGet());\\n    });\\n    if (window.api.onHuntUpdate) window.api.onHuntUpdate(async () => { if (ahAberto) drawAh(await window.api.huntGet()); });\\n    document.addEventListener('keydown', (e) => { if (ahAberto && e.key === 'Escape') { e.preventDefault(); fecharAh(); } }, true);\\n\\n    // ---------- Ver no celular: QR code e código para abrir o resumo no celular ----------\\n    // QR code simples (versão 4, correção L, modo byte): até 78 letras. Feito à mão para o PokeLink.\\n    function qrMatriz(texto) {\\n      const N = 33, DADOS = 80, EC = 20;\\n      const bytes = [...new TextEncoder().encode(texto)];\\n      if (bytes.length > 78) throw new Error('texto grande demais para o QR');\\n      // bits: modo byte (0100) + tamanho (8 bits) + bytes + fim\\n      const bits = [];\\n      const put = (v, n) => { for (let k = n - 1; k >= 0; k--) bits.push((v >> k) & 1); };\\n      put(4, 4); put(bytes.length, 8); bytes.forEach((b) => put(b, 8));\\n      put(0, Math.min(4, DADOS * 8 - bits.length));\\n      while (bits.length % 8) bits.push(0);\\n      const cw = [];\\n      for (let k = 0; k < bits.length; k += 8) cw.push(parseInt(bits.slice(k, k + 8).join(''), 2));\\n      for (let p = 0; cw.length < DADOS; p++) cw.push(p % 2 ? 0x11 : 0xEC);\\n      // correção de erros (Reed-Solomon)\\n      const exp = new Array(512), log = new Array(256);\\n      for (let k = 0, x = 1; k < 255; k++) { exp[k] = x; log[x] = k; x <<= 1; if (x & 256) x ^= 0x11D; }\\n      for (let k = 255; k < 512; k++) exp[k] = exp[k - 255];\\n      const mul = (a, b) => (a && b ? exp[log[a] + log[b]] : 0);\\n      let gen = [1];\\n      for (let k = 0; k < EC; k++) {\\n        const g = new Array(gen.length + 1).fill(0);\\n        gen.forEach((c, j) => { g[j] ^= c; g[j + 1] ^= mul(c, exp[k]); });\\n        gen = g;\\n      }\\n      const rest = new Array(EC).fill(0);\\n      for (const c of cw) {\\n        const f = c ^ rest.shift(); rest.push(0);\\n        for (let j = 0; j < EC; j++) rest[j] ^= mul(gen[j + 1], f);\\n      }\\n      const todos = cw.concat(rest);\\n      // matriz\\n      const m = Array.from({ length: N }, () => new Array(N).fill(false));\\n      const fixo = Array.from({ length: N }, () => new Array(N).fill(false));\\n      const set = (x, y, v) => { m[y][x] = v; fixo[y][x] = true; };\\n      const finder = (cx, cy) => {\\n        for (let dy = -4; dy <= 4; dy++) for (let dx = -4; dx <= 4; dx++) {\\n          const x = cx + dx, y = cy + dy;\\n          if (x < 0 || y < 0 || x >= N || y >= N) continue;\\n          const d = Math.max(Math.abs(dx), Math.abs(dy));\\n          set(x, y, d !== 2 && d !== 4);\\n        }\\n      };\\n      finder(3, 3); finder(N - 4, 3); finder(3, N - 4);\\n      for (let k = 0; k < N; k++) { if (!fixo[6][k]) set(k, 6, k % 2 === 0); if (!fixo[k][6]) set(6, k, k % 2 === 0); }\\n      for (let dy = -2; dy <= 2; dy++) for (let dx = -2; dx <= 2; dx++) set(26 + dx, 26 + dy, Math.max(Math.abs(dx), Math.abs(dy)) !== 1);\\n      // formato (correção L, máscara 0)\\n      const dado = (1 << 3) | 0;\\n      let r = dado; for (let k = 0; k < 10; k++) r = (r << 1) ^ ((r >> 9) * 0x537);\\n      const fmt = ((dado << 10) | r) ^ 0x5412;\\n      const b = (k) => ((fmt >> k) & 1) === 1;\\n      for (let k = 0; k <= 5; k++) set(8, k, b(k));\\n      set(8, 7, b(6)); set(8, 8, b(7)); set(7, 8, b(8));\\n      for (let k = 9; k < 15; k++) set(14 - k, 8, b(k));\\n      for (let k = 0; k < 8; k++) set(N - 1 - k, 8, b(k));\\n      for (let k = 8; k < 15; k++) set(8, N - 15 + k, b(k));\\n      set(8, N - 8, true);\\n      // dados em zigue-zague, com máscara 0\\n      let i = 0;\\n      for (let dir = N - 1; dir >= 1; dir -= 2) {\\n        if (dir === 6) dir = 5;\\n        for (let v = 0; v < N; v++) for (let j = 0; j < 2; j++) {\\n          const x = dir - j, sobe = ((dir + 1) & 2) === 0, y = sobe ? N - 1 - v : v;\\n          if (fixo[y][x]) continue;\\n          let bit = false;\\n          if (i < todos.length * 8) bit = ((todos[i >> 3] >> (7 - (i & 7))) & 1) === 1;\\n          i++;\\n          if ((x + y) % 2 === 0) bit = !bit;\\n          m[y][x] = bit;\\n        }\\n      }\\n      return m;\\n    }\\n\\n    const qrSvg = (texto) => {\\n      const m = qrMatriz(texto), q = 4, n = m.length + q * 2;\\n      let r = '';\\n      m.forEach((linha, y) => linha.forEach((v, x) => { if (v) r += `M${x + q},${y + q}h1v1h-1z`; }));\\n      return `<svg viewBox=\\\"0 0 ${n} ${n}\\\" shape-rendering=\\\"crispEdges\\\" role=\\\"img\\\" aria-label=\\\"QR code para abrir no celular\\\"><rect width=\\\"${n}\\\" height=\\\"${n}\\\" fill=\\\"#fff8ec\\\"/><path d=\\\"${r}\\\" fill=\\\"#1a0a12\\\"/></svg>`;\\n    };\\n    let celAberto = null;\\n    function fecharCel() {\\n      if (!celAberto) return;\\n      const id = celAberto; celAberto = null;\\n      const p = document.getElementById('celPanel'); if (p) p.remove();\\n      const sh = document.getElementById('celShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    async function acaoCel(acao, btn) {\\n      if (btn) { btn.disabled = true; btn.textContent = 'Aguarde...'; }\\n      drawCel(await window.api.monitorAcao(acao));\\n    }\\n    function drawCel(d) {\\n      const p = document.getElementById('celPanel');\\n      if (!p || !d) return;\\n      const cb = p.querySelector('.cb'), ft = p.querySelector('.lp-foot');\\n      if (!d.ligado) {\\n        cb.innerHTML = `<div class=\\\"cel-off\\\">\\n          <div>Veja o resumo das 4 contas no celular, <b>de qualquer lugar</b>: nível, ouro, XP, capturas, hunt, pontos das lives e avisos (conta travada, meta da Kick, shiny...).</div>\\n          <ul><li>O celular só <b>vê</b>: não dá para mexer em nada por lá.</li>\\n          <li>O resumo vai a cada ${d.min} minutos para um servidor, guardado sob um código que só você tem.</li>\\n          <li>Senhas e logins nunca são enviados. Ao desligar, o resumo é apagado do servidor.</li></ul>\\n          <div class=\\\"nota\\\">Só atualiza com o PC ligado e o PokeLink aberto.</div></div>`;\\n        ft.innerHTML = '<span class=\\\"grow\\\"></span><button class=\\\"kx-btn go\\\" data-cel=\\\"ligar\\\">Ligar</button>';\\n      } else {\\n        const st = d.enviando ? ['', 'Enviando o resumo...'] : d.erro ? ['erro', `Não consegui enviar: ${escL(d.erro)}`]\\n          : d.ultimo ? ['', `Último envio às ${escL(d.ultimo)} · atualiza a cada ${d.min} minutos`] : ['aviso', 'Preparando o primeiro envio...'];\\n        cb.innerHTML = `<div class=\\\"cel-g\\\"><div class=\\\"cel-qr\\\">${qrSvg(d.link)}</div>\\n          <div class=\\\"cel-i\\\"><ol><li>Aponte a <b>câmera do celular</b> para o QR code.</li>\\n            <li>Ou abra <b>${escL(d.site.replace(/^https:\\\\/\\\\//, ''))}</b> e digite o código:</li></ol>\\n            <div class=\\\"cel-cod\\\">${escL(d.codigoFmt)}</div>\\n            ${d.codigoNovo ? '<div class=\\\"cel-st aviso\\\">O código mudou: leia o QR de novo no celular.</div>' : ''}\\n            <div class=\\\"cel-st ${st[0]}\\\">${st[1]}</div>\\n            <div style=\\\"color:#9d7a8a;font-size:12px\\\">Quem tiver este código vê o resumo. Se alguém viu, use \\\"Trocar código\\\".</div></div></div>`;\\n        ft.innerHTML = `<button class=\\\"kx-btn small\\\" data-cel=\\\"desligar\\\" title=\\\"Para de enviar e apaga o resumo do servidor\\\">Desligar</button>\\n          <button class=\\\"kx-btn small\\\" data-cel=\\\"trocar\\\" title=\\\"Cria um código novo; o antigo para de funcionar\\\">Trocar código</button>\\n          <span class=\\\"grow\\\"></span><button class=\\\"kx-btn small\\\" data-copiar=\\\"1\\\">Copiar link</button>\\n          <button class=\\\"kx-btn small go\\\" data-cel=\\\"agora\\\"${d.enviando ? ' disabled' : ''}>Enviar agora</button>`;\\n      }\\n      ft.querySelectorAll('[data-cel]').forEach((b) => { b.onclick = () => acaoCel(b.dataset.cel, b); });\\n      const cp = ft.querySelector('[data-copiar]');\\n      if (cp) cp.onclick = async () => { try { await navigator.clipboard.writeText(d.link); cp.textContent = 'Copiado!'; } catch (e) { cp.textContent = 'Não copiou'; } };\\n    }\\n    if (window.api.onMonitorPanel) window.api.onMonitorPanel(async (d) => {\\n      closeAll();\\n      fecharCel();\\n      celAberto = d.id;\\n      const sh = el('div'); sh.id = 'celShade'; sh.onclick = () => fecharCel();\\n      document.body.appendChild(sh);\\n      const p = el('div', 'lp cel'); p.id = 'celPanel';\\n      p.innerHTML = `<div class=\\\"ch\\\"><b>Ver no celular</b><span>resumo das contas de qualquer lugar</span><button class=\\\"cfg-x\\\" title=\\\"Fechar\\\">×</button></div>\\n        <div class=\\\"cb\\\"><div class=\\\"pv-msg\\\">Carregando...</div></div><div class=\\\"lp-foot\\\"></div>`;\\n      document.body.appendChild(p);\\n      p.querySelector('.cfg-x').onclick = () => fecharCel();\\n      drawCel(await window.api.monitorGet());\\n    });\\n    if (window.api.onMonitorUpdate) window.api.onMonitorUpdate(async () => { if (celAberto) drawCel(await window.api.monitorGet()); });\\n    document.addEventListener('keydown', (e) => { if (celAberto && e.key === 'Escape') { e.preventDefault(); fecharCel(); } }, true);\\n\\n    // ---------- Uso de CPU e memória: cartões coloridos (verde ok · amarelo médio · vermelho alto) ----------\\n    let usoAberto = null, usoTimer = null;\\n    function fecharUso() {\\n      if (!usoAberto) return;\\n      const id = usoAberto;\\n      usoAberto = null;\\n      clearInterval(usoTimer); usoTimer = null;\\n      const p = document.getElementById('usoPanel'); if (p) p.remove();\\n      const sh = document.getElementById('usoShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    const mb = (v) => (v >= 1024 ? (v / 1024).toFixed(1).replace('.', ',') + ' GB' : Math.round(v) + ' MB');\\n    const pct = (v) => Math.round(v || 0) + '%';\\n    const NIVEL = { ok: 'OK', medio: 'MÉDIO', alto: 'ALTO' };\\n    const cartao = (cls, titulo, valor, sub, det, nivel) => `<div class=\\\"uso-c ${nivel}${cls ? ' ' + cls : ''}\\\">\\n        <div class=\\\"t\\\" title=\\\"${escL(titulo)}\\\">${escL(titulo)}</div><div class=\\\"v\\\">${valor}</div>\\n        <div class=\\\"s\\\"><span>${sub}</span><span class=\\\"tag\\\">${NIVEL[nivel]}</span></div>${det ? `<div class=\\\"d\\\">${det}</div>` : ''}</div>`;\\n    function drawUso(d) {\\n      const p = document.getElementById('usoPanel');\\n      if (!p || !d) return;\\n      const t = d.total;\\n      let h = `<div class=\\\"uso-g\\\">${cartao('hero', 'PokeLink inteiro', mb(t.mem), `CPU ${pct(t.cpu)}`, `4 contas, barras e ${t.nLives} live${t.nLives === 1 ? '' : 's'}`, t.nivel)}</div>`;\\n      h += `<div class=\\\"uso-h\\\">Contas</div><div class=\\\"uso-g\\\">${d.contas.map((c) => cartao('', c.nome, mb(c.mem), `CPU ${pct(c.cpu)}`, c.modo, c.nivel)).join('')}</div>`;\\n      h += `<div class=\\\"uso-h\\\">Por grupo <span style=\\\"text-transform:none;letter-spacing:0;color:#9d7a8a\\\">· do que mais gasta para o que menos gasta</span></div><div class=\\\"uso-g\\\">${d.grupos.map((g) =>\\n        cartao('', g.nome + (g.qtd ? ` (${g.qtd})` : ''), mb(g.mem), `CPU ${pct(g.cpu)}`, g.porItem != null ? `≈ ${mb(g.porItem)} por live` : g.dica, g.nivel)).join('')}</div>`;\\n      if (d.outros && d.outros.length) h += `<div class=\\\"uso-h\\\">Dentro de \\\"Outros\\\"</div><div class=\\\"uso-out\\\">${d.outros.map((o) => `<span>${escL(o.nome)}: <b>${mb(o.mem)}</b></span>`).join('')}</div>`;\\n      p.querySelector('.cb').innerHTML = h;\\n    }\\n    if (window.api.onUsoPanel) window.api.onUsoPanel(async (d) => {\\n      closeAll();\\n      if (usoAberto) fecharUso();\\n      usoAberto = d.id;\\n      const sh = el('div'); sh.id = 'usoShade'; sh.onclick = () => fecharUso();\\n      document.body.appendChild(sh);\\n      const p = el('div', 'lp uso'); p.id = 'usoPanel';\\n      p.innerHTML = `<div class=\\\"ch\\\"><b>Uso de CPU e memória</b><span>atualiza sozinho a cada 5 s</span><button class=\\\"cfg-x\\\" title=\\\"Fechar\\\">×</button></div>\\n        <div class=\\\"cb\\\"><div class=\\\"pv-msg\\\">Medindo...</div></div>\\n        <div class=\\\"lp-foot\\\"><span class=\\\"uso-leg\\\"><span><i style=\\\"background:#7fe08a\\\"></i>ok</span><span><i style=\\\"background:#e7c46a\\\"></i>médio consumo</span><span><i style=\\\"background:#ff5d6c\\\"></i>alto consumo</span></span>\\n        <span class=\\\"grow\\\"></span><span style=\\\"color:#9d7a8a;font-size:12px\\\">Dica: Eco e Mega Eco deixam as contas mais leves</span></div>`;\\n      document.body.appendChild(p);\\n      p.querySelector('.cfg-x').onclick = () => fecharUso();\\n      drawUso(await window.api.usoGet());\\n      usoTimer = setInterval(async () => { if (usoAberto) drawUso(await window.api.usoGet()); }, 5000);\\n    });\\n    document.addEventListener('keydown', (e) => { if (usoAberto && e.key === 'Escape') { e.preventDefault(); fecharUso(); } }, true);\\n\\n    // ---------- Pontos da Kick: painel que desce da moedinha ----------\\n    let kickAberto = null;\\n    let kickIniciado = false;\\n    function fecharKick() {\\n      if (!kickAberto) return;\\n      const id = kickAberto;\\n      kickAberto = null;\\n      const k = document.getElementById('kickw');\\n      k.hidden = true;\\n      const sh = document.getElementById('kickShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    if (window.api.onKickPanel) window.api.onKickPanel((d) => {\\n      closeAll();\\n      if (kickAberto) fecharKick();\\n      kickAberto = d.id;\\n      const sh = el('div'); sh.id = 'kickShade'; sh.onclick = () => fecharKick();\\n      document.body.appendChild(sh);\\n      const k = document.getElementById('kickw');\\n      k.classList.add('panel');\\n      k.hidden = false;\\n      if (!kickIniciado) { kickIniciado = true; initKick({ fechar: () => fecharKick(), conta: d.conta }); }\\n      else { window.__kickConta(d.conta); window.__kickRefresh(); }\\n      const fit = () => {\\n        const r = k.getBoundingClientRect();\\n        const x = Math.max(8, Math.min(d.x, innerWidth - r.width - 8));\\n        let y = d.y;\\n        if (innerHeight > 100 && y + r.height > innerHeight - 8) y = Math.max(40, (d.up || innerHeight) - r.height);\\n        k.style.left = x + 'px';\\n        k.style.top = Math.max(40, Math.min(y, innerHeight - r.height - 8)) + 'px';\\n      };\\n      requestAnimationFrame(fit);\\n      window.addEventListener('resize', fit);\\n    });\\n    document.addEventListener('keydown', (e) => { if (kickAberto && e.key === 'Escape') { e.preventDefault(); fecharKick(); } }, true);\\n\\n    // ---------- Auto Compra: painel que desce do botão ----------\\n    let cfgAberto = null;\\n    function fecharCfg() {\\n      if (!cfgAberto) return;\\n      const id = cfgAberto;\\n      cfgAberto = null;\\n      const c = document.getElementById('cfg');\\n      c.hidden = true;\\n      c.classList.remove('panel');\\n      const sh = document.getElementById('cfgShade'); if (sh) sh.remove();\\n      window.api.autoCfgClosed(id);\\n    }\\n    let cfgIniciado = false;\\n    if (window.api.onAutoCfg) window.api.onAutoCfg((d) => {\\n      closeAll();\\n      if (cfgAberto) fecharCfg();\\n      cfgAberto = d.id;\\n      const sh = el('div'); sh.id = 'cfgShade'; sh.onclick = () => fecharCfg();\\n      document.body.appendChild(sh);\\n      const c = document.getElementById('cfg');\\n      c.classList.add('panel');\\n      // liga/desliga desta conta (antes era um botão separado na barra)\\n      const acc = document.getElementById('cfgAcc');\\n      acc.hidden = !Number.isInteger(d.conta);\\n      document.getElementById('cfgAccNome').textContent = `Auto Compra ligada em ${d.nome || 'nesta conta'}`;\\n      document.getElementById('cfgAccSt').textContent = d.on ? (d.status ? 'Status: ' + d.status : 'Ligada') : 'Desligada: liga aqui para começar a comprar sozinho';\\n      const sw = document.getElementById('cfgAccOn');\\n      sw.checked = !!d.on;\\n      sw.onchange = () => {\\n        window.api.setAuto(d.conta, sw.checked);\\n        document.getElementById('cfgAccSt').textContent = sw.checked ? 'Ligada' : 'Desligada';\\n      };\\n      // ações que antes ficavam no menu \\\"Auto Compra\\\" da barra de cima\\n      const now = document.getElementById('cfgNow');\\n      now.hidden = !Number.isInteger(d.conta);\\n      now.textContent = 'Verificar agora';\\n      now.title = `Confere o estoque de ${d.nome || 'esta conta'} agora`;\\n      now.onclick = () => { window.api.autoRunNow(Number.isInteger(window.__cfgContaAtual) ? window.__cfgContaAtual : d.conta); fecharCfg(); };\\n      document.getElementById('cfgLog').onclick = () => window.api.autoLog();\\n      if (!cfgIniciado) {\\n        cfgIniciado = true;\\n        initConfig({ fechar: () => fecharCfg(), conta: Number.isInteger(d.conta) ? d.conta : 0 });\\n        // botão de fechar no cabeçalho do painel\\n        const x = el('button', 'cfg-x', '×', 'Fechar', () => fecharCfg());\\n        c.querySelector('.ch').appendChild(x);\\n      } else {\\n        c.hidden = false;\\n        if (window.__cfgConta) window.__cfgConta(Number.isInteger(d.conta) ? d.conta : 0);\\n      }\\n      // posição: embaixo do botão, sem sair da janela\\n      const fit = () => {\\n        const r = c.getBoundingClientRect();\\n        const x = Math.max(8, Math.min(d.x, innerWidth - r.width - 8));\\n        let y = d.y;\\n        if (innerHeight > 100 && y + r.height > innerHeight - 8) y = Math.max(40, (d.up || innerHeight) - r.height);\\n        c.style.left = x + 'px';\\n        c.style.top = Math.max(40, Math.min(y, innerHeight - r.height - 8)) + 'px';\\n      };\\n      requestAnimationFrame(fit);\\n      window.addEventListener('resize', fit);\\n    });\\n    document.addEventListener('keydown', (e) => { if (cfgAberto && e.key === 'Escape') { e.preventDefault(); fecharCfg(); } }, true);\\n\\n    // ---------- menuzinho de escolha (ex.: Desempenho) ----------\\n    let popCur = null;\\n    function closePopup(value) {\\n      if (!popCur) return;\\n      const id = popCur.id;\\n      popCur = null;\\n      const sh = document.getElementById('popShade'); if (sh) sh.remove();\\n      const pn = document.getElementById('popPanel'); if (pn) pn.remove();\\n      window.api.popupReply(id, value == null ? null : value);\\n    }\\n    if (window.api.onPopup) window.api.onPopup((d) => {\\n      closePopup(null);\\n      closeAll();\\n      popCur = d;\\n      const sh = el('div'); sh.id = 'popShade'; sh.onclick = () => closePopup(null);\\n      document.body.appendChild(sh);\\n      const p = el('div', 'dd pop'); p.id = 'popPanel';\\n      if (d.title) p.appendChild(el('div', 'pop-t')).textContent = d.title;\\n      if (d.sub) p.appendChild(el('div', 'pop-sub')).textContent = d.sub;\\n      d.items.forEach((it) => {\\n        const b = el('button', 'it pop-it' + (it.checked ? ' cur' : ''));\\n        b.innerHTML = '<span class=\\\"pop-ic\\\"></span><span class=\\\"pop-tx\\\"><b></b><small></small></span><span class=\\\"pop-ok\\\"></span>';\\n        b.querySelector('.pop-ic').textContent = it.icon || '';\\n        b.querySelector('b').textContent = it.label;\\n        b.querySelector('small').textContent = it.desc || '';\\n        b.querySelector('.pop-ok').textContent = it.checked ? '✓' : '';\\n        b.onclick = () => closePopup(it.value);\\n        p.appendChild(b);\\n      });\\n      document.body.appendChild(p);\\n      // posiciona: embaixo do botão; se não couber, em cima; nunca fora da janela\\n      const fit = () => {\\n        const r = p.getBoundingClientRect();\\n        let x = Math.min(d.x, innerWidth - r.width - 6);\\n        let y = d.y;\\n        if (innerHeight > 100 && y + r.height > innerHeight - 6 && d.up) y = d.up - r.height;\\n        p.style.left = Math.max(6, x) + 'px';\\n        p.style.top = Math.max(38, y) + 'px';\\n      };\\n      fit();\\n      window.addEventListener('resize', fit, { once: true });\\n      (p.querySelector('.pop-it.cur') || p.querySelector('.pop-it')).focus();\\n    });\\n    document.addEventListener('keydown', (e) => { if (popCur && e.key === 'Escape') { e.preventDefault(); closePopup(null); } }, true);\\n    // o app pode fechar um pop-up sozinho (ex.: \\\"gerando...\\\" quando termina)\\n    if (window.api.onDialogClose) window.api.onDialogClose((id) => {\\n      if (dlgCur && dlgCur.id === id) { answer(cancelOf(dlgCur)); return; }\\n      const k = dlgQueue.findIndex((d) => d.id === id);\\n      if (k >= 0) { const [d] = dlgQueue.splice(k, 1); window.api.dialogReply(d.id, cancelOf(d), null); }\\n    });\\n\\n    document.addEventListener('keydown', (e) => {\\n      if (dlgCur) {\\n        if (e.key === 'Escape') { e.preventDefault(); answer(cancelOf(dlgCur)); }\\n        return; // Enter aciona o botão em foco (o padrão já começa focado)\\n      }\\n      if (e.key === 'Escape') closeAll();\\n    });\\n    window.addEventListener('blur', closeAll); // trocou de janela (Alt+Tab): fecha\\n\\n    window.api.onTitleState(({ title, version, channel, icon, menus }) => {\\n      MENUS = menus;\\n      closeAll();\\n      tb.innerHTML = '';\\n      document.title = title;\\n      const brand = el('div', 'brand', iconHtml(icon) + '<b></b>');\\n      brand.querySelector('b').textContent = title;\\n      if (channel || version) {\\n        const v = el('span', 'ver', null, `Versão ${version}${channel ? ' (' + channel.toLowerCase() + ')' : ''}`);\\n        v.textContent = channel ? `${channel} ${version}` : `v${version}`;\\n        brand.appendChild(v);\\n      }\\n      tb.appendChild(brand);\\n      const nav = el('nav');\\n      menus.forEach((m, idx) => {\\n        const b = el('button', 'mbtn');\\n        b.innerHTML = (MENU_ICO[m.label] || '') + '<span></span>';\\n        b.querySelector('span').textContent = m.label;\\n        b.dataset.label = m.label;\\n        b.onclick = () => (openIdx === idx ? closeAll() : openTop(idx, b));\\n        b.onmouseenter = () => { if (openIdx !== -1) openTop(idx, b); }; // com um menu aberto, passar o mouse troca\\n        nav.appendChild(b);\\n      });\\n      tb.appendChild(nav);\\n      tb.appendChild(el('button', 'ibtn', 'i', 'Sobre o PokeLink', () => window.api.showAbout()));\\n      if (window.__badges) applyBadges(window.__badges);\\n    });\\n    // selos com números nos menus (ex.: lives abertas)\\n    function applyBadges(bd) {\\n      window.__badges = bd;\\n      tb.querySelectorAll('.mbtn').forEach((btn) => {\\n        const n = bd[btn.dataset.label];\\n        let s = btn.querySelector('.mb-badge');\\n        if (n > 0) { if (!s) { s = el('i', 'mb-badge'); btn.appendChild(s); } s.textContent = n > 99 ? '99+' : String(n); }\\n        else if (s) s.remove();\\n      });\\n    }\\n    if (window.api.onTitleBadges) window.api.onTitleBadges(applyBadges);\\n    window.api.titleReady();\\n  }\\n\\n  /* ----------------------------- barra ----------------------------- */\\n  const LEVEL_NAMES = ['Normal', 'Eco', 'Mega Eco'];\\n  const CHIPS = ['▶', '🍃', '📊', '💤'];\\n  const SVG = {\\n    reload: '<svg viewBox=\\\"0 0 16 16\\\"><path d=\\\"M13 8a5 5 0 1 1-1.6-3.7\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\"/><path d=\\\"M13.5 2.5v3.3h-3.3\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/></svg>',\\n    on: '<svg viewBox=\\\"0 0 16 16\\\"><path d=\\\"M2 6h3l4-3v10l-4-3H2z\\\" fill=\\\"#fff\\\"/><path d=\\\"M11 5.5a3.5 3.5 0 0 1 0 5M12.8 3.8a6 6 0 0 1 0 8.4\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.5\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\"/></svg>',\\n    off: '<svg viewBox=\\\"0 0 16 16\\\"><path d=\\\"M2 6h3l4-3v10l-4-3H2z\\\" fill=\\\"#fff\\\"/><path d=\\\"M11 5.5l4 5M15 5.5l-4 5\\\" stroke=\\\"#ff8a8a\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"/></svg>',\\n    expand: '<svg viewBox=\\\"0 0 16 16\\\"><path d=\\\"M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/></svg>',\\n    grid: '<svg viewBox=\\\"0 0 16 16\\\" fill=\\\"#fff\\\"><rect x=\\\"2\\\" y=\\\"2\\\" width=\\\"5\\\" height=\\\"5\\\" rx=\\\"1\\\"/><rect x=\\\"9\\\" y=\\\"2\\\" width=\\\"5\\\" height=\\\"5\\\" rx=\\\"1\\\"/><rect x=\\\"2\\\" y=\\\"9\\\" width=\\\"5\\\" height=\\\"5\\\" rx=\\\"1\\\"/><rect x=\\\"9\\\" y=\\\"9\\\" width=\\\"5\\\" height=\\\"5\\\" rx=\\\"1\\\"/></svg>',\\n    map: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\"><path d=\\\"M8 1.5a4.5 4.5 0 0 0-4.5 4.5c0 3.4 4.5 8.5 4.5 8.5s4.5-5.1 4.5-8.5A4.5 4.5 0 0 0 8 1.5z\\\" fill=\\\"#fff\\\"/><circle cx=\\\"8\\\" cy=\\\"6\\\" r=\\\"1.7\\\" fill=\\\"#7a4098\\\"/></svg>',\\n    mapa: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.6\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"M1.5 3.5l4-1.5 5 2 4-1.5v10l-4 1.5-5-2-4 1.5z\\\"/><path d=\\\"M5.5 2v10M10.5 4v10\\\"/></svg>',\\n    olho: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.6\\\"><path d=\\\"M1 8s2.6-5 7-5 7 5 7 5-2.6 5-7 5-7-5-7-5z\\\"/><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"2.2\\\" fill=\\\"#fff\\\"/></svg>',\\n    olhoOff: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"><path d=\\\"M1 8s2.6-5 7-5 7 5 7 5-2.6 5-7 5-7-5-7-5z\\\"/><path d=\\\"M2 2l12 12\\\"/></svg>',\\n    mira: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\"><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"5.2\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.6\\\"/><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"1.6\\\" fill=\\\"#fff\\\"/><path d=\\\"M8 .8v3M8 12.2v3M.8 8h3M12.2 8h3\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"/></svg>',\\n    puzzle: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\"><path d=\\\"M6 1.5a1.6 1.6 0 0 1 3.2 0V3h3a1 1 0 0 1 1 1v3h-1.5a1.6 1.6 0 0 0 0 3.2H13.2v3a1 1 0 0 1-1 1h-3v-1.5a1.6 1.6 0 0 0-3.2 0V14.5h-3a1 1 0 0 1-1-1v-3h1.5a1.6 1.6 0 0 0 0-3.2H2V4a1 1 0 0 1 1-1h3z\\\" fill=\\\"#fff\\\"/></svg>',\\n    coin: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\"><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"6.5\\\" fill=\\\"#f7d85a\\\" stroke=\\\"#3a1d00\\\" stroke-width=\\\"1.4\\\"/><path d=\\\"M8 4.5v7M6 6.2h3.2a1.3 1.3 0 0 1 0 2.6H6.8a1.3 1.3 0 0 0 0 2.6H10\\\" fill=\\\"none\\\" stroke=\\\"#3a1d00\\\" stroke-width=\\\"1.3\\\" stroke-linecap=\\\"round\\\"/></svg>',\\n    twitch: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\"><path d=\\\"M3 1.5h11v7.5l-3 3H8.5L6 14.5V12H3z\\\" fill=\\\"#fff\\\"/><path d=\\\"M7 4.5v3M10.5 4.5v3\\\" stroke=\\\"#6a3bc4\\\" stroke-width=\\\"1.6\\\" stroke-linecap=\\\"round\\\"/></svg>',\\n    kick: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\"><path d=\\\"M2.5 1.5h3.5v4h1.5v-2h2v-2h4v4h-2v2h-2v1h2v2h2v4h-4v-2h-2v-2H6v4H2.5z\\\" fill=\\\"currentColor\\\"/></svg>',\\n    tv: '<svg viewBox=\\\"0 0 16 16\\\" width=\\\"10\\\" height=\\\"10\\\"><rect x=\\\"1.5\\\" y=\\\"3.5\\\" width=\\\"13\\\" height=\\\"9\\\" rx=\\\"2\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.8\\\"/><path d=\\\"M5 1.5l3 2 3-2\\\" fill=\\\"none\\\" stroke=\\\"#fff\\\" stroke-width=\\\"1.5\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/><path d=\\\"M6.5 6v4l3.5-2z\\\" fill=\\\"#fff\\\"/></svg>',\\n    gear: '<svg viewBox=\\\"0 0 16 16\\\"><path fill=\\\"#fff\\\" d=\\\"M9.3 1.4l.3 1.8c.4.1.8.3 1.2.6l1.7-.7 1.4 2.4-1.4 1.2c.1.4.1.8 0 1.2l1.4 1.2-1.4 2.4-1.7-.7c-.4.3-.8.5-1.2.6l-.3 1.8H6.7l-.3-1.8c-.4-.1-.8-.3-1.2-.6l-1.7.7-1.4-2.4 1.4-1.2a4 4 0 0 1 0-1.2L2.1 4.9l1.4-2.4 1.7.7c.4-.3.8-.5 1.2-.6l.3-1.8z\\\"/><circle cx=\\\"8\\\" cy=\\\"8\\\" r=\\\"2.1\\\" fill=\\\"#7a4098\\\"/></svg>',\\n  };\\n\\n  function el(tag, cls, html, title, onclick) {\\n    const e = document.createElement(tag);\\n    if (cls) e.className = cls;\\n    if (html != null) e.innerHTML = html;\\n    if (title) e.title = title;\\n    if (onclick) e.onclick = onclick;\\n    return e;\\n  }\\n  const group = (cls) => el('div', 'grp ' + cls);\\n\\n  function render({ level, names, auto, focused, muted, pos, lives, loading, extBtns, hunt }) {\\n    app.innerHTML = '';\\n    document.body.classList.toggle('bottom', !!pos && pos[I] === 'bottom');\\n    const zoomed = focused !== -1;\\n    const esc = (t) => String(t == null ? '' : t).replace(/[&<>\\\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;' }[c]));\\n\\n    // 1) conta: o nome (clique = ampliar) ou as 4 abas quando ampliada\\n    const left = group('left');\\n    if (!zoomed) {\\n      left.appendChild(el('button', 'btn name', `<span class=\\\"chip\\\">${I + 1}</span><span class=\\\"lbl\\\">${esc(names[I])}</span>`,\\n        'Ampliar esta conta', () => window.api.setView(I)));\\n    } else {\\n      names.forEach((n, i) => {\\n        left.appendChild(el('button', 'btn tab' + (i === I ? ' cur' : ''), `<span class=\\\"chip\\\">${i + 1}</span><span class=\\\"lbl\\\">${esc(n)}</span>`,\\n          'Ir para ' + n, () => window.api.setView(i)));\\n      });\\n    }\\n    app.appendChild(left);\\n    app.appendChild(el('div', 'sep'));\\n\\n    // 2) jogo: desempenho + auto compra (com a engrenagem colada)\\n    const lv = level[I];\\n    const on = !!(auto && auto.enabled[I]);\\n    const mid = group('mid');\\n    // o modo de desempenho fica na barra de cima (menu Desempenho); aqui só a cena desta conta\\n    if (level[I] === 0 || level[I] === 1) {\\n      const eco = level[I] === 1;\\n      mid.appendChild(el('button', 'btn cena' + (eco ? '' : ' on'),\\n        `<span class=\\\"chip\\\">${eco ? SVG.olhoOff : SVG.olho}</span><span class=\\\"lbl\\\">${eco ? 'Ligar a cena' : 'Cena ligada'}</span>`,\\n        eco ? 'Esta conta está em Eco (cena desligada). Clique para ver o jogo nesta tela.' : 'Mostrando o jogo. Clique para desligar a cena desta conta (Eco).',\\n        () => window.api.cenaToggle(I)));\\n    }\\n    // um botão só: mostra se está ligada e abre o painel (com o liga/desliga e as regras)\\n    // botão dividido: clicar no nome liga/desliga; clicar na setinha (depois da barrinha) abre as configurações\\n    mid.appendChild(el('button', 'btn auto split' + (on ? ' on' : ''),\\n      `<span class=\\\"coin\\\"></span><span class=\\\"lbl\\\">Auto Compra${on && (Array.isArray(auto.dry) ? auto.dry[I] : auto.dry) ? ' (teste)' : ''}</span><span class=\\\"split-c\\\" title=\\\"Configurar\\\">▼</span>`,\\n      'Auto Compra: ' + (on ? 'ligada' : 'desligada') + (auto && auto.status[I] ? '\\\\nStatus: ' + auto.status[I] : '') +\\n        '\\\\nClique para ' + (on ? 'desligar' : 'ligar') + ' · setinha: configurações',\\n      (ev) => {\\n        const r = ev.currentTarget.getBoundingClientRect();\\n        if (ev.target.closest('.split-c')) window.api.openAutoConfig({ left: r.left, top: r.top, bottom: r.bottom });\\n        else window.api.setAuto(I, !on);\\n      }));\\n    // troca de hunt automática: nome liga/desliga nesta conta · setinha abre as configurações\\n    if (hunt) {\\n      const hon = !!(hunt.on && hunt.on[I]);\\n      mid.appendChild(el('button', 'btn hunt split' + (hon ? ' on' : ''),\\n        `<span class=\\\"chip\\\">${SVG.mapa}</span><span class=\\\"lbl\\\">Troca de hunt</span><span class=\\\"split-c\\\" title=\\\"Configurar\\\">▼</span>`,\\n        'Troca de hunt automática: ' + (hon ? 'ligada' : 'desligada') + (hunt.status && hunt.status[I] ? '\\\\nStatus: ' + hunt.status[I] : '') +\\n          '\\\\nClique para ' + (hon ? 'desligar' : 'ligar') + ' · setinha: configurações',\\n        (ev) => {\\n          if (ev.target.closest('.split-c')) window.api.huntPanel();\\n          else window.api.huntSet({ conta: I, on: !hon });\\n        }));\\n    }\\n    app.appendChild(mid);\\n\\n    // 3) lives: Twitch e Kick (+ moedinha dos pontos da Kick)\\n    if (lives) {\\n      const o = (lives.open && lives.open[I]) || { twitch: [], kick: [] };\\n      app.appendChild(el('div', 'sep'));\\n      const lg = group('livesg');\\n      [\\n        ['twitch', 'Twitch', SVG.twitch, 'o bônus de XP da Twitch'],\\n        ['kick', 'Kick', SVG.kick, 'juntar os pontos dos canais da Kick'],\\n      ].forEach(([p, nm, ico, para]) => {\\n        const lon = !!(lives[p] && lives[p][I]);\\n        const lst = o[p] || [];\\n        const tip = lon\\n          ? `${nm} ligada (clique para desligar)\\\\nAbertas: ${lst.join(', ') || 'nenhuma ao vivo agora'}` + (lives.checked ? '' : '\\\\nVerificando quem está ao vivo...')\\n          : `Abrir as lives oficiais da ${nm} automaticamente, mutadas, para ${para}`;\\n        // Twitch: clique liga/desliga. Kick: um botão só, que abre o painel (liga/desliga + pontos + resgate)\\n        // Kick: botão dividido (nome liga/desliga · setinha abre os pontos e o resgate)\\n        lg.appendChild(el('button', `btn lives ${p}` + (lon ? ' on' : '') + (p === 'kick' ? ' split' : ''),\\n          `<span class=\\\"chip\\\">${ico}</span><span class=\\\"lbl\\\">${nm}${lon ? ' <b>' + lst.length + '</b>' : ''}</span>${lon ? '<span class=\\\"rec\\\"></span>' : ''}` +\\n            (p === 'kick' ? '<span class=\\\"split-c\\\" title=\\\"Pontos e resgate\\\">▼</span>' : ''),\\n          p === 'kick' ? tip + '\\\\nSetinha: pontos, resgate e canais' : tip,\\n          (ev) => {\\n            if (p === 'kick' && ev.target.closest('.split-c')) {\\n              const r = ev.currentTarget.getBoundingClientRect();\\n              window.api.kickOpen(I, { left: r.left, top: r.top, bottom: r.bottom });\\n            } else window.api.setLives(I, p, !lon);\\n          }));\\n      });\\n      app.appendChild(lg);\\n    }\\n\\n    // 4) ações (encostadas na direita): extensões, recarregar, som, ampliar/grade\\n    const right = group('right');\\n    (extBtns || []).forEach((x) => {\\n      right.appendChild(el('button', 'btn icon ext', SVG.mira, `${x.nome}: abrir nesta conta`, () => window.api.openExt(I, x.id)));\\n    });\\n    const busy = !!(loading && loading[I]);\\n    right.appendChild(el('button', 'btn icon' + (busy ? ' spin' : ''), SVG.reload,\\n      busy ? 'Carregando...' : 'Recarregar esta conta', () => window.api.reload(I)));\\n    right.appendChild(el('button', 'btn icon', muted && muted[I] ? SVG.off : SVG.on,\\n      muted && muted[I] ? 'Som desligado (clique para ligar)' : 'Som ligado (clique para silenciar)', () => window.api.toggleMute(I)));\\n    right.appendChild(zoomed\\n      ? el('button', 'btn icon', SVG.grid, 'Voltar para as 4 contas', () => window.api.setView(-1))\\n      : el('button', 'btn icon', SVG.expand, 'Ampliar esta conta', () => window.api.setView(I)));\\n    app.appendChild(right);\\n  }\\n\\n  if (MODE === 'config') {\\n    initConfig();\\n  } else if (MODE === 'title') {\\n    initTitle();\\n  } else if (MODE === 'pvp') {\\n    initPvp();\\n  } else if (MODE === 'resumo') {\\n    initResumo();\\n  } else if (MODE === 'kick') {\\n    initKick();\\n  } else {\\n    window.api.onState(render);\\n    window.api.ready();\\n  }\\n</script>\"}}","sig":"I+Rt4zMqUVXO05wHxZANpN0GnhG693B3uBoK2XeQC2119txxD/xKRuJK9RHbCyzg6QNdt+oMj2V+dhxTp4fRCQ=="}